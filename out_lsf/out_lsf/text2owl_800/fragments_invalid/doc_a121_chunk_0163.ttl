hpc:Jobcontrolspecification a owl:Class .
hpc:terminatecontrol a owl:ObjectProperty .
hpc:resumecontrol a owl:ObjectProperty .
hpc:suspendcontrol a owl:ObjectProperty .
hpc:Bkill rdfs:domain hpc:Terminatecontrol ;
        rdfs:range xsd:string .
hpc:Breque rdfs:domain hpc:Terminatecontrol ;
        rdfs:range xsd:string .
hpc:Bresume rdfs:domain hpc:Resumecontrol ;
        rdfs:range xsd:string .
hpc:Bstop rdfs:domain hpc:Suspendcontrol ;
        rdfs:range xsd:string .
hpc:Defaultsignalconversion a owl:Class .
hpc:Windows a owl:Class .
hpc:Unix a owl:Class .
hpc:signalconversion a owl:ObjectProperty .
hpc:Ctrlcctrlcsigint rdfs:domain hpc:Signalconversion ;
        rdfs:range hpc:Windows hpc:Unix .
hpc:Ctrlbctrlbsigquit rdfs:domain hpc:Signalconversion ;
        rdfs:range hpc:Windows hpc:Unix .
hpc:Customsignalconversion a owl:Class .
hpc:lsfNt2unixCtrlc a owl:DatatypeProperty .
hpc:lsfNt2unixCtrlb a owl:DatatypeProperty .
hpc:Sigxxxx rdfs:range xsd:string .
hpc:Sigyyyy rdfs:range xsd:string .
hpc:customsignalconversionRule a owl:ObjectProperty .
hpc:Ctrlcctrlcsigxxxx rdfs:domain hpc:CustomsignalconversionRule ;
        rdfs:range hpc:LsfNt2unixCtrlc hpc:Ctrlcsigint .
hpc:Ctrlbctrlbsigyyyy rdfs:domain hpc:CustomsignalconversionRule ;
        rdfs:range hpc:LsfNt2unixCtrlb hpc:Ctrlbsigquit .
hpc:Processtrackingthroughcgroups a owl:Class .
hpc:Linux a owl:Class .
hpc:Kernelversion rdfs:domain hpc:Linux ;
        rdfs:range xsd:string .
hpc:Cgroupsfunctionssupported rdfs:domain hpc:Linux ;
        rdfs:range xsd:boolean .
hpc:processtracking a owl:ObjectProperty .
hpc:Processgroupid rdfs:domain hpc:Processtracking ;
        rdfs:range xsd:integer .
hpc:Processesnotinexistingjobprocesstree rdfs:domain hpc:Processtracking ;
        rdfs:range xsd:boolean .
hpc:Processesthatrunquickly rdfs:domain hpc:Processtracking ;
        rdfs:range xsd:boolean .
