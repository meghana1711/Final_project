@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:provhosttimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:duration .

hpc:billingperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:duration .

hpc:ignorelsbRcExternalHostIdleTime a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:boolean .

hpc:LogLevel a owl:EnumProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string ;
    rdfs:enum "INFO" "DEBUG" "WARN" "ERROR" "FATAL" .

hpc:instanceprefix a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .

hpc:osUsername a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .

hpc:osPassword a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .

hpc:Openstackinstance a owl:Class .
