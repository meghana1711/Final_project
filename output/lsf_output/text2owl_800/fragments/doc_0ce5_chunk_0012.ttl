hpc:Mbatchd a owl:Class .
hpc:Lsfratelimiter a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd .

hpc:usesmultithreading a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:boolean .

hpc:hasport a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .

hpc:forkschildmbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Mbatchd .

hpc:processesqueryrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Queryrequest .

hpc:Queryrequest a owl:Class .

hpc:hasdedicatedport a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .

hpc:createsthreadtoprocess a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Queryrequest .

hpc:useslsfratelimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Lsfratelimiter .
