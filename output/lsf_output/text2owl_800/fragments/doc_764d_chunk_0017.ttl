hpc:LsfDaemon a owl:Class .
hpc:LIM_Daemon a hpc:LSF_Daemon .
hpc:mbatchd a hpc:LSF_Daemon .

hpc:nonprivilegedportcommunication a owl:ObjectProperty .

hpc:Eauthprogram a owl:Class .

hpc:lsfMcNonprivilegedPorts a owl:DatatypeProperty .
hpc:lsfLimPort a owl:DatatypeProperty .
hpc:lsbMbdPort a owl:DatatypeProperty .

hpc:Firewall a owl:Class .

hpc:acceptincomingcommunication a owl:ObjectProperty .
hpc:allowoutgoingcommunication a owl:ObjectProperty .

hpc:Nonprivilegedsourceport rdfs:domain hpc:Firewall ;
    rdfs:range xsd:integer .

hpc:Destinationport rdfs:domain hpc:Firewall ;
    rdfs:range xsd:integer .

hpc:LsfDaemon rdfs:subClassOf hpc:Computingresource .

hpc:Nonprivilegedportcommunication rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:LsfDaemon .

hpc:LimDaemon rdfs:subClassOf hpc:LsfDaemon ;
    rdfs:subClassOf hpc:Nonprivilegedportcommunication .

hpc:Mbatchd rdfs:subClassOf hpc:LsfDaemon ;
    rdfs:subClassOf hpc:Nonprivilegedportcommunication .

hpc:Eauthprogram rdfs:subClassOf hpc:Securitymechanism .

hpc:LsfMcNonprivilegedPorts rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:boolean .

hpc:Firewall rdfs:subClassOf hpc:Networkdevice .

hpc:Acceptincomingcommunication rdfs:domain hpc:Firewall ;
    rdfs:range hpc:Nonprivilegedsourceport, hpc:Destinationport .

hpc:Allowoutgoingcommunication rdfs:domain hpc:Firewall ;
    rdfs:range hpc:Nonprivilegedsourceport, hpc:Destinationport .
