hpc:Job rdfs:subClassOf owl:Class .
hpc:Requeueexitvalues rdfs:subClassOf hpc:Job .
hpc:LsbJobpend rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:LsbJobexitStat rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Executionenvironment rdfs:subClassOf hpc:Job .
hpc:Commandpath rdfs:domain hpc:Executionenvironment ;
    rdfs:range xsd:string .
hpc:Preexecutioncommand rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .
hpc:Postexecutioncommand rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .
hpc:Path rdfs:domain hpc:Executionenvironment ;
    rdfs:range xsd:string .
hpc:Stdinstdoutstderr rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .
hpc:Unix rdfs:subClassOf hpc:Executionenvironment .
hpc:Windows rdfs:subClassOf hpc:Executionenvironment .
hpc:Shellfeatures rdfs:subClassOf hpc:Unix .
hpc:Preexecutioncommanddirectory rdfs:domain hpc:Shellfeatures ;
    rdfs:range xsd:string .
hpc:Preexecutioncommandfile rdfs:domain hpc:Shellfeatures ;
    rdfs:range xsd:string .
hpc:Postexecutioncommanduser rdfs:domain hpc:Executionenvironment ;
    rdfs:range hpc:User
