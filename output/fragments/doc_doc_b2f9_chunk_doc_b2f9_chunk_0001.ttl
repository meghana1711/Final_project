hpc:SlurmCluster a owl:Class .
hpc:GresType a owl:Class .
hpc:ComputeNode a owl:Class .
hpc:Gres a owl:Class .
hpc:GresConf a owl:Class .

hpc:hasGresType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range hpc:GresType .

hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GresType ;
    rdfs:range hpc:ComputeNode .

hpc:hasGres rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range hps:Gres .

hpc:GresConfOf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range hpc:GresConf .

hpc:GresTypeName a owl:DatatypeProperty ;
    rdfs:domain hpc:GresType ;
    rdfs:range xsd:string .

hpc:NodeName a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range xsd:string .

hpc:GresTypeValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Gres ;
    rdfs:range xsd:string .

hpc:GresTypeCount a owl:DatatypeProperty ;
    rdfs:domain hpc:Gres ;
    rdfs:range xsd:nonNegativeInteger .

hpc:GresTypeDeviceFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Gres ;
    rdfs:range xsd:string .

hpc:GresTypeCoreCount a owl:DatatypeProperty ;
    rdfs:domain hpc:Gres ;
    rdfs:range xsd:nonNegativeInteger .

hpc:GresNoConsume a owl:ObjectProperty .
```
