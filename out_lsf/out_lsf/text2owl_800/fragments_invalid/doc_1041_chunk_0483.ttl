hpc:Job
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Task
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a task in a job." .

hpc:JobAllocation
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents the allocation of a job." .

hpc:ResizeNotificationCommand
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a command to resize a notification." .

hpc:ExecutableFile
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents an executable file." .

hpc:Host
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a host in the HPC system." .

hpc:HostSpecification
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a specification of a host or a list of hosts." .

hpc:ExcludeHostListSpecification
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a list of hosts to be excluded from a HostSpecification." .

hpc:HostListSpecification
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a list of hosts in a HostSpecification." .

hpc:HostSpec
    a owl:ObjectProperty ;
    rdfs:domain [ hpc:Hostspecification ] ;
    rdfs:range [ hpc:Host ] ;
    rdfs:comment "Relates a HostSpecification to a Host." .

hpc:released_host_specification
    a owl:ObjectProperty ;
    rdfs:domain [ hpc:Job ] ;
    rdfs:range [ hpc:Hostspecification ] ;
    rdfs:comment "Relates a Job to its released host specification." .

hpc:all
    a owl:ObjectProperty ;
    rdfs:domain [ hpc:ReleasedHostSpecification ] ;
    rdfs:range [ hpc:Hostspecification ] ;
    rdfs:comment "Specifies all the tasks currently being used by the job." .

hpc:host_spec
    a owl:ObjectProperty ;
    rdfs:domain [ hpc:ReleasedHostSpecification ] ;
    rdfs:range [ hpc:Hostspecification ] ;
    rdfs:comment "Releases the number of tasks that are specified by positive_integer on the host that is specified by host_name." .

hpc:exclude_host
