hpc:Lsfserverhost a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an LSF server host in a cluster." .

hpc:hasLoginName an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The administrator login name for the server host." .

hpc:hasHostType an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of the server host." .

hpc:hasHostModel an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The model of the server host." .

hpc:acceptsInteractiveJobs an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the local cluster accepts or sends interactive jobs to this cluster." .

hpc:preferredAuthenticationName an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The preferred authentication name for the server host." .

hpc:actualAuthenticationName an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The actual authentication name in use for the server host." .

# LSF Installation and Configuration
hpc:Lsfinstallation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the LSF installation and configuration process." .

hpc:runsLSFInstallationScripts an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the LSF installation scripts are run during the installation process." .

# LSF Configuration File
hpc:Lsfconfigfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an LSF configuration file." .

hpc:requiresInstallConfigVariables an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfigfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The required variables for the install.config file." .

hpc:requiresServerConfigVariables an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfigfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The required variables for the server.config file." .

hpc:requiresAbsolutePath an owl:ObjectProperty ;
    rdfs:domain hdfs:LSFConfigFile ;
    rdfs:range xsd:string ;
    rdfs:comment
