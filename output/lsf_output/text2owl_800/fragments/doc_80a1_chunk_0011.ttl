hpc:Predictor a owl:Class .
hpc:RegressionAlgorithms rdf:type owl:ObjectProperty .
hpc:ClassificationAlgorithms rdf:type owl:ObjectProperty .
hpc:ranking_metric_regression rdf:type owl:DatatypeProperty .
hpc:ranking_metric_classification rdf:type owl:DatatypeProperty .
hpc:transformers rdf:type owl:ObjectProperty .

hpc:Regressionalgorithms rdfs:domain hpc:Predictor .
hpc:Classificationalgorithms rdfs:domain hpc:Predictor .
hpc:RankingMetricRegression rdfs:domain hpc:Predictor .
hpc:RankingMetricClassification rdfs:domain hpc:Predictor .
hpc:Transformers rdfs:domain hpc:Predictor .

hpc:Regressionalgorithms rdfs:range xsd:string .
hpc:Classificationalgorithms rdfs:range xsd:string .
hpc:RankingMetricRegression rdfs:range xsd:string .
hpc:RankingMetricClassification rdfs:range xsd:string .
hpc:Transformers rdfs:range xsd:string .

hpc:Predictor a owl:Class ;
    hpc:RegressionAlgorithms ( "RandomForestRegressorEstimator" "ExtraTreesRegressorEstimator" "XGBRegressorEstimator" "GradientBoostingRegressorEstimator" ) ;
    hpc:ClassificationAlgorithms ( "ExtraTreesClassifierEstimator" "GradientBoostingClassifierEstimator" "DecisionTreeClassifierEstimator" "RandomForestClassifierEstimator" ) ;
    hpc:ranking_metric_regression "MAE" ;
    hpc:ranking_metric_classification "Accuracy" .
