    rdfs:range xsd:boolean .
hpc:Errorfile rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string .
hpc:Jobid rdfs:domain hpc:Errorfile ;
    rdfs:range xsd:string .
hpc:Jobindex rdfs:domain hpc:Errorfile ;
    rdfs:range xsd:integer .
hpc:Currentworkingdirectory rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string .
