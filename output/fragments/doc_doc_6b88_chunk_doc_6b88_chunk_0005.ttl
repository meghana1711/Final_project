hpc:KeyCloakInstance a owl:Class .
hpc:hasClientSecret hpc:KeyCloakInstance rdf:datatype xsd:string .
hpc:hasClient hpc:KeyCloakInstance rdf:resource rdf:nil .
hpc:hasStartupScript hpc:KeyCloakInstance rdf:resource rdf:nil .
hpc:hasEnvironmentVariables hpc:KeyCloakInstance rdf:resource rdf:nil .

hpc:Client a owl:Class .
hpc:hasID hpc:Client rdf:datatype xsd:string .
hpc:hasSecret hpc:Client rdf:datatype xsd:string .
hpc:hasUsername hpc:Client rdf:datatype xsd:string .
hpc:hasPassword hpc:Client rdf:datatype xsd:string .

hpc:StartupScript a owl:Class .
hpc:hasContent hpc:StartupScript rdf:datatype xsd:string .

hpc:EnvironmentVariable a owl:Class .
hpc:hasName hpc:EnvironmentVariable rdf:datatype xsd:string .
hpc:hasValue hpc:EnvironmentVariable rdf:datatype xsd:string .

# KeyCloak Realm, User, and Client Relations
hpc:Realm a owl:Class .
hpc:hasClient hpc:Realm rdf:resource rdf:nil .
hpc:hasUser hpc:Realm rdf:resource rdf:nil .

hpc:User a owl:Class .
hpc:hasID hpc:User rdf:datatype xsd:string .
hpc:hasRealm hpc:User rdf:resource rdf:nil .

hpc:ClientRelation a owl:Class .
hpc:hasRealm hpc:ClientRelation rdf:resource rdf:nil .
hpc:hasClient hpc:ClientRelation rdf:resource rdf:nil .

# Authentication Methods
hpc:AuthenticationMethod a owl:Class .
hpc:hasName hpc:AuthenticationMethod rdf:datatype xsd:string .
hpc:hasJWKSFile hpc:AuthenticationMethod rdf:resource rdf:nil .
hpc:hasUserClaimField hpc:AuthenticationMethod rdf:resource rdf:nil .

hpc:JWKSAuth a hpc:AuthenticationMethod .
hpc:hasName hpc:JWKSAuth "JWKS" .

hpc:JWTAuth a hpc:AuthenticationMethod .
hpc:hasName hpc:JWTAuth "JWT" .

# Slurm Configuration
hpc:SlurmInstance a owl:Class .
hpc:hasAuthAltTypes hpc:SlurmInstance rdf:datatype xsd:string .
hpc:hasAuthAltParameters hpc:SlurmInstance rdf:resource rdf:nil .
hpc:hasJWTScript hpc:SlurmInstance rdf:resource rdf:nil .

hpc:UserMapping a owl:Class .
hpc:hasService hpc:UserMapping rdf:resource rdf:nil .
hpc:hasField hpc:UserMapping rdf:datatype xsd:string .

