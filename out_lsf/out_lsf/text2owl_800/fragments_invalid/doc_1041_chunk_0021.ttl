hpc:Jobstatistics a owl:Class .

hpc:Totaldonejobs hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Totalexitedjobs hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Totalcputime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Averagecputime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Maxcputime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Mincputime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Cpuefficiency hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Cpupeakusage hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Memoryefficiency hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Totalwaittime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Averagewaittime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .
hpc:Maxwaittime hpc:Jobstatistics rdfs:domain hpc:Jobstatistics .

hpc:printusage a owl:ObjectProperty .
hpc:Printusage rdfs:domain hpc:Command .
hpc:Printusage rdfs:range rdf:Literal .

hpc:printversion a owl:ObjectProperty .
hpc:Printversion rdfs:domain hpc:Command .
hpc:Printversion rdfs:range rdf:Literal .

hpc:defaultoutputformat a owl:DatatypeProperty .
hpc:Defaultoutputformat rdfs:domain hpc:Command .
hpc:Defaultoutputformat rdfs:range xsd:string .
