hpc:Applicationprofile a owl:Class .
hpc:Queue a owl:Class .

hpc:overridesqueuesettings a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Queue .

hpc:overridesqueuelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:defineenvironmentvariables a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:absoluterunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .

hpc:preexecutionqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Queue .

hpc:joblevelpreexecutioncommands a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Job .

hpc:postexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:rerunnable a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .

hpc:submitstononrerunnablequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
