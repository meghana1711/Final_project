hpc:Blaunch a owl:Class .
hpc:Jobres a owl:Class .
hpc:Rootsbatchd a owl:Class .
hpc:resourceusagerequest a owl:ObjectProperty ;
    rdfs:domain hpc:Jobres ;
    rdfs:range hpc:Resourceusage .
hpc:heartbeatmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobres ;
    rdfs:range hpc:Message .
hpc:Timeout a xsd:duration ;
    rdfs:range hpc:Resourceusagerequest .
hpc:Lsbapplicationprofile a owl:Class .
hpc:lsbcommandlogmask a owl:DatatypeProperty ;
    rdfs:domain hpc:Blaunch ;
    rdfs:range xsd:string .
hpc:lsbdebugcmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Blaunch ;
    rdfs:range xsd:string .
hpc:lsbcmdlogdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Blaunch ;
    rdfs:range xsd:string .
hpc:lsfdisablelsrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplicationprofile ;
    rdfs:range xsd:boolean .
hpc:lsfrootrex a owl:DatatypeProperty ;
    rdfs:domain hpc:Blaunch ;
    rdfs:range xsd:string .
hpc:Otherremoteexecutioncommands a owl:Class .
hpc:jobcontrolactions a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplicationprofile ;
    rdfs:range xsd:string .
hpc:jobControls a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplicationprofile ;
    rdfs:range xsd:string .
hpc:Firstexecutionhost a owl:Class .
hpc:jobcontrolsignals a owl:DatatypeProperty ;
    rdfs:domain hpc:Firstexecutionhost ;
    rdfs:range xsd:string .
hpc:Otherhosts a owl:Class .
