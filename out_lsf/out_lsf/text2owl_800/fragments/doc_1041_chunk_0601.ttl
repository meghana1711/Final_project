hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job submitted to a High Performance Computing system." .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A group of users in a High Performance Computing system." .

hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A requirement for data access in a High Performance Computing job." .

hpc:Tag a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A named data entity in a High Performance Computing system." .

hpc:tagowner a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hpc:User ;
    rdfs:comment "The user who owns a tag in a High Performance Computing system." .

hpc:cachepermission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "The group that has access to the cached files for a High Performance Computing job." .

hpc:datagroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "The user group specified for data access in a High Performance Computing job." .

hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of a tag in a High Performance Computing system." .

hpc:cacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether access control is enabled for the data manager in a High Performance Computing system." .

hpc:datacheck a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether data sanity checks are performed for a High Performance Computing job." .

hpc:dataspecification a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "The specification of the data requirement for a High Performance Computing job." .

hpc:runtimevariable a owl:DatatypeProperty ;
    rdfs:domain hpc:Filepath ;
    rdfs:range xsd:string ;
    rdfs:comment "The %I runtime variable in file paths in a High Performance Computing system." .
