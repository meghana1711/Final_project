hpc:Lsgrun a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Runs a task on a group of hosts." .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Synopsis" .

hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range hpc:Command ;
    rdfs:comment "The command to be executed" .

hpc:argument a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "Arguments for the command" .

hpc:resreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Resource requirements for the task" .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string ;
    rdfs:comment "The host name(s) to run the task on" .

hpc:p a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Prints command usage to stderr and exits" .

hpc:p1 a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Prints LSF release version to stderr and exits" .

hpc:v a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Verbose mode" .

hpc:s a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Runs the task in serial mode" .

hpc:r a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range hpc:Resreq ;
    rdfs:comment "Resource requirements for the task" .

hpc:m a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range rdf:List ;
    rdfs:comment "Runs the task on specific host(s)" .

hpc:h a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Prints help information" .

hpc:v1 a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Prints version information" .
