hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:Status a owl:Class .
hpc:Queue a owl:Class .
hpc:Command a owl:Class .
hpc:aps a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:systemaps a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:adminaps a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:bmodcommand a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Bmodcommand .
hpc:bjobscommand a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Bjobscommand .
hpc:bhistcommand a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Bhistcommand .
hpc:Queuegroup a owl:Class .
hpc:apspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Queuegroup ;
    rdfs:range hpc:Queue .
hpc:fairsharequeues a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuegroup ;
    rdfs:range xsd:boolean .
