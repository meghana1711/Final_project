hpc:bjgroup a owl:ObjectProperty .

hpc:GroupName rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:Njobs rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Pend rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Run rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ssusp rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ususp rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Finish rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:dateTime .
hpc:Sla rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:duration .
hpc:Jlimit rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Owner rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Jobgroup .

hpc:JobGroup "/A" a hpc:JobGroup ;
    hpc:NJOBS 0 ;
    hpc:PEND 0 ;
    hpc:RUN 0 ;
    hpc:SSUSP 0 ;
    hpc:USUSP 0 ;
    hpc:FINISH ""^^xsd:dateTime ;
    hpc:SLA "0/10"^^xsd:duration ;
    hpc:JLIMIT 0 ;
    hpc:OWNER "user1" .

hpc:JobGroup "/X" a hpc:JobGroup ;
    hpc:NJOBS 0 .

hpc:JobGroup "/A/B" a hpc:JobGroup ;
    hpc:NJOBS 0 ;
    hpc:PEND 0 ;
    hpc:RUN 0 ;
    hpc:SSUSP 0 ;
    hpc:USUSP 0 ;
    hpc:FINISH ""^^xsd:dateTime ;
    hpc:SLA "0/5"^^xsd:duration ;
    hpc:JLIMIT 0 ;
    hpc:OWNER "user1" .

hpc:JobGroup "/X/Y" a hpc:JobGroup ;
    hpc:NJOBS 0 .
