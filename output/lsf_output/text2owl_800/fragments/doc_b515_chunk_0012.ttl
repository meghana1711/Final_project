hpc:Jobsizelist a owl:Class .
hpc:jobsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsizelist ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:hasjobsizelist a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:domain hpc:Applicationprofile .
