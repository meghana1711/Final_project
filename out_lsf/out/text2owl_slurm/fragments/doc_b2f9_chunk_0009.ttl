hpc:Gpu a owl:Class .
hpc:Gres a owl:Class .
hpc:Mps a owl:Class .
hpc:grescount a owl:DatatypeProperty .
hpc:Grescount rdfs:domain hpc:Gres ;
                 rdfs:range xsd:decimal .
hpc:allocatedas a owl:ObjectProperty .
hpc:Allocatedas rdfs:domain hpc:Gpu ;
                 rdfs:range hpc:Gres .
hpc:Singlegpujobrequest a owl:Class .
hpc:multiplesharinggrespj a owl:ObjectProperty .
hpc:Multiplesharinggrespj rdfs:domain hpc:Singlegpujobrequest ;
                          rdfs:range xsd:boolean .
hpc:gputype a owl:ObjectProperty .
hpc:Gputype rdfs:domain hpc:Gpu ;
             rdfs:range rdf:Resource .
hpc:nvmllibraryinstalled a owl:ObjectProperty .
hpc:Nvmllibraryinstalled rdfs:domain hpc:Gpu ;
                         rdfs:range xsd:boolean .
