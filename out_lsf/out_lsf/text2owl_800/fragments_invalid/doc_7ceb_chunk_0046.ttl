hpc:Elim a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Located in the LSF_SERVERDIR directory." ;
    rdfs:label "ELIM" ;
    rdf:type owl:Class ;
    rdfs:seeAlso <http://example.org/hpc#elim_location> .

hpc:elimLocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string ;
    rdfs:comment "The location of the ELIM." ;
    rdfs:label "elimLocation" ;
    rdf:type owl:DatatypeProperty .

hpc:LsfServerdir a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Directory where the ELIM is located." ;
    rdfs:label "LSF_SERVERDIR" ;
    rdf:type owl:Class ;
    rdfs:seeAlso <http://example.org/hpc#elim_location> .

hpc:MiscExamples a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Directory containing examples of ELIM." ;
    rdfs:label "misc_examples" ;
    rdf:type owl:Class .

# Shared resources
hpc:Sharedresource a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A dynamic shared resource for software licenses." ;
    rdfs:label "SharedResource" ;
    rdf:type owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf [ a owl:Class ;
                                            rdfs:subClassOf owl:NamedIndividual ] ;
                        rdfs:subClassOf [ a owl:Class ;
                                            rdfs:subClassOf owl:ObjectProperty ;
                                            rdfs:domain hpc:Sharedresource ] ] .

hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the shared resource." ;
    rdfs:label "resourceName" ;
    rdf:type owl:DatatypeProperty .

hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:string ;
    rdfs:comment "Type of the shared resource." ;
    rdfs:label "type" ;
    rdf:type owl:ObjectProperty .

hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Interval at which the value of the shared resource is refreshed." ;
    rdfs:label "interval" ;
    rdf:type owl:DatatypeProperty .

h
