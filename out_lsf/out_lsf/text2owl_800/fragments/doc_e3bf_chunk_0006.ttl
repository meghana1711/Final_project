hpc:Productedition a owl:Class .
hpc:LSFStandardEdition rdf:type hpc:ProductEdition ;
    rdfs:label "LSF Standard Edition" .
hpc:LSFExpressEdition rdf:type hpc:ProductEdition ;
    rdfs:label "LSF Express Edition" .

hpc:Entitlementfile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:entitlementfiledownload a owl:ObjectProperty ;
    rdfs:domain hpc:Productedition ;
    rdfs:range hpc:Entitlementfile ;
    rdfs:label "downloadEntitlementFile" .

hpc:setentitlementfile a owl:ObjectProperty ;
    rdfs:domain hpc:Productedition ;
    rdfs:range hpc:Entitlementfile ;
    rdfs:label "setEntitlementFile" .

hpc:upgrade a owl:ObjectProperty ;
    rdfs:domain hpc:Productedition ;
    rdfs:range hpc:Productedition ;
    rdfs:label "upgrade" .

hpc:Installation a owl:Class .
hpc:installmanagementhost a owl:ObjectProperty ;
    rdfs:domain hpc:Installation ;
    rdfs:range hpc:Installationstep .

hpc:Installationstep a owl:Class .
