@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Queue a owl:Class .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Resourcemap a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcemap .
hpc:location a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcename ;
    rdfs:range xsd:string .

hpc:Poejob a owl:Class .

hpc:Lsfconf a owl:Class .
hpc:lsbSubCommandname a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf .
hpc:lsfEnableExtscheduler a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf .
hpc:lsfCpusetBestcpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf .
hpc:lsfVplugin a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .
hpc:lsbRlaPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .
hpc:lsbShortHostlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf .

hpc:Lsfsharedresources a owl:Class .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
hpc:increasing a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:Slurm a rdfs:subClassOf hpc:Resource .
hpc:Cpuset a rdfs:subClassOf hpc:Resource .
hpc:MpichGm a rdfs:subClassOf hpc:Resource .
hpc:Lammpi a rdfs:subClassOf hpc:Resource .
hpc:Mpichp4 a rdfs:subClassOf hpc:Resource .
hpc:Mvapich a rdfs:subClassOf
