hpc:RollupStats a owl:Class .
hpc:daily hpc:RollupStats;
  rdfs:subPropertyOf hpc:rollupStats .
hpc:hourly hpc:RollupStats;
  rdfs:subPropertyOf hpc:rollupStats .
hpc:monthly hpc:RollupStats;
  rdfs:subPropertyOf hpc:rollupStats .
hpc:last_run rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:RollupStats ;
  rdfs:range xsd:anyURI .

hpc:SharesUint64Tres a owl:Class .
