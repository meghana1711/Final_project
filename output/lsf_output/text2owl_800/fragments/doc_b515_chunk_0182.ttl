hpc:ParentQueue
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "Queue with a user-based fair share policy that applies to child queues." .

hpc:ChildQueue
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "Queue that inherits the fair share policy from a parent queue." .

hpc:hasFairSharePolicy
    a owl:ObjectProperty ;
    rdfs:domain hpc:Parentqueue ;
    rdfs:range hpc:Fairsharepolicy ;
    rdfs:comment "The fair share policy applied to the parent queue and its child queues." .

hpc:hasChildQueue
    a owl:ObjectProperty ;
    rdfs:domain hpc:Parentqueue ;
    rdfs:range hpc:Childqueue ;
    rdfs:comment "The child queues that inherit the fair share policy from the parent queue." .

hpc:FairSharePolicy
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The policy that defines the fair share of resources across multiple queues." .

hpc:hasUser
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:User ;
    rdfs:comment "The users to whom the fair share policy applies." .

hpc:hasShareAssignment
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The share assignment of a user in the fair share policy." .

hpc:User
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A user who can submit jobs to fair share queues." .

hpc:Queue
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A queue in the HPC system." .

hpc:hasUserAssignment
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:User ;
    rdfs:comment "The users allowed to use the queue." .

hpc:DISPATCH_ORDER
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Parentqueue ;
    rdfs:range xsd:string ;
    rdfs:comment "The dispatch order of jobs in the parent queue and its child queues." .
