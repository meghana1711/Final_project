hpc:Lsfadminuser a owl:Class .
hpc:cacheaccesscontrol a owl:ObjectProperty .
hpc:cacheaccessiblefiles a owl:ObjectProperty .

hpc:Lsfadminuser rdfs:subClassOf xsd:string .
hpc:Cacheaccesscontrol rdfs:domain hpc:Lsfjob .
hpc:Cacheaccesscontrol rdfs:range xsd:boolean .
hpc:Cacheaccessiblefiles rdfs:domain hpc:Lsfjob .
hpc:Cacheaccessiblefiles rdfs:range xsd:boolean .

hpc:CacheAccessControl rdfs:subPropertyOf hpc:hasCacheAccessControl .
hpc:CacheAccessibleFiles rdfs:subPropertyOf hpc:hasCacheAccessibleFiles .

hpc:CacheAccessControl rdfs:label "Enables the owner of a data tag or a data file in the cache to change the user group ownership of a tag, an ownership, and the permissions of a file."@en .
hpc:CacheAccessibleFiles rdfs:label "Specifies whether LSF data manager initiates a transfer job or creates a symbolic link from the cache to the requested data file."@en .

hpc:CacheAccessControl rdfs:comment "Syntax: CACHE_ACCESS_CONTROL=Y | y | N | n"@en .
hpc:CacheAccessibleFiles rdfs:comment "Syntax: CACHE_ACCESSIBLE_FILES=Y | y | N | n"@en .

hpc:Cacheaccesscontrol rdfs:subClassOf owl:Restriction .
hpc:Cacheaccessiblefiles rdfs:subClassOf owl:Restriction .

hpc:CacheAccessControl rdfs:hasValue "Y" .
hpc:CacheAccessControl rdfs:hasValue "y" .
hpc:CacheAccessControl rdfs:hasValue "N" .
hpc:CacheAccessControl rdfs:hasValue "n" .

hpc:CacheAccessibleFiles rdfs:hasValue "Y" .
hpc:CacheAccessibleFiles rdfs:hasValue "y" .
hpc:CacheAccessibleFiles rdfs:hasValue "N" .
hpc:CacheAccessibleFiles rdfs:hasValue "n" .

hpc:Cacheaccesscontrol rdfs:domain rdfs:Resource .
hpc:Cacheaccessiblefiles rdfs:domain rdfs:Resource .

hpc:Cacheaccesscontrol rdfs:range xsd:boolean .
hpc:Cacheaccessiblefiles rdfs:range xsd:boolean .
