hpc:JobDescMsg a owl:Class .

hpc:mailType a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .

hpc:memoryBindingType a owl:ObjectProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .
hpc:memoryBindingType rdfs:subPropertyOf xsd:string .

hpc:memoryPerCpu a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .
    rdfs:comment "Minimum memory in megabytes per allocated CPU (64 bit integer number with flags)" .

hpc:memoryPerNode a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .
    rdfs:comment "Minimum memory in megabytes per allocated node (64 bit integer number with flags)" .

hpc:openMode a owl:ObjectProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .
hpc:openMode rdfs:subPropertyOf xsd:string .

hpc:prefer a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .
    rdfs:comment "Comma-separated list of features that are preferred but not required" .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .
    rdfs:comment "Request specific job priority (32 bit integer number with flags)" .

hpc:profile a owl:ObjectProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .
hpc:profile rdfs:subPropertyOf xsd:string .

hpc:requiredNodes a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:string .
    rdfs:comment "Comma-separated list of required nodes" .

hpc:requiredSwitches a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .
    rdfs:comment "Maximum number of switches (32 bit integer number with flags)" .

hpc:rlimits a owl:Class .
hpc:rlimits rdfs:subClassOf hpc:JobDescMsg .
