@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:lsfGetpasswdRetryCount a owl:DatatypeProperty ;
  rdfs:domain hpc:Lsfconfiguration ;
  rdfs:range xsd:integer .

hpc:lsfGetpwnamRetry a owl:DatatypeProperty ;
  rdfs:domain hpc:Lsfconfiguration ;
  rdfs:range xsd:integer .

hpc:lsfGpuHardwareChange a owl:ObjectProperty ;
  rdfs:domain hpc:Lsfconfiguration ;
  rdfs:range xsd:string .

hpc:LSF_GPU_HARDWARE_CHANGE_Y a owl:NamedIndividual ;
  hpc:LSF_GPU_HARDWARE_CHANGE "Y" .

hpc:LSF_GPU_HARDWARE_CHANGE_N a owl:NamedIndividual ;
  hpc:LSF_GPU_HARDWARE_CHANGE "N" .

hpc:lsfHostgroupInfo a owl:ObjectProperty ;
  rdfs:domain hpc:Lsfconfiguration ;
  rdfs:range xsd:string .

hpc:LSF_HOSTGROUP_INFO_Y a owl:NamedIndividual ;
  hpc:LSF_HOSTGROUP_INFO "Y" .
