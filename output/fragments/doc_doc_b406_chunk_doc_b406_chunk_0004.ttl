hpc:ConsumableResource a owl:Class .
hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .

hpc:hasJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Job .

hpc:isSharedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ConsumableResource ;
    rdfs:range hpc:Partition .

hpc:getJobsFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range rdfs:Integer .

hpc:OverSubscribe rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:integer .

hpc:MaxJobsOnNode rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ConsumableResource ;
    rdfs:range xsd:integer .

hpc:SelectType rdf:type owl:Enum ;
    rdfs:member hpc:select/linear ;
    rdfs:member hpc:select/linearPlus ;
    rdfs:member hpc:select/cons_tres .

hpc:SelectTypeParameters rdf:type owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    rdfs:subPropertyOf hpc:SelectType .

hpc:CR_Memory rdf:type hpc:SelectTypeParameters ;
    owl:onProperty hpc:Memory .

hpc:CR_Core rdf:type hpc:SelectTypeParameters ;
hpc:CR_CPU rdf:type hpc:SelectTypeParameters ;
hpc:CR_Socket rdf:type hpc:SelectTypeParameters .

hpc:Memory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ConsumableResource ;
    rdfs:range xsd:decimal .
```
