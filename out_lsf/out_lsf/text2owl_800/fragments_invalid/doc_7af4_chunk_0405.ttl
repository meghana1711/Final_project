hpc:Container a owl:Class .
hpc:Singularitycontainer hpc:subclassof hpc:Container .
hpc:Apptainercontainer hpc:subclassof hpc:Container .
hpc:Podmancontainer hpc:subclassof hpc:Container .

hpc:ldLibraryPathSetting an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .

hpc:siteEnvAppendSetting an owl:ObjectProperty ;
    rdfs:domain hpc:Singularitycontainer ;
    rdfs:range xsd:string .

hpc:jobRunOption an owl:ObjectProperty ;
    rdfs:domain hpc:Singularitycontainer, hpc:Apptainercontainer, hpc:Podmancontainer .

hpc:cleanedLDLibraryPath an owl:DatatypeProperty ;
    rdfs:domain hpc:Program ;
    rdfs:range xsd:boolean .

hpc:dependsOnLDLibraryPath an owl:ObjectProperty ;
    rdfs:domain hpc:Program ;
    rdfs:range hpc:Program .

hpc:OpenMPI a hpc:Program .

hpc:ldSoConfFile an owl:DatatypeProperty ;
    rdfs:domain hpc:Singularitycontainer ;
    rdfs:range xsd:string .

hpc:ldConfigCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Singularitycontainer .

hpc:PodmanContainerJobRunOption an owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainer ;
    rdfs:range xsd:string .

hpc:reservedUserOption an owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainerjobrunoption .

hpc:preExecutionScriptOutputContainsUserOption an owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainer ;
    rdfs:range xsd:boolean .

hpc:automaticallySetWorkingDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainer .

hpc:automaticallySetULimit an owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainer .
