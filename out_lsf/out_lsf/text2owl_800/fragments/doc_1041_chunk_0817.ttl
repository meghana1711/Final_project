hpc:Loadinformation a owl:Class .
hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:Command a owl:Class .

# Object Properties
hpc:hasloadinformation a owl:ObjectProperty .
hpc:onhost a owl:ObjectProperty .
hpc:forresource a owl:ObjectProperty .
hpc:executescommand a owl:ObjectProperty .

# Datatype Properties
hpc:outputfieldname a owl:DatatypeProperty .
hpc:outputwidth a owl:DatatypeProperty .
hpc:outputdelimiter a owl:DatatypeProperty .
hpc:loadindex a owl:DatatypeProperty .
hpc:numhosts a owl:DatatypeProperty .
hpc:resourcename a owl:DatatypeProperty .
hpc:location a owl:DatatypeProperty .
hpc:resourcerequirement a owl:DatatypeProperty .

# Domain and Range
hpc:Hasloadinformation rdfs:domain hpc:Resource .
hpc:Onhost rdfs:domain hpc:Loadinformation .
hpc:Forresource rdfs:domain hpc:Loadinformation .
hpc:Executescommand rdfs:domain hpc:Loadinformation .
hpc:Outputfieldname rdfs:domain hpc:Loadinformation .
hpc:Outputwidth rdfs:domain hpc:Loadinformation .
hpc:Outputdelimiter rdfs:domain hpc:Loadinformation .
hpc:Loadindex rdfs:domain hpc:Loadinformation .
hpc:Numhosts rdfs:domain hpc:Loadinformation .
hpc:Resourcename rdfs:domain hpc:Loadinformation .
hpc:Location rdfs:domain hpc:Loadinformation .
hpc:Resourcerequirement rdfs:domain hpc:Loadinformation .
hpc:Outputfieldname rdfs:range xsd:string .
hpc:Outputwidth rdfs:range xsd:nonNegativeInteger .
hpc:Outputdelimiter rdfs:range xsd:string .
hpc:Loadindex rdfs:range xsd:nonNegativeInteger .
hpc:Numhosts rdfs:range xsd:nonNegativeInteger .
hpc:Resourcename rdfs:range xsd:string .
hpc:Location rdfs:range xsd:string .
hpc:Resourcerequirement rdfs:range xsd:string .

# Subclass Relations
hpc:FieldNameLoad a hpc:LoadInformation .
hpc:JsonLoad a hpc:LoadInformation .
hpc:NoOutputLoad a hpc:LoadInformation .
hpc:StrictOutputLoad a hpc:LoadInformation .
