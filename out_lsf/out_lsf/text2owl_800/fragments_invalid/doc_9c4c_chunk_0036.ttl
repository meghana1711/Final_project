hpc:Lsfadmin a owl:Class .
hpc:haspermission a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral .

hpc:Root a owl:Class ;
    rdfs:subClassOf hpc:Lsfadmin .

hpc:Useraccount a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:lsfAdmins a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range xsd:string .

hpc:lsfClusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral .

hpc:Lsfcluster a owl:Class .
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .

hpc:Validvalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:hasValidValue rdf:Property ;
    rdfs:domain hpc:LsfAdmins, hpc:LsfClusterName ;
    rdfs:range hpc:Validvalue .

hpc:requiredvariable a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
