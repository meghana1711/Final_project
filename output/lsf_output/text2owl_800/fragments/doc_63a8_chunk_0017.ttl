hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job with data requirements." .

hpc:datarequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The data requirements for a job." .

hpc:modifydatarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Modifydatarequirementaction ;
    rdfs:comment "Modifying the data requirements of a job." .

hpc:replacedatarequirement a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:ModifyDataRequirement ;
    rdfs:comment "Replacing the entire previous data requirement string." .

hpc:adddatarequirement a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:ModifyDataRequirement ;
    rdfs:comment "Adding a part of the data requirement string." .

hpc:Modifydatarequirementaction a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The action of modifying the data requirements." .

hpc:Bsubcommand a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The command used to submit a job to LSF." .

hpc:datatransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range hpc:Datatransfermethod ;
    rdfs:comment "The method used for transferring data with bsub command." .

hpc:Lsfdatamanager a owl:Class ;
    rdfs:subClassOf hpc:Datatransfermethod ;
    rdfs:comment "The LSF Data Manager for transferring files." .

hpc:Esubscript a owl:Class ;
    rdfs:subClassOf hpc:Datatransfermethod ;
    rdfs:comment "The esub script for converting -f options to -data options." .

hpc:Wrapperscript a owl:Class ;
    rdfs:subClassOf hpc:Datatransfermethod ;
    rdfs:comment "The wrapper script for running either the original lsrcp binary or the bstage command." .

hpc:Lsfconfiguration a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The configuration settings for LSF." .

hpc:lsbEsubMethod a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The method used for submitting the esub script." .
