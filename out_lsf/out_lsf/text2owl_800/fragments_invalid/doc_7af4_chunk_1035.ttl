@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:lsbFrames a owl:ObjectProperty .
hpc:lsbHmsTimeFormat a owl:DatatypeProperty .
hpc:lsbHosts a owl:ObjectProperty .
hpc:lsbInteractive a owl:DatatypeProperty .
hpc:lsbJobaffReq a owl:ObjectProperty .

rdfs:domain hpc:LsbFrames rdf:List .
rdfs:domain hpc:LsbHmsTimeFormat xsd:string .
rdfs:domain hpc:LsbHosts rdf:List .
rdfs:domain hpc:LsbInteractive xsd:string .
rdfs:domain hpc:LsbJobaffReq rdf:List .

rdfs:range hpc:LsbFrames xsd:positiveInteger .
rdfs:range hpc:LsbHmsTimeFormat xsd:string .
rdfs:range hpc:LsbHosts xsd:string .
rdfs:range hpc:LsbInteractive xsd:string .
rdfs:range hpc:LsbJobaffReq xsd:string .

hpc:Job a rdfs:subClassOf owl:Class .
hpc:LSB_FRAMES rdfs:subPropertyOf owl:ObjectProperty .
hpc:LSB_HMS_TIME_FORMAT rdfs:subPropertyOf owl:DatatypeProperty .
hpc:LSB_HOSTS rdfs:subPropertyOf owl:ObjectProperty .
hpc:LSB_INTERACTIVE rdfs:subPropertyOf owl:DatatypeProperty .
hpc:LSB_JOBAFF_REQ rdfs:subPropertyOf owl:ObjectProperty .
