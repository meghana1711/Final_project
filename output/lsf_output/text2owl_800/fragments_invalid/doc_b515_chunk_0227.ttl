@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix hpc: <http://example.org/hpc#>

hpc:Resizenotificationcommand a owl:Class.
hpc:hasResizeNotificationResultDomain rdfs:Resource.
hpc:hasResizeNotificationResultRange xsd:string.

hpc:LSB_RESIZE_NOTIFY_OK a xsd:string.
hpc:LSB_RESIZE_NOTIFY_FAIL a xsd:string.

hpc:Resizeablejob a owl:Class.
hpc:isresizablejob a owl:ObjectProperty.

hpc:Resizeablejobprofile a owl:Class.
hpc:hasResizableJobProfileDomain rdfs:Resource.
hpc:hasResizableJobProfileRange rdf:Resource.
