hpc:apsPriority a owl:ObjectProperty .
hpc:QueueGroup a owl:Class .
hpc:jobPriorityOverTime a owl:DatatypeProperty .
hpc:maxUserPriority a owl:DatatypeProperty .
hpc:Job a owl:Class .
hpc:USER rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:QUEUE rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:FROM_HOST rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JOB_NAME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:SUBMIT_TIME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:APS rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Queue rdfs:domain hpc:ApsPriority ;
hpc:Job rdfs:domain hpc:ApsPriority .
hpc:QueueGroup rdfs:range hpc:Queue .
hpc:APS_PRIORITY rdfs:subPropertyOf rdf:Property ;
    rdfs:range xsd:integer .
hpc:JOB_PRIORITY_OVER_TIME rdfs:subPropertyOf rdf:Property ;
    rdfs:range xsd:integer .
hpc:MAX_USER_PRIORITY rdfs:subPropertyOf rdf:Property ;
    rdfs:range xsd:integer .
