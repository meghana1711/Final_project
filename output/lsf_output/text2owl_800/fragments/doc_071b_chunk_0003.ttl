hpc:Lsf a owl:Class .
hpc:bconf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Configurationfile .

hpc:lsfLiveConfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:addadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Admin .

hpc:Admin a owl:Class .

hpc:lsid a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsfversion .

hpc:Lsfversion a owl:Class ;
    rdfs:subClassOf owl:String .

hpc:lsclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Clusterinfo .

hpc:Clusterinfo a owl:Class .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:string .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:string .

hpc:masterhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:string .

hpc:adminname a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:string .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:integer .

hpc:servers a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinfo ;
    rdfs:range xsd:integer .

hpc:bparams a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Configurationparameter .

hpc:Configurationparameter a owl:Class .

hpc:badmin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Systemruntimeinfo .

hpc:Systemruntimeinfo a owl:Class .
