hpc:OrphanJobTermGracePeriod a owl:Class .
hpc:parallelSchedBySlot a owl:ObjectProperty .
hpc:ParallelSchedBySlot rdfs:domain hpc:OrphanJobTermGracePeriod ;
                             rdfs:range xsd:boolean .
hpc:pendReasonUpdateInterval a owl:DatatypeProperty .
hpc:PendReasonUpdateInterval rdfs:domain hpc:OrphanJobTermGracePeriod ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:performanceThresholdFile a owl:DatatypeProperty .
hpc:PerformanceThresholdFile rdfs:domain hpc:OrphanJobTermGracePeriod ;
                                 rdfs:range xsd:string .
hpc:persistLiveConfig a owl:DatatypeProperty .
hpc:PersistLiveConfig rdfs:domain hpc:OrphanJobTermGracePeriod ;
                          rdfs:range xsd:boolean .
