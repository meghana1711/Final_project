hpc:Localfile hpc:localfileclass ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A local file created if it does not exist." .

hpc:Remotefile hpc:remotefileclass ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A remote file that is copied to local_file before the job executes and back after it completes." .

hpc:Copyoperation hpc:copyoperationclass ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Localfile ;
    rdfs:range hpc:Remotefile ;
    rdfs:comment "The operation of copying a local_file to a remote_file." .

hpc:Executejob hpc:executejobclass ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Localfile ;
    rdfs:range hpc:Localfile ;
    rdfs:comment "The operation of executing a job on a local_file and overwriting it with the copied back remote_file." .

hpc:Changedirectory hpc:changedirectoryclass ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Localfile ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The operation of changing the directory to the same path name as the directory where the bsub command was run." .

hpc:Nonsharedfilesystem hpc:nonsharedfilesystemclass ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A file system where specifying remote_file as a file name with no path when running in non-shared file systems." .

hpc:Inputfile hpc:inputfileclass ;
    rdfs:subClassOf hpc:Localfile ;
    rdfs:domain hpc:Executejob ;
    rdfs:range hpc:Localfile ;
    rdfs:comment "The input file for a job." .

hpc:Outputfile hpc:outputfileclass ;
    rdfs:subClassOf hpc:Localfile ;
    rdfs:domain hpc:Executejob ;
    rdfs:range hpc:Localfile ;
    rdfs:comment "The output file for a job." .

hpc:Submissionhost hpc:submissionhostclass ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The host where the bsub command is run." .

hpc:Executionhost hpc:executionhostclass ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The host where the job is executed." .

hpc:Copyfromsubmissionhost hpc:copyfromsubmissionhostclass ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range hpc:Localfile ;
    rdfs:comment "The operation of copying an input_file from the submission host to the execution host." .

hpc:Copytosubmissionhost hpc:copytosubmissionhostclass ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Outputfile ;
    rd
