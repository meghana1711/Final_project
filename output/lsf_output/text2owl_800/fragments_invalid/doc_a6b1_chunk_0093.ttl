hpc:Portablehardwarelocality a owl:Class .
hpc:Lsf a owl:Class .
hpc:Intelxeonphiresources a owl:Class .
hpc:Nvidagpu a owl:Class .
hpc:Intelmic a owl:Class .

hpc:supports rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Portablehardwarelocality ;
    rdfs:range hpc:Lsf .

hpc:detects rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Portablehardwarelocality ;
    rdfs:range hpc:Lsf .

hpc:integratedInto rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Portablehardwarelocality .

hpc:gathers rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Portablehardwarelocality ;
    rdfs:range xsd:string .

hpc:detectsTopology rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Portablehardwarelocality ;
    rdfs:range xsd:string .

hpc:Intelxeonphi a rdfs:subClassOf hpc:Intelmic .
