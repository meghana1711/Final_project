hpc:SlurmUser rdfs:subClassOf owl:NamedIndividual .

hpc:SlurmctldHost a owl:ObjectProperty .
hpc:SlurmctldHost rdfs:domain hpc:SlurmConfigurationFile ;
                   rdfs:range xsd:string .

