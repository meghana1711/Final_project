hpc:Threads a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:SCoT a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:NodeList a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Resource a owl:Class .
hpc:Memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:JobSetting a owl:Class .
hpc:ReqSockets a owl:DatatypeProperty ;
