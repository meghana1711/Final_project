hpc:Resource a owl:Class .
hpc:resourcelocation a owl:ObjectProperty .
hpc:resourcename a owl:DatatypeProperty .
hpc:totalamount a owl:DatatypeProperty .
hpc:reservedamount a owl:DatatypeProperty .

hpc:Resource rdfs:subClassOf owl:Class .
hpc:Resourcelocation rdfs:domain hpc:Resource ;
                        rdfs:range rdf:Resource .
hpc:Resourcename rdfs:domain hpc:Resource ;
                  rdfs:range xsd:string .
hpc:Totalamount rdfs:domain hpc:Resource ;
                rdfs:range xsd:nonNegativeInteger .
hpc:Reservedamount rdfs:domain hpc:Resource ;
                rdfs:range xsd:nonNegativeInteger .

