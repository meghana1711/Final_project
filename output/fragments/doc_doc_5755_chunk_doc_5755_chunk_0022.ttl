hpc:Job a owl:Class .
hpc:PendingJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    hpc:hasNoEstimate a owl:ObjectProperty .

hpc:JobWithDependencies a hpc:Job ;
    rdfs:subClassOf hpc:PendingJob .

hpc:EstimatedJob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    hpc:hasEstimate a owl:DatatypeProperty .

hpc:SoonJob a hpc:EstimatedJob .

hpc:BackfillRestrictedJob a hpc:Job ;
    rdfs:subClassOf hpc:Job .

hpc:ColorCodedOutput a owl:Class .

hpc:SqueueOutput a hpc:ColorCodedOutput .
hpc:ColorWrapper a owl:Class .

hpc:CommandOutput a owl:Class ;
    rdfs:subClassOf hpc:ColorCodedOutput .

hpc:ColorCodedCommandOutput a owl:ObjectProperty ;
    rdfs:domain hpc:ColorCodedOutput ;
    rdfs:range hpc:ColorCodedOutput .

hpc:ColorConfigFile a owl:Class ;
    rdfs:subClassOf hpc:ColorCodedOutput .

hpc:ColorConfigFilePath a owl:DatatypeProperty ;
    rdfs:domain hpc:ColorConfigFile ;
    rdfs:range xsd:string .

hpc:ColorWrapperPath a owl:DatatypeProperty ;
    rdfs:domain hpc:ColorWrapper ;
    rdfs:range xsd:string .

hpc:UsePty a owl:ObjectProperty ;
    rdfs:domain hpc:ColorWrapper .

hpc:BaseColor a owl:DatatypeProperty ;
    rdfs:domain hpc:ColorWrapper .

hpc:MatchColor a owl:ObjectProperty ;
    rdfs:domain hpc:ColorWrapper ;
    rdfs:range hpc:Match .

hpc:MatchDefaultColor a owl:ObjectProperty ;
    rdfs:domain hpc:Match .
    rdfs:range rdfs:Resource .

hpc:MatchResource a owl:Class .
hpc:NullResource a hpc:MatchResource .
hpc:RunningJob a hpc:MatchResource .

hpc:MatchPattern a owl:ObjectProperty ;
    rdfs:domain hpc:Match .
    rdfs:range xsd:string .

hpc:RegexColor a owl:ObjectProperty ;
    rdfs:domain hpc:Match .
    rdfs:range rdfs:Resource .

hpc:CompletedJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:CompletingJob a owl:Class ;
    rdfs:subClassOf hpc:CompletedJob .

hpc:HungCompletingJob a owl:Class ;
    rdfs:subClassOf hpc:CompletingJob .

hpc:NodeInCompletingState a owl:Class .

hpc:NodeState a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeInCompleting
