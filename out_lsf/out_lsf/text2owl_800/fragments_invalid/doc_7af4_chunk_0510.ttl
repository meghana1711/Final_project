hpc:Lsfservice a owl:Class .
hpc:checksbysbatchd a owl:ObjectProperty .
hpc:checksbytaskresd a owl:ObjectProperty .
hpc:overridesbymemlimitType a owl:ObjectProperty .
hpc:overridesbylsbJobCpulimit a owl:ObjectProperty .
hpc:overridesbylsbJobMemlimit a owl:ObjectProperty .
hpc:usespamCredsoverridebylsbapplications a owl:ObjectProperty .
hpc:usespamCredsoverridebylsbqueues a owl:ObjectProperty .
hpc:UsePamCredsdefault a owl:Class .
hpc:Users a owl:Class .
hpc:isuser a owl:ObjectProperty .
hpc:isusergroup a owl:ObjectProperty .
hpc:isincludedinlist a owl:ObjectProperty .
hpc:USERS_Description a rdfs:Literal .
hpc:LSFClusterAdmin a owlimport:NamedIndividual .

hpc:Lsfservice rdfs:subClassOf owl:Class .
hpc:Checksbysbatchd rdfs:domain hpc:Lsfservice ;
                      rdfs:range rdf:Resource .
hpc:Checksbytaskresd rdfs:domain hpc:Lsfservice ;
                      rdfs:range rdf:Resource .
hpc:OverridesbymemlimitType rdfs:domain hpc:Lsfservice ;
                             rdfs:range rdf:Resource .
hpc:OverridesbylsbJobCpulimit rdfs:domain hpc:Lsfservice ;
                               rdfs:range rdf:Boolean .
hpc:OverridesbylsbJobMemlimit rdfs:domain hpc:Lsfservice ;
                               rdfs:range rdf:Boolean .
hpc:UsespamCredsoverridebylsbapplications rdfs:domain hpc:Lsfservice ;
                                      rdfs:range rdf:Resource .
hpc:UsespamCredsoverridebylsbqueues rdfs:domain hpc:Lsfservice ;
                                     rdfs:range rdf:Resource .
hpc:UsePamCredsdefault a owl:Class ;
                          rdfs:subClassOf hpc:Lsfservice .
hpc:Users a owl:Class .
hpc:Isuser rdfs:domain hpc:Users ;
                   rdfs:range rdf:Resource .
hpc:Isusergroup rdfs:domain hpc:Users ;
                 rdfs:range rdf:Resource .
hpc:Isincludedinlist rdfs:domain hpc:Users ;
                     rdfs:range rdf:Resource .
hpc:USERS_Description rdfs:datatype xsd:string .
hpc:LSFClusterAdmin rdf:type hpc:USERS ;
                     hpc:Isincludedinlist hpc:lsfclusteradmin .
