hpc:LsfLicenseScheduler a owl:Class .
hpc:installation a owl:ObjectProperty .
hpc:entitlementfile a owl:DatatypeProperty .
hpc:Webbasedui a owl:Class .
hpc:Applicationcenter a owl:Class .
hpc:Releasenotes a owl:Class .

hpc:LsfLicenseScheduler rdfs:subClassOf owl:Class .
hpc:Installation rdfs:domain hpc:LsfLicenseScheduler ;
                    rdfs:range rdf:Seq ;
                    rdfs:subPropertyOf owl:Action .
hpc:Entitlementfile rdfs:domain hpc:Installation ;
                    rdfs:range xsd:string .
hpc:Webbasedui rdfs:subClassOf owl:Class .
hpc:Applicationcenter rdfs:subClassOf hpc:Webbasedui .
hpc:Releasenotes rdfs:subClassOf owl:Class .
