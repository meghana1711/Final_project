hpc:Guaranteepool a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Configuration overview of guaranteed resource pools." .

hpc:simplifiedguaranteeparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "SIMPLIFIED_GUARANTEE parameter in the lsb.params file." .

hpc:loanpoliciesparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "LOAN_POLICIES parameter in the lsb.resources file." .

hpc:idlebuffer a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "Replaced RETAIN keyword in the GuaranteedResourcePool section of the lsb.resources file." .

hpc:hostclosing a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "Use multiple reasons to close hosts." .

hpc:lockid a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostclosing ;
    rdfs:range xsd:string ;
    rdfs:comment "Each lock ID is a string that can contain up to 128 alphanumeric and underscore (_) characters." .

hpc:hostclosingcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "Use the new -i option with the badmin hclose command when closing a host to specify a lock ID." .

hpc:stackedlockid a owl:ObjectProperty ;
    rdfs:domain hpc:Hostclosingcommand ;
    rdfs:range hpc:Lockid ;
    rdfs:comment "If the host is already closed, running badmin hclose -i lock_id stacks the new lock ID with any existing lock IDs on the closed host." .

hpc:Hostclosed a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a closed host." .

hpc:haslockid a owl:ObjectProperty ;
    rdfs:domain hpc:Hostclosed ;
    rdfs:range hpc:Lockid ;
    rdfs:comment "The lock ID attached to the closed host." .
