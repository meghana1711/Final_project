hpc:Job a owl:Class .
hpc:Burstbuffer a owl:Class .
hpc:configuringflag a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:runningstate a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstate .
hpc:burstbufferstate a owl:ObjectProperty ;
    rdfs:domain hpc:Burstbuffer ;
    rdfs:range hpc:Burstbufferstate .
hpc:JobState a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf owl:FunctionalProperty ;
    rdfs:range hpc:Jobstatetype ;
    owl:hasValue hpc:StageOut ;
    owl:hasValue hpc:Complete ;
    owl:hasValue hpc:Teardown ;
    owl:hasValue hpc:TeardownFail .
hpc:BurstBufferStateType a owl:Enum ;
    rdfs:subClassOf owl:Class ;
