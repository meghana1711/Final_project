hpc:Lsf a owl:Class .
hpc:Job a owl:Class .
hpc:Hungjob a owl:Class .
hpc:Unknownstate a owl:Class .
hpc:Exitstate a owl:Class .
hpc:Runlimit a owl:Class .
hpc:Hoststatusunreachable a owl:Class .
hpc:Hoststatusunavailable a owl:Class .
hpc:Operatingsystemissue a owl:Class .
hpc:Runstate a owl:Class .
hpc:run a owl:DatatypeProperty .
hpc:timeout a owl:DatatypeProperty .
hpc:removeHungJobsFor a owl:ObjectProperty .
hpc:hastimeout a owl:DatatypeProperty .
hpc:Job hasRunState rdfs:domain hpc:Job ;
    rdfs:range hpc:Runstate .
hpc:Job hasHostStatus rdfs:domain hpc:Job ;
    rdfs:range hpc:Hoststatusunreachable, hpc:Hoststatusunavailable .
hpc:Hoststatusunreachable rdfs:subClassOf hpc:Hoststatus .
hpc:Hoststatusunavailable rdfs:subClassOf hpc:Hoststatus .
hpc:Lsf rdfs:subClassOf owl:Class .
hpc:Lsf hasHungJob rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Hungjob .
hpc:Hungjob rdfs:subClassOf hpc:Job .
hpc:Lsf hasRemoveHungJobsFor rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .
