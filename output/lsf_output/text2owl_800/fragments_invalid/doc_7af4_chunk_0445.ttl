hpc:Preferencelevel a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Preferencelevel ;
    rdfs:range xsd:string .
hpc:Hostgroup a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Others a owl:Class ;
    rdfs:subClassOf hpc:Preferencelevel .
hpc:All a owl:Class ;
    rdfs:subClassOf hpc:Preferencelevel .
hpc:Allremote a owl:Class ;
    rdfs:subClassOf hpc:Preferencelevel ;
    rdfs:subClassOf hpc:All .
hpc:not a owl:ObjectProperty ;
    rdfs:domain hpc:All ;
    rdfs:range hpc:Hostname .
hpc:hasPreference an owl:DatatypeProperty ;
    rdfs:domain hpc:Preferencelevel ;
    rdfs:range xsd:nonNegativeInteger .
hpc:canrunon a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit, hpc:Hostgroup ;
    rdfs:range hpc:Hostname .
