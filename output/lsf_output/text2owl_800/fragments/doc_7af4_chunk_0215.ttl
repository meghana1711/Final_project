hpc:User a owl:Class .
hpc:Reservationusage a owl:Class .
hpc:reservationmethod a owl:ObjectProperty .
hpc:Resource a owl:Class .
hpc:reserve a owl:ObjectProperty .
hpc:ResourceMethod rdf:type owl:Enum;
                    rdfs:label "PER_JOB" ;
                    rdfs:comment "Reservation for a parallel job, LSF reserves one instance for each host." .
hpc:ResourceMethod rdf:type owl:Enum;
                    rdfs:label "PER_HOST" ;
                    rdfs:comment "Reservation means that for the parallel job, LSF reserves one instance for each host." .
hpc:ResourceMethod rdf:type owl:Enum;
                    rdfs:label "PER_TASK" ;
                    rdfs:comment "Reservation means that for the task, LSF reserves one instance." .
hpc:Reservation rdf:type owl:Class .
hpc:ReservableResource rdf:type owl:Class .
hpc:Reservableresource rdfs:subClassOf hpc:Resource .
hpc:ReservableResource rdfs:comment "The resource reservation method. Only the following built-in resources can be defined as reservable: mem, swp, tmp." .
hpc:Reservationusage rdfs:domain hpc:User .
hpc:Reservation rdfs:domain hpc:Reservationusage .
hpc:Reservation rdfs:range hpc:Reservationmethod .
hpc:Reservableresource rdfs:domain hpc:Reservation .
hpc:Reservableresource rdfs:range xsd:string .
