hpc:File a owl:Class .
hpc:Cachelocation hpc:File rdfs:domain hpc:File ;
    rdfs:range xsd:string .
hpc:Permission hpc:File rdfs:domain hpc:File ;
    rdfs:range xsd:string .
hpc:Size hpc:File rdfs:domain hpc:File ;
    rdfs:range xsd:decimal .
hpc:Modified hpc:File rdfs:domain hpc:File ;
    rdfs:range xsd:dateTime .
hpc:Cachelocation rdfs:subClassOf rdf:Resource .
hpc:Permission rdfs:subClassOf rdf:Resource .
hpc:Size rdfs:subClassOf rdf:Resource .
hpc:Modified rdfs:subClassOf rdf:Resource .
hpc:hash a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .
