hpc:Egroupexecutable a owl:Class .
hpc:hasgroupdefinitionfile a owl:ObjectProperty .
hpc:Groupdefinitionfile rdfs:domain hpc:Egroupexecutable ;
    rdfs:range rdf:Resource .
hpc:hasexclusionmark a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupdefinitionfile ;
    rdfs:range xsd:boolean .
hpc:isenabledforslascheduling a owl:DatatypeProperty ;
    rdfs:domain hpc:Egroupexecutable ;
    rdfs:range xsd:boolean .
hpc:isusedforhostgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Egroupexecutable ;
    rdfs:range hpc:Hostgroup .
hpc:isusedforusergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Egroupexecutable ;
    rdfs:range hpc:Usergroup .
hpc:Groupdefinitionfileparameter a owl:Class .
hpc:groupName a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupdefinitionfileparameter .
hpc:groupMember a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupdefinitionfileparameter .
hpc:Hostgroup a owl:Class .
hpc:Usergroup a owl:Class .
hpc:egroupUpdateInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lsbhosts a owl:Class .
hpc:Lsbusers a owl:Class .
hpc:lsbServerdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Egroupexecutable .
hpc:badminreconfigure a owl:ObjectProperty .
hpc:requiresreconfiguration a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:boolean .
hpc:hasgroupname a owl:ObjectProperty ;
    rdfs:domain hpc:Groupdefinitionfile ;
    rdfs:range hpc:Groupname .
hpc:Groupname a owl:Class .
