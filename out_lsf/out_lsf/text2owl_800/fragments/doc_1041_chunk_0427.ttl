hpc:Jobmodification a owl:Class .
hpc:Slamodification a owl:Class .
hpc:Serviceclassmodification a owl:Class .
hpc:Applicationprofilemodification a owl:Class .

hpc:hassla a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range hpc:Sla .

hpc:hasserviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Slamodification ;
    rdfs:range hpc:Serviceclass .

hpc:hasapplicationprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofilemodification ;
    rdfs:range hpc:Applicationprofile .

hpc:Sla a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .

hpc:Serviceclass a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Slamodification .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Applicationprofilemodification .

hpc:cannotuseslawithotheroptions a owl:ObjectProperty ;
    rdfs:domain hpc:Slamodification ;
    rdfs:range xsd:boolean .

hpc:cannotmodifyserviceclassofjob a owl:ObjectProperty ;
    rdfs:domain hpc:Slamodification ;
    rdfs:range xsd:boolean .

hpc:cannotmodifysatisfiedsla a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:boolean .

hpc:defaultslaattachment a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range hpc:Sla .

hpc:applicationprofileexistence a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofilemodification ;
    rdfs:range xsd:boolean .

hpc:pendingjobmodification a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofilemodification ;
    rdfs:range xsd:boolean .

hpc:Sla rdfs:range hpc:Sla .
hpc:Serviceclass rdfs:range hpc:Serviceclass .
hpc:Applicationprofile rdfs:range hpc:Applicationprofile .
