hpc:Jobslot a owl:Class .
hpc:Memoryreservation a owl:Class .
hpc:maxreservetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryreservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:backfill a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:Job .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Resourcerequirement a owl:Class .
hpc:reserveturn a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:compoundresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement .
hpc:alternativeresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    owl:hasBackfillJob hpc:Backfill .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .
