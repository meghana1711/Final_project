hpc:Scrunnode a owl:Class .
hpc:scrunscript a owl:ObjectProperty ;
    rdfs:domain hpc:Scrunnode ;
    rdfs:range xsd:string .

hpc:Ociconfig a owl:Class .
hpc:containerjob a owl:ObjectProperty ;
    rdfs:domain hpc:Ociconfig ;
    rdfs:range xsd:string .

hpc:Jwtauthnotsupported a owl:Class .
hpc:hostnetworkingrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:boolean .

hpc:Podmanexecnotsupported a owl:Class .
hpc:Podmancomposenotsupported a owl:Class ;
    rdfs:subClassOf hpc:Podmanexecnotsupported .
hpc:partialimplementation a owl:ObjectProperty ;
    rdfs:domain hpc:Podmancomposenotsupported ;
    rdfs:range xsd:string .

hpc:Somecompositionsmaywork a owl:Class ;
    rdfs:subClassOf hpc:Podmancomposenotsupported .
hpc:differentnodes a owl:ObjectProperty ;
    rdfs:domain hpc:Somecompositionsmaywork ;
    rdfs:range xsd:boolean .

hpc:networkmodehostdevice a owl:ObjectProperty ;
    rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .

