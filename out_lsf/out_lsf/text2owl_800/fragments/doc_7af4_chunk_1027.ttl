hpc:lsbDebugSch a owl:DatatypeProperty .
hpc:LsbDefaultJobgroup a owl:Class .
hpc:Hasjobgroupname rdfs:domain hpc:LsbDefaultJobgroup ;
                     rdfs:range xsd:string .
hpc:Jobgroupname rdfs:range xsd:string .
hpc:jobgroupname a owl:DatatypeProperty .
hpc:jobGroupName rdfs:subPropertyOf hpc:hasJobGroupName .
hpc:Jobgroupnamestartswith rdfs:domain hpc:LsbDefaultJobgroup ;
                          rdfs:range xsd:string .
hpc:jobGroupNameStartsWith rdf:value "/" .
hpc:Jobgroupnameendswith rdfs:domain hpc:LsbDefaultJobgroup ;
                         rdfs:range xsd:string .
hpc:jobGroupNameEndsWith rdf:value "" .
hpc:Jobgroupnamehasslash rdfs:domain hpc:LsbDefaultJobgroup ;
                         rdfs:range xsd:boolean .
hpc:jobGroupNameHasSlash rdf:value "false" .
hpc:Jobgroupnamehasslashinarow rdfs:domain hpc:LsbDefaultJobgroup ;
                               rdfs:range xsd:boolean .
hpc:jobGroupNameHasSlashInARow rdf:value "false" .
