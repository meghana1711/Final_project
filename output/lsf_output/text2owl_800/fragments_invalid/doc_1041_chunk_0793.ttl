hpc:Lsgrun a owl:Class ;
    rdfs:subClassOf hpc:Globaloperation .

hpc:commandlineargument a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string .

hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string .

hpc:hostfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string .

hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string .

hpc:numhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:integer .

hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range r15s:PG .

hpc:commandprompt a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:string .

hpc:lsbdisablelimlockexcl a owl:ObjectProperty ;
    rdfs:domain hpc:Lsgrun ;
    rdfs:range xsd:boolean .
