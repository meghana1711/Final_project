hpc:FairshareGroups a owl:Class .
hpc:accessControl a owl:ObjectProperty .
hpc:autoAttach a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:name a owl:DatatypeProperty .
hpc:priority a owl:DatatypeProperty .
hpc:UserGroup a owl:Class .

hpc:FairshareGroups rdfs:subClassOf hpc:UserGroup .
hpc:AccessControl rdfs:domain hpc:FairshareGroups ;
                     rdfs:range rdf:List ;
                     rdfs:subPropertyOf hpc:ACCESS_CONTROL .
hpc:AutoAttach rdfs:domain hpc:FairshareGroups ;
                 rdfs:range xsd:boolean .
hpc:Description rdfs:domain hpc:FairshareGroups ;
                 rdfs:range xsd:string .
hpc:Name rdfs:domain hpc:FairshareGroups ;
             rdfs:range xsd:string .
hpc:Priority rdfs:domain hpc:FairshareGroups ;
             rdfs:range xsd:integer .
