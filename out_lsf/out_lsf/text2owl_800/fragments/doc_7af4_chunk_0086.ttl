hpc:InfinitInt a owl:Class .
hpc:maxJobRequeue a owl:DatatypeProperty ;
    rdfs:domain hpc:InfinitInt ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of times to requeue a job automatically. Valid values 0 < MAX_JOB_REQUEUE < INFINIT_INT" .

hpc:MAX_JOB_REQUEUE_DEFAULT a owl:NamedIndividual ;
    hpc:MAX_JOB_REQUEUE "Not defined" .

hpc:INFINIT_INT_DEFAULT a owl:NamedIndividual ;
    hpc:INFINIT_INT "Not defined" .

hpc:maxPreexecRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of times to attempt the pre-execution command of a job from a remote cluster. If the job's pre-execution command fails all attempts, the job is returned to the submission cluster." .

hpc:remoteMaxPreexecRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Use this instead of MAX_PREEXEC_RETRY. Job forwarding model for the LSF multicluster capability only." .
