@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Workloadsnapshotmodificationscript a owl:Class .
hpc:Workloadsnapshotplugin a owl:Class .

hpc:lsbSubBegin a owl:ObjectProperty .
hpc:LsbSubBegin rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                   rdfs:range xsd:integer .

hpc:lsbSubChkpDir a owl:ObjectProperty .
hpc:LsbSubChkpDir rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                      rdfs:range xsd:string .

hpc:lsbSubCommandLine a owl:ObjectProperty .
hpc:LsbSubCommandLine rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                          rdfs:range xsd:string .

hpc:lsbSubChkpPeriod a owl:ObjectProperty .
hpc:LsbSubChkpPeriod rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                         rdfs:range xsd:string .

hpc:lsbSubDependCond a owl:ObjectProperty .
hpc:LsbSubDependCond rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                         rdfs:range xsd:string .

hpc:lsbSubErrFile a owl:ObjectProperty .
hpc:LsbSubErrFile rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                      rdfs:range xsd:string .

hpc:lsbSubExclusive a owl:ObjectProperty .
hpc:LsbSubExclusive rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                       rdfs:range xsd:boolean .

hpc:lsbSubHold a owl:ObjectProperty .
hpc:LsbSubHold rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                 rdfs:range xsd:boolean .

hpc:lsbSubHostSpec a owl:ObjectProperty .
hpc:LsbSubHostSpec rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                      rdfs:range xsd:string .

hpc:lsbSubHosts a owl:ObjectProperty .
hpc:LsbSubHosts rdfs:domain hpc:Workloadsnapshotmodificationscript ;
                  rdfs:range xsd:string .

hpc:lsbSubInFile a owl:ObjectProperty
