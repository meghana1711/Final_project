hpc:Gpu a owl:Class .
hpc:gpuReq a owl:ObjectProperty .
hpc:gpuVersion a owl:DatatypeProperty .
hpc:gpuModel a owl:DatatypeProperty .
hpc:gpuCount a owl:DatatypeProperty .
hpc:gpuClockspeed a owl:DatatypeProperty .
hpc:gpuManufacturer a owl:DatatypeProperty .
hpc:Host a owl:Class .
hpc:GpuReqSyntax a owl:Class .
hpc:GpuReqSyntax rdfs:subClassOf hpc:GpuReq .
hpc:GpuReqSyntax rdfs:domain hpc:Gpu .
hpc:GpuReqSyntax rdfs:range xsd:string .
hpc:CompoundGpuReq a owl:Class .
hpc:CompoundGpuReq rdfs:subClassOf hpc:GpuReq .
hpc:CompoundGpuReq rdfs:domain hpc:Gpu .
hpc:AlternativeGpuReq a owl:Class .
hpc:AlternativeGpuReq rdfs:subClassOf hpc:GpuReq .
hpc:AlternativeGpuReq rdfs:domain hpc:Gpu .

hpc:TeslaK20c a hpc:GPU ;
    hpc:GPU_Model "TeslaK20c" ;
    hpc:GPU_Version "384.10" ;
    hpc:GPU_Count xsd:integer "1" ;
    hpc:GPU_ClockSpeed xsd:integer "70" ;
    hpc:GPU_Manufacturer "Nvidia" .

hpc:TeslaK80c a hpc:GPU ;
    hpc:GPU_Model "TeslaK80c" ;
    hpc:GPU_Version "384.10" ;
    hpc:GPU_Count xsd:integer "1" ;
    hpc:GPU_ClockSpeed xsd:integer "90" ;
    hpc:GPU_Manufacturer "Nvidia" .

hpc:Vega10_RadeonIn a hpc:GPU ;
    hpc:GPU_Model "Vega10_RadeonIn" ;
    hpc:GPU_Version "5.6.12" ;
    hpc:GPU_Count xsd:integer "0" ;
    hpc:GPU_Manufacturer "AMD" .

hpc:hostb a hpc:Host .
hpc:hostc a hpc:Host .

