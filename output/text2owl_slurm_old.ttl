# Fragment: job_state_codes.chunk00001.ttl
hpc:Job a owl:Class .
hpc:JobState a owl:Class .
hpc:JobFlag a owl:Class .

hpc:hasJobState a owl:ObjectProperty .
hpc:hasJobFlag a owl:ObjectProperty .

hpc:JobState rdfs:subClassOf hpc:Job .
hpc:JobFlag rdfs:subClassOf hpc:Job .

hpc:BOOT_FAIL a hpc:JobState ;
  rdfs:label "terminated due to node boot failure" .
hpc:CANCELLED a hpc:JobState ;
  rdfs:label "cancelled by user or administrator" .
hpc:COMPLETED a hpc:JobState ;
  rdfs:label "completed execution successfully; finished with an exit code of zero on all nodes" .
hpc:DEADLINE a hpc:JobState ;
  rdfs:label "terminated due to reaching the latest acceptable start time specified for the job" .
hpc:FAILED a hpc:JobState ;
  rdfs:label "completed execution unsuccessfully; non-zero exit code or other failure condition" .
hpc:NODE_FAIL a hpc:JobState ;
  rdfs:label "terminated due to node failure" .
hpc:OUT_OF_MEMORY a hpc:JobState ;
  rdfs:label "experienced out of memory error" .
hpc:PENDING a hpc:JobState ;
  rdfs:label "queued and waiting for initiation; will typically have a reason code specifying why it has not yet started" .
hpc:PREEMPTED a hpc:JobState ;
  rdfs:label "terminated due to preemption; may transition to another state based on the configured PreemptMode and job characteristics" .
hpc:RUNNING a hpc:JobState ;
  rdfs:label "allocated resources and executing" .
hpc:SUSPENDED a hpc:JobState ;
  rdfs:label "allocated resources but execution suspended, such as from preemption or a direct request from an authorized user" .
hpc:TIMEOUT a hpc:JobState ;
  rdfs:label "terminated due to reaching the time limit, such as those configured in slurm.conf or specified for the individual job" .

hpc:COMPLETING a hpc:JobFlag ;
  rdfs:label "job has finished or been cancelled and is performing cleanup tasks, including the epilog script if present" .
hpc:CONFIGURING a hpc:JobFlag ;
  rdfs:label "job has been allocated nodes and is waiting for them to boot or reboot" .
hpc:LAUNCH_FAILED a h

# Fragment: job_submit_plugins.chunk00001.ttl
# Slurm Workload Manager
hpc:SlurmWorkloadManager a owl:Class .

# Plugin
hpc:Plugin a owl:Class ;
  rdfs:subClassOf hpc:SlurmWorkloadManager ;
  rdfs:comment "A plugin for Slurm Workload Manager." .

hpc:pluginName a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range xsd:string .

hpc:pluginType a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range xsd:string .

hpc:pluginVersion a xsd:unsignedInt .

# Job Submit Plugin
hpc:JobSubmitPlugin a owl:Class ;
  rdfs:subClassOf hpc:Plugin .

hpc:init a owl:ObjectProperty ;
  rdfs:domain hpc:JobSubmitPlugin ;
  rdfs:range xsd:integer .

hpc:fini a owl:ObjectProperty ;
  rdfs:domain hpc:JobSubmitPlugin ;
  rdfs:range xsd:void .

hpc:job_submit a owl:ObjectProperty ;
  rdfs:domain hpc:JobSubmitPlugin ;
  rdfs:range xsd:integer .

hpc:job_modify a owl:ObjectProperty ;
  rdfs:domain hpc:JobSubmitPlugin ;
  rdfs:range xsd:integer .

# Lua Functions
hpc:LuaFunction a owl:Class ;
  rdfs:subClassOf hpc:JobSubmitPlugin .
```

# Fragment: job_submit_plugins.chunk00002.ttl
hpc:JobDescription a owl:Class .
hpc:environment a owl:DatatypeProperty .
hpc:max_nodes a owl:DatatypeProperty .
hpc:slurm_job_submit a owl:ObjectProperty .
hpc:slurm_job_modify a owl:ObjectProperty .
hpc:part_list a owl:ObjectProperty .
hpc:submit_uid a xsd:integer .
hpc:job_ptr a owl:ObjectProperty .
hpc:modify_uid a xsd:integer .

hpc:JobAllocationRequest a owl:Class, rdfs:subClassOf [ a owl:Restriction ;
                                                         rdfs:onProperty hpc:max_nodes ;
                                                         rdfs:hasValue xsd:integer ] .
```

This ontology fragment represents the classes `JobDescription`, `JobAllocationRequest`, and the properties `environment`, `max_nodes`, `slurm_job_submit`, `slurm_job_modify`, `part_list`, `submit_uid`, `job_ptr`, and `modify_uid`. The `JobAllocationRequest` class is a subclass of a restricted `JobDescription` class, where the `max_nodes` property must have a value of type `xsd:integer`.

