hpc:WCKeyResponse a owl:Class .
hpc:WCKeyRemovedResponse a hpc:WCKeyResponse ;
    rdfs:subClassOf hpc:WCKeyResponse .
hpc:WCKeyAddedResponse a hpc:WCKeyResponse ;
    rdfs:subClassOf hpc:WCKeyResponse .

hpc:hasContent a owl:ObjectProperty ;
    rdfs:domain hpc:Response ;
    rdfs:range rdf:Resource .

hpc:contentJsonRequest a owl:DatatypeProperty ;
    rdfs:domain hpc:Content ;
    rdfs:range xsd:anyURI .

hpc:contentXYAML a owl:DatatypeProperty ;
    rdfs:domain hpc:Content ;
    rdfs:range xsd:anyURI .

hpc:contentTextYAML a owl:DatatypeProperty ;
    rdfs:domain hpc:Content ;
    rdfs:range xsd:anyURI .

hpc:contentApplicationYAML a owl:DatatypeProperty ;
    rdfs:domain hpc:Content ;
    rdfs:range xsd:anyURI .

hpc:schema a owl:ObjectProperty ;
    rdfs:domain hpc:Content ;
    rdfs:range rdf:Resource .

hpc:ref a owl:DatatypeProperty ;
    rdfs:domain hpc:Schema ;
    rdfs:range rdf:Resource .
