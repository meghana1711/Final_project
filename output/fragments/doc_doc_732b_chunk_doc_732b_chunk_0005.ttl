hpc:User a owl:Class .
hpc:AllowedUser a owl:Class .
hpc:AdminUser a owl:Class, hpc:User .
hpc:GroupMember a owl:Class .
hpc:PAMModule a owl:Class .
hpc:ConfigurableModule a owl:Class .

hpc:hasUser a owl:ObjectProperty .
hpc:hasGroup a owl:ObjectProperty .
hpc:hasFile a owl:ObjectProperty .
hpc:hasOption a owl:ObjectProperty .
hpc:hasAction a owl:ObjectProperty .

hpc:User rdfs:subClassOf hpc:AllowedUser .
hpc:AdminUser rdfs:subClassOf hpc:AllowedUser .

hpc:PAMModule rdfs:subClassOf hpc:ConfigurableModule .

hpc:hasUser rdfs:domain hpc:AllowedUser ;
             rdfs:range hpc:User .
hpc:hasGroup rdfs:domain hpc:AllowedUser ;
             rdfs:range hpc:GroupMember .
hpc:hasFile rdfs:domain hpc:PAMModule .
hpc:hasOption rdfs:domain hpc:ConfigurableModule ;
             rdfs:range xsd:string .
hpc:hasAction rdfs:domain hpc:ConfigurableModule ;
             rdfs:range xsd:string .

hpc:sufficient a owl:ObjectProperty .
hpc:required a owl:ObjectProperty .
hpc:session a owl:ObjectProperty .
hpc:success a owl:ObjectProperty .
hpc:ignore a owl:ObjectProperty .
hpc:default a owl:ObjectProperty .
hpc:onerr a owl:ObjectProperty .
hpc:sense a owl:ObjectProperty .
hpc:item a owl:ObjectProperty .

hpc:sufficient rdfs:domain hpc:PAMModule ;
             rdfs:range hpc:PAMModule .
hpc:required rdfs:domain hpc:PAMModule ;
             rdfs:range hpc:PAMModule .
hpc:session rdfs:domain hpc:PAMModule ;
             rdfs:range hpc:PAMModule .
hpc:success rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:integer .
hpc:ignore rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:integer .
hpc:default rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:integer .
hpc:onerr rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:string .
hpc:sense rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:string .
hpc:item rdfs:domain hpc:PAMModule ;
             rdfs:range xsd:string .

hpc:action_no_jobs a owl:DatatypeProperty .
hpc:action_no_jobs rdfs:domain hpc:ConfigurableModule ;
             rdfs:range xsd:string .
```
