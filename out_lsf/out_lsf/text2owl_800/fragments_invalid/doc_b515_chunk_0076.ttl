hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:CPUBinding an owl:ObjectProperty .
hpc:MemoryBinding an owl:ObjectProperty .
hpc:HostType an owl:Class .
hpc:Level an owl:Class .
hpc:Exclusive an owl:Class .
hpc:Shared an owl:Class .
hpc:CPU an owl:Class .
hpc:CPUBind an owl:ObjectProperty .
hpc:CpuBindSocket an owl:ObjectProperty .
hpc:CpuBindCore an owl:ObjectProperty .
hpc:Numa an owl:Class .
hpc:NumaSize xsd:string .
hpc:NumaID xsd:integer .
hpc:NumaPol xsd:string .

hpc:Job rdfs:subClassOf hpc:Resource .
hpc:Host rdfs:subClassOf hpc:Resource .
hpc:Socket rdfs:subClassOf hpc:Host .
hpc:Core rdfs:subClassOf hpc:Socket .
hpc:Cpu rdfs:subClassOf hpc:Core .

hpc:Cpubinding rdfs:domain hpc:Job ;
               rdfs:range hpc:Cpu .
hpc:Memorybinding rdfs:domain hpc:Job ;
               rdfs:range hpc:Memory .
hpc:Cpubindsocket rdfs:domain hpc:Cpu ;
               rdfs:range hpc:Socket .
hpc:Cpubindcore rdfs:domain hpc:Cpu ;
               rdfs:range hpc:Core .

hpc:Hosttype rdfs:subClassOf hpc:Host .
hpc:Level rdfs:subClassOf hpc:Hosttype .
hpc:Exclusive rdfs:subClassOf hpc:Level .
hpc:Shared rdfs:subClassOf hpc:Level .

hpc:Numa rdfs:subClassOf hpc:Socket .
hpc:Numasize rdfs:domain hpc:Numa ;
             rdfs:range xsd:string .
hpc:Numaid rdfs:domain hpc:Numa ;
             rdfs:range xsd:integer .
hpc:Numapol rdfs:domain hpc:Numa ;
             rdfs:range xsd:string .
