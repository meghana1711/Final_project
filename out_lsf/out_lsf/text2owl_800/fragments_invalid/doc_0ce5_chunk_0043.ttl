hpc:Mbatchd a owl:Class .
hpc:maxjobnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .
hpc:minswitchperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Eventswitchingprocess a owl:Class ;
