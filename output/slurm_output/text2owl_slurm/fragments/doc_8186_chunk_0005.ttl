hpc:Jwtauthentication a owl:Class .
hpc:Slurmuser a owl:Class .
hpc:Rootuser a owl:Class .
hpc:Proxyuser a owl:Class .
hpc:Slurmrestd a owl:Class .
hpc:Unixdomainsocketauthentication a owl:Class .
hpc:Slurmconf a owl:Class .
hpc:Slurmdbdconf a owl:Class .
hpc:xslurmusername a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwtauthentication ;
    rdfs:range xsd:string .
hpc:xslurmusertoken a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwtauthentication ;
    rdfs:range xsd:string .
hpc:slurmjwt a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range hpc:Jwtauthentication .
hpc:authalttypes a owl:DatatypeProperty ;
    rdfs:domain (hpc:Slurmconf hpc:Slurmdbdconf) ;
    rdfs:range xsd:string .
hpc:localauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range hpc:Unixdomainsocketauthentication .
hpc:Mungesecuritydomain a owl:Class .
hpc:slurmrestdinmungedomain a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range hpc:Mungesecuritydomain .
hpc:Authenticatingproxy a owl:Class .
hpc:jwttokenforslurmuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Authenticatingproxy ;
    rdfs:range xsd:string .
hpc:proxyforuser a owl:ObjectProperty ;
    rdfs:domain hpc:Authenticatingproxy ;
    rdfs:range hpc:Proxyuser .
hpc:allowedforslurmuser a owl:ObjectProperty ;
    rdfs:domain hpc:Authenticatingproxy ;
    rdfs:range hpc:Slurmuser .
hpc:allowedforroot a owl:ObjectProperty ;
    rdfs:domain hpc:Authenticatingproxy ;
    rdfs:range hpc:Rootuser .
