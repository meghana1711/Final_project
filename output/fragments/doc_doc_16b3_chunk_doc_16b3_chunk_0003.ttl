hpc:Job a owl:Class .
hpc:JobStep a owl:Class, rdfs:subClassOf hpc:Job .
hpc:JobAllocation a owl:Class .
hpc:Node a owl:Class .
hpc:GRES a owl:Class .
hpc:Design a owl:Class .

hpc:hasAllocation a owl:ObjectProperty .
hpc:hasNode a owl:ObjectProperty .
hpc:hasStep a owl:ObjectProperty .
hpc:hasGRES a owl:ObjectProperty .
hpc:hasDesign a owl:ObjectProperty .

hpc:index a owl:DatatypeProperty .
hpc:allocatedGRES a owl:DatatypeProperty .
hpc:credential a owl:DatatypeProperty .

hpc:index rdfs:domain hpc:JobAllocation ;
        rdfs:range xsd:integer .
hpc:allocatedGRES rdfs:domain hpc:Job ;
        rdfs:range hpc:GRES .
hpc:credential rdfs:domain hpc:Job ;
        rdfs:range xsd:string .
```
