hpc:Lsfserverhost a owl:Class .
hpc:Singularityapplicationprofile a owl:Class .
hpc:Singularityqueue a owl:Class .
hpc:Singularityjob a owl:Class .
hpc:containerconfiguration a owl:ObjectProperty .
hpc:Containerconfiguration rdfs:domain hpc:Singularityapplicationprofile .
hpc:Containerconfiguration rdfs:domain hpc:Singularityqueue .
hpc:Container rdfs:range xsd:string .
hpc:mpienvironment a owl:ObjectProperty .
hpc:Mpienvironment rdfs:domain hpc:Singularityjob .
hpc:Mpienvironment rdfs:range xsd:string .
hpc:singularityversion a owl:DatatypeProperty .
hpc:Singularityversion rdfs:domain hpc:Lsfserverhost .
hpc:Singularityversion rdfs:range xsd:string .
hpc:apptainername a owl:DatatypeProperty .
hpc:Apptainername rdfs:domain hpc:Singularityapplicationprofile .
hpc:Apptainername rdfs:range xsd:string .
hpc:Singularityapplicationprofile rdfs:subClassOf hpc:Lsfjobprofile .
hpc:Singularityqueue rdfs:subClassOf hpc:Lsfbatchqueue .
hpc:Singularityjob rdfs:subClassOf hpc:Lsfjob .
