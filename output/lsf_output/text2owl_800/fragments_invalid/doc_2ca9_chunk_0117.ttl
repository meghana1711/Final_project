hpc:Jobprevention a owl:Class .
hpc:SNDJOBS_TO rdf:datatype xsd:string ;
    rdfs:domain hpc:Jobprevention ;
    rdfs:range hpc:Executioncluster .

hpc:Jobsubmissionlimit a owl:Class .
hpc:queue rdf:datatype xsd:string ;
    rdfs:domain hpc:Jobsubmissionlimit ;
    rdfs:range hpc:Queue .

hpc:Multiclusterqueue a owl:Class .

hpc:FWD_USERS rdf:datatype xsd:string ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Samestring a owl:Class .

hpc:Advancereservation a owl:Class .
hpc:resourceRequirement rdf:datatype xsd:string ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Resourcerequirementstring .

hpc:Applicationprofile a owl:Class .
hpc:Priority rdf:datatype xsd:float ;
    rdfs:domain hpc:Applicationprofile .

hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Priority rdf:datatype xsd:float ;
    rdfs:domain hpc:User ;
    rdfs:domain hpc:Usergroup .

hpc:bjobsprio a owl:ObjectProperty .
    rdfs:domain hpc:Pendingjob .
