# Fragment: add.chunk00001.ttl
hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD rdf:type owl:NamedIndividual ;
    rdf:type hpc:SlurmWorkloadManager .

hpc:Version a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager .

hpc:Overview a owl:Class .
hpc:ReleaseNotes a owl:Class .
hpc:Documentation a owl:Class .
hpc:FAQ a owl:Class .
hpc:Publications a owl:Class .
hpc:Installing a owl:Class .
hpc:Download a owl:Class .
hpc:RelatedSoftware a owl:Class .
hpc:InstallationGuide a owl:Class .
hpc:GettingHelp a owl:Class .
hpc:MailingLists a owl:Class .
hpc:SupportAndTraining a owl:Class .
hpc:Troubleshooting a owl:Class .
hpc:AddingFilesOrPluginsToSlurm a owl:Class .
hpc:AddingFileToSlurm a owl:Class .
hpc:AddingPluginToSlurm a owl:Class .

hpc:AddFileToSlurm a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range rdf:Seq ;
        rdf:first hpc:addToGitRepository ;
        rdf:rest [ rdf:type owl:ObjectProperty ;
                    rdf:subPropertyOf hpc:AddFileToSlurm ;
                    rdf:first hpc:modifyMakefileAM ;
                    rdf:rest [ rdf:type owl:ObjectProperty ;
                                rdf:subPropertyOf hpc:AddFileToSlurm ;
                                rdf:first hpc:executeAutoreconf ;
                                rdf:rest [ rdf:type owl:ObjectProperty ;
                                            rdf:subPropertyOf hpc:AddFileToSlurm ;
                                            rdf:first hpc:modifyMakefileIn ] ] ] .

hpc:AddPluginToSlurm a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range rdf:Seq ;
        rdf:first hpc:createNewDirectory ;
        rdf:rest [ rdf:type owl:ObjectProperty ;
                    rdf:subPropertyOf hpc:AddPluginToSlurm ;
                    rdf:first hpc:addToParentDirectoryMakefileAM ;
                    rdf:rest [ rdf:type owl:ObjectProperty ;
                                rdf:subPropertyOf hpc:AddPluginToSlurm ;
                                rdf:first hpc:putNewFile ;
                                rdf:rest [ rdf:type owl:ObjectProperty ;
                                            rdf:subPropertyOf hpc:AddPluginToSlurm ;
                                            rdf:first hpc:createMakefileAM ;
                                            rdf:rest [ rdf:type owl:ObjectProperty ;
                                                        rdf:subPropertyOf hpc:AddPluginToSlurm ;
                                                        rdf:first hpc:identifyNewMakefile ;

# Fragment: api.chunk00001.ttl
hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD rdf:type owl:NamedIndividual ;
    hpc:isVersion "25.05" .

hpc:Overview rdf:type owl:Class .
hpc:ReleaseNotes rdf:type owl:Class ;
    rdfs:subClassOf hpc:Overview .
hpc:Using rdf:type owl:Class .
hpc:Documentation rdf:type owl:Class ;
    rdfs:subClassOf hpc:Using .
hpc:FAQ rdf:type owl:Class ;
    rdfs:subClassOf hpc:Using .
hpc:Publications rdf:type owl:Class ;
    rdfs:subClassOf hpc:Using .
hpc:Installing rdf:type owl:Class .
hpc:Download rdf:type owl:Class ;
    rdfs:subClassOf hpc:Installing .
hpc:RelatedSoftware rdf:type owl:Class ;
    rdfs:subClassOf hpc:Installing .
hpc:InstallationGuide rdf:type owl:Class ;
    rdfs:subClassOf hpc:Installing .
hpc:GettingHelp rdf:type owl:Class .
hpc:MailingLists rdf:type owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .
hpc:SupportAndTraining rdf:type owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .
hpc:Troubleshooting rdf:type owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .
hpc:SlurmAPIs rdf:type owl:Class .

hpc:slurmAPIsHasCommand a owl:ObjectProperty .
hpc:slurmAPIsHasCommand rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range rdf:Resource .

hpc:slurmAPIsIsFixed a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:boolean .

hpc:slurmAPIsChangesBetweenMajorRelease a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:boolean .

hpc:slurmAPIsEncouragesTarget rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range rdf:Resource .

hpc:slurmAPIsProvidesForBroaderCrossVersionCompatibility a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmAPIs ;
    rdfs:range xsd:boolean .

hpc:slurmAPIsLastModified a xsd:date ;
    rdfs:domain hpc:SlurmAPIs .
