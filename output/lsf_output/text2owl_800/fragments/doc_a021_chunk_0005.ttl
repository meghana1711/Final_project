hpc:Resourceclass a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceclass ;
    rdfs:range xsd:string .

hpc:resourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceclass ;
    rdfs:range xsd:string .

hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceclass ;
    rdfs:range xsd:string .

hpc:increasing a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceclass ;
    rdfs:range xsd:boolean .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceclass ;
    rdfs:range xsd:string .

hpc:OpenStackHost a hpc:ResourceClass ;
    hpc:ResourceName "openstackhost" ;
    hpc:ResourceType xsd:boolean ;
    hpc:Interval "" ;
    hpc:Increasing false ;
    hpc:Description "Hosts borrowed from OpenStack" .

hpc:Awshost a hpc:ResourceClass ;
    hpc:ResourceName "awshost" ;
    hpc:ResourceType xsd:boolean ;
    hpc:Interval "" ;
    hpc:Increasing false ;
    hpc:Description "Hosts borrowed from AWS" .

hpc:Azurehost a hpc:ResourceClass ;
    hpc:ResourceName "azurehost" ;
    hpc:ResourceType xsd:boolean ;
    hpc:Interval "" ;
    hpc:Increasing false ;
    hpc:Description "instances borrowed from Azure" .

hpc:Googlehost a hpc:ResourceClass ;
    hpc:ResourceName "googlehost" ;
    hpc:ResourceType xsd:boolean ;
    hpc:Interval "" ;
    hpc:Increasing false ;
    hpc:Description "Hosts borrowed from Google Compute Cloud" .

hpc:lsbrcexternalhostflag a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

hpc:Lsbrcqueues a owl:Class .

hpc:rchosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbrcqueues ;
    rdfs:range xsd:string .

hpc:Awsexample a hpc:LsbRcQueues ;
    hpc:RcHosts "awshost" .
