hpc:Lsflicensescheduler a owl:Class .
hpc:lmType a owl:DatatypeProperty .
hpc:name a owl:ObjectProperty .
hpc:remoteLmstatServers a owl:ObjectProperty .
hpc:HostName rdfs:domain hpc:RemoteLmstatServers ;
    rdfs:range xsd:string .
hpc:PortNumber rdfs:domain hpc:LicServers ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LicServers a owl:Class .
hpc:FLEXLM a owl:NamedIndividual ;
    hpc:LM_TYPE xsd:string "FLEXLM" .
hpc:RLM a owl:NamedIndividual ;
    hpc:LM_TYPE xsd:string "RLM" .
hpc:Servicedomain a owl:Class .
hpc:ProjectModeOrClusterMode rdfs:subClassOf hpc:Servicedomain ;
    rdfs:comment "Used for both project mode and cluster mode." .
