hpc:Elim a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "An elim program." .

hpc:sectionelimargs a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string ;
    rdfs:comment "The command-line arguments that are required by an elim on startup." .

hpc:elimPollInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The frequency with which the LIM samples external load index information from the MELIM." .

hpc:ELIM_POLL_INTERVAL_UNITS a xsd:string ;
    rdfs:comment "The units of ELIM_POLL_INTERVAL." .

hpc:ElimPollIntervalUnits rdfs:subClassOf xsd:string ;

hpc:lsfElimBlocktime a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:decimal ;
    rdfs:comment "UNIX only. Specifies how long the MELIM waits before restarting an elim that fails to send a complete load update string." .

hpc:LSF_ELIM_BLOCKTIME_UNITS a xsd:string ;
    rdfs:comment "The units of LSF_ELIM_BLOCKTIME." .

hpc:LsfElimBlocktimeUnits rdfs:subClassOf xsd:string ;

hpc:lsfElimDebug a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string ;
    rdfs:comment "UNIX only. Used for debugging; logs all load information received from elim executables to the MELIM log file (melim.log.host_name)." .

hpc:lsfElimRestarts a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:integer ;
    rdfs:comment "UNIX only. Limits the number of times an elim can be restarted." .

hpc:LSF_ELIM_RESTARTS_LIMIT a xsd:integer ;
    rdfs:comment "The limit of LSF_ELIM_RESTARTS." .

hpc:LsfElimRestartsLimit rdfs:subClassOf xsd:integer ;

hpc:lsfElimDebugOrLsfElimBlocktime a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range hpc:LsfElimDebugOrLsfElimBlocktimeOption ;
    rdfs:comment "You must also define either LSF_ELIM_DEBUG or LSF_ELIM_BLOCKTIME. Defining this parameter prevents an ongoing restart loop in the case of a faulty elim." .

hpc:LsfElimDebugOrLsfElimBlocktimeOption a owl:Class ;
    rd
