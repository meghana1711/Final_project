hpc:Mbatchd a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Platformmulticluster a owl:Class .
hpc:Platformconfiguration a owl:Class .
hpc:Localcluster a owl:Class .
hpc:Remotecluster a owl:Class .
hpc:internalinterval a owl:ObjectProperty .
hpc:Internalinterval rdfs:domain hpc:Platformmulticluster ;
                          rdfs:range xsd:integer .
hpc:communicationinterval a owl:ObjectProperty .
hpc:Communicationinterval rdfs:domain hpc:Platformconfiguration ;
                             rdfs:range xsd:integer .
hpc:cacheinterval a owl:DatatypeProperty .
hpc:Cacheinterval rdfs:domain hpc:Platformconfiguration ;
                     rdfs:range xsd:integer .
hpc:maximumdelay a owl:DatatypeProperty .
hpc:Maximumdelay rdfs:domain hpc:Platformconfiguration ;
                    rdfs:range xsd:duration .
hpc:Lsf a owl:Class .
hpc:ncpus a owl:DatatypeProperty .
hpc:Ncpus rdfs:domain hpc:Lsf ;
              rdfs:range xsd:nonNegativeInteger .
hpc:maxmem a owl:DatatypeProperty .
hpc:Maxmem rdfs:domain hpc:Lsf ;
              rdfs:range xsd:nonNegativeInteger .
hpc:maxswp a owl:DatatypeProperty .
hpc:Maxswp rdfs:domain hpc:Lsf ;
              rdfs:range xsd:nonNegativeInteger .
hpc:maxtmp a owl:DatatypeProperty .
hpc:Maxtmp rdfs:domain hpc:Lsf ;
              rdfs:range xsd:nonNegativeInteger .
hpc:licensing a owl:ObjectProperty .
hpc:Licensing rdfs:domain hpc:Lsf ;
              rdfs:range hpc:Lsflicensing .
hpc:Lsflicensing a owl:Class .
hpc:perhostorperqueueloadthresholds a owl:ObjectProperty .
hpc:Perhostorperqueueloadthresholds rdfs:domain hpc:Lsf ;
                                      rdfs:range hpc:Loadthreshold .
hpc:Loadthreshold a owl:Class .
hpc:effectiverunqueuelength a owl:DatatypeProperty .
hpc:Effectiverunqueuelength rdfs:domain hpc:Loadthreshold ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:r15s a owl:DatatypeProperty .
hpc:R15s rdfs:domain hpc:Loadthreshold ;
              rdfs:range xsd:nonNegativeInteger .
hpc:r1m a owl:DatatypeProperty .
hpc:R1m rdfs:domain hpc:Loadthreshold ;
              rdfs:range xsd:nonNegativeInteger .
hpc:r15m a owl:DatatypeProperty .
hpc:R15m rdfs:domain hpc:Loadthreshold ;
              rdfs:range xsd:nonNegativeInteger .
hpc:jobsSuspension a owl:Object
