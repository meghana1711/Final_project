hpc:Taskrun hpc:a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a task run." .

hpc:Windowsunsupported hpc:a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a task run on a system where the -S option is not supported." .

hpc:Verbosemode hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Taskrun ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether verbose mode is enabled for a task run." .

hpc:Hostname hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the name of the host or hosts running the task." .

hpc:Hostfile hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrun ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the file that contains a list of host names." .

hpc:Allhosts hpc:a owl:Class ;
    rdfs:subClassOf hpc:Taskrun ;
    rdfs:comment "Represents a task run on all hosts listed in the host file or specified by -n option." .

hpc:Exclusiveoptions hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Allhosts ;
    rdfs:range rdf:List ;
    rdfs:comment "Represents the options that are exclusive with the -f host_file option." .

hpc:Numprocessors hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrun ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Represents the number of processors to use for the task." .

hpc:Cluster hpc:a owl:Class ;
    rdfs:subClassOf hpc:Taskrun ;
    rdfs:comment "Represents a task run in a cluster with a required number of available hosts." .
