hpc:Jobarrayevent a owl:Class .
hpc:JobModify2 hpc:eventtype rdf:PlainLiteral "JOB_MODIFY2" .
hpc:JobSignal hpc:eventtype rdf:PlainLiteral "JOB_SIGNAL" .
hpc:JobStatus hpc:eventtype rdf:PlainLiteral "JOB_STATUS" .
hpc:JobClean hpc:eventtype rdf:PlainLiteral "JOB_CLEAN" .
hpc:JobSwitch hpc:eventtype rdf:PlainLiteral "JOB_SWITCH" .
hpc:JobFinish hpc:eventtype rdf:PlainLiteral "JOB_FINISH" .
hpc:JobFinish2 hpc:eventtype rdf:PlainLiteral "JOB_FINISH2" .
hpc:JobStatus2 hpc:eventtype rdf:PlainLiteral "JOB_STATUS2" .
hpc:JobMove hpc:eventtype rdf:PlainLiteral "JOB_MOVE" .

hpc:Eventloggingbehavior a owl:Class .
hpc:enabledEventLogging rdf:PlainLiteral "Y" .
hpc:disabledEventLogging rdf:PlainLiteral "N" .

hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_MODIFY2 .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_SIGNAL .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_STATUS .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_CLEAN .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_SWITCH .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_FINISH .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_FINISH2 .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_STATUS2 .
hpc:Eventloggingbehavior hpc:haseventtype hpc:JOB_MOVE .

hpc:CombinedEventLogging rdf:PlainLiteral "Enabled" .
hpc:IndividualEventLogging rdf:PlainLiteral "Disabled" .

hpc:Eventloggingbehavior hpc:combinedeventlogging rdf:PlainLiteral "CombinedEventLogging" .
hpc:Eventloggingbehavior hpc:individualeventlogging rdf:PlainLiteral "IndividualEventLogging" .

hpc:Jobarray hpc:haseventloggingbehavior hpc:CombinedEventLogging .
hpc:Singlejob hpc:haseventloggingbehavior hpc:IndividualEventLogging .

hpc:jobid a owl:DatatypeProperty .
hpc:Jobid rdfs:domain hpc:Jobarray .
hpc:Jobid rdfs:domain hpc:Singlejob .
hpc:Jobid rdfs:range xsd:nonNegativeInteger .

hpc:arrayindex a owl:DatatypeProperty .
hpc:Arrayindex rdfs:domain hpc:Jobarray .
hpc:Arrayindex rdfs:range xsd:nonNegativeInteger .
