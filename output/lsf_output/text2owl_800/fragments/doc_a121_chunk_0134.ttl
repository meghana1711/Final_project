hpc:Applicationprofile a owl:Class .
hpc:Job a owl:Class .
hpc:Hostbasedprocessing a owl:Class .
hpc:hostpreexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprocessing ;
    rdfs:range hpc:Job .
hpc:hostpostexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprocessing ;
    rdfs:range hpc:Job .
hpc:userpostexecution a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixuser ;
    rdfs:range xsd:string .
hpc:lsbjobexitstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Unixuser a owl:Class .
hpc:Hostbasedprepostexecutionprocessing a owl:Class ;
    rdfs:subClassOf hpc:Hostbasedprocessing .
hpc:Applicationlevel a owl:Class ;
    rdfs:subClassOf hpc:Hostbasedprocessing .
hpc:preexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprepostexecutionprocessing ;
    rdfs:range hpc:Job .
hpc:postexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprepostexecutionprocessing ;
    rdfs:range hpc:Job .
hpc:requeuesjobifnonzeroexitcode a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecution ;
    rdfs:range hpc:Job .
hpc:usessameenvironmentvariables a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprepostexecutionprocessing ;
    rdfs:range hpc:Job .
