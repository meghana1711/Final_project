hpc:Partition a owl:Class .
hpc:Topology a owl:Class .

hpc:hasTopology a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:Topology .

hpc:clusterDefaultTopology a hpc:Topology .
