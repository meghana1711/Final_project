hpc:Lsf a owl:Class .
hpc:generaltroubleshootingstep a owl:ObjectProperty .
hpc:runcommand a owl:ObjectProperty .
hpc:noteerror a owl:ObjectProperty .
hpc:checkerrorlog a owl:ObjectProperty .
hpc:Lsfcluster a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Lsferror a owl:Class .
hpc:LsfConfdir a owl:Class .
hpc:Host a owl:Class .
hpc:lsfMasterList a owl:ObjectProperty .
hpc:defaultdirectory a owl:DatatypeProperty .
hpc:Cannotopenfile a owl:Class .

hpc:LSF rdf:type owl:Class .
hpc:GeneralTroubleshootingStep rdf:type owl:ObjectProperty .
hpc:RunCommand rdf:type owl:ObjectProperty .
hpc:NoteError rdf:type owl:ObjectProperty .
hpc:CheckErrorLog rdf:type owl:ObjectProperty .
hpc:LSFCluster rdf:type owl:Class .
hpc:LSFDaemon rdf:type owl:Class .
hpc:LSFError rdf:type owl:Class .
hpc:LSF_CONFDIR rdf:type owl:Class .
hpc:Host rdf:type owl:Class .
hpc:LSF_MASTER_LIST rdf:type owl:ObjectProperty .
hpc:DefaultDirectory rdf:type owl:DatatypeProperty .
hpc:CannotOpenFile rdf:type owl:Class .

hpc:Lsf rdfs:subClassOf hpc:LsfCluster .
hpc:Lsfdaemon rdfs:subClassOf hpc:Lsf .
hpc:Lsferror rdfs:subClassOf hpc:Lsf .
hpc:LsfConfdir rdfs:subClassOf hpc:Directory .
hpc:Host rdfs:subClassOf hpc:Computer .

hpc:Generaltroubleshootingstep rdfs:domain hpc:Lsf .
hpc:Runcommand rdfs:domain hpc:Generaltroubleshootingstep .
hpc:Noteerror rdfs:domain hpc:Generaltroubleshootingstep .
hpc:Checkerrorlog rdfs:domain hpc:Generaltroubleshootingstep .
hpc:Checkerrorlog rdfs:range hpc:Errorlog .
hpc:Defaultdirectory rdfs:range xsd:string .

hpc:Cannotopenfile rdfs:subClassOf hpc:Lsferror .
hpc:Cannotopenfile rdfs:domain hpc:LsfConfdir .
