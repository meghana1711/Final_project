hpc:Database a owl:Class .
hpc:DatabaseBackup a owl:Class .
hpc:DatabaseError a owl:Class .
hpc:DatabaseTable a owl:Class .
hpc:DatabaseUpgrade a owl:Class .
hpc:DatabaseRestart a owl:Class .
hpc:DatabaseBackupMethod a owl:ObjectProperty ;
    rdfs:domain hpc:DatabaseBackup ;
    rdfs:range hpc:DatabaseBackupMethod .
hpc:DatabaseUpgradeMethod a owl:ObjectProperty ;
    rdfs:domain hpc:DatabaseUpgrade ;
    rdfs:range hpc:DatabaseUpgradeMethod .
hpc:DatabaseRestartMethod a owl:ObjectProperty ;
    rdfs:domain hpc:DatabaseRestart ;
    rdfs:range hpc:DatabaseRestartMethod .
hpc:DatabaseTableID a owl:DatatypeProperty ;
    rdfs:domain hpc:DatabaseTable ;
    rdfs:range xsd:string .
hpc:DatabaseErrorMessage a owl:DatatypeProperty ;
    rdfs:domain hpc:DatabaseError ;
    rdfs:range xsd:string .

# MariaDB related classes and properties
hpc:MariaDB a owl:Class ;
    rdfs:subClassOf hpc:DatabaseUpgrade .
hpc:MariaDBUpgradeMethod a owl:ObjectProperty ;
    rdfs:domain hpc:MariaDB ;
    rdfs:range xsd:string .

# Duplicate record related classes and properties
hpc:DuplicateRecord a owl:Class .
hpc:DuplicateRecordInDatabaseTable a owl:ObjectProperty ;
    rdfs:domain hpc:DuplicateRecord ;
    rdfs:range hpc:DatabaseTable .
hpc:DuplicateRecordID a owl:DatatypeProperty ;
    rdfs:domain hpc:DuplicateRecord ;
    rdfs:range xsd:string .

# Slurmdbd daemon related classes and properties
hpc:Slurmdbd a owl:Class .
hpc:SlurmdbdDebugMessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .
hpc:SlurmdbdErrorMessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .
hpc:SlurmdbdRestartMethod a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range hpc:DatabaseRestartMethod .

# MySQL related classes and properties
hpc:MySQL a owl:Class .
hpc:MySQLDatabase a owl:Class ;
    rdfs:subClassOf hpc:Database .
hpc:MySQLDatabaseBackup a owl:Class ;
    rdfs:subClassOf hpc:DatabaseBackup .
hpc:MySQLDatabaseError a owl:Class ;
    rdfs:subClassOf hpc:DatabaseError .
hpc:MySQLDatabaseTable a owl:Class ;
    rdfs:subClassOf hpc:DatabaseTable .
hpc:MySQLDatabaseUpgrade a owl:Class ;
    rdfs
