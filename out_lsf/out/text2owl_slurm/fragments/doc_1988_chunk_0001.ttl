hpc:Slurm a owl:Class .
hpc:timeslicedgangscheduling a owl:ObjectProperty .
hpc:preemptivejobscheduling a owl:ObjectProperty .
hpc:Preemptionmode a owl:Class .
hpc:suspend a owl:ObjectProperty .
hpc:gangscheduler a owl:ObjectProperty .
hpc:schedulertimeslice a owl:DatatypeProperty .
hpc:Workloadmanager a owl:Class .
hpc:responsiveness a owl:ObjectProperty .
hpc:utilization a owl:ObjectProperty .
hpc:Jobprioritytier a owl:Class .
hpc:Preemptingqos a owl:Class .
hpc:throughput a owl:ObjectProperty .
hpc:resourceovercommitment a owl:ObjectProperty .
hpc:localbackfilling a owl:ObjectProperty .
hpc:Partition a owl:Class .
hpc:schedulertimesliceinterval a owl:DatatypeProperty .
hpc:Heterogeneousjob a owl:Class .
hpc:gangschedulinglogic a owl:ObjectProperty .
hpc:Suspendedjob a owl:Class .

hpc:Workloadmanager rdfs:subClassOf owl:Class .
hpc:Slurm rdfs:subClassOf hpc:Workloadmanager .
hpc:Timeslicedgangscheduling rdfs:domain hpc:Slurm ;
    rdfs:range hpc:Slurm .
hpc:Preemptivejobscheduling rdfs:domain hpc:Slurm ;
    rdfs:range hpc:Slurm .
hpc:Preemptionmode rdfs:subClassOf hpc:Preemptivejobscheduling .
hpc:Suspend rdfs:domain hpc:Preemptionmode ;
    rdfs:range hpc:Gangscheduler .
hpc:Gangscheduler rdfs:domain hpc:Slurm ;
    rdfs:range hpc:Slurm .
hpc:Schedulertimeslice rdfs:domain hpc:Slurm ;
    rdfs:range xsd:duration .
hpc:Responsiveness rdfs:domain hpc:Workloadmanager ;
    rdfs:range xsd:float .
hpc:Utilization rdfs:domain hpc:Workloadmanager ;
    rdfs:range xsd:float .
hpc:Jobprioritytier rdfs:subClassOf hpc:Partition .
hpc:Preemptingqos rdfs:subClassOf hpc:Partition .
hpc:Throughput rdfs:domain hpc:Workloadmanager ;
    rdfs:range xsd:float .
hpc:Resourceovercommitment rdfs:domain hpc:Workloadmanager ;
    rdfs:range xsd:float .
hpc:Localbackfilling rdfs:domain hpc:Workloadmanager ;
    rdfs:range xsd:float .
hpc:Partition rdfs:subClassOf owl:Class .
hpc:Schedulertimesliceinterval rdfs:domain hpc:Partition ;
    rdfs:range xsd:duration .
hpc:Heterogeneousjob rdfs:subClassOf hpc:Job .
