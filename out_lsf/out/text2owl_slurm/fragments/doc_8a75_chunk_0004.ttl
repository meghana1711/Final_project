hpc:Slurmjob a owl:Class .
hpc:slurmJobGpus a owl:ObjectProperty .
hpc:gpuDeviceOrdinal a owl:DatatypeProperty .
hpc:slurmArrayJobId a owl:DatatypeProperty .
hpc:slurmArrayTaskId a owl:DatatypeProperty .
hpc:slurmArrayTaskCount a owl:DatatypeProperty .
hpc:rocrVisibleDevices a owl:ObjectProperty .

hpc:Slurmjob rdfs:subClassOf [ a owl:Class ;
                                 rdfs:subClassOf owl:Restriction ;
                                 owl:onProperty hpc:SLURM_JOB_GPUS ;
                                 owl:allValuesFrom rdf:nil ] .

hpc:SlurmJobGpus rdfs:domain hpc:Slurmjob ;
                     rdfs:range xsd:integer .

hpc:GpuDeviceOrdinal rdfs:domain hpc:Slurmjob ;
                         rdfs:range xsd:nonNegativeInteger .

hpc:RocrVisibleDevices rdfs:domain hpc:Slurmjob ;
                            rdfs:range rdf:List .

hpc:SlurmArrayJobId rdfs:domain hpc:Slurmjob ;
                          rdfs:range xsd:string .

hpc:SlurmArrayTaskId rdfs:domain hpc:Slurmjob ;
                            rdfs:range xsd:nonNegativeInteger .

hpc:SlurmArrayTaskCount rdfs:domain hpc:Slurmjob ;
                               rdfs:range xsd:nonNegativeInteger .
