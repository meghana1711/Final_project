hpc:LSB_CLEAN_PDONE_TIMEOUT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The time in seconds to wait before the mbatchd daemon cleans those jobs from core memory." .

hpc:CLEAN_PERIOD
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of seconds defined in the lsb.params configuration file." .

hpc:LSF_MBATCHD_DAEMON
    a owl:Class ;
    rdfs:comment "The mbatchd daemon in LSF." .

hpc:JOB_CLEANING
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfMbatchdDaemon ;
    rdfs:range hpc:Job ;
    rdfs:comment "The action of cleaning jobs from core memory by the mbatchd daemon." .

hpc:LSB_PARAMS_FILE
    a owl:Class ;
    rdfs:comment "The lsb.params configuration file." .

hpc:CONFIGURABLE_PARAMETER
    a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A parameter that can be configured in the lsb.params file." .

hpc:LSB_PARAM_NAME
    a owl:DatatypeProperty ;
    rdfs:domain hpc:ConfigurableParameter ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the LSB parameter." .

hpc:MAX_PREEXEC_FORWARDING_RETRY
    a hpc:CONFIGURABLE_PARAMETER ;
    hpc:LSB_PARAM_NAME "MAX_PREEXEC_FORWARDING_RETRY" ;
    rdfs:comment "The maximum number of times to attempt forwarding a job to a remote cluster." .

hpc:REMOTE_CLUSTER
    a owl:Class ;
    rdfs:comment "A remote cluster." .

hpc:JOB_FORWARDING
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfMbatchdDaemon ;
    rdfs:range hpc:Job ;
    rdfs:comment "The action of forwarding a job to a remote cluster." .

hpc:JOB_REJECTION
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Reason ;
    rdfs:comment "The reason a job was rejected." .

hpc:PRE_EXECUTION_COMMAND_FAILURE
    a hpc:Reason ;
    rdfs:comment "The failure of the pre-execution command of the job." .

hpc:LOCAL_MAX_PREEXEC_RETRY_ACTION
    a owl:ObjectProperty ;
    rdfs:domain hpc:ConfigurableParameter ;
    rdfs:range xsd:string ;
    rdfs:comment "The action to take when a job fails all forwarding
