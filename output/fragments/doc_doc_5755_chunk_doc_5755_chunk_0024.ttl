hpc:Job a owl:Class .
hpc:State a owl:EnumeredClass ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:member hpc:PD ;
    rdfs:member hpc:R ;
    rdfs:member hpc:FAILED ;
    rdfs:member hpc:RUNNING ;
    rdfs:member hpc:SUSPENDED ;
    rdfs:member hpc:COMPLETED .

hpc:NonZeroExitCode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:JobHeldUser a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Node a owl:Class .
hpc:NodeList a owl:Class ;
    rdfs:subClassOf owl:Collection ;
    rdfs:subClassOf rdf:List ;
    rdfs:member hpc:Node .

hpc:NodeListReason a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeList ;
    rdfs:range xsd:string .

hpc:RequeueAction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:RequeueHoldAction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
```
