hpc:Lsfversion101Fixpack10 a owl:Class .
hpc:lshostscommandoptionAllhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack10 ;
    rdfs:range hpc:Lsfcommandoption .

hpc:lshostscommandoptionLoc a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack11 ;
    rdfs:range hpc:Lsfcommandoption .

hpc:lshostscommandoptionGpu a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack11 ;
    rdfs:range hpc:Lsfcommandoption .

hpc:lshostscommandoptionMig a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack11 ;
    rdfs:range hpc:Lsfcommandoption .

hpc:lshostscommandoptionCname a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack12 ;
    rdfs:range hpc:Deprecatedcommandoption .

hpc:lsloadcommandoptionO a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack3 ;
    rdfs:range hpc:Lsfcommandoption .

hpc:lsloadcommandoptionCname a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack12 ;
    rdfs:range hpc:Deprecatedcommandoption .

hpc:Lslogincommand a owl:Class ;
    rdfs:subClassOf hpc:Deprecatedcommand .

hpc:Lsmoncommand a owl:Class ;
    rdfs:subClassOf hpc:Deprecatedcommand .

hpc:Lsportcheckcommand a owl:Class .

hpc:physicalindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack13 ;
    rdfs:range xsd:integer .


For the deprecated commands and options, I've created a separate class `hpc:DeprecatedCommand` and `hpc:DeprecatedCommandOption` to represent them. The `hpc:DeprecatedCommandOption` is an object property that relates a deprecated command option to its corresponding deprecated command.
