hpc:CPUManagement a owl:Class .
hpc:SlurmAccounting rdf:type owl:Class ;
    rdfs:subClassOf hpc:CPUManagement .

hpc:UserLimit rdf:type owl:Class ;
    rdfs:subClassOf hpc:SlurmAccounting .
hpc:GroupLimit rdf:type owl:Class ;
    rdfs:subClassOf hpc:SlurmAccounting .
hpc:ClusterLimit rdf:type owl:Class ;
    rdfs:subClassOf hpc:SlurmAccounting .

hpc:CPUUsage rdf:type owl:Class ;
    rdfs:subClassOf hpc:SlurmAccounting .

hpc:CPU rdf:type owl:Class .
hpc:Node rdf:type owl:Class .
hpc:Partition rdf:type owl:Class .

hpc:hasCPU a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range rdfs:Resource .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Partition .

hpc:hasLimit a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmAccounting ;
    rdfs:range xsd:integer .

hpc:isOverSubscribed a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .

hpc:hasState a owl:DatatypeProperty ;
    rdfs:domain (hpc:Node | hpc:Partition) ;
    rdfs:range xsd:string .

hpc:hasName a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:hasNodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:hasCommandLine a owl:DatatypeProperty ;
    rdfs:domain hpc:Example ;
    rdfs:range xsd:string .

hpc:hasSelectType a owl:DatatypeProperty ;
    rdfs:domain hpc:Example ;
    rdfs:range xsd:string .

hpc:hasTasks a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:hasCPUsPerTask a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Example a owl:Class .
hpc:Job a owl:Class .
```
