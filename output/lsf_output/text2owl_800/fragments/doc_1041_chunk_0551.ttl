hpc:Serviceclass a owl:Class .
hpc:Guaranteedresourcepool a owl:Class .
hpc:Queue a owl:Class .
hpc:Slot a owl:Class .

# Object Properties
hpc:hassla a owl:ObjectProperty .
hpc:hasaccesscontrol a owl:ObjectProperty .
hpc:hasguaranteetotal a owl:ObjectProperty .
hpc:haspoolname a owl:ObjectProperty .
hpc:hastype a owl:ObjectProperty .
hpc:hasconfig a owl:ObjectProperty .
hpc:hasused a owl:ObjectProperty .
hpc:hasslotpool a owl:ObjectProperty .
hpc:hasslots a owl:ObjectProperty .
hpc:hasusedslot a owl:ObjectProperty .

# Datatype Properties
hpc:hasname a owl:DatatypeProperty .

# Subclass Relations
hpc:Guaranteedresourcepool rdfs:subClassOf hpc:Resourcepool .

# Domain and Range
hpc:Hassla rdfs:domain hpc:Serviceclass ;
    rdfs:range hpc:Sla .
hpc:Hasaccesscontrol rdfs:domain hpc:Sla ;
    rdfs:range hpc:Queue .
hpc:Hasguaranteetotal rdfs:domain hpc:Sla .
hpc:Haspoolname rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Hastype rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Hasconfig rdfs:domain hpc:Sla ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasused rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasslotpool rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range hpc:Pool .
hpc:Hasslots rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range rdf:List .
hpc:Hasusedslot rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range hpc:Slot .
hpc:Hasname rdfs:domain hpc:Slot ;
    rdfs:range xsd:string .
