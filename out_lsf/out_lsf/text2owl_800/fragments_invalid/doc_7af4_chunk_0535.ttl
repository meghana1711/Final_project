hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Limit a owl:Class .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:groupname a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .
hpc:usergroupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:User .
hpc:haslimit a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Limit .
hpc:isstrict a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:boolean .
hpc:ishorizontal a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:boolean .
hpc:isvertical a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:boolean .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:User .
hpc:hasgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Usergroup .
hpc:excludedusers a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:Project a owl:Class .
hpc:projectlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Limit .
hpc:isstrictproject a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:boolean .

hpc:User rdfs:subClassOf owl:Class .
hpc:Usergroup rdfs:subClassOf owl:Class .
hpc:Limit rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf hpc:Identifiableentity .
hpc:Usergroup rdfs:subClassOf hpc:Identifiableentity .
hpc:Limit rdfs:subClassOf hpc:Identifiableentity .
hpc:Identifiableentity rdfs:subClassOf owl:Class .

hpc:Hasuser rdfs:domain hpc:Limit ;
    rdfs:range hpc:User ;
    rdfs:subPropertyOf hpc:hasMember .
hpc:Hasgroup rdfs:domain hpc:Limit ;
    rdfs:range hpc:Usergroup ;
    rdfs:subPropertyOf hpc:hasMember .
hpc:UserGroupMembership rdfs:subPropertyOf hpc:hasMember .

hpc:Isstrict rdfs:domain hpc:Limit ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf rdf:type .
hpc:Ishorizontal rdfs:domain
