hpc:SRUN a owl:Class .
hpc:SLURMCTLD a owl:Class .
hpc:SLURMD a owl:Class .
hpc:SLURMSTEPd a owl:Class .

hpc:sends a owl:ObjectProperty ;
    rdfs:domain hpc:SRUN ;
    rdfs:range hpc:StepCreateRequest .

hpc:responds a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMCTLD ;
    rdfs:range hpc:StepCredential .

hpc:opens a owl:ObjectProperty ;
    rdfs:domain hpc:SRUN ;
    rdfs:range xsd:integer .

hpc:forwards a owl:ObjectProperty ;
    rdfs:domain hpc:SRUN ;
    rdfs:range hpc:CredentialWithTaskInfo .

hpc:forksExecs a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMD ;
    rdfs:range hpc:Slurmstepd .

hpc:connects a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMSTEPd ;
    rdfs:range xsd:integer .

hpc:notifies a owl:ObjectProperty ;
    rdfs:domain [a hpc:SRUN ; rdfs:subClassOf hpc:Communicator] ;
    rdfs:range hpc:JobTermination .

hpc:verifies a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMCTLD ;
    rdfs:range hpc:ProcessTermination .

hpc:releases a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMCTLD ;
    rdfs:range hpc:Resources .

hpc:Communicator a owl:Class .
hpc:FallbackSlurmctld a owl:Class ;
    rdfs:subClassOf hpc:Communicator .
hpc:FallbackSlurmdbd a owl:Class ;
    rdfs:subClassOf hpc:Communicator .

hpc:MultiClusterConfiguration a owl:Class .
hpc:Federation a owl:Class .
```
