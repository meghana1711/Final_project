@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

# Classes
hpc:Servicedomain a owl:Class .
hpc:Licensefeature a owl:Class .

# Object Properties
hpc:assignedto a owl:ObjectProperty ;
    rdfs:domain hpc:Server ;
    rdfs:range hpc:Servicedomain .
hpc:useslicense a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Licensefeature .

# Datatype Properties
hpc:totallicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:lsfuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:lsfdeserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:lsffree a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:nonlsfuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:nonlsfdeserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:nonlsffree a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .

# Instances
hpc:p1_f2 a hpc:LicenseFeature ;
    hpc:totalLicenses "10"^^xsd:integer .
hpc:p1_f1 a hpc:LicenseFeature ;
    hpc:totalLicenses "5"^^xsd:integer .
hpc:app_1 a hpc:ServiceDomain ;
    hpc:P1F2 hpc:assignedto hpc:server1 , hpc:server2 ;
    hpc:P1F1 hpc:assignedto hpc:server1 ;
    hpc:P1F2 hpc:assignedto hpc:server3 ;
    hpc:P1F2 hpc:lsfuse "0"^^xsd:integer ;
    hpc:P1F2 hpc:lsfdeserve "10"^^xsd:integer ;
    hpc:P1F2 hpc:lsffree "10"^^xsd:integer ;
    hpc:P1F2 hpc:nonlsfuse "0"
