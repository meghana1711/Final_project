hpc:Jobgroup a owl:Class .
hpc:Job a owl:Class .
hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:suspendalljobsingroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range rdf:PlainLiteral .
hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:resumealljobsingroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range rdf:PlainLiteral .
hpc:terminatejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:terminatealljobsingroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range rdf:PlainLiteral .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .
