hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a owl:Class .

hpc:WCKey a owl:Class .

hpc:AccountingStorageEnforce a owl:ObjectProperty ;
    rdfs:domain hpc:slurm.conf ;
    rdfs:range rdf:List .

hpc:TrackWCKey a owl:ObjectProperty ;
    rdfs:domain (hpc:slurm.conf hpc:slurmdbd.conf) ;
    rdfs:range xsd:boolean .

hpc:sbatch a owl:Class ;
    rdfs:subClassOf hpc:SubmittingTool .
hpc:salloc a owl:Class ;
    rdfs:subClassOf hpc:SubmittingTool .
hpc:srun a owl:Class ;
    rdfs:subClassOf hpc:SubmittingTool .

hpc:SubmittingTool a owl:Class .

hpc:--wckey a owl:ObjectProperty ;
    rdfs:domain (hpc:sbatch hpc:salloc hpc:srun) ;
    rdfs:range xsd:string .

hpc:SBATCH_WCKEY a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range xsd:string .

hpc:SLURM_WCKEY a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range xsd:string .

hpc:sacct a owl:Class .

hpc:--format a owl:ObjectProperty ;
    rdfs:domain hpc:sacct ;
    rdfs:range rdf:List .

hpc:--wckeys a owl:ObjectProperty ;
    rdfs:domain hpc:sacct ;
    rdfs:range rdf:List .

hpc:sacctmgr a owl:Class .

hpc:addUser a owl:ObjectProperty ;
    rdfs:domain hpc:sacctmgr ;
    rdfs:range xsd:string .

hpc:delUser a owl:ObjectProperty ;
    rdfs:domain hpc:sacctmgr ;
    rdfs:range xsd:string .

hpc:modUser a owl:ObjectProperty ;
    rdfs:domain hpc:sacctmgr ;
    rdfs:range xsd:string .

hpc:sreport a owl:Class .
```
