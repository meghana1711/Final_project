@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Guaranteedresourcepool a owl:Class.
hpc:packagePool rdf:type hpc:GuaranteedResourcePool ;
    rdfs:comment "guaranteed resource pool configuration" .

hpc:Package a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:slots ;
                        owl:allValuesFrom [ xsd:nonNegativeInteger "1" ] ;
                        owl:onProperty hpc:mem ;
                        owl:hasValue [ xsd:nonNegativeInteger "10000" ] ] .

hpc:
