hpc:Cpu a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a CPU job." .

hpc:runTime a owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The duration that the job has been running." .

hpc:idleFactor a owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The idle factor used for job exception handling." .

hpc:exceptionStatus a owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The job's exception status." .

hpc:numslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The number of slots used by the job." .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of memory used by the job." ;
    rdfs:subPropertyOf hpc:memlimit .

hpc:maxMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum memory used by the job." ;
    rdfs:subPropertyOf hpc:memlimit .

hpc:avgMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The average amount of memory used by the job." ;
    rdfs:subPropertyOf hpc:memlimit .

hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The memory limit as defined in lsf.conf." .
