hpc:Applicationprofile a owl:Class ;
  rdfs:subClassOf hpc:Configurableentity .

hpc:applicationprofileproperty a owl:ObjectProperty ;
  rdfs:domain hpc:Applicationprofile ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf hpc:ConfigurableProperty .

hpc:PRE_EXEC rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:string .
hpc:POST_EXEC rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:string .
hpc:HOST_PRE_EXEC rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:string .
hpc:HOST_POST_EXEC rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:string .
hpc:JOB_INCLUDE_POSTPROC rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:string .
hpc:JOB_POSTPROC_TIMEOUT rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:integer .
hpc:LOCAL_MAX_PREEXEC_RETRY rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:integer .
hpc:MAX_PREEXEC_RETRY rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:integer .
hpc:REMOTE_MAX_PREEXEC_RETRY rdf:Datatype rdfs:subPropertyOf hpc:ApplicationProfileProperty ;
  rdfs:range xsd:integer .

