hpc:User a owl:Class .
hpc:Account a owl:Class .

# Object Properties
hpc:hasShare a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .
hpc:consumesResource a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .
hpc:hasChildAccount a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Account .
hpc:hasParentAccount a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Account .

# Datatype Properties
hpc:normalizedShare a owl:DatatypeProperty ;
    rdfs:domain hpc:User .
hpc:actualUsage a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .
hpc:effectiveUsage a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .

# Formula for Effective Usage
hpc:UE a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .
hpc:UAchild a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .
hpc:UEparent a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .
hpc:Sall_siblings a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .
hpc:Schild a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .

# Initial Data
hpc:User1 a hpc:User ;
    hpc:hasShare "1"^^xsd:integer ;
    hpc:normalizedShare "0.3"^^xsd:decimal ;
    hpc:consumesResource hpc:AccountA .

hpc:User2 a hpc:User ;
    hpc:hasShare "1"^^xsd:integer ;
    hpc:normalizedShare "0.05"^^xsd:decimal ;
    hpc:consumesResource hpc:AccountC .

hpc:User3 a hpc:User ;
    hpc:hasShare "1"^^xsd:integer ;
    hpc:normalizedShare "0.05"^^xsd:decimal ;
    hpc:consumesResource hpc:AccountC .

hpc:User4 a hpc:User ;
    hpc:hasShare "1"^^xsd:integer ;
    hpc:normalizedShare "0.25"^^xsd:decimal ;
    hpc:consumesResource hpc:AccountA .

hpc:User5 a hpc:User ;
    hpc:hasShare "1"^^xsd:integer ;
    hpc:normalizedShare "0.35"^^xsd:decimal ;
    # Additional users and their shares can be added here

hpc:AccountA a hpc:Account ;
    hpc:hasChildAccount hpc:AccountB ;
