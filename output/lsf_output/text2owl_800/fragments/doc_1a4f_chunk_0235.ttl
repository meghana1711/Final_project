hpc:Autoresizablejob a owl:Class .
hpc:Resourcetype a owl:Class .
hpc:Model a owl:Class .
hpc:Type a owl:Class .
hpc:Computeunittype a owl:Class .
hpc:hasResourceType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Resourcetype .
hpc:hasModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Model .
hpc:hasType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Type .
hpc:sameType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Type .
hpc:sameModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Model .
hpc:sameTypeModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Model .
hpc:computeunit a owl:DatatypeProperty .
hpc:hasComputeUnit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Computeunit .
hpc:Computeunittype rdfs:subClassOf hpc:Resourcetype .
hpc:cuType rdf:type xsd:string .
hpc:Cutype rdfs:range hpc:Computeunittype .
