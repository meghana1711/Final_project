hpc:Architecture a owl:Class .
hpc:cpufactor a owl:DatatypeProperty .
hpc:modelname a owl:ObjectProperty .
hpc:Automaticallydetectedmodel a owl:Class .
hpc:Reserved a owl:Class .

hpc:Automaticallydetectedmodel rdfs:subClassOf hpc:Model .
hpc:Reserved rdfs:subClassOf hpc:Architecture .

hpc:Cpufactor rdfs:domain hpc:Model .
hpc:Modelname rdfs:domain hpc:Host .

hpc:Model rdfs:subClassOf hpc:Entity .
hpc:Host rdfs:subClassOf hpc:Entity .
hpc:Architecture rdfs:subClassOf hpc:Entity .

hpc:Entity rdf:type owl:Class .
hpc:CPUFactor rdf:type owl:DatatypeProperty .
hpc:ModelName rdf:type owl:ObjectProperty .
