hpc:Bctrld a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:comment "Shut down LIM." .

hpc:bctrldrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Bctrld ;
    rdfs:range hpc:Bctrld ;
    rdfs:comment "Restarts LIM." .

hpc:Lsload a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:comment "View dynamic load values." .

