hpc:HardResourceLimit a owl:Class .
hpc:UserResourceLimit a owl:Class .
hpc:NodeResourceLimit a owl:Class .
hpc:ClusterResourceLimit a owl:Class .
hpc:PropagateResourceLimits a owl:ObjectProperty .
hpc:PropagateResourceLimitsExcept a owl:ObjectProperty .
hpc:ResourceLimitErrorMessage a owl:DatatypeProperty .
hpc:ResourceLimitPropagation rdfs:subClassOf hpc:ResourceLimitPropagationFailure .
