hpc:Hostgroup a owl:Class .
hpc:hosts a owl:ObjectProperty .

hpc:Hostgroup rdfs:subClassOf owl:Class .
hpc:Hosts rdfs:domain owl:Class ;
                          rdfs:range rdf:List .

hpc:Host rdf:type owl:Class .
hpc:Host rdfs:subClassOf hpc:Hostgroup .

hpc:allhosts a owl:ObjectProperty .
hpc:Allhosts rdfs:domain hpc:Hostgroup ;
                         rdfs:range rdf:List .

hpc:excludedhosts a owl:ObjectProperty .
hpc:Excludedhosts rdfs:domain hpc:Allhosts ;
                          rdfs:range rdf:List .

hpc:subgroup a owl:ObjectProperty .
hpc:Subgroup rdfs:domain hpc:Hostgroup ;
                         rdfs:range hpc:Hostgroup .

hpc:horizontalformat a owl:ObjectProperty .
hpc:Horizontalformat rdfs:domain hpc:Limit ;
                            rdfs:range xsd:boolean .

hpc:verticalformat a owl:ObjectProperty .
hpc:Verticalformat rdfs:domain hpc:Limit ;
                            rdfs:range xsd:boolean .

hpc:percentage a owl:DatatypeProperty .
hpc:Percentage rdfs:domain hpc:Limit ;
                         rdfs:range xsd:decimal .

hpc:perhost a owl:ObjectProperty .
hpc:Perhost rdfs:domain hpc:Limit ;
                         rdfs:range rdf:List .

hpc:Limit a owl:Class .
