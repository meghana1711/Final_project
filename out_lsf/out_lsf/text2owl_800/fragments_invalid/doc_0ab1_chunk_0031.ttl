hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Status a owl:Class .
hpc:Queue a owl:Class .
hpc:Command a owl:Class .
hpc:Host a owl:Class .
hpc:Gpu a owl:Class .
hpc:jobstatus a owl:ObjectProperty .
hpc:submittedfrom a owl:ObjectProperty .
hpc:cwd a owl:ObjectProperty .
hpc:specifiedhosts a owl:ObjectProperty .
hpc:requestedgpu a owl:ObjectProperty .
hpc:combinedgpurequirement a owl:DatatypeProperty .
hpc:effectivegpurequirement a owl:DatatypeProperty .
hpc:resourcerequirementdetails a owl:ObjectProperty .
hpc:gpurequirementdetails a owl:ObjectProperty .
hpc:num a owl:DatatypeProperty .
hpc:mode a owl:DatatypeProperty .
hpc:mps a owl:DatatypeProperty .
hpc:jExclusive a owl:DatatypeProperty .
hpc:Resourcerequirement a owl:Class .
hpc:Combinedresourcerequirement a owl:Class .
hpc:Effectiveresourcerequirement a owl:Class .
hpc:Gpurequirement a owl:Class .
hpc:shared a owl:ObjectProperty .
hpc:no a owl:ObjectProperty .
hpc:yes a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Status rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:Command rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Gpu rdfs:subClassOf owl:Class .

hpc:Jobstatus rdfs:domain hpc:Job ;
    rdfs:range hpc:Status .

hpc:Submittedfrom rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Cwd rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Specifiedhosts rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Requestedgpu rdfs:domain hpc:Job ;
    rdfs:range hpc:Gpurequirement
