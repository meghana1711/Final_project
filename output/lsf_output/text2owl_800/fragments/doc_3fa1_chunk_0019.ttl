hpc:Usershareassignment a owl:Class .
hpc:Dynamicsharepriority a owl:Class .
hpc:Jobdispatchorder a owl:Class .

hpc:configuresfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingpolicy ;
    rdfs:range hpc:Fairsharepolicy .

hpc:athostlevel a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:Host .

hpc:atqueuelevel a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:Queue .

hpc:hashierarchicalfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:Fairsharepolicy .

hpc:hasadditionalrestrictions a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Restriction .

hpc:RELAX_JOB_DISPATCH_ORDER a xsd:boolean .

hpc:Fcfsscheduling a owl:Class ;
    rdfs:subClassOf hpc:Schedulingpolicy ;
    rdfs:comment "Jobs are dispatched in the order they appear in the queue." .

hpc:Userbasedfairshare a owl:Class ;
    rdfs:subClassOf hpc:Fairsharepolicy .

hpc:timedecay a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeReal .

hpc:committedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hostpartitionuserbasedfairshare a owl:Class ;
    rdfs:subClassOf hpc:Userbasedfairshare ;
    rdfs:comment "Handles resource contention across multiple queues." .

hpc:Queueleveluserbasedfairshare a owl:Class ;
    rdfs:subClassOf hpc:Userbasedfairshare ;
    rdfs:comment "Handles resource contention among users in the same queue." .

hpc:jobdispatchorderbyqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Schedulingpolicy .
