hpc:Bmod       a owl:Class ;
           rdfs:subClassOf hpc:Jobmodification .

hpc:Brestart  a owl:Class ;
           rdfs:subClassOf hpc:Jobaction .

hpc:Bresume   a owl:Class ;
           rdfs:subClassOf hpc:Jobaction .

hpc:Bstop     a owl:Class ;
           rdfs:subClassOf hpc:Jobaction .

hpc:Jobdata   a owl:Class .

hpc:hasjobdata a owl:ObjectProperty ;
           rdfs:domain hpc:Job ;
           rdfs:range hpc:Jobdata .

hpc:Jobaction a owl:Class .

hpc:Jobinformationaccesscontrol a owl:Class .

hpc:setjobinformationaccesscontrol a owl:ObjectProperty ;
           rdfs:domain hpc:Jobinformationaccesscontrol ;
           rdfs:range hpc:Job .

hpc:accessremotehosts a owl:ObjectProperty ;
           rdfs:domain hpc:Jobinformationaccesscontrol .

hpc:lsrun       a owl:ObjectProperty .
hpc:lsgrun      a owl:ObjectProperty .
