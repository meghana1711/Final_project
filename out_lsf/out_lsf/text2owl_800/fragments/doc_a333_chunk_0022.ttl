hpc:Lsfsimulator a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Lsfconfiguration a owl:Class .
hpc:lsfconfdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .
hpc:imports a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulator ;
    rdfs:range hpc:Lsfconfiguration .
hpc:configures a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulator ;
    rdfs:range hpc:Lsfcluster .
hpc:hasparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .
hpc:LsfStrictChecking rdfs:subClassOf hpc:Hasparameter .
hpc:LsfAuthQueryCommands rdfs:subClassOf hpc:Hasparameter .
hpc:importcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulator ;
    rdfs:range xsd:string .
hpc:loadconfigurationpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulator ;
    rdfs:range xsd:string .
hpc:Lsfsimulatorhost a owl:Class ;
    rdfs:subClassOf hpc:Lsfcluster .
hpc:isserverorclient a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulatorhost ;
    rdfs:range xsd:boolean .
hpc:mappedintocontainer a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulatorhost ;
    rdfs:range xsd:string .
