hpc:Installation a owl:Class .
hpc:LibraryLocation a owl:Class .
hpc:LibraryFile a owl:Class .
hpc:CompileInstallationAction rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Installation ;
    rdfs:range hpc:CompileInstallationAction .
hpc:LinkLibrary rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LibraryLocation ;
    rdfs:range hpc:LibraryFile .
hpc:Prefix a owl:Class .
hpc:Sysconfdir a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:Slurm a owl:Class ;
    rdfs:subClassOf hpc:Installation .
hpc:SlurmConfigurationFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:SlurmNode a owl:Class .
hpc:ComputeNode a owl:Class ;
    rdfs:subClassOf hpc:SlurmNode .
hpc:ControllerNode a owl:Class ;
    rdfs:subClassOf hpc:SlurmNode .
hpc:OptionalNode a owl:Class ;
    rdfs:subClassOf hpc:SlurmNode .
hpc:SinglePurposeNode a owl:Class ;
    rdfs:subClassOf hpc:SlurmNode .
hpc:SlurmDaemon a owl:Class .
hpc:NonRootServiceAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon .
```
