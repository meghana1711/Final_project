hpc:Job a owl:Class .
hpc:BurstBuffer a owl:Class .
hpc:BurstBufferPool a owl:Class .
hpc:BurstBufferPlugin a owl:Class .
hpc:BurstBufferDirective a owl:Class .
hpc:BurstBufferScript a owl:Class .
hpc:BurstBufferOption a owl:Class .
hpc:PersistentBurstBuffer a owl:Class .

# Object Properties
hpc:hasJob a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:Job .

hpc:hasPool a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:BurstBufferPool .

hpc:hasPlugin a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:BurstBufferPlugin .

hpc:hasDirective a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:BurstBufferDirective .

hpc:hasScript a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBufferDirective ;
    rdfs:range hpc:BurstBufferScript .

hpc:hasOption a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBufferDirective ;
    rdfs:range hpc:BurstBufferOption .

hpc:hasPersistentBurstBuffer a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:PersistentBurstBuffer .

# Datatype Properties
hpc:size a owl:DatatypeProperty ;
    rdfs:domain hpc:BurstBuffer .

hpc:format a owl:DatatypeProperty ;
    rdfs:domain hpc:BurstBuffer .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:PersistentBurstBuffer .

hpc:access a owl:DatatypeProperty ;
    rdfs:domain hpc:PersistentBurstBuffer .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:PersistentBurstBuffer .

hpc:pool a owl:DatatypeProperty ;
    rdfs:domain hpc:BurstBufferDirective .

hpc:capacity a owl:DatatypeProperty ;
    rdfs:domain hpc:BurstBufferDirective .

# Subclass relations
hpc:DataWarp a hpc:BurstBufferPlugin ;
hpc:Lua a hpc:BurstBufferPlugin ;
hpc:PersistentBurstBuffer a hpc:BurstBuffer .
```
