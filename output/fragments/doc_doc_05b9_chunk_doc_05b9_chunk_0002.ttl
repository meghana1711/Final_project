hpc:JobInformation a owl:Class .
hpc:JobStateInformation a owl:Class .
hpc:LicensesInformation a owl:Class .
hpc:NodesInformation a owl:Class .
hpc:PartitionInformation a owl:Class .
hpc:PingResponse a owl:Class .

hpc:jobId a xsd:string .
hpc:nodeName a xsd:string .
hpc:partitionName a xsd:string .
hpc:updateTime xsd:dateTime .
hpc:flags xsd:string .

hpc:hasJobId hpc:jobId rdfs:domain hpc:JobInformation ;
    rdfs:range xsd:string .
hpc:hasNodeName hpc:nodeName rdfs:domain hpc:NodesInformation ;
    rdfs:range xsd:string .
hpc:hasPartitionName hpc:partitionName rdfs:domain hpc:PartitionInformation ;
    rdfs:range xsd:string .
hpc:hasUpdateTime hpc:updateTime rdfs:domain (hpc:JobInformation | hpc:NodesInformation | hpc:PartitionInformation) ;
    rdfs:range xsd:dateTime .
hpc:hasFlags hpc:flags rdfs:domain (hpc:JobInformation | hpc:NodesInformation | hpc:PartitionInformation) ;
    rdfs:range xsd:string .

hpc:JobInformation v0.0.43_openapi_job_info_resp rdf:type owl:Class .
hpc:JobStateInformation v0.0.43_openapi_job_info_resp rdf:type owl:Class .
hpc:LicensesInformation v0.0.43_openapi_licenses_resp rdf:type owl:Class .
hpc:NodesInformation v0.0.43_openapi_nodes_resp rdf:type owl:Class .
hpc:PartitionInformation v0.0.43_openapi_partition_resp rdf:type owl:Class .
hpc:PingResponse v0.0.43_openapi_ping_array_resp rdf:type owl:Class .
