@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Containerjob a owl:Class .
hpc:Podmanjob a owl:Class .
hpc:Dockerjob a owl:Class .
hpc:Enrootjob a owl:Class .

hpc:hasControlScript an owl:ObjectProperty .
hpc:hasStarterScript an owl:ObjectProperty .
hpc:hasMonitorScript an owl:ObjectProperty .
hpc:hasExecDriver an owl:ObjectProperty .
hpc:hasContainer an owl:ObjectProperty .
hpc:hasDescription an owl:DatatypeProperty .

hpc:Container a owl:Class .
hpc:Podman an owl:Class, rdfs:subClassOf hpc:Container .
hpc:Docker an owl:Class, rdfs:subClassOf hpc:Container .
hpc:Enroot an owl:Class, rdfs:subClassOf hpc:Container .

hpc:Hasimage rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Hasoptions rdfs:domain hpc:Container ;
    rdfs:range xsd:string .

hpc:Execdriver a owl:Class .
hpc:Context an owl:Class, rdfs:subClassOf hpc:Execdriver .
hpc:Starter an owl:Class, rdfs:subClassOf hpc:Execdriver .
hpc:Monitor an owl:Class, rdfs:subClassOf hpc:Execdriver .
hpc:Controller an owl:Class, rdfs:subClassOf hpc:Execdriver .

hpc:Hasuser rdfs:domain hpc:Context ;
    rdfs:range xsd:string .
hpc:Haspath rdfs:domain hpc:Context ;
    rdfs:range xsd:string .

hpc:Queue a owl:Class .
hpc:Hasqueuename rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:QueueDescription an owl:DatatypeProperty .

hpc:ExtendableRunlimit a owl:Class .


