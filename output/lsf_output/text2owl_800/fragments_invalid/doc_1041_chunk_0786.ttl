hpc:Lsfinstallation a owl:Class .
hpc:installationprogresslog a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:Productfiles a owl:Class ;
    rdfs:subClassOf hpc:Lsfinstallation .

hpc:decompression a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range hpc:Productfiles .

hpc:extraction a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range hpc:Productfiles .

hpc:copying a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range hpc:Productfiles .

hpc:configuration a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range hpc:Cluster .

hpc:Cluster a owl:Class .

hpc:hostsetup a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Lsfhost .

hpc:Lsfhost a owl:Class .

hpc:automaticstartup a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:boolean .

hpc:Ibmpoe a owl:Class .

hpc:ibmpejobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmpoe ;
    rdfs:range xsd:boolean .

hpc:Lsfserverhost a owl:Class ;
    rdfs:subClassOf hpc:Lsfhost .

hpc:lsfinstalldirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:lsfinstallscript a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:optional a owl:DatatypeProperty ;
    rdfs:domain hdfs:LSFInstallation ;
    rdfs:range xsd:boolean .

hpc:lsfclusterfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:topdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostsetup ;
    rdfs:range xsd:string .

hpc:boot a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostsetup ;
    rdfs:range xsd:boolean .
