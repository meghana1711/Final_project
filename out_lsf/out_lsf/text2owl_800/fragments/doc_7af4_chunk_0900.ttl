hpc:Cachepermissions a owl:Class .
hpc:validminutes a owl:DatatypeProperty .
hpc:defaultminutes a owl:DatatypeProperty .
hpc:permissiontype a owl:ObjectProperty .

hpc:Cachepermissions rdfs:subClassOf owl:Class .
hpc:UserCache rdf:type hpc:CachePermissions ;
    rdfs:comment "Files are stored in a user-specific subdirectory in the staging area. All files are owned by that user with 700 file permission mode." .
hpc:GroupCache rdf:type hpc:CachePermissions ;
    rdfs:comment "Users in the same primary UNIX user group can share the cached files to avoid unnecessary file transfers." ;
    rdfs:subClassOf hpc:Cachepermissions .
hpc:AllCache rdf:type hpc:CachePermissions ;
    rdfs:comment "Only a single cache is created for incoming files, and files are shareable by all users." .

hpc:Validminutes rdfs:domain hpc:Cachepermissions ;
    rdfs:range xsd:integer .
hpc:Defaultminutes rdfs:domain hpc:Cachepermissions ;
    rdfs:range xsd:integer .
hpc:Permissiontype rdfs:domain hpc:Cachepermissions ;
    rdfs:range xsd:string .
