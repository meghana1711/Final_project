hpc:Job a owl:Class .
hpc:Cluster a owl:Class .
hpc:Federation a owl:Class .
hpc:SiblingJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:OriginCluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .

hpc:HeldJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:DependentJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:ViableCluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .

hpc:AllocateResources a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Job .

hpc:CoordinateWithOrigin a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster .

hpc:RevokedJob a owl:Class ;
    rdfs:subClassOf hpc:SiblingJob .

hpc:MainScheduler a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:BackfillScheduler a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:DownCluster a owl:Class ;

hpc:RequeuedJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:SlurmConfOptions a owl:Class .

hpc:RequeueExit a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfOptions .
    rdfs:range xsd:string .

hpc:RequeueExitHold a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfOptions .
    rdfs:range xsd:string .

hpc:InteractiveJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:LocalCluster a owl:Class .

hpc:RemoteSiblingCluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:Srun a owl:Class .

hpc:SLURM_WORKING_CLUSTER a owl:DatatypeProperty ;
    rdfs:domain hpc:Srun .
    rdfs:range xsd:string .

hpc:AccessibleToAllSubmissionHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:boolean .

hpc:SlurmdSpooldir a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:string .
```
