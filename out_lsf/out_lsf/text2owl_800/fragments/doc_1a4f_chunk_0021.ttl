hpc:Pagingrate a owl:Class .
hpc:Loginsession a owl:Class .
hpc:lsindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Loginsession ;
    rdfs:range xsd:nonNegativeInteger .

hpc:interactiveidletime a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:itindex a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:InteractiveIdleTime ;
    rdfs:domain hpc:Unixhost ;
    rdfs:range xsd:nonNegativeInteger .

hpc:windowsitindex a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:InteractiveIdleTime ;
    rdfs:domain hpc:Windowshost ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Temporarydirectories a owl:Class .
hpc:tmpindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Temporarydirectories ;
    rdfs:range xsd:decimal .

hpc:Swapspace a owl:Class .

hpc:tmpindexonunix a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:TemporaryDirectories ;
    rdfs:domain hpc:Unixtemporarydirectories ;
    rdfs:range xsd:decimal .

hpc:tmpindexonwindows a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:TemporaryDirectories ;
    rdfs:domain hpc:Windowstemporarydirectories ;
    rdfs:range xsd:decimal .

hpc:swapspaceonunix a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:SwapSpace ;
    rdfs:domain hpc:Unixswapspace ;
    rdfs:range xsd:decimal .

hpc:swapspaceonwindows a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:SwapSpace ;
    rdfs:domain hpc:Windowsswapspace ;
    rdfs:range xsd:decimal .
