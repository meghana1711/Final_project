hpc:HeterogeneousJob a owl:Class .
hpc:JobStep a owl:Class .
hpc:JobAllocation a owl:Class .
hpc:ResourceContention a owl:Class .
hpc:StepID a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStep ;
    rdfs:range xsd:integer .
hpc:HetGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStep ;
    rdfs:range xsd:integer .
hpc:JobID a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocation ;
    rdfs:range xsd:integer .
hpc:HetSize a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocation ;
    rdfs:range xsd:integer .
hpc:JobStepAllocation a owl:ObjectProperty ;
    rdfs:domain hpc:JobAllocation ;
    rdfs:range hpc:JobStep .
hpc:ResourceContentionPrevention a owl:ObjectProperty ;
    rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:JobStepAllocation .
hpc:MaxHetGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStepAllocation ;
    rdfs:range xsd:integer .
hpc:HeterogeneousJobComponent a owl:Class ;
    rdfs:subClassOf hpc:JobAllocation .
hpc:JobID_HetGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:HeterogeneousJobComponent ;
    rdfs:range xsd:integer .
hpc:JobNodes_HetGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:HeterogeneousJobComponent ;
    rdfs:range xsd:string .
hpc:JobNodeList_HetGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:HeterogeneousJobComponent ;
    rdfs:range xsd:string .
