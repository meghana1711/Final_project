hpc:Blimit a owl:Class .
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldname ;
    rdfs:range xsd:nonNegativeInteger .
hpc:delimiter a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldname ;
    rdfs:range xsd:string .
hpc:projectname a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit .
hpc:queuename a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit .
hpc:username a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:usergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:lslicenseproject a owl:DatatypeProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit .
hpc:hostgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:clustername a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit ;
    rdfs:range xsd:string .
hpc:applicationname a owl:ObjectProperty ;
    rdfs:domain hpc:Blimit .
hpc:Glimit a owl:Class ;
    rdfs:subClassOf hpc:Blimit .
