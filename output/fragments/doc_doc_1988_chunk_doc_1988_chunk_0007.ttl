hpc:Job a owl:Class .
hpc:JobID a xsd:string .
hpc:Partition a owl:Class .
hpc:Name a owl:ObjectProperty .
hpc:User a owl:Class .
hpc:State a owl:Enumeroation ;
    rdfs:member rdf:PlainLiteral("R") ;
    rdfs:member rdf:PlainLiteral("S") .
hpc:Time a xsd:duration .
hpc:Nodes a xsd:nonNegativeInteger .
hpc:NodeList a xsd:string .

hpc:SubmittedBatchJob a owl:FunctionalProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:JOBID rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobID .

hpc:PARTITION rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .

hpc:NAME rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Name .

hpc:USER rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:ST rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:TIME rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:NODES rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NODELIST rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
```
