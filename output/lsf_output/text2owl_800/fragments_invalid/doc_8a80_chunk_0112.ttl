hpc:Project a owl:Class .
hpc:Task a owl:Class .
hpc:Host a owl:Class .
hpc:Terminal a owl:Class .
hpc:User a owl:Class .

hpc:Hasproject hpc:objectproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Project .

hpc:Fromhost hpc:objectproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .

hpc:Fromterminal hpc:objectproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Terminal .

hpc:Submittedby hpc:objectproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:User .

hpc:Tid hpc:datatypeproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:User hpc:datatypeproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:Status hpc:datatypeproperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:running rdf:PlainLiteral "RUN"^^xsd:string .
hpc:notStarted rdf:PlainLiteral "RUN"^^xsd:string .

hpc:Task subClassOf (hpc:Project hpc:hasProject) .
hpc:Task subClassOf (hpc:Host hpc:fromHost) .
hpc:Task subClassOf (hpc:Terminal hpc:fromTerminal) .
hpc:Task subClassOf (hpc:User hpc:submittedBy) .
