@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LsfDebug a owl:Class .
hpc:lsbDebugCmd a owl:ObjectProperty .

rdfs:domain hpc:LsbDebugCmd rdf:Resource .
rdfs:range hpc:LsbDebugCmd xsd:string .

hpc:Logclass a owl:Class .
hpc:LC_ADVRSV a hpc:LogClass .
hpc:LC2_ADVRSV a hpc:LogClass .
hpc:LC_AFS a hpc:LogClass .
hpc:LC2_AFS a hpc:LogClass .
hpc:LC_M_LOG a hpc:LogClass .
hpc:LC2_M_LOG a hpc:LogClass .
hpc:LC_MEMORY a hpc:LogClass .
hpc:LC2_MEMORY a hpc:LogClass .
