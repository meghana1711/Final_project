hpc:NewModuleFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:MakefileAMFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:SlurmSourceDirectory a owl:Class .

hpc:Autoreconf a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSourceDirectory ;
    rdfs:range hpc:Command .

hpc:MakefileInFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:MakefileAMFile a rdfs:subClassOf hpc:MakefileInFile .

hpc:SlurmSpecFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:RPM a owl:Class ;

hpc:NewDirectory a owl:Class ;

hpc:ConfigureACFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:NewDirectoryPath a owl:DatatypeProperty ;
    rdfs:domain hpc:ConfigureACFile ;
    rdfs:range <http://www.w3.org/2001/XMLSchema#anyURI> .

hpc:MakeFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:AutoreconfTranslate a owl:ObjectProperty ;
    rdfs:domain hpc:MakeFileAMFile ;
    rdfs:range hpc:MakeFileInFile .

hpc:ConfigureTranslate a owl:ObjectProperty ;
    rdfs:domain hpc:MakeFileInFile ;
    rdfs:range hpc:MakeFile .

hpc:Compile a owl:ObjectProperty ;
    rdfs:domain hpc:MakeFile ;
    rdfs:range hpc:Command .

hpc:MakeOutputFile a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:MakeOutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Compile ;
    rdfs:range hpc:MakeOutputFile .

hpc:SlurmConf a owl:Class ;

hpc:ConfigurationTool a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:Command .

hpc:EtcSubdirectory a owl:Class .

hpc:ManPage a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:SlurmConf5 a rdfs:subClassOf hpc:ManPage .

hpc:InitDSlurm a owl:Class
