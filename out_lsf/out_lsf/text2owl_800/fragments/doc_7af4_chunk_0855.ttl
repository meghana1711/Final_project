    rdfs:domain hpc:LsfMcNonPrivilegedPorts ;
    rdfs:range xsd:string .

hpc:LsfMcTcpKeepalive a owl:Class .
hpc:hasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:LsfMcTcpKeepalive ;
    rdfs:range xsd:string .

hpc:LsfMisc a owl:Class .
hpc:directory a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfMisc ;
    rdfs:range xsd:string .

hpc:LsfMqBrokerHosts a owl:Class .
hpc:hasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:LsfMqBrokerHosts ;
    rdfs:range xsd:string .

hpc:LsfMqBrokerHostForMqtt a owl:Class ;
    rdfs:subClassOf hpc:LsfMqBrokerHosts .
