hpc:Job a owl:Class .
hpc:amdgpuallocation hpc:propname a owl:ObjectProperty .
hpc:nvidiagpuallocation hpc:propname a owl:ObjectProperty .
hpc:Xgmiconnection rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Nvlinkconnection rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Glinkconnection rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf xsd:boolean .
hpc:Defaultgpuallocation rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Migdevicerequirements a owl:Class .
hpc:gpuinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Migdevicerequirements ;
    rdfs:range xsd:nonNegativeInteger .
hpc:computeinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Migdevicerequirements ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Migvalidinstancesizecombinations a owl:Class .
hpc:miginstancesizecombination a owl:ObjectProperty ;
    rdfs:domain hpc:Migvalidinstancesizecombinations ;
    rdfs:range xsd:boolean .
hpc:Gpuinstancesizeconstraint a owl:Class .
hpc:maxcomputeinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuinstancesizeconstraint ;
    rdfs:range xsd:nonNegativeInteger .
hpc:migdefaultcomputeinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Migdevicerequirements ;
    rdfs:range xsd:nonNegativeInteger .
hpc:gpuReqMerge a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Gpurequirementmerging a owl:Class .
hpc:gpurequirementlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirementmerging ;
    rdfs:range xsd:string .
hpc:gpurequirementlevelorder a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirementmerging ;
    rdfs:range hpc:Gpurequirementlevel .
