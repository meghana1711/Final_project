hpc:Limit a owl:Class .
hpc:synopsis a owl:ObjectProperty .
hpc:description a owl:ObjectProperty .
hpc:Synopsis rdfs:domain hpc:Limit ;
                 rdfs:range rdf:PlainLiteral .
hpc:Description rdfs:domain hpc:Limit ;
                 rdfs:range rdf:PlainLiteral .
hpc:runlimit a owl:DatatypeProperty ;
             rdfs:domain hpc:Limit ;
             rdfs:range xsd:duration .
hpc:runlimitUnit a owl:ObjectProperty .
hpc:RunlimitUnit rdfs:domain hpc:Limit ;
                 rdfs:range xsd:string .
