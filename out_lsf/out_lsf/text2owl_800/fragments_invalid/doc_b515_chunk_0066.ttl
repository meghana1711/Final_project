hpc:hascpuaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Cpuaffinity .
hpc:hasmemoryaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
