hpc:ContainerExecution a owl:Class .
hpc:hasCommand a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerExecution ;
    rdfs:range rdf:Resource .

hpc:InteractiveStep a owl:Class ;
    rdfs:subClassOf hpc:ContainerExecution .

hpc:JobStep a owl:Class ;
    rdfs:subClassOf hpc:ContainerExecution .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:ContainerExecution ;
    rdfs:subClassOf rdf:List ;
    rdfs:first hpc:JobStep .

hpc:hasContainerPath a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerExecution .

hpc:usesMungeAuth a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:usesSlurmScrun a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:usesRootlessDocker a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

# Container Configuration
hpc:ContainerBundle a owl:Class .

hpc:hasAbsolutePath a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerBundle .

hpc:usesExportNone a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerBundle .

# Networking
hpc:ContainerNetworking a owl:Class .
hpc:usesNoneNetworkDriver a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerNetworking .

hpc:isIsolated a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerNetworking .

# Docker Commands
hpc:DockerCommand a owl:Class .
hpc:requiresSecurityOptLabel a owl:ObjectProperty ;
    rdfs:domain hpc:DockerCommand .
hpc:requiresSecurityOptSeccomp a owl:ObjectProperty ;
    rdfs:domain hpc:DockerCommand .
hpc:requiresSecurityOptApparmor a owl:ObjectProperty ;
    rdfs:domain hpc:DockerCommand .
hpc:requiresNetNone a owl:ObjectProperty ;
    rdfs:domain hpc:DockerCommand .

hpc:DockerCommandInContainer a owl:Class ;
    rdfs:subClassOf hpc:DockerCommand .

hpc:notSupportedInContainer a owl:ObjectProperty ;
    rdfs:domain hpc:DockerCommandInContainer .
```
