hpc:jobFinish a owl:ObjectProperty ;
    rdfs:domain hpc:LsbAcct ;
    rdfs:range hpc:Event .

hpc:jobFinish2 a owl:ObjectProperty ;
    rdfs:domain hpc:LsbStream ;
    rdfs:range hpc:Event .

hpc:jobStatus2 a owl:ObjectProperty ;
    rdfs:domain hpc:LsbStatus ;
    rdfs:range hpc:Event .

hpc:dumpinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinfo ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:hasMinCardinality 1 ;
    owl:hasMaxCardinality 2147483646 .

hpc:DumpIntervalDefault a xsd:integer ;
    hpc:DumpInterval rdfs:seeAlso this .

hpc:jobInfoMemoryCacheSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinfo ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:hasMinCardinality 0 ;
    owl:hasMaxCardinality MAX_INT .

hpc:JOB_INFO_MEMORY_CACHE_SIZE_DEFAULT a xsd:integer ;
    hpc:JOB_INFO_MEMORY_CACHE_SIZE rdfs:seeAlso this ;
    hpc:JOB_INFO_MEMORY_CACHE_SIZE rdf:value "1024" .

hpc:MinimumRecommendedCacheSize a xsd:integer ;
    hpc:JOB_INFO_MEMORY_CACHE_SIZE rdfs:seeAlso this ;
    hpc:JOB_INFO_MEMORY_CACHE_SIZE rdf:value "500" .

hpc:Jobinformationcache a owl:Class .
hpc:Jobinfo a owl:Class ;
    rdfs:subClassOf hpc:Jobinformationcache .
