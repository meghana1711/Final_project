hpc:Job a owl:Class .
hpc:Job hasStartTime rdf:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Job hasReason rdf:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Job hasState rdf:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Completedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:bjobsrun a owl:ObjectProperty .
hpc:Bjobsrun rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:bjobsrunwithoptions a owl:ObjectProperty .
hpc:Bjobsrunwithoptions rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:bjobsp a owl:ObjectProperty .
hpc:Bjobsp rdfs:domain hpc:User ;
    rdfs:range hpc:Pendingjob .
hpc:bjobspsum a owl:ObjectProperty .
hpc:Bjobspsum rdfs:domain hpc:User ;
    rdfs:range hpc:Statistic .
hpc:busersw a owl:ObjectProperty .
hpc:Busersw rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:Statistic a owl:Class .
hpc:jobcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Statistic ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hostcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Statistic ;
    rdfs:range xsd:nonNegativeInteger .
hpc:occurrencecount a owl:DatatypeProperty ;
    rdfs:domain hpc:Statistic ;
    rdfs:range xsd:nonNegativeInteger .
