hpc:SlurmdbConfigResponse a owl:Class .
hpc:OpenapiResp a owl:Class .
hpc:SlurmdbdStatsResponse a owl:Class .
hpc:InstancesResponse a owl:Class .

hpc:hasContent a owl:ObjectProperty .

hpc:hasContentTextYAML rdfs:domain hpc:SlurmdbConfigResponse ;
                        rdfs:range xsd:string .
hpc:hasContentApplicationJsonRequest rdfs:domain hpc:SlurmdbConfigResponse ;
                                         rdfs:range hpc:OpenapiResp .

hpc:OpenapiResp rdfs:subClassOf hpc:SlurmdbConfigResponse .
hpc:SlurmdbdStatsResp rdfs:subClassOf hpc:SlurmdbConfigResponse .
hpc:InstancesResp rdfs:subClassOf hpc:SlurmdbConfigResponse .
```
