hpc:clifilterPPreSubmit a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmclifilterplugin ;
    rdfs:range hpc:Slurmclifilterfunction .

hpc:clifilterPPostSubmit a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmclifilterplugin ;
    rdfs:range hpc:Slurmclifilterfunction .

hpc:Slurmclifilterfunction a owl:Class .
