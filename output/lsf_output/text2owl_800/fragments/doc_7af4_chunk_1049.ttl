hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Jobqueue a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:jobwarningaction a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobsubmissionscript a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:jobqueuemodification a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobqueue .

hpc:memoryswaphostlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:resourceenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourceenforcement .

hpc:memoryswaphostlimitenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceenforcement ;
    rdfs:range hpc:Job .

hpc:memoryswaphostlimitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryswaphostlimitenforcement ;
    rdfs:range xsd:string .

hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:resourceenforcementspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Resourceenforcement .

hpc:Lsfconfiguration a owl:Class ;
    rdfs:subClassOf owl:Class .
