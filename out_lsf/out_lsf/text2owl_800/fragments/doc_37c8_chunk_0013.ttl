hpc:Containerjob a owl:Class .
hpc:Dockercontainer a owl:Class .

# Define object properties
hpc:hasremovaloption a owl:ObjectProperty .
hpc:hasnetworkoption a owl:ObjectProperty .
hpc:hasruntimeoption a owl:ObjectProperty .
hpc:haspasswdfile a owl:ObjectProperty .

# Define datatype properties
hpc:passwdfileformat a owl:DatatypeProperty .

# Define domain and range for properties
hpc:Hasremovaloption rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:boolean .
hpc:Hasnetworkoption rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .
hpc:Hasruntimeoption rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .
hpc:Haspasswdfile rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .
hpc:Passwdfileformat rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .

# Define subclass relations
hpc:DockerContainer a hpc:ContainerJob ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty hpc:hasRuntimeOption ;
            owl:hasValue "nvidia" ] ] .

# Define the specific Docker command
hpc:dockercommand a owl:ObjectProperty .
hpc:Dockercommand rdfs:domain hpc:Dockercontainer ;
    rdfs:range xsd:string .

# Define the Docker command for the given example
hpc:exampleDockerCommand a hpc:DockerCommand .
hpc:exampleDockerCommand rdf:value "nvidia-docker[image(ubuntu) options(--rm --net =host --ipc=host -v --runtime =nvidia /path/to/my/passwd:/etc/passwd)]" .

# Define the UNIX/Linux password file format
hpc:unixlinuxpasswdformat a owl:DatatypeProperty .
hpc:Unixlinuxpasswdformat rdfs:domain hpc:Containerjob ;
    rdfs:range rdf:List .
hpc:unixLinuxPasswdFormat rdf:first hpc:user ;
    rdfs:range xsd:string .
hpc:unixLinuxPasswdFormat rdf:rest hpc:passwdDetails ;
    rdfs:range rdf:List .
hpc:passwdDetails rdf:first hpc:uid ;
    rdfs:range xsd:integer .
hpc:passwdDetails rdf:rest hpc:gid ;
    rdfs:range xsd:integer .
hpc:passwdDetails rdf:rest hpc:gecos ;
    rdfs:range xsd:string .
hpc:passwdDetails rdf:rest hpc:homeDirectory ;
    rdfs:range xsd:string .
hpc:passwdDetails rdf:rest hpc:shell ;
    rdfs:range xsd:string .
