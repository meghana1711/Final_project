 rdfs:range xsd:string .

hpc:inuse a owl:DatatypeProperty ;
 rdfs:domain hpc:License .

hpc:reserve a owl:DatatypeProperty ;
 rdfs:domain hpc:License .

hpc:total a owl:DatatypeProperty ;
 rdfs:domain hpc:License .

hpc:available a owl:DatatypeProperty ;
 rdfs:domain hpc:License .

hpc:percentage a owl:DatatypeProperty ;
