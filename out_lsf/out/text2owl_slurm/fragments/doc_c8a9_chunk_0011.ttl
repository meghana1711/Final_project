hpc:Hasreason rdfs:range xsd:string .
hpc:hasstate a owl:DatatypeProperty .
hpc:Hasstate rdfs:domain hpc:Job .
hpc:Hasstate rdfs:range xsd:string .
hpc:hastime a owl:DatatypeProperty .
hpc:Hastime rdfs:domain hpc:Job .
hpc:Hastime rdfs:range xsd:duration .
