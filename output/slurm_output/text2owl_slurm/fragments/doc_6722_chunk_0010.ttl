hpc:Datawarp a owl:Class .
hpc:hasdirective a owl:ObjectProperty ;
    rdfs:domain hpc:Datawarp ;
    rdfs:range xsd:string .

hpc:Jobdw a owl:Class ;
    rdfs:subClassOf hpc:Datawarp ;
    rdfs:comment "For burst buffer directives when using the burst_buffer/datawarp plugin." .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdw ;
    rdfs:range xsd:string .

hpc:capacity a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdw ;
    rdfs:range xsd:decimal .

hpc:accessMode a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdw ;
    rdfs:range xsd:string .

hpc:pfs a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdw ;
    rdfs:range xsd:string .

hpc:StageIn a owl:Class ;
    rdfs:subClassOf hpc:Datawarp ;
    rdfs:comment "For staging in files." .

hpc:typeStageIn a owl:DatatypeProperty ;
    rdfs:domain hpc:StageIn ;
    rdfs:range xsd:string .

hpc:source a owl:DatatypeProperty ;
    rdfs:domain hpc:StageIn ;
    rdfs:range xsd:string .

hpc:destination a owl:DatatypeProperty ;
    rdfs:domain hpc:StageIn ;
    rdfs:range xsd:string .

hpc:StageOut a owl:Class ;
    rdfs:subClassOf hpc:Datawarp ;
    rdfs:comment "For staging out files." .

hpc:typeStageOut a owl:DatatypeProperty ;
    rdfs:domain hpc:StageOut ;
    rdfs:range xsd:string .

hpc:sourceStageOut a owl:DatatypeProperty ;
    rdfs:domain hpc:StageOut ;
    rdfs:range xsd:string .

hpc:destinationStageOut a owl:DatatypeProperty ;
    rdfs:domain hpc:StageOut ;
    rdfs:range xsd:string .

hpc:Lua a owl:Class ;
    rdfs:subClassOf hpc:Datawarp ;
    rdfs:comment "Default directive for this plugin." .

hpc:directive a owl:DatatypeProperty ;
    rdfs:domain hpc:Lua ;
    rdfs:range xsd:string .

hpc:pool a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdw ;
    rdfs:range xsd:string .
