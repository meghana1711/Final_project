hpc:Statusclass a owl:Class .
hpc:status a owl:ObjectProperty .
hpc:jobcount a owl:DatatypeProperty .
hpc:state a owl:DatatypeProperty .
hpc:ssusp a owl:DatatypeProperty .
hpc:ususp a owl:DatatypeProperty .
hpc:rsvp a owl:DatatypeProperty .
hpc:Ssuspended a owl:Class .
hpc:Ususpended a owl:Class .
hpc:Rsvclosed a owl:Class .
hpc:Ok a owl:Class .
hpc:LsfManagement a hpc:StatusClass .
hpc:Host a owl:Class .
hpc:Closed a owl:Class .
hpc:Externaljobcontrol a owl:Class .
hpc:Esubscript a owl:Class .
hpc:Azureprovider a owl:Class .
hpc:Resourcegroup a owl:Class .
hpc:Subscription a owl:Class .
hpc:Instance a owl:Class .
hpc:Resourcelimit a owl:Class .
hpc:Communication a owl:Class .
hpc:Logfile a owl:Class .
hpc:Persistencefile a owl:Class .
hpc:Adminaccount a owl:Class .

hpc:Status rdfs:domain hpc:Statusclass ;
    rdfs:range xsd:integer .
hpc:Jobcount rdfs:domain hpc:Status ;
    rdfs:range xsd:integer .
hpc:State rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:Ssusp rdfs:domain hpc:Status ;
    rdfs:range xsd:boolean .
hpc:Ususp rdfs:domain hpc:Status ;
    rdfs:range xsd:boolean .
hpc:Rsvp rdfs:domain hpc:Status ;
    rdfs:range xsd:boolean .
hpc:Ssuspended rdfs:subClassOf hpc:Suspended .
hpc:Ususpended rdfs:subClassOf hpc:Suspended .
hpc:Rsvclosed rdfs:subClassOf hpc:Closed .
hpc:Ok rdfs:subClassOf hpc:Status .
hpc:LsfManagement a hpc:StatusClass ;
    hpc:JobCount "1"^^xsd:integer ;
    hpc:State "ok"^^xsd:string ;
    hpc:SSUSP "0"^^xsd:boolean ;
    hpc:USUSP "0"^^xsd:boolean ;
    hpc:RSVP "0"^^xsd:boolean .
hpc:Host a hpc:StatusClass .
hpc:Closed a hpc:StatusClass ;
    hpc:JobCount "1"^^xsd:integer ;
    hpc:State "closed"^^xsd:string ;
    hpc:SSUSP "1"^^xsd:boolean ;
    hpc:USUSP "1"^^xsd:boolean ;
    hpc:RSVP "0"^^xsd:boolean .
hpc:Externaljobcontrol a owl:Class .
hpc:Esubscript a owl:Class ;
    rdfs
