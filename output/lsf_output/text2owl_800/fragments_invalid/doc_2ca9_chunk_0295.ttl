hpc:Releasenotes a owl:Class .
hpc:WhatSNew a owl:Class .
hpc:IbmSpectrumLsfLicenseScheduler a owl:Class .
hpc:Version a owl:Class .
hpc:FixPack a owl:Class .

hpc:hasKnownIssuesAndLimitations an owl:ObjectProperty ;
    rdfs:domain hpc:Releasenotes ;
    rdfs:range hpc:Knownissuesandlimitations .

hpc:hasNewBehavior an owl:ObjectProperty ;
    rdfs:domain hpc:WhatSNew ;
    rdfs:range hpc:Newbehavior .

hpc:hasVersion an owl:DatatypeProperty ;
    rdfs:domain hpc:Releasenotes ;
    rdfs:range xsd:string .

hpc:hasFixPack an owl:DatatypeProperty ;
    rdfs:domain hpc:Version ;
    rdfs:range xsd:string .

hpc:IbmSpectrumLsfLicenseSchedulerBasicEdition a owl:Class ;
    rdfs:subClassOf hpc:IbmSpectrumLsfLicenseScheduler .

hpc:IbmSpectrumLsfLicenseSchedulerStandardEdition a owl:Class ;
    rdfs:subClassOf hpc:IbmSpectrumLsfLicenseScheduler .

hpc:Systemrequirementsandcompatibility a owl:Class ;
    rdfs:subClassOf hpc:Releasenotes .

hpc:Differencesbetweeneditions a owl:Class ;
    rdfs:subClassOf hpc:Releasenotes .

hpc:Installationprocedures a owl:Class ;
    rdfs:subClassOf hpc:Releasenotes .

hpc:whatSNewInIbmSpectrumLsfLicenseScheduler a owl:ObjectProperty ;
    rdfs:domain hpc:WhatSNew ;
    rdfs:range hpc:IbmSpectrumLsfLicenseScheduler .

hpc:whatSNewInIbmSpectrumLsfLicenseSchedulerVersion1010FixPack15 a owl:ObjectProperty ;
    rdfs:domain hpc:WhatSNewInIbmSpectrumLsfLicenseScheduler ;
    rdfs:range hpc:Newbehavior .

hpc:whatSNewInIbmSpectrumLsfLicenseSchedulerVersion1010FixPack12 a owl:ObjectProperty ;
    rdfs:domain hpc:WhatSNewInIbmSpectrumLsfLicenseScheduler ;
    rdfs:range hpc:Newbehavior .
