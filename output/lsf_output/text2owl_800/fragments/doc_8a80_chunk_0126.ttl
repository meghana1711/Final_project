hpc:nRetries a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskmancommand ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Project a owl:Class .

hpc:Interactivelicenseproject a owl:Class ;
    rdfs:subClassOf hpc:Project .

hpc:Taskmancommand a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:Rusage a owl:Class .

hpc:rusagetoken a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusage ;
    rdfs:range xsd:nonNegativeInteger .

hpc:rusageduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusage ;
    rdfs:range xsd:duration .

hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Rusage .

hpc:alternativeresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Taskmancommand ;
    rdfs:range hpc:Resourcerequirement .

hpc:compoundresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Taskmancommand ;
    rdfs:range hpc:Resourcerequirement .

hpc:Resourcerequirementlist a owl:Class .

hpc:resourcerequirementor a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementlist ;
    rdfs:range hpc:Resourcerequirement .

hpc:resourcerequirementand a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementlist ;
    rdfs:range hpc:Resourcerequirement .
