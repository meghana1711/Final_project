    rdfs:range xsd:string .

hpc:userSharesValueValue a owl:DatatypeProperty ;
    rdfs:domain hpc:UserSharesValue ;
    rdfs:range xsd:integer .

hpc:fairshare a owl:DatatypeProperty ;
