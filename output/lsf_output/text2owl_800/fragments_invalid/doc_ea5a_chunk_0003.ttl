@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Bigmemapp a owl:Class.
hpc:AppA rdf:value xsd:4.

hpc:Switch a owl:Class.
hpc:hasNode rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Bigmemapp;
    rdfs:range hpc:Node.

hpc:Node a owl:Class.

hpc:s1node1 a hpc:Node;
    hpc:hasSwitch rdf:resource hpc:s1.

hpc:s1node2 a hpc:Node;
    hpc:hasSwitch rdf:resource hpc:s1.

h
