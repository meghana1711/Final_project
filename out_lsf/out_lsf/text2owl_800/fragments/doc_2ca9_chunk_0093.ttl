hpc:Strictgpucpuaffinitybinding a owl:Class .
hpc:gputilevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Strictgpucpuaffinitybinding ;
    rdfs:range xsd:string .
hpc:affyes a owl:DatatypeProperty ;
    rdfs:domain hpc:Strictgpucpuaffinitybinding ;
    rdfs:range xsd:boolean .
hpc:Lsfconffile a owl:Class ;
    rdfs:subClassOf hpc:Configurationfile .
hpc:lsbgpunewsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Strictgpucpuaffinitybinding ;
    rdfs:range hpc:Lsfconffile .
hpc:bsubgpucommandoption a owl:ObjectProperty ;
    rdfs:domain hpc:Strictgpucpuaffinitybinding ;
    rdfs:range hpc:Commandoption .

# Multiple MPS Daemons for GPU Jobs
hpc:Mpsdaemonbehavior a owl:Class .
hpc:mpsyes a owl:DatatypeProperty ;
    rdfs:domain hpc:Mpsdaemonbehavior ;
    rdfs:range xsd:string .
hpc:mpsno a owl:DatatypeProperty ;
    rdfs:domain hpc:Mpsdaemonbehavior ;
    rdfs:range xsd:string .
hpc:mpspersocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Mpsdaemonbehavior ;
    rdfs:range xsd:string .
hpc:mpspergpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Mpsdaemonbehavior ;
    rdfs:range xsd:string .
hpc:Lsfconffile a owl:Class ;
    rdfs:subClassOf hpc:Configurationfile ;
    rdfs:subClassOf hpc:Enablesmpsdaemons .
hpc:gpuresourcerequirementsstring a owl:ObjectProperty ;
    rdfs:domain hpc:Mpsdaemonbehavior ;
    rdfs:range hpc:Gpuresourcerequirements .

# NVIDIA Data Center GPU Manager (DCGM) Integration
hpc:Dcgmintegration a owl:Class .
hpc:lsfdcgmport a owl:DatatypeProperty ;
    rdfs:domain hpc:Dcgmintegration ;
    rdfs:range xsd:integer .
hpc:Lsfconffile a owl:Class ;
    rdfs:subClassOf hpc:Configurationfile ;
    rdfs:subClassOf hpc:Enablesdcgmintegration .
