hpc:Srun a owl:Class .
hpc:hastimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:nonNegativeInteger .
hpc:exitedtask a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:dateTime .
hpc:jobfailed a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:boolean .
hpc:forceterminatedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:string .
hpc:abandonedio a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:boolean .
hpc:jobhold a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:dateTime .
hpc:jobsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:nonNegativeInteger .
hpc:changeablejobsize a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:boolean .
hpc:jobbegintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:dateTime .
hpc:Jobholdstate a owl:Class ;
    rdfs:subClassOf hpc:Srun .
hpc:Job a owl:Class .
