hpc:Awsinstance a owl:Class .
hpc:bsubcommand a owl:ObjectProperty .
hpc:status a owl:DatatypeProperty .
hpc:hostStatus a owl:Enum .
hpc:ok rdf:value "ok" ; rdfs:label "ok" .
hpc:closed_RC rdf:value "closed_RC" ; rdfs:label "closed_RC" .
hpc:bhostscommand a owl:ObjectProperty .
hpc:Ipaddress rdf:type xsd:string ; rdfs:domain hpc:Awsinstance ; rdfs:range xsd:string .
hpc:Maxjobs rdf:type xsd:nonNegativeInteger ; rdfs:domain hpc:Awsinstance .
hpc:Runningjobs rdf:type xsd:nonNegativeInteger ; rdfs:domain hpc:Awsinstance .
hpc:Idletime rdf:type xsd:nonNegativeInteger ; rdfs:domain hpc:Awsinstance .
hpc:Bsubcommand rdfs:domain hpc:Awsinstance .
hpc:Bsubcommand rdfs:range rdf:PlainLiteral .
hpc:Bhostscommand rdfs:domain hpc:Awsinstance .
hpc:Bhostscommand rdfs:range rdf:PlainLiteral .
hpc:Awsinstance rdfs:subClassOf rdf:Resource .
