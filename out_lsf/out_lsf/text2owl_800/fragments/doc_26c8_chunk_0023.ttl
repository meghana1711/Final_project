hpc:Template a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
hpc:hasattribute a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range hpc:Attribute .
hpc:Attribute a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:NamedIndividual ] .
hpc:hastype a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:string .
hpc:hasnumericvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:decimal .
hpc:hasbooleanvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:boolean .
hpc:hasopenstackhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:integer .
hpc:hasuserdata a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
hpc:hasuserscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
hpc:templatepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:integer .
hpc:higherprioritytemplatepreferred a owl:ObjectProperty .
