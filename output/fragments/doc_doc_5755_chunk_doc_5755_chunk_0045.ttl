hpc:SlurmComputer a owl:Class .
hpc:SlurmNode a owl:Class, rdfs:subClassOf hpc:SlurmComputer .
hpc:UserAccount a owl:Class .
hpc:AllocatedNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:UserAccount ;
    rdfs:range hpc:SlurmNode .
hpc:LockedMemoryLimitPropagation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmComputer ;
    rdfs:range xsd:string .
hpc:PAMModule rdf:type owl:Class .
hpc:PamSlurmModule rdf:type owl:Class, rdfs:subClassOf hpc:PAMModule .
hpc:PamSlurmAdoptModule rdf:type owl:Class, rdfs:subClassOf hpc:PamSlurmModule .
hpc:pamListfile rdf:type owl:Class .
hpc:hasPAMModule rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmComputer ;
    rdfs:range hpc:PAMModule .
hpc:requiresPamListfile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PamListfile ;
    rdfs:range xsd:boolean .
```
