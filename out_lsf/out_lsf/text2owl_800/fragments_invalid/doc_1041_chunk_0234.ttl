@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:mused a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:decimal .

hpc:mrsv a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:nonNegativeInteger .

hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Runningjob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:susp a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspendedjob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:rsv a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Vendor a owl:Class .

hpc:ngpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:nonNegativeInteger .

hpc:sharedAvail a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:nonNegativeInteger .

hpc:exclusiveAvail a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:nonNegativeInteger .

hpc:StaticAttributes a owl:Class .

hpc:nvlinkXgmi a owl:DatatypeProperty ;
    rdfs:domain hpc:Staticattribute ;
    rdfs:range xsd:string .

hpc:mig a owl:DatatypeProperty ;
    rdfs:domain hpc:Staticattribute ;
    rdfs:range xsd:boolean .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Gpuresource .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Gpu a owl:Class .
