hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Computationtask ;
    rdfs:comment "A job submitted to a high-performance computing system." .

hpc:Optionsfile a owl:Class ;
    rdfs:subClassOf hpc:File ;
    rdfs:comment "A text file containing options for a job." .

hpc:Spooldirectory a owl:Class ;
    rdfs:subClassOf hpc:Directory ;
    rdfs:comment "A directory where job command files are spooled." .

hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "The action of submitting a job to a high-performance computing system." .

hpc:spoolcommandfile a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "The action of spooling a command file for a job." .

hpc:modifyorremovecommandfile a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "The action of modifying or removing the command file for a job." .

hpc:optionsfiletype a owl:DatatypeProperty ;
    rdfs:domain hpc:Optionsfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of the options file (Bourne shell or Windows batch)." .

hpc:spooldirectoryspecifiedin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Spooldirectory ;
    rdfs:comment "The action of specifying the spool directory in lsb.params." .
