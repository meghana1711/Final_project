hpc:Host a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Resourceconnector a owl:Class .
hpc:Openstackvm a owl:Class .

hpc:closedRc a owl:DatatypeProperty .
hpc:drainedofjobs a owl:ObjectProperty .
hpc:notifiesresourceconnector a owl:ObjectProperty .
hpc:terminatesopenstackvm a owl:ObjectProperty .
hpc:deallocateshost a owl:ObjectProperty .
hpc:pingablebyhostname a owl:ObjectProperty .
hpc:configureddns a owl:ObjectProperty .
hpc:restartlsfdaemons a owl:ObjectProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Managementhost rdfs:subClassOf hpc:Host .
hpc:Resourceconnector rdfs:subClassOf owl:Class .
hpc:Openstackvm rdfs:subClassOf owl:Class .

hpc:ClosedRc rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:Drainedofjobs rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Host .
hpc:Notifiesresourceconnector rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Managementhost .
hpc:Terminatesopenstackvm rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Openstackvm .
hpc:Deallocateshost rdfs:domain hpc:Openstackvm ;
    rdfs:range hpc:Host .
hpc:Pingablebyhostname rdfs:domain hpc:Host ;
    rdfs:range hpc:Host .
hpc:Configureddns rdfs:domain hpc:Managementhost .
hpc:Restartlsfdaemons rdfs:domain hpc:Managementhost .
