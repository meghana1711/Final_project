hpc:Njobs a owl:Class .
hpc:currentjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:paralleljob a owl:ObjectProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range hpc:Njobs .
hpc:pendingjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runningjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:systemsuspendedjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:usersuspendedjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:exitedordonejobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Sla a owl:Class .
hpc:serviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Sla ;
    rdfs:range rdf:Resource .
hpc:Jlimit a owl:Class .
hpc:jobgrouplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jlimit ;
    rdfs:range xsd:string .
hpc:usedlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jlimit ;
    rdfs:range xsd:string .
