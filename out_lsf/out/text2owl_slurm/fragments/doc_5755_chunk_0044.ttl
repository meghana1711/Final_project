hpc:Slurmec2usage a owl:Class .
hpc:Ec2instance a owl:Class ;
    rdfs:subClassOf hpc:Computenode .

hpc:generatehostsfile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmec2usage ;
    rdfs:range hpc:File .

hpc:generateslurmconf a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmec2usage ;
    rdfs:range hpc:File .

hpc:rsyncfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmec2usage ;
    rdfs:range hpc:Action .

hpc:ec2instanceresolvable a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:boolean .

# PAM user limits
hpc:Pamuserlimitcontrol a owl:Class ;
    rdfs:subClassOf hpc:Usermanagement .

hpc:enablepam a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:boolean .

hpc:pamconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Pamuserlimitcontrol ;
    rdfs:range hpc:File .

hpc:pamconfigureslurm a owl:ObjectProperty ;
    rdfs:domain hpc:Pamconfiguration ;
    rdfs:range hpc:Pammodule .

hpc:Pammodule a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:pamlimitsetting a owl:ObjectProperty ;
    rdfs:domain hpc:Pamuserlimitcontrol ;
    rdfs:range hpc:Limitsetting .

hpc:propagateresourcelimitsexcept a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
