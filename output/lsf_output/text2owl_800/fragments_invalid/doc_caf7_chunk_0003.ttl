hpc:Lsfbindir a owl:Class;
    rdfs:subClassOf owl:Directory;
    rdfs:subClassOf hpc:Installationdirectory .
hpc:LsfBindir rdf:type owl:Class;
    rdfs:subClassOf rdf:Resource;
    rdfs:subClassOf owl:Class .
hpc:Lsfbindir rdfs:subClassOf owl:Directory;
    rdfs:subClassOf hpc:Installationdirectory .

hpc:LSF_BINDIR rdf:type rdfs:Literal;
    rdfs:comment "Directory containing LSF user commands, which are shared by all hosts of the same type" .

hpc:Lsfconfdir a owl:Class;
    rdfs:subClassOf owl:Directory;
    rdfs:subClassOf hpc:Installationdirectory .
hpc:LsfConfdir rdf:type owl:Class;
    rdfs:subClassOf rdf:Resource;
    rdfs:subClassOf owl:Class .
hpc:Lsfconfdir rdfs:subClassOf owl:Directory;
