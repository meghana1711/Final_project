hpc:application_profile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Applicationprofile ;
    rdfs:comment "Displays information about the specified application profile." .

hpc:description
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The description of the application profile." .

hpc:profilesCharacteristicsAndStatistics
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The characteristics and statistics of the application profile." .

hpc:parameters
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The parameters of the application profile." .

hpc:cgroup_CPU_SHARES_FACTOR_percentage
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The CGROUP_CPU_SHARES_FACTOR percentage for the application profile." .

hpc:resourceUsageLimits
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource usage limits for the application profile." .

hpc:associatedCommands
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The associated commands for the application profile." .

hpc:bindingPolicy
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The binding policy for the application profile." .

hpc:niceValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The NICE value for the application profile." .

hpc:jobControls
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The job controls for the application profile." .

hpc:pendingTimeLimits
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The pending time limits for the application profile." .

hpc:eligiblePendingTimeLimits
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The eligible pending time limits for the application profile." .
