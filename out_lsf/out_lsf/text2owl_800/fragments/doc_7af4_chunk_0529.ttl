hpc:Limit a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .

hpc:Applicationprofile a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:enforcedon a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Applicationprofile .

hpc:Allapplicationprofiles a owl:Class ;
    rdfs:subClassOf hpc:Applicationprofile .

hpc:Excludeapplicationprofiles a owl:Class ;
    rdfs:subClassOf hpc:Applicationprofile .

hpc:perApp a owl:ObjectProperty .
hpc:PerApp rdfs:domain hpc:Limit ;
    rdfs:range rdf:List .
hpc:PER_APP rdfs:subPropertyOf hpc:enforcedOn .

hpc:PER_APP_all a owl:NamedIndividual ;
    hpc:PER_APP (hpc:all rdf:first hpc:ApplicationProfile) .

hpc:PER_APP_exclude a owl:NamedIndividual ;
    hpc:PER_APP (hpc:exclude rdf:first hpc:ApplicationProfile) .
