hpc:jobarrayjobslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A collection of jobs submitted as a single unit." .

hpc:createjobarray a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobarray ;
    rdfs:comment "The act of creating a job array." .

hpc:jobarraysize a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of jobs in a job array." .

hpc:maxjobarraysize a owl:DatatypeProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of jobs in a job array that can run at any one time." .

hpc:jobarrayinputfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The directory containing the input files for all jobs in the job array." .

hpc:jobarrayoutputfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The directory where the output files for all jobs in the job array will be stored." .

hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of a job within its job array." .

hpc:lsbjobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of a job within its job array, provided by LSF." .

hpc:jobarraypreparationdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The directory where the input files for the jobs in the job array should be prepared." .
