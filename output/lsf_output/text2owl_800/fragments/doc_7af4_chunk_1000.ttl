hpc:Lsadmin a owl:Class .
hpc:hasValidValue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsadmin ;
    rdfs:range xsd:string .

hpc:LicenseSchedulerAdminAccount a hpc:LSAdmin ;
    hpc:hasValidValue "lsadmin" .

hpc:Useraccount a owl:Class .
hpc:Licensescheduleradminaccount rdfs:subClassOf hpc:Useraccount .

hpc:Lsadminlist a owl:Class .
hpc:hasLSAdmin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsadminlist ;
    rdfs:range xsd:string .

hpc:Lsadminlistvalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:LSAdminListValues a hpc:LSAdminList ;
    hpc:hasLSAdminValue "user1" ;
    hpc:hasLSAdminValue "user2" .

hpc:Licenseschedulerhost a owl:Class .
hpc:hasValidValue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Licenseschedulerhost ;
    rdfs:range xsd:string .

hpc:Lshosts a owl:Class .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:string .

hpc:Lshostsvalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:LSHostsValues a hpc:LSHosts ;
    hpc:hasHostValue "host_name1" ;
    hpc:hasHostValue "host_name2" .

hpc:lsstatpath a owl:DatatypeProperty .

hpc:LMStatPath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsstatpath ;
    rdfs:range xsd:string .

hpc:Lmstatpathvalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:LMStatPathValues a hpc:LMStatPath ;
    hpc:hasLMStatPathValue "/usr/bin" .

hpc:lstop a owl:DatatypeProperty .

hpc:LSTop rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lstop ;
    rdfs:range xsd:string .

hpc:Lstopvalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:LSTopValues a hpc:LSTop ;
    hpc:hasLSTopValue "/path" .
