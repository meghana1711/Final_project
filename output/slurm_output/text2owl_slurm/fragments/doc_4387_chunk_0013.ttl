hpc:authinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .

hpc:authtype a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration ;
    rdfs:range xsd:string .

hpc:Databasenode a owl:Class .

hpc:databaseport a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:integer .

hpc:DefaultPort xsd:integer "6819" .

hpc:logfile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .

hpc:pluginpath a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration ;
    rdfs:range xsd:string .
