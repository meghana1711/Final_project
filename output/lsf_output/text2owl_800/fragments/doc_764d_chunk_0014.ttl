hpc:Cluster a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Hasuser rdfs:domain hpc:Cluster ;
                     rdfs:range hpc:User .
hpc:Incluster rdfs:domain hpc:Host ;
               rdfs:range hpc:Cluster .
hpc:Hashost rdfs:domain hpc:Cluster ;
              rdfs:range hpc:Host .
hpc:Isuserof rdfs:domain hpc:User ;
              rdfs:range hpc:Cluster .
hpc:Send rdfs:domain hpc:Host ;
          rdfs:range hpc:Cluster .
hpc:Recv rdfs:domain hpc:Cluster ;
          rdfs:range hpc:Host .
hpc:Multicluster a owl:Class .
hpc:Awareof rdfs:domain hpc:Cluster ;
              rdfs:range hpc:Cluster .
hpc:restrictedawareness a owl:ObjectProperty .
hpc:Allowedinteraction rdfs:domain hpc:Cluster ;
                       rdfs:range hpc:Cluster .
