hpc:Topologyfunction a owl:Class .
hpc:Block a owl:Class .
hpc:Switch a owl:Class .
hpc:Node a owl:Class .

hpc:blockx a owl:ObjectProperty .
hpc:switchy a owl:ObjectProperty .
hpc:blockwith a owl:ObjectProperty .
hpc:switchwith a owl:ObjectProperty .

hpc:scontrolupdate a owl:ObjectProperty .
hpc:sbatch a owl:ObjectProperty .
hpc:partitionname a owl:DatatypeProperty .
hpc:nodes a owl:DatatypeProperty .

hpc:Environmentvariable a owl:Class .
hpc:slurmTopologyAddr a owl:DatatypeProperty .
hpc:SlurmTopologyAddr rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .

hpc:SlurmTopologyAddrComponent a owl:Class .
hpc:SlurmTopologyAddrComponent rdfs:subClassOf hpc:Node .
hpc:SlurmTopologyAddrComponent rdfs:subClassOf hpc:Switch .

hpc:slurmTopologyAddrType a owl:DatatypeProperty .
hpc:SlurmTopologyAddrType rdfs:domain hpc:SlurmTopologyAddrComponent ;
    rdfs:range xsd:string .

hpc:Multipletopologies a owl:Class .
hpc:topologyyaml a owl:DatatypeProperty .
hpc:Topologyyaml rdfs:domain hpc:Multipletopologies ;
    rdfs:range xsd:string .
