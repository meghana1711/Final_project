hpc:CpuTimeFactor a xsd:decimal; rdfs:range xsd:decimal .
hpc:RunJobFactor a xsd:decimal; rdfs:range xsd:decimal .
hpc:RunTimeFactor a xsd:decimal; rdfs:range xsd:decimal .
hpc:FairshareAdjustmentFactor a xsd:decimal; rdfs:range xsd:decimal .

hpc:Dynamicprioritycalculation a owl:Class .
hpc:withhistoricalruntime a owl:ObjectProperty .
hpc:withouthistoricalruntime a owl:ObjectProperty .

hpc:Job a owl:Class .
hpc:isrunning a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:hasdecayedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:hashistoricalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:hasruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:dynamicprioritycalculationwithhistoricalruntime a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Dynamicprioritycalculation ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:dynamicprioritycalculationwithouthistoricalruntime a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Dynamicprioritycalculation ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:runtimedecay a owl:ObjectProperty .
hpc:appliestorunningjob a owl:ObjectProperty ;
    rdfs:domain hpc:Runtimedecay ;
    rdfs:range hpc:Job .
hpc:decaysovertime a owl:ObjectProperty ;
    rdfs:domain hpc:Runtimedecay .
hpc:istransferredtohistoricalruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Runtimedecay ;
    rdfs:range hpc:Job .

hpc:resumesuspendedjobusingruntimedecay a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
