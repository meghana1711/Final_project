hpc:checkpointing a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpoint .

hpc:initialcheckpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger .

hpc:checkpointfrequency a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpoint .

hpc:checkpointmethodname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:restartmethodname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Checkpointmethod a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:Checkpoint a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:Job a owl:Class .

hpc:LSF_SERVERDIR a owl:NamedIndividual .
hpc:LSB_ECHKPNT_METHOD_DIR a owl:NamedIndividual .
