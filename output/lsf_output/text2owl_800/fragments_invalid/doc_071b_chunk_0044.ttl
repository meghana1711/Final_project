hpc:Loadsched rdfs:domain hpc:LoadThreshold ;
                     rdfs:range hpc:Total ;
                     rdfs:range hpc:Reserved .
hpc:Loadstop rdfs:domain hpc:LoadThreshold ;
                     rdfs:range hpc:Total ;
                     rdfs:range hpc:Reserved .
hpc:ThresholdAndLoad a owl:Class .
