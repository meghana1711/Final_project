hpc:Mcsparameters a owl:Class .
hpc:preemptmode a owl:ObjectProperty .
hpc:Job a owl:Class .
hpc:gracetime a owl:DatatypeProperty .
hpc:userwarningsignal a owl:DatatypeProperty .
hpc:Licenses a owl:Class .
hpc:preemptparameters a owl:DatatypeProperty .
hpc:selecttype a owl:ObjectProperty .
