hpc:Lsfconfdirectory a owl:Class .
hpc:Lsfserver a owl:Class .
hpc:Lsfimage a owl:Class .
hpc:Lsfsimulator a owl:Class .
hpc:Lsfconfigurationpackage a owl:Class .
hpc:extractlsfsimulator a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range hpc:Lsfimage .
hpc:copylsfsimulatorpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range hpc:Lsfconfigurationpackage .
hpc:sourcelsfenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfshell ;
    rdfs:range hpc:Lsfconfdirectory .
hpc:createlsfconfigurationpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsimulator ;
    rdfs:range hpc:Lsfconfigurationpackage .
hpc:LSFConf a hpc:LSFConfiguration .
hpc:productionClusterSharedir a hpc:LSFConfDirectory ;
    rdfs:comment "The LSF configuration directory on the production cluster shared directory." .
hpc:lsf a hpc:LSFServer ;
    rdfs:comment "An LSF server host in the production cluster." .
hpc:lsfSimulator a hpc:LSFImage ;
    rdfs:comment "The lsf_simulator image." .
hpc:lsfSimulatorPackage a hpc:LSFConfigurationPackage ;
    rdfs:comment "A tar or tar.gz file containing the LSF configuration." .
hpc:Lsfconfdirectory rdfs:subClassOf hpc:Lsfconfdirectory .
hpc:Lsfserver rdfs:subClassOf hpc:Lsfserver .
hpc:Lsfimage rdfs:subClassOf hpc:Lsfimage .
hpc:Lsfsimulatorpackage rdfs:subClassOf hpc:Lsfconfigurationpackage .
