hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:Host a owl:Class .
hpc:migration a owl:ObjectProperty .
hpc:MigrateImmediately a xsd:integer .
hpc:checkpoint a owl:ObjectProperty .
hpc:CheckpointPeriod a xsd:integer .
hpc:CheckpointDirectory a xsd:string .
hpc:Requeue a xsd:integer .
hpc:RequeueToBottom a xsd:integer .
hpc:joblevelmigrationthreshold a owl:DatatypeProperty .
hpc:applicationprofilemigrationthreshold a owl:DatatypeProperty .
hpc:queuemigrationthreshold a owl:DatatypeProperty .
hpc:hostmigrationthreshold a owl:DatatypeProperty .
hpc:jobsubmission a owl:ObjectProperty .
hpc:jobrestart a owl:ObjectProperty .
hpc:jobcheckpoint a owl:ObjectProperty .

hpc:Job rdfs:subClassOf hpc:Resource .
hpc:Queue rdfs:subClassOf hpc:Resource .
hpc:Host rdfs:subClassOf hpc:Resource .

hpc:Migration rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:Migrateimmediately rdfs:domain hpc:Migration ;
    rdfs:range xsd:integer .
hpc:Checkpoint rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:Checkpointperiod rdfs:domain hpc:Checkpoint ;
    rdfs:range xsd:integer .
hpc:Checkpointdirectory rdfs:domain hpc:Checkpoint ;
    rdfs:range xsd:string .
hpc:Requeue rdfs:domain hpc:Migration ;
    rdfs:range xsd:integer .
hpc:Requeuetobottom rdfs:domain hpc:Requeue ;
    rdfs:range xsd:integer .
hpc:Joblevelmigrationthreshold rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Applicationprofilemigrationthreshold rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:Queuemigrationthreshold rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:Hostmigrationthreshold rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Jobsubmission rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:Jobrestart rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:Jobcheckpoint rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
