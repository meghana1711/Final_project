hpc:Submissionqueue a owl:Class .
hpc:Executionqueue a owl:Class .
hpc:jobforwardingrate a owl:ObjectProperty .
hpc:lsbMaxForwardPerSession a owl:DatatypeProperty .
hpc:imptJobbklg a owl:DatatypeProperty .
hpc:schedulingcycletime a owl:DatatypeProperty .
hpc:maxRschedTime a owl:DatatypeProperty .

hpc:Submissionqueue rdfs:subClassOf owl:Class .
hpc:Executionqueue rdfs:subClassOf owl:Class .
hpc:JobForwardingRate rdf:domain hpc:SubmissionQueue ;
                          rdf:range rdf:Resource .
hpc:LSB_MAX_FORWARD_PER_SESSION rdf:domain hpc:SubmissionQueue ;
                                 rdfs:range xsd:integer .
hpc:ImpT_JOBBKLG rdf:domain hpc:ExecutionQueue ;
                   rdfs:range xsd:integer .
hpc:SchedulingCycleTime rdf:domain hpc:SubmissionQueue ;
                          rdfs:range xsd:float .
hpc:MAX_RSCHED_TIME rdf:domain hpc:ExecutionQueue ;
                        rdfs:range xsd:integer .
