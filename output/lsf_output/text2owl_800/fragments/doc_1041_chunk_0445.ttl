hpc:Outputformat a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Bqueuesfield a owl:Class ;
    rdfs:subClassOf owl:Class .

# Object Properties
hpc:hasfield a owl:ObjectProperty ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range rdf:List .

hpc:fieldorder a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fieldwidth a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fieldjustification a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:string .

hpc:fieldalias a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:string .

hpc:showallfields a owl:ObjectProperty ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range xsd:boolean .

hpc:colonwidth a owl:ObjectProperty ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:truncateoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:boolean .

hpc:rightjustify a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield ;
    rdfs:range xsd:boolean .

hpc:delimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range xsd:string .

# Datatype Properties
hpc:hasversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range xsd:string .
