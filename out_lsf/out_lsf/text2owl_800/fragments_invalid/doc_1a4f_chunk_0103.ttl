hpc:Job a owl:Class .
hpc:tasklimit a owl:DatatypeProperty .
hpc:minimumtasklimit a owl:DatatypeProperty .
hpc:defaulttasklimit a owl:DatatypeProperty .
hpc:absoluterunlimit a owl:ObjectProperty .
hpc:Lsbparams a owl:Class .
hpc:Lsbapplications a owl:Class .
hpc:preexecutioncommands a owl:ObjectProperty .
hpc:queuelevelpreexecutioncommands a owl:ObjectProperty .
hpc:joblevelpreexecutioncommands a owl:ObjectProperty .
hpc:applicationlevelpreexecutioncommands a owl:ObjectProperty .
hpc:postexecutioncommands a owl:ObjectProperty .
hpc:joblevelpostexecutioncommands a owl:ObjectProperty .
hpc:applicationlevelpostexecutioncommands a owl:ObjectProperty .
hpc:jobbasedpostexecutioncommands a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Tasklimit rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Minimumtasklimit rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Defaulttasklimit rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Absoluterunlimit rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Lsbparams rdfs:subClassOf owl:Class .
hpc:Lsbapplications rdfs:subClassOf owl:Class .
hpc:Preexecutioncommands rdfs:domain hpc:Job ;
    rdfs:range rdf:* .
hpc:Queuelevelpreexecutioncommands rdfs:domain hpc:Queue ;
    rdfs:range rdf:* .
hpc:Joblevelpreexecutioncommands rdfs:domain hpc:Job ;
    rdfs:range rdf:* .
hpc:Applicationlevelpreexecutioncommands rdfs:domain hpc:Applicationprofile ;
    rdfs:range rdf:* .
hpc:Postexecutioncommands rdfs:domain hpc:Job ;
    rdfs:range rdf:* .
hpc:Joblevelpostexecutioncommands rdfs:domain hpc:Job ;
    rdfs:range rdf:* .
hpc:Applicationlevelpostexecutioncommands rdfs:domain hpc:Applicationprofile ;
    rdfs:range rdf:* .
hpc:Jobbasedpostexecutioncommands rdfs:domain hpc:Job ;
    rdfs:range rdf:* .

1 le hpc:MinimumTaskLimit owl:lessThanOrEqual hpc:DefaultTaskLimit .
1 le hpc:DefaultTaskLimit owl:lessThanOrEqual hpc:MaximumTaskLimit .

hpc:AbsRunlimit rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:AbsoluteRunLimit .

hpc:Normalizedbyhostcpufactor rdfs:domain hpc:Runtimelimit ;
    rdfs:range xsd:boolean .

hpc:Absolutewallclockruntime rdfs:subClassOf hpc:Runtimelimit .
