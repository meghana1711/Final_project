hpc:Hostpowerstatus a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf (hpc:Event .) .

hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:eventtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range xsd:dateTime .

hpc:requestid a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:opcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:trigger a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range hpc:Poweroperationtrigger .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpowerstatus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Poweroperationtrigger a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf (hpc:Powerpolicy .) ;
    rdfs:subClassOf (hpc:Job .) ;
    rdfs:subClassOf (hpc:Badminhpower .) .
