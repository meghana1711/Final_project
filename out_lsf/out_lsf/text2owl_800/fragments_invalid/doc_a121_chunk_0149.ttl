hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the system." .

hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The CPU time used by the job." .

hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The runtime of the job." .

hpc:resourceusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The resource usage of the job." .

hpc:postexecutionprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether post-execution processing is included in the resource usage." .

hpc:Preexecretrylimitexceeded a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job where the pre-exec retry limit was exceeded." .

hpc:jobstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The current status of the job." .

hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a pending job." .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a running job." .

hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a suspended job." .

hpc:Finishedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a finished job." .

hpc:Accountingstatistics a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents accounting statistics for finished jobs." .

hpc:Bacct a owl:Class ;
    rdfs:subClassOf hpc:Accountingstatistics ;
    rdfs:comment "Displays accounting statistics for finished jobs." .

hpc:preexecutioncommandchange a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command ;
    rdfs:comment "Changes the pre-execution command at the job level." .

hpc:postexecutioncommandchange a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command ;
    rdfs:comment "Changes the post-execution command at the job level." .

hpc:postdone a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
