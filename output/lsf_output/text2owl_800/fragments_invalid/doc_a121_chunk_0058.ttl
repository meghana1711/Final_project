hpc:Lsfjob a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Submissionhost a owl:Class .
hpc:Filetransfer a owl:Class .
hpc:Spooledcommandfile a owl:Class .
hpc:Commandfile a owl:Class .

# Object Properties
hpc:issubmittedby a owl:ObjectProperty .
hpc:isexecutedon a owl:ObjectProperty .
hpc:hasspooledcommandfile a owl:ObjectProperty .
hpc:hascommandfile a owl:ObjectProperty .
hpc:copiesfrom a owl:ObjectProperty .
hpc:copiesto a owl:ObjectProperty .
hpc:cancelslastspooledcommandfile a owl:ObjectProperty .
hpc:modifiescommand a owl:ObjectProperty .

# Datatype Properties
hpc:jobid a owl:DatatypeProperty .
hpc:executiondirectory a owl:DatatypeProperty .
hpc:status a owl:DatatypeProperty .
hpc:outputdirectory a owl:DatatypeProperty .

# Domain and Range
rdfs:domain hpc:Issubmittedby hpc:Submissionhost .
rdfs:domain hpc:Isexecutedon hpc:Executionhost .
rdfs:domain hpc:Hasspooledcommandfile hpc:Lsfjob .
rdfs:domain hpc:Hascommandfile hpc:Lsfjob .
rdfs:domain hpc:Copiesfrom hpc:Filetransfer .
rdfs:domain hpc:Copiesto hpc:Filetransfer .
rdfs:domain hpc:Cancelslastspooledcommandfile hpc:Lsfjob .
rdfs:domain hpc:Modifiescommand hpc:Lsfjob .
rdfs:range hpc:Jobid xsd:string .
rdfs:range hpc:Executiondirectory xsd:string .
rdfs:range hpc:Status xsd:string .
rdfs:range hpc:Outputdirectory xsd:string .

# Subclass
hpc:Spooledcommandfile a rdfs:subClassOf hpc:Commandfile .
