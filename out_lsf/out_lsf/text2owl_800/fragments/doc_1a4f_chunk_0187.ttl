hpc:Jobsubmission a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:selectionstring a owl:DatatypeProperty .
hpc:orderstring a owl:DatatypeProperty .
hpc:usagestring a owl:DatatypeProperty .
hpc:spanstring a owl:DatatypeProperty .

hpc:Compoundresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Simpleresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .

hpc:Compoundresourcerequirement rdfs:domain hpc:Jobsubmission .

hpc:hascompoundresourcerequirement a owl:ObjectProperty .
hpc:hassimpleresourcerequirement a owl:ObjectProperty .

hpc:Compoundresourcerequirement rdfs:range hpc:Compoundresourcerequirementlist .
hpc:CompoundResourceRequirementList rdf:type owl:Collection .
hpc:CompoundResourceRequirementList rdfs:member hpc:CompoundResourceRequirement .

hpc:Simpleresourcerequirement rdfs:range hpc:Simpleresourcerequirement .

hpc:Selectionstring rdfs:domain hpc:Simpleresourcerequirement .
hpc:Orderstring rdfs:domain hpc:Simpleresourcerequirement .
hpc:Usagestring rdfs:domain hpc:Simpleresourcerequirement .
hpc:Spanstring rdfs:domain hpc:Simpleresourcerequirement .

hpc:Selectionstring rdfs:range xsd:string .
hpc:Orderstring rdfs:range xsd:string .
hpc:Usagestring rdfs:range xsd:string .
hpc:Spanstring rdfs:range xsd:string .

hpc:numslots a owl:DatatypeProperty .
hpc:defaultslotsetting a owl:DatatypeProperty .
hpc:tasklimit a owl:DatatypeProperty .

hpc:Numslots rdfs:domain hpc:Jobsubmission .
hpc:Defaultslotsetting rdfs:domain hpc:Jobsubmission .
hpc:Tasklimit rdfs:domain hpc:Jobsubmission .

hpc:Numslots rdfs:range xsd:nonNegativeInteger .
hpc:Defaultslotsetting rdfs:range xsd:string .
hpc:Tasklimit rdfs:range xsd:string .
