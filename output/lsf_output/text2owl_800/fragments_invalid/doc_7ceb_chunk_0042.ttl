hpc:Badminreconfig a owl:Class .
hpc:hasReconfigErrors an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Badminreconfig ;
    rdfs:range xsd:boolean .

hpc:Troubleshootinglsfproblems a owl:Class .
hpc:ConfigurationReference an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Troubleshootinglsfproblems ;
    rdfs:range xsd:URI .

hpc:CommandReference an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Troubleshootinglsfproblems ;
    rdfs:range xsd:URI .

hpc:Lsfstartupconfigure a owl:Class .
hpc:Lsfstartupconfigure rdfs:subClassOf hpc:Configuration .

hpc:lsfstartup a owl:ObjectProperty .
hpc:Lsfstartup rdfs:domain hpc:Lsfstartupconfigure ;
    rdfs:range hpc:Lsfdaemon .

hpc:lsfstartupautomatically a owl:ObjectProperty .
hpc:Lsfstartupautomatically rdfs:domain hpc:Lsfstartupconfigure ;
    rdfs:range xsd:boolean .

hpc:Lsfadministrator a owl:Class .

hpc:lsfsudoers a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfstartupconfigure ;
    rdfs:range hpc:Lsfsudoersfile .

hpc:Lsfsudoersfile a owl:Class .

hpc:Lsfdaemonstartcontrol a owl:Class .

hpc:lsfdaemonstartablebylsfadministrator a owl:ObjectProperty .
hpc:Lsfdaemonstartablebylsfadministrator rdfs:domain hpc:Lsfdaemon ;
    rdfs:range hpc:Lsfadministrator .

hpc:lsfdaemonstartableautomatically a owl:ObjectProperty .
hpc:Lsfdaemonstartableautomatically rdfs:domain hpc:Lsfdaemon ;
    rdfs:range xsd:boolean .

hpc:Lsfdaemonstartupcontrol a owl:Class .
