hpc:Lsflicensescheduler a owl:Class .
hpc:hasglobalvalue a owl:ObjectProperty .
hpc:Hasglobalvalue rdfs:domain hpc:Lsflicensescheduler .
hpc:Hasglobalvalue rdfs:range xsd:string .

hpc:hasfeaturevalue a owl:ObjectProperty .
hpc:Hasfeaturevalue rdfs:domain hpc:Lsflicensescheduler .
hpc:Hasfeaturevalue rdfs:range xsd:string .

hpc:lmRemoveSuspJobs a owl:DatatypeProperty .
hpc:LmRemoveSuspJobs rdfs:domain hpc:Lsflicensescheduler .
hpc:LmRemoveSuspJobs rdfs:range xsd:nonNegativeInteger .

hpc:lmRemoveSuspJobsDescription a owl:DatatypeProperty .
hpc:LmRemoveSuspJobsDescription rdfs:domain hpc:LmRemoveSuspJobs .
hpc:LmRemoveSuspJobsDescription rdfs:range xsd:string .

hpc:lmRemoveInterval a owl:DatatypeProperty .
hpc:LmRemoveInterval rdfs:domain hpc:LmRemoveSuspJobs .
hpc:LmRemoveInterval rdfs:range xsd:nonNegativeInteger .

hpc:Fastdispatchprojectmode a owl:Class .
hpc:Lsflicensescheduler rdfs:subClassOf hpc:Fastdispatchprojectmode .
