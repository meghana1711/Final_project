hpc:Project a owl:Class .
hpc:License a owl:Class .
hpc:Group a owl:Class .
hpc:haslicense a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:License .
hpc:belongstogroup a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Group .
hpc:groupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Project .
hpc:Lp1 a hpc:Project ;
    hpc:hasLicense 5 ;
    hpc:usedLicenses 6 .
hpc:Lp2 a hpc:Project ;
    hpc:hasLicense 5 ;
    hpc:usedLicenses 0 .
hpc:Lp3 a hpc:Project ;
    hpc:hasLicense 5 ;
    hpc:usedLicenses 7 .
hpc:Lp4 a hpc:Project ;
    hpc:hasLicense 5 ;
    hpc:usedLicenses 7 .
hpc:GroupA a hpc:Group .
hpc:GroupB a hpc:Group .
hpc:Groupa hpc:groupmembership Lp1 .
hpc:Groupa hpc:groupmembership Lp2 .
hpc:Groupb hpc:groupmembership Lp3 .
hpc:Groupb hpc:groupmembership Lp4 .
hpc:Appy a owl:Class .
hpc:Appy hpc:distribution rdf:PlainLiteral "LanServer1(Lp1 5/5 Lp2 5/5 Lp3 5/5 Lp4 5/5)" .
hpc:Appy hpc:group rdf:PlainLiteral "GroupA(Lp1 Lp2) GroupB (Lp3 Lp4)" .
