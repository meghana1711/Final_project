hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Resource a owl:Class .
hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:Queue a owl:Class .
hpc:queuelevelresourceallocationlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Host a owl:Class .
hpc:loadindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:float .
hpc:candidatehost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:schedulingthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:schedulingpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:availableresource a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:submitjob a owl:ObjectProperty .
hpc:Defaultqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
