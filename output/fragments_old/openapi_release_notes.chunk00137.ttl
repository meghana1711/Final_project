hpc:QosResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:QosDeleteResponse a hpc:QosResponse ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf hpc:QosResponse ] .

hpc:QosDeleteResponseSchema a owl:ObjectProperty ;
    rdfs:domain hpc:QosDeleteResponse ;
    rdfs:range xsd:anyURI .

hpc:TresResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf hpc:QosResponse ] .

hpc:TresGetResponse a hpc:TresResponse ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf hpc:TresResponse ] .

hpc:TresPostRequest a owl:ObjectProperty ;
    rdfs:domain hpc:TresResponse ;
    rdfs:range xsd:anyURI .
