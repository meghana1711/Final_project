hpc:JobSubmitPlugin a owl:Class .
hpc:hasJobRequest rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmitPlugin ;
    rdfs:range hpc:JobRequest .
hpc:hasSystemPartitions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmitPlugin ;
    rdfs:range hpc:SystemPartition .
hpc:setPartition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmitPlugin ;
    rdfs:range xsd:string .

hpc:JobSubmitPluginAPI a owl:Class .

hpc:PluginNone a owl:Class ;
    rdfs:subClassOf hpc:JobSubmitPlugin .

hpc:Parameter a owl:Class .
hpc:hasPlugin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range rdfs:Resource .

hpc:AccountingStorageType a hpc:Parameter .
hpc:AcctGatherEnergyType a hpc:Parameter .
hpc:AcctGatherInterconnectType a hpc:Parameter .
hpc:AcctGatherFilesystemType a hpc:Parameter .
hpc:AcctGatherProfileType a hpc:Parameter .
hpc:CliFilterPlugins a hpc:Parameter .
hpc:CoreSpecPlugin a hpc:Parameter .
hpc:ExtSensorsType a hpc:Parameter .
hpc:JobAcctGatherType a hpc:Parameter .
hpc:JobCompType a hpc:Parameter .
hpc:JobContainerType a hpc:Parameter .
hpc:MCSPlugin a hpc:Parameter .
hpc:MpiDefault a hpc:Parameter .
hpc:PowerParameters a hpc:Parameter .
hpc:PreemptType a hpc:Parameter .
hpc:PrioritySiteFactorPlugin a hpc:Parameter .
hpc:SwitchType a hpc:Parameter .
hpc:TaskPlugin a hpc:Parameter .
hpc:TopologyPlugin a hpc:Parameter .

hpc:AccountingDatabase a owl:Class .
hpc:slurmdbd a owl:Class ;
    rdfs:subClassOf hpc:AccountingDatabase .

hpc:hasAddedSecurity rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AccountingDatabase ;
    rdfs:range xsd:boolean .
