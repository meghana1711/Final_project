hpc:Remotefileaccess a owl:Class .
hpc:checkmtab a owl:ObjectProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range hpc:Localmountpoint .
hpc:sshcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range hpc:Sshcommand .
hpc:noprefixfound a owl:ObjectProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range hpc:Remotesshexecution .
hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range hpc:Bsubcommandtype .
hpc:bstageincommand a owl:ObjectProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range hpc:Bstageincommandtype .
hpc:errorreturned a owl:ObjectProperty ;
    rdfs:domain hpc:Bstageincommand ;
    rdfs:range xsd:boolean .
hpc:Cacheaccesscontrol a owl:Class ;
    rdfs:subClassOf hpc:Remotefileaccess .
hpc:Datatag a owl:Class ;
    rdfs:subClassOf hpc:Cacheaccesscontrol .
hpc:Datafile a owl:Class ;
    rdfs:subClassOf hpc:Cacheaccesscontrol .
hpc:changeusergroupownership a owl:ObjectProperty ;
    rdfs:domain hpc:Datatag, hpc:Datafile ;
    rdfs:range hpc:Usergroup .
hpc:configureusergroupcacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Cacheaccesscontrol ;
    rdfs:range xsd:boolean .
hpc:Cachepermissions a owl:Class ;
    rdfs:subClassOf hpc:Cacheaccesscontrol .
hpc:AllValue a xsd:string .
hpc:setfilepermissions a owl:ObjectProperty ;
    rdfs:domain hpc:Cachepermissions ;
    rdfs:range hpc:Allvalue .
hpc:StagingAreaSubdirectories a xsd:string .
hpc:SingleCache a xsd:string .
hpc:SharedByAllUsers a xsd:string .
