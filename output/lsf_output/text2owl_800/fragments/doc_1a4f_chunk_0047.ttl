hpc:Resourcerequirement a owl:Class .
hpc:Reservation a owl:Class .
hpc:Dynamicexternalresource a owl:Class .
hpc:Elimexecutable a owl:Class .
hpc:runjob a owl:ObjectProperty .
hpc:Hasresourcerequirement rdfs:domain hpc:Runjob ;
                               rdfs:range hpc:Resourcerequirement .
hpc:Loadinformation a owl:Class .
hpc:loadinformationbyresource a owl:ObjectProperty .
hpc:Hasresource rdfs:domain hpc:Loadinformationbyresource ;
                             rdfs:range xsd:string .
hpc:Configurationchange a owl:Class .
hpc:Admincommand a owl:Class .
hpc:reconfigure a owl:ObjectProperty .
hpc:restartlim a owl:ObjectProperty .
hpc:Hasimpactedlim rdfs:domain hpc:Restartlim ;
                    rdfs:range xsd:string .
hpc:Configurationdisplay a owl:Class .
hpc:displayconfiguration a owl:ObjectProperty .
hpc:Hasresourcename rdfs:domain hpc:Displayconfiguration ;
                      rdfs:range xsd:string .
