hpc:Battach a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Command to connect to a job execution host or container." .

hpc:battach a owl:ObjectProperty ;
    rdfs:domain hpc:Battach ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Command to directly connect to an existing job execution host or container for a specified job." .

hpc:battachShell a owl:DatatypeProperty ;
    rdfs:domain hpc:Battach ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies an alternate shell to run when connecting to a job execution host or container." .

hpc:battachM a owl:ObjectProperty ;
    rdfs:domain hpc:Battach ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Connects to the specified job execution host for non-Docker jobs or the specified job container on the job execution host for Docker jobs." .

hpc:PamSession a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "LSF opening a PAM session when submitting jobs to Linux hosts." .

hpc:usePamCreds a owl:DatatypeProperty ;
    rdfs:domain hpc:PamSession ;
    rdfs:range xsd:string ;
    rdfs:comment "Parameter to enable the PAM session." .

hpc:limits a owl:DatatypeProperty ;
    rdfs:domain hpc:PamSession ;
    rdfs:range xsd:string ;
    rdfs:comment "Keyword to use together with the session keyword." .

hpc:submitJob a owl:ObjectProperty ;
    rdfs:domain hpc:PamSession ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Submits job tasks into a PAM session." .
