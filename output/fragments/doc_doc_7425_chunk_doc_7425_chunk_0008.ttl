hpc:CR_Type a owl:Class .
hpc:openMode a owl:DatatypeProperty ;
    rdfs:domain hpc:CR_Type ;
    rdfs:range xsd:string ;
    rdf:enum "APPEND" ;
    rdf:enum "TRUNCATE" .

hpc:OpenApiJobInfoResp a owl:Class .
hpc:lastBackfill a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenApiJobInfoResp ;
    rdfs:range xsd:string ;
    rdfs:comment "Time of last backfill scheduler run (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .
hpc:lastUpdate a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenApiJobInfoResp ;
    rdfs:range xsd:string ;
    rdfs:comment "Time of last job change (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .

hpc:OpenApiJobPostResponse a owl:Class .
hpc:results a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenApiJobPostResponse ;
    rdfs:range xsd:string ;
    rdfs:comment "Job update results (Job update results)" .

hpc:OpenApiKillJobResp a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenApiKillJobResp ;
    rdfs:range xsd:string ;
    rdfs:comment "resultant status of signal request (List of jobs signal responses)" .

hpc:OpenApiKillJobsResp a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenApiKillJobsResp ;
    rdfs:range xsd:string ;
    rdfs:comment "resultant status of signal request (List of jobs signal responses)" .

