hpc:Primarylsf Administrator a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The first user account name in the list is the primary LSF administrator." .

hpc:Secondarylsf Administrator a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Secondary LSF administrators are optional." .

hpc:lsfAdmins a owl:ObjectProperty ;
    rdfs:domain hpc:Primarylsf Administrator ;
    rdfs:range xsd:string ;
    rdfs:comment "Existing user accounts" .

hpc:lsfClusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "Required." .
