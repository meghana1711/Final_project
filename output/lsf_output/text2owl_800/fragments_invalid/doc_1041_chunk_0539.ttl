hpc:Host a owl:Class .
hpc:Localhost rdfs:subClassOf hpc:Host .
hpc:Remotehost rdfs:subClassOf hpc:Host .
hpc:Reservation a owl:Class .
hpc:reservationname a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:ReservationNameMinLength rdf:datatype xsd:nonNegativeInteger ;
    rdfs:range 1 ;
    rdfs:subPropertyOf hpc:ReservationName .
hpc:ReservationNameMaxLength rdf:datatype xsd:nonNegativeInteger ;
    rdfs:range 40 ;
    rdfs:subPropertyOf hpc:ReservationName .
hpc:ReservationNameFirstChar rdf:datatype xsd:string ;
    rdfs:range "([A-Z])" ;
    rdfs:subPropertyOf hpc:ReservationName .
hpc:ReservationNameAllowedChars rdf:datatype xsd:string ;
    rdfs:range "[A-Za-z0-9_-\"]" ;
    rdfs:subPropertyOf hpc:ReservationName .
hpc:ReservationNameUniqueInCluster rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationNameSystemAssigned rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationErrorMessage rdf:datatype xsd:string ;
    rdfs:domain hpc:Reservation ;
    rdfs:range "The specified reservation name is referenced by a job." .
hpc:ReservationNameSpecified rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationNameNotSpecified rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationNameUsedByJob rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationNameUserDefined rdf:datatype xsd:boolean ;
    rdfs:range "true" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:ReservationNameSystemAssignedPattern rdf:datatype xsd:string ;
    rdfs:range "user_name#sequence" ;
    rdfs:subPropertyOf hpc:Reservation .
hpc:reservationunit a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range owl:Thing .
hpc:ReservationUnitSlot rdf:datatype xsd:string ;
    rdfs:range "slot" ;
    rdfs:subPropertyOf hpc:ReservationUnit .
hpc:ReservationUnitHost rdf:datatype xsd:string ;
    rdfs:range "host" ;
