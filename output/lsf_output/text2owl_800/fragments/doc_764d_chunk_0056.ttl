hpc:Cluster a owl:Class .
hpc:Equivalentcluster a owl:Class .
hpc:remotehost a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Admincluster a owl:Class .
hpc:remoteclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:List .
hpc:equiv a owl:DatatypeProperty ;
    rdfs:domain hpc:Remoteclusters .
hpc:Remoteresource a owl:Class .
hpc:remoteresourceavailability a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:List .
hpc:submissionforwardpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:mcPluginRemoteResource a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
hpc:mcPluginScheduleEnhance a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Remoteresource .
hpc:resourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
hpc:userdefinedresource a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:boolean .
