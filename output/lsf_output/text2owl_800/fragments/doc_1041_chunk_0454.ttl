hpc:Job a owl:Class .
hpc:cpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:tasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:swaplimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:cpulimitGraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:minimumtasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:maximumtasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cpulimitScalingfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
