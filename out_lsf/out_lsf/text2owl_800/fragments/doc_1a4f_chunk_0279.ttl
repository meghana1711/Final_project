hpc:processlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Limits the number of concurrent processes that can be part of a job." .

hpc:defaultprocesslimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Processlimit ;
    rdfs:comment "If a default process limit is specified, jobs submitted to the queue without a job-level process limit are killed when the default process limit is reached." .

hpc:maximumprocesslimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "If you specify only one limit, it is the maximum, or hard, process limit." .

hpc:softprocesslimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "If you specify two limits, the first one is the default, or soft, process limit." .

hpc:runtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "It sets the run time limit of a job." .

hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runtimelimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The maximum amount of time a job can run before it is terminated." .

hpc:rununit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The units of the run limit." .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the host name." .

hpc:hostmodel a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the host model." .

hpc:deadlineconstraintscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:comment "With deadline constraint scheduling configured, a run limit also specifies the amount of time a job is expected to take, and the minimum amount of time that must be available before a job can be started." .
