hpc:Command a owl:Class .
hpc:hassignalvalue a owl:ObjectProperty .
hpc:hassignalname a owl:DatatypeProperty .
hpc:hasKillReason rdf:type owl:DatatypeProperty .
hpc:hasUserName rdf:type owl:DatatypeProperty .
hpc:hasUserGroup rdf:type owl:DatatypeProperty .
hpc:hasJobID rdf:type owl:DatatypeProperty .
hpc:hasJobIDList rdf:type owl:ObjectProperty .
hpc:hasCommandLineOption rdf:type owl:DatatypeProperty .

hpc:Command rdfs:subClassOf owl:Class .
hpc:Hassignalvalue rdfs:domain hpc:Command ;
                     rdfs:range xsd:string .
hpc:Hassignalname rdfs:domain hpc:Command ;
                     rdfs:range xsd:string .
hpc:Haskillreason rdfs:domain hpc:Command ;
                   rdfs:range xsd:string .
hpc:Hasusername rdfs:domain hpc:Command ;
                 rdfs:range xsd:string .
hpc:Hasusergroup rdfs:domain hpc:Command ;
                  rdfs:range xsd:string .
hpc:Hasjobid rdfs:domain hpc:Command ;
               rdfs:range xsd:integer .
hpc:Hasjobidlist rdfs:domain hpc:Command ;
                 rdfs:range rdf:List .
hpc:Hascommandlineoption rdfs:domain hpc:Command ;
                      rdfs:range xsd:string .
