hpc:Lsfhost a owl:Class .
hpc:Lsfcommand a owl:Class .
hpc:Osuser a owl:Class .
hpc:LSFAdministrator rdf:type owl:Class .
hpc:LsfSudoersFile rdf:type owl:Class .
hpc:LsfConfFile rdf:type owl:Class .
hpc:lsfrshcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Lsfcommand .
hpc:startcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Osuser ;
    rdfs:range hpc:Lsfcommand .
hpc:shutdowncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadministrator ;
    rdfs:range hpc:Lsfcommand .
hpc:restartcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Osuser ;
    rdfs:range hpc:Lsfcommand .
hpc:Daemon a owl:Class .
hpc:daemonaction a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range xsd:string .
hpc:SystemctlCommands rdf:type owl:Class .
hpc:HostCluster rdf:type owl:Class .
hpc:reconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Hostcluster ;
    rdfs:range xsd:string .
hpc:Sbatchddaemon a owl:Class .
hpc:LIM rdf:type owl:Class .
hpc:ResDaemon rdf:type owl:Class .
hpc:JobHost rdf:type owl:Class ;
    rdfs:subClassOf hpc:Lsfhost .
hpc:DaemonNotResponding rdf:type owl:Class .
hpc:ManagementHost rdf:type owl:Class .
hpc:ErrorMessage rdf:type owl:Class .
hpc:HostTakeover rdf:type owl:Class .
