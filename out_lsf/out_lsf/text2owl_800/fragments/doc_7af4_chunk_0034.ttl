    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:utime a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:stime a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:options3 a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:avgmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:effectiveresreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:srccluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:srcjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:dstcluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
