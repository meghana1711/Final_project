hpc:Package a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A collection of resources with a specific type guarantee." .

hpc:slots a owl:ObjectProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of slots in a package." .

hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The memory allocated to a package." .

hpc:Guaranteepool a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A pool of resources with a specific type guarantee." .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A physical machine in the HPC system." .

hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range rdf:List ;
    rdfs:comment "The hosts or host groups that the guarantee is enforced on." .

hpc:resselect a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteepool ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource requirement string for hosts defined by the HOSTS parameter." .
