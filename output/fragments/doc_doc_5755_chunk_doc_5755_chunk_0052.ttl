hpc:SlurmConfiguration a owl:Class .
hpc:useInteractiveStep a owl:ObjectProperty .
hpc:SlurmConfiguration rdfs:subClassOf owl:Class .
hpc:useInteractiveStep rdfs:domain hpc:SlurmConfiguration ;
                          rdfs:range xsd:boolean .

hpc:TmpfsJobContainer a owl:Class .
hpc:JobContainerType a owl:ObjectProperty .
hpc:TmpfsJobContainer rdfs:subClassOf owl:Class .
hpc:JobContainerType rdfs:domain hpc:TmpfsJobContainer ;
                       rdfs:range xsd:string .

hpc:JobContainerConf a owl:Class .
hpc:BasePath a owl:DatatypeProperty .
hpc:JobContainerConf rdfs:subClassOf owl:Class .
hpc:BasePath rdfs:domain hpc:JobContainerConf ;
                 rdfs:range xsd:string .

hpc:MountPath a owl:DatatypeProperty .
hpc:MountPath rdfs:domain hpc:TmpfsJobContainer ;
             rdfs:range xsd:string .

hpc:PrivateTmp a owl:Class .
hpc:PrivateShm a owl:Class .
hpc:PrivateTmp rdfs:subClassOf hpc:MountPath .
hpc:PrivateShm rdfs:subClassOf hpc:MountPath .
```
