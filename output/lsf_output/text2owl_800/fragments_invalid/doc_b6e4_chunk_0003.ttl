@base <http://example.org/hpc/>

hpc:Lsfwebserviceserver a owl:Class ;
    rdfs:subClassOf a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Lsfwebserviceserver rdfs:subClassOf owl:OperatingSystem .

hpc:Operatingsystem a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Operatingsystem rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf owl:Linux .

hpc:Linux a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Linux rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf owl:Linuxx64 ;
    rdfs:subClassOf owl:Linuxarm .

hpc:Linuxx64 a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf owl:Rhel ;
