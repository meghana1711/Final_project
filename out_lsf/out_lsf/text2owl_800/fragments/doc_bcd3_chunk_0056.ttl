hpc:Bqueuescommand a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Customizedbqueuesoutput a owl:Class ;
    rdfs:subClassOf hpc:Bqueuescommand .

hpc:Modifiedformatbqueuesoption a owl:Class ;
    rdfs:subClassOf hpc:Bqueuesoption .

hpc:Unmodifiedformatbqueuesoption a owl:Class ;
    rdfs:subClassOf hpc:Bqueuesoption .

hpc:Bqueuesfield a owl:Class .

# Object Properties
hpc:appliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesoption ;
    rdfs:range hpc:Bqueuescommand .

hpc:hasalias a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield .

hpc:hasunits a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield .

hpc:haswidth a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesfield .

# Datatype Properties
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:supportedwidth a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

hpc:unitofmeasurement a owl:DatatypeProperty ;
    rdfs:range xsd:string .

# Instances
hpc:BQueuesFormat a hpc:BQueuesOption ;
    hpc:fieldName "LSB_BQUEUES_FORMAT" ;
    hpc:Appliesto hpc:customizedbqueuesoutput ;
    hpc:hasAlias "bqueues -o" .

hpc:NoHeader a hpc:BQueuesOption ;
    hpc:fieldName "bqueues -noheader" ;
    hpc:Appliesto hpc:customizedbqueuesoutput ;
    hpc:hasAlias "noheader" .

hpc:Json a hpc:BQueuesOption ;
    hpc:fieldName "bqueues -json" ;
    hpc:Appliesto hpc:customizedbqueuesoutput .

hpc:QHist a hpc:CustomizedBQueuesOutput .

hpc:Corelimit a hpc:BQueuesField ;
    hpc:fieldName "corelimit" ;
    hpc:hasAlias "max_corelimit" .
