hpc:Logclass a owl:Class .
hpc:Logclass rdfs:subClassOf hpc:LsDebugCmd .

hpc:LsEnableMaxPreempt a owl:Class .
hpc:LsEnableMaxPreempt rdfs:domain xsd:string .
hpc:LsEnableMaxPreempt rdfs:range ( "Y" "N" ) .

hpc:LsMaxTaskmanPreempt a owl:Class .
hpc:LsMaxTaskmanPreempt rdfs:domain xsd:string .

hpc:LsLogMask a owl:Class .
hpc:LsLogMask rdfs:domain xsd:string .

hpc:messageLogLevel a owl:DatatypeProperty .
hpc:MessageLogLevel rdfs:domain hpc:LsLogMask .
hpc:MessageLogLevel rdfs:range xsd:string .

hpc:log_level a owl:Enum .
hpc:LogLevel rdfs:subClassOf xsd:string .
hpc:LogLevel rdfs:range ( "LOG_ERR" "LOG_WARNING" "LOG_INFO" "LOG_DEBUG" "LOG_DEBUG1" "LOG_DEBUG2" "LOG_DEBUG3" ) .

hpc:logLevelHierarchy a owl:ObjectProperty .
hpc:LogLevelHierarchy rdfs:domain hpc:LogLevel .
hpc:LogLevelHierarchy rdfs:range hpc:LogLevel .
hpc:log_level_hierarchy rdfs:subPropertyOf rdf:< .
