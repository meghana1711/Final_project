hpc:Runtime a owl:Class .
hpc:ContainerRuntime a owl:Class .
hpc:NvidiaContainerRuntime rdf:type hpc:ContainerRuntime ;
    rdfs:subClassOf hpc:Runtime .
hpc:Singularity rdf:type hpc:ContainerRuntime ;
    rdfs:subClassOf hpc:Runtime .
hpc:HpcngSingularity rdf:type hpc:Singularity .

hpc:RunTimeStart a owl:ObjectProperty ;
    rdfs:domain hpc:NvidiaContainerRuntime ;
    rdfs:range xsd:string .
hpc:RunTimeKill a owl:ObjectProperty ;
    rdfs:domain hpc:NvidiaContainerRuntime ;
    rdfs:range xsd:string .
hpc:RunTimeDelete a owl:ObjectProperty ;
    rdfs:domain hpc:NvidiaContainerRuntime ;
    rdfs:range xsd:string .
hpc:RunTimeQuery a owl:ObjectProperty ;
    rdfs:domain hpc:NvidiaContainerRuntime ;
    rdfs:range xsd:string .
hpc:RunTimeRun a owl:ObjectProperty ;
    rdfs:domain hpc:NvidiaContainerRuntime ;
    rdfs:range xsd:string .

hpc:IgnoreFileConfigJson a xsd:boolean .
hpc:EnvExclude a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:RunTimeEnvExclude a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .

hpc:OciMode a owl:Class ;
    rdfs:subClassOf hpc:Singularity .

hpc:OciState a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:OciCreate a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:OciRun a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:OciKill a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:OciDelete a owl:ObjectProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
