hpc:Lsfserver a owl:Class .
hpc:LSFManagementHost rdf:subClassOf hpc:LSFServer .
hpc:PrimaryLSFAdministrator rdf:subClassOf rdf:Resource .
hpc:startlsf a owl:ObjectProperty .
hpc:stoplsf a owl:ObjectProperty .
hpc:reconfigurelsf a owl:ObjectProperty .
hpc:LSFHost rdf:subClassOf hpc:LSFServer .
hpc:LSFDaemon rdf:subClassOf hpc:LSFHost .
hpc:lim rdf:type hpc:LSFDaemon ;
    rdfs:comment "Lim daemon" .
hpc:res rdf:type hpc:LSFDaemon ;
    rdfs:comment "Resource daemon" .
hpc:sbd rdf:type hpc:LSFDaemon ;
    rdfs:comment "Submission daemon" .
hpc:StartLSFDomain rdf:type hpc:StartLSF ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Lsfdaemon .
hpc:StopLSFDomain rdf:type hpc:StopLSF ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Lsfdaemon .
hpc:ReconfigureLSFDomain rdf:type hpc:ReconfigureLSF ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Lsfhost .
