hpc:v0_0_41_openapi_assocs_resp a owl:Class .
hpc:v0_0_41_openapi_assocs_removed_resp a owl:Class .

hpc:AssociationResponse a owl:Class, rdfs:Resource .
hpc:AssociationResponse rdfs:subClassOf [ hpc:v0_0_41_openapi_assocs_resp ; owl:unionOf (hpc:v0_0_41_openapi_assocs_removed_resp) ] .

hpc:hasContent a owl:ObjectProperty .
