hpc:Interactiveidletime a owl:Class .
hpc:hasinteractiveidletime a owl:DatatypeProperty .
hpc:Hasinteractiveidletime rdfs:domain hpc:Interactiveidletime .
hpc:Hasinteractiveidletime rdfs:range xsd:nonNegativeInteger .
hpc:haspagingrate a owl:DatatypeProperty .
hpc:Haspagingrate rdfs:domain hpc:Interactiveidletime .
hpc:Haspagingrate rdfs:range xsd:nonNegativeInteger .
hpc:Suspendingcondition a owl:Class .
hpc:Suspendingcondition rdfs:subClassOf hpc:Interactiveidletime .
hpc:Suspendingcondition rdfs:range xsd:boolean .
hpc:SuspendingCondition rdf:value "it<1 && pg>50" .
hpc:Resumingcondition a owl:Class .
hpc:Resumingcondition rdfs:subClassOf hpc:Interactiveidletime .
hpc:Resumingcondition rdfs:range xsd:boolean .
hpc:ResumingCondition rdf:value "it>5 && pg<10" .
hpc:idlethreshold a owl:DatatypeProperty .
hpc:Idlethreshold rdfs:domain hpc:Interactiveidletime .
hpc:Idlethreshold rdfs:range xsd:nonNegativeInteger .
