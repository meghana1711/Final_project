hpc:EgoDaemon   a owl:Class .
hpc:LsfDaemon   a owl:Class .
hpc:MbdDaemon   a owl:Class .

hpc:cpuAllocation  a owl:ObjectProperty ;
                     rdfs:domain hpc:EgoDaemon ;
                     rdfs:range xsd:nonNegativeInteger .

hpc:lsfDaemonCpus  a owl:DatatypeProperty ;
                      rdfs:domain hpc:LsfDaemon ;
                      rdfs:range xsd:nonNegativeIntegerList .

hpc:mbdQueryCpus  a owl:DatatypeProperty ;
                     rdfs:domain hpc:MbdDaemon ;
                     rdfs:range xsd:nonNegativeIntegerList .

hpc:mbdRefreshTime  a owl:DatatypeProperty ;
                       rdfs:domain hpc:MbdDaemon ;
                       rdfs:range xsd:nonNegativeInteger .

hpc:minRefreshTime  a owl:DatatypeProperty ;
                       rdfs:domain hpc:MbdRefreshTime ;
                       rdfs:range xsd:nonNegativeInteger .

hpc:lsbQueryPort  a owl:ObjectProperty ;
                     rdfs:domain hpc:MbdRefreshTime ;
                     rdfs:range xsd:nonNegativeInteger .

hpc:MBD_REFRESH_TIME_Range  a owl:Restriction ;
                             rdfs:onProperty hpc:MBD_REFRESH_TIME ;
                             rdfs:minValue 0 ;
                             rdfs:maxValue 300 .
