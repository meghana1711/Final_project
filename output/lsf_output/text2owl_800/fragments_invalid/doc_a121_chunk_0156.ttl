hpc:Jobstarter a owl:Class .
hpc:hasJobCommands an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range xsd:string .
hpc:runsunder a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range xsd:string .
hpc:defaultUserCommands rdf:PlainLiteral "true" .
hpc:USRCMD rdf:PlainLiteral "%USRCMD" .
hpc:USRCMDWithAdditionalCommands rdf:PlainLiteral "%USRCMD; ..." .
hpc:Jobcommandline a owl:Class ;
    rdfs:subClassOf hpc:Jobstarter .
hpc:Windowsexecutionhost a owl:Class .
hpc:Unixexecutionhost a owl:Class .
hpc:LsfBindir a owl:Class .
hpc:Executionhostdefaultenvironment a owl:Class .
hpc:Submissionhostsettings a owl:Class .
hpc:Executionhostsettings a owl:Class .
hpc:preservestarter a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range hpc:Executionhostdefaultenvironment .
hpc:augmentstarter a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range hpcs:executionHostDefaultEnvironment ;
    rdfs:range hpc:Submissionhostsettings .
hpc:bsublforwindows a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range xsd:boolean .
hpc:jobstarterlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range xsd:string .
hpc:defaultPathOnExecutionHost rdf:PlainLiteral "/" .
hpc:WindowsPath rdf:PlainLiteral "%WINDIR%" .
hpc:UNIXPath rdf:PlainLiteral "$HOME/bin" .
hpc:LsfMiscExamples a owl:Class .
