hpc:Csmerrorcode a owl:Class .
hpc:Rescheduleablejob a owl:Class .
hpc:Excludederrorcode a owl:Class .

hpc:hasCSMErrorCode an owl:ObjectProperty ;
    rdfs:domain hpc:Rescheduleablejob ;
    rdfs:range hpc:Csmerrorcode .

hpc:isExcluded an owl:ObjectProperty ;
    rdfs:domain hpc:Rescheduleablejob ;
    rdfs:range hpc:Excludederrorcode .

hpc:Csmerrorcoderange a owl:Class ;
    rdfs:subClassOf hpc:Csmerrorcode .

hpc:hasStartEndErrorCodes rdfs:DatatypeProperty ;
    rdfs:domain hpc:Csmerrorcoderange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Rescheduleablejob a rdfs:subClassOf hpc:Job .
hpc:rescheduleableJob
    hpc:hasCSMErrorCode some hpc:hasCSMErrorCode ;
    minCardinality 1 .

hpc:Excludederrorcode a rdfs:subClassOf hpc:Csmerrorcode .
hpc:excludedErrorCode
    hpc:isExcluded some hpc:isExcluded ;
    minCardinality 1 .

hpc:CSMErrorCodeRange
    hpc:hasStartEndErrorCodes some hpc:hasStartEndErrorCodes ;
    minCardinality 2 .
