hpc:Singularityserver a owl:Class .
hpc:singularityversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Singularityserver ;
    rdfs:range xsd:string .

hpc:singularityexecutable a owl:ObjectProperty ;
    rdfs:domain hpc:Singularityserver ;
    rdfs:range xsd:string .

hpc:Singularityimage a owl:Class .

hpc:singularityimagepreparation a owl:ObjectProperty ;
    rdfs:domain hpc:Singularityimage ;
    rdfs:range xsd:boolean .

hpc:singularityimageaccessibility a owl:ObjectProperty ;
    rdfs:domain hpc:Singularityimage ;
    rdfs:range xpc:SingularityHost .

hpc:singularitycontainerdirectorybinding a owl:ObjectProperty ;
    rdfs:domain hpc:Singularityserver ;
    rdfs:range hpc:Directory .

hpc:singularitycontainercustomization a owl:ObjectProperty ;
    rdfs:domain hpc:Singularityserver ;
    rdfs:range hpc:Starterscript .

hpc:Singularitycontainerjob a owl:Class .

hpc:Preexecutionoperation a owl:Class .
hpc:Postexecutionoperation a owl:Class .

hpc:datapreparation a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionoperation ;
    rdfs:range hpc:Mounteddirectory .

hpc:containercustomization a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutionoperation ;
    rdfs:range hpc:Starterscript .

hpc:Containerjobprofile a owl:Class ;
    rdfs:subClassOf hpc:Applicationprofile ;
    hpc:container a owl:DatatypeProperty ;
        rdfs:domain hpc:Containerjobprofile .

hpc:Containerqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    hpc:container a owl:DatatypeProperty ;
        rdfs:domain hpc:Containerqueue .

hpc:Mountedfilesystem a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Executionuser a owl:Class .
hpc:Starterscript a owl:Class .
hpc:Directory a owl:Class .
