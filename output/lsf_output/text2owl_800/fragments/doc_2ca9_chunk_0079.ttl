hpc:LSF_ROOT_USER
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The root users on these specified hosts can remotely execute commands." .

hpc:LSF_DISABLE_LSRUN
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Setting LSF_DISABLE_LSRUN=N in the lsf.conf file to enable hosts that are running LSF Application Center to use the lsrun and lsgrun commands." .

hpc:LSF_ADDON_HOSTS
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF_ADDON_HOSTS parameter in the lsf.conf file" .

hpc:LS_ROOT_USER
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LS_ROOT_USER parameter in the lsf.licensescheduler file" .

hpc:LSF_ROOT_REX
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF_ROOT_REX parameter in the lsf.conf file" .

hpc:JobSubmissionOptionFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Job submission option files" .

hpc:bsubCommandOption
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:domain hpc:Jobsubmissionoptionfile ;
    rdfs:range rdf:Resource ;
    rdfs:comment "bsub command options" .

hpc:bsubJSONCommandOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionoptionfile ;
    rdfs:range rdf:Resource ;
    rdfs:comment "bsub -json command option" .

hpc:bsubYAMLCommandOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionoptionfile ;
    rdfs:range rdf:Resource ;
    rdfs:comment "bsub -yaml command option" .

hpc:JobSubmissionEnvironment
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "View the job submission environment" .

hpc:bjobsEnvCommandOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionenvironment ;
    rdfs:range rdf:Resource ;
    rdfs:comment "bjobs -env command option" .

hpc:bjobsScriptCommandOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionenvironment ;
    rdfs:range rdf:Resource ;
    rdfs:comment "bjobs -script command option" .

hpc:LSFApplicationCenterDesktopClientHost
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF can now use LSF Application Center desktop client hosts as job submission hosts." .
