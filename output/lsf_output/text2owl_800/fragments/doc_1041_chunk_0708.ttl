hpc:IgnoreDeadline a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:Runlimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .

hpc:Jobqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:Chunkjobqueue a owl:Class ;
    rdfs:subClassOf hpc:Jobqueue .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workflowelement .

hpc:Serviceclass a owl:Class .

hpc:estimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:runlimitoverridden a owl:ObjectProperty ;
    rdfs:domain hpc:IgnoreDeadline ;
    rdfs:range hpc:Jobqueue .

hpc:jobchunking a owl:ObjectProperty ;
    rdfs:domain hpc:Jobqueue ;
    rdfs:range xsd:boolean .

hpc:runlimitexceeded a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:runlimitgreaterthan a owl:ObjectProperty ;
    rdfs:domain hpc:Jobqueue ;
    rdfs:range xsd:duration .

hpc:jobscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Scheduling .

hpc:jobdependency a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Dependencyexpression .

hpc:Scheduling a owl:Class .

hpc:Dependencyexpression a owl:Class .

hpc:runtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:jobrunlimitratio a owl:DatatypeProperty ;
    rdfs:domain hpc:Params ;
    rdfs:range xsd:decimal .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:duration .
