hpc:Lsf a owl:Class .
hpc:badmincommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Command .

hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Command .

hpc:bqueuescommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Command .

hpc:Lsfclustermanagement a owl:Class ;
    rdfs:subClassOf hpc:Lsf .

hpc:lsadmincommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfclustermanagement ;
    rdfs:range hpc:Command .

hpc:lsadminckconfigcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfclustermanagement ;
    rdfs:range hpc:Command .

hpc:lsadminckconfigdetailedinfo a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsadminckconfigcommand ;
    rdfs:range xsd:string .

hpc:Lsfconfigurationfile a owl:Class .

hpc:lim a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfclustermanagement ;
    rdfs:range hpc:Daemon .

hpc:res a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfclustermanagement ;
    rdfs:range hpc:Daemon .
