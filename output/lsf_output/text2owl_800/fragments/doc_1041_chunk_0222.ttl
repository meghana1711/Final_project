hpc:Unreachablehost a owl:Class .
hpc:hasunreachablesbatchd a owl:ObjectProperty .
hpc:Closedhost a owl:Class .
hpc:ismemberofcomputeunit a owl:ObjectProperty .
hpc:Exclusivecomputeunitjob a owl:Class .
hpc:lsfmulticlustercapability a owl:ObjectProperty .
hpc:maxjobslotsperuser a owl:DatatypeProperty .
hpc:maxjobslots a owl:DatatypeProperty .

hpc:Hasunreachablesbatchd rdfs:domain hpc:Unreachablehost ;
    rdfs:range hpc:Host .

hpc:Ismemberofcomputeunit rdfs:domain hpc:Host ;
    rdfs:range hpc:Computeunit .

hpc:Exclusivecomputeunitjob rdfs:subClassOf hpc:Job .

hpc:Lsfmulticlustercapability rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:boolean .

hpc:Maxjobslotsperuser rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Maxjobslots rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:nonNegativeInteger .
