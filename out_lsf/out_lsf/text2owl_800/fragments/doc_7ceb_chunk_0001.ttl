hpc:LsfOverview a owl:Class .
hpc:ClusterOverview a owl:Class ;
    rdfs:subClassOf hpc:LsfOverview .
hpc:WorkWithLsf a owl:Class ;
    rdfs:subClassOf hpc:LsfOverview .
hpc:TroubleshootingLsfProblems a owl:Class ;
    rdfs:subClassOf hpc:LsfOverview .
hpc:LsfTermsAndConcepts a owl:Class ;
    rdfs:subClassOf hpc:LsfOverview .
hpc:ClusterCharacteristics a owl:Class ;
    rdfs:subClassOf hpc:LsfTermsAndConcepts .
hpc:FileSystemsDirectoriesAndFiles a owl:Class ;
    rdfs:subClassOf hpc:ClusterCharacteristics .
hpc:ImportantDirectoriesAndConfigurationFiles a owl:Class ;
    rdfs:subClassOf hpc:FileSystemsDirectoriesAndFiles .
hpc:LsfConfiguration a owl:Class ;
    rdfs:subClassOf hpc:FileSystemsDirectoriesAndFiles .
hpc:JobStates a owl:Class ;
    rdfs:subClassOf hpc:LsfTermsAndConcepts .

hpc:hasoverview a owl:ObjectProperty .
hpc:hasconfigurationfile a owl:ObjectProperty .
hpc:hasdirectory a owl:ObjectProperty .
hpc:hasstate a owl:DatatypeProperty .

hpc:LSF rdf:type hpc:Cluster .
hpc:Cluster rdf:type owl:Class .
hpc:Cluster rdfs:subClassOf hpc:Lsf .
