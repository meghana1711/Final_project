hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job in the cluster." .

hpc:submissiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:priority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:graceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:Preemptivejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a preemptive job in the cluster." .

hpc:pendingreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:preexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "Represents a command to be executed." .
