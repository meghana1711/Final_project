hpc:Commandsyntax a owl:Class .
hpc:nestedquotationsnotsupported a owl:ObjectProperty ;
    rdfs:domain hpc:Commandsyntax ;
    rdfs:range hpc:Commandsyntax .
hpc:correctcommandsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Commandsyntax ;
    rdfs:range hpc:Commandsyntax .
hpc:containerioenabled a owl:ObjectProperty ;
    rdfs:domain hpc:Commandsyntax ;
    rdfs:range hpc:Commandsyntax .
hpc:notsupportedcommandsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Commandsyntax ;
    rdfs:range hpc:Commandsyntax .
hpc:correctnotsupportedcommandsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Commandsyntax ;
    rdfs:range hpc:Commandsyntax .
hpc:Reservedoptions a owl:Class .
hpc:donotuseoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Reservedoptions ;
    rdfs:range xsd:string .
hpc:automaticallysetoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Reservedoptions ;
    rdfs:range xsd:string .
hpc:overrideslsfsettings a owl:ObjectProperty ;
    rdfs:domain hpc:Reservedoptions ;
    rdfs:range xsd:string .
hpc:Containername a owl:Class .
hpc:namingconventions a owl:ObjectProperty ;
    rdfs:domain hpc:Containername ;
    rdfs:range xsd:string .
hpc:JobType a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Types of LSF jobs" ;
    owl:oneOf ( hpc:NormalJob ;
                hpc:BlaunchParallelJob ;
                hpc:ArrayJob ;
                hpc:ArrayBlaunchParallelJob ) .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Containername ;
    rdfs:range xsd:integer .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Containername ;
    rdfs:range xsd:string .
hpc:jobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Containername ;
    rdfs:range xsd:integer .
hpc:taskid a owl:DatatypeProperty ;
    rdfs:domain hpc:Containername ;
    rdfs:range xsd:integer .
hpc:Dockeroptions a owl:Class .
hpc:Container a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Docker container" .
hpc:image a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockeroptions ;
    rdfs:range xsd:string .
hpc:options a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockeroptions ;
    rdfs:range xsd:string .
hpc:rm a owl:DatatypeProperty ;
