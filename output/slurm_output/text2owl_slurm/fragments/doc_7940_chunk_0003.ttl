hpc:Federatedjobid a owl:Class .
hpc:localjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Federatedjobid ;
    rdfs:range xsd:unsignedInt .
hpc:clusteroriginid a owl:DatatypeProperty ;
    rdfs:domain hpc:Federatedjobid ;
    rdfs:range xsd:unsignedInt .

hpc:Jobsubmission a owl:Class .
hpc:submitcopiesofjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission .

hpc:Cluster a owl:Class .
hpc:iseligibleforjob a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:Jobscheduling a owl:Class .

hpc:Clusterfeature a owl:Class .
hpc:hasclusterfeature a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Clusterfeature .

hpc:Clusterconstraint a owl:Class .
hpc:meetsclusterconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:clusterlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission .
hpc:SiblingJobsSubmissionList a rdfs:Class ;
    rdfs:subClassOf hpc:Clusterlist .
