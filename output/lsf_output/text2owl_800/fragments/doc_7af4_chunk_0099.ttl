hpc:Processlimit a owl:Class .
hpc:hasprocesslimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit ;
    rdfs:range xsd:integer .

hpc:Priority a owl:Class .
hpc:haspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Priority ;
    rdfs:range xsd:integer .

hpc:rcAccount a owl:ObjectProperty .
hpc:HasrcAccount rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
