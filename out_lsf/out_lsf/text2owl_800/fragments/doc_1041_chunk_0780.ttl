hpc:Command a owl:Class .
hpc:timinglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:logfile a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:Lsfadministrator a owl:Class .
hpc:Root a owl:Class ;
    rdfs:subClassOf hpc:Lsfadministrator .
hpc:showconf a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List .
hpc:Host a owl:Class .
hpc:Localhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:limconf a owl:DatatypeProperty ;
    rdfs:domain hpc:Showconf ;
    rdfs:range rdf:List .
hpc:all a owl:ObjectProperty ;
    rdfs:domain hpc:Showconf .
hpc:Multicluster a owl:Class .
hpc:Managementcandidatehost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf hpc:Multicluster .
hpc:Serverhost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf hpc:Multicluster .
hpc:limparameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Showconf ;
    rdfs:range rdf:List .
