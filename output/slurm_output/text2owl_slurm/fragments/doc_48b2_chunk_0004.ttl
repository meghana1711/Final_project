hpc:Job a owl:Class .
hpc:Jobstep a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:hasresourcerequirements a owl:ObjectProperty .
hpc:hasJobStep rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstep .
hpc:hasPartition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:Job .
hpc:isDefaultPartition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .
hpc:getState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:hasState rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
