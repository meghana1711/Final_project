hpc:Job a owl:Class .
hpc:memorylimit a owl:ObjectProperty .
hpc:Slurm a owl:Class .
hpc:Slurmd a owl:Class .
hpc:resourcelimit a owl:DatatypeProperty .
hpc:Propagateresourcelimitsexcept rdfs:domain hpc:Slurm ;
                                    rdfs:range xsd:string .
hpc:Limitmemlock rdfs:domain hpc:Slurmd ;
                   rdfs:range xsd:string .
hpc:Ulimit rdfs:domain hpc:User ;
                   rdfs:range xsd:string .
hpc:Systemdservice rdfs:subClassOf hpc:Slurmd .
hpc:Sufficientlylargeresourcelimit rdfs:domain hpc:Resourcelimit ;
                                     rdfs:range xsd:boolean .
hpc:Memlockfailure rdfs:subClassOf hpc:Job ;
                      rdfs:comment "A job that fails due to low memlock limit." .
hpc:Nopropagationofresourcelimit rdfs:subClassOf hpc:Job ;
                                    rdfs:comment "A job whose resource limit is not propagated." .
