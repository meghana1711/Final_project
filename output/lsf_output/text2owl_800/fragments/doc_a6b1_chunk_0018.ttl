hpc:Command a owl:Class .
hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:debuglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .

hpc:Resdebug a owl:Class ;
    rdfs:subClassOf hpc:Command .
hpc:className a owl:ObjectProperty ;
    rdfs:domain hpc:Resdebug ;
    rdfs:range hpc:Classname .

hpc:Mbddebug a owl:Class ;
    rdfs:subClassOf hpc:Command .
hpc:className a owl:ObjectProperty ;
    rdfs:domain hpc:Mbddebug ;
    rdfs:range hpc:Classname .
hpc:debugLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbddebug .
hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbddebug .
hpc:logQueueSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbddebug ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Sbddebug a owl:Class ;
    rdfs:subClassOf hpc:Command .
hpc:className a owl:ObjectProperty ;
    rdfs:domain hpc:Sbddebug ;
    rdfs:range hpc:Classname .
hpc:debugLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbddebug .
