hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a queue in the system." .

hpc:runlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of jobs that can be in the queue at any given time." .

hpc:interruptiblebackfill a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the queue is configured for interruptible backfill." .

hpc:slaguaranteesignore a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether jobs in the queue can access all guaranteed resources, potentially ignoring some guarantees." .

hpc:Slaguaranteesignorevalue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    owl:unionOf (hpc:YValue hpc:NValue) ;
    rdfs:comment "Values that can be assigned to the SLA_GUARANTEES_IGNORE property." .

hpc:Yvalue a owl:Class ;
    rdfs:subClassOf hpc:Slaguaranteesignorevalue ;
    rdfs:comment "Indicates that jobs in the queue can access all guaranteed resources, potentially ignoring some guarantees." .

hpc:Nvalue a owl:Class ;
    rdfs:subClassOf hpc:Slaguaranteesignorevalue ;
    rdfs:comment "Indicates that the queue must honor resource guarantees when dispatching jobs." .

hpc:slotreserve a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Maxreservetime ;
    rdfs:comment "Enables processor reservation for the queue and specifies the reservation time." .

hpc:maxreservetime a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of MBD_SLEEP_TIME cycles over which a job can reserve job slots." .
