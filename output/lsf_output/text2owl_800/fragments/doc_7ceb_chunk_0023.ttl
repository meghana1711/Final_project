hpc:Job a owl:Class .
hpc:Historicalinformation a owl:Class .
hpc:bhistcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Historicalinformation .

hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Batchschedulingqueue .

hpc:lsruncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:bjobscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstatus .

hpc:bstopcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:bresumecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:bkillcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Batchjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Interactivetask a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:resourcerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hosttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Integratedapplication a owl:Class .
