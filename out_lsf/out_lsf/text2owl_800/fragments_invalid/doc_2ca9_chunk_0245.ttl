hpc:Host a owl:Class .
hpc:groupmember a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:GroupMember_Range rdf:List ;
    rdf:first rdfs:datatype xsd:nonPositiveInteger ;
    rdf:rest hpc:GroupMember .
hpc:preferredhostgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Groupmember ;
    rdfs:range rdf:List .
hpc:PreferredHostGroup_Preference rdf:List ;
    rdf:first rdfs:datatype xsd:nonNegativeInteger ;
    rdf:rest hpc:Host .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:HostName_Pattern rdf:List ;
    rdf:first xsd:string ;
    rdf:rest rdf:List ;
        rdf:first xsd:nonNegativeInteger ;
        rdf:rest xsd:string .
hpc:Hostgroup a owl:Class .
hpc:jobarrayeventscombine a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range xsd:boolean .
hpc:JobArrayEventsCombine_ModifiedEvents rdf:List ;
    rdf:first xsd:string ;
    rdf:rest rdf:List ;
        rdf:first xsd:string ;
        rdf:rest rdf:nil .
hpc:jobFinish a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbAcct ;
    rdfs:range xsd:string .
