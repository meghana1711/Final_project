hpc:Sdiag a owl:Class .
hpc:maintainsStatistics rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sdiag ;
    rdfs:range rdf:Resource .

hpc:TimeSeriesDatabase a owl:Class .

hpc:DiamondCollector a owl:Class .

hpc:Collectd a owl:Class ;
    rdfs:subClassOf hpc:DiamondCollector .

hpc:JSON a owl:Class .

hpc:SlurmPlugin a owl:Class .
hpc:slurmrestd a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .
hpc:burst_buffer/datawarp a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .
hpc:burst_buffer/lua a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .
hpc:jobcomp/elasticsearch a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .
hpc:jobcomp/kafka a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .

hpc:JSONC a owl:Class .

hpc:gitClone a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:mkdir a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:cd a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:cmake a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:make a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:sudo a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:makeInstall a owl:ObjectProperty ;
    rdfs:domain hpc:JSONC .

hpc:export a owl:ObjectProperty .

hpc:libhttp_parser a owl:Class .

hpc:slurmrestdRequires a owl:ObjectProperty ;
    rdfs:domain hpc:slurmrestd ;
    rdfs:range hpc:libhttp_parser .

hpc:hasVersion a owl:DatatypeProperty .
