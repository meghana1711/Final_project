hpc:Hostcluster a owl:Class .
hpc:Host a owl:Class .
hpc:Lsfinstallation a owl:Class .
hpc:logon a owl:ObjectProperty .
hpc:listcontents a owl:ObjectProperty .
hpc:changedirectory a owl:ObjectProperty .
hpc:editconfigfile a owl:ObjectProperty .
hpc:specifypath a owl:DatatypeProperty .
hpc:getdistributionfile a owl:ObjectProperty .
hpc:logonasroot a owl:ObjectProperty .
hpc:runlsfinstall a owl:ObjectProperty .
hpc:LSFTop a xsd:string .
hpc:LsfTop rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .
hpc:LSF_1_0_0 a xsd:string .
hpc:LsfTopDirectory rdfs:subClassOf hpc:Lsf100 ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .
hpc:LsfDistributionfile rdfs:subClassOf hpc:Lsf100 ;
    rdfs:domain hpc:Lsfinstallation .
hpc:lsfTardir a owl:DatatypeProperty .
hpc:lsfAddServers a owl:DatatypeProperty .
hpc:Hosttype rdfs:subClassOf hpc:Host .
hpc:Hosttypedirectory rdfs:domain hpc:Hosttype ;
    rdfs:range hpc:Host .
