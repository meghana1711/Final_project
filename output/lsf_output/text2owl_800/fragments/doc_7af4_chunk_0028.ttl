hpc:Event a owl:Class .
hpc:Event rdfs:subClassOf rdf:Resource .

hpc:eventtype a owl:DatatypeProperty .
hpc:Eventtype rdfs:domain hpc:Event .
hpc:Eventtype rdfs:range xsd:string .

hpc:versionnumber a owl:DatatypeProperty .
hpc:Versionnumber rdfs:domain hpc:Event .
hpc:Versionnumber rdfs:range xsd:nonNegativeInteger .

hpc:eventtime a owl:DatatypeProperty .
hpc:Eventtime rdfs:domain hpc:Event .
hpc:Eventtime rdfs:range xsd:nonNegativeInteger .

hpc:jobid a owl:DatatypeProperty .
hpc:Jobid rdfs:domain hpc:Event .
hpc:Jobid rdfs:range xsd:nonNegativeInteger .

hpc:userid a owl:DatatypeProperty .
hpc:Userid rdfs:domain hpc:Event .
hpc:Userid rdfs:range xsd:nonNegativeInteger .

hpc:options a owl:DatatypeProperty .
hpc:Options rdfs:domain hpc:Event .
hpc:Options rdfs:range xsd:nonNegativeInteger .

hpc:numprocessors a owl:DatatypeProperty .
hpc:Numprocessors rdfs:domain hpc:Event .
hpc:Numprocessors rdfs:range xsd:nonNegativeInteger .

hpc:jobFinish a owl:ObjectProperty .
hpc:JobFinish rdfs:domain hpc:Event .
hpc:JobFinish rdfs:range hpc:Event .
