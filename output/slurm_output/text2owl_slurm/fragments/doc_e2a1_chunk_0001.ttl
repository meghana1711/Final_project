hpc:Slurmcluster a owl:Class .
hpc:Slurmctld a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponent .
hpc:Slurmdbd a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponent .
hpc:Computenode a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponent .
hpc:Clientcommand a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponent .

hpc:Slurmcomponentcommunication a owl:Class .
hpc:Slurmctldcommunication a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponentcommunication .
hpc:Slurmdbdcommunication a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponentcommunication .
hpc:Slurmdcommunication a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponentcommunication .

hpc:slurmctldport a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range xsd:integer .

hpc:slurmdbdport a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:integer .

hpc:slurmdport a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:integer .

hpc:communicationparameters a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range hpc:Communicationparameter .

hpc:Communicationparameter a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:enableipv6 a owl:ObjectProperty ;
    rdfs:domain hpc:Communicationparameters .

hpc:disableipv4 a owl:ObjectProperty ;
    rdfs:domain hpc:Communicationparameters .

hpc:Ipv6communication a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponentcommunication .

hpc:Ipv4communication a owl:Class ;
    rdfs:subClassOf hpc:Slurmcomponentcommunication .
