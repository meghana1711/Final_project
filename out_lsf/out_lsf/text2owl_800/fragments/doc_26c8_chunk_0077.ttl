hpc:sshkeyid a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:Region a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:zone a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:integer .

hpc:Template a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf (hpc:Resource rdfs:subClassOf) .

hpc:templateid a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:ncores a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:icgen2host a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:boolean .

hpc:pricing a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
