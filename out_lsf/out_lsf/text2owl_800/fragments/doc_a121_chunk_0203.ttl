hpc:Jobscheduling a owl:Class ;
    rdfs:subClassOf hpc:Hpcprocess .

hpc:Jobsuspension a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling ;
    rdfs:subClassOf hpc:Hpcevent .

hpc:Jobresumption a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling ;
    rdfs:subClassOf hpc:Hpcevent .

hpc:Jobhostassignment a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling .

hpc:Jobxapplicationexecution a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling .

hpc:xsessionstart a owl:ObjectProperty ;
    rdfs:domain hpc:Jobhostassignment ;
    rdfs:range hpc:Xsession .

hpc:xtermstart a owl:ObjectProperty ;
    rdfs:domain hpc:Jobxapplicationexecution ;
    rdfs:range hpc:Xterm .

hpc:sshx11forwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Jobscheduling ;
    rdfs:range hpc:Sshcommand .

hpc:Sshcommand a owl:Class .

hpc:jobscriptcreation a owl:ObjectProperty ;
    rdfs:domain hpc:Hpcuser ;
    rdfs:range hpc:Jobscript .

hpc:Jobscript a owl:Class .

hpc:hostload a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:Host a owl:Class .

hpc:Hpcuser a owl:Class .

hpc:Hpcevent a owl:Class .

hpc:Xsession a owl:Class .

hpc:Xterm a owl:Class .
