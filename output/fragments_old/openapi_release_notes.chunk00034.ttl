hpc:ReservationDescription a owl:Class .

hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescription ;
    rdfs:range xsd:int .

hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescription ;
    rdfs:range xsd:int .

hpc:duration $ref hpc:uint32NoValStruct .

hpc:end_time a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescription ;
    rdfs:range xsd:int .

hpc:end_time $ref hpc:uint64NoValStruct .

hpc:features a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescription ;
    rdfs:range xsd:string .

hpc:flags a owl:ObjectProperty .

hpc:flags $ref hpc:ReservationFlag .

hpc:ReservationFlag a owl:Class .
hpc:ReservationFlag a rdfs:subClassOf [ a owl:Restriction ;
                                         rdfs:onProperty hpc:flags ;
                                         rdfs:allValuesFrom xsd:string ] .

hpc:ReservationFlag $ref hpc:MAINT .
hpc:ReservationFlag $ref hpc:NO_MAINT .
hpc:ReservationFlag $ref hpc:DAILY .
hpc:ReservationFlag $ref hpc:NO_DAILY .
hpc:ReservationFlag $ref hpc:WEEKLY .
hpc:ReservationFlag $ref hpc:NO_WEEKLY .
hpc:ReservationFlag $ref hpc:IGNORE_JOBS .
hpc:ReservationFlag $ref hpc:NO_IGNORE_JOBS .
hpc:ReservationFlag $ref hpc:ANY_NODES .
hpc:ReservationFlag $ref hpc:STATIC .
hpc:ReservationFlag $ref hpc:NO_STATIC .
hpc:ReservationFlag $ref hpc:PART_NODES .
hpc:ReservationFlag $ref hpc:NO_PART_NODES .
hpc:ReservationFlag $ref hpc:OVERLAP .
hpc:ReservationFlag $ref hpc:SPEC_NODES .
hpc:ReservationFlag $ref hpc:TIME_FLOAT .
hpc:ReservationFlag $ref hpc:REPLACE .
hpc:ReservationFlag $ref hpc:ALL_NODES .
hpc:ReservationFlag $ref hpc:PURGE_COMP .
hpc:ReservationFlag $ref hpc:W
