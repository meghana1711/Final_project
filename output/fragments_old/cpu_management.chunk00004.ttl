hpc:Node a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .
hpc:Proc a owl:Class .
hpc:Partition a owl:Class .

hpc:hasNodeAddr rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:hasSockets rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:coresPerSocket rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .

hpc:hasThreadsPerCore rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .

hpc:hasProcs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .

hpc:isState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:hasNodeName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node .
    rdfs:range xsd:string .

hpc:isPartitionName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
    rdfs:range xsd:string .

hpc:hasNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
    rdfs:range xsd:string .

hpc:isOverSubscribe rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
    rdfs:range xsd:boolean .

hpc:isDefault rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
    rdfs:range xdfs:boolean .

hpc:isStateUp rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
    rdfs:range xsd:boolean .

hpc:isSelectType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:isSelectTypeParameters rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:isCommandLine rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:hasNodesAlloc
