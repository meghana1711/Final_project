hpc:Usergroup a owl:Class .
hpc:Windowsusergroup rdfs:subClassOf hpc:Usergroup ;
    rdfs:comment "Includes the domain name in uppercase letters." .

hpc:domainname a owl:DatatypeProperty ;
    rdfs:domain hpc:Windowsusergroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The domain name of the Windows user group." .

hpc:Groupmember a owl:Class .

hpc:competeforresources a owl:ObjectProperty ;
    rdfs:domain hpc:Groupmember ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Competition for resources according to FCFS scheduling." .

hpc:hierarchicalfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Group ;
    rdfs:comment "Further division of shares among group members." .

hpc:individualassignment a owl:ObjectProperty ;
    rdfs:domain hpc:Groupmember ;
    rdfs:range hpc:Resourceassignment ;
    rdfs:comment "Share assignment to members of a group individually." .

hpc:recursive a owl:ObjectProperty ;
    rdfs:domain hpc:Individualassignment ;
    rdfs:range hdfs:Boolean ;
    rdfs:comment "Indicates if the share assignment is recursive." .

hpc:Resourceassignment a owl:Class .

hpc:numbershares a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceassignment ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of shares of the cluster resources assigned to the user." .

hpc:totalshares a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer ;
    rdfs:comment "The total number of shares." .

hpc:Group a owl:Class .

hpc:Default a owl:Class .
hpc:Others a owl:Class .

hpc:Hostpartition a owl:Class .
hpc:hpartName a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the partition." .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:string ;
    rdfs:comment "The list of hosts in the partition." .

hpc:userShares a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:List ;
    rdfs:comment "The list of user shares in the partition." .

hpc:Resource a owl:Class .
