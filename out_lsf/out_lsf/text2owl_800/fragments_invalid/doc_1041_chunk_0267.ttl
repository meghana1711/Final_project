hpc:Socket a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Socket ID of the GPU. NVLINK/XGMI" .

hpc:hasnvlinkxgmi a owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates if the GPU has NVLink or XGMI connections with other GPUs allocated for the job (ranked by GPU ID and including itself). The connection flag of each GPU is a character separated by a forward slash (/) between GPUs: A Y indicates there is a direct connection between two GPUs. An N shows there is no direct connection with that GPU. A hyphen (-) shows the GPU itself." .

hpc:connectionflag a owl:DatatypeProperty ;
    rdfs:domain hpc:Hasnvlinkxgmi ;
    rdfs:range xsd:string ;
    rdfs:comment "The connection flag of each GPU" .

hpc:errorwarningmessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:string ;
    rdfs:comment "If the job exited abnormally due to a GPU-related error or warning, the error or warning message displays." .

hpc:hasgpuconnectionerror a owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range rdf:Resource ;
    rdfs:comment "If LSF could not get GPU usage information from DCGM, a hyphen (-) displays." .

hpc:displaytime a owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:string ;
    rdfs:comment "Displays times in the customized output in hh:mm:ss format." .

hpc:Customizedoutputformat a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Categories format" .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string ;
    rdfs:comment "Synopsis" .

hpc:conflictingoptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string ;
    rdfs:comment "Use only with the -o and -o -json options." .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string ;
    rdfs:comment "When speciﬁed, bjobs displays any times (but not time stamps) in the customized output in hh:mm:ss format. The cpu_used field normally uses one decimal place in the bjobs output, but if you specify -hms, bjobs rounds up this field to the next second." .

hpc:roundedcpuused a owl:DatatypeProperty ;
    rdfs:domain hpc:Description ;
    rdfs:range xsd:string ;
    rdfs:comment "For example, if the cpu_used field is 0
