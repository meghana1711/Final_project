hpc:ownershipBy a owl:ObjectProperty .

hpc:LSF_Top rdf:type owl:Class .
hpc:LSF_Top_Top_Directory rdf:type owl:Class .
hpc:Version_Directory rdf:type owl:Class .
hpc:Resource_Connector_Directory rdf:type owl:Class .
hpc:Provider_Directory rdf:type owl:Class .
hpc:Configuration_File rdf:type owl:Class .
