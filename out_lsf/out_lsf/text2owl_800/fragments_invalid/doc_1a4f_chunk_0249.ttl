hpc:Resourcereservation a owl:Class .
hpc:Perjobreservation hpc:resourcereservation ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Reservation for resources per job." .
hpc:Pertaskreservation hpc:resourcereservation ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Reservation for resources per task." .
hpc:Perhostreservation hpc:resourcereservation ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Reservation for resources per host." .
hpc:UserDefinedResource rdf:Type owl:Class ;
    rdfs:comment "User-defined numeric resources." .
hpc:BuiltInResource rdf:Type owl:Class ;
    rdfs:comment "Built-in resources such as mem, cpu, or swp." .
hpc:ReservationUsage rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemanager ;
    rdfs:range hpc:Resourcereservation ;
    rdfs:comment "Configures resource reservation." .
hpc:ResourceReservePerTask rdf:Type xsd:decimal ;
    rdfs:range hpc:Resourcereservation ;
    rdfs:comment "Cluster-wide resource reserve parameter." .
hpc:ResourceNotReservedInLsb rdf:Type owl:Class ;
    rdfs:subClassOf hpc:Resourcereservation ;
    rdfs:comment "Resources not reserved in lsb.resources." .
hpc:ReservationOverridesResourceReservePerTask rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:Resourcereservepertask ;
    rdfs:comment "Configuration overrides RESOURCE_RESERVE_PER_TASK if it also exists for the same resource." .
hpc:Perhostreservation rdfs:subClassOf hpc:Resourcereservation ;
    rdfs:comment "For the parallel job, LSF reserves one instance of a resource for each host." .
hpc:PerSlotObsolete rdf:Type owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Obsolete as of LSF 9.1.3 and replaced by PER_TASK." .
hpc:ResourceLimitBehavior rdf:Type owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Does not change any existing resource limit behavior." .
hpc:SchedulingCluster rdf:Type owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Configure resource usage in the scheduling cluster." .
hpc:MemoryReservationForPendingJobs rdf:Type owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "By default, the rusage string reserves resources for running jobs, not pending jobs." .
