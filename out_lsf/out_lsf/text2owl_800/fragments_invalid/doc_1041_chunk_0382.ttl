hpc:alphabetical a owl:DatatypeProperty ;
 rdfs:domain hpc:Sortby .
 rdfs:range xsd:string .

hpc:bytotallicenses a owl:DatatypeProperty ;
 rdfs:domain hpc:Sortby .
 rdfs:range xsd:string .

hpc:byavailablelicenses a owl:DatatypeProperty ;
