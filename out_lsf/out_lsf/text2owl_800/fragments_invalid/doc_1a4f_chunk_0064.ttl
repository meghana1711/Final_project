hpc:Lsfhost a owl:Class .
hpc:hasIPAddressRange an owl:ObjectProperty .
hpc:Ipaddressrange rdfs:domain hpc:Lsfhost ;
                    rdfs:range xsd:string .
hpc:LSF_HOST_ADDR_RANGE rdf:value hpc:hasIPAddressRange ;
                        rdfs:label "LSF_HOST_ADDR_RANGE" .
hpc:IPAddress a xsd:string .
hpc:IPAddressRangeValue an owl:DatatypeProperty ;
                         rdfs:domain hpc:Ipaddressrange ;
                         rdfs:range xsd:string .
hpc:IPv4Address a xsd:string .
hpc:IPv6Address a xsd:string .
hpc:Ipv4ipv6address rdfs:subClassOf hpc:Ipaddress .
hpc:Ipv4address rdfs:subClassOf hpc:Ipv4ipv6address ;
                 rdfs:label "IPv4Address" .
hpc:Ipv6address rdfs:subClassOf hpc:Ipv4ipv6address ;
                 rdfs:label "IPv6Address" .
hpc:joinCluster an owl:ObjectProperty .
hpc:rebootAutomatically an owl:ObjectProperty .
hpc:hostSetup an owl:ObjectProperty .
hpc:startLSF an owl:ObjectProperty .
hpc:nonSharedFileSystemEnvironment an owl:Class .
hpc:installLSFBinaries an owl:ObjectProperty ;
                        rdfs:domain hpc:Nonsharedfilesystemenvironment .
hpc:localizedLSFConfFile an owl:ObjectProperty ;
                          rdfs:domain hpc:Nonsharedfilesystemenvironment .
hpc:shellEnvironmentScripts an owl:ObjectProperty ;
                             rdfs:domain hpc:Nonsharedfilesystemenvironment .
hpc:serverHost an owl:Class ;
                 rdfs:subClassOf hpc:Nonsharedfilesystemenvironment .
hpc:serverConfigFile an owl:ObjectProperty ;
                      rdfs:domain hpc:Serverhost .
