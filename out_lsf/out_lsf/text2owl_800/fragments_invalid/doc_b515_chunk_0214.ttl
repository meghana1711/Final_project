hpc:Checkpointdirectory a owl:Class.
hpc:Jobid a owl:Class.
hpc:Checkpointfile a owl:Class.
hpc:checkpointperiod a owl:DatatypeProperty;
    rdfs:domain hpc:Checkpointdirectory;
    rdfs:range xsd:nonNegativeInteger.
hpc:checkpointmethod a owl:ObjectProperty;
    rdfs:domain hpc:Job.
hpc:lsbechkpntmethod a owl:ObjectProperty;
    rdfs:domain hpc:Queue.
hpc:checkpointdirectorypath a owl:DatatypeProperty;
    rdfs:domain hpc:Checkpointdirectory;
    rdfs:range xsd:string.
hpc:jobhascheckpointdirectory a owl:ObjectProperty;
    rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Checkpointdirectory.
