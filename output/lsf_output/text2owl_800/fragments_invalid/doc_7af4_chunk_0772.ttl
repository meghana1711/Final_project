@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Solaris a owl:Class .
hpc:Hpux a owl:Class .
hpc:Linux a owl:Class .

hpc:Utmpfileregistrationnotsupported a owl:Class .
hpc:Utmpfileregistrationnotsupported rdfs:subClassOf hpc:Operatingsystem .

hpc:Interactivebatchjob a owl:Class .
hpc:Interactivebatchjob rdfs:subClassOf hpc:Job .

hpc:lsfAcPncUrl a owl:DatatypeProperty .
hpc:LsfAcPncUrl rdfs:domain hpc:Lsf .
hpc:LsfAcPncUrl rdfs:range xsd:string .

hpc:lsfAcceptNumclients a owl:DatatypeProperty .
hpc:LsfAcceptNumclients rdfs:domain hpc:Lsf .
hpc:LsfAcceptNumclients rdfs:range xsd:integer .

hpc:lsfAddonHosts a owl:ObjectProperty .
hpc:LsfAddonHosts rdfs:domain hpc:Lsf .
hpc:LsfAddonHosts rdfs:range xsd:string .
