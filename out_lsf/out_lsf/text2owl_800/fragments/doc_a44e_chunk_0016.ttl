hpc:Job a owl:Class .
hpc:graceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Outputfile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:Stageoutrequirement a owl:Class .

hpc:hasGracePeriod rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Graceperiod .

hpc:hasOutputFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputfile .

hpc:hasStageOutRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Stageoutrequirement .

hpc:cachepermissions a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:Userownership a owl:Class ;
    rdfs:subClassOf hpc:Cachepermissions .

hpc:Groupownership a owl:Class ;
    rdfs:subClassOf hpc:Cachepermissions .

hpc:Allownership a owl:Class ;
    rdfs:subClassOf hpc:Cachepermissions .

hpc:Userspecificsubdirectory a owl:Class .

hpc:UserSpecificSubdirectoryOwnership rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Userownership ;
    rdfs:range hpc:Userspecificsubdirectory .

hpc:UnixGroup rdf:type owl:Class .

hpc:FileTransferSuccess rdf:type owl:ObjectProperty .

hpc:FileCleanup rdf:type owl:ObjectProperty .

hpc:BstageOutTagCommand rdf:type owl:Class .

hpc:BdataTagsCleanCommand rdf:type owl:Class .

hpc:Parameter rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Bdatatagscleancommand .
