hpc:BatchStep a owl:Class .
hpc:hasBatchHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BatchStep ;
    rdfs:range xsd:string .

hpc:InteractiveStep a owl:Class .
hpc:hasInteractiveShell rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:InteractiveStep ;
    rdfs:range xsd:string .

hpc:NormalStep a owl:Class .
hpc:hasJobId rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:NormalStep ;
    rdfs:range xsd:string .
hpc:hasStepId rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:NormalStep ;
    rdfs:range xsd:string .

hpc:SlurmStep a owl:Class .
hpc:runsCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BatchStep, hpc:InteractiveStep, hpc:NormalStep ;
    rdfs:range xsd:string .

hpc:Job a owl:Class .
hpc:hasNormalStep rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:NormalStep .
```
