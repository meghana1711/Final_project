hpc:connectionurl a owl:ObjectProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The URL of the LDAP server." .

hpc:bindtype a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of bind used for authentication." .

hpc:binddn a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The DN used for binding to the LDAP server." .

hpc:bindcredentials a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The password for the binding DN." .

hpc:editmode a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The mode for editing LDAP settings." .

hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The LDAP attribute for the username." .

hpc:rdn a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The LDAP attribute for the RDN." .

hpc:uuid a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The LDAP attribute for the UUID." .

hpc:userobjectclasses a owl:DatatypeProperty ;
    rdfs:domain hpc:Ldap ;
    rdfs:range xsd:string ;
    rdfs:comment "The object classes for the LDAP user." .
