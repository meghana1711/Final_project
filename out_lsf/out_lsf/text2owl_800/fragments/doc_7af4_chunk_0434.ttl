hpc:Mpsdaemon a owl:Class .
hpc:mpsmode a owl:ObjectProperty .
hpc:Resourcerequirement a owl:Class .
hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Socket a owl:Class .
hpc:Gpu a owl:Class .
hpc:sharedmps a owl:ObjectProperty .
hpc:exclusive a owl:ObjectProperty .
hpc:jexclusive a owl:DatatypeProperty .
hpc:affinity a owl:ObjectProperty .
hpc:strictaffinity a owl:DatatypeProperty .
hpc:block a owl:ObjectProperty .

hpc:Mpsdaemon rdfs:subClassOf owl:Class .
hpc:Mpsmode rdfs:domain hpc:Mpsdaemon ;
                                rdfs:range xsd:string .
hpc:Resourcerequirement rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Socket rdfs:subClassOf owl:Class .
hpc:Gpu rdfs:subClassOf owl:Class .
hpc:Sharedmps rdfs:domain hpc:Mpsdaemon ;
                             rdfs:range hpc:Mpsdaemon .
hpc:Exclusive rdfs:domain hpc:Job ;
                          rdfs:range xsd:boolean .
hpc:Jexclusive rdfs:domain hpc:Job ;
                          rdfs:range xsd:boolean .
hpc:Affinity rdfs:domain hpc:Job ;
                          rdfs:range hpc:Gpu .
hpc:Strictaffinity rdfs:domain hpc:Job ;
                          rdfs:range xsd:boolean .
hpc:Block rdfs:domain hpc:Mpsdaemon ;
                          rdfs:range xsd:nonNegativeInteger .

hpc:per_socket a xsd:string .
hpc:per_gpu a xsd:string .
hpc:shared a xsd:string .
hpc:EXCLUSIVE_THREAD a xsd:string .
hpc:j_exclusive a xsd:boolean .
hpc:aff a xsd:boolean .
hpc:block a xsd:nonNegativeInteger .
