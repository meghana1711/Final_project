hpc:Cluster a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:absfolderpath a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Job a owl:Class .
hpc:Cache a owl:Class .
hpc:cachepermission a owl:DatatypeProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:string .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Cache .
hpc:Group a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Cachefile a owl:Class ;
    rdfs:subClassOf hpc:Cache .
hpc:Cachegroup a owl:Class ;
    rdfs:subClassOf hpc:Cache .
hpc:cacheforuser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Cache .
hpc:cacheforgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Cachegroup .
hpc:cacheforgroupspecified a owl:ObjectProperty ;
    rdfs:domain hpc:Cachegroup ;
    rdfs:range xsd:string .
