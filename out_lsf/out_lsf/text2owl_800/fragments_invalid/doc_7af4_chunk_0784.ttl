hpc:Rurprologuescript a owl:Class .
hpc:hasRURPrologueScriptPath rdf:Property ;
    rdfs:domain hpc:Rurprologuescript ;
    rdfs:range xsd:string .

hpc:lsfCrayRurPrologPath a owl:ObjectProperty .

hpc:DefaultRURPrologueScript a hpc:RURPrologueScript ;
    hpc:hasRURPrologueScriptPath "opt/cray/rur/default/bin/rur_epilogue.py" .

hpc:RURPrologueScriptPath rdf:Property ;
    rdfs:domain hpc:LsfCrayRurPrologPath ;
    rdfs:range xsd:string .

hpc:limnicevalue a owl:DatatypeProperty .
hpc:hasLIMNiceValue rdf:Property ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer .

hpc:lsfDaemonNiceLim a owl:ObjectProperty .

hpc:DefaultLIMNiceValue a xsd:integer ;
    xsd:value "-20" .

hpc:LSF_DAEMON_NICE_LIM_Domain rdf:Property ;
    rdfs:domain hpc:LsfDaemonNiceLim ;
    rdfs:range hpc:LsfDaemon .

hpc:LSF_DAEMON_NICE_LIM_Range rdf:Property ;
    rdfs:domain hpc:Limnicevalue ;
    rdfs:range xsd:integer .

hpc:mbatchdnicevalue a owl:DatatypeProperty .
hpc:hasMBatchdNiceValue rdf:Property ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer .

hpc:lsfDaemonNiceMbd a owl:ObjectProperty .

hpc:DefaultMBatchdNiceValue a xsd:integer ;
    xsd:value "-20" .

hpc:LSF_DAEMON_NICE_MBD_Domain rdf:Property ;
    rdfs:domain hpc:LsfDaemonNiceMbd ;
    rdfs:range hpc:LsfDaemon .

hpc:LSF_DAEMON_NICE_MBD_Range rdf:Property ;
    rdfs:domain hpc:Mbatchdnicevalue ;
    rdfs:range xsd:integer .

hpc:LsfDaemon a owl:Class .
