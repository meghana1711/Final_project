hpc:Job a owl:Class .

hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:backwardCompatibleWith(hpc:flags) .

hpc:het a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:int .

hpc:hold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:int .

hpc:memory_per_cpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:int .

hpc:memory_per_node a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:int .

hpc:reservation a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:requested a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:segment_size a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:int .

hpc:state a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:current a owl:DatatypeProperty ;
    rdfs:domain hpc:State ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:backwardCompatibleWith(hpc:current) .

hpc:eligible a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:xsd:dateTime .
```
