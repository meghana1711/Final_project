hpc:Cpuefficiency a owl:Class .
hpc:cpupeak a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuefficiency ;
    rdfs:range xsd:decimal .
hpc:cpurequested a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuefficiency .

hpc:Cpuaverageefficiency a owl:Class .
hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuaverageefficiency ;
    rdfs:range xsd:decimal .
hpc:jobruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuaverageefficiency ;
    rdfs:range xsd:decimal .
hpc:cpurequested a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuaverageefficiency .

hpc:cpupeakduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuefficiency ;
    rdfs:range xsd:decimal .

hpc:Memefficiency a owl:Class .
hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memefficiency ;
    rdfs:range xsd:decimal .
hpc:requestedmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memefficiency ;
    rdfs:range xsd:decimal .
hpc:maxexecutionhostsnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Memefficiency ;
    rdfs:range xsd:decimal .

hpc:Inputfile a owl:Class .

hpc:Outputfile a owl:Class .

hpc:Errfile a owl:Class .

hpc:Exceptionstatus a owl:Class .
hpc:idle a owl:ObjectProperty ;
    rdfs:domain hpc:Exceptionstatus .
hpc:overrun a owl:ObjectProperty ;
    rdfs:domain hpc:Exceptionstatus .
hpc:jobidlethreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Idle ;
    rdfs:range xsd:decimal .
hpc:joboverrunthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Overrun ;
    rdfs:range xsd:decimal .
