hpc:Solarissystem a owl:Class .
hpc:Unixplatform a owl:Class .
hpc:nsswitchconffile a owl:DatatypeProperty .
hpc:resolvconffile a owl:DatatypeProperty .
hpc:gethostbynamefunction a owl:ObjectProperty .
hpc:ypbinddaemon a owl:ObjectProperty .
hpc:nameddaemon a owl:ObjectProperty .
hpc:resolverfunctions a owl:ObjectProperty .
hpc:hostsfile a owl:DatatypeProperty .
hpc:svcconffile a owl:DatatypeProperty .
hpc:Nsswitchconffile a rdfs:subClassOf xsd:string .
hpc:Resolvconffile a rdfs:subClassOf xsd:string .
hpc:Gethostbynamefunction rdfs:domain hpc:Unixplatform ;
                                rdfs:range rdf:Resource .
hpc:Ypbinddaemon rdfs:domain hpc:Unixplatform ;
                   rdfs:range rdf:Resource .
hpc:Nameddaemon rdfs:domain hpc:Unixplatform ;
                   rdfs:range rdf:Resource .
hpc:Resolverfunctions rdfs:domain hpc:Unixplatform ;
                        rdfs:range rdf:Resource .
hpc:Hostsfile rdfs:domain hpc:Unixplatform ;
               rdfs:range xsd:string .
hpc:Solarissystem rdfs:subClassOf hpc:Unixplatform .
hpc:Multihomedhost a owl:Class .
hpc:Dualstackhost a owl:Class .
hpc:internetaddress a owl:DatatypeProperty .
hpc:officialhostname a owl:DatatypeProperty .
hpc:alias a owl:DatatypeProperty .
hpc:Lsfhost a owl:Class .
hpc:privatelsfhostsfile a owl:DatatypeProperty .
hpc:lsfconfdir a owl:DatatypeProperty .
hpc:format a owl:DatatypeProperty .
hpc:Multihomedhost rdfs:subClassOf hpc:Host .
hpc:Dualstackhost rdfs:subClassOf hpc:Multihomedhost .
hpc:Internetaddress rdfs:domain hpc:Host ;
                      rdfs:range xsd:string .
hpc:Officialhostname rdfs:domain hpc:Host ;
                      rdfs:range xsd:string .
hpc:Alias rdfs:domain hpc:Host ;
                   rdfs:range xsd:string .
hpc:Lsfhost rdfs:subClassOf hpc:Host .
hpc:Privatelsfhostsfile rdfs:domain hpc:Lsfcluster ;
                          rdfs:range xsd:string .
hpc:Lsfconfdir rdfs:domain hpc:Lsfcluster ;
                 rdfs:range xsd:string .
hpc:Format rdfs:domain hpc:LsfConfdir/hosts ;
             rdfs:range xsd:string .
