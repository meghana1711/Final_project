hpc:Partitionqoslimit a owl:Class.
hpc:Jobqoslimit a owl:Class.
hpc:Userassociation a owl:Class.
hpc:Accountassociation a owl:Class.
hpc:Rootclusterassociation a owl:Class.
hpc:Partitionlimit a owl:Class.

hpc:hashierarchy a owl:ObjectProperty;
    rdfs:domain hpc:Hierarchicallimit;
    rdfs:range hpc:Hierarchicallimit.

hpc:Hierarchicallimit a owl:Class;
    rdfs:subClassOf owl:ObjectProperty;
    rdfs:subClass [ a owl:Class;
        rdf:type owl:Restriction;
        owl:onProperty hpc:hasHierarchy;
        owl:allValuesFrom hpc:HierarchicalLimit ].

hpc:enforcementorder a owl:ObjectProperty;
    rdfs:domain hpc:Hierarchicallimit;
    rdfs:range xsd:string.

hpc:precedenceorder a owl:ObjectProperty;
