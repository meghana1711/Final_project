hpc:RunWindows a owl:Class .
hpc:LoadThresholds a owl:Class .
hpc:HardwareTopology a owl:Class .
hpc:numa a owl:ObjectProperty .
hpc:socket a owl:ObjectProperty .
hpc:AvailableCpuFrequency a owl:Class .
hpc:cpuFrequency a owl:DatatypeProperty .
hpc:CurrentCpuFrequency a owl:Class .
hpc:cpuFrequencyGhz a owl:DatatypeProperty .
hpc:numCpus a owl:DatatypeProperty .
hpc:ResourceBasedOutput a owl:Class .
hpc:resourcebasedoutputS a owl:ObjectProperty .
hpc:sl a owl:ObjectProperty .
hpc:StaticResources a owl:Class .
hpc:resource a owl:ObjectProperty .
hpc:numericvalue a owl:DatatypeProperty .
hpc:hostname a owl:ObjectProperty .
hpc:names a owl:DatatypeProperty .
hpc:ResourceNames a owl:Class .

hpc:RunWindows rdfs:subClassOf owl:Class .
hpc:LoadThresholds rdfs:subClassOf owl:Class .
hpc:HardwareTopology rdfs:subClassOf owl:Class .
hpc:AvailableCpuFrequency rdfs:subClassOf owl:Class .
hpc:CurrentCpuFrequency rdfs:subClassOf owl:Class .
hpc:ResourceBasedOutput rdfs:subClassOf owl:Class .
hpc:StaticResources rdfs:subClassOf owl:Class .
hpc:ResourceNames rdfs:subClassOf owl:Class .

hpc:Numa rdfs:domain hpc:HardwareTopology ;
    rdfs:range rdf:Resource .
hpc:Socket rdfs:domain hpc:HardwareTopology ;
    rdfs:range rdf:Resource .
hpc:CpuFrequency rdfs:domain hpc:AvailableCpuFrequency ;
    rdfs:range xsd:decimal .
hpc:CurrentCpuFrequencyGhz rdfs:domain hpc:CurrentCpuFrequency ;
    rdfs:range xsd:decimal .
hpc:NumCpus rdfs:domain hpc:CurrentCpuFrequency ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ResourcebasedoutputS rdfs:domain hpc:ResourceBasedOutput ;
    rdfs:range rdf:Resource .
hpc:Sl rdfs:domain hpc:ResourceBasedOutput ;
    rdfs:range rdf:Resource .
hpc:Resource rdfs:domain hpc:StaticResources ;
    rdfs:range rdf:Resource .
