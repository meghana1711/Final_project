hpc:Usedslots a owl:Class .
hpc:Usedmemory a owl:Class .
hpc:Slotmemory a owl:Class .
hpc:fairshareadjustmentpluginmemorythreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcluster ;
    rdfs:range xsd:decimal .

hpc:jobslotinuse a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:totalmemoryinuse a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:averagememoryperslot a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcluster ;
    rdfs:range xsd:decimal .

hpc:runtimedecay a owl:ObjectProperty .
hpc:historicalruntimedecay a owl:ObjectProperty .
hpc:committedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:historicalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
