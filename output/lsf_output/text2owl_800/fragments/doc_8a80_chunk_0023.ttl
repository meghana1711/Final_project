hpc:Projectgrouppath a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Enables hierarchical project group paths for project mode." .

hpc:hasprojectgrouppath a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specifies whether hierarchical project group paths are enabled." .

hpc:Remotelmstatprotocol a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Defines the protocol for remote license management." .

hpc:hasremotelmstatprotocol a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the protocol for remote license management." .
