hpc:Compoundapplicationlevelresourcerequirement a owl:Class .
hpc:Joblevelresourcerequirement a owl:Class .
hpc:Queuelevelresourcerequirement a owl:Class .

hpc:overwrites rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementlevel ;
    rdfs:range hpc:Resourcerequirementlevel .

hpc:Resourcerequirementlevel a owl:Class .

hpc:Compoundapplicationlevelresourcerequirement rdfs:subClassOf hpc:Resourcerequirementlevel .
hpc:Joblevelresourcerequirement rdfs:subClassOf hpc:Resourcerequirementlevel .
hpc:Queuelevelresourcerequirement rdfs:subClassOf hpc:Resourcerequirementlevel .

hpc:merges rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range hpc:Compoundapplicationlevelresourcerequirement .

hpc:interacts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range hpc:Queuelevelresourcerequirement .

hpc:combines rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range hpc:Queuelevelresourcerequirement .

hpc:conflicts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range hpc:Queuelevelresourcerequirement .

hpc:merge rdf:type owl:ObjectProperty ;
    rdfs:domain xsd:Resource ;
    rdfs:range xsd:Resource .

hpc:num1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:num2 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundapplicationlevelresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:rusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:Resource .

hpc:Internalloadindices a owl:Class .
hpc:Duration a owl:Class .

hpc:rejectedByBjobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelresourcerequirement ;
    rdfs:range hpc:Internalloadindex .

hpc:loadThresholds rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queuelevelresourcerequirement ;
    rdfs:range hpc:Loadthreshold .

hpc:strictResourceRequirementSyntax rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Selectsection ;
    rdfs:range xsd:boolean .

hpc:nonConsumableResource rdf:type owl:ObjectProperty ;
    rdfs:domain xsd:Resource ;
    rdfs:range xsd:boolean .

hpc:RESRSV_LIMIT rdf:type owl:DatatypeProperty
