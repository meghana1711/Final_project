hpc:UsageFactorSafe a owl:Boolean .
hpc:AccountingStorageEnforce a rdf:List .
hpc:AccountingStorageEnforce rdfs:member hpc:Safe .

hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf owl:Thing .

hpc:TRESMins a xsd:nonNegativeFloat .
hpc:TRESRunMins a xsd:nonNegativeFloat .
hpc:TRESBillingUnit a xsd:nonNegativeInteger .
hpc:RawUsage a xsd:nonNegativeFloat .
hpc:MinTRESPerJob a xsd:nonNegativeFloat .
hpc:MinPrioThreshold a xsd:nonNegativeInteger .

hpc:hasUsageFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .

hpc:hasMinTRESPerJob a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeFloat .

hpc:hasMinPrioThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasTRESMins a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeFloat .

hpc:hasTRESRunMins a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeFloat .

hpc:hasTRESBillingUnit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasRawUsage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeFloat .

hpc:hasUsageFactorSafe a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:UsageFactorSafe .

hpc:hasAccountingStorageEnforce a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:AccountingStorageEnforce .
