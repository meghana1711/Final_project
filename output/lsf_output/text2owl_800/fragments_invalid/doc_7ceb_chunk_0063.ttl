hpc:Lsferror a owl:Class .
hpc:GetPortError a owl:SubClassOf hpc:LSFError .
hpc:GetPortError rdfs:comment "The LSF service is not registered." .

hpc:BindSocketError a owl:SubClassOf hpc:LSFError .
hpc:BindSocketError rdfs:comment "init_AcceptSock: Can’t bind daemon socket to port <port>: error, exiting" .
hpc:BindSocketError rdfs:comment "init_ServSock: Could not bind socket to port <port>: error" .

hpc:ConfigurationError a owl:SubClassOf hpc:LSFError .
hpc:ConfigurationError rdfs:comment "Configuration errors" .

hpc:GeneralConfigurationError a owl:SubClassOf hpc:ConfigurationError .
hpc:GeneralConfigurationError rdfs:comment "General errors are listed first," .

hpc:SpecificConfigurationError a owl:SubClassOf hpc:ConfigurationError .
hpc:SpecificConfigurationError rdfs:comment "errors from specific files." .

hpc:IgnoredSectionError a owl:SubClassOf hpc:SpecificConfigurationError .
hpc:IgnoredSectionError rdfs:comment "file(line): Section name expected after Begin; ignoring" .

hpc:InvalidSectionNameError a owl:SubClassOf hpc:SpecificConfigurationError .
hpc:InvalidSectionNameError rdfs:comment "file(line): Invalid section name name; ignoring" .

hpc:PrematureEOFError a owl:SubClassOf hpc:SpecificConfigurationError .
hpc:PrematureEOFError rdfs:comment "file(line): Section section: Premature EOF" .

hpc:KeywordLineError a owl:SubClassOf hpc:SpecificConfigurationError .
hpc:KeywordLineError rdfs:comment "file(line): keyword line format error for section section; Ignore this section" .

hpc:KeyValuesMismatchError a owl:SubClassOf hpc:SpecificConfigurationError .
hpc:KeyValuesMismatchError rdfs:comment "file(line): values do not match keys for section section; Ignoring line" .

hpc:MissingOrInvalidHostModelError a owl:SubClassOf hpc:ConfigurationError .
hpc:MissingOrInvalidHostModelError rdfs:comment "file: HostModel section missing or invalid" .

hpc:MissingOrInvalidResourceError a owl:SubClassOf hpc:ConfigurationError .
hpc:MissingOrInvalidResourceError rdfs:comment "file: Resource section missing or invalid" .

hpc:MissingOrInvalidHostTypeError a owl:SubClassOf hpc:ConfigurationError .
hpc:MissingOrInvalidHostTypeError rdfs:comment "file: HostType section missing or invalid" .

hpc:Seconddaemonerror a owl:Class .
hpc:SecondDaemonError rdfs:comment "These error messages can occur if you try to start a second LSF daemon (for example, RES is already running, and you run RES again). If so," .
hpc:SecondDaemonError rdfs:comment "and you want to start the new daemon, kill the running daemon or use the lsadmin or badmin commands to shut down or restart the daemon." .

hpc:
