hpc:Reservation a owl:Class ;
    rdfs:subClassOf hpc:Resourceallocation ;
    rdfs:comment "Represents a reservation of resources in a HPC system." .

hpc:hasstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:hasduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasflags a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:timeFloatFlag a owl:NamedIndividual ;
    rdf:type hpc:ReservationFlag ;
    rdfs:label "time_float" .

hpc:replaceDownFlag a owl:NamedIndividual ;
    rdf:type hpc:ReservationFlag ;
    rdfs:label "REPLACE_DOWN" .

hpc:replaceFlag a owl:NamedIndividual ;
    rdf:type hpc:ReservationFlag ;
    rdfs:label "REPLACE" .

hpc:Reservationstate a owl:Class ;
    rdfs:subClassOf hpc:Resourcestate ;
    rdfs:comment "State of a reservation in a HPC system." .

hpc:drainingState a owl:NamedIndividual ;
    rdf:type hpc:ReservationState ;
    rdfs:label "DRAINING" .

hpc:reservationreplacesallocatedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:reservationreplacesjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:reservationreplacesdownnodes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:reservationreplacesjobnodes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:reservationreplacesnodes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:reservationreplacesnodesforspanningcores a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Boolean .

hpc:Reservationflag a owl:Class ;
    rdfs:subClassOf hpc:Resourceflag ;
    rdfs:comment "Represents a flag for a reservation in a HPC system." .
