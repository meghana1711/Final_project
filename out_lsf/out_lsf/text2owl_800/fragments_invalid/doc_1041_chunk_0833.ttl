hpc:Lsmake a owl:Class .
hpc:NumTasks hpc:Lsmake rdfs:domain xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:DebugLevel hpc:Lsmake rdfs:domain xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:NumRetries hpc:Lsmake rdfs:domain xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:MakeOption rdfs:subClassOf hpc:Lsmake .
hpc:NoBlockShellMode hpc:MakeOption rdfs:subClassOf owl:NamedIndividual .
hpc:Target rdfs:subClassOf hpc:Lsmake .
hpc:ASeconds hpc:Lsmake rdfs:domain hpc:Command ;
    rdfs:range xsd:duration .
hpc:Command rdfs:subClassOf owl:NamedIndividual .
