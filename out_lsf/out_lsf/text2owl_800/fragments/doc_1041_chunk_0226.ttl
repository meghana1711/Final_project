hpc:ClosedEgo a owl:Class .
hpc:hasAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedEgo ;
    rdfs:range xsd:boolean .

hpc:ClosedExcl a owl:Class .
hpc:submittedWithCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedExcl ;
    rdfs:range xsd:string .

hpc:ClosedFull a owl:Class .
hpc:maxJobSlots rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ClosedFull ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ClosedLim a owl:Class .
hpc:unreachableLIM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedLim ;
    rdfs:range xsd:boolean .

hpc:ClosedLock a owl:Class .
hpc:lockedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedLock ;
    rdfs:range xsd:string .

hpc:ClosedWind a owl:Class .
hpc:definedInLSBFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedWind ;
    rdfs:range xsd:string .

hpc:ClosedRc a owl:Class .
hpc:resourceProviderReclaimRequest rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClosedRc ;
    rdfs:range xsd:boolean .
