hpc:Preexecutionscript a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "A script that runs before a container job with LSF administrator privileges." .

hpc:hasscriptfile a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionscript ;
    rdfs:range xsd:string ;
    rdfs:comment "The full file path to the pre-execution script." .

hpc:scriptoutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutionscript ;
    rdfs:range xsd:string ;
    rdfs:comment "The output of the pre-execution script, used as container startup options." .

hpc:Scriptexecutionstatus a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:comment "The status of the pre-execution script execution." .
    rdfs:subClassOf owl:Object ;
    owl:hasValue hpc:ScriptFailed ;
    owl:hasValue hpc:ScriptSuccess ;
    owl:hasValue hpc:ScriptOutputTooLong ;

hpc:ScriptFailed a owl:NamedIndividual ;
    rdfs:label "Script Failed" .

hpc:ScriptSuccess a owl:NamedIndividual ;
    rdfs:label "Script Success" .

hpc:ScriptOutputTooLong a owl:NamedIndividual ;
    rdfs:label "Script Output Too Long" .

hpc:scriptexecutionmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionscript ;
    rdfs:range hpc:Scriptexecutionmethod ;
    rdfs:comment "The method of processing the container job based on the result of the pre-execution script." .

hpc:Scriptexecutionmethod a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "The method of processing the container job based on the result of the pre-execution script." .
    rdfs:subClassOf owl:Enum ;
    owl:hasValue hpc:ExitWithScriptCode ;
    owl:hasValue hpc:IgnoreExtraOptions ;
    owl:hasValue hpc:UseFirst512Options ;
    owl:hasValue hpc:UseAllOptions .

hpc:ExitWithScriptCode a owl:NamedIndividual ;
    rdfs:label "Exit with script code" .

hpc:IgnoreExtraOptions a owl:NamedIndividual ;
    rdfs:label "Ignore extra options" .

hpc:UseFirst512Options a owl:NamedIndividual ;
    rdfs:label "Use first 512 options" .

hpc:UseAllOptions a owl:NamedIndividual ;
    rdfs:label "Use all options" .

hpc:Dockerjobrunoptions a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "The Docker job run options for the docker run command." .
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:scriptOutput ;
    owl:hasValueData hpc:DockerJobRunOption
