hpc:Cluster a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:Resource a owl:Class .
hpc:communication a owl:ObjectProperty .
hpc:Commondefinitions rdfs:domain hpc:Cluster ;
                          rdfs:range hpc:Cluster .
hpc:Hasmanagementhost rdfs:domain hpc:Cluster ;
                         rdfs:range hpc:Managementhost .
hpc:Hashosttype rdfs:domain hpc:Cluster ;
                  rdfs:range hpc:Hosttype .
hpc:Hashostmodel rdfs:domain hpc:Cluster ;
                 rdfs:range hpc:Hostmodel .
hpc:Hasresource rdfs:domain hpc:Cluster ;
                rdfs:range hpc:Resource .
hpc:Communicationwith rdfs:domain hpc:Cluster ;
                      rdfs:range hpc:Cluster .
hpc:Communicationmethod rdfs:domain hpc:Cluster ;
                       rdfs:range xsd:string .
hpc:Defaultusernamespace rdfs:domain hpc:Cluster ;
                         rdfs:range xsd:boolean .
hpc:Privilegedportauthentication rdfs:domain hpc:Cluster ;
                                 rdfs:range xsd:boolean .
hpc:Externalclienttoserverauthentication rdfs:domain hpc:Cluster ;
                                          rdfs:range xsd:string .
