@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Smtmode a owl:Class.
hpc:hassmtmode a owl:DatatypeProperty;
    rdfs:domain hpc:Smtmode;
    rdfs:range xsd:integer.

hpc:Smtmodevalue a owl:Class;
    rdfs:subClassOf hpc:Smtmode;
    rdfs:subClassOf xsd:nonNegativeInteger.

hpc:Rescheduleuponcsmsetuperror a owl:Class.
hpc:hasrescheduleuponcsmsetuperror a owl:ObjectProperty;
    rdfs:domain hpc:Rescheduleupon
