hpc:ArHostList a owl:Class .
hpc:arStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:ArReservation ;
    rdfs:range xsd:integer .
hpc:arEndTime a owl:DatatypeProperty ;
    rdfs:domain hpc:ArReservation ;
    rdfs:range xsd:integer .
hpc:arJobids a owl:ObjectProperty ;
    rdfs:domain hpc:ArReservation ;
    rdfs:range hpc:ArJob .
hpc:arCreator a owl:DatatypeProperty ;
    rdfs:domain hpc:ArReservation ;
    rdfs:range xsd:string .
hpc:arOwners a owl:ObjectProperty ;
    rdfs:domain hpc:ArReservation ;
    rdfs:range xsd:string .
hpc:ArScript a owl:Class ;
    rdfs:subClassOf hpc:ArReservation .
hpc:arScriptPretime a owl:DatatypeProperty ;
    rdfs:domain hpc:ArScript ;
    rdfs:range xsd:integer .
hpc:arScriptNotifies a owl:ObjectProperty ;
    rdfs:domain hpc:ArScript ;
    rdfs:range xsd:string .
hpc:arScriptLogs a owl:ObjectProperty ;
    rdfs:domain hpc:ArScript ;
    rdfs:range xsd:string .
hpc:ArReservation a owl:Class .
