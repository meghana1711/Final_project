hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Queue a owl:Class .
hpc:Project a owl:Class .
hpc:Limit a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Hostgroup a owl:Class .

# Object Properties
hpc:hasuser a owl:ObjectProperty .
hpc:hasqueue a owl:ObjectProperty .
hpc:onhost a owl:ObjectProperty .
hpc:haslimit a owl:ObjectProperty .
hpc:usesqueue a owl:ObjectProperty .
hpc:usesusergroup a owl:ObjectProperty .
hpc:onhostgroup a owl:ObjectProperty .

# Datatype Properties
hpc:slots a owl:DatatypeProperty .
hpc:memory a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:tmp a owl:DatatypeProperty .
hpc:jobs a owl:DatatypeProperty .

# Class and Property Domain and Range
hpc:User rdfs:subClassOf rdf:Resource .
hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Queue rdfs:subClassOf rdf:Resource .
hpc:Project rdfs:subClassOf rdf:Resource .
hpc:Limit rdfs:subClassOf rdf:Resource .
hpc:Usergroup rdfs:subClassOf rdf:Resource .
hpc:Hostgroup rdfs:subClassOf rdf:Resource .

hpc:Hasuser rdfs:domain hpc:User ;
                        rdfs:range hpc:Host .
hpc:Hasqueue rdfs:domain hpc:Host ;
                        rdfs:range hpc:Queue .
hpc:Onhost rdfs:domain hpc:Job ;
                        rdfs:range hpc:Host .
hpc:Haslimit rdfs:domain hpc:Job ;
                        rdfs:range hpc:Limit .
hpc:Usesqueue rdfs:domain hpc:Limit ;
                        rdfs:range hpc:Queue .
hpc:Usesusergroup rdfs:domain hpc:Limit ;
                        rdfs:range hpc:Usergroup .
hpc:Onhostgroup rdfs:domain hpc:Limit ;
                        rdfs:range hpc:Hostgroup .

hpc:Slots rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
hpc:Memory rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
hpc:Swp rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
hpc:Tmp rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
hpc:Jobs rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
