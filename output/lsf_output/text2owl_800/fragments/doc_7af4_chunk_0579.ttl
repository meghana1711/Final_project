hpc:Lsbthreshold a owl:Class .
hpc:hasfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbthreshold ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasruntimevar a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbthreshold ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Minenergy a owl:Class ;
    rdfs:subClassOf hpc:Lsbthreshold .
hpc:Mintime a owl:Class ;
    rdfs:subClassOf hpc:Lsbthreshold .
hpc:Lsbusers a owl:Class .
hpc:hasusergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbusers .
hpc:hasjobslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbusers ;
    rdfs:range xsd:nonNegativeInteger .
