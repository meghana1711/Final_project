hpc:Egodaemonscpus a owl:Class .
hpc:Lsfdaemonscpus a owl:Class .
hpc:Mbdquerycpus a owl:Class .
hpc:Egodefinencpus a owl:Class .

hpc:runson a owl:ObjectProperty ;
    rdfs:domain hpc:Egodaemonscpus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:boundto a owl:ObjectProperty ;
    rdfs:domain hpc:Egodaemonscpus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Operatingsystem a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:range xsd:string ;
    rdfs:subClassOf (hpc:Linux26orhigher rdfs:union hpc:Solaris10orhigher) .

hpc:Linux26orhigher a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:comment "Linux 2.6 or higher" ] .

hpc:Solaris10orhigher a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:comment "Solaris 10 or higher" ] .

hpc:egodefinencpus hasValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Egodefinencpus ;
    rdfs:range xsd:string .

hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Egodefinencpus ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Procs a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:comment "number of processors" ] .

hpc:Cores a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:comment "number of processors x number of cores" ] .

hpc:Threads a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:comment "number of processors x number of cores x number of threads" ] .
