hpc:RcAccount a owl:Class .
hpc:RcReclaimAction a owl:Class .

hpc:hasrcaccount a owl:ObjectProperty .
hpc:hasrcreclaimaction a owl:ObjectProperty .

hpc:Hasrcaccount rdfs:domain hpc:RcAccount ;
    rdfs:range xsd:string .

hpc:Hasrcreclaimaction rdfs:domain hpc:RcReclaimAction ;
    rdfs:range xsd:string ;
    rdfs:range rdf:List ;
        rdf:first xsd:string ;
        rdf:rest rdf:List ;
            rdf:first xsd:string ;
            rdf:rest rdf:nil .
