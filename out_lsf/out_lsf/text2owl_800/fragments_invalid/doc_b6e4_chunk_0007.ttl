hpc:Usgovernmentuser a owl:Class.
hpc:restrictedrights a owl:DatatypeProperty.
hpc:Cluster a owl:Class.
hpc:clustername a owl:DatatypeProperty;
                   rdfs:domain hpc:Cluster;
                   rdfs:range xsd:string.
hpc:mastername a owl:DatatypeProperty;
                   rdfs:domain hpc:Cluster;
                   rdfs:range xsd:string.
hpc:command a owl:ObjectProperty.
hpc:Job a owl:Class.
hpc:jobid a owl:DatatypeProperty;
               rdfs:domain hpc:Job;
               rdfs:range xsd:string.
hpc:user a owl:DatatypeProperty;
               rdfs:domain hpc:Job;
               rdfs:range xsd:string.
hpc:stat a owl:DatatypeProperty;
               rdfs:domain hpc:Job;
               rdfs:range xsd:string.
hpc:queue a owl:DatatypeProperty;
               rdfs:domain hpc:Job;
