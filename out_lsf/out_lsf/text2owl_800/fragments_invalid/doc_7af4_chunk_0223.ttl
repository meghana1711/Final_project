@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:Hosttype a owl:Class .

hpc:hasname a owl:ObjectProperty .
hpc:maxjobstotal a owl:DatatypeProperty .
hpc:maxjobsperuser a owl:DatatypeProperty .
hpc:loadcondition a owl:ObjectProperty .
hpc:timewindow a owl:ObjectProperty .

hpc:Host rdfs:subClassOf hpc:Hostmodel .
hpc:Hostmodel rdfs:subClassOf hpc:Hosttype .

hpc:Hasname rdfs:domain hpc:Host .
hpc:Maxjobstotal rdfs:domain hpc:Host .
hpc:Maxjobsperuser rdfs:domain hpc:Host .
hpc:Loadcondition rdfs:domain hpc:Host .
hpc:Timewindow rdfs:domain hpc:Host .

hpc:Hasname rdfs:range xsd:string .
hpc:Maxjobstotal rdfs:range xsd:nonNegativeInteger .
hpc:Maxjobsperuser rdfs:range xsd:nonNegativeInteger .

hpc:HOST_NAME rdf:typedef hpc:hasName .
