hpc:Logfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "LogFile" ;
    rdfs:comment "Represents a log file with a specific format." .

hpc:daemonname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "daemonName" ;
    rdfs:comment "The name of the daemon associated with the log file." .

hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "hostName" ;
    rdfs:comment "The host name where the log file is created or related to." .

hpc:path a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "path" ;
    rdfs:comment "The path where the log file is created or located." .

hpc:Temporary a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Temporary" ;
    rdfs:comment "Indicates whether the log file is created temporarily." .

hpc:Default a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Default" ;
    rdfs:comment "Indicates the default log file used by the system." .

hpc:Unixlinux a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "UnixLinux" ;
    rdfs:comment "Indicates the operating system where the log file is created." .

hpc:Windows a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Windows" ;
    rdfs:comment "Indicates the operating system where the log file is created." .

hpc:Validpath a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "ValidPath" ;
    rdfs:comment "Indicates whether the specified path is valid." .

hpc:Nologfilecreated a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "NoLogFileCreated" ;
    rdfs:comment "Indicates that no log file is created when the specified path is not valid on Windows." .

hpc:timinglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "timingLevel" ;
    rdfs:comment "The timing level for the sbatchd daemon." .

