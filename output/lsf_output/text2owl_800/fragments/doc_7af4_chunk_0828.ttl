hpc:Validvalue a owl:Class .
hpc:Validvalue rdfs:subClassOf xsd:string .
hpc:Validvalue rdfs:subClassOf rdf:PlainLiteral .
hpc:ValidValue rdfs:maxLength 40 .
hpc:ValidValue rdfs:comment "Strings with alphanumeric characters, underscores (_), or hyphens (-)." .

hpc:Candidatehostlist a owl:Class .
hpc:Candidatehostlist rdfs:subClassOf rdf:List .
hpc:CandidateHostList rdfs:comment "Space-separated list of hosts that are candidate License Scheduler hosts." .

hpc:lsfLicSchedHosts a owl:ObjectProperty .
hpc:LsfLicSchedHosts rdfs:domain hpc:Host .
hpc:LsfLicSchedHosts rdfs:range hpc:Candidatehostlist .
hpc:LSF_LIC_SCHED_HOSTS rdfs:comment "The candidate License Scheduler host list is read by LIM on each host to check if the host is a candidate License Scheduler management host." .

hpc:lsfLicSchedPreemptRequeue a owl:ObjectProperty .
hpc:LsfLicSchedPreemptRequeue rdfs:domain hpc:Parameter .
hpc:LsfLicSchedPreemptRequeue rdfs:range xsd:boolean .
hpc:LSF_LIC_SCHED_PREEMPT_REQUEUE rdfs:comment "Set this parameter to re-queue a job whose license is preempted by IBM® Spectrum LSF License Scheduler." .

hpc:lsfLicSchedPreemptSlotRelease a owl:ObjectProperty .
hpc:LsfLicSchedPreemptSlotRelease rdfs:domain hpc:Parameter .
hpc:LsfLicSchedPreemptSlotRelease rdfs:range xsd:boolean .
hpc:LSF_LIC_SCHED_PREEMPT_SLOT_RELEASE rdfs:comment "Set this parameter to release the resources of a LSF License Scheduler job that is suspended." .
