hpc:Hostregsetup a owl:Class ;
    rdfs:comment "Sets the management host name in the hostregsetup script." .

hpc:Lsreghost a owl:Class ;
    rdfs:comment "Resolves the DNS entry." .

hpc:Burstingbehavior a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Configures the overall decision on how to configure bursting behavior." .

hpc:demanddecision a owl:ObjectProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:string ;
    rdfs:comment "Determines if demand is generated or not at the scheduler." .

hpc:queuethreshold a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:integer ;
    rdfs:comment "Controls the decision to trigger demand at the queue level." .

hpc:rcDemandPolicy a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:string ;
    rdfs:comment "Configures the threshold on when to launch instances in AWS." .

hpc:stepvalue a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:integer ;
    rdfs:comment "Throttles the rate of launching instances in AWS." .

hpc:maxnumber a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the maximum instances to request for AWS." .

hpc:lsbRcExternalHostIdleTime a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:integer ;
    rdfs:comment "Considers when to reclaim the AWS EC2 instances." .

hpc:lsbRcExternalHostMaxTtl a owl:DatatypeProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:integer ;
    rdfs:comment "Additional fine tuning of the policies." .

hpc:customizedpolicyscript a owl:ObjectProperty ;
    rdfs:domain BurstingBehavior ;
    rdfs:range xsd:string ;
    rdfs:comment "A customized policy script which is used after the default plug-in runs to determine the final demand to be used." .
