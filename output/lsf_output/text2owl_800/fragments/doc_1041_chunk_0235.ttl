hpc:Mig a owl:Class .

hpc:hasmig a owl:ObjectProperty ;
    rdfs:domain hpc:Mig ;
    rdfs:range xsd:boolean .

hpc:Latestgpuusage a owl:Class .

hpc:Gpujobinformation a owl:Class .

hpc:jexcl a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujobinformation .

hpc:runjobids a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujobinformation ;
    rdfs:range xsd:string .

hpc:suspendedjobids a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujobinformation ;
    rdfs:range xsd:string .

hpc:pendingjobids a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujobinformation ;
    rdfs:range xsd:string .

hpc:Resourceconnector a owl:Class .

hpc:-rconly a owl:ObjectProperty .

hpc:pubdnsname a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:pubipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:privdnsname a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:privipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:rcstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:provstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:tag a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:string .

hpc:updatedat a owl:DatatypeProperty ;
    rdfs:domain hpc:-rconly ;
    rdfs:range xsd:dateTime .

hpc:instanceid a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .

hpc:Instance a owl:Class .
hpc:Instance rdfs:subClassOf hpc:Resourceconnector .
