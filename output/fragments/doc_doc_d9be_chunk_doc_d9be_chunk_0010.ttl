hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:CPUAllocation a owl:Class .
hpc:Task a owl:Class .

hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:hasAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:CPUAllocation .

hpc:hasCPUCount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CPUAllocation ;
    rdfs:range xsd:integer .

hpc:hasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:CPUAllocation ;
    rdfs:range hpc:Task .

hpc:hasTaskId rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:integer .

hpc:OvercommittedJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:OverallocatedJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:SharedResourceJob a owl:Class ;
    rdfs:subClassOf hpc:Job .
```
