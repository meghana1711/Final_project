hpc:poeWTimeout a owl:DatatypeProperty .
hpc:lsfPoeTimeoutSelect a owl:ObjectProperty .
hpc:lsfProcessTracking a owl:ObjectProperty .
hpc:lsfProxydBypass a owl:ObjectProperty .

hpc:PoeWTimeout rdfs:domain hpc:Wrapper .
hpc:LsfPoeTimeoutSelect rdfs:domain hpc:Wrapper ;
                                rdfs:range xsd:integer .
hpc:LsfProcessTracking rdfs:domain hpc:Lsfconfiguration ;
                            rdfs:range xsd:string .
hpc:LsfProxydBypass rdfs:domain hpc:Lsfconfiguration .

hpc:Wrapper a owl:Class .
hpc:Lsfconfiguration a owl:Class .

hpc:LSF_PROCESS_TRACKING
    rdfs:subPropertyOf rdf:Property ;
    rdfs:comment "Enable this parameter to track processes based on job control functions such as termination, suspension, resume and other signaling, on Linux systems which support cgroups' freezer subsystem." .

hpc:LSF_PROXYD_BYPASS
    rdfs:subPropertyOf rdf:Property ;
    rdfs:comment "The LSF_PROXYD_BYPASS parameter determines how the mbatchd daemon responds to requests without tokens for LSF rate limiter (lsfproxyd) requests." .

hpc:LSF_POE_TIMEOUT_SELECT
    rdfs:subPropertyOf rdf:Property ;
    rdfs:comment "Specifies the time in seconds for the poe_w wrapper to wait for connections from the pmd_w wrapper." .

hpc:LSF_POE_TIMEOUT_SELECT
    rdf:value "160"^^xsd:integer ;
    rdfs:comment "Default 160 seconds" .

hpc:LSF_PROCESS_TRACKING
    rdf:value "Y"^^xsd:string .

hpc:LSF_PROXYD_BYPASS
    rdf:value "STRICT"^^xsd:string .
