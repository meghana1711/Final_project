hpc:joberroroutputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file path where the standard error output of the job is appended." .

hpc:lsbStdoutDirect a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "If set to Y or y, the standard error output of a job is written to the specified file during job execution. If not set, it is written to a temporary file and copied to the specified file after the job finishes." .

hpc:LsfNotsupportedonwindows a owl:Class ;
    rdfs:subClassOf hpc:Operatingsystemrestriction ;
    rdfs:comment "Represents the restriction that LSB_STDOUT_DIRECT is not supported on Windows." .

hpc:maxfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of characters a file path can contain." .

hpc:jobidreplacement a owl:ObjectProperty ;
    rdfs:domain hpc:Errorfile ;
    rdfs:range hpc:Jobid ;
    rdfs:comment "Replaces %J in the name of the error file with the job ID." .

hpc:jobindexreplacement a owl:ObjectProperty ;
    rdfs:domain hpc:Errorfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "Replaces %I in the name of the error file with the job index in the array if the job is a member of an array. Otherwise, replaces %I with 0 (zero)." .

hpc:errorfilelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File ;
    rdfs:comment "The location where the standard error output file is written if the current working directory is not accessible on the execution host after the job starts." .

hpc:inaccessibleerrorfilehandling a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Errorhandling ;
    rdfs:comment "Defines the action to take when the specified error file is not accessible." .

hpc:sameoutputanderrorfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Indicates whether the error file of the job is NULL and the standard error of the job is stored in the output file if the specified error file is the same as the output file." .
