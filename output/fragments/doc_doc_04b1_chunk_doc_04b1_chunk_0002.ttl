hpc:SyncookieConfig a owl:Class .
hpc:syncookies rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SyncookieConfig ;
    rdfs:range xsd:integer .

hpc:SynackRetries rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:TCPConnectionConfig ;
    rdfs:range xsd:integer ;
    rdfs:maxCardinality 1 .

hpc:Somaxconn rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SocketConfig ;
    rdfs:range xsd:integer .

hpc:LocalPortRange rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CommunicationConfig ;
    rdfs:range xsd:string .

hpc:Txqueuelen rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:NetworkInterfaceConfig ;
    rdfs:range xsd:integer .

hpc:MungeThreadCount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:MungeConfig ;
    rdfs:range xsd:integer .

hpc:SyncookieFunctionality a owl:Enum ;
    rdfs:member ( "0" "1" ) .

hpc:TCPConnectionState a owl:Class ;
    rdfs:subClassOf hpc:TCPConnectionConfig .

hpc:SocketConfig a owl:Class ;
    rdfs:subClassOf hpc:NetworkInterfaceConfig .

hpc:CommunicationConfig a owl:Class .

hpc:NetworkInterfaceConfig a owl:Class .

hpc:MungeConfig a owl:Class .

hpc:TCPConnectionConfig a owl:Class ;
    rdfs:subClassOf hpc:NetworkInterfaceConfig ;
    rdfs:subClassOf hpc:CommunicationConfig .
```
