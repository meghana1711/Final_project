hpc:Lsfcluster a owl:Class .
hpc:Azureresourcegroup a owl:Class .
hpc:Networksecuritygroup a owl:Class .
hpc:Lsfnetworksecuritygroup a rdfs:subClassOf hpc:Networksecuritygroup .
hpc:lsfport a owl:DatatypeProperty .
hpc:haslsfport a owl:ObjectProperty .
hpc:Hasazureresourcegroup rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Azureresourcegroup .
hpc:Hasnetworksecuritygroup rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Networksecuritygroup .
hpc:Hascustomizedrule rdfs:domain hpc:Networksecuritygroup ;
    rdfs:range rdf:List .
hpc:Hascustomizedrule/rdf:first rdfs:range xsd:string .
hpc:Hascustomizedrule/rdf:rest rdfs:range hpc:Customizedrule .
hpc:Customizedrule a owl:Class .
hpc:Haslsfport rdfs:domain hpc:Customizedrule ;
    rdfs:range xsd:integer .
hpc:Hasipaddress rdfs:domain hpc:Customizedrule ;
    rdfs:range xsd:string .
hpc:LSF_LIM_PORT a xsd:integer .
hpc:LSF_RES_PORT a xsd:integer .
hpc:LSB_SBD_PORT a xsd:integer .
