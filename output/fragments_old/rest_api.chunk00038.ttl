hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:Cluster a owl:Class .
hpc:Partition a owl:Class .
hpc:Coordinator a owl:Class .
hpc:Organization a owl:Class .

hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:User .

hpc:hasAccount a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .

hpc:hasCoordinator a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Coordinator .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Partition .

hpc:hasId a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

hpc:hasOrganization a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Organization .

hpc:hasName a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:domain hpc:Coordinator ;
    rdfs:domain hpc:Organization ;
    rdfs:range xsd:string .

hpc:isDirect a owl:DatatypeProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:boolean .

hpc:hasDescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:domain hpc:Organization ;
    rdfs:range xsd:string .

hpc:hasFlags a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:domain hpc:Organization ;
    rdfs:range xsd:string .
```
