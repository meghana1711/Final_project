@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Script a owl:Class .
hpc:Hadoopjob a owl:Class .
hpc:hadoopinstallationdirectory a owl:ObjectProperty .
hpc:javaruntimeenvironment a owl:ObjectProperty .
hpc:hadoopconfigurationdirectory a owl:ObjectProperty .
hpc:userhdfs a owl:ObjectProperty .
hpc:debug a owl:ObjectProperty .
hpc:jarfile a owl:DatatypeProperty .
hpc:scriptname a owl:DatatypeProperty .
hpc:bsuboptions a owl:DatatypeProperty .

hpc:Script rdfs:subClassOf owl:Class .
hpc:Hadoopjob rdfs:subClassOf hpc:Script .

hpc:Hadoopinstallationdirectory rdfs:domain hpc:Hadoopjob ;
    rdfs:range xsd:string .
hpc:Javaruntimeenvironment rdfs:domain hpc:Hadoopjob ;
    rdfs:range xsd:string .
hpc:Hadoopconfigurationdirectory rdfs:domain hpc:Hadoopjob ;
    rdfs:range xsd:string .
hpc:Userhdfs rdfs:domain hpc:Hadoopjob ;
    rdfs:range xsd:string .
hpc:Debug rdfs:domain hpc:Hadoopjob ;
    rdfs:range xsd:boolean .
hpc:Jarfile rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:Scriptname rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:Bsuboptions rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
