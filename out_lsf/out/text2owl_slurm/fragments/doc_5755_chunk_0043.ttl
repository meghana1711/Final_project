hpc:Slurmdaemon a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:Slurmd a owl:Class .

hpc:drainnode a owl:ObjectProperty .
hpc:Drainnode rdfs:domain hpc:Slurmdaemon ;
    rdfs:range rdf:Resource .

hpc:updateslurmconf a owl:ObjectProperty .
hpc:Updateslurmconf rdfs:domain hpc:Slurmdaemon ;
    rdfs:range rdf:Resource .

hpc:scontrolreconfigure a owl:ObjectProperty .
hpc:Scontrolreconfigure rdfs:domain hpc:Slurmdaemon .

hpc:removenodes a owl:ObjectProperty .
hpc:Removenodes rdfs:domain hpc:Slurmdaemon ;
    rdfs:range rdf:List .

hpc:nodestate a owl:DatatypeProperty .
hpc:Nodestate rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:string .

hpc:returntoservice a owl:DatatypeProperty .
hpc:Returntoservice rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:integer .

hpc:Cgroupv2 a owl:Class .
hpc:converttocgroupv2 a owl:ObjectProperty .
hpc:Converttocgroupv2 rdfs:domain rdf:Resource ;
    rdfs:range hpc:Cgroupv2 .

hpc:runonec2 a owl:ObjectProperty .
hpc:Runonec2 rdfs:domain hpc:Job .
hpc:Runonec2 rdfs:range rdf:Resource .

hpc:noderebootreason a owl:DatatypeProperty .
hpc:Noderebootreason rdfs:domain hpc:Nodeevent ;
    rdfs:range xsd:string .

hpc:Nodeevent a owl:Class .
hpc:Nodeevent rdfs:subClassOf hpc:Event .
