hpc:Preemptivequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:Preemptablequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:Preempts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .

hpc:PreemptedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .

hpc:HasPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:IsPreemptive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue .

hpc:IsPreemptable rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue .

hpc:LeastLoadedHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preemptablequeue .

hpc:Resizeablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:HasResizeRequest rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:IsInSSUSPState rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
