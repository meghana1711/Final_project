hpc:LsbConfiguration a owl:Class .
hpc:estimatorenabled a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbConfiguration ;
    rdfs:range xsd:boolean .

hpc:estimationstartdelay a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbConfiguration ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Estimator a owl:Class .
hpc:estimatormaxjobsprediction a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:nonNegativeInteger .

hpc:estimatorpredictiontimethreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:nonNegativeInteger .

hpc:estimatorruntimethreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:nonNegativeInteger .

hpc:estimatorsimstartinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:nonNegativeInteger .

hpc:estimatorcpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:string .

hpc:estimatoridletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Managementhostcpu a owl:Class .
