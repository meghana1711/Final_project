hpc:Sampleperiod a owl:Class .
hpc:start a owl:ObjectProperty ;
    rdfs:domain hpc:Sampleperiod ;
    rdfs:range rdf:Resource .
hpc:stop a owl:ObjectProperty ;
    rdfs:domain hpc:Sampleperiod ;
    rdfs:range rdf:Resource .
hpc:view a owl:ObjectProperty ;
    rdfs:domain hpc:Sampleperiod ;
    rdfs:range rdf:Resource .
hpc:setperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Sampleperiod ;
    rdfs:range xsd:integer .
hpc:qact a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource .
hpc:Qactivation a owl:Class ;
    rdfs:subClassOf hpc:Qact .
hpc:Queue a owl:Class .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Qactivation ;
    rdfs:range xsd:string .
hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Qactivation ;
    rdfs:range xsd:string .
hpc:all a owl:NamedIndividual .
