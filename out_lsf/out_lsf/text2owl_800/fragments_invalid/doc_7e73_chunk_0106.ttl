@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Template a owl:Class .
hpc:mincpuplatform a owl:DatatypeProperty .
hpc:zone a owl:DatatypeProperty .
hpc:userdata a owl:ObjectProperty .

rdfs:domain hpc:Template hpc:Mincpuplatform .
rdfs:domain hpc:Template hpc:Zone .
rdfs:domain hpc:Template hpc:Userdata .

rdfs:range hpc:Mincpuplatform xsd:string .
rdfs:range hpc:Zone xsd:string .

hpc:TemplateMinCPU-VM-1 a hpc:Template ;
    hpc:minCpuPlatform "Intel Sandy Bridge" ;
    hpc:userData "zone=us-east1-d" .

hpc:gcloud-VM-1 a hpc:Template ;
    hpc:googlehost ["Boolean", "1"] ;
    hpc:minCpuPlatform ["String", "Intel_Sandy_Bridge"] .

hpc:gcloud-VM-2 a hpc:Template ;
    hpc:googlehost ["Boolean", "1"] ;
    hpc:minCpuPlatform ["String", "Intel_Cascade_Lake"] .
