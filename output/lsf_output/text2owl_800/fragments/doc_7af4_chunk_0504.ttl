hpc:Queueleveltasklimit a owl:Class ;
    rdfs:subClassOf hpc:Tasklimit .

hpc:Applicationleveltasklimit a owl:Class ;
    rdfs:subClassOf hpc:Tasklimit ;
    rdfs:subClassOf hpc:Queueleveltasklimit .

hpc:Jobleveltasklimit a owl:Class ;
    rdfs:subClassOf hpc:Tasklimit ;
    rdfs:subClassOf hpc:Queueleveltasklimit .

hpc:Tasklimit a owl:Class .

hpc:hashigherpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Tasklimit ;
    rdfs:range hpc:Tasklimit .

# Relationship constraints
hpc:Queueleveltasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:hasHigherPriority ;
      owl:allValuesFrom hpc:ApplicationLevelTaskLimit ] .

hpc:Applicationleveltasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:hasHigherPriority ;
      owl:allValuesFrom hpc:JobLevelTaskLimit ] .

hpc:Jobleveltasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:hasHigherPriority ;
      owl:allValuesFrom hpc:TaskLimit ] .

# Limit properties
hpc:minimumlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimit .

hpc:defaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimit .

hpc:maximumlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimit .

# Limit constraints
hpc:Tasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:minimumLimit ;
      owl:minValue xsd:integer ;
      owl:minInclusive "1" ] .

hpc:Tasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:defaultLimit ;
      owl:minValue xsd:integer ;
      owl:minInclusive "1" ] .

hpc:Tasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:maximumLimit ;
      owl:maxValue xsd:integer ;
      owl:maxInclusive "Unlimited" ] .

# Block size constraint for TaskLimit
hpc:Tasklimit rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty hpc:defaultLimit ;
      owl:allValuesFrom
        [ a xsd:integer ;
          owl:greaterThanOrEqual (
            [ a xsd:integer ;
              rdf:value (
                hpc:RES_REQ
                [ a hpc:CompoundResourceRequirement ;
                  rdfs:label "CompoundResourceRequirement" ] ) ] ) ] ] .

# TER
