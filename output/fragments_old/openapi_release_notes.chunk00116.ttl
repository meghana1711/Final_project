hpc:JobSignalResponse a owl:Class .
hpc:JobSignalResponse has rdf:type owl:Object .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSignalResponse ;
    rdfs:range xsd:string .

hpc:statusItems a owl:Class ;
    rdf:type owl:ObjectProperty ;
    rdfs:subClassOf hpc:status .

hpc:error a owl:Class ;
    rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:statusItems ;
    rdfs:range hpc:Error .

hpc:code a owl:DatatypeProperty ;
    rdfs:domain hpc:error ;
    rdfs:range xsd:int .

hpc:message a owl:DatatypeProperty ;
    rdfs:domain hpc:error ;
    rdfs:range xsd:string .

hpc:string a owl:DatatypeProperty ;
    rdfs:domain hpc:message ;
    rdfs:range xsd:string .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:error ;
    rdfs:range xsd:string .

hpc:federation a owl:Class ;
    rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:statusItems .

hpc:sibling a owl:DatatypeProperty ;
    rdfs:domain hpc:federation ;
    rdfs:range xsd:string .

hpc:job_id a owl:Class ;
    rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:statusItems .

hpc:infinite a owl:DatatypeProperty ;
    rdfs:domain hpc:job_id ;
    rdfs:range xsd:boolean .

hpc:number a owl:DatatypeProperty ;
    rdfs:domain hpc:job_id ;
    rdfs:range xsd:int .
```
