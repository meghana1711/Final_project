hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:fairshare a owl:DatatypeProperty .
hpc:hasfairshare a owl:ObjectProperty .
hpc:levelfs a owl:DatatypeProperty .
hpc:haslevelfs a owl:ObjectProperty .

hpc:User rdfs:subClassOf hpc:Account .

hpc:User rdfs:domain hpc:Account .
hpc:Hasfairshare rdfs:domain hpc:Account .
hpc:Hasfairshare rdfs:range xsd:decimal .
hpc:Levelfs rdfs:domain hpc:Account .
hpc:Levelfs rdfs:range xsd:decimal .

hpc:Account rdfs:subClassOf rdf:Resource .
