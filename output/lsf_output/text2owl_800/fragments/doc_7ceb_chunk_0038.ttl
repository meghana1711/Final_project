hpc:QueueDefinition
    a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasQueueName
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .

hpc:editQueueDefinition
    a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Queuedefinition .

hpc:saveQueueDefinition
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:boolean .

hpc:checkQueueDefinition
    a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:boolean .

hpc:reconfigureCluster
    a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:boolean .

hpc:lsbQueuesFile
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .
