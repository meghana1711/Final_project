hpc:Fairsharejobcount a owl:Class .
hpc:hasfairsharejobcount a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharejobcount ;
    rdfs:range xsd:string .

hpc:Fwdjobfactor a owl:Class .
hpc:hasfwdjobfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Fwdjobfactor ;
    rdfs:range xsd:decimal .

hpc:Globalexitrate a owl:Class .
hpc:hasglobalexitrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Globalexitrate ;
    rdfs:range xsd:nonNegativeInteger .
