hpc:Applicationprofile a owl:Class .
hpc:Bacct a owl:Class .
hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:decimal .
hpc:d a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:dateTime .
hpc:dur a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:duration .
hpc:f a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:gpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:boolean .
hpc:Hostlistfile a owl:Class ;
    rdfs:subClassOf hpc:Hostname .
hpc:hostlistfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Hostmodel a owl:Class ;
    rdfs:subClassOf hpc:Hostname .
hpc:Hostname a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Lsprojectname a owl:Class ;
    rdfs:subClassOf hpc:Hostname .
hpc:logfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .
hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:dateTime .
