hpc:maxjobcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Controls how many jobs may be in the slurmctld daemon records at any point in time (pending, running, suspended or completed[temporarily]). The default value is 10,000." .

hpc:messagetimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:duration ;
    rdfs:comment "Controls how long to wait for a response to messages. The default value is 10 seconds. While the slurmctld daemon is highly threaded, its responsiveness is load dependent. This value might need to be increased somewhat." .

hpc:minjobage a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Controls how soon the record of a completed job can be purged from the slurmctld memory and thus not visible using the squeue command. The record of jobs run will be preserved in accounting records and logs. The default value is 300 seconds. The value should be reduced to a few seconds if possible." .

hpc:Slurmdaemon a owl:Class .

hpc:prologslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range hpc:Slurmdaemon ;
    rdfs:comment "Neither of these is recommended for a high throughput environment." .

hpc:epilogslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range hpc:Slurmdaemon ;
    rdfs:comment "Neither of these is recommended for a high throughput environment." .
