hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a computing queue." .

# LongQueue Class
hpc:Longqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "Represents a queue that displays queue information in a long multiple line format." .

# ShareAccountTree Object Property
hpc:shareaccounttree a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Shareaccounttree ;
    rdfs:comment "Represents the share account tree of a fair share queue." .

# FairShare Queue Class
hpc:Fairsharequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "Represents a queue that uses queue-based fair share." .

# GlobalFairSharePolicy Name Datatype Property
hpc:globalfairsharepolicyname a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharequeue ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the global fair share policy name for the participating queue." .

# RemoteShareLoad Datatype Property
hpc:remoteshareload a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareaccount ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Represents the remote share load for each share account in the queue." .

# NormalizedFairShareFactor Datatype Property
hpc:normalizedfairsharefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharequeue ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Represents the normalized fair share factor, if it is not zero." .

# ShareAccount Class
hpc:Shareaccount a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a share account in a fair share queue." .
