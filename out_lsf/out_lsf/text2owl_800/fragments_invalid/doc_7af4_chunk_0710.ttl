hpc:Operatingsystem a owl:Class .
hpc:Windows a hpc:OperatingSystem .
hpc:SunSolaris2x a hpc:OperatingSystem .

# Memory Limits
hpc:Memorylimitenforcementstrategy a owl:Class .
hpc:NoLimit a hpc:MemoryLimitEnforcementStrategy .
hpc:OSLevel a hpc:MemoryLimitEnforcementStrategy .
hpc:LSFJobLevel a hpc:MemoryLimitEnforcementStrategy .
hpc:LSFProcessLevel a hpc:MemoryLimitEnforcementStrategy .

hpc:OSLevelMemoryLimit a hpc:MemoryLimitEnforcementStrategy .
hpc:LSFJobMemoryLimit a hpc:MemoryLimitEnforcementStrategy .
hpc:LSFProcessMemoryLimit a hpc:MemoryLimitEnforcementStrategy .

hpc:operatingsystemmemorylimit a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range hpc:Memorylimitenforcementstrategy .

# LSB Parameters
hpc:lsbJobMemlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

hpc:lsbMemlimitEnforce a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

hpc:lsbJobOutputLogging a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

# Commands and Actions
hpc:bctrldrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

hpc:jobControls a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

hpc:jobTerminateInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystemmemorylimit .
    rdfs:range xsd:string .

# Limitations
hpc:Jobrunninglimitations a owl:Class .
hpc:ConcurrentLimit a hpc:JobRunningLimitations .
hpc:MemoryLimitInteraction a hpc:JobRunningLimitations .

hpc:concurrentlimitdescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrunninglimitations .
    rdfs:range xsd:string .

hpc:memorylimitinteractiondescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrunninglimitations .
    rdfs:range xsd:string .

hpc:jobrunninglimitationsonrunningjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrunninglimitations .
    rdfs:range hpc:Operatingsystemmemorylimit .
