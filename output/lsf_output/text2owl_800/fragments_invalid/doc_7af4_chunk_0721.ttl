hpc:LsbLogMaskSch a owl:Class .
hpc:hasLogLevel an owl:ObjectProperty .
hpc:hasValidLogLevels a rdfs:Class .
hpc:LOG_ERR rdf:value "LOG_ERR" ;
    rdfs:subClassOf hpc:Hasvalidloglevels .
hpc:LOG_WARNING rdf:value "LOG_WARNING" ;
    rdfs:subClassOf hpc:Hasvalidloglevels .
hpc:LOG_NOTICE rdf:value "LOG_NOTICE" ;
    rdfs:subClassOf hpc:Hasvalidloglevels .
hpc:LOG_INFO rdf:value "LOG_INFO" ;
    rdfs:subClassOf hpc:Hasvalidloglevels .
hpc:LOG_DEBUG rdf:value "LOG_DEBUG" ;
hpc:LOG_DEBUG1 rdf:value "LOG_DEBUG1" ;
hpc:LOG_DEBUG2 rdf:value "LOG_DEBUG2" ;
hpc:LOG_DEBUG3 rdf:value "LOG_DEBUG3" ;
    rdfs:subClassOf hpc:Hasvalidloglevels .
hpc:LsbLogMaskSch hpc:hasloglevel rdf:resource hpc:LOG_DEBUG ;
    rdfs:domain hpc:LsbLogMaskSch ;
    rdfs:range hpc:Hasvalidloglevels .

hpc:LsbMailFromDomain a owl:Class .
hpc:hasDomainName an owl:ObjectProperty .
hpc:domainName rdf:datatype xsd:string .
hpc:LsbMailFromDomain hpc:hasdomainname ?domain_name ;
    rdfs:domain hpc:LsbMailFromDomain ;
    rdfs:range xsd:string .

hpc:LsbMailTimestampEpochSeconds a owl:Class .
hpc:hasTimestampFormat an owl:DatatypeProperty .
hpc:hasTimestampFormatValue an owl:ObjectProperty .
hpc:Y rdf:value "Y" ;
    rdfs:subClassOf hpc:Hastimestampformatvalue .
hpc:N rdf:value "N" ;
    rdfs:subClassOf hpc:Hastimestampformatvalue .
hpc:LsbMailTimestampEpochSeconds hpc:hastimestampformat rdf:resource hpc:Y ;
    rdfs:domain hpc:LsbMailTimestampEpochSeconds ;
    rdfs:range hpc:Hastimestampformatvalue .

hpc:LsbMailprog a owl:Class .
hpc:hasMailProgram an owl:DatatypeProperty .
hpc:hasMailProgramValue an owl:ObjectProperty .
hpc:LsbMailprog hpc:hasmailprogram rdf:datatype xsd:string ;
    rdfs:domain hpc:LsbMailprog ;
    rdfs:range xsd:string .
