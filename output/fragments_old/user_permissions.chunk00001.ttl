hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a owl:NamedIndividual ;
    rdf:type hpc:SlurmWorkloadManager .

hpc:Operator a owl:Class .
hpc:Admin a owl:Class ;
    rdfs:subClassOf hpc:Operator .
hpc:Coordinator a owl:Class ;
    rdfs:subClassOf hpc:Operator .

hpc:hasPermission a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .

hpc:viewInformation a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .
hpc:createReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .
hpc:alterReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .
hpc:deleteReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .
hpc:setAdminLevel a owl:ObjectProperty ;
    rdfs:domain hpc:Operator ;
    rdfs:range xsd:string .
hpc:alterSlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range xsd:string .
hpc:addUsersOrSubAccounts a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .
hpc:changeLimitsOnAccountAndUserAssociations a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .
hpc:cancelJobs a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .
hpc:requeueJobs a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .
hpc:reassignJobs a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .

hpc:hasTableInDatabase a owl:ObjectProperty ;
    rdfs:domain hpc:Coordinator ;
    rdfs:range xsd:string .
```
