hpc:Job a owl:Class .
hpc:BlockSize rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NumberOfSlots rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Blocksizeconstraint a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:BlockSizeConstraint rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job ;
    owl:hasValue (xsd:integer "4"^^xsd:integer) rdfs:range .

hpc:Rejectedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Allocatedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Allocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Allocatedjob ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .
hpc:HostStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:HostResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MaxJobs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:RunStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:SuspendedStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Unavailablehost a owl:Class ;
    rdfs:subClassOf hpc:Host .
