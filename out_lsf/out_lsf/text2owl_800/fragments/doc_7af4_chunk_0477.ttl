hpc:Queuepriority a owl:Class .
hpc:nice a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuepriority ;
    rdfs:range xsd:integer .

hpc:Processlimit a owl:Class .
hpc:defaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit ;
    rdfs:range xsd:integer .
hpc:maximumlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit .

hpc:Jobslotlimit a owl:Class .
hpc:qjobLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslotlimit ;
    rdfs:range xsd:integer .

hpc:Queuegroup a owl:Class .
hpc:queueGroup a owl:ObjectProperty ;
    rdfs:domain hpc:Queuegroup ;
    rdfs:range rdf:List .
