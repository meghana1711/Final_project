hpc:Lsflicensescheduler a owl:Class .
hpc:Repriselicensemanager a owl:Class .
hpc:portnumber a owl:DatatypeProperty .
hpc:Licenseserverhost a owl:Class .
hpc:licservers a owl:ObjectProperty .
hpc:Flexnetlicenseserver a owl:Class .
hpc:Multiplelicenseserverhosts a owl:Class .
hpc:Redundantlicenseserverhosts a owl:Class .
hpc:Licensecollector a owl:Class .
hpc:licensecollectorname a owl:DatatypeProperty .
hpc:Servicedomain a owl:Class .
hpc:liccollectorserves a owl:ObjectProperty .
hpc:Performance a owl:Class .
hpc:distributelicenseinformation a owl:ObjectProperty .
hpc:Clustermode a owl:Class .
hpc:Projectmode a owl:Class .
hpc:Defaultundefined a owl:Class .
hpc:Licenseschedulerdaemon a owl:Class .
hpc:Licensecollectordaemon a owl:Class .

hpc:Licenseserverhost rdfs:subClassOf hpc:Licserver .
hpc:Licservers rdfs:domain hpc:Lsflicensescheduler ;
                 rdfs:range rdf:List .
hpc:Flexnetlicenseserver rdfs:subClassOf hpc:Licenseserverhost .
hpc:Multiplelicenseserverhosts rdfs:subClassOf hpc:Licenseserverhost ;
                 rdfs:subClassOf rdf:List .
hpc:Redundantlicenseserverhosts rdfs:subClassOf hpc:Licenseserverhost ;
                 rdfs:subClassOf rdf:List .
hpc:Licensecollector rdfs:subClassOf hpc:Servicedomain .
hpc:Liccollectorserves rdfs:domain hpc:Licensecollector ;
                 rdfs:range hpc:Servicedomain .
hpc:Performance rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Distributelicenseinformation rdfs:domain hpc:Performance ;
                 rdfs:range hpc:Lsflicensescheduler .
hpc:Clustermode rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Projectmode rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Defaultundefined rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Licenseschedulerdaemon rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Licensecollectordaemon rdfs:subClassOf hpc:Licensecollector .

hpc:Portnumber rdfs:domain hpc:Repriselicensemanager ;
              rdfs:range xsd:integer .
