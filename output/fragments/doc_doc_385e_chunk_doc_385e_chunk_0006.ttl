hpc:Node a owl:Class .
hpc:CPU a owl:Class .
hpc:Allocation a owl:Class .
hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range hpc:Node .
hpc:hasCPU rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range hpc:CPU .
hpc:allocatedOn rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range xsd:time .
hpc:Node sleep rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:Linux01 a hpc:Node ;
    hpc:hasCPU 2 .
hpc:Linux02 a hpc:Node ;
    hpc:hasCPU 2 .
hpc:Linux03 a hpc:Node ;
    hpc:hasCPU 2 .
hpc:Linux04 a hpc:Node ;
    hpc:hasCPU 4 .

hpc:Job1 a hpc:Allocation ;
    hpc:allocatedOn "0:00"^^xsd:time ;
    hpc:hasNode linux01 ;
    hpc:hasCPU 2 .
hpc:Job2 a hpc:Allocation ;
    hpc:allocatedOn "0:11"^^xsd:time ;
    hpc:hasNode linux02 ;
    hpc:hasCPU 2 .
hpc:Job3 a hpc:Allocation ;
    hpc:allocatedOn "0:11"^^xsd:time ;
    hpc:hasNode linux03 ;
    hpc:hasCPU 2 .
hpc:Job4 a hpc:Allocation ;
    hpc:allocatedOn "0:11"^^xsd:time ;
    hpc:hasNode linux04 ;
    hpc:hasCPU 1 .
hpc:Job5 a hpc:Allocation ;
    hpc:allocatedOn "0:11"^^xsd:time ;
    hpc:hasNode linux04 ;
    hpc:hasCPU 3 .
```
