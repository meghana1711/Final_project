hpc:Lsfuser a owl:Class .
hpc:haspassword a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .

hpc:hasrole a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser .

hpc:Lsfuserrole a owl:Class .
hpc:Lsfuserrolewithoutego a owl:Class .
hpc:Lsfuserrolewithego a owl:Class .

hpc:LSFUserRoleWithoutEGO;
    hpc:Lsfuser a rdfs:subClassOf ;
    hpc:Primarylsfadministrator a rdfs:subClassOf ;
    hpc:Lsfadministrator a rdfs:subClassOf ;
    hpc:Clusteradministrator a rdfs:subClassOf ;
    hpc:Queueadministrator a rdfs:subClassOf ;
    hpc:Hostgroupadministrator a rdfs:subClassOf ;
    hpc:Usergroupadministrator a rdfs:subClassOf .

hpc:LSFUserRoleWithEGO;
    hpc:Clusteradministrator a rdfs:subClassOf ;
    hpc:Consumeradministrator a rdfs:subClassOf .

hpc:LSFUser;
    hpc:haspermissiontosubmitjobs a owl:ObjectProperty ;
    hpc:haspermissiontoviewjobstates a owl:ObjectProperty .

hpc:primaryLSFAdministrator;
    hpc:haspermissiontoperformclusterwideoperations a owl:ObjectProperty ;
    hpc:haspermissiontochangeconfigurationfiles a owl:ObjectProperty ;
    hpc:haspermissiontoreconfigurecluster a owl:ObjectProperty ;
    hpc:haspermissiontocontroljobssubmittedbyallusers a owl:ObjectProperty .

hpc:LSFAdministrator;
    hpc:haspermissiontoperformoperationsaffectingotherlsfusers a owl:ObjectProperty .

hpc:clusterAdministrator;
    rdfs:subClassOf hpc:Lsfadministrator ;
    hpc:canadministeranyobjectsandworkloadincluster a owl:ObjectProperty .

hpc:consumerAdministrator;
    rdfs:subClassOf hpc:Lsfuserrolewithego ;
    hpc:canadministeranyobjectsandworkloadinconsumerstowhichtheyhaveaccess a owl:ObjectProperty .
