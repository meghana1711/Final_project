hpc:Loadstop a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Determines when running jobs can be suspended." .

hpc:Loadindex a owl:Class ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Loadstop ;
    rdfs:range xsd:decimal .

hpc:Loadlevel a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The load level on a host." .

hpc:Hostloadcondition a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The load conditions on a host compared with the threshold values." .

hpc:Resourcelimit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Limits the use of resources while a job is running." .

hpc:Hardlimit a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimit ;
    rdfs:comment "Resource limits that are specified at the queue level are hard limits." .

hpc:Softlimit a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimit ;
    rdfs:comment "Resource limits that are specified with job submission are soft limits." .

hpc:Resourceallocationlimit a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimit ;
    rdfs:comment "Restricts the amount of a resource that must be available during job scheduling." .

hpc:Resourceconsumer a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The resource consumers the limits apply to." .

hpc:Jobresourcerequirement a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The bsub -R option specifies resources requirements for the job." .

hpc:Hostmatch a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Hosts that match the resource requirements." .
