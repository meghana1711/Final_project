    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

hpc:RunTimeKill hpc:runcRunTimeKill a owl:ObjectProperty ;
    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

