hpc:Iorate a owl:Class .
hpc:io a owl:DatatypeProperty ;
    rdfs:domain hpc:Iorate ;
    rdfs:range xsd:decimal .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:order a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:builtin a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:dynamic a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:release a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .

hpc:Loadindex a owl:Class .
hpc:lsinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Loadindex ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class .
hpc:commandline a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Swap a owl:Class ;
    rdfs:subClassOf hpc:Resource .
