hpc:Threadlimit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The default is no limit. Exceeding the limit causes the job to terminate." .

hpc:hasthreadlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of concurrent threads for a job." .

hpc:Jobtermination a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The termination time for a job." .

hpc:hasterminationtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobtermination ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when a job is scheduled to terminate." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A computing job submitted to a cluster." .

hpc:hasterminationsignal a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The sequence of signals sent to a job when it exceeds the thread limit or reaches its termination time." .

hpc:Schedule a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A schedule for a job." .

hpc:hasschedule a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Schedule ;
    rdfs:comment "The schedule associated with a job." .

hpc:terminationaction a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string ;
    rdfs:comment "The action to take when a job reaches its termination time." .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A profile for an application." .

hpc:terminatecontrolaction a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The action to take when an application reaches its termination time." .
