hpc:Powerpolicy a owl:Class .
hpc:Powerpolicyname rdfs:domain hpc:Powerpolicy ;
                     rdfs:range xsd:string ;
                     rdfs:maxLength 60 .
hpc:Hostlist rdfs:domain hpc:Powerpolicy ;
                 rdfs:range rdf:List .
hpc:Hostlistmember rdfs:domain hpc:Hostlist ;
                    rdfs:range hpc:Host .
hpc:Host a owl:Class .
hpc:Hostname rdfs:domain hpc:Host ;
             rdfs:range xsd:string .
hpc:Hostpartition rdfs:domain hpc:Host ;
                rdfs:range xsd:string .
hpc:Hostgroup rdfs:domain hpc:Host ;
               rdfs:range xsd:string .
hpc:Computeunit rdfs:domain hpc:Host ;
               rdfs:range xsd:string .
hpc:Powerpolicynameunique rdfs:subClassOf hpc:Powerpolicy ;
                             rdfs:subPropertyOf rdf:type ;
                             rdfs:domain hpc:Powerpolicy ;
                             rdfs:range hpc:Powerpolicy ;
                             owl:inverseOf hpc:hasUniquePowerPolicyName .
hpc:Hasuniquepowerpolicyname rdfs:domain hpc:Powerpolicy ;
                             rdfs:range hpc:Powerpolicy .
hpc:Timewindow rdfs:domain hpc:Powerpolicy ;
                 rdfs:range xsd:duration .
hpc:Allhostsnotincluded rdfs:subClassOf hpc:Powerpolicy ;
                               rdfs:subPropertyOf rdf:type ;
                               rdfs:domain hpc:Powerpolicy ;
                               rdfs:range hpc:Powerpolicy ;
                               owl:inverseOf hpc:hasAllHostsNotIncluded .
hpc:Hasallhostsnotincluded rdfs:domain hpc:Powerpolicy ;
                             rdfs:range hpc:Powerpolicy .
hpc:Managementandmanagementcandidatehosts rdfs:subClassOf hpc:Powerpolicy ;
                                                 rdfs:subPropertyOf rdf:type ;
                                                 rdfs:domain hpc:Powerpolicy ;
                                                 rdfs:range hpc:Powerpolicy ;
                                                 owl:inverseOf hpc:hasManagementAndManagementCandidateHosts .
hpc:Hasmanagementandmanagementcandidatehosts rdfs:domain hpc:Powerpolicy ;
                                               rdfs:range hpc:Powerpolicy .
hpc:hostsOverlap rdfs:subPropertyOf rdf:type ;
                   rdfs:domain hpc:Powerpolicy ;
                   rdfs:range rdf:List .
hpc:Hostsoverlapmember rdfs:domain hpc:Hostsoverlap ;
                       rdfs:range hpc:Host .
hpc:timeWindowActive rdfs:subPropertyOf rdf:type ;
                       rdfs:domain hpc:Powerpolicy ;
                       rdfs:range xsd:boolean .
hpc:timeWindowInactive rdfs:subPropertyOf rdf:type ;
                        rdfs:domain hpc:Powerpolicy ;
