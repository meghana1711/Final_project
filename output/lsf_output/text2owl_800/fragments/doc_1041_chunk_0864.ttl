hpc:Patchinstallcommand a owl:Class .
hpc:Hasenvironmentsetting rdfs:domain hpc:Patchinstallcommand ;
    rdfs:range xsd:string .
hpc:Requirespermission rdfs:domain hpc:Patchinstallcommand ;
    rdfs:range hpc:Account .
hpc:Isadminaccount rdfs:subClassOf hpc:Account .
hpc:Isrootaccount a owl:Class ;
    rdfs:subClassOf hpc:Account .
hpc:Haspackage rdfs:domain hpc:Patchinstallcommand ;
    rdfs:range hpc:Package .
hpc:Silentoption rdfs:domain hpc:Patchinstallcommand ;
    rdfs:range xsd:boolean .
hpc:Forceoption rdfs:domain hpc:Patchinstallcommand ;
    rdfs:range xsd:boolean .
hpc:Clusteradminaccount rdfs:subClassOf hpc:Account .
hpc:Package a owl:Class .
