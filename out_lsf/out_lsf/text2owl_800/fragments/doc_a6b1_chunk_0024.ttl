hpc:Host a owl:Class .
hpc:Logfile a owl:Class .
hpc:Timinglevel a owl:Class .
hpc:LogfileName rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .
hpc:HostName rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:restime a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Timingtime .
hpc:badminMbdtime a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Timingtime .
hpc:badminSbdtime a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Timingtime .
hpc:badminSchdtime a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Timingtime .
hpc:lsfJobTerminationReasonLogging a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .

hpc:Timingtime rdfs:subClassOf xsd:string .
