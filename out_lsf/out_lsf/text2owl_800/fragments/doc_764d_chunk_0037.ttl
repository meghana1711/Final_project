hpc:Executioncluster a owl:Class .
hpc:Submissioncluster a owl:Class .
hpc:jobforwardingmodel a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Job .

hpc:fairsharescheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Schedulingpolicy .

hpc:Fairsharepriority a owl:Class ;
    rdfs:subClassOf hpc:Schedulingpolicy .

hpc:Usergroup a owl:Class .
hpc:resourceusageinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharepriority ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Multiclusterjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Localjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:jobresizing a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Job .

hpc:jobresizable a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobresizing ;
    rdfs:range xsd:boolean .

hpc:jobshrinkable a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobresizing ;
    rdfs:range xsd:boolean .

hpc:jobrelease a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Jobresizing .

hpc:Jobresizerelease a owl:Class ;
    rdfs:subClassOf hpc:Jobresizing .

hpc:lsbeventsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobresizerelease ;
    rdfs:range xsd:string .

hpc:jobResize a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbeventsfile ;
    rdfs:range xsd:string .

hpc:jobAcctFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Submissioncluster ;
    rdfs:range xsd:string .

hpc:jobspanscluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:boolean .

hpc:resizableacrossclusters a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:boolean .

hpc:userbelongstogroup a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Usergroup .

hpc:User a owl:Class .
