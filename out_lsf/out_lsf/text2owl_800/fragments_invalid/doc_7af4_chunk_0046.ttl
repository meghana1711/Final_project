hpc:Checkpointdirectory a owl:Class ;
    rdfs:comment "Specifies the checkpoint directory for automatic checkpointing for the application." ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "CheckpointDirectory" ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range rdf:XMLLiteral ;

hpc:hascheckpointdirectory a owl:ObjectProperty ;
    rdfs:comment "Relates an ApplicationProfile to its checkpoint directory." ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Checkpointdirectory ;

hpc:Checkpointperiodabsentwarning a owl:Class ;
    rdfs:comment "A warning message issued when CHKPNT_PERIOD, CHKPNT_INITPERIOD or CHKPNT_METHOD was set in an application profile but CHKPNT_DIR was not set." ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "checkpointPeriodAbsentWarning" ;

hpc:checkpointdirectorypathlength a owl:DatatypeProperty ;
    rdfs:comment "The maximum length of the file path of the checkpoint directory." ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:integer ;

hpc:Checkpointingnotsupportedonleasedhost a owl:Class ;
    rdfs:comment "Checkpointing is not supported if a job runs on a leased host." ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "checkpointingNotSupportedOnLeasedHost" ;

hpc:Checkpointingsupportedonmulticluster a owl:Class ;
    rdfs:comment "To enable checkpointing of jobs with the LSF multicluster capability, define a checkpoint directory in an application profile." ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "checkpointingSupportedOnMulticluster" ;

hpc:ischeckpointdirectoryrelative a owl:DatatypeProperty ;
    rdfs:comment "Indicates whether the checkpoint directory is relative to the current working directory for the job." ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:boolean ;

hpc:maxcheckpointdirectorypathlengthunixlinux a owl:DatatypeProperty ;
    rdfs:comment "The maximum length of the file path of the checkpoint directory for UNIX and Linux." ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:integer ;

hpc:maxcheckpointdirectorypathlengthwindows a owl:DatatypeProperty ;
    rdfs:comment "The maximum length of the file path of the checkpoint directory for Windows." ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:integer ;

hpc:Mergecheckpointconfiguration a owl:Class ;
    rdfs:comment "The merged result of job-level and application profile settings override queue-level configuration." ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "mergeCheckpointConfiguration" ;

hpc:useEnvironmentVariablesInDirectoryPath a
