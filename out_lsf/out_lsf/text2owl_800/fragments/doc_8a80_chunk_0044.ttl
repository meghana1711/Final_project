hpc:hasLicense
    a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:positiveInteger .

hpc:totalShares
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The total number of shares is the sum of the shares assigned to each project." .

hpc:ownsLicenses
    a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "When configured, preemption is enabled and owned licenses are reclaimed using preemption when there is unmet demand." .

hpc:defaultProject
    a owl:Class ;
    rdfs:subClassOf hpc:Project ;
    rdfs:comment "A reserved keyword that represents the default project if the job submission does not specify a project." .

hpc:hasDescription
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "Used for project mode only." .

hpc:projectMode
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "One of DISTRIBUTION or GROUP_DISTRIBUTION must be defined when using project mode." .

hpc:mutuallyExclusive
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range hpc:Projectmode ;
    rdfs:comment "If deﬁned in the same feature, the License Scheduler daemon returns an error and ignores this feature." .

hpc:Distribution
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Used for project mode only." .

hpc:groupDistribution
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Used for project mode only." .
