hpc:GpuReqParameter a owl:Class .
hpc:execDriverEquivalence a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReqParameter ;
    rdfs:range hpc:LsbApplicationParameter .

hpc:dockerImagePreference a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReqParameter ;
    rdfs:range xsd:boolean .

hpc:mpsNoCudaVisibleDevices a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReqParameter ;
    rdfs:range xsd:boolean .

hpc:blockDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReqParameter ;
    rdfs:range xsd:boolean .

hpc:packScheduling a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReqParameter ;
    rdfs:range xsd:boolean .

hpc:sessionPam a owl:ObjectProperty ;
    rdfs:domain hpc:UsePamCredsParameter ;
    rdfs:range xsd:boolean .

hpc:limitsPam a owl:ObjectProperty ;
    rdfs:domain hpc:UsePamCredsParameter ;
    rdfs:range xsd:boolean .

hpc:mcForwardDelay a owl:DatatypeProperty ;
    rdfs:domain hpc:JobParameter ;
    rdfs:range xsd:nonNegativeInteger .

hpc:jobForwardingBehavior a owl:DatatypeProperty ;
    rdfs:domain hpc:JobParameter ;
    rdfs:range xsd:string .

hpc:relaxJobDispatchOrder a owl:ObjectProperty ;
    rdfs:domain hpc:JobParameter ;
    rdfs:range xsd:boolean .

hpc:RelaxedConstraints a owl:Class ;
    rdfs:subClassOf hpc:JobParameter .

hpc:share a owl:ObjectProperty ;
    rdfs:domain hpc:RelaxJobDispatchOrder ;
    rdfs:range xsd:string .

hpc:maxSbdConns a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbHostParameter ;
    rdfs:range xsd:nonNegativeInteger .

hpc:defaultValue a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxSbdConns ;
    rdfs:range xsd:integer .
