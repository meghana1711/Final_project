hpc:Plan a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a plan for a job." .

hpc:delay a owl:DatatypeProperty ;
    rdfs:domain hpc:Plan ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Number of minutes to delay before considering making a plan for a job following the job's submission time." .

hpc:maxJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Plan ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Maximum number of jobs that can have a plan concurrently." .

hpc:rschedTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Plan ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Number of minutes before recalculating the plan. If set to 0, the plan is recalculated in each plan-making cycle." .

hpc:allocationPlanner a owl:ObjectProperty ;
    rdfs:domain hpc:Plan ;
    rdfs:range hpc:Plan ;
    rdfs:comment "The PLAN parameter replaces the existing SLOT_RESERVE parameter and RESOURCE_RESERVE parameter when the ALLOCATION_PLANNER parameter is enabled." .

hpc:powerOnWait a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Configures a wait time (in seconds) after a host is resumed and enters ok status, before dispatching a job." .

hpc:POWER_ON_WAIT_GLOBAL a owl:NamedIndividual ;
    hpc:POWER_ON_WAIT rdf:type xsd:nonNegativeInteger ;
    rdfs:comment "The default value applied globally." .

hpc:powerResetCmd a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:XMLLiteral ;
    rdfs:comment "Defines the reset operation script that will be called when handling a power reset request." .

hpc:powerResumeCmd a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:XMLLiteral ;
    rdfs:comment "Defines the resume operation script that will be called when handling a resume request. An opposite operation to POWER_SUSPEND_CMD." .

hpc:POWER_STATUS_LOG_MAX a
