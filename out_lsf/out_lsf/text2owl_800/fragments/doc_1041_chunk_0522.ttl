hpc:Reservation a owl:Class .
hpc:ReservationID rdf:type xsd:string .
hpc:Host a owl:Class .
hpc:HostName rdf:type xsd:string .
hpc:HostGroup rdf:type xsd:string .
hpc:NumberUnit rdf:type xsd:nonNegativeInteger .
hpc:User a owl:Class .
hpc:UserName rdf:type xsd:string .
hpc:UserGroup rdf:type xsd:string .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Host .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .

hpc:removehosts a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:removeusers a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:canRemoveHosts rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:removeHosts .

hpc:canRemoveUsers rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:removeUsers .

hpc:hasremovedhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasremovedusers a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:reservationdisabled a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .

hpc:ReservationCanBeEnabled rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:ReservationDisabled .

hpc:reservationforcedisable a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .
