hpc:Useraccount a owl:Class .
hpc:Administrativeprivileges a owl:Class .
hpc:changepasswordaction a owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range hpc:Administrativeprivileges .
hpc:oldpassword a owl:DatatypeProperty ;
    rdfs:domain hpc:Changepasswordaction .
hpc:newpassword a owl:DatatypeProperty ;
    rdfs:domain hpc:Changepasswordaction .
hpc:Host a owl:Class .
hpc:workgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range hpc:Host .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Changepasswordaction .
hpc:username a owl:ObjectProperty ;
    rdfs:domain hpc:Changepasswordaction ;
    rdfs:range xsd:string .
hpc:ChangePasswordActionSuccess a xsd:string .
hpc:ChangePasswordActionFailure a xsd:string .
hpc:changeownpasswordaction a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Changepasswordaction ;
    rdfs:domain hpc:Useraccount .
hpc:changeanotheruserpasswordaction a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Changepasswordaction ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range hpc:Useraccount .
