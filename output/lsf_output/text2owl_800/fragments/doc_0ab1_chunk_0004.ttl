hpc:Jobprocessbinding rdfs:subClassOf owl:Class .

hpc:Cudavisibledevices rdfs:domain hpc:Gpujobdevice ;
                        rdfs:range xsd:string .
hpc:Gpuallocation rdfs:domain hpc:Gpujob ;
                   rdfs:range hpc:Exclusivethreadgpu .
hpc:Devicecontainer rdfs:domain hpc:Gpujobdevice ;
                     rdfs:range hpc:Gpujobprocess .
