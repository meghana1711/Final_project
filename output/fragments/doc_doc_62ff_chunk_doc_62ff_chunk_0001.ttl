hpc:WorkloadManager a owl:Class.
hpc:PBS a hpc:WorkloadManager.
hpc:Torque a hpc:WorkloadManager.
hpc:Slurm a hpc:WorkloadManager.
hpc:LSF a hpc:WorkloadManager.
hpc:SGE a hpc:WorkloadManager.
hpc:LoadLeveler a hpc:WorkloadManager.

hpc:Command a owl:Class.
hpc:EnvironmentVariable a owl:Class.
hpc:JobSpecificationOption a owl:Class.

hpc:hasCommand a owl:ObjectProperty.
hpc:hasEnvironmentVariable a owl:ObjectProperty.
hpc:hasJobSpecificationOption a owl:ObjectProperty.

hpc:commonFunctionality rdf:type owl:Class.
hpc:uniqueFeature rdf:type owl:Class.

hpc:isUsedBy a owl:ObjectProperty.
hpc:hasCommonFunctionality rdf:type owl:ObjectProperty.
hpc:hasUniqueFeature rdf:type owl:ObjectProperty.

hpc:WorkloadManager rdfs:subClassOf [ a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf owl:NamedIndividual ]
].

hpc:Command rdfs:subClassOf [ a owl:Class ;
  rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf xsd:string ]
].

hpc:EnvironmentVariable rdfs:subClassOf [ a owl:Class ;
  rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf xsd:string ]
].

hpc:JobSpecificationOption rdfs:subClassOf [ a owl:Class ;
  rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf xsd:string ]
].

hpc:hasCommonFunctionality rdfs:domain hpc:WorkloadManager.
hpc:hasCommonFunctionality rdfs:range hpc:commonFunctionality.

hpc:hasUniqueFeature rdfs:domain hpc:WorkloadManager.
hpc:hasUniqueFeature rdfs:range hpc:uniqueFeature.

hpc:isUsedBy rdfs:domain hpc:commonFunctionality.
hpc:isUsedBy rdfs:range hpc:WorkloadManager.

hpc:hasCommand rdfs:domain hpc:WorkloadManager.
hpc:hasCommand rdfs:range hpc:Command.

hpc:hasEnvironmentVariable rdfs:domain hpc:WorkloadManager.
hpc:hasEnvironmentVariable rdfs:range hpc:EnvironmentVariable.

hpc:hasJobSpecificationOption rdfs:domain hpc:WorkloadManager.
hpc:hasJobSpecificationOption rdfs:range hpc:JobSpecificationOption.
