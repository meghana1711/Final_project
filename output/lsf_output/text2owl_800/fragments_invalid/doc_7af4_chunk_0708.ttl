hpc:Job a owl:Class .
hpc:Process a owl:Class .
hpc:Signal an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signaltype .
hpc:SignalType rdf:type owl:Class .
hpc:CPU_Limit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Memory_Limit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:OS_Kill rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:LSF_Kill rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Per_Job_Limit rdf:type owl:Class .
hpc:Per_Process_Limit rdf:type owl:Class .
hpc:lsbJobidDispLength a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:integer .
hpc:maxJobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:integer .
hpc:lsbJobCpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:boolean .
hpc:lsbJobMemlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:boolean .
hpc:Configuration a owl:Class .
