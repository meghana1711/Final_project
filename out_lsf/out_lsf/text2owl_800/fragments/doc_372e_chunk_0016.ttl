hpc:Serviceclass a owl:Class .
hpc:hasname a owl:ObjectProperty .
hpc:goals a owl:ObjectProperty .
hpc:optionalparameters a owl:ObjectProperty .

hpc:Hasname rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .

hpc:Goals rdfs:domain hpc:Serviceclass ;
    rdfs:range rdfs:Resource .

hpc:Goals rdfs:subClassOf owl:Class ;
    rdfs:subClassOf (hpc:Guarantee rdf:type owl:Class) .

hpc:Optionalparameters rdfs:domain hpc:Serviceclass ;
    rdfs:range rdfs:Resource .

hpc:Optionalparameters rdfs:subClassOf owl:Class .
