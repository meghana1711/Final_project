@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Serviceclass a owl:Class.
hpc:Serviceclass hpc:haspriority rdf:datatype xsd:integer.
hpc:Serviceclass hpc:hasusergroup rdf:List.
hpc:Serviceclass hpc:hasgoal rdf:List.
hpc:Serviceclass hpc:hasactivewindow rdf:List.
hpc:Serviceclass hpc:hasstatus rdf:List.
hpc:Serviceclass hpc:hasslathroughput rdf:datatype xsd:decimal.
hpc:Serviceclass hpc:hasoptimumnumberofrunningjobs rdf:datatype xsd:nonNegativeInteger.

hpc:Sla a owl:Class.
hpc:Sla hpc
