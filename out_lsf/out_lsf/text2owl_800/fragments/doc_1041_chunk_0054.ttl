hpc:Loglevel a owl:Class .
hpc:LogDebug1 a hpc:LogLevel .
hpc:LogDebug2 a hpc:LogLevel .
hpc:LogDebug3 a hpc:LogLevel .

hpc:includes a owl:ObjectProperty .
hpc:Includes rdfs:domain hpc:Loglevel .
hpc:Includes rdfs:range hpc:Loglevel .

hpc:Loglevel rdfs:subClassOf hpc:Loglevel .
hpc:Logdebug1 rdfs:subClassOf hpc:Loglevel .
hpc:Logdebug2 rdfs:subClassOf hpc:Loglevel .
hpc:Logdebug3 rdfs:subClassOf hpc:Loglevel .
hpc:Logdebug3 rdfs:subClassOf hpc:Logdebug2 .
hpc:Logdebug3 rdfs:subClassOf hpc:Logdebug1 .
hpc:Logdebug3 rdfs:subClassOf hpc:Logdebug .

hpc:Logfile a owl:Class .
hpc:Logfile rdfs:subClassOf hpc:Loglevel .

hpc:filepath a owl:DatatypeProperty .
hpc:Filepath rdfs:domain hpc:Logfile .
hpc:Filepath rdfs:range xsd:string .

hpc:logfilename a owl:DatatypeProperty .
hpc:Logfilename rdfs:domain hpc:Logfile .
hpc:Logfilename rdfs:range xsd:string .

hpc:logfileformat a owl:DatatypeProperty .
hpc:Logfileformat rdfs:domain hpc:Logfile .
hpc:Logfileformat rdfs:range xsd:string .

hpc:Logdirectory a owl:Class .
hpc:Logdirectory rdfs:subClassOf hpc:Loglevel .

hpc:defaultlogfile a owl:DatatypeProperty .
hpc:Defaultlogfile rdfs:domain hpc:Loglevel .
hpc:Defaultlogfile rdfs:range xsd:string .

hpc:resettodefault a owl:ObjectProperty .
hpc:Resettodefault rdfs:domain hpc:Loglevel .
