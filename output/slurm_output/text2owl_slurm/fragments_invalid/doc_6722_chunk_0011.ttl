hpc:Burstbufferdirective a owl:Class.
hpc:Job a owl:Class.
hpc:Burstbufferpool a owl:Class.
hpc:capacity a owl:DatatypeProperty;
    rdfs:domain hpc:Burstbufferpool;
    rdfs:range xsd:nonNegativeInteger.
hpc:directive a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Burstbufferdirective.
hpc:Application a owl:Class.
hpc:hasapplication a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Application.
hpc:createpersistent a owl:ObjectProperty.
hpc:Persistentburstbuffer a owl:Class.
hpc:name a owl:DatatypeProperty;
    rdfs:domain hpc:Createpersistent;
    rdfs:range xsd:string.
hpc:capacitypersistent a owl:DatatypeProperty;
    rdfs:domain hpc:Createpersistent;
    rdfs:range xsd:nonNegativeInteger.
hpc:access a owl:DatatypeProperty;
