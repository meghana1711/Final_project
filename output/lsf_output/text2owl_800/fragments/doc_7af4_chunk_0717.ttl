hpc:LsbKrbTgtFwd a owl:Class .
hpc:lsbKrbCheckInterval a owl:DatatypeProperty .
hpc:LsbKrbCheckInterval rdfs:domain hpc:LsbKrbTgtFwd ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:LSB_KRB_CHECK_INTERVAL_DEFAULT a xsd:integer .
hpc:lsbKrbImpersonate a owl:ObjectProperty .
hpc:LSB_KRB_IMPERSONATE_DEFAULT a xsd:string .
hpc:LSB_KRB_IMPERSONATE_DOES_NOT_IMPERSONATE a xsd:string .
hpc:LSB_KRB_IMPERSONATE_IMPERSONATES a xsd:string .
hpc:LSB_KRB_IMPERSONATE_REQUIRES_EAUTH a xsd:string .
hpc:LSB_KRB_IMPERSONATE_RESTRICTIONS a xsd:string .
hpc:LSB_KRB_IMPERSONATE_AFFECTS_COMMANDS a xsd:string .
hpc:LSB_KRB_IMPERSONATE_RESTART_REQUIRED a xsd:string .
hpc:lsbKrbLibPath a owl:DatatypeProperty .
hpc:LsbKrbLibPath rdfs:domain hpc:LsbKrbTgtFwd ;
                             rdfs:range xsd:string .
