hpc:Resourcerequirement a owl:Class .
hpc:order a owl:ObjectProperty .
hpc:same a owl:ObjectProperty .
hpc:select a owl:ObjectProperty .
hpc:rusage a owl:ObjectProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:tmp a owl:DatatypeProperty .
hpc:duration a owl:DatatypeProperty .
hpc:decay a owl:DatatypeProperty .
hpc:license a owl:DatatypeProperty .

hpc:Bigmem a owl:Class .
hpc:Veriloglic a owl:Class .
hpc:Applicv15 a owl:Class .
hpc:Applicv201 a owl:Class .

hpc:Resourcerequirement rdfs:subClassOf owl:Class .
hpc:Order rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range hpc:Resourcerequirement .
hpc:Same rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range hpc:Resourcerequirement .
hpc:Select rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range rdfs:Literal .
hpc:Rusage rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range hpc:Resourcerequirement .
hpc:Mem rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:decimal .
hpc:Swp rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:decimal .
hpc:Tmp rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:decimal .
hpc:Duration rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:duration .
hpc:Decay rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:decimal .
hpc:License rdfs:domain hpc:Resourcerequirement ;
                               rdfs:range xsd:nonNegativeInteger .

hpc:Bigmem rdfs:subClassOf hpc:Resourcerequirement .
hpc:Veriloglic rdfs:subClassOf hpc:Resourcerequirement .
hpc:Applicv15 rdfs:subClassOf hpc:Resourcerequirement .
hpc:Applicv201 rdfs:subClassOf hpc:Resourcerequirement .

hpc:ResourceRequirement_1024 a hpc:ResourceRequirement ;
                             hpc:Rusage mem "0.5"^^xsd:decimal ;
                             hpc:Rusage swp "1"^^xsd:decimal ;
                             hpc:Rusage tmp "1024"^^xsd:decimal .

hpc:ResourceRequirement_multi a hpc:ResourceRequirement ;
                               hpc:Select swp "(> 15)"^^xsd:string ;
                               hpc:Select hpux "(true)"^^xsd:string ;
                               hpc:Order r15m "(true)"^^xsd:string ;
