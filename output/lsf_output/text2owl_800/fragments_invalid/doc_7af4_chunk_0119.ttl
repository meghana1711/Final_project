hpc:Tasklimit a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ; owl:unionOf (hpc:Queuetasklimit hpc:Applicationtasklimit hpc:Jobtasklimit) ] .

hpc:Queuetasklimit a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ; rdfs:subClassOf hpc:Tasklimit ] ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Hashighestpriority hpc:Applicationtasklimit ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Hashigherpriority hpc:Applicationtasklimit ] .

hpc:Applicationtasklimit a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ; rdfs:subClassOf hpc:Tasklimit ] ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Hashigherpriority hpc:Jobtasklimit ] .

hpc:Jobtasklimit a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ; rdfs:subClassOf hpc:Tasklimit ] ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subProperty rdfs:domain hpc:Job ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Jobleveltasklimit ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Minimum ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Default ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Maximum ] ;
    rdfs:subProperty rdfs:domain hpc:Applicationprofile ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Jobleveltasklimitminimum ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Jobleveltasklimitdefault ] ;
    rdfs:subProperty rdfs:range xsd:positiveInteger [ hpc:Jobleveltasklimitmaximum ] ;
    rdfs:subProperty rdfs:domain hpc:Jobprofile ;
    rdfs:subProperty rdfs:range xsd:boolean [ hpc:Ignoresjobsizelist ] .

hpc:terminateControl a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
