hpc:queryNthreads a owl:DatatypeProperty .
hpc:remoteCacheRefreshInterval a owl:DatatypeProperty .
hpc:stagingArea a owl:ObjectProperty .

hpc:QueryNthreads rdfs:domain hpc:Datamanager .
hpc:RemoteCacheRefreshInterval rdfs:domain hpc:Datamanager .
hpc:StagingArea rdfs:domain hpc:Datamanager .

hpc:QueryNthreads rdfs:range xsd:integer .
hpc:RemoteCacheRefreshInterval rdfs:range xsd:nonNegativeInteger .
hpc:StagingArea rdfs:range xsd:anyURI .

hpc:Datamanager a owl:Class .
