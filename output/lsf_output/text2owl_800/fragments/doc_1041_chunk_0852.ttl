hpc:Hostregsetup a owl:Class .
hpc:Filepath rdfs:domain hpc:Hostregsetup .
hpc:Filepath rdfs:range xsd:string .

hpc:Lsreghostcommand a owl:Class .
hpc:Sendsmessage rdfs:domain hpc:Lsreghostcommand .
hpc:Sendsmessage rdfs:range rdf:List .
hpc:Registermessage rdfs:range xsd:string .
hpc:Exits rdfs:domain hpc:Lsreghostcommand .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Hasname rdfs:domain hpc:Host .
hpc:Hasname rdfs:range xsd:string .

hpc:Lsfserver rdfs:subClassOf hpc:Host .
hpc:Isregistered rdfs:domain hpc:Lsfserver .
hpc:Isregistered rdfs:range xsd:boolean .

hpc:Hostregsetupfile rdfs:subClassOf owl:Class .
hpc:Containshost rdfs:domain hpc:Hostregsetupfile .
hpc:Containshost rdfs:range hpc:Host .
hpc:Istextfile rdfs:domain hpc:Hostregsetupfile .
hpc:Istextfile rdfs:range xsd:boolean .
hpc:Hasline rdfs:domain hpc:Hostregsetupfile .
hpc:Hasline rdfs:range xsd:string .
hpc:Isignored rdfs:domain hpc:Hostregsetupfile .
hpc:Isignored rdfs:range xsd:boolean .
hpc:Iscomment rdfs:domain hpc:Hostregsetupfile .
hpc:Iscomment rdfs:range xsd:boolean .

hpc:Windowslsfhost rdfs:subClassOf hpc:Host .
hpc:Hasipaddress rdfs:domain hpc:Windowslsfhost .
hpc:Hasipaddress rdfs:range xsd:string .
