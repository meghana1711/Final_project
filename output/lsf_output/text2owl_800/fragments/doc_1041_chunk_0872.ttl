hpc:Fullinstallation a owl:Class .
hpc:hasdate a owl:DatatypeProperty ;
    rdfs:domain hpc:Fullinstallation ;
    rdfs:range xsd:date .

hpc:ispatched a owl:ObjectProperty ;
    rdfs:domain hpc:Fullinstallation ;
    rdfs:range hpc:Patch .

hpc:Patch a owl:Class ;
    rdfs:subClassOf hpc:Fullinstallation .

hpc:hasfixnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Patch .

hpc:hasbuildnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Patch .

hpc:isfileversioninfo a owl:ObjectProperty ;
    rdfs:domain hpc:Fullinstallation ;
    rdfs:range hpc:Fileversioninfo .

hpc:Fileversioninfo a owl:Class .

hpc:hasproductname a owl:DatatypeProperty ;
    rdfs:domain hpc:Fileversioninfo .

hpc:hasproductversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Fileversioninfo .

hpc:hasbinarytype a owl:DatatypeProperty ;
    rdfs:domain hpc:Fileversioninfo .

hpc:Binarytype a owl:Class .

hpc:hasbuildnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Binarytype .

hpc:hasbuilddate a owl:DatatypeProperty ;
    rdfs:domain hpc:Binarytype .

hpc:isupdatedbinary a owl:ObjectProperty ;
    rdfs:domain hpc:Binarytype ;
    rdfs:range hpc:Update .

hpc:Update a owl:Class .

hpc:hasnotes a owl:DatatypeProperty ;
    rdfs:domain hpc:Update .

hpc:hasdateinstalled a owl:DatatypeProperty ;
    rdfs:domain hpc:Update .
