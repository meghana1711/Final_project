hpc:Task a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty hpc:taskSubmittedFrom ;
                                          rdfs:domain hpc:Task ] ] ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:taskSubmittedBy ;
                       rdfs:domain hpc:Task ] ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty hpc:printUsage ;
                                          rdfs:domain hpc:Task ] ] ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty hpc:printLSFVersion ;
                                          rdfs:domain hpc:Task ] ] ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty hpc:shortOutput ;
                                          rdfs:domain hpc:Task ] ] ;

hpc:tasksubmittedfrom a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:tasksubmittedby a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:printusage a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;

hpc:printlsfversion a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;

hpc:shortoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range rdf:List ;

hpc:TaskID rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:USER rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:STAT rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:RUN rdf:type hpc:DatatypeProperty ;
    rdfs:range xsd:string ;

hpc:TID rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:host rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;

hpc:project rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Task ;
