@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:Partition a owl:Class.
hpc:User a owl:Class.
hpc:State a owl:EnumeredClass;
    rdfs:subClassOf owl:Class;
    rdf:first rdfs:Literal "PD" ;
    rdf:rest rdf:List ( rdfs:Literal "R" ) .
hpc:Node a owl:Class.
hpc:Nodelist a owl:Class.
hpc:hasjob a owl:ObjectProperty;
    rdfs:domain hpc:Node;
    rdfs:range rdf:List.
hpc
