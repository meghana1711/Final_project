hpc:Targetlogfile a owl:Class ;
    rdfs:comment "Specify the file into which all log files are to be merged. Specify either an absolute or a relative path. The target file cannot be part of the files to be merged.";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "TargetLogFile" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .

hpc:Lsadmin a owl:Class ;
    rdfs:comment "Administrative tool to control LIM and RES daemon operations in LSF.";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Lsadmin" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsadmin ;
    rdfs:range xsd:string ;
    rdfs:label "Synopsis" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsadmin ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .

hpc:subcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsadmin ;
    rdfs:range hpc:Subcommand ;
    rdfs:label "Subcommand" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .

hpc:Ckconfig a owl:Class ;
    rdfs:subClassOf hpc:Subcommand ;
    rdfs:label "ckconfig" ;
    rdfs:isDefinedBy <http://example.org/hpc#> .
