hpc:Pool a owl:Class .
hpc:hasid a owl:ObjectProperty ;
    rdfs:domain hpc:Pool ;
    rdfs:range xsd:string .
hpc:hasquantity a owl:DatatypeProperty ;
    rdfs:domain hpc:Pool ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasgranularity a owl:DatatypeProperty ;
    rdfs:domain hpc:Pool ;
    rdfs:range xsd:nonNegativeInteger .
