hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Valid values for priority are any integers between 1 and the value of the MAX_USER_PRIORITY parameter that is conﬁgured in the lsb.params ﬁle. Job priorities that are not valid are rejected." .

hpc:joborder a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:comment "Job order is the ﬁrst consideration to determine job eligibility for dispatch." .

hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Job priorities that are assigned by LSF administrators and queue administrators can be beyond MAX_USER_PRIORITY for any jobs in the queue." .

hpc:Jobeligibility a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Jobs are still subject to all scheduling policies regardless of job priority." .

hpc:Jobscheduling a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Jobs are scheduled based ﬁrst on their queue priority ﬁrst, then job priority, and lastly in ﬁrst-come ﬁrst-served order." .

hpc:Jobpriorityescalation a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "User-assigned job priority can be conﬁgured with automatic job priority escalation to automatically increase the priority of jobs that are pending for a specified period (JOB_PRIORITY_OVER_TIME in lsb.params)." .

hpc:Apsscheduling a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling ;
    rdfs:comment "When absolute priority scheduling is conﬁgured in the submission queue (the APS_PRIORITY parameter in the lsb.queues ﬁle), the user-assigned job priority is used for the JPRIORITY factor in the APS calculation." .

hpc:Relaxedjobdispatch a owl:Class ;
    rdfs:subClassOf hpc:Jobscheduling ;
    rdfs:comment "If the RELAX_JOB_DISPATCH_ORDER parameter in the lsb.params ﬁle is enabled, which allows LSF to deviate from standard job prioritization policies, LSF might break the job dispatch order as speciﬁed by the user priority." .

hpc:Datastaging a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Speciﬁes the options for direct data staging (for example, IBM CAST burst buffer)." .
