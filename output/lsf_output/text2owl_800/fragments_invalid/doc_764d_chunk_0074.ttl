hpc:Lsfjob a owl:Class .
hpc:Queueadministrator a owl:Class .
hpc:Jobpriorityescalation a owl:Class .
hpc:jobpriorityovertime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpriorityescalation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:maxuserpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Executioncluster .
hpc:JobPriority prop
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:QueuePriority prop
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:FirstComeFirstServedOrder prop
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
hpc:Jobeligibility a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Executioncluster a owl:Class .
hpc:Submissioncluster a owl:Class .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Executioncluster .
hpc:lsfjobpriorityescalation a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Jobpriorityescalation .
hpc:lsfjobpriorityovertime a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Jobpriorityovertime .
hpc:lsfjobpriorityescalationeffective a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Lsfjob .
hpc:btop a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue .
hpc:bbot a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue .
