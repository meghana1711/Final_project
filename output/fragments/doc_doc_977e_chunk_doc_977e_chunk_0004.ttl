hpc:PartitionName rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:Flags rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:Licenses rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .
hpc:BurstBuffer rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:decimal .
