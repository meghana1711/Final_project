hpc:Applicationprofile a owl:Class .
hpc:total a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:integer .

hpc:suspendedtasks a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:integer .

hpc:longoutputformat a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Longoutputformat .

hpc:ssuspsuspendedtasks a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:integer .

hpc:ssuspsuspendedbylsf a owl:ObjectProperty ;
    rdfs:domain hpc:Ssuspsuspendedtasks .

hpc:ssuspsuspendedbyjobsubmitter a owl:ObjectProperty ;
    rdfs:domain hpc:Ssuspsuspendedtasks .

hpc:rsv a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:integer .

hpc:envVars a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:Namevaluepair a owl:Class .

hpc:cgroupCpuSharesFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:Applicationspecificenvironmentvariable a owl:Class ;
    rdfs:subClassOf hpc:Namevaluepair .

hpc:Fixpack15 a owl:Class .
hpc:administratorscanuse a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack15 ;
    rdfs:range hpc:CgroupCpuSharesFactor .

hpc:Linuxcgroupinterface a owl:Class .
hpc:v1 a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroupinterface .

hpc:v2 a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroupinterface .

hpc:cpushares a owl:DatatypeProperty ;
    rdfs:domain hpc:Linuxcgroupinterface .

hpc:cpuweight a owl:DatatypeProperty ;
    rdfs:domain hpc:Linuxcgroupinterface .
