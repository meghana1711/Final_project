hpc:Job a owl:Class .
hpc:pendingreason a owl:ObjectProperty .
hpc:combinedresourcerequirement a owl:ObjectProperty .
hpc:effectiveresourcerequirement a owl:ObjectProperty .
hpc:resourcerequirementstring a owl:DatatypeProperty .
hpc:schedulerdispatchdecision a owl:ObjectProperty .
hpc:joballocation a owl:ObjectProperty .
hpc:jobdispatch a owl:ObjectProperty .
hpc:resourceusage a owl:ObjectProperty .
hpc:Rusage a owl:Class .
hpc:Simpleeffectiveresourcerequirement a owl:Class .
hpc:Compoundeffectiveresourcerequirement a owl:Class .
hpc:Alternativeeffectiveresourcerequirement a owl:Class .
hpc:modifyjobresourcerequirement a owl:ObjectProperty .
hpc:bswitchModifyRusage a owl:ObjectProperty .
hpc:JobFinish a owl:Class .
hpc:jobFinishEventrecord a owl:ObjectProperty .
hpc:Lsbacctfile a owl:Class .
hpc:Lsbstreamfile a owl:Class .
hpc:resourcerequirementdetails a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Pendingreason rdfs:domain hpc:Job ;
    rdfs:range rdf:String .
hpc:Combinedresourcerequirement rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Effectiveresourcerequirement rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Resourcerequirementstring rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Schedulerdispatchdecision rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Joballocation rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Jobdispatch rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Resourceusage rdfs:domain hpc:Rusage ;
    rdfs:range rdf:Resource .
hpc:Rusage rdfs:subClassOf owl:Class .
hpc:Simpleeffectiveresourcerequirement rdfs:subClassOf hpc:Effectiveresourcerequirement ;
    rdfs:domain xsd:string .
hpc:Compoundeffectiveresourcerequirement rdfs:subClassOf hpc:Effectiveresourcerequirement ;
    rdfs:domain rdf:Resource .
hpc:Alternativeeffectiveresourcerequirement rdfs:subClassOf hpc:Effectiveresourcerequirement ;
    rdfs:domain rdf:Resource .
hpc:Modifyjobresourcerequirement rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:BswitchModifyRusage rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:JobFinish rdfs:subClassOf owl:Class .
hpc:JOB_FINISH_Event
