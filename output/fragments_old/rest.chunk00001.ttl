hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a owl:Class .

hpc:RESTAPIDaemon a owl:Class .
hpc:slurmrestd a hpc:RESTAPIDaemon .

hpc:Stateless a owl:ObjectProperty .
hpc:RunMode a owl:EnumClass .
hpc:InetServiceMode a hpc:RunMode .
hpc:ListeningMode a hpc:RunMode .
hpc:Configuration a owl:ObjectProperty .
hpc:Plugins a owl:ObjectProperty .
hpc:HighAvailability a owl:ObjectProperty .
hpc:Security a owl:ObjectProperty .
hpc:JSONWebTokenAuthentication a owl:ObjectProperty .

hpc:InetServiceMode rdfs:subClassOf hpc:RunMode .
hpc:ListeningMode rdfs:subClassOf hpc:RunMode .

hpc:slurmrestd rdfs:subClassOf hpc:RESTAPIDaemon .

hpc:Stateless rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:boolean .

hpc:RunMode rdfs:domain hpc:RESTAPIDaemon .

hpc:InetServiceMode rdfs:subPropertyOf hpc:RunMode ;
    rdfs:range xsd:boolean .

hpc:ListeningMode rdfs:subPropertyOf hpc:RunMode ;
    rdfs:range xsd:boolean .

hpc:Configuration rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:anyURI .

hpc:Plugins rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:anyURI .

hpc:HighAvailability rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:boolean .

hpc:Security rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:boolean .

hpc:JSONWebTokenAuthentication rdfs:domain hpc:RESTAPIDaemon ;
    rdfs:range xsd:boolean .
