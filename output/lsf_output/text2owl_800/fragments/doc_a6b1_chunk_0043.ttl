hpc:Remotetask a owl:Class .
hpc:requiresfile a owl:ObjectProperty .
hpc:Requiresfile rdfs:domain hpc:Remotetask ;
                  rdfs:range hpc:File .

hpc:File a owl:Class .

hpc:Samenameaccesserror a owl:Class .
hpc:Samenameaccesserror rdfs:subClassOf hpc:Error .

hpc:Nfs a owl:Class .
hpc:Nfs rdfs:subClassOf hpc:Sharedfilesystem .

hpc:nfsmounttable a owl:ObjectProperty .
hpc:Nfsmounttable rdfs:domain hpc:Nfs ;
                rdfs:range hpc:Mounttable .

hpc:Automount a owl:Class .
hpc:Automount rdfs:subClassOf hpc:Sharedfilesystem .

hpc:automountmapping a owl:ObjectProperty .
hpc:Automountmapping rdfs:domain hpc:Automount ;
                rdfs:range hpc:Mapping .

hpc:automountmappedunder a owl:DatatypeProperty .
hpc:Automountmappedunder rdfs:domain hpc:Automount ;
                rdfs:range xsd:string .

hpc:uncpath a owl:DatatypeProperty .
hpc:Uncpath rdfs:domain hpc:Fileaccessmethod ;
            rdfs:range xsd:string .

hpc:Fileaccessmethod a owl:Class .

hpc:Nonsharedfilesystem a owl:Class .

hpc:Windowsfilesharing a owl:Class .
hpc:Windowsfilesharing rdfs:subClassOf hpc:Sharedfilesystem .

hpc:Windowsserver a owl:Class .
hpc:Windowsserver rdfs:subClassOf hpc:Server .

hpc:Windowsclient a owl:Class .
hpc:Windowsclient rdfs:subClassOf hpc:Client .

hpc:share a owl:ObjectProperty .
hpc:Share rdfs:domain hpc:Windowsserver ;
          rdfs:range hpc:Share .

hpc:accessviaunc a owl:ObjectProperty .
hpc:Accessviaunc rdfs:domain hpc:File ;
                rdfs:range hpc:Fileaccessmethod .

hpc:accessviadrive a owl:ObjectProperty .
hpc:Accessviadrive rdfs:domain hpc:File ;
                rdfs:range hpc:Fileaccessmethod .

hpc:Server a owl:Class .
hpc:Client a owl:Class .
hpc:File a owl:Class .
hpc:Error a owl:Class .
