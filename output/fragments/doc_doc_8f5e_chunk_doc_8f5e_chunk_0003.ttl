hpc:Site a owl:Class .
hpc:PreReleaseVersion a owl:Class .
hpc:Upgrade a owl:Class .
hpc:MinorUpgrade rdf:type hpc:Upgrade ;
    rdfs:subClassOf hpc:Upgrade .
hpc:MajorUpgrade rdf:type hpc:Upgrade ;
    rdfs:subClassOf hpc:Upgrade .
hpc:RevertingUpgrade a owl:ObjectProperty .
hpc:RevertingUpgrade rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:Site .
hpc:Supported rdf:type owl:ObjectProperty .
hpc:Supported rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:PreReleaseVersion .
hpc:NotSupported rdf:type owl:ObjectProperty .
hpc:NotSupported rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:SlurmDaemon .
hpc:Started rdf:type owl:ObjectProperty .
hpc:Started rdfs:domain hpc:SlurmDaemon .
hpc:StateFile rdf:type owl:DatatypeProperty .
hpc:StateFile rdfs:domain hpc:SlurmDaemon .
hpc:Database rdf:type owl:DatatypeProperty .
hpc:Database rdfs:domain hpc:SlurmDaemon .
hpc:LossOrCorruption rdf:type owl:ObjectProperty .
hpc:LossOrCorruption rdfs:domain hpc:SlurmDaemon .
hpc:RefuseToStart rdf:type owl:ObjectProperty .
hpc:RefuseToStart rdfs:domain hpc:SlurmDaemon .
hpc:PossibleDataLoss rdf:type owl:ObjectProperty .
hpc:PossibleDataLoss rdfs:domain hpc:SlurmDaemon .
hpc:RecoveryTool rdf:type owl:Class .
hpc:Backup rdf:type hpc:RecoveryTool .
hpc:DiskImage rdf:type hpc:RecoveryTool .
hpc:Snapshot rdf:type hpc:RecoveryTool .
hpc:StateSaveLocation rdf:type owl:DatatypeProperty .
hpc:StateSaveLocation rdfs:domain hpc:SlurmDaemon .
hpc:AccountingDatabase rdf:type owl:DatatypeProperty .
hpc:AccountingDatabase rdfs:domain hpc:SlurmDaemon .
hpc:RevertComponents rdf:type owl:ObjectProperty .
hpc:RevertComponents rdfs:domain hpc:RecoveryTool .
hpc:PrepareCluster rdf:type owl:ObjectProperty .
hpc:PrepareCluster rdfs:domain hpc:Site .
hpc:CreateBackups rdf:type owl:ObjectProperty .
hpc:CreateBackups rdfs:domain hpc:PrepareCluster .
hpc:UpgradeSlurmdbd rdf:type owl:ObjectProperty .
hpc:UpgradeSlurmdbd rdfs:domain hpc:PrepareCluster .
hpc:UpgradeSlurmctld rdf:type owl:ObjectProperty .
hpc:UpgradeSlurmctld rdfs:domain hpc
