@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LSB_BUSERS_FORMAT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:LSB_BJOBS_FORMAT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:ask_hosts_field
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Field .

hpc:Field
    a owl:Class .

hpc:bjobs_o_command
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Commandoption .

hpc:bsub_m_command
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Commandoption .

hpc:datachk_option
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Commandoption .

hpc:data_command
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Commandoption .

hpc:Cache_Refresh_Interval
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDatamanagerConfigParameter ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LSF_DATA_BSUB_CHKSUM
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConfParameter ;
    rdfs:range xsd:string .

hpc:dm_stagein_transfer_script
    a owl:Class .

hpc:dm_stagein_transfer_script_sh
    a owl:NamedIndividual ;
    rdf:type hpc:dm_stagein_transfer_script ;
    rdf:value "dm_stagein_transfer.sh" .
