hpc:Account a owl:Class .
hpc:Parentaccount a owl:Class .
hpc:fairsharefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:float .
hpc:rparent a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:float .
hpc:Depthoblivious a owl:Class ;
    rdfs:subClassOf hpc:Account .
hpc:hasbonusmalus a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Fairsharefactor .
hpc:kepttoone a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:boolean .
hpc:Depthoblivious a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       owl:intersectionOf ( hpc:Account
                                             hpc:haspriorityflags [ a owl:ObjectProperty ;
                                                                     rdfs:range xsd:string ;
                                                                     owl:onProperty hpc:PriorityFlags ;
                                                                     owl:someValuesFrom ( hpc:DEPTH_OBLIVIOUS ) ] ) ] .
hpc:prioritytype a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
