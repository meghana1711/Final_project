hpc:LsfLicenseScheduler a owl:Class .
hpc:ManagementHost a owl:Class .
hpc:LicenseServer a owl:Class .
hpc:Cluster a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Feature a owl:Class .

hpc:hasport a owl:ObjectProperty .
hpc:hashost a owl:ObjectProperty .
hpc:hasadmin a owl:ObjectProperty .
hpc:hasstatinterval a owl:DatatypeProperty .
hpc:statpath a owl:DatatypeProperty .
hpc:isclustermode a owl:DatatypeProperty .

hpc:manageslicense a owl:ObjectProperty .
hpc:provideslicense a owl:ObjectProperty .
hpc:usescluster a owl:ObjectProperty .

hpc:LsfLicenseScheduler rdfs:subClassOf owl:Class .
hpc:ManagementHost rdfs:subClassOf hpc:LsfLicenseScheduler .
hpc:LicenseServer rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Servicedomain rdfs:subClassOf hpc:LsfLicenseScheduler .
hpc:Feature rdfs:subClassOf hpc:LsfLicenseScheduler .

hpc:Hasport rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:integer .
hpc:Hashost rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range hpc:ManagementHost .
hpc:Hasadmin rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:string .
hpc:Hasstatinterval rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Statpath rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:string .
hpc:Isclustermode rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:string .

hpc:Manageslicense rdfs:domain hpc:ManagementHost ;
    rdfs:range hpc:LicenseServer .
hpc:Provideslicense rdfs:domain hpc:LicenseServer ;
    rdfs:range hpc:Feature .
hpc:Usescluster rdfs:domain hpc:Feature ;
    rdfs:range hpc:Cluster .

hpc:LSFManagementHost a hpc:Management_Host
