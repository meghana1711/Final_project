hpc:Mixedcluster a owl:Class .
hpc:Singlecluster a owl:Class .
hpc:Windowsonlycluster a owl:Class .
hpc:Unixhost a owl:Class .
hpc:Windowshost a owl:Class .
hpc:Job a owl:Class .
hpc:executiondomain a owl:ObjectProperty .
hpc:submissiondomain a owl:ObjectProperty .
hpc:executionhost a owl:ObjectProperty .
hpc:jobsubmission a owl:ObjectProperty .
hpc:jobexecution a owl:ObjectProperty .
hpc:Windowsaccount a owl:Class .
hpc:Unixaccount a owl:Class .
hpc:Domain a owl:Class .
hpc:accountmapping a owl:ObjectProperty .
hpc:preferredexecutiondomain a owl:DatatypeProperty .
hpc:trustrelationship a owl:ObjectProperty .
hpc:validaccount a owl:DatatypeProperty .
hpc:uniformusernamespace a owl:ObjectProperty .
hpc:Windowsdomain a owl:Class .
hpc:Singlewindowsdomain a owl:Class .
hpc:Multiplewindowsdomains a owl:Class .

hpc:Mixedcluster rdfs:subClassOf owl:Class .
hpc:Singlecluster rdfs:subClassOf owl:Class .
hpc:Windowsonlycluster rdfs:subClassOf owl:Class .
hpc:Unixhost rdfs:subClassOf owl:Class .
hpc:Windowshost rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .
hpc:Executiondomain rdfs:domain hpc:Job ;
                          rdfs:range hpc:Executionhost .
hpc:Submissiondomain rdfs:domain hpc:Job ;
                          rdfs:range hpc:Windowsaccount .
hpc:Executionhost rdfs:domain hpc:Jobexecution .
hpc:Jobsubmission rdfs:domain hpc:Job ;
                   rdfs:range hpc:Unixhost .
hpc:Jobexecution rdfs:domain hpc:Job .
hpc:Windowsaccount rdfs:subClassOf owl:Class .
hpc:Unixaccount rdfs:subClassOf owl:Class .
hpc:Domain rdfs:subClassOf owl:Class .
hpc:Accountmapping rdfs:domain hpc:Mixedcluster ;
                      rdfs:range hpc:Windowsaccount, hpc:Unixaccount .
hpc:Preferredexecutiondomain rdfs:domain hpc:Job ;
                              rdfs:range xsd:string .
hpc:Trustrelationship rdfs:domain hpc:Mixedcluster ;
                         rdfs:range hpc:Submissiondomain .
hpc:Validaccount rdfs:domain hpc:Executionhost ;
                   rdfs:range xsd:boolean .
hpc:Uniformusernamespace rdfs:domain hpc:Mixedcluster ;
                          rdfs:range xsd:boolean .
hpc:Windowsdomain rdfs:subClassOf hpc:Domain .
hpc:Singlewindowsdomain rdfs:subClassOf hpc:Windowsdomain .
hpc:MultipleWindowsDomains rdfs:sub
