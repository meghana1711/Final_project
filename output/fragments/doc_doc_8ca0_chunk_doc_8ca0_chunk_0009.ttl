hpc:ExclusiveUser a owl:Class .
hpc:OverSubscribe a owl:Class .
hpc:Node a owl:Class .

hpc:hasExclusiveUser a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:boolean .

hpc:hasOverSubscribe a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:ResumeTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:ResumeTimeoutDefault a xsd:integer ;
    hpc:value "60" .

hpc:SuspendTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:SuspendTimeInfinite a xsd:integer ;
    hpc:value "INFINITE" .

hpc:SuspendProgram a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range rdf:Resource .

hpc:SuspendTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:SuspendTimeoutDefault a xsd:integer ;
    hpc:value "30" .
```
