hpc:Host a owl:Class .
hpc:hasmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:haspus a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hassocket a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Socket .
hpc:hascore a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Core .
hpc:hascpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:hasoperatingsystem a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:haslibrary a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:supportsenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Environment .

hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:core a owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Socket a owl:Class .
hpc:socket a owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Environment a owl:Class .
hpc:Environment "Intel Xeon Phi co-processors" rdfs:label "Intel Xeon Phi co-processors" .
hpc:Environment "Intel Many Integrated Core Architecture, or MIC, co-processors" rdfs:label "Intel Many Integrated Core Architecture, or MIC, co-processors" .
hpc:Environment "CUDA 4.0 to CUDA 8.0 and later" rdfs:label "CUDA 4.0 to CUDA 8.0 and later" .
hpc:Environment "Linux x64" rdfs:label "Linux x64" .

hpc:hostB a hpc:Host ;
    hpc:hasMemory "2G" ;
    hpc:hasCPU "Intel Pentium 4 CPU" ;
    hpc:hasSocket 1 ;
    hpc:hasCore (1 0) ;
    hpc:hasPUs (2 0) .

hpc:hostC a hpc:Host ;
    hpc:hasMemory "4G" ;
    hpc:hasCPU "Intel Itanium CPU" ;
    hpc:hasPUs 2 .

hpc:hostD a hpc:Host ;
    hpc:hasMemory "1009M" ;
    hpc:hasSocket 1 ;
    hpc:hasLibrary "hwloc" ;
    hpc:hasOperatingSystem "RedH
