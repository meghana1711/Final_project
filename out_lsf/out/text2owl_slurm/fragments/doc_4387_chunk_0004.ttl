hpc:Slurmdbd a owl:Class .
hpc:User a owl:Class .
hpc:Accounting a owl:Class .
hpc:Authentication a owl:Class .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:consistentname a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User .
hpc:consistentid a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:Slurmuser a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:Administrator a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:accountrecordaccess a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Accounting .
hpc:passwdfile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .
hpc:Mungeauthentication a owl:Class ;
    rdfs:subClassOf hpc:Authentication .
hpc:mungekey a owl:DatatypeProperty ;
    rdfs:domain hpc:Mungeauthentication ;
    rdfs:range xsd:string .
hpc:localdomainsocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .
