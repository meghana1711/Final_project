                                       rdfs:domain hpc:SlurmVersion25_05 ;
                                       rdfs:range xsd:boolean .

hpc:sacctmgrDumpLoadQOSes a owl:ObjectProperty ;
                           rdfs:domain hpc:SlurmVersion25_05 ;
                           rdfs:range rdf:Resource .

hpc:slurmrestdTLSEncryption a owl:ObjectProperty ;
                            rdfs:domain hpc:SlurmVersion25_05 ;
                            rdfs:range xsd:boolean .

hpc:srunWaitForChildren a owl:ObjectProperty ;
                        rdfs:domain hpc:SlurmVersion25_05 ;
                        rdfs:range xsd:boolean .

hpc:topologyBlockGaps a owl:ObjectProperty ;
                      rdfs:domain hpc:SlurmVersion25_05 ;
