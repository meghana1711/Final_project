hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is waiting to be executed." .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is currently being executed." .

hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is temporarily halted but not yet completed." .

hpc:Modifiablerunningjob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob ;
    rdfs:comment "A running job that can be modified." .

# Object Properties
hpc:hasshelllimits a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job has default shell limits." .

hpc:hasestimatedruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job has an estimated run time." .

hpc:canbemodified a owl:ObjectProperty ;
    rdfs:domain hpc:Modifiablerunningjob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job can be modified." .

hpc:hascpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Modifiablerunningjob ;
    rdfs:range xsd:duration ;
    rdfs:comment "Indicates the CPU limit for a running job." .

hpc:hasmemorylimit a owl:ObjectProperty ;
    rdfs:domain hpc:Modifiablerunningjob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Indicates the memory limit for a running job." .

hpc:isrerunnable a owl:ObjectProperty ;
    rdfs:domain hpc:Modifiablerunningjob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job can be rerun." .

hpc:hasresourcerequirements a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "Indicates the resource requirements for a job." .

hpc:hasrunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Modifiablerunningjob ;
    rdfs:range xsd:duration ;
    rdfs:comment "Indicates the run limit for a running job." .

hpc:hasswaplimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Indicates the swap limit for a job." .
