hpc:Globalresource a owl:Class .
hpc:Numericresource a owl:Class .
hpc:resourcemap a owl:ObjectProperty .
hpc:resourcename a owl:DatatypeProperty .
hpc:location a owl:ObjectProperty .
hpc:resourcevalue a owl:DatatypeProperty .
hpc:Resourcevalue rdfs:domain hpc:Numericresource ;
                    rdfs:range xsd:decimal .
hpc:Location rdfs:domain hpc:Globalresource ;
               rdfs:range xsd:string .
hpc:Resourcemap rdfs:domain hpc:Globalresource ;
               rdfs:range rdf:List .
hpc:List a owl:Class ;
          rdfs:subClassOf xsd:nonNegativeInteger .
hpc:List rdf:first rdf:List ;
             rdf:rest rdf:List .
hpc:List rdf:first rdf:PropertyValue ;
             rdf:rest rdf:List .
hpc:propertyvalue a owl:DatatypeProperty .
hpc:Propertyvalue rdfs:domain rdf:List ;
                 rdfs:range xsd:string .
hpc:Resourcename rdfs:range xsd:string .
