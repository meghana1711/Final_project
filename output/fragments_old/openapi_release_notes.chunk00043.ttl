hpc:Slurm a owl:Class .
hpc:Version a owl:Class .
hpc:DataParser a owl:Class .
hpc:OpenAPI a owl:Class .
hpc:Reservation a owl:Class .

hpc:hasVersion rdfs:domain Slurm ;
    rdfs:range Version .

hpc:hasDataParser rdfs:domain DataParser ;
    rdfs:range Slurm .

hpc:hasOpenAPI rdfs:domain OpenAPI ;
    rdfs:range Slurm .

hpc:hasRelease rdfs:domain Version ;
    rdfs:range xsd:string .

hpc:hasMajorVersion rdfs:domain Version ;
    rdfs:range xsd:integer .

hpc:hasMinorVersion rdfs:domain Version ;
    rdfs:range xsd:integer .

hpc:hasMicroVersion rdfs:domain Version ;
    rdfs:range xsd:integer .

hpc:hasPlugin rdfs:domain DataParser ;
    rdfs:range xsd:string .

hpc:hasFlags rdfs:domain DataParser ;
    rdfs:range xsd:string .

hpc:hasFlag rdfs:domain DataParser ;
    rdfs:range xsd:string .

hpc:hasOpenAPIList rdfs:domain OpenAPI ;
    rdfs:range xsd:string .

hpc:JobStateRequest a owl:Class .
hpc:JobId a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStateRequest ;
    rdfs:range xsd:string .

hpc:ReservationRequest a owl:Class .
hpc:ReservationDescription a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationRequest ;
    rdfs:range xsd:string .

hpc:ReservationModificationResponse a owl:Class .
```
