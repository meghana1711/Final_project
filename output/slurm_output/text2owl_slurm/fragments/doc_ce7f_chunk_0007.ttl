hpc:Loginnode a owl:Class .
hpc:Slurmdbddaemon a owl:Class .
hpc:Databasemachine a owl:Class .
hpc:Controllermachine a owl:Class .
hpc:Accountingsupport a owl:Class .
hpc:Slurmrestnode a owl:Class .
hpc:Slurmrestddaemon a owl:Class .
hpc:slurmclientcommand a owl:ObjectProperty .
hpc:slurmconffile a owl:ObjectProperty .
hpc:authenticationmethod a owl:ObjectProperty .
hpc:Authslurmauthentication a owl:Class .
hpc:Configlessmode a owl:Class .
hpc:slurmdconfiguration a owl:ObjectProperty .
hpc:restdrunmode a owl:DatatypeProperty .
hpc:UnixServiceRunMode a xsd:string .
hpc:InetServiceRunMode a xsd:string .
hpc:Loginnode rdfs:subClassOf hpc:Computingresource .
hpc:Slurmdbddaemon rdfs:subClassOf hpc:Daemon .
hpc:Databasemachine rdfs:subClassOf hpc:Machine .
hpc:Controllermachine rdfs:subClassOf hpc:Machine .
hpc:Accountingsupport rdfs:subClassOf hpc:Clusterfeature .
hpc:Slurmrestnode rdfs:subClassOf hpc:Machine .
hpc:Slurmrestddaemon rdfs:subClassOf hpc:Daemon .
hpc:Slurmclientcommand rdfs:domain hpc:Loginnode ;
                             rdfs:range rdf:Resource .
hpc:Slurmconffile rdfs:domain hpc:Loginnode ;
                             rdfs:range rdf:Resource .
hpc:Authenticationmethod rdfs:domain hpc:Loginnode ;
                             rdfs:range rdf:Resource .
hpc:Authslurmauthentication rdfs:subClassOf hpc:Authenticationmethod .
hpc:Configlessmode rdfs:subClassOf hpc:Loginnode .
hpc:Slurmdconfiguration rdfs:domain hpc:Configlessmode ;
                             rdfs:range rdf:Resource .
hpc:Restdrunmode rdfs:domain hpc:Slurmrestddaemon ;
                             rdfs:range xsd:string .
