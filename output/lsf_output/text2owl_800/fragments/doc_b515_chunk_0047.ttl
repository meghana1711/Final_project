hpc:hostlimitperjob a owl:DatatypeProperty .
hpc:Hostlimitperjob rdfs:domain hpc:Job .
hpc:Hostlimitperjob rdfs:range xsd:integer .

hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf rdf:Resource .

hpc:hashostlimit a owl:ObjectProperty .
hpc:Hashostlimit rdfs:domain hpc:Job .
hpc:Hashostlimit rdfs:range xsd:integer .

hpc:Compoundresourcerequirement a owl:Class .
hpc:Compoundresourcerequirement rdfs:subClassOf rdf:Resource .

hpc:hasminimumhosts a owl:DatatypeProperty .
hpc:Hasminimumhosts rdfs:domain hpc:Compoundresourcerequirement .
hpc:Hasminimumhosts rdfs:range xsd:nonNegativeInteger .

hpc:Paralleljob a owl:Class .
hpc:Paralleljob rdfs:subClassOf hpc:Job .

hpc:hasspan a owl:ObjectProperty .
hpc:Hasspan rdfs:domain hpc:Paralleljob .
hpc:Hasspan rdfs:range hpc:Resourcerequirement .

hpc:Resourcerequirement a owl:Class .
hpc:Resourcerequirement rdfs:subClassOf rdf:Resource .

hpc:ptile a owl:ObjectProperty .
hpc:Ptile rdfs:domain hpc:Resourcerequirement .
hpc:Ptile rdfs:range xsd:nonNegativeInteger .

hpc:ProcessorsPerHost a owl:NamedIndividual .
hpc:ProcessorsPerHost rdf:type hpc:Ptile .
hpc:ProcessorsPerHost rdf:value "1"^^xsd:nonNegativeInteger .

hpc:UnknownResourceRequirement a owl:NamedIndividual .
hpc:UnknownResourceRequirement rdf:type hpc:ResourceRequirement .
hpc:Unknownresourcerequirement hpc:hasminimumhosts "1"^^xsd:nonNegativeInteger .
