@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Cluster a owl:Class .
hpc:GpdCluster a owl:Class .
hpc:lsbGpdCluster a owl:DatatypeProperty .
hpc:lsbGpdPort a owl:DatatypeProperty .

hpc:Globalfairsharepolicy a owl:Class .
hpc:policyname a owl:ObjectProperty .
hpc:participants a owl:ObjectProperty .
hpc:syncmode a owl:DatatypeProperty .

hpc:Queue a owl:Class .
hpc:HighioQueue a owl:Class .
hpc:schedulingpolicies a owl:DatatypeProperty .

hpc:Usershare a owl:Class .
hpc:usershares a owl:DatatypeProperty .
hpc:shareinfofor a owl:DatatypeProperty .
hpc:usergroupsharepriority a owl:DatatypeProperty .
hpc:started a owl:DatatypeProperty .
hpc:reserved a owl:DatatypeProperty .
hpc:cpuTime a owl:DatatypeProperty .
hpc:runTime a owl:DatatypeProperty .
hpc:adjust a owl:DatatypeProperty .
hpc:remoteLoad a owl:DatatypeProperty .

hpc:Org a owl:Class .
hpc:HighioOrgs a owl:Class .

hpc:Project a owl:Class .
hpc:ProjectA a owl:Class .

hpc:User a owl:Class .
hpc:User1 a owl:Class .

hpc:gpolicyd a owl:DatatypeProperty .
hpc:cluster a owl:DatatypeProperty .
hpc:host a owl:DatatypeProperty .

hpc:bgpinfo a owl:ObjectProperty .
hpc:status a owl:ObjectProperty .
hpc:conf a owl:ObjectProperty .
hpc:fsload a owl:ObjectProperty .

hpc:bqueues a owl:ObjectProperty .
hpc:rl a owl:ObjectProperty .

hpc:Xsd:string rdfs:domain hpc:LsbGpdCluster ;
                  rdfs:domain hpc:LsbGpdPort ;
                  rdfs:domain hpc:Policyname ;
                  rdfs:domain hpc:Participants ;
                  rdfs:domain hpc:Sync
