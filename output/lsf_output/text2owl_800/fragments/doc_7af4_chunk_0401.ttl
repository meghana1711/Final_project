hpc:Job a owl:Class .
hpc:Checkpointablejob a owl:Class .
hpc:checkpointdirectory a owl:DatatypeProperty .
hpc:checkpointperiod a owl:DatatypeProperty .
hpc:Checkpointdirectory rdfs:domain hpc:Checkpointablejob .
hpc:Checkpointperiod rdfs:domain hpc:Checkpointablejob .
hpc:Checkpointdirectory rdfs:range xsd:string .
hpc:Checkpointperiod rdfs:range xsd:nonNegativeInteger .
hpc:checkpointableinqueue a owl:ObjectProperty .
hpc:checkpointableinapplicationprofile a owl:ObjectProperty .
hpc:checkpointableinjob a owl:ObjectProperty .
hpc:Checkpointableinsendjobqueue rdfs:subClassOf hpc:Checkpointableinqueue .
hpc:Checkpointableinreceivejobqueue rdfs:subClassOf hpc:Checkpointableinqueue .
hpc:Checkpointableinapplicationprofile rdfs:subClassOf hpc:Checkpointableinqueue .
hpc:Checkpointableinmulticlusterjob rdfs:subClassOf hpc:Checkpointablejob .
hpc:CheckpointDirectoryInMulticlusterJob rdfs:subPropertyOf hpc:CheckpointableInMulticlusterJob .
hpc:CheckpointPeriodInMulticlusterJob rdfs:subPropertyOf hpc:CheckpointableInMulticlusterJob .
hpc:Checkpointingnotsupportedonleasedhost rdfs:subClassOf hpc:Job .
hpc:CheckpointDirectoryLengthLimit rdfs:subPropertyOf hpc:CheckpointDirectory .
hpc:CheckpointPeriodLimit rdfs:subPropertyOf hpc:CheckpointPeriod .
hpc:CheckpointDirectoryLengthLimitForUnixAndLinux rdfs:subPropertyOf hpc:CheckpointDirectoryLengthLimit .
hpc:CheckpointDirectoryLengthLimitForUnixAndLinux rdf:value "4000" .
hpc:CheckpointDirectoryLengthLimitForWindows rdfs:subPropertyOf hpc:CheckpointDirectoryLengthLimit .
hpc:CheckpointDirectoryLengthLimitForWindows rdf:value "255" .
