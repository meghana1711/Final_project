hpc:LSB_RC_UPDATE_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Update interval in seconds." .

hpc:MQTT_BROKER_HOST
    a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string ;
    rdfs:comment "Host name for the MQTT message broker." .

hpc:MQTT_BROKER_PORT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "TCP port for the MQTT message broker." .
