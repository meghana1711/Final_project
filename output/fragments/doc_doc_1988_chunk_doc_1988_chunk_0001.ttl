hpc:allocatesResourcesTo rdfs:range hpc:Partition .
hpc:improvesResponsiveness a rdfs:subPropertyOf rdf:type .
hpc:improvesUtilization a rdfs:subPropertyOf rdf:type .
hpc:allowsMoreJobsToBeginRunning a rdfs:subPropertyOf rdf:type .
hpc:reducesWaitingTimeForShorterJobs a rdfs:subPropertyOf rdf:type .
hpc:improvesThroughput a rdfs:subPropertyOf rdf:type .
hpc:providesOpportunitiesForLocalBackfilling a rdfs:subPropertyOf rdf:type .
hpc:worksOnEachPartitionIndependently a rdfs:subPropertyOf rdf:type .
hpc:suspendsNewJobUntilSchedulerTimesliceElapses a rdfs:subPropertyOf rdf:type .
hpc:suspendsRunningJob a rdfs:subPropertyOf rdf:type .
hpc:letsNewJobUseResources a rdfs:subPropertyOf rdf:type .
hpc:terminatesOneOfTheJobs a rdfs:subPropertyOf rdf:type .
hpc:excludesFromGangSchedulingOperations a rdfs:subPropertyOf rdf:type .
