hpc:GrpSubmitJobs
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:hasJob ;
                       owl:hasValue xsd:nonNegativeInteger ;
                       owl:maxCardinality 1 ] ;
    rdfs:comment "The total number of jobs able to be submitted to the system at any given time from a QOS. If this limit is reached, new submission requests will be denied until previous jobs complete from this group." .

hpc:GrpTRES
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:usesTRES ;
                       owl:hasValue xsd:nonNegativeInteger ] ;
    rdfs:comment "The total count of TRES able to be used at any given time from jobs running from a QOS." .

hpc:GrpTRESMins
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:usesTRES ;
                       owl:hasValue xsd:nonNegativeInteger ;
                       owl:maxCardinality 1 ;
                       rdfs:subPropertyOf hpc:GrpTRES ] ;
    rdfs:comment "The total number of TRES minutes that can possibly be used by past, present and future jobs running from a QOS. If any limit is reached, all running jobs with that TRES in this group will be killed, and no new jobs will be allowed to run. This usage is decayed (at a rate of PriorityDecayHalfLife). It can also be reset (according to PriorityUsageResetPeriod) in order to allow jobs to run against the QOS again. QOS that have the NoDecay flag set do not decay GrpTRESMins, see QOS Options for details." .

hpc:GrpTRESRunMins
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:usesTRES ;
                       owl:hasValue xsd:nonNegativeInteger ;
                       owl:maxCardinality 1 ;
                       rdfs:subPropertyOf hpc:GrpTRES ] ;
    rdfs:comment "Used to limit the combined total number of TRES minutes used by all jobs running with a QOS. This takes into consideration the time limit of running jobs and consumes it." .

hpc:hasJob
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grpsubmitjobs ;
    rdfs:range hpc:Job .

hpc:usesTRES
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grptres ;
    rdfs:range xsd:nonNegativeInteger .
