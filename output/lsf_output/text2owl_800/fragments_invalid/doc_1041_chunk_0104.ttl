hpc:Job a owl:Class .
hpc:Job a rdfs:subClassOf owl:NamedIndividual .

hpc:Jobcgroup a owl:Class .
hpc:Jobcgroup rdfs:subClassOf owl:NamedIndividual .

hpc:Jobcontainer a owl:Class .
hpc:Jobcontainer rdfs:subClassOf owl:NamedIndividual .

hpc:Taskcontainer a owl:Class .
hpc:Taskcontainer rdfs:subClassOf owl:NamedIndividual .

hpc:Jobsubmissionuser a owl:Class .
hpc:Jobsubmissionuser rdfs:subClassOf owl:NamedIndividual .

hpc:Starterorcontextuser a owl:Class .
hpc:Starterorcontextuser rdfs:subClassOf owl:NamedIndividual .

hpc:battach a owl:ObjectProperty .
hpc:Battach rdfs:domain hpc:Job .
hpc:Battach rdfs:range hpc:Jobcgroup .

hpc:dockerexec a owl:ObjectProperty .
hpc:Dockerexec rdfs:domain hpc:Jobcgroup .
hpc:Dockerexec rdfs:range hpc:Jobcontainer .

hpc:attachtotaskcontainer a owl:ObjectProperty .
hpc:Attachtotaskcontainer rdfs:domain hpc:Battach .
hpc:Attachtotaskcontainer rdfs:range hpc:Taskcontainer .

hpc:hasowner a owl:ObjectProperty .
hpc:Hasowner rdfs:domain hpc:Jobcgroup .
hpc:Hasowner rdfs:range hpc:Jobsubmissionuser .

hpc:hasownerinprofile a owl:ObjectProperty .
hpc:Hasownerinprofile rdfs:domain hpc:Jobcgroup .
hpc:Hasownerinprofile rdfs:range hpc:Starterorcontextuser .

hpc:JobType rdf:type owl:DatatypeProperty .
hpc:Jobtype rdfs:domain hpc:Job .
hpc:Jobtype rdfs:range xsd:string .

hpc:ExecutionHost rdf:type owl:DatatypeProperty .
hpc:Executionhost rdfs:domain hpc:Jobcgroup .
hpc:Executionhost rdfs:range xsd:string .

hpc:TaskID rdf:type owl:DatatypeProperty .
hpc:Taskid rdfs:domain hpc:Taskcontainer .
hpc:Taskid rdfs:range xsd:integer .

hpc:JobContainerID rdf:type owl:DatatypeProperty .
hpc:Jobcontainerid rdfs:domain hpc:Jobcontainer .
hpc:Jobcontainerid rdfs:range xsd:string .
