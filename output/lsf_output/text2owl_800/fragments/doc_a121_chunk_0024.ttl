hpc:Pendtime a owl:Class .
hpc:ependtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendtime ;
    rdfs:range xsd:duration .
hpc:ipendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendtime ;
    rdfs:range xsd:duration .
hpc:estimatedSimStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:effectivePlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendtimelimit ;
    rdfs:range xsd:duration .
hpc:plimitRemain a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendtimelimit ;
    rdfs:range xsd:duration .
hpc:pendingTimeRemaining a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendtime ;
    rdfs:range xsd:duration .
hpc:effectiveEplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Eligiblependtimelimit ;
    rdfs:range xsd:duration .
hpc:eplimitRemain a owl:DatatypeProperty ;
    rdfs:domain hpc:Eligiblependtimelimit ;
    rdfs:range xsd:duration .
hpc:Job a owl:Class .
hpc:Eligiblependtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Pendtimelimit .
hpc:Ineligiblependtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Pendtimelimit .
