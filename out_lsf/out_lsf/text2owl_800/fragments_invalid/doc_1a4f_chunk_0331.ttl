hpc:Resourcemap a owl:Class .
hpc:Resourcemap rdfs:subClassOf owl:Class .

hpc:Globalresource a owl:Class .
hpc:Globalresource rdfs:subClassOf owl:Class .
hpc:Staticglobalresource rdfs:subClassOf hpc:Globalresource .
hpc:Dynamicglobalresource rdfs:subClassOf hpc:Globalresource .

hpc:hasinitialvalue a owl:ObjectProperty .
hpc:Hasinitialvalue rdfs:domain hpc:Staticglobalresource ;
                      rdfs:range xsd:anyURI .

hpc:sharedwithallclusters a owl:ObjectProperty .
hpc:Sharedwithallclusters rdfs:domain hpc:Globalresource ;
                           rdfs:range xsd:boolean .

hpc:Resourcemap hpc:hasstaticresource hpc:StaticGlobalResource .
hpc:Resourcemap hpc:hasdynamicresource hpc:DynamicGlobalResource .

hpc:StaticGlobalResource rdf:ID RESOURCENAME ;
                             hpc:hasInitialValue resource_value@[all] .

hpc:DynamicGlobalResource rdf:ID RESOURCENAME .
