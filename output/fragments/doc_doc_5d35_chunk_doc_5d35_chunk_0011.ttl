hpc:HeterogeneousJob a owl:Class .
hpc:BackfillSchedulerPlugin hpc:schedules hpc:HeterogeneousJob .

hpc:FifoSchedulingLogic a owl:Class .
hpc:FifoSchedulingLogic hpc:schedules hpc:Job .

hpc:HeterogeneousJobStep a owl:Class .
hpc:HeterogeneousJobStep rdfs:subClassOf hpc:JobStep .
hpc:HeterogeneousJobStep rdfs:domain hpc:HeterogeneousJob .

hpc:GangScheduling rdfs:domain hpc:Job .
hpc:SlurmPerlAPIs rdfs:domain hpc:PerlAPI .
hpc:SlurmPerlAPIs hpc:doesNotSupport hpc:HeterogeneousJob .

hpc:SrunMultiProgOption a owl:ObjectProperty .
hpc:SrunMultiProgOption rdfs:domain hpc:SrunCommand .
hpc:SrunMultiProgOption rdfs:range xsd:integer .
hpc:SrunMultiProgOption xsd:minInclusive "1" .
hpc:SrunMultiProgOption xsd:maxInclusive "1" .
hpc:SrunMultiProgOption owl:inverseOf hpc:hasSrunMultiProgOption .

hpc:SrunOpenMode a owl:ObjectProperty .
hpc:SrunOpenMode rdfs:domain hpc:SrunCommand .
hpc:SrunOpenMode rdfs:range xsd:string .
hpc:SrunOpenMode rdfs:default "append" .

hpc:CommunicationPorts a owl:Class .
hpc:CommunicationPorts rdfs:subClassOf hpc:Resource .
hpc:CommunicationPorts rdfs:domain hpc:MPIJob .

hpc:AncientMPI a owl:Class .
hpc:AncientMPI rdfs:subClassOf hpc:MPIJob .
hpc:AncientMPI rdfs:subClassOf hpc:Job .
hpc:AncientMPI rdfs:subClassOf hpc:CommunicationPortsDependentJob .

hpc:CommunicationPortsDependentJob a owl:Class .
hpc:CommunicationPortsDependentJob rdfs:subClassOf hpc:Job .
hpc:CommunicationPortsDependentJob rdfs:domain hpc:Job .

hpc:StepLaunchFailure a owl:Class .
hpc:StepLaunchFailure rdfs:subClassOf hpc:JobFailure .
hpc:StepLaunchFailure rdfs:domain hpc:JobStep .

hpc:HeterogeneousStepJobAllocation a owl:Class .
hpc:HeterogeneousStepJobAllocation rdfs:subClassOf hpc:JobAllocation .
hpc:HeterogeneousStepJobAllocation rdfs:domain hpc:HeterogeneousJob .

hpc:HeterogeneousStep rdfs:subClassOf hpc:JobStep .
hpc:HeterogeneousStep rdfs:domain hpc:HeterogeneousJobStepAllocation .
hpc:HeterogeneousStep rdfs:range hpc:HeterogeneousJobStep .
