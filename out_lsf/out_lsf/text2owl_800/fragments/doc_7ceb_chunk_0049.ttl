hpc:Lsfserver a owl:Class .
hpc:Errorlog a owl:Class .
hpc:Logfile a owl:Class .
hpc:Primaryadmin a owl:Class .
hpc:lsfLogdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range rdf:Resource .
hpc:logdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range rdf:Resource .
hpc:ownedby a owl:ObjectProperty ;
    rdfs:domain hpc:Logdirectory ;
    rdfs:range hpc:Primaryadmin .
hpc:writableby a owl:ObjectProperty ;
    rdfs:domain hpc:Logdirectory ;
    rdfs:range xsd:string .
hpc:errorlogsin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range rdf:List .
hpc:logfileinerror a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range hpc:Logfile .
hpc:limLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:resLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:pimLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:mbatchdLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:mbschdLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:sbatchdLog a hpc:LogFile ;
    hpc:LogFileInError true .
hpc:vemkdLog a hpc:LogFile ;
    hpc:LogFileInError true .
