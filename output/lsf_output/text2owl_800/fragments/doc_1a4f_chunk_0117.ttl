hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:Host a owl:Class .
hpc:Plannedallocation a owl:Class .
hpc:Configuredlimit a owl:Class .
hpc:reservation a owl:ObjectProperty .
hpc:Hasresource rdfs:domain hpc:Job ;
                   rdfs:range hpc:Resource .
hpc:Hasplannedallocation rdfs:domain hpc:Job ;
                        rdfs:range hpc:Plannedallocation .
hpc:Hasconfiguredlimit rdfs:domain hpc:Resource ;
                      rdfs:range hpc:Configuredlimit .
hpc:sticky a owl:ObjectProperty .
hpc:Issticky rdfs:domain hpc:Plannedallocation ;
             rdfs:range xsd:boolean .
hpc:canceled a owl:ObjectProperty .
hpc:Wasmodifiedbyjob rdfs:domain hpc:Plannedallocation ;
               rdfs:range hpc:Job .
hpc:Nolongerusablehost rdfs:domain hpc:Plannedallocation ;
                    rdfs:range hpc:Host .
hpc:Doesnotsatisfyjobrequirements rdfs:domain hpc:Plannedallocation ;
                              rdfs:range hpc:Host .
hpc:Plannedallocationcanceledreason a owl:Class .
hpc:JobModification rdf:type hpc:PlannedAllocationCanceledReason .
hpc:HostUnusability rdf:type hpc:PlannedAllocationCanceledReason .
hpc:HostLoadThresholdExceeded rdf:type hpc:HostUnusability .
hpc:LSFDaemonsDown rdf:type hpc:HostUnusability .
hpc:HostNoLongerSatisfiesJobRequirements rdf:type hpc:PlannedAllocationCanceledReason .
hpc:SelectRequirement rdf:type hpc:JobRequirement .
hpc:Jobrequirement a owl:Class .
