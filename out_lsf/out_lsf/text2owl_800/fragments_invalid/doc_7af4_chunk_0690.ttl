hpc:Validfilename a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:characters ;
                        owl:hasValue "_" ;
                        owl:allValuesFrom xsd:string ] .

hpc:Reservedfilename a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:name ;
                        owl:hasValue "esub.user" ;
                        owl:allValuesFrom xsd:string ] .

hpc:Parentesub a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:name ;
                        owl:hasValue mesub ;
                        owl:someValuesFrom xsd:string ] .

hpc:Esubprogram a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:location ;
                        owl:hasValue LSF_SERVERDIR ;
                        owl:allValuesFrom xsd:string ] .

hpc:Esubconflict a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:method ;
                        owl:hasValue xsd:string ;
                        owl:allValuesFrom hpc:ParallelJobHandling ] .

hpc:Defaultesub a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:applied ;
                        owl:hasValue false ;
                        owl:allValuesFrom xsd:boolean ] .

hpc:lsbEsubSingleQuote a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:string .

hpc:lsbSubProjectNameEnclosed a owl:ObjectProperty ;
    rdfs:domain hpc:Esubprocess ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasParameter .
