hpc:ArrayJob a owl:Class .
hpc:ArrayTask a owl:Class .

hpc:ArrayJobId rdf:type owl:ObjectProperty .
hpc:ArrayTaskId rdf:type owl:ObjectProperty .
hpc:JobId rdf:type owl:DatatypeProperty .

hpc:ArrayJob rdfs:subClassOf [ a owl:Class ;
                                 rdfs:subClassOf owl:Thing ;
                                 rdfs:comment "Represents a job array in HPC." ] .

hpc:ArrayTask rdfs:subClassOf [ a owl:Class ;
                                   rdfs:subClassOf owl:Thing ;
                                   rdfs:comment "Represents a task within a job array in HPC." ] .

hpc:ArrayJobId rdfs:domain hpc:ArrayJob ;
              rdfs:range xsd:string ;
              rdfs:comment "The unique identifier for the job array." .

hpc:ArrayTaskId rdfs:domain hpc:ArrayTask ;
               rdfs:range xsd:string ;
               rdfs:comment "The unique identifier for a task within a job array." .

hpc:JobId rdfs:domain hpc:ArrayTask ;
         rdfs:range xsd:string ;
         rdfs:comment "The unique identifier for a job, assigned as tasks are started." .
```
