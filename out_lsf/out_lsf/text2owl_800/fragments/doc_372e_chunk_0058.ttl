hpc:Elifexpression a owl:Class ;
    rdfs:subClassOf hpc:Expression .

hpc:Ifstatement a owl:Class ;
    rdfs:subClassOf hpc:Elifexpression ;
    rdfs:subClassOf hpc:Statement .

hpc:Elsestatement a owl:Class ;
    rdfs:subClassOf hpc:Statement .

hpc:Endifstatement a owl:Class ;
    rdfs:subClassOf hpc:Statement .

hpc:Timebasedconfiguration a owl:Class .

hpc:Timebasedconfigurationfile a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Configurationcheckprocedure a owl:Class ;
    rdfs:subClassOf hpc:Procedure .

hpc:Restartprocedure a owl:Class ;
    rdfs:subClassOf hpc:Procedure .

hpc:Verifyconfigurationprocedure a owl:Class ;
    rdfs:subClassOf hpc:Procedure .

hpc:Timebasedconfigurationverificationprocedure a owl:Class ;
    rdfs:subClassOf hpc:Verifyconfigurationprocedure .

hpc:bladminckconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Configurationcheckprocedure ;
    rdfs:range hpc:Command .

hpc:bctrldrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Restartprocedure ;
    rdfs:range hpc:Command .

hpc:bladminrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Restartprocedure ;
    rdfs:range hpc:Command .

hpc:blinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Verifyconfigurationprocedure ;
    rdfs:range hpc:Command .

hpc:blstat a owl:ObjectProperty ;
    rdfs:domain hpc:Verifyconfigurationprocedure ;
    rdfs:range hpc:Command .

hpc:timebasedexpression a owl:DatatypeProperty ;
    rdfs:domain hpc:Ifstatement ;
    rdfs:range xsd:time .

hpc:elsepart a owl:ObjectProperty ;
    rdfs:domain hpc:Ifstatement ;
    rdfs:range hpc:Statement .

hpc:endifpart a owl:ObjectProperty ;
    rdfs:domain hpc:Ifstatement ;
    rdfs:range hpc:Statement .
