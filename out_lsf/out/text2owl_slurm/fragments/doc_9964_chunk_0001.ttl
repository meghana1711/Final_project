hpc:Wckey a owl:Class .
hpc:accountingstorageenforce a owl:ObjectProperty .
hpc:trackwckey a owl:ObjectProperty .
hpc:Slurmconf a owl:Class .
hpc:Slurmdbdconf a owl:Class .
hpc:Submittingtool a owl:Class .
hpc:sbatchWckey a owl:DatatypeProperty .
hpc:sallocWckey a owl:DatatypeProperty .
hpc:slurmWckey a owl:DatatypeProperty .
hpc:userdefaultwckey a owl:DatatypeProperty .
hpc:Accountingrecord a owl:Class .
hpc:Wckeyappendedwithasterisk a owl:Class .
hpc:Sacct a owl:Class .
hpc:format a owl:ObjectProperty .
hpc:wckeys a owl:DatatypeProperty .
hpc:viewwckey a owl:ObjectProperty .
hpc:singleoutjobsbywckey a owl:ObjectProperty .

hpc:Wckey rdfs:subClassOf xsd:string .
hpc:Accountingstorageenforce rdfs:domain hpc:Slurmconf ;
                                 rdfs:range hpc:Wckey .
hpc:Trackwckey rdfs:domain (hpc:Slurmconf rdf:or hpc:Slurmdbdconf) ;
                                 rdfs:range hpc:Wckey .
hpc:Submittingtool rdfs:subClassOf xsd:string .
hpc:SbatchWckey rdfs:domain hpc:Submittingtool ;
                                 rdfs:range hpc:Wckey .
hpc:SallocWckey rdfs:domain hpc:Submittingtool ;
                                 rdfs:range hpc:Wckey .
hpc:SlurmWckey rdfs:domain hpc:Submittingtool ;
                                 rdfs:range hpc:Wckey .
hpc:Userdefaultwckey rdfs:domain hpc:User ;
                                 rdfs:range hpc:Wckey .
hpc:Accountingrecord rdfs:subClassOf hpc:Wckey .
hpc:Wckeyappendedwithasterisk rdfs:subClassOf hpc:Accountingrecord .
hpc:Sacct rdfs:subClassOf xsd:string .
hpc:Format rdfs:domain hpc:Sacct ;
                               rdfs:range xsd:string .
hpc:Wckeys rdfs:domain hpc:Sacct ;
                               rdfs:range xsd:string .
hpc:Viewwckey rdfs:domain hpc:Sacct ;
                               rdfs:range hpc:Wckey .
hpc:Singleoutjobsbywckey rdfs:domain hpc:Sacct ;
                               rdfs:range xsd:string .
