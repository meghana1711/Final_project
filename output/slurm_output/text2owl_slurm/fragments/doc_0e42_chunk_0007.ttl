hpc:SLURM_JWT rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmjob ;
    rdfs:range xsd:string ;
    rdfs:comment "The JWT token for the SLURM job." .

hpc:SLURMJob rdf:type owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:unset rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmjob ;
    rdfs:range owl:Nothing ;
    rdfs:comment "Clears the specified SLURM job property." .
