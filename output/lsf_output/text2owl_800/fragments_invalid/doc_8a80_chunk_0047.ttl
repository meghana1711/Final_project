hpc:ENABLE_MINJOB_PREEMPTION
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range xsd:string ;
    rdfs:label "ENABLE_MINJOB_PREEMPTION" ;
    rdfs:comment "Minimizes the overall number of preempted jobs by enabling job list optimization. For example, for a job that requires 10 licenses, License Scheduler preempts one job that uses 10 or more licenses rather than 10 jobs that each use one license." .

hpc:FAST_DISPATCH
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range xsd:string ;
    rdfs:label "FAST_DISPATCH" ;
    rdfs:comment "Enables fast dispatch project mode for the license feature, which increases license utilization for project licenses. Used for project mode only. When enabled, LSF License Scheduler does not have to run lmutil, lmstat, rlmutil, or rlmstat to verify that a license is free before each job dispatch." .

hpc:Feature
    a owl:Class ;
    rdfs:label "Feature" .

hpc:ProjectMode
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:label "ProjectMode" .

hpc:ALLOCATION
    a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Feature ;
    rdfs:label "ALLOCATION" .

hpc:DEMAND_LIMIT
    a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer ;
    rdfs:label "DEMAND_LIMIT" .

hpc:DISTRIBUTION
    a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Distribution ;
    rdfs:label "DISTRIBUTION" .

hpc:GROUP_DISTRIBUTION
    a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Groupdistribution ;
    rdfs:label "GROUP_DISTRIBUTION" .

hpc:LM_LICENSE_NAME
    a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:label "LM_LICENSE_NAME" .

hpc:LS_FEATURE_PERCENTAGE
    a owl:DatatypeProperty ;
    rd
