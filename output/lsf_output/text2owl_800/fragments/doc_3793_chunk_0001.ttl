hpc:Lsfintegrationoncraylinux a owl:Class .
hpc:lsfversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfintegrationoncraylinux ;
    rdfs:range xsd:string .
hpc:lsfversionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:string .
hpc:lsfcraylinuxenvironmentversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfintegrationoncraylinux ;
    rdfs:range xsd:string .
hpc:LSFEdition a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:unionOf ( hpc:LSFStandardEdition hpc:LSFExpressEdition ) .
hpc:Lsfstandardedition a owl:Class ;
    rdf:label "LSF Standard Edition" .
hpc:Lsfexpressedition a owl:Class ;
    rdf:label "LSF Express Edition" .
hpc:Installationpackage a owl:Class .
hpc:installationtarfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationpackage ;
    rdfs:range xsd:string .
hpc:installerpackage a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationpackage ;
    rdfs:range xsd:string .
hpc:spacerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationpackage ;
    rdfs:range xsd:decimal .
hpc:installationprocedure a owl:ObjectProperty .
hpc:Configurationparameters a owl:Class .
hpc:Integrationdirectory a owl:Class .
hpc:Submittingandrunningjobs a owl:Class .
hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf hpc:Submittingandrunningjobs .
hpc:Preemption a owl:Class ;
    rdfs:subClassOf hpc:Submittingandrunningjobs .
hpc:Reservationscheduling a owl:Class ;
    rdfs:subClassOf hpc:Submittingandrunningjobs .
