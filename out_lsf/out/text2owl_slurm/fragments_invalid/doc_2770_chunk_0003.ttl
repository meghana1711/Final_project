hpc:Job a owl:Class.
hpc:Backfillscheduler a owl:Class.
hpc:Jobpartitionpair a owl:Class.

hpc:considersresourcerequirements a owl:ObjectProperty.
hpc:Considersresourcerequirements rdfs:domain hpc:Backfillscheduler; rdfs:range hpc:Job.

hpc:reservesresources a owl:ObjectProperty.
hpc:Reservesresources rdfs:domain hpc:Backfillscheduler; rdfs:range hpc:Node.

hpc:evaluatesjobpartitions a owl:ObjectProperty.
hpc:Evaluatesjobpartitions rdfs:domain hpc:Backfillscheduler; rdfs:range hpc:Jobpartitionpair.

hpc:hasjob a owl:ObjectProperty.
hpc:Hasjob rdfs:domain hpc:Jobpartitionpair; rdfs:range hpc:Job.

hpc:haspartition a owl:ObjectProperty.
hpc:Haspartition rdfs:domain hpc:Jobpartitionpair; rdfs:range hpc:Partition.

hpc:Plannedstate a owl:Class; rdfs:subClassOf hpc:State
