hpc:Cluster a owl:Class .
hpc:LSFCluster a hpc:Cluster .
hpc:Procs a owl:Class .
hpc:Cores a owl:Class .
hpc:Threads a owl:Class .
hpc:ncpusdefinition a owl:ObjectProperty .
hpc:DefaultNcpus rdf:type hpc:NcpusDefinition ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Cores .
hpc:EgoDefineNcpus rdf:type hpc:NcpusDefinition ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Procs .
hpc:ProcsAsCores rdf:type hpc:NcpusDefinition ;
    rdfs:domain hpc:Procs ;
    rdfs:range hpc:Cores .
hpc:ProcsAsThreads rdf:type hdtp:NcpusDefinition ;
    rdfs:domain hpc:Procs ;
    rdfs:range hpc:Threads .
hpc:egolocalresources a owl:ObjectProperty .
hpc:EgoEnabled rdf:type owl:ObjectProperty .
hpc:EgoLocalResourcesPrecedence rdf:type owl:ObjectProperty .
hpc:DynamicHost rdf:type hpc:Host .
hpc:StaticHost rdf:type hpc:Host .
hpc:Host a owl:Class .
