hpc:Resource a owl:Class .
hpc:Reservationusage a owl:Class .
hpc:Reservableresource a owl:Class .
hpc:reservableresourcevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservableresource ;
    rdfs:range xsd:string .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
hpc:Reservation a owl:Class ;
    rdfs:subClassOf hpc:Reservableresource .
hpc:Builtinresource a owl:Class ;
    rdfs:subClassOf hpc:Reservableresource .
hpc:Customresource a owl:Class ;
    rdfs:subClassOf hpc:Reservableresource .
hpc:Globalresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Staticglobalresource a owl:Class ;
    rdfs:subClassOf hpc:Globalresource .
hpc:Dynamicglobalresource a owl:Class ;
    rdfs:subClassOf hpc:Globalresource .
hpc:Resourcesection a owl:Class .
hpc:resourcenamekeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:descriptionkeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:typekeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:intervalkeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:increasingkeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:consumablekeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
hpc:releasekeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcesection .
