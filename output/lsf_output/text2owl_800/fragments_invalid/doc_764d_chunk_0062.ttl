hpc:Scheduler a owl:Class .
hpc:mcPluginScheduleEnhance a owl:DatatypeProperty .
hpc:imptJobbklg a owl:DatatypeProperty .
hpc:enablequeuepreference a owl:ObjectProperty .
hpc:enablejobslotlimit a owl:ObjectProperty .
hpc:Advancereservation a owl:Class .
hpc:Activeadvancereservation a owl:Class .
hpc:Inactiveadvancereservation a owl:Class .
hpc:Samebooleanresourcewithinhostgroups a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Host a owl:Class .
hpc:Booleanresource a owl:Class .
hpc:Samehosttypewithinhostgroups a owl:Class .
hpc:Remotequeuehostgroup a owl:Class .
hpc:remoteresourcescheduling a owl:ObjectProperty .
hpc:preemptablejobscheduling a owl:ObjectProperty .
hpc:Submissioncluster a owl:Class .
hpc:availableslots a owl:DatatypeProperty .
hpc:pendingslots a owl:DatatypeProperty .
hpc:Maximumvalue a owl:Class .
hpc:Negativevalue a owl:Class .
hpc:pendingjoblimit a owl:DatatypeProperty .
hpc:Backfilljobs a owl:Class .

hpc:Scheduler rdfs:subClassOf owl:Class .
hpc:McPluginScheduleEnhance rdfs:domain Scheduler ;
                                      rdfs:range xsd:string .
hpc:ImptJobbklg rdfs:domain Scheduler ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Enablequeuepreference rdfs:domain Scheduler ;
                          rdfs:range Scheduler .
hpc:Enablejobslotlimit rdfs:domain Scheduler ;
                        rdfs:range Scheduler .
hpc:Advancereservation rdfs:subClassOf Scheduler .
hpc:Activeadvancereservation rdfs:subClassOf AdvanceReservation .
hpc:Inactiveadvancereservation rdfs:subClassOf AdvanceReservation .
hpc:Samebooleanresourcewithinhostgroups rdfs:subClassOf Scheduler .
hpc:Hostgroup rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Booleanresource rdfs:subClassOf owl:Class .
hpc:Samehosttypewithinhostgroups rdfs:subClassOf Scheduler .
hpc:Remotequeuehostgroup rdfs:subClassOf Hostgroup .
hpc:Remoteresourcescheduling rdfs:domain Scheduler ;
                             rdfs:range RemoteQueueHostgroup .
hpc:Preemptablejobscheduling rdfs:domain Scheduler ;
                             rdfs:range SubmissionCluster .
hpc:Availableslots rdfs:domain Scheduler ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:Pendingslots rdfs:domain Scheduler ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Max
