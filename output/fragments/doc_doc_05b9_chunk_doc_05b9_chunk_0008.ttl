hpc:QueryParameter a owl:Class .
hpc:PathParameter a owl:Class .
hpc:ReturnType a owl:Class .
hpc:APICall a owl:Class .

hpc:hasQueryParameter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:QueryParameter .

hpc:hasPathParameter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:PathParameter .

hpc:hasReturnType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:ReturnType .

hpc:hasExampleData rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ReturnType ;
    rdfs:range xsd:string .

hpc:hasMediaType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ReturnType ;
    rdfs:range xsd:string .

hpc:hasResponse rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:Response .

hpc:Response a owl:Class .
hpc:hasName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Response ;
    rdfs:range xsd:string .

hpc:hasUpStatus rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range xsd:string .

hpc:hasPathParameterName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PathParameter ;
    rdfs:range xsd:string .

hpc:hasDefaultValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PathParameter ;
    rdfs:range xsd:string .

hpc:hasReturnTypeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ReturnType ;
    rdfs:range xsd:string .

hpc:hasExampleDataContentType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ReturnType ;
    rdfs:range xsd:string .
