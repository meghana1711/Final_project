hpc:Lsfversion a owl:Class .
hpc:Fixpack a owl:Class .

hpc:zbunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:remotehost a owl:ObjectProperty ;
    rdfs:domain hpc:Jobforwardingmodel ;
    rdfs:range xsd:string .

hpc:emailaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Emailnotification ;
    rdfs:range xsd:string ;
    rdfs:maxLength xsd:nonNegativeInteger "511" .

hpc:Csmjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:string ;
    rdfs:maxLength xsd:nonNegativeInteger "511" .

hpc:jobscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:string .

hpc:bestfitallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Allocationalgorithm .

hpc:Allocationalgorithm a owl:Class .

hpc:affinity a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresource ;
    rdfs:range xsd:string .

hpc:Gpuresource a owl:Class .
