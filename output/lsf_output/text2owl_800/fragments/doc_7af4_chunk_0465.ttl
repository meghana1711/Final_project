hpc:Advancereservationjob a owl:Class .
hpc:remotetimeoutlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservationjob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Ignored by the receiving queue. Remote timeout limit never affects advance reservation jobs." .

hpc:maxtotaltimepreempt a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservationjob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the accumulated preemption time after which a job cannot be preempted again." .

hpc:MaxTotalTimePreemptRange a owl:Restriction ;
    rdfs:onProperty hpc:MaxTotalTimePreempt ;
    rdfs:allValuesFrom xsd:nonNegativeInteger ;
    rdfs:minInclusive "1"^^xsd:integer .

hpc:mcforwarddelay a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservationjob ;
    rdfs:range xsd:decimal ;
    rdfs:comment "When using the LSF multicluster capability, specifies the job forwarding behavior and the amount of time after job submission and scheduling for LSF to revert to the default job forwarding behavior." .

hpc:MCForwardDelayRange a owl:Restriction ;
    rdfs:onProperty hpc:MCForwardDelay ;
    rdfs:allValuesFrom xsd:decimal ;
    rdfs:minInclusive "-1"^^xsd:integer .
