hpc:Job a owl:Class .
hpc:ParentJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:ChildJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:Dependencycondition a owl:Class .
hpc:done rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:done ;
                                             owl:hasValue hpc:Job ] ] .
hpc:ended rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:ended ;
                                             owl:hasValue hpc:Job ] ] .
hpc:exit rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:exit ;
                                             owl:hasValue xsd:anyURI ] ] .
hpc:external rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range [ xsd:anyURI , xsd:string ] ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:external ;
                                             owl:hasValue xsd:anyURI ] ] .
hpc:post_done rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:post_done ;
                                             owl:hasValue hpc:Job ] ] .
hpc:post_err rdf:type hpc:DependencyCondition ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             owl:onProperty hpc:post_err ;
                                             owl:hasValue hpc:Job ] ] .
