hpc:AssociationID a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:int32 .

hpc:AccountName a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .

hpc:ClusterName a owl:DatatypeProperty ;
    rdfs:domain (hpc:Cluster OR hpc:ClusterRec) ;
    rdfs:range xsd:string .

hpc:NodeNames a owl:DatatypeProperty ;
    rdfs:domain hpc:ClusterRec ;
    rdfs:range xsd:string .

hpc:SelectPlugin a owl:DatatypeProperty ;
    rdfs:domain hpc:ClusterRec ;
    rdfs:range xsd:string .

hpc:Associations a owl:ObjectProperty ;
    rdfs:domain hpc:ClusterRec ;
    rdfs:range hpc:ClusterRecAssociations .

hpc:RpcVersion a owl:DatatypeProperty ;
    rdfs:domain hpc:ClusterRec ;
    rdfs:range xsd:int32 .

hpc:Tres a owl:Class ;
    rdfs:subClassOf xsd:long .

hpc:Association a owl:Class .
hpc:Account a owl:Class .
hpc:Cluster a owl:Class .
hpc:ClusterRec a owl:Class .
hpc:User a owl:Class .
hpc:ClusterRecAssociations a owl:Class .
```
