hpc:Host a owl:Class .
hpc:HostType rdf:type owl:Class .
hpc:HighSpeedConnectionGroup rdf:type owl:Class .
hpc:ResourceMap rdf:type owl:Class .
hpc:Queue rdf:type owl:Class .
hpc:QueueName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Priority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:Nice rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:ResReq rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirement .
hpc:Resourcerequirement a owl:Class .
hpc:Mem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:decimal .
hpc:Type rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
hpc:Hgconnect rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
hpc:HgconnectType rdf:type owl:Class .
hpc:Hg1 rdf:type hpc:HgconnectType .
hpc:Hg2 rdf:type hpc:HgconnectType .
hpc:Hg3 rdf:type hpc:HgconnectType .
hpc:Same rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Sametype .
hpc:SameType rdf:type owl:Class .
hpc:Description rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:TaskLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Tasklimitspec .
hpc:Tasklimitspec a owl:Class .
hpc:MinimumLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimitspec ;
    rdfs:range xsd:integer .
hpc:DefaultLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimitspec ;
    rdfs:range xsd:integer .
hpc:MaximumLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklimitspec ;
    rdfs:range xsd:integer .
hpc:Bsub rdf:type owl:Class .
hpc:BsubN rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:integer .
