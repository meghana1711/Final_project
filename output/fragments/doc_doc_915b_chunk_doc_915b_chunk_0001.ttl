hpc:TrustedSource a owl:Class .
hpc:HasSharedKey a owl:ObjectProperty ;
    rdfs:domain hpc:TrustedSource ;
    rdfs:range xsd:string .

hpc:MungeAuthentication a owl:Class ;
    rdfs:subClassOf hpc:TrustedSource .

hpc:MungeCredentials a owl:Class .

hpc:HasMungeLibrary a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:boolean .

hpc:Slurm a owl:Class .

hpc:HasMungeKey a owl:ObjectProperty ;
    rdfs:domain hpc:MungeAuthentication ;
    rdfs:range xsd:string .

hpc:MungeKeyFile a owl:Class ;
    rdfs:subClassOf hpc:MungeKey .

hpc:MungeKeyFileOwnedByMunge a owl:DatatypeProperty ;
    rdfs:domain hpc:MungeKeyFile ;
    rdfs:range xsd:string .

hpc:MungeKeyFileReadableOnlyByMunge a owl:DatatypeProperty ;
    rdfs:domain hpc:MungeKeyFile ;
    rdfs:range xsd:boolean .

hpc:MungeServiceRunning a owl:ObjectProperty ;
    rdfs:domain hpc:MungeAuthentication ;
    rdfs:range xsd:boolean .
```
