hpc:Bctrld a owl:Class .
hpc:Bdata a owl:Class .

hpc:hasexitcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Bctrld ;
    rdfs:range xsd:string .

hpc:requiresconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Bdata ;
    rdfs:range xsd:string .

hpc:sudoersconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Bdata ;
    rdfs:range xsd:string .

hpc:Datamanagementsubcommand a owl:Class .
hpc:Datamanager a owl:Class ;
    rdfs:subClassOf hpc:Datamanagementsubcommand .

hpc:Cachequery a owl:Class ;
    rdfs:subClassOf hpc:Datamanagementsubcommand .

hpc:cachesubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagementsubcommand ;
    rdfs:range hpc:Cachequery .

hpc:cacheuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Cachequery ;
    rdfs:range xsd:string .

hpc:cachegroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Cachequery ;
    rdfs:range xsd:string .

hpc:cachecluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Cachequery ;
    rdfs:range xsd:string .

hpc:helpoption a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagementsubcommand ;
    rdfs:range hpc:Helpandversionoption .

hpc:versionoption a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagementsubcommand ;
    rdfs:range hpc:Helpandversionoption .

hpc:Helpandversionoption a owl:Class .

hpc:bhist a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .

hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .

hpc:bmod a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .

hpc:bstage a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .

hpc:lsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Configurationfile .

hpc:lsfdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Helpandversionoption ;
    rdfs:range hpc:Command .
