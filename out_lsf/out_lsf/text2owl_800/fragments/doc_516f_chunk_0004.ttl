hpc:Job a owl:Class .
hpc:Jobstatus a owl:Class .
hpc:Runningjob a owl:Class .
hpc:Pendingjob a owl:Class .

hpc:hasstatus a owl:ObjectProperty .
hpc:hasreason a owl:DatatypeProperty .
hpc:hashost a owl:ObjectProperty .

hpc:Jobstatus rdfs:subClassOf hpc:Job .
hpc:Runningjob rdfs:subClassOf hpc:Jobstatus .
hpc:Pendingjob rdfs:subClassOf hpc:Jobstatus .

hpc:Hasstatus rdfs:domain hpc:Job .
hpc:Hasreason rdfs:domain hpc:Pendingjob .
hpc:Hashost rdfs:domain hpc:Pendingjob .
hpc:Hashost rdfs:range xsd:string .

hpc:PEND a hpc:JobStatus .
hpc:RUN a hpc:JobStatus .
hpc:USUSP a hpc:JobStatus .
hpc:PSUSP a hpc:JobStatus .
hpc:SSUSP a hpc:JobStatus .
hpc:DONE a hpc:JobStatus .
hpc:EXIT a hpc:JobStatus .
