hpc:Jobcheckout a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that checks out tokens for either 201-AppZ or 202-AppZ." .

hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcheckout ;
    rdfs:range xsd:string ;
    rdfs:comment "The rusage string associated with the job." .

hpc:Appz201 a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Represents the AppZ201 in the rusage string." .

hpc:lmremoveinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the minimum time a job must have a license checked out before lmremove or rlmremove can remove the license." .

hpc:lmremovesuspjob a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Enables LSF License Scheduler to use lmremove or rlmremove to remove license features from each recently-suspended job." .
