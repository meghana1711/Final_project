hpc:Prioritytype a owl:Class .
hpc:PriorityDecayHalfLife a xsd:nonNegativeInteger .
hpc:PriorityUsageResetPeriod a xsd:string .
hpc:PriorityFavorSmall a xsd:boolean .
hpc:PriorityMaxAge a xsd:duration .
hpc:PriorityWeightAge a xsd:nonNegativeInteger .
hpc:PriorityWeightFairshare a xsd:nonNegativeInteger .
hpc:PriorityWeightJobSize a xsd:nonNegativeInteger .
hpc:PriorityWeightPartition a xsd:nonNegativeInteger .
hpc:PriorityWeightQOS a xsd:nonNegativeInteger .

hpc:Prioritytype rdfs:subClassOf owl:Class .
hpc:Prioritydecayhalflife rdfs:domain hpc:Prioritytype ;
                           rdfs:range xsd:nonNegativeInteger .
hpc:Priorityusageresetperiod rdfs:domain hpc:Prioritytype ;
                              rdfs:range xsd:string .
hpc:Priorityfavorsmall rdfs:domain hpc:Prioritytype ;
                        rdfs:range xsd:boolean .
hpc:Prioritymaxage rdfs:domain hpc:Prioritytype ;
                   rdfs:range xsd:duration .
hpc:Priorityweightage rdfs:domain hpc:Prioritytype ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightfairshare rdfs:domain hpc:Prioritytype ;
                            rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightjobsize rdfs:domain hpc:Prioritytype ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightpartition rdfs:domain hpc:Prioritytype ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightqos rdfs:domain hpc:Prioritytype ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:PriorityWeightQOS rdf:value 0 .
