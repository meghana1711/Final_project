hpc:AuthenticationProxy a owl:Class .
hpc:UsesPublicKeys a owl:ObjectProperty .
hpc:CloudAuthenticationSystem a owl:Class .
hpc:HasCloudAuthenticationSystem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthenticationProxy ;
    rdfs:range hpc:CloudAuthenticationSystem .

hpc:AmazonCognito a hpc:CloudAuthenticationSystem .
hpc:Keycloak a hpc:CloudAuthenticationSystem .
hpc:Keycloak_StandaloneUse rdf:type hpc:Keycloak ;
    rdfs:comment "Doesn't require a cloud auth solution." .

hpc:JWT a owl:Class .
hpc:HasJWTKey a owl:ObjectProperty .
hpc:JWTKeyFile a owl:DatatypeProperty .
hpc:JWTKeyFile_Location rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JWT .

hpc:SlurmController a owl:Class .
hpc:HasStateSaveLocation a owl:ObjectProperty .
hpc:HasJWTKeyFile a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController .

hpc:Slurmdbd a owl:Class .
hpc:HasJWTKeyFile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:AuthAltTypes a owl:DatatypeProperty .
hpc:AuthAltParameters a owl:DatatypeProperty .
hpc:AuthAltTypes_Value rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range rdf:List .
hpc:AuthAltParameters_Value rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthAltParameters .

hpc:TokenLifespan a owl:DatatypeProperty .
hpc:TokenLifespan_Value rdf:type xsd:integer .

hpc:DisableTokenCreation a owl:DatatypeProperty .

hpc:SLURM_JWT a owl:DatatypeProperty .
hpc:SLURM_JWT_Value rdf:type xsd:string .

hpc:SLURM_JWT_EnvironmentVariable a owl:Class .
hpc:SLURM_JWT_EnvironmentVariable_Value rdf:type owl:DatatypeProperty .

hpc:SlurmRestdDaemon a owl:Class .
hpc:ActivatesAuthAltTypes a owl:ObjectProperty .

hpc:ExternalAuthenticationIntegration a owl:Class .
hpc:UsesJWKS a owl:ObjectProperty .
hpc:UsesRS256Tokens a owl:ObjectProperty .
hpc:JWKS_File a owl:DatatypeProperty .
```
