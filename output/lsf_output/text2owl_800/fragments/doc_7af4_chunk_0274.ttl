hpc:defaultJobCwd a owl:ObjectProperty .
hpc:DefaultJobCwd rdfs:domain hpc:Lsfjob .
hpc:DefaultJobCwd rdfs:range xsd:string .
hpc:DefaultJobCwd rdfs:subClassOf owl:Property .

hpc:Unixpath a owl:Class .
hpc:Windowspath a owl:Class .
hpc:Mixedpath a owl:Class .
hpc:Mixedpath rdfs:subClassOf hpc:Path .

hpc:Unixpath rdfs:subClassOf xsd:string .
hpc:Windowspath rdfs:subClassOf xsd:string .

hpc:MixedPath rdf:type owl:Restriction .
hpc:MixedPath owl:onProperty hpc:DEFAULT_JOB_CWD .
hpc:MixedPath owl:allValuesFrom hpc:Path .
hpc:MixedPath owl:hasValue "|" .

# Cluster-wide job output directory
hpc:defaultJobOutdir a owl:ObjectProperty .
hpc:DefaultJobOutdir rdfs:domain hpc:Lsfjob .
hpc:DefaultJobOutdir rdfs:range hpc:Outputdirectory .
hpc:DefaultJobOutdir rdfs:subClassOf owl:Property .

hpc:Outputdirectory a owl:Class .
hpc:Outputdirectory rdfs:subClassOf xsd:string .

hpc:Dynamicpattern a owl:Class .
hpc:Dynamicpattern rdfs:subClassOf xsd:string .

hpc:jobidpattern a owl:DatatypeProperty .
hpc:Jobidpattern rdfs:domain hpc:Outputdirectory .
hpc:Jobidpattern rdfs:range xsd:string .

hpc:jobgrouppattern a owl:DatatypeProperty .
hpc:Jobgrouppattern rdfs:domain hpc:Outputdirectory .
hpc:Jobgrouppattern rdfs:range xsd:string .

hpc:jobindexpattern a owl:DatatypeProperty .
hpc:Jobindexpattern rdfs:domain hpc:Outputdirectory .
hpc:Jobindexpattern rdfs:range xsd:nonNegativeInteger .
