hpc:Job a owl:Class .
hpc:Producerjob a owl:Class .
hpc:Consumerjob a owl:Class .
hpc:Tag a owl:Class .

# Object Properties
hpc:produces a owl:ObjectProperty .
hpc:consumes a owl:ObjectProperty .
hpc:hastag a owl:ObjectProperty .

# Datatype Properties
hpc:name a owl:DatatypeProperty .
hpc:creator a owl:DatatypeProperty .
hpc:lastupload a owl:DatatypeProperty .
hpc:lastdownload a owl:DatatypeProperty .

# Domain and Range
hpc:Produces rdfs:domain hpc:Producerjob ;
    rdfs:range hpc:Tag .
hpc:Consumes rdfs:domain hpc:Consumerjob ;
    rdfs:range hpc:Tag .
hpc:Hastag rdfs:domain hpc:Job ;
    rdfs:range hpc:Tag .
hpc:Name rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:Creator rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:Lastupload rdfs:domain hpc:Tag ;
    rdfs:range xsd:dateTime .
hpc:Lastdownload rdfs:domain hpc:Tag ;
    rdfs:range xsd:dateTime .
