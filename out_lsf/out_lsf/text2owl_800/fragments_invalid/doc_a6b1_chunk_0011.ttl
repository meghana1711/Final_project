hpc:Host a owl:Class .
hpc:Lsf a owl:Class .
hpc:Perfmon a owl:Class .
hpc:Filedescriptor a owl:Class .
hpc:badminperfmonview a owl:ObjectProperty .
hpc:lsfLogdir a owl:DatatypeProperty .
hpc:LsfLogdir rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Filedescriptorlimit rdfs:subClassOf hpc:Filedescriptor ;
    rdfs:comment "The maximum value on AIX5, 64-bit hosts if the file descriptor limit has never been changed." ;
    owl:hasValue xsd:9223372036854775797 .
hpc:Unixhost a owl:Class .
    rdfs:comment "Applies to UNIX hosts only." .
