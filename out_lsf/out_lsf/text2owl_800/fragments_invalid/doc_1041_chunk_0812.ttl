@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:GpuModel a owl:Class .
hpc:gpuDriver a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuModel ;
    rdfs:range xsd:string .
hpc:gpuFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuModel .
hpc:numaId a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuModel .
hpc:Vendor a owl:Class .
hpc:mig a owl:ObjectProperty ;
    rdfs:domain hpc:GpuModel .
hpc:devid a owl:DatatypeProperty ;
    rdfs:domain hpc:Mig .
hpc:gid a owl:DatatypeProperty ;
    rdfs:domain hpc:Mig .
hpc:instName a owl:DatatypeProperty ;
    rdfs:domain hpc:Mig .
hpc:Files a owl:Class .
hpc:lsid a owl:DatatypeProperty ;
    rdfs:domain hpc:Files .
hpc:Lsid a owl:Class .
