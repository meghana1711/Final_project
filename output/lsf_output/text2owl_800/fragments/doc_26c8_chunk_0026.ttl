hpc:Providername a owl:Class .
hpc:Providername rdfs:subClassOf xsd:string .

hpc:Policyconfig a owl:Class .
hpc:policies a owl:ObjectProperty .

hpc:Defaultvalue a owl:Class .
hpc:Defaultvalue rdfs:subClassOf xsd:string .

hpc:perrcaccount a owl:ObjectProperty .
hpc:Perrcaccount rdfs:domain hpc:Policyconfig .
hpc:Perrcaccount rdfs:range hpc:Providername .
hpc:Perrcaccount rdfs:range rdf:List .

hpc:pertemplatename a owl:ObjectProperty .
hpc:Pertemplatename rdfs:domain hpc:Policyconfig .
hpc:Pertemplatename rdfs:range xsd:string .
hpc:Pertemplatename rdfs:range rdf:List .

hpc:perprovider a owl:ObjectProperty .
hpc:Perprovider rdfs:domain hpc:Policyconfig .
hpc:Perprovider rdfs:range hpc:Providername .
hpc:Perprovider rdfs:range rdf:List .

hpc:maxnumber a owl:DatatypeProperty .
hpc:Maxnumber rdfs:domain hpc:Policyconfig .
hpc:Maxnumber rdfs:range xsd:nonNegativeInteger .

hpc:Consumer a owl:Class .
hpc:Consumer rdfs:subClassOf hpc:Providername .
hpc:Consumer rdfs:subClassOf hpc:Templatename .
hpc:Consumer rdfs:subClassOf hpc:Accountname .
