hpc:Partition "hipri" a hpc:Partition ;
    hpc:PriorityTier 2 ;
    hpc:PreemptMode "preempt/qos" .

hpc:Job "485" a hpc:Job ;
    hpc:SubmittedJob true ;
    hpc:RunningOn ( hpc:Node "n12" ) ;
    hpc:PreemptedBy "490" .

hpc:Job "490" a hpc:Job ;
    hpc:SubmittedJob true ;
    hpc:RunningOn ( hpc:Node "n12" hpc:Node "n13" hpc:Node "n14" ) .
