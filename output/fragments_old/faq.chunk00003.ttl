hpc:Allocation a owl:Class .
hpc:Allocation rdfs:subClassOf owl:Class .

hpc:BaseBoard rdf:type owl:Class .
hpc:Socket rdf:type owl:Class .
hpc:Core rdf:type owl:Class .
hpc:Thread rdf:type owl:Class .

hpc:allocatedBy a owl:ObjectProperty .
hpc:allocatedBy rdfs:domain hpc:SystemAdministrator ;
                 rdfs:range hpc:Allocation .

hpc:hasBaseBoard a owl:ObjectProperty .
hpc:hasBaseBoard rdfs:domain hpc:Allocation ;
                 rdfs:range hpc:BaseBoard .

hpc:hasSocket a owl:ObjectProperty .
hpc:hasSocket rdfs:domain hpc:BaseBoard ;
             rdfs:range hpc:Socket .

hpc:hasCore a owl:ObjectProperty .
hpc:hasCore rdfs:domain hpc:Socket ;
            rdfs:range hpc:Core .

hpc:hasThread a owl:ObjectProperty .
hpc:hasThread rdfs:domain hpc:Core ;
             rdfs:range hpc:Thread .

# Task Distribution
hpc:DistributionMethod a owl:Class .
hpc:DistributionMethod rdfs:subClassOf owl:Class .

hpc:arbitrary a hpc:DistributionMethod .

hpc:taskOn a owl:ObjectProperty .
hpc:taskOn rdfs:domain hpc:DistributionMethod ;
           rdfs:range hpc:Node .

# Node Allocation
hpc:Node a owl:Class .
hpc:Node rdfs:subClassOf owl:Class .

hpc:hasTask a owl:ObjectProperty .
hpc:hasTask rdfs:domain hpc:Node ;
           rdfs:range hpc:Task .

# Task
hpc:Task a owl:Class .
hpc:Task rdfs:subClassOf owl:Class .

hpc:hasID a owl:DatatypeProperty .
hpc:hasID rdfs:domain hpc:Task ;
         rdfs:range xsd:integer .

# Script for Task Layout
hpc:Script a owl:Class .
hpc:Script rdfs:subClassOf owl:Class .

hpc:runsOn a owl:ObjectProperty .
hpc:runsOn rdfs:domain hpc:Script ;
           rdfs:range hpc:Allocation .

# Environment
hpc:Environment a owl:Class .
hpc:Environment rdfs:subClassOf owl:Class .

hpc:propagatedFrom a owl:ObjectProperty .
hpc:propagatedFrom rdfs:domain hpc:Environment ;
               rdfs:range hpc:Allocation .

# Make Command
hpc:MakeCommand a owl:Class .
hpc:MakeCommand rdfs:subClassOf owl:Class .

hpc:utilizesResources a owl:ObjectProperty .
hpc:utilizesResources rdfs:domain hpc:MakeCommand ;
                      rdfs:range hpc
