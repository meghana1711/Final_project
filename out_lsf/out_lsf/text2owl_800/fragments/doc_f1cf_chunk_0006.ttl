hpc:Interactivequeue a owl:Class ;
    rdfs:comment "For interactive jobs only" .

hpc:Idlequeue a owl:Class ;
    rdfs:comment "Running only if the machine is idle and very lightly loaded." .

hpc:hasqueuename a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:hasqueuedescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Interactivequeue rdfs:subClassOf hpc:Queue .
hpc:Idlequeue rdfs:subClassOf hpc:Queue .
