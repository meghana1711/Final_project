hpc:APICall a owl:Class .
hpc:MediaType a owl:Class .
hpc:APIResponse a owl:Class .
hpc:QueryParameter a owl:Class .
hpc:PathParameter a owl:Class .

hpc:hasMediaType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:MediaType .

hpc:hasResponse rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:APIResponse .

hpc:hasQueryParameter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:QueryParameter .

hpc:hasPathParameter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:APICall ;
    rdfs:range hpc:PathParameter .

hpc:APICall_v0_0_43_openapi_instances_resp a hpc:APIResponse ;
    rdf:type owl:Class .

hpc:APICall_v0_0_43_openapi_slurmdbd_jobs_resp a hpc:APIResponse ;
    rdf:type owl:Class .

hpc:QueryParameter_time_end a hpc:QueryParameter ;
    rdf:type owl:Class ;
    rdfs:subClassOf hpc:QueryParameter ;
    rdfs:comment "Time end (UNIX timestamp)" ;
    rdfs:domain hpc:APICall ;
    rdfs:range xsd:integer .

hpc:QueryParameter_time_start a hpc:QueryParameter ;
    rdf:type owl:Class ;
    rdfs:subClassOf hpc:QueryParameter ;
    rdfs:comment "Time start (UNIX timestamp)" ;
    rdfs:domain hpc:APICall ;
    rdfs:range xsd:integer .

hpc:PathParameter_job_id a hpc:PathParameter ;
    rdf:type owl:Class ;
    rdfs:subClassOf hpc:PathParameter ;
    rdfs:comment "Job ID" ;
    rdfs:domain hpc:APICall ;
    rdfs:range xsd:string .
