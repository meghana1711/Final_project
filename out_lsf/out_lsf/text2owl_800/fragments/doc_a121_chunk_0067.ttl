hpc:Directdatastagingjob a owl:Class .
hpc:Lsf a owl:Class .
hpc:Burstbuffer a owl:Class .
hpc:IBMCASTBurstBuffer rdf:type hpc:BurstBuffer ;
    rdfs:comment "A specific type of burst buffer." .

hpc:bsubStage a owl:ObjectProperty ;
    rdfs:domain hpc:Directdatastagingjob ;
    rdfs:range hpc:Stagecommand .

hpc:Stagecommand a owl:Class .
hpc:storagerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Stagecommand ;
    rdfs:range xsd:integer .
hpc:stageinscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Stagecommand ;
    rdfs:range xsd:string .
hpc:stageoutscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Stagecommand ;
    rdfs:range xsd:string .

hpc:lsbStageInExec a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Systemlevelscript .

hpc:lsbStageOutExec a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Systemlevelscript .

hpc:Systemlevelscript a owl:Class .
hpc:setupscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Systemlevelscript ;
    rdfs:range xsd:string .
hpc:cleanupscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Systemlevelscript ;
    rdfs:range xsd:string .

hpc:twolevelstagein a owl:ObjectProperty ;
    rdfs:domain hpc:Directdatastagingjob ;
    rdfs:range hpc:Stageinscript .

hpc:twolevelstageout a owl:ObjectProperty ;
    rdfs:domain hpc:Directdatastagingjob ;
    rdfs:range hpc:Stageoutscript .

hpc:Highperformancelocalstorage a owl:Class ;
    rdfs:subClassOf hpc:Storage .

hpc:Executionhost a owl:Class ;
    rdfs:subClassOf hpc:Computingresource .

hpc:Workload a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:CheckpointRestartWorkload rdf:type hpc:Workload ;
    rdfs:comment "A workload that involves checkpointing and restarting." .
hpc:ScratchVolumeWorkload rdf:type hpc:Workload ;
    rdfs:comment "A workload that requires scratch volume." .
hpc:ExtendedMemoryIOWorkload rdf:type hpc:Workload ;
    rdfs:comment "A workload that requires extended memory I/O." .
