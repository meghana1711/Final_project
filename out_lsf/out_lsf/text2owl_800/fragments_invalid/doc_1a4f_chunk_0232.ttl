hpc:Host a owl:Class .
hpc:status a owl:DatatypeProperty .
hpc:jl a owl:DatatypeProperty .
hpc:u a owl:DatatypeProperty .
hpc:max a owl:DatatypeProperty .
hpc:njobs a owl:DatatypeProperty .
hpc:run a owl:DatatypeProperty .
hpc:ssusp a owl:DatatypeProperty .
hpc:ususp a owl:DatatypeProperty .
hpc:rsv a owl:DatatypeProperty .
hpc:Closed a owl:Class .
hpc:Unavail a owl:Class .
hpc:Ok a owl:Class .
hpc:bsub a owl:ObjectProperty .
hpc:Job a owl:Class .
hpc:Normal a owl:Class .
hpc:Default a owl:Class .
hpc:host a owl:ObjectProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:user a owl:DatatypeProperty .
hpc:queue a owl:DatatypeProperty .
hpc:fromHost a owl:DatatypeProperty .
hpc:jobName a owl:DatatypeProperty .
hpc:submitTime a owl:DatatypeProperty .
hpc:bjobs a owl:ObjectProperty .
hpc:bhosts a owl:ObjectProperty .

hpc:Host rdfs:subClassOf hpc:Hostclass .
hpc:Closed rdfs:subClassOf hpc:Host .
hpc:Unavail rdfs:subClassOf hpc:Host .
hpc:Ok rdfs:subClassOf hpc:Host .

hpc:Status rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Jl rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:U rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Max rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Njobs rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Run rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ssusp rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ususp rdfs:domain hpc:Host ;
    r
