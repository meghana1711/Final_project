hpc:Applicationx a owl:Class .
hpc:Applicationy a owl:Class .

hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Distributionvalue .

hpc:Distributionvalue a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        owl:unionOf (hpc:LicenseServer rdf:First hpc:Cluster rdf:First xsd:nonNegativeInteger ) ] .

hpc:enableinteractive a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters ;
    rdfs:range xsd:boolean .

hpc:allocation a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Allocationvalue .

hpc:Allocationvalue a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        owl:unionOf (hpc:LicenseServer rdf:First rdf:List (hpc:Cluster rdf:First xsd:nonNegativeInteger rdf:First xsd:nonNegativeInteger? ) ) ] .

hpc:Interactivetask a owl:Class ;
    rdfs:subClassOf hpc:Task .

hpc:Cluster a owl:Class .
hpc:Licenseserver a owl:Class .
hpc:Task a owl:Class .
