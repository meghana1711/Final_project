hpc:Advancereservation a owl:Class .
hpc:arStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:integer .
hpc:arEndTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:integer .
hpc:arJobids a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range rdf:List .
hpc:arCreator a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string .
hpc:arOwners a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string .
hpc:Script a owl:Class ;
    rdfs:subClassOf hpc:Advancereservation .
hpc:prescript a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range hpc:Advancereservation .
hpc:postscript a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string .
