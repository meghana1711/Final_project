hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:Lsfjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Customized preemption script job." .

hpc:Interactivetask a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Interactive task submitted with the taskman command." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:clustername a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .

hpc:Displayterminal a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Checkedoutlicense a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Licenseserver a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:portnumber a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                        rdfs:subClassOf hpc:Checkedoutlicense ] ] ;
    rdfs:range xsd:integer .

hpc:tokenname a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                        rdfs:subClassOf hpc:Checkedoutlicense ] ] ;
    rdfs:range xsd:string .

hpc:user a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                        rdfs:subClassOf hpc:Checkedoutlicense ] ] ;
    rdfs:range xsd:string .

hpc:host a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                        rdfs:subClassOf hpc:Checkedoutlicense ] ] ;
    rdfs:range xsd:string .

hpc:display a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                        rdfs:subClassOf hpc:Checkedoutlicense ] ] ;
    rdfs:range xsd:string .

hpc:Licensemanager a owl:Class ;
