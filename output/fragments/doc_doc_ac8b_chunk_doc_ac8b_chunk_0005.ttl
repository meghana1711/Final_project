hpc:QOSFactor a owl:Class .
hpc:hasQOSFactor a owl:ObjectProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:float .

hpc:SiteFactor a owl:Class ;
    rdfs:subClassOf hpc:QOSFactor .

hpc:TRESFactor a owl:Class ;
    rdfs:subClassOf hpc:QOSFactor .

hpc:GlobalTRESFactor a owl:Class ;
    rdfs:subClassOf hpc:TRESFactor .

hpc:LocalTRESFactor a owl:Class ;
    rdfs:subClassOf hpc:TRESFactor .

hpc:TRESType a owl:Class .

hpc:setSiteFactor a owl:ObjectProperty ;
    rdfs:domain hpc:Site ;
    rdfs:range hpc:SiteFactor .

hpc:TRESFactorForJob a owl:ObjectProperty ;
    rdfs:domain hpc:TRESType ;
    rdfs:range hpc:TRESFactor .

hpc:fairShareFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
```
