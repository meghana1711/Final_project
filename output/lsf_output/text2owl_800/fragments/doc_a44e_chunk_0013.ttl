hpc:Lsfdatamanager a owl:Class .
hpc:Parameters a owl:Class .
hpc:Remotedatamanagers a owl:Class .

hpc:admins a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .

hpc:stagingArea a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:fileTransferCmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cacheAccessibleFiles a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cacheAccessControl a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cacheInputGracePeriod a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cacheOutputGracePeriod a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cachePermissions a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:cacheRefreshInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:permissionMask a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:queryNthreads a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
hpc:remoteCacheRefreshInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanagers .
