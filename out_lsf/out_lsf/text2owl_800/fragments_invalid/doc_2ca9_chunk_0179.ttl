hpc:Host a owl:Class .

hpc:hasHostName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hostRange an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:leadingZeroHostName an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:multipleSquareBracketHostName an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:colonusedashypheninhostname a owl:ObjectProperty .
