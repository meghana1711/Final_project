hpc:Limit a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string ;
    rdfs:maxLength 40 .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:integer .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resourceconsumer .

hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Resourceconsumer .

hpc:App a owl:Class ;
hpc:Queue a owl:Class ;
hpc:User a owl:Class ;
hpc:Licenseproject a owl:Class ;

hpc:canConsumeMemory rdf:Property ;
    rdfs:domain [ a owl:Class ;
                    rdfs:subClassOf hpc:Resourceconsumer ] ;
    rdfs:range xsd:integer .

hpc:isPartOfLimit rdf:Property ;
    rdfs:domain hpc:Resourceconsumer ;
    rdfs:range hpc:Limit .
