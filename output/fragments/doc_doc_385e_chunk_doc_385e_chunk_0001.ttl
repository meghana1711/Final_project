hpc:CPU a owl:Class .
hpc:Memory a owl:Class .
hpc:Board a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:CR_CPU hpc:CPU rdf:type owl:ObjectProperty .
hpc:CR_Memory rdf:type owl:ObjectProperty .
hpc:CR_Board rdf:type owl:ObjectProperty .
hpc:CR_Socket rdf:type owl:ObjectProperty .
hpc:CR_Core rdf:type owl:ObjectProperty .
hpc:CR_Socket_Memory rdf:type owl:ObjectProperty .
hpc:CPU rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Memory rdfs:subClassOf xsd:nonNegativeDecimal .
hpc:CR_CPU rdfs:domain hpc:CPU ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:CR_Memory rdfs:domain hpc:Memory ;
                        rdfs:range xsd:nonNegativeDecimal .
hpc:CR_Board rdfs:domain hpc:Board .
hpc:CR_Socket rdfs:domain hpc:Socket .
hpc:CR_Core rdfs:domain hpc:Core .
hpc:CR_Socket_Memory rdfs:domain hpc:Socket ;
                        rdfs:range hpc:Memory .
