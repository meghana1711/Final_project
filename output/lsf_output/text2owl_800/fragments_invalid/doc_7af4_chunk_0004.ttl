hpc:Lsbreasons a owl:Class .
hpc:Lsbresources a owl:Class .
hpc:Lsbserviceclasses a owl:Class .
hpc:Lsbthreshold a owl:Class .
hpc:Lsbusers a owl:Class .
hpc:Lsfacct a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Lsfconf a owl:Class .
hpc:Lsfdatamanager a owl:Class .

hpc:hasResourceConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbresources ;
    rdfs:range hpc:Configurationfile .

hpc:hasThresholdConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbthreshold ;
    rdfs:range hpc:Configurationfile .

hpc:hasUserConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbusers ;
    rdfs:range hpc:Configurationfile .

hpc:isClusterConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Configurationfile .

hpc:isConfFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string .

hpc:isOptional rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Class ;
    rdfs:range xsd:boolean .

hpc:Lsbreasons rdfs:subClassOf hpc:Class .
hpc:Lsbresources rdfs:subClassOf hpc:Class .
hpc:Lsbserviceclasses rdfs:subClassOf hpc:Class .
hpc:Lsbthreshold rdfs:subClassOf hpc:Class .
hpc:Lsbusers rdfs:subClassOf hpc:Class .
hpc:Lsfacct rdfs:subClassOf hpc:Class .
hpc:Lsfcluster rdfs:subClassOf hpc:Class .
hpc:Lsfconf rdfs:subClassOf hpc:Class .
hpc:Lsfdatamanager rdfs:subClassOf hpc:Class .

hpc:LSBReasons rdf:type owl:Class ;
    owl:sameAs hpc:#ResourceAllocationLimits ;
    owl:sameAs hpc:#Exports ;
    owl:sameAs hpc:#ResourceUsageLimits ;
    owl:sameAs hpc:#GuaranteePolicies .

hpc:LsfCluster rdf:type owl:Class ;
    owl:sameAs hpc:#LSFHost .

hpc:LsfConf rdf:type owl:Class ;
    owl:sameAs hpc:#LSFOperation .

hpc:LsfDatamanager rdf:type owl:Class ;
    owl:sameAs hpc:#IBMSpectrumLSFDataManager .
