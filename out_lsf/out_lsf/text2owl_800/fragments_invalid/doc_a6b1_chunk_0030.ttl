hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job in an HPC system." .

hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a resource in an HPC system." .

hpc:hasowner a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User ;
    rdfs:comment "The user who submitted the job." .

hpc:hasproject a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Project ;
    rdfs:comment "The project associated with the job." .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstatus ;
    rdfs:comment "The current status of the job." .

hpc:hasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue ;
    rdfs:comment "The queue where the job is running." .

hpc:hascommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The command executed by the job." .

hpc:hassubmissionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The host from which the job was submitted." .

hpc:hasexecutionhome a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The execution home directory of the job." .

hpc:hasexecutioncwd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The execution current working directory of the job." .

hpc:hasstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when the job started." .

hpc:hasendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when the job ended." .

hpc:hasexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The exit code of the job." .

hpc:hascputimeused a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeDouble ;
    rdfs:comment "The CPU time used by the job." .

hpc:hasterminationreason a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    r
