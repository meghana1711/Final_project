hpc:Cputime a owl:Class .
hpc:Cputimeduringsample rdfs:subClassOf hpc:Cputime .
hpc:Cpuutilization a owl:Class .
hpc:rss a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencyattimeofsample ;
    rdfs:range xsd:decimal .
hpc:vmsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencyattimeofsample ;
    rdfs:range xsd:decimal .
hpc:pages a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencyattimeofsample ;
    rdfs:range xsd:nonNegativeInteger .
hpc:readmegabytes a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencyattimeofsample ;
    rdfs:range xsd:decimal .
hpc:writemegabytes a owl:DatatypeProperty ;
