@base <http://example.org/hpc/>

hpc:Lsfadministrator a owl:Class.
hpc:resrestartaction a owl:ObjectProperty;
    rdfs:domain hpc:Lsfadministrator;
    rdfs:range xsd:string.

hpc:Firstexecutionhost a owl:Class.
hpc:Job a owl:Class;
    rdfs:subClassOf hpc:Firstexecutionhost.

hpc:Task a owl:Class;
    rdfs:subClassOf hpc:Job.

hpc:jobtimedout a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:integer.

hpc:tasksregistered a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:integer.

hpc:djobcommfailaction a owl:ObjectProperty;
    rdfs:domain hpc:Applicationprofile;
    rdfs:range xsd:string.

hpc:Djobcommfailactionvalue a owl:Class;
    rdfs:subClassOf xsd:string.
    hpc:DjobComm
