hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    hpc:hasQOS a owl:ObjectProperty ;
    hpc:canPreempt rdf:Type owl:ObjectProperty ;
    hpc:hasPreemptableQOS rdf:Type owl:ObjectProperty ;
    hpc:hasPreemptExemptTime rdf:Type owl:DatatypeProperty ;
    hpc:hasResourceLimits rdf:Type owl:ObjectProperty ;

hpc:QOS a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    hpc:hasLimits rdf:Type owl:ObjectProperty ;
    hpc:canPreempt rdf:Type owl:ObjectProperty ;
    hpc:preemptExemptTime rdf:Type xsd:duration ;
    hpc:hasOverPartQOS rdf:Type owl:ObjectProperty ;

hpc:PartitionQOS a owl:Class ;
    rdfs:subClassOf hpc:QOS ;
    rdfs:subClassOf owl:Thing ;
    hpc:appliesToPartition rdf:Type owl:ObjectProperty ;
    hpc:overridesJobQOS rdf:Type owl:ObjectProperty ;

hpc:ResourceLimits a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:domain hpc:QOS ;
    rdfs:range rdf:List ;

hpc:PreemptExemptTime rdf:Type xsd:duration ;
hpc:OverPartQOS rdf:Type owl:ObjectProperty ;
```
