hpc:hasAccessRestriction a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmDBD ;
  rdfs:range hpc:AccessRestriction .
hpc:hasConsistentName a owl:ObjectProperty ;
  rdfs:domain hpc:User ;
  rdfs:range xsd:boolean .
hpc:hasConsistentID a owl:ObjectProperty ;
  rdfs:domain hpc:Computer ;
  rdfs:range xsd:boolean .
hpc:supportsPreserveCaseUser a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmDBD ;
  rdfs:range xsd:boolean .
hpc:recommendedAuthentication a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmDBD ;
  rdfs:range xsd:string .
hpc:requiresMUNGE a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmDBD ;
