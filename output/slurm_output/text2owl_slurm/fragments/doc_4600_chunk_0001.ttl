hpc:Jobcontainerplugin a owl:Class ;
  rdfs:subClassOf hpc:Plugin .

hpc:jobcontainertype a owl:ObjectProperty ;
  rdfs:domain hpc:Slurmconfiguration ;
  rdfs:range hpc:Jobcontainerplugin .

hpc:prologflags a owl:ObjectProperty ;
  rdfs:domain hpc:Slurmconfiguration ;
  rdfs:range xsd:string .

hpc:Jobcontainerconf a owl:Class ;
  rdfs:subClassOf hpc:Configurationfile .

hpc:autobasepath a owl:DatatypeProperty ;
  rdfs:domain hpc:Jobcontainerconf ;
  rdfs:range xsd:boolean .

hpc:basepath a owl:DatatypeProperty ;
  rdfs:domain hpc:Jobcontainerconf ;
  rdfs:range xsd:string .

hpc:dirs a owl:DatatypeProperty ;
  rdfs:domain hpc:Jobcontainerconf ;
  rdfs:range xsd:string .
