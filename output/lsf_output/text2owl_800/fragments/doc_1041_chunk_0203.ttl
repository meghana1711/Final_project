hpc:Job a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdf:Resource ] .

# Job Properties
hpc:submittedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:submittedto a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .

hpc:submissiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:dispatchtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:completiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:cwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:numtasks a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:requestedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:effectiveresources a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

# Resource Classes
hpc:Resource a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdf:Resource ] .

hpc:Span a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Rusage a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Affinity a owl:Class ;
    rdfs:subClassOf hpc:Resource .

# Resource Properties
hpc:type a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

hpc:r15s a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:pg a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:nonNegativeDecimal .
