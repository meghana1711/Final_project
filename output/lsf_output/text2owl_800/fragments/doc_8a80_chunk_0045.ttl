hpc:hasDistributionPolicy
    a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string ;
    rdfs:comment "The distribution policy determines how the licenses available in each service domain are distributed among the clients." .

hpc:DistributionPolicy
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A space-separated list with each project name followed by its share assignment." .

hpc:ShareAssignment
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Determines what fraction of available licenses is assigned to each project, in the event of competition between projects." .

hpc:hasProject
    a owl:ObjectProperty ;
    rdfs:domain hpc:Shareassignment ;
    rdfs:range hpc:Project ;
    rdfs:comment "The project name followed by its share assignment." .

hpc:hasShare
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareassignment ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The fraction of available licenses assigned to each project." .

hpc:hasLicensesOwned
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareassignment ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of licenses owned by that project." .

hpc:preempts
    a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Project ;
    rdfs:comment "In the event of competition between projects, projects that own licenses preempt jobs." .
