hpc:Job a owl:Class .
hpc:hasID rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

# Heterogeneous Job
hpc:HeterogeneousJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hetJobID rdf:Property ;
    rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range xsd:string .

hpc:hetJobIDSet rdf:Property ;
    rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range xsd:string .

hpc:hetJobOffset rdf:Property ;
    rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range xsd:nonNegativeInteger .

# Job Component
hpc:JobComponent a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:jobID rdf:Property ;
    rdfs:domain hpc:JobComponent ;
    rdfs:range xsd:string .

# Heterogeneous Job Leader
hpc:HeterogeneousJobLeader a owl:Class ;
    rdfs:subClassOf hpc:HeterogeneousJob .

hpc:hetJobID rdf:Property ;
    rdfs:domain hpc:HeterogeneousJobLeader ;
    rdfs:range xsd:string .

# Burst Buffer
hpc:BurstBuffer a owl:Class .
hpc:isPersistent rdf:Property ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .

hpc:hasJobID rdf:Property ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:string .

# Persistent Burst Buffer
hpc:PersistentBurstBuffer a owl:Class ;
    rdfs:subClassOf hpc:BurstBuffer .

hpc:datawarpPlugin rdf:Property ;
    rdfs:domain hpc:PersistentBurstBuffer ;
    rdfs:range xsd:string .

# Job-specific Burst Buffer
hpc:JobSpecificBurstBuffer a owl:Class ;
    rdfs:subClassOf hpc:BurstBuffer .

hpc:hasDirectives rdf:Property ;
    rdfs:domain hpc:JobSpecificBurstBuffer ;
    rdfs:range xsd:string .
```
