hpc:Job a owl:Class .
hpc:Feature a owl:Class .
hpc:Effectivelicenseproject a owl:Class .
hpc:Projectgrouphierarchy a owl:Class .
hpc:Cluster a owl:Class .
hpc:authorizedproject a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Project .
hpc:shortestpath a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Effectivelicenseproject .
hpc:demandlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project .
hpc:Projectdemand a owl:Class .
hpc:Clusterdemand a owl:Class .
hpc:jobpending a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:jobrusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:hierarchicalgrouppath a owl:ObjectProperty ;
    rdfs:domain hpc:Effectivelicenseproject .
hpc:OthersProject a owl:NamedIndividual .
hpc:projectdemandlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectdemand .
hpc:clusterdemandreport a owl:ObjectProperty ;
    rdfs:domain hpc:Clusterdemand .
hpc:potentialdemand a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterdemand .
hpc:otherresourcesrequired a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterdemand .
hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Effectivelicenseproject .
hpc:Effectivelicenseproject rdfs:subClassOf hpc:Project .
hpc:Cluster rdfs:subClassOf hpc:Authorizedproject .
hpc:Projectgrouphierarchy rdfs:subClassOf hpc:Effectivelicenseproject .
hpc:Projectdemand rdfs:subClassOf hpc:Clusterdemand .
hpc:Clusterdemandreport rdfs:subClassOf hpc:Clusterdemand .
hpc:Effectivelicenseproject rdfs:subClassOf hpc:Project .
hpc:Effectivelicenseproject hpc:Hierarchicalgrouppath rdfs:range hpc:Projectgrouphierarchy .
hpc:Project hpc:Hierarchicalgrouppath rdfs:range xsd:string .
hpc:Effectivelicenseproject hpc:Demandlimit rdfs:range xsd:decimal .
hpc:Clusterdemand hpc:Potentialdemand rdfs:range xsd:decimal .
hpc:Clusterdemand hpc:Otherresourcesrequired rdfs:range xsd:string .
