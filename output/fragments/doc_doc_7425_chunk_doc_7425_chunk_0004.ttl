hpc:JobInfo a owl:Class .
hpc:Rlimit a owl:Class .
hpc:SegmentSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Rlimit ;
    rdfs:range xsd:unsignedShort .
hpc:Shared a owl:EnumeredClass ;
    rdfs:subClassOf hpc:Rlimit ;
    rdfs:subClassOf owl:Class ;
    rdf:type rdfs:Class ;
    rdfs:comment "Shared resource mode" .
hpc:Shared "none" a hpc:Shared ;
    rdfs:comment "No sharing" .
hpc:Shared "oversubscribe" a hpc:Shared ;
    rdfs:comment "Oversubscription allowed" .
hpc:Shared "user" a hpc:Shared ;
    rdfs:comment "User-defined sharing" .
hpc:Shared "mcs" a hpc:Shared ;
    rdfs:comment "MCS (Multi-Cluster Sharing)" .

hpc:Memlock a hpc:Rlimit ;
    rdfs:comment "Locked-in-memory address space" .
hpc:Nofile a hpc:Rlimit ;
    rdfs:comment "Number of open files" .
hpc:Nproc a hpc:Rlimit ;
    rdfs:comment "Number of processes" .
hpc:Rss a hpc:Rlimit ;
    rdfs:comment "Largest resident set size, in bytes" .
hpc:Stack a hpc:Rlimit ;
    rdfs:comment "Maximum size of stack segment, in bytes" .

hpc:X11 a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .
hpc:JobState a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .
hpc:HetJobId a hpc:Rlimit ;
    rdfs:comment "Heterogeneous job ID, if applicable" .
hpc:HetJobOffset a hpc:Rlimit ;
    rdfs:comment "Unique sequence number applied to this component of the heterogeneous job" .
hpc:Hold a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:boolean .
hpc:MailType a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .
hpc:LicensesAllocated a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
