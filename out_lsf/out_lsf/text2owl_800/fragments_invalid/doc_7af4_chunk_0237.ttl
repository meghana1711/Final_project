hpc:Hostgroup a owl:Class ;
    rdfs:subClassOf hpc:Group .

hpc:Hostpartition a owl:Class ;
    rdfs:subClassOf hpc:Group .

hpc:administeredBy an owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Clusteradmin .

hpc:contains an owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Host .

hpc:excludedFrom an owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:integer .

hpc:includes an owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:integer .

hpc:isCondensed an owl:DatatypeProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:boolean .

hpc:hasPartition an owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:belongsToPartition an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hostpartition .

hpc:Fairshareathostlevel rdfs:subClassOf hpc:Hostpartition .

hpc:hostD1 a hpc:Host .
hpc:hostD2 a hpc:Host .
hpc:hostD3 a hpc:Host .
hpc:hostD5 a hpc:Host .
hpc:hostD10 a hpc:Host .
hpc:hostD11 a hpc:Host .
hpc:hostD25 a hpc:Host .
hpc:hostD30 a hpc:Host .
hpc:hostD40 a hpc:Host .
hpc:hostD50 a hpc:Host .

hpc:groupF a hpc:HostGroup ;
    hpc:contains 3 (hpc:hostD1 . hpc:hostD3 . hpc:hostD5) ;
    hpc:isCondensed false ;
    hpc:administeredBy some hpc:ClusterAdmin .

hpc:groupG a hpc:HostGroup ;
    hpc:includes 42 (hpc:hostD11 . hpc:hostD12 . hpc:hostD30 . hpc:hostD40 . hpc:hostD41 . ... hpc:hostD50) ;
    hpc:excludedFrom 3 (hpc:hostD15 hpc:hostD20 hpc:hostD25) ;
    hpc:includes 1 (hpc:hostD2) ;
    hpc:isCondensed false ;
    hpc:administeredBy some hpc:ClusterAdmin .

hpc:groupH a hpc:HostPartition ;
    hpc:Haspartition hpc:groupg .

hpc:groupI a hpc:HostPartition ;
    hpc:Haspartition hpc:groupf .
