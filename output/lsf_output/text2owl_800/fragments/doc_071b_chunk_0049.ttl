hpc:Host a owl:Class .
hpc:alias a owl:ObjectProperty .
hpc:ipaddress a owl:DatatypeProperty .
hpc:Node a owl:Class .
hpc:NodeIndex a xsd:string .
hpc:Hostnamerange a owl:Class .
hpc:noderange a owl:ObjectProperty .

hpc:Host rdfs:subClassOf hpc:Node .
hpc:Alias rdfs:domain hpc:Host .
hpc:Ipaddress rdfs:domain hpc:Host .
hpc:Node rdfs:subClassOf rdf:Resource .
hpc:Hostnamerange rdfs:subClassOf hpc:Node .

hpc:Noderange rdfs:domain hpc:Noderange .
hpc:Noderange rdfs:range xsd:string .

hpc:Hostnamerange rdfs:subClassOf hpc:Node .
hpc:HostNameRange rdf:value "http://example.org/hpc#HostNameRange" .
hpc:HostNameRange rdfs:comment "A range of host names for a group of nodes." .

hpc:NodeRange rdf:value "http://example.org/hpc#NodeRange" .
hpc:NodeRange rdfs:comment "A range of node indices for a group of nodes." .
