@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:Status a owl:Class .
hpc:Provisionedhost a owl:Class .
hpc:Detailedstatus a owl:Class .
hpc:Basicstatus a owl:Class .
hpc:Provisionedbylcsaws a owl:Class .
hpc:Remotehost a owl:Class .
hpc:Localhost a owl:Class .
hpc:pubdnsname a owl:DatatypeProperty .
hpc:pubipaddress a owl:DatatypeProperty .
hpc:privdnsname a owl:DatatypeProperty .
hpc:privipaddress a owl:DatatypeProperty .
hpc:rcstatus a owl:DatatypeProperty .
hpc:provstatus a owl:DatatypeProperty .
hpc:tag a owl:DatatypeProperty .
hpc:updatedat a owl:DatatypeProperty .
hpc:dispatchwindow a owl:DatatypeProperty .
hpc:CpuF a xsd:decimal .
hpc:MaxNjobs a xsd:nonNegativeInteger .
hpc:Run a xsd:boolean .
hpc:Ssusp a xsd:nonNegativeInteger .
hpc:Ususp a xsd:nonNegativeInteger .
hpc:Rsv a xsd:nonNegativeInteger .
hpc:RcStatus_Values rdf:type owl:NamedIndividual .
hpc:RcStatus_Values rdfs:label "Allocated running" .
hpc:RcStatus_Values rdfs:comment "Host is allocated and running" .
hpc:RcstatusValues rdfs:subClassOf hpc:Rcstatus .
hpc:ProvStatus_Values rdf:type owl:NamedIndividual .
hpc:ProvStatus_Values rdfs:label "Done terminated" .
hpc:ProvStatus_Values rdfs:comment "Host is done and terminated" .
hpc:ProvstatusValues rdfs:subClassOf hpc:Provstatus .

hpc:Provisionedhost rdfs:subClassOf rdf:Resource .
hpc:Remotehost rdfs:subClassOf hpc:Provisionedhost .
hpc:Localhost rdfs:subClassOf hpc:Provisionedhost .
hpc:Detailedstatus rdfs:subClassOf hpc:Status .
hpc:Basic
