hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Hasschedulingconditions ;
    rdfs:subClassOf hpc:Hassuspendingconditions ;
    rdfs:subClassOf hpc:Hasresumingconditions ;
    rdfs:domain hpc:Hasschedulingconditions rdf:Resource ;
    rdfs:domain hpc:Hassuspendingconditions rdf:Resource ;
    rdfs:domain hpc:Hasresumingconditions rdf:Resource ;
    rdfs:range hpc:Schedulingcondition rdf:Resource ;
    rdfs:range hpc:Suspendingcondition rdf:Resource ;
    rdfs:range hpc:Resumingcondition rdf:Resource .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Hasschedulingloadthresholds ;
    rdfs:subClassOf hpc:Hassuspendingloadthresholds ;
    rdfs:domain hpc:Hasschedulingloadthresholds rdf:Resource ;
    rdfs:domain hpc:Hassuspendingloadthresholds rdf:Resource ;
    rdfs:range hpc:Schedulingloadthreshold rdf:Resource .

hpc:Schedulingcondition a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirement ;
    rdfs:range hpc:Schedulingloadthreshold .

hpc:Resourcerequirement a owl:Class .

hpc:Schedulingloadthreshold a owl:Class ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:Suspendingcondition a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Suspendingloadthreshold .

hpc:Suspendingloadthreshold a owl:Class ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:Resumingcondition a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resumingloadthreshold .

hpc:Resumingloadthreshold a owl:Class ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Hasschedulingloadthresholds ;
    rdfs:domain hpc:Hasschedulingloadthresholds rdf:Resource ;
    rdfs:range hpc:Schedulingloadthreshold .

hpc:SchedulingLoadThreshold
