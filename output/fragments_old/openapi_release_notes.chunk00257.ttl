hpc:TresList a owl:Class .
hpc:JobResSocketArray a owl:Class .
hpc:StatsMsgRpcsDump a owl:Class .
hpc:StatsMsgRpcsQueue a owl:Class .
hpc:JobRes a owl:Class .
hpc:JobResCoreArray a owl:Class .
hpc:JobResNodes a owl:Class .

hpc:hasRequired a owl:ObjectProperty .
hpc:hasType a owl:ObjectProperty .

hpc:TresListItem a owl:Class .
hpc:UserListItem a owl:Class .
hpc:WckeyListItem a owl:Class .
hpc:JobResCore a owl:Class .
hpc:JobResNode a owl:Class .

hpc:TresListItem rdfs:subClassOf hpc:TresList .
hpc:UserListItem rdfs:subClassOf hpc:UserList .
hpc:WckeyListItem rdfs:subClassOf hpc:WckeyList .
hpc:JobResCore rdfs:subClassOf hpc:JobResCoreArray .
hpc:JobResNode rdfs:subClassOf hpc:JobResNodes .

hpc:TresListItem rdfs:domain hpc:TresList .
hpc:UserListItem rdfs:domain hpc:UserList .
hpc:WckeyListItem rdfs:domain hpc:WckeyList .
hpc:JobResCore rdfs:domain hpc:JobResCoreArray .
hpc:JobResNode rdfs:domain hpc:JobResNodes .

hpc:hasRequired rdfs:range xsd:integer .
hpc:hasType rdfs:range rdfs:Resource .

hpc:TresListItem rdfs:subPropertyOf hpc:hasRequired .
hpc:UserListItem rdfs:subPropertyOf hpc:hasRequired .
hpc:WckeyListItem rdfs:subPropertyOf hpc:hasRequired .
hpc:JobRes rdfs:subPropertyOf hpc:hasType .
hpc:JobResCore rdfs:subPropertyOf hpc:hasType .
hpc:JobResNode rdfs:subPropertyOf hpc:hasType .

hpc:JobRes rdfs:comment "Job resource" .
hpc:JobResCore rdfs:comment "Job core resource" .
hpc:JobResNode rdfs:comment "Job node resource" .

hpc:acctGatherEnergyCurrentWatts a owl:DatatypeProperty .
hpc:extSensorsDataConsumedEnergy a owl:DatatypeProperty
