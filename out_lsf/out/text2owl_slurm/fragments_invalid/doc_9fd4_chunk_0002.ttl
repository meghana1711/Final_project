@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:Step a owl:Class.
hpc:Signal a owl:Class.
hpc:Jobrecord a owl:Class.
hpc:Steprecord a owl:Class.
hpc:exitcode a owl:DatatypeProperty.
hpc:derivedexitcode a owl:DatatypeProperty.
hpc:commentstring a owl:DatatypeProperty.
hpc:hassignal a owl:ObjectProperty.
hpc:hasjobrecord a owl:ObjectProperty.
hpc:hassteprecord a owl:ObjectProperty.

hpc:hasExitCode rdf:type rdfs:Property
