hpc:Slurmdbd a owl:Class .
hpc:SlurmAuthenticationPlugin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range hpc:Munge .

hpc:SlurmAccountingStoragePlugin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:SlurmDBDCaching rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:SlurmDBDPrioritization rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:SlurmCommandNotRequired rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:Boolean .

hpc:SlurmDBDRequiredRPMs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:string .

hpc:Association rdf:type owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:ClusterName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association .

hpc:BankAccount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association .

hpc:User rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association .

hpc:SlurmPartition rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .

hpc:SchedulingPolicy rdf:type owl:Class .

hpc:AccountingStorageEnforce rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingpolicy .

hpc:PreventInvalidAccess rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:Boolean ;
    rdfs:subPropertyOf hpc:AccountingStorageEnforce .

hpc:EnforceLimits rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:Boolean ;
    rdfs:subPropertyOf hpc:AccountingStorageEnforce .

hpc:AssociationsOption rdf:type owl:Class .
hpc:LimitsOption rdf:type owl:Class .

hpc:AssociationsOptionAssociations rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Associationsoption ;
    rdfs:range xsd:string .

hpc:AssociationsOptionLimits rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Associationsoption ;
    rdfs:range xsd:string .
