hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workload ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:pend a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the status of a job is PENDing." .

hpc:outputFromJ a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Shows the output files generated by a job." .

hpc:outputFromJ2 a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "For jobs with a folder as data requirement, shows the folder name." .

hpc:dataRequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Shows the data requirement for a job." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The unique identifier for a job." .

hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who submitted the job." .

hpc:stat a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of the job." .

hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The queue the job is in." .

hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The host from which the job was submitted." .

hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the job." .

hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time the job was submitted." .

hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a file in the HPC system." .

hpc:size a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The size of the file." .

