hpc:Queue a owl:Class;
    rdfs:subClassOf hpc:Resource.

hpc:Pool a owl:Class;
    rdfs:subClassOf hpc:Resource.

hpc:haspool a owl:ObjectProperty;
    rdfs:domain hpc:Queue;
    rdfs:range hpc:Pool.

hpc:slotshare a owl:DatatypeProperty;
    rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal.

hpc:slotpool a owl:DatatypeProperty;
    rdfs:domain hpc:Queue;
    rdfs:range xsd:string.

hpc:shareconstraint a owl:ObjectProperty;
    rdfs:domain hpc:Pool;
    rdfs:range hpc:Queue.

hpc:slotlimit a owl:DatatypeProperty;
    rdfs:domain hpc:Pool;
    rdfs:range xsd:nonNegativeInteger.

hpc:totalslotlimit a owl:DatatypeProperty;
    rdfs:domain hpc:Pool;
    rdfs:range
