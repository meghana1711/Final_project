hpc:Lsf a owl:Class .
hpc:version a owl:DatatypeProperty .
hpc:location a owl:DatatypeProperty .
hpc:edition a owl:ObjectProperty .
hpc:runningstate a owl:ObjectProperty .
hpc:checkresult a owl:DatatypeProperty .
hpc:startcommand a owl:DatatypeProperty .
hpc:ClusterType a owl:EnumClass .
hpc:Windowscluster hpc:clustertype .
hpc:Mixedcluster hpc:clustertype .
hpc:Unixhost a owl:Class .
hpc:Windowshost a owl:Class .
hpc:lsinfo a owl:ObjectProperty .
hpc:lshosts a owl:ObjectProperty .
hpc:lsiinfo a owl:ObjectProperty .
hpc:Resource a owl:Class .
hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .

hpc:Lsf rdfs:subClassOf owl:Class .
hpc:Version rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Location rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Edition rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Edition .
hpc:Runningstate rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Checkresult rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Startcommand rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:ClusterType rdf:type owl:EnumClass .
hpc:WindowsCluster rdf:type hpc:ClusterType .
hpc:MixedCluster rdf:type hpc:ClusterType .
hpc:Unixhost rdfs:subClassOf hpc:Host .
hpc:Windowshost rdfs:subClassOf hpc:Host .
hpc:LSInfo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsinforesult .
hpc:LSHosts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Hostlist .
hpc:LSIInfo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Resourceinfo .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:Hosttype rdfs:subClassOf owl:Class .
hpc:Hostmodel rdfs:subClassOf owl:Class .
