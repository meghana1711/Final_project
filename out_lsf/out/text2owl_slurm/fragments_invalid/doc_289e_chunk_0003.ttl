hpc:Partition a owl:Class.
hpc:Grptres hpc:Partition rdfs:domain hpc:Partition;
                                rdfs:range xsd:nonNegativeInteger.

hpc:Qos a owl:Class.
hpc:Flags hpc:Qos rdfs:domain hpc:Qos;
              rdfs:range xsd:boolean.

hpc:Relative hpc:flags a owl:EquivalentClass;
                      rdf:type owl:Restriction;
                      rdfs:onProperty hpc:Flags;
                      rdfs:allValuesFrom xsd:true.

hpc:Hasqos hpc:Partition rdfs:domain hpc:Partition;
                          rdfs:range hpc:Qos.

hpc:Memory hpc:Qos rdfs:domain hpc:Qos;
              rdfs:range xsd:nonNegativeInteger.

hpc:Hasrelativeqos hpc:Qos rdfs:domain hpc:Qos;
                         rdfs:range xsd:boolean.
