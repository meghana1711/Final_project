hpc:Swaplimit a owl:Class ;
    rdfs:subClassOf owl:Real ;
    rdfs:comment "The maximum amount of memory a job can use, in KB." .

hpc:lsfUnitForLimits a owl:ObjectProperty ;
    rdfs:domain hpc:Swaplimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The unit for displaying SWAPLIMIT (MB, GB, TB, PB, or EB)." .

hpc:Processlimit a owl:Class ;
    rdfs:subClassOf owl:Real ;
    rdfs:comment "The maximum number of concurrent processes that are allocated to a job." .

hpc:Threadlimit a owl:Class ;
    rdfs:subClassOf owl:Real ;
    rdfs:comment "The maximum number of concurrent threads that are allocated to a job." .

hpc:Runlimit a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger ;
    rdfs:comment "The maximum wall clock time a process can use, in minutes." .

hpc:CPUFactor owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The CPU factor of the execution host." .

hpc:sigintsignal a owl:ObjectProperty ;
    rdfs:domain hpc:Swaplimit, hpc:Processlimit, hpc:Threadlimit, hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The SIGINT signal sent to processes when limits are reached." .

hpc:sigtermsignal a owl:ObjectProperty ;
    rdfs:domain hpc:Swaplimit, hpc:Processlimit, hpc:Threadlimit, hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The SIGTERM signal sent to processes when limits are reached." .

hpc:sigkillsignal a owl:ObjectProperty ;
    rdfs:domain hpc:Swaplimit, hpc:Processlimit, hpc:Threadlimit, hpc:Runlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The SIGKILL signal sent to processes when limits are reached." .

hpc:Filesizelimit a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger ;
    rdfs:comment "The maximum file size a process can create, in KB." .

hpc:rlimitFsize a owl:ObjectProperty ;
    rdfs:domain hpc:Filesizelimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The UNIX setrlimit system call option for enforcing the FILESIZELimit." .

hpc:ulSetfsize a owl:ObjectProperty ;
    rdfs:domain hpc:Filesizelimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The ulimit system call option for enforcing the FILESIZELimit." .

hpc:Datalimit a owl:Class ;
    rdfs:sub
