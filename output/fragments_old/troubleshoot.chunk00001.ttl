hpc:SlurmWorkloadManager a owl:Class .
hpc:Controller a owl:Class .
hpc:Node a owl:Class .
hpc:Job a owl:Class .
hpc:Scheduler a owl:Class .
hpc:BuiltinScheduler a owl:Class, rdfs:subClassOf hpc:Scheduler .
hpc:BackfillScheduler a owl:Class, rdfs:subClassOf hpc:Scheduler .
hpc:Problem a owl:Class .
hpc:FileSystemProblem a owl:Class, rdfs:subClassOf hpc:Problem .
hpc:NetworkingProblem a owl:Class, rdfs:subClassOf hpc:Problem .
hpc:ConfigurationProblem a owl:Class, rdfs:subClassOf hpc:Problem .

# Object Properties
hpc:hasController rdf:type owl:ObjectProperty .
hpc:hasNode rdf:type owl:ObjectProperty .
hpc:hasJob rdf:type owl:ObjectProperty .
hpc:hasScheduler rdf:type owl:ObjectProperty .
hpc:isStuckInState rdf:type owl:ObjectProperty .
hpc:isResponding rdf:type owl:ObjectProperty .
hpc:hasReason rdf:type owl:ObjectProperty .
hpc:hasTime rdf:type xsd:dateTime .

# Datatype Properties
hpc:type rdf:type owl:DatatypeProperty .
hpc:state rdf:type owl:DatatypeProperty .
hpc:reason rdf:type owl:DatatypeProperty .

# Object Property Domain and Range
hpc:hasController rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:Controller .
hpc:hasNode rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:Node .
hpc:hasJob rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:Job .
hpc:hasScheduler rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:Scheduler .
hpc:isStuckInState rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isResponding rdfs:domain (hpc:Controller | hpc:Node) ;
    rdfs:range xsd:boolean .
hpc:hasReason rdfs:domain (hpc:Problem | hpc:Job) ;
    rdfs:range xsd:string .
hpc:hasTime rdfs:domain hpc:Problem ;
    rdfs:range xsd:dateTime .

# Individual Instances
hpc:SlurmWorkloadManager_25_05 a hpc:SlurmWorkloadManager .

# Object Property Values
hpc:SlurmWorkloadManager_25_05 hpc:hasController hpc:Controller_Primary ;
    hpc:SlurmWorkloadManager_25_05 hpc:hasController hpc:Controller_Backup .

# Annotations
hpc:Controller_Primary a hpc:Controller ;
