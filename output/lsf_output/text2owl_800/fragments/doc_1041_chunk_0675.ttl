hpc:Jobpacksubmission a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "For requests in the file, job pack submission supports all bsub options in the job submission file except for the following: -I, -Ip, -Is, -IS, -ISp, -ISs, -IX, -XF, -K, -jsdl, -h, -V, -pack." .

hpc:Jobpack a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Each group of jobs submitted to mbatchd together is called a job pack." .

hpc:hasBsubOption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpacksubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "The bsub options that are not supported in job pack submission." .

hpc:isJobPackEnabled rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpacksubmission ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job packs feature is enabled." .

hpc:jobPackSize rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpacksubmission ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of jobs in a job pack." .

hpc:jobPackRejectionReason rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range xsd:string ;
    rdfs:comment "The reason for the rejection of a job pack if it exceeds the job pack size defined in lsf.conf." .

hpc:handledByLSF rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range hpc:Job ;
    rdfs:comment "The job requests in the pack are handled by LSF as if they were submitted individually with the bsub command." .
