hpc:Resourcegroup a owl:Class .
hpc:Resourcedistributionplan a owl:Class .
hpc:Service a owl:Class .
hpc:Useraccount a owl:Class .

hpc:hasresource a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcegroup ;
    rdfs:range rdf:Resource .

hpc:hasdistributionplan a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcegroup ;
    rdfs:range hpc:Resourcedistributionplan .

hpc:hasservice a owl:ObjectProperty ;
    rdfs:domain hpc:Service .
    rdfs:range rdf:Resource .

hpc:hasuseraccount a owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount .
    rdfs:range rdf:Resource .

hpc:isenabled a owl:DatatypeProperty ;
    rdfs:domain hpc:Service .
    rdfs:range xsd:boolean .

hpc:LsfTop a owl:Class ;
    rdfs:subClassOf owl:Directory .

hpc:Conf a owl:Class ;
    rdfs:subClassOf hpc:LsfTop .

hpc:writable a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfTop .
    rdfs:range xsd:boolean .
