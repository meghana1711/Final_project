@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LsbOutputTargetfailed a owl:Class ;
  rdfs:comment "Indicates that LSF cannot access the output file specified for a job submitted the bsub -o option." ;
  rdfs:domain lsfJob ;
  rdfs:range xsd:string ;
  rdfs:subClassOf owl:Enum ;
  rdfs:subClassOf hpc:Lsbenvironmentvariable .

hpc:LsbProjectName a owl:Class ;
  rdfs:comment "To enable the use of project names for accounting purposes inside third party tools that launch jobs under LSF using environment variables." ;
  rdfs:domain lsfJob ;
  rdfs:range xsd:string ;
  rdfs:subClassOf owl:NamedIndividual .

hpc:LsbQueue a owl:Class ;
  rdfs:comment "The name of the queue from which the job is dispatched." ;
  rdfs:domain lsfJob ;
  rdfs:range xsd:string ;
  rdfs:subClassOf owl:NamedIndividual .

hpc:hasLSB_OUTPUT_TARGETFAILED an owl:ObjectProperty ;
  rdfs:domain lsfJob ;
  rdfs:range hpc:LsbOutputTargetfailed ;
  rdfs:subPropertyOf rdf:type .

hpc:hasLSB_PROJECT_NAME an owl:ObjectProperty ;
  rdfs:domain lsfJob ;
  rdfs:range hpc:LsbProjectName ;
  rdfs:subPropertyOf rdf:type .

hpc:hasLSB_QUEUE an owl:ObjectProperty ;
  rdfs:domain lsfJob ;
  rdfs:range hpc:LsbQueue ;
  rdfs:subPropertyOf rdf:type .
