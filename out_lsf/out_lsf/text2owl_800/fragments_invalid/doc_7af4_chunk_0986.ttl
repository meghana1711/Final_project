hpc:it a hpc:ConsumableResource .
hpc:tmp a hpc:ConsumableResource .
hpc:swp a hpc:ConsumableResource .
hpc:mem a hpc:ConsumableResource .

hpc:ncpus a hpc:NonConsumableResource .
hpc:ndisks a hpc:NonConsumableResource .
hpc:maxmem a hpc:NonConsumableResource .
hpc:maxswp a hpc:NonConsumableResource .
hpc:maxtmp a hpc:NonConsumableResource .
hpc:cpuf a hpc:NonConsumableResource .
hpc:type a hpc:NonConsumableResource .
hpc:model a hpc:NonConsumableResource .
hpc:status a hpc:NonConsumableResource .
