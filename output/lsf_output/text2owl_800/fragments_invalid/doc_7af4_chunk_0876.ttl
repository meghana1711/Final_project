    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range hpc:Boolean .
hpc:ignoreonotheroperatingsystems a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range hpc:Boolean .
hpc:lsfreplacepimwithlinuxcgroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range xsd:boolean .
hpc:lsfprocesstracking a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range hpc:Boolean .
hpc:lsflinuxcgroupacct a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range hdfs:Boolean .
hpc:lsbresourceenforce a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroup ;
