hpc:Licenseproject a owl:Class .
hpc:Lp1 a owl:Class .
hpc:Lp2 a owl:Class .
hpc:Project a owl:Class .

# Object Properties
hpc:entitledto a owl:ObjectProperty .
hpc:preempts a owl:ObjectProperty .
hpc:useslicenseswhennotneededbylp2 a owl:ObjectProperty .

# Datatype Properties
hpc:totallicenses a owl:DatatypeProperty .
hpc:licensesneededimmediately a owl:DatatypeProperty .
hpc:licensesavailablelater a owl:DatatypeProperty .

# Individuals
hpc:Lp1_Instance a hpc:Lp1 .
hpc:Lp2_Instance a hpc:Lp2 .

# Subclass Relations
hpc:Lp2 rdfs:subClassOf hpc:Licenseproject .

# Domain and Range
hpc:Entitledto rdfs:domain hpc:Licenseproject ;
    rdfs:range hpc:Project .
hpc:Preempts rdfs:domain hpc:Licenseproject ;
    rdfs:range hpc:Project .
hpc:Useslicenseswhennotneededbylp2 rdfs:domain hpc:Project ;
    rdfs:range hpc:Project .

# Data Type Restrictions
hpc:Totallicenses rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Licensesneededimmediately rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Licensesavailablelater rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .


This ontology fragment represents the classes `Lp1` and `Lp2` as subclasses of `LicenseProject`. It also defines the object properties `entitledTo`, `preempts`, and `usesLicensesWhenNotNeededByLp2`, as well as the datatype properties `totalLicenses`, `licensesNeededImmediately`, and `licensesAvailableLater`. The domain and range for each property are defined, and data type restrictions are added for the datatype properties.
