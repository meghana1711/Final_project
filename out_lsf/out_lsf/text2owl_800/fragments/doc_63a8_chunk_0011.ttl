hpc:Job a owl:Class .
hpc:transfercommand a owl:ObjectProperty .
hpc:submissiondirectory a owl:DatatypeProperty .
hpc:stagingarea a owl:DatatypeProperty .
hpc:Datatag a owl:Class .
hpc:Datataggedfile a owl:Class .
hpc:Taggeddirectory a owl:Class .
hpc:datadependency a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Transfercommand rdfs:domain hpc:Job ;
    rdfs:range rdf:Property .
hpc:Submissiondirectory rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Stagingarea rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Datatag rdfs:subClassOf owl:Class .
hpc:Datataggedfile rdfs:subClassOf owl:Class .
hpc:Taggeddirectory rdfs:subClassOf owl:Class .
hpc:Datadependency rdfs:domain hpc:Datatag ;
    rdfs:range hpc:Job .

hpc:jobHasTransfercommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Transfercommand .
hpc:jobUsesSubmissiondirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobUsesStagingarea a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:datatagHasTaggedfile a owl:ObjectProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range hpc:Datataggedfile .
hpc:datatagHasTaggeddirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range hpc:Taggeddirectory .
hpc:datatagDependsOnJob a owl:ObjectProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range hpc:Job .
