hpc:retryLimit a owl:DatatypeProperty .
hpc:RetryLimit rdfs:domain hpc:Serverhost ;
                  rdfs:range xsd:nonNegativeInteger .

hpc:hostInactivityLimit a owl:DatatypeProperty .
hpc:HostInactivityLimit rdfs:domain hpc:Serverhost ;
                            rdfs:range xsd:nonNegativeInteger .

hpc:exinterval a owl:DatatypeProperty .
hpc:Exinterval rdfs:domain hpc:Serverhost ;
                rdfs:range xsd:nonNegativeInteger .

hpc:Clusteradmins a owl:Class .
hpc:Administrator a owl:Class .

hpc:hasadministrator a owl:ObjectProperty .
hpc:Hasadministrator rdfs:domain hpc:Clusteradmins ;
                       rdfs:range hpc:Administrator .

hpc:isprimaryadministrator a owl:ObjectProperty .
hpc:Isprimaryadministrator rdfs:domain hpc:Administrator ;
                             rdfs:range xsd:boolean .

hpc:isunixuser a owl:ObjectProperty .
hpc:Isunixuser rdfs:domain hpc:Administrator ;
                rdfs:range xsd:string .

hpc:iswindowsuser a owl:ObjectProperty .
hpc:Iswindowsuser rdfs:domain hpc:Administrator ;
                   rdfs:range xsd:string .

hpc:isgroup a owl:ObjectProperty .
hpc:Isgroup rdfs:domain hpc:Administrator ;
              rdfs:range xsd:string .

hpc:Serverhost a owl:Class .
