hpc:Queue a owl:Class .
hpc:Crossqueuefairsharequeue a owl:Class .
hpc:Userbasedfairsharequeue a owl:Class .
hpc:Hierarchicalfairsharequeue a owl:Class .
hpc:Nonfairsharequeue a owl:Class .
hpc:Fairsharetree a owl:Class .
hpc:dispatchorder a owl:ObjectProperty .
hpc:priority a owl:DatatypeProperty .
hpc:submissiontime a owl:DatatypeProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:Group a owl:Class .
hpc:Subgroup a owl:Class .
hpc:User a owl:Class .
hpc:resourceconsumption a owl:DatatypeProperty .
hpc:dynamicsharepriority a owl:DatatypeProperty .

hpc:Queue rdfs:subClassOf owl:Class .
hpc:Crossqueuefairsharequeue rdfs:subClassOf hpc:Queue .
hpc:Userbasedfairsharequeue rdfs:subClassOf hpc:Queue .
hpc:Hierarchicalfairsharequeue rdfs:subClassOf hpc:Userbasedfairsharequeue .
hpc:Nonfairsharequeue rdfs:subClassOf hpc:Queue .
hpc:Fairsharetree rdfs:subClassOf owl:Class .
hpc:Dispatchorder rdfs:domain hpc:Queue ;
                        rdfs:range hpc:Queue .
hpc:Priority rdfs:domain hpc:Queue ;
                        rdfs:range xsd:decimal .
hpc:Submissiontime rdfs:domain hpc:Queue ;
                        rdfs:range xsd:dateTime .
hpc:Jobid rdfs:domain hpc:Queue ;
                        rdfs:range xsd:string .
hpc:Resourceconsumption rdfs:domain hpc:Group ;
                        rdfs:range xsd:decimal .
hpc:Dynamicsharepriority rdfs:domain hpc:Group ;
                        rdfs:range xsd:decimal .
hpc:Group rdfs:subClassOf owl:Class .
hpc:Subgroup rdfs:subClassOf hpc:Group .
hpc:User rdfs:subClassOf owl:Class .
