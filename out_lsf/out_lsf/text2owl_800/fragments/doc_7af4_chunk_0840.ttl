hpc:Loggingsystem a owl:Class .
hpc:Loggingqueue a owl:Class .
hpc:Loggingthread a owl:Class .
hpc:Loggingdirectory a owl:Class .

# Object Properties
hpc:hasLoggingSystem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Loggingthread ;
    rdfs:range hpc:Loggingsystem .

hpc:hasLoggingQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Loggingthread ;
    rdfs:range hpc:Loggingqueue .

hpc:isLogDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Loggingsystem ;
    rdfs:range hpc:Loggingdirectory .

# Datatype Properties
hpc:logqueuesize a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

# Subclass Relations
hpc:MBatchd a hpc:LoggingSystem ;
    rdfs:subClassOf hpc:Loggingsystem .

hpc:MBSchd a hpc:LoggingSystem ;
    rdfs:subClassOf hpc:Loggingsystem .

hpc:DedicatedLoggingThread a hpc:LoggingThread ;
    rdfs:subClassOf hpc:Loggingthread .

# Data
hpc:LSF_LOG_THREAD a hpc:DedicatedLoggingThread ;
    hpc:logQueueSize xsd:0 .

hpc:LSF_LOG_QUEUE_SIZE a hpc:LoggingQueue .

hpc:LSF_DISCARD_LOG a hpc:LoggingSystem .

hpc:LSF_LOGDIR a hpc:LoggingDirectory .
