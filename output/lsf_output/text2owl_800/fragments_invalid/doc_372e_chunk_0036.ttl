hpc:groupshares a owl:ObjectProperty .
hpc:ownershiplimits a owl:ObjectProperty .
hpc:nonshared a owl:ObjectProperty .
hpc:Group a owl:Class .
hpc:Project a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:limit a owl:DatatypeProperty .
hpc:Token a xsd:nonNegativeInteger .

hpc:Projectgroup rdfs:subClassOf owl:Class .
hpc:Groupshares rdfs:domain hpc:Projectgroup ;
                 rdfs:range rdf:List .
hpc:Ownershiplimits rdfs:domain hpc:Projectgroup ;
                   rdfs:range rdf:List .
hpc:Nonshared rdfs:domain hpc:Projectgroup ;
               rdfs:range rdf:PlainLiteral .

hpc:Group rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Servicedomain rdfs:subClassOf owl:Class .

hpc:hasgroup a owl:ObjectProperty ;
             rdfs:domain hpc:Projectgroup ;
             rdfs:range hpc:Group .
hpc:sharesownership a owl:ObjectProperty ;
                   rdfs:domain hpc:Projectgroup ;
                   rdfs:range hpc:Group .
hpc:ownershiplimits a owl:ObjectProperty ;
                   rdfs:domain hpc:Projectgroup ;
                   rdfs:range rdf:List .
hpc:nonshared a owl:ObjectProperty ;
              rdfs:domain hpc:Projectgroup ;
              rdfs:range rdf:PlainLiteral .

hpc:hasproject a owl:ObjectProperty ;
              rdfs:domain hpc:Group ;
              rdfs:range hpc:Project .
hpc:hasservicedomain a owl:ObjectProperty ;
                   rdfs:domain hpc:Project ;
                   rdfs:range hpc:Servicedomain .

