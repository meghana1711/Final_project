hpc:Ociconfiguration a owl:Class.
hpc:hasociconf a owl:ObjectProperty.
hpc:Hasociconf rdfs:domain hpc:Node; rdfs:range hpc:Ociconfiguration.

hpc:Node a owl:Class.

hpc:Ociruntimeconfiguration a owl:Class.
hpc:Ociruntimeconfiguration rdfs:subClassOf hpc:Ociconfiguration.

hpc:jwtauthnotsupported a owl:DatatypeProperty.
hpc:Jwtauthnotsupported rdfs:domain hpc:Ociruntimeconfiguration; rdfs:range xsd:boolean.

hpc:dockercontainerbuildingnotfunctional a owl:DatatypeProperty.
hpc:Dockercontainerbuildingnotfunctional rdfs:domain hpc:Ociruntimeconfiguration; rdfs:range xsd:boolean.

hpc:dockernoconfigoptions a owl:DatatypeProperty.
hpc:Dockernoconfigoptions rdfs:domain hpc:Ociruntimeconfiguration; rdfs:range xsd:string.

hpc:dockersecurity
