hpc:Job a owl:Class .
hpc:bsubjob a owl:ObjectProperty .
hpc:resourcerequirement a owl:DatatypeProperty .
hpc:status a owl:DatatypeProperty .
hpc:Host a owl:Class .
hpc:ipaddress a owl:DatatypeProperty .
hpc:statusofhost a owl:ObjectProperty .
hpc:okStatus a owl:NamedIndividual .
hpc:unavailStatus a owl:NamedIndividual .
hpc:closedStatus a owl:NamedIndividual .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Bsubjob rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Resourcerequirement rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Ipaddress rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Statusofhost rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Okstatus hpc:status "ok" .
hpc:Unavailstatus hpc:status "unavail" .
