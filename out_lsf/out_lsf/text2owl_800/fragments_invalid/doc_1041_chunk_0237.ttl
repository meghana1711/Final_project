hpc:Hostpartition a owl:Class .
hpc:hashosts a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:Resource .
hpc:hasusers a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:Resource .
hpc:hasshares a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:integer .
hpc:HostPartitionName a rdfs:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hostpartitionoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition .
hpc:displayhostpartitioninfo a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition .
hpc:printversion a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition .
hpc:printusage a owl:ObjectProperty ;
    rdfs:domain hdfs:HostPartition .
