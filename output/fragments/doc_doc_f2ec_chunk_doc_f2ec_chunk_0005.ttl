    rdfs:domain hpc:SlurmNode ;
    rdfs:range hpc:SlurmUser .
hpc:SlurmUserExistsOnController a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser .
hpc:SlurmUserExistsOnNode a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser .
hpc:SlurmNodeHasCompatibleSlurmVersion a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode .
hpc:SlurmNodeRestart a owl:ObjectProperty .
hpc:SlurmNodeCheckLogFiles a owl:ObjectProperty .
