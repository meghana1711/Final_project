hpc:Host a owl:Class .
hpc:Hostname rdfs:domain hpc:Host .
hpc:Hostname rdfs:range xsd:string .

hpc:Pendingjob a owl:Class .
hpc:Pendingreason rdfs:domain hpc:Pendingjob .
hpc:Pendingreason rdfs:range xsd:string .

hpc:Suspendedjob a owl:Class .
hpc:Suspendreason rdfs:domain hpc:Suspendedjob .
hpc:Suspendreason rdfs:range xsd:string .

hpc:Suspendedjoblist rdfs:subClassOf hpc:Suspendedjob .

hpc:jobsuspendingreason a owl:ObjectProperty .
hpc:Jobsuspendingreason rdfs:domain hpc:Job .
hpc:Jobsuspendingreason rdfs:range hpc:Suspendreason .

hpc:jobsubmittingreason a owl:DatatypeProperty .
hpc:Jobsubmittingreason rdfs:domain hpc:Job .
hpc:Jobsubmittingreason rdfs:range xsd:string .

hpc:Loadthreshold rdfs:domain hpc:Suspendreason .
hpc:Loadthreshold rdfs:range xsd:decimal .

hpc:Schedulingparameter rdfs:domain hpc:Suspendreason .
hpc:Schedulingparameter rdfs:range xsd:string .

hpc:maxpendingjobthreshold a owl:DatatypeProperty .
hpc:Maxpendingjobthreshold rdfs:domain hpc:User .
hpc:Maxpendingjobthreshold rdfs:range xsd:decimal .

hpc:Bjobscommand rdfs:subClassOf owl:NamedIndividual .
hpc:bjobsCommand rdfs:subPropertyOf hpc:JobSubmittingReason .
hpc:bjobsCommand rdf:value "bjobs -lp" .

hpc:Viewpendingreasonscommand rdfs:subClassOf owl:NamedIndividual .
hpc:viewPendingReasonsCommand rdfs:subPropertyOf hpc:JobSubmittingReason .
hpc:viewPendingReasonsCommand rdf:value "bjobs -p" .

hpc:Viewsummarizedcommand rdfs:subClassOf owl:NamedIndividual .
hpc:viewSummarizedCommand rdfs:subPropertyOf hpc:JobSubmittingReason .
hpc:viewSummarizedCommand rdf:value "bjobs -psum" .

hpc:Viewuserscommand rdfs:subClassOf owl:NamedIndividual .
hpc:viewUsersCommand rdfs:subPropertyOf hpc:JobSubmittingReason .
hpc:viewUsersCommand rdf:value "busers -w all" .

hpc:Viewsuspendedjobscommand rdfs:subClassOf owl:NamedIndividual .
hpc:viewSuspendedJobsCommand rdfs:subPropertyOf hpc:JobSuspendingReason .
hpc:viewSuspendedJobsCommand rdf:value "bjobs -s" .

hpc:Viewdetailedsuspendedjobscommand rdfs:subClassOf owl:NamedIndividual .
hpc:viewDetailedSuspend
