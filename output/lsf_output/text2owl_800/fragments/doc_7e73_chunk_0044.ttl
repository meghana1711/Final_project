hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .

hpc:hasname a owl:ObjectProperty .
hpc:Hasname rdfs:domain hpc:Queue ;
                        rdfs:range xsd:string .

hpc:hasdescription a owl:ObjectProperty .
hpc:Hasdescription rdfs:domain hpc:Queue ;
                        rdfs:range xsd:string .

hpc:haspriority a owl:DatatypeProperty .
hpc:Haspriority rdfs:domain hpc:Queue ;
                    rdfs:range xsd:integer .

hpc:hasusers a owl:ObjectProperty .
hpc:Hasusers rdfs:domain hpc:Queue ;
                    rdfs:range xsd:string .

hpc:isexclusive a owl:DatatypeProperty .
hpc:Isexclusive rdfs:domain hpc:Queue ;
                    rdfs:range xsd:boolean .

hpc:isrerunnable a owl:DatatypeProperty .
hpc:Isrerunnable rdfs:domain hpc:Queue ;
                    rdfs:range xsd:boolean .

hpc:hasrcaccount a owl:DatatypeProperty .
hpc:Hasrcaccount rdfs:domain hpc:Queue ;
                    rdfs:range xsd:string .

hpc:hasrchosts a owl:DatatypeProperty .
hpc:Hasrchosts rdfs:domain hpc:Queue ;
                    rdfs:range xsd:string .

hpc:hasrcdemandpolicy a owl:ObjectProperty .
hpc:Hasrcdemandpolicy rdfs:domain hpc:Queue ;
                        rdfs:range hpc:Rcdemandpolicy .

hpc:Rcdemandpolicy a owl:Class .
hpc:Rcdemandpolicy rdfs:subClassOf owl:Class .

hpc:hasthresholdcondition a owl:ObjectProperty .
hpc:Hasthresholdcondition rdfs:domain hpc:Rcdemandpolicy ;
                            rdfs:range hpc:Thresholdcondition .

hpc:Thresholdcondition a owl:Class .
hpc:Thresholdcondition rdfs:subClassOf owl:Class .

hpc:hasnumpendjobs a owl:DatatypeProperty .
hpc:Hasnumpendjobs rdfs:domain hpc:Thresholdcondition ;
                     rdfs:range xsd:integer .

hpc:hasduration a owl:DatatypeProperty .
hpc:Hasduration rdfs:domain hpc:Thresholdcondition ;
                    rdfs:range xsd:integer .

hpc:hasminutes a owl:DatatypeProperty .
hpc:Hasminutes rdfs:domain hpc:Thresholdcondition ;
                    rdfs:range xsd:integer .

hpc:hasvalue a owl:DatatypeProperty .
hpc:Hasvalue rdfs:domain hpc:Thresholdcondition ;
                    rdfs:range xsd:integer .
