hpc:Lsfserver a owl:Class .
hpc:esubscriptfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:string .

hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:string .

hpc:Memmodel a owl:Class .

hpc:Lsfpredictorservice a owl:Class .
hpc:updatelsfpredictorservice a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictorservice ;
    rdfs:range hpc:Updatelsfpredictorservice .
hpc:Updatelsfpredictorservice a owl:Class .
    hpc:stopCurrentService rdfs:subPropertyOf hpc:updateLSFPredictorService ;
    rdfs:domain hpc:Updatelsfpredictorservice ;
    rdfs:range hpc:Stopcurrentservice .
    hpc:extractNewPackage rdfs:subPropertyOf hpc:updateLSFPredictorService ;
    rdfs:domain hpc:Updatelsfpredictorservice ;
    rdfs:range hpc:Extractnewpackage .

hpc:Lsfpredictorhost a owl:Class .
hpc:logintolsfpredictorhost a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictorhost ;
    rdfs:range xsd:string .

hpc:lsfpredictordirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfpredictorhost ;
    rdfs:range xsd:string .

hpc:newinstallationpackage a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfpredictorhost ;
    rdfs:range xsd:string .

hpc:removepreviouslsfpredictorimage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictorhost ;
    rdfs:range xsd:string .

hpc:Localregistry a owl:Class .

hpc:Lsfcognitivepredictorv1 a owl:Class .
hpc:bcognstop a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcognitivepredictorv1 ;
    rdfs:range xsd:string .

hpc:stopcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Bcognstop ;
    rdfs:range xsd:string .

hpc:forceflag a owl:DatatypeProperty ;
    rdfs:domain hpc:Stopcommand ;
    rdfs:range xsd:string .

hpc:extractnewinstallationpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictorhost ;
    rdfs:range xsd:string .
