hpc:Jobsubmissionpattern a owl:Class .
hpc:nummulticlusterjobs a owl:DatatypeProperty .
hpc:nummulticlustertasks a owl:DatatypeProperty .
hpc:preferredhost a owl:ObjectProperty .
hpc:Hostgroup a owl:Class .

# Object Properties
hpc:Haspreferredhost rdfs:domain hpc:Jobsubmissionpattern ;
                      rdfs:range hpc:Hostgroup .

# Datatype Properties
hpc:Nummulticlusterjobs rdfs:domain hpc:Jobsubmissionpattern ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Nummulticlustertasks rdfs:domain hpc:Jobsubmissionpattern ;
                           rdfs:range xsd:nonNegativeInteger .

# Configuration Files
hpc:Lsbqueuesconfigurationfile a owl:Class .
hpc:Lsfhostsconfigurationfile a owl:Class .
hpc:Lsfconffile a owl:Class .

# Subclass Relations
hpc:Jobsubmissionpattern rdfs:subClassOf hpc:Configuration .
hpc:Lsbqueuesconfigurationfile rdfs:subClassOf hpc:Configuration .
hpc:Lsfhostsconfigurationfile rdfs:subClassOf hpc:Configuration .
hpc:Lsfconffile rdfs:subClassOf hpc:Configuration .

# Commands
hpc:Limtcommand a owl:Class .
hpc:Lshostscommand a owl:Class .
hpc:Bhostsaffcommand a owl:Class .
hpc:imptjoblimit a owl:DatatypeProperty .
hpc:impttasklimit a owl:DatatypeProperty .
hpc:Lsbcommands a owl:Class .

# Supported Platforms
hpc:Rhel85 a owl:Class ;
           rdfs:subClassOf hpc:Platform .
hpc:Rhel86 a owl:Class ;
           rdfs:subClassOf hpc:Platform .
hpc:Rhel90 a owl:Class ;
           rdfs:subClassOf hpc:Platform .
hpc:Ibmaix7x a owl:Class ;
             rdfs:subClassOf hpc:Platform .

# IBM Spectrum LSF Version 10.1 Fix Pack 12
hpc:Lsfversion101fp12 a owl:Class .
hpc:releasedate a owl:DatatypeProperty .
hpc:securityfeatures a owl:ObjectProperty .
