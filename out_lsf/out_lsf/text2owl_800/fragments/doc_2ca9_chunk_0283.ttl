hpc:Lsfusermapping a owl:Class .
hpc:AwsprovTemplates a owl:Class .
hpc:interfacetype a owl:ObjectProperty .
hpc:AzuresprovTemplates a owl:Class .
hpc:imagename a owl:ObjectProperty .
hpc:interruptible a owl:ObjectProperty .
hpc:maxprice a owl:DatatypeProperty .
hpc:gcloudRegion a owl:ObjectProperty .
hpc:AzuresccprovTemplates a owl:Class .

rdfs:domain hpc:Interfacetype rdf:Resource .
rdfs:domain hpc:Imagename rdf:Resource .
rdfs:domain hpc:Interruptible rdf:Resource .
rdfs:domain hpc:Maxprice xsd:decimal .
rdfs:domain hpc:GcloudRegion rdf:Resource .

rdfs:range hpc:Interfacetype hpc:Boolean .
rdfs:range hpc:Imagename xsd:string .
rdfs:range hpc:Interruptible xsd:boolean .
rdfs:range hpc:Maxprice xsd:decimal .
rdfs:range hpc:GcloudRegion xsd:string .

hpc:lsf_usermappingFile a hpc:LSFUserMapping .
