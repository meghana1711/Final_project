hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:DefaultUserGroup rdf:type hpc:UserGroup ;
    rdfs:comment "Default user group for jobs when not explicitly specified." .

hpc:jobassociation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .

hpc:jobcontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "Operations that can be issued by the user group administrator." .

hpc:GroupAdmin rdf:type hpc:UserGroup ;
    rdfs:comment "User group administrator." .

hpc:StrictUGControl rdf:type hpc:Job ;
    rdfs:comment "Enforces strict user group control." .

hpc:EnforceOneUGLimits rdf:type hpc:Job ;
    rdfs:comment "Enforces one user group limit." .

hpc:detectidlejobafter a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The minimum job run time before mbatchd reports that the job is idle." .

hpc:diagnoselogdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file location for collected diagnosis information." .
