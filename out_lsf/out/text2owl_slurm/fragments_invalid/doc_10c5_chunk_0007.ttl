hpc:Cpuaffinity a owl:Class .
hpc:Core a owl:Class .
hpc:Processor a owl:Class .
hpc:taskid a owl:DatatypeProperty .
hpc:Hascore rdfs:domain hpc:Processor ;
                 rdfs:range hpc:Core .
hpc:Hastaskid rdfs:domain hpc:Processor ;
                 rdfs:range xsd:integer .

hpc:BlockNumberedCore a hpc:Core ;
                      rdfs:subClassOf hpc:Core .
hpc:CyclicCore a hpc:Core ;
                 rdfs:subClassOf hpc:Core .

hpc:BlockNumberedProcessor a hpc:Processor ;
                           rdfs:subClassOf hpc:Processor ;
                           hpc:hascore a owl:ObjectProperty ;
                           {
                             rdfs:range hpc:Blocknumberedcore
                           }

hpc:CyclicProcessor a hpc:Processor ;
                     rdfs:subClassOf hpc:Processor ;
                     hpc:hascore a owl:ObjectProperty ;
                     {
