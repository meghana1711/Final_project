hpc:Command a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Task a owl:Class .
hpc:Logfile a owl:Class .
hpc:Time a owl:Class .
hpc:SUMMARY owl:DatatypeProperty .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:User .
hpc:isHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .
hpc:hasLogFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Logfile .
hpc:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:isSummarized rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .
hpc:Tasklogfile a owl:Class ;
    rdfs:subClassOf hpc:Logfile .
hpc:LSACCT a hpc:Command ;
    hpc:isSummarized false .
