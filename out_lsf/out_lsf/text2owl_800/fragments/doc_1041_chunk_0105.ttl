hpc:Processowner a owl:Class .
hpc:executionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Processowner ;
    rdfs:range xsd:string .
hpc:shellpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Processowner ;
    rdfs:range xsd:string .
hpc:Binaryfile a owl:Class ;
    rdfs:subClassOf hpc:Shellpath .
hpc:jobid a owl:ObjectProperty ;
    rdfs:domain hpc:Processowner ;
    rdfs:range xsd:string .
hpc:Jobarrayelement a owl:Class ;
    rdfs:subClassOf hpc:Jobid .
hpc:runningjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range hpc:Job .
hpc:Job a owl:Class .
