hpc:Node a owl:Class .
hpc:Partition a owl:Class .

hpc:selecttype a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:selecttypeparameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:nodename a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:partitionname a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
