hpc:Job a owl:Class .
hpc:Submissionqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:TestQueue a hpc:Queue ;
    rdfs:subClassOf hpc:Queue .
hpc:SimulationQueue a hpc:Queue ;
    rdfs:subClassOf hpc:Queue .
hpc:DefaultQueue a hpc:Queue .
hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Submission .
hpc:Submission a owl:Class .
hpc:Script a owl:Class ;
    rdfs:subClassOf hpc:Submission .
hpc:scriptshell a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:scriptinterpreter a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:scriptcoredump a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:scriptifcondition a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:scriptjob a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
hpc:Shell a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:BourneShell a hpc:Shell ;
    rdfs:subClassOf hpc:Shell ;
    rdfs:label "Bourne Shell"@en .
hpc:CShell a hpc:Shell ;
    rdfs:subClassOf hpc:Shell ;
    rdfs:label "C Shell"@en .
