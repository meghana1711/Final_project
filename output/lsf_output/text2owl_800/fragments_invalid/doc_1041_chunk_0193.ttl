hpc:Job a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:jobName ;
                       rdfs:maxLength xsd:integer "4094" ;
                       owl:allValuesFrom rdf:nil ] .

hpc:jobname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasName .

hpc:wildcardcharacter a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobnamerestriction ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdf:type .

hpc:Jobnamerestriction a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:jobName ] .

hpc:Jobdescription a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:jobDescription ;
                       rdfs:maxLength xsd:integer "4094" ] .

hpc:jobdescription a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasDescription .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:jobName ;
                       owl:hasValue hpc:array ] .

hpc:array a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf rdf:type .

hpc:Wildcardinarray a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       rdfs:onProperty hpc:jobName ;
                       owl:hasValue hpc:wildcardCharacter ;
                       owl:onClass hpc:JobArray ] .
