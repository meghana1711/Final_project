@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Advancereservation a owl:Class .
hpc:Advancereservationenhancement a owl:Class .
hpc:Advancereservationscript a owl:Class .
hpc:prescript a owl:ObjectProperty .
hpc:postscript a owl:ObjectProperty .
hpc:brsvaddcommand a owl:ObjectProperty .
hpc:brsvmodcommand a owl:ObjectProperty .
hpc:lsbStartEbrokerd a owl:DatatypeProperty .
hpc:lsbEswitchMethod a owl:DatatypeProperty .
hpc:Datacollection a owl:Class .
hpc:Enhancedenergyaccounting a owl:Class .
hpc:Lsfbeattool a owl:Class .
hpc:Ipmitool a owl:Class .
hpc:Ibmspectrumlsfexplorer a owl:Class .
hpc:lsfEnableBeatService a owl:DatatypeProperty .
hpc:lsfQueryEsFunctions a owl:DatatypeProperty .
hpc:lsfQueryEsServers a owl:DatatypeProperty .
hpc:Dataprovenance a owl:Class .
hpc:Fileprovenance a owl:Class .

hpc:Advancereservation rdfs:subClassOf hpc:Job .
hpc:Advancereservationenhancement rdfs:subClassOf hpc:Advancereservation .
hpc:Advancereservationscript rdfs:subClassOf hpc:Script .

hpc:Prescript rdfs:domain hpc:Advancereservation .
hpc:Postscript rdfs:domain hpc:Advancereservation .
hpc:Brsvaddcommand rdfs:domain hpc:Advancereservationenhancement .
hpc:Brsvmodcommand rdfs:domain hpc:Advancereservationenhancement .
hpc:LsbStartEbrokerd rdfs:range xsd:boolean .
hpc:LsbEswitchMethod rdfs:range xsd:string .

hpc:Enhancedenergyaccounting rdfs:subClassOf hpc:Datacollection .
hpc:Lsfbeattool rdfs:subClassOf hpc:Tool .
hpc:Ipmitool rdfs:subClassOf hpc:Tool .
hpc:Ibmspectrumlsfexplorer rdfs:subClassOf hpc:Software .

hpc:LsfEnableBeatService rdfs:range xsd:boolean .
hpc:LsfQueryEsFunctions rdfs:range xsd:string .
hpc
