hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Candidatehost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Noncandidatehost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Pendingreason a owl:Class ;
    rdfs:subClassOf owl:Thing .

# Object Properties
hpc:hasreason a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Pendingreason .

hpc:affectshosts a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingreason ;
    rdfs:range rdfs:Integer .

# Datatype Properties
hpc:iscandidate a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:totalhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

hpc:totalcandidatehosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

hpc:totalnoncandidatehosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

# LSB_SKIP_FULL_HOSTS parameter
hpc:lsbSkipFullHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean .

# Commands
hpc:bjobsP2 a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Output .

hpc:bjobsP3 a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Output .

# Output
hpc:Output a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Output rdfs:subClass rdf:PlainLiteral ;
    rdfs:range xsd:string .
