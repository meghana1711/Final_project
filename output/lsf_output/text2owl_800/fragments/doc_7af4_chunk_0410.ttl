hpc:Cpulimit a owl:Class .
hpc:defaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:string .
hpc:maximumlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:string .
hpc:hour a xsd:nonNegativeInteger .
hpc:minute a xsd:nonNegativeInteger .
hpc:hostName a xsd:string .
hpc:hostModel a xsd:string .
hpc:signalhandler a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:gracePeriod a xsd:nonNegativeInteger .
hpc:dynamicallycreatedprocesses a owl:ObjectProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range hpc:Job .
hpc:joblevelcpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Runawayjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobusestoomanyresources a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Sigxcpu a owl:Class .
hpc:Sigint a owl:Class .
hpc:Sigterm a owl:Class .
hpc:Sigkill a owl:Class .
