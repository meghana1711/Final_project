hpc:Jobsubmission a owl:Class .
hpc:jobsubmissionstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:integer .
hpc:jobqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:joberror a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:integer .
hpc:LsbSubJobQueue rdfs:subClassOf hpc:Jobqueue .
hpc:LsbSubJobErr rdfs:subClassOf hpc:Joberror .
hpc:LsbNoError rdfs:subClassOf hpc:Joberror .

hpc:lsbBhostsFormat a owl:ObjectProperty .
hpc:lsbHmsTimeFormat a owl:ObjectProperty .
hpc:dataprovenance a owl:ObjectProperty .
hpc:projectname a owl:DatatypeProperty .

hpc:LsbBhostsFormatCustomization a owl:Class ;
    rdfs:subClassOf hpc:LsbBhostsFormat ;
    rdfs:subClassOf hpc:Commanddisplaycustomization .
hpc:LsbHmsTimeFormatCustomization a owl:Class ;
    rdfs:subClassOf hpc:LsbHmsTimeFormat ;
    rdfs:subClassOf hpc:Commanddisplaycustomization .
hpc:DataprovenanceTool a owl:Class ;
    rdfs:subClassOf hpc:Dataprovenance .
hpc:LsfIntegrationForRationalClearcaseObsolete a owl:Class ;
    rdfs:subClassOf hpc:DataprovenanceTool .
hpc:ProjectnameLengthExtension a owl:Class .
hpc:DockerImagePreference a owl:Class .
hpc:DockerImageHostPreference a owl:Class .
hpc:CommandDisplayCustomization a owl:Class .
