hpc:Application a owl:Class .
hpc:RequiresRecompile a owl:ObjectProperty .
hpc:HasSlurmAPI a owl:ObjectProperty .
hpc:ELFFile a owl:Class .
hpc:HasSlurmLibrary a owl:ObjectProperty .
hpc:SlurmVersion a xsd:string .
hpc:CustomSlurmBuild a owl:Class .
hpc:InstalledSlurmVersion a owl:DatatypeProperty .
hpc:SymbolicLinkedSlurm a owl:ObjectProperty .
hpc:PotentialLibraryConflict a owl:Class .

hpc:Application rdfs:subClassOf owl:Thing .
hpc:RequiresRecompile rdfs:domain hpc:Application ;
                          rdfs:range xsd:boolean .
hpc:HasSlurmAPI rdfs:domain hpc:Application ;
                 rdfs:range rdf:Resource .
hpc:ELFFile rdfs:subClassOf owl:Thing .
hpc:HasSlurmLibrary rdfs:domain hpc:ELFFile ;
                     rdfs:range rdf:Resource .
hpc:SlurmVersion rdfs:domain hpc:CustomSlurmBuild ;
                 rdfs:range xsd:string .
hpc:SymbolicLinkedSlurm rdfs:domain hpc:CustomSlurmBuild ;
                        rdfs:range rdf:Resource .
hpc:PotentialLibraryConflict rdfs:subClassOf owl:Thing .
```
