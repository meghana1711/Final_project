hpc:Options a owl:Class .
hpc:prints a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:Resource .

hpc:printsversion a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .

