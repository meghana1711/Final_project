hpc:LsbSkipFullHosts a owl:Class .
hpc:LsbSshXforwardCmd a owl:Class .
hpc:LsbSshStageInExec a owl:Class .

hpc:hasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:LsbSkipFullHosts, hpc:LsbSshXforwardCmd, hpc:LsbSshStageInExec ;
    rdfs:range xsd:string .

hpc:LsbSkipFullHosts rdfs:subClassOf owl:Boolean .
hpc:LsbSshXforwardCmd rdfs:subClassOf owl:String .
hpc:LsbSshStageInExec rdfs:subClassOf owl:String .

hpc:hascommand a owl:ObjectProperty ;
    rdfs:domain hpc:LsbSshXforwardCmd ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:islocatedindirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSshStageInExec ;
    rdfs:range xsd:string .
