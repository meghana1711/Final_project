@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Cluster a owl:Class .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Cacheableitem .
hpc:Cacheableitem a owl:Class .
hpc:cachequery a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cacheresult .
hpc:Cacheresult a owl:Class .
hpc:changegroup a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Group .
hpc:Group a owl:Class .
hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Cacheableitem ;
    rdfs:subClassOf rdf:Resource .
hpc:filepermissionmode a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Tag a owl:Class ;
    rdfs:subClassOf hpc:Cacheableitem .
hpc:tagquery a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hpc:Tagresult .
hpc:Tagresult a owl:Class .
