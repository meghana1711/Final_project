hpc:Rootuser a owl:Class .
hpc:extractpackage a owl:ObjectProperty .
hpc:extractedfilesdirectory a owl:DatatypeProperty .
hpc:tarcommand a owl:DatatypeProperty .
hpc:changedirectory a owl:ObjectProperty .
hpc:editlwsinstallsh a owl:ObjectProperty .
hpc:sourcelsfenvironment a owl:ObjectProperty .
hpc:lsfenvironmentfile a owl:DatatypeProperty .
hpc:installlsfwebservicespackage a owl:ObjectProperty .
hpc:runinstaller a owl:ObjectProperty .
hpc:acceptlicenseagreement a owl:ObjectProperty .

hpc:Rootuser rdfs:subClassOf xsd:string .
hpc:Extractpackage rdfs:domain hpc:Rootuser .
hpc:Extractedfilesdirectory rdfs:range xsd:string .
hpc:Tarcommand rdfs:range xsd:string .
hpc:Changedirectory rdfs:domain hpc:Rootuser .
hpc:Editlwsinstallsh rdfs:domain hpc:Rootuser .
hpc:Sourcelsfenvironment rdfs:domain hpc:Rootuser .
hpc:Lsfenvironmentfile rdfs:range xsd:string .
hpc:Installlsfwebservicespackage rdfs:domain hpc:Rootuser .
hpc:Runinstaller rdfs:domain hpc:Rootuser .
hpc:Acceptlicenseagreement rdfs:domain xsd:integer .
