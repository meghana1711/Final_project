hpc:Template a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a resource template requested by LSF." .

hpc:templateid a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique template name." .

hpc:maxnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of available instances of this template." .
