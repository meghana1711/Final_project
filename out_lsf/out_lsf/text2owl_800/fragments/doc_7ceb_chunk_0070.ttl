hpc:Egocommandmessage a owl:Class .
hpc:LSF_ENABLE_EGO rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Egocommandmessage ;
    rdfs:range xsd:boolean .
hpc:ego_conf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Egocommandmessage ;
    rdfs:range hpc:File .
hpc:vemkd_daemon rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Egocommandmessage ;
    rdfs:range hpc:Daemon .
hpc:Daemon a owl:Class .
hpc:File a owl:Class .
