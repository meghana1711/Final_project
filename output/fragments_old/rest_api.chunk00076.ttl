# Classes
hpc:WCKey a owl:Class .
hpc:Slurm a owl:Class .
hpc:Plugin a owl:Class .
hpc:Client a owl:Class .
hpc:Command a owl:Class .
hpc:Warning a owl:Class .
hpc:Error a owl:Class .

# Object Properties
hpc:hasCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:hasRelease rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:hasVersion rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range hpc:Version .
hpc:hasMajor rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Version ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasMinor rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Version ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasMicro rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Version ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasAccountingStorage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .
hpc:hasName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .
hpc:hasType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .
hpc:hasDataParser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .
hpc:hasSource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
hpc:hasGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
hpc:hasCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command
