hpc:Jobstepcontrol a owl:Class .
hpc:Commandlineoption a owl:Class .
hpc:distribution a owl:ObjectProperty .
hpc:possiblevalues a owl:ObjectProperty .
hpc:description a owl:DatatypeProperty .

hpc:Jobstepcontrol rdfs:subClassOf owl:Class .
hpc:Commandlineoption rdfs:subClassOf hpc:Jobstepcontrol .
hpc:Distribution rdfs:domain hpc:Commandlineoption ;
                    rdfs:range hpc:Distributionoption .
hpc:Possiblevalues rdfs:domain hpc:Distribution ;
                    rdfs:range xsd:string .
hpc:Description rdfs:domain hpc:Distribution ;
                    rdfs:range xsd:string .

hpc:Distributionoption a owl:Class .
hpc:distribution a owl:ObjectProperty ;
                rdfs:range hpc:Distributionoption .
hpc:mblock a owl:ObjectProperty ;
           rdfs:range hpc:Distributionoption .
hpc:cyclic a owl:ObjectProperty ;
           rdfs:range hpc:Distributionoption .
hpc:arbitrary a owl:ObjectProperty ;
             rdfs:range hpc:Distributionoption .
hpc:plane a owl:ObjectProperty ;
           rdfs:range xsd:string .

hpc:ntaskspercore a owl:DatatypeProperty ;
                rdfs:domain hpc:Commandlineoption ;
                rdfs:range xsd:nonNegativeInteger .
hpc:ntaskspersocket a owl:DatatypeProperty ;
                 rdfs:domain hpc:Commandlineoption ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:ntaskspernode a owl:DatatypeProperty ;
                rdfs:domain hpc:Commandlineoption ;
                rdfs:range xsd:nonNegativeInteger .
hpc:relative a owl:ObjectProperty ;
            rdfs:domain hpc:Commandlineoption .

hpc:Optionaltaskdistribution a owl:Class .
hpc:taskbinding a owl:ObjectProperty .
hpc:Slurmconf a owl:Class .
hpc:taskplugin a owl:ObjectProperty ;
             rdfs:range xsd:string .
hpc:Cgroupconf a owl:Class .
hpc:constraincores a owl:DatatypeProperty ;
              rdfs:domain hpc:Cgroupconf ;
              rdfs:range xsd:boolean .
hpc:srun a owl:ObjectProperty ;
          rdfs:domain hpc:Taskbinding ;
          rdfs:range xsd:string .
hpc:cpubind a owl:ObjectProperty ;
            rdfs:domain hpc:Taskbinding .
hpc:ntaskspercore a owl:DatatypeProperty ;
               rdfs:domain hpc:Taskbinding ;
               rdfs:range xsd:nonNegativeInteger .
hpc:distribution a owl:ObjectProperty ;
            rdfs:domain hpc:Taskbinding ;
            rdfs:range xsd:string .
