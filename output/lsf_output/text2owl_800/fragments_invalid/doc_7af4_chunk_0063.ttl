hpc:Applicationprofile a owl:Class .

# Execution Host Environment
hpc:ExecutionHostEnvironment rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

# Proﬁle Value
hpc:ProfileValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

# Overwrites Execution Host Environment
hpc:overwritesexecutionhostenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Profilevalue .

# Changes take effect after badmin reconﬁg
hpc:changeseffectafterbadminreconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Profilevalue .

# Affects pending jobs only
hpc:affectspendingjobsonly a owl:ObjectProperty ;
    rdfs:domain hpc:Profilevalue .

# Running jobs are not affected
hpc:runningjobsnotaffected a owl:ObjectProperty ;
    rdfs:domain hpc:Profilevalue .

# Default Not deﬁned
hpc:Defaultnotdefined a owl:Class .

# ESTIMATED_RUNTIME
hpc:EstimatedRuntime rdf:type owl:Class .

# Syntax
hpc:Syntax rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Format of runtime estimate is same as the RUNLIMIT parameter
hpc:formatofruntimeestimateissameastherunlimitparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Description
hpc:Description rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Used for scheduling purposes only
hpc:usedforschedulingpurposesonly a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Does not kill jobs that exceed this value unless the jobs also exceed a deﬁned RUNLIMIT
hpc:doesnotkilljobsthatexceedthisvalueunlessthejobsalsoexceedarunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Job-level runtime estimate specified by bsub -We overrides the ESTIMATED_RUNTIME setting in an application proﬁle
hpc:joblevelruntimeestimatespecifiedbybsuboverridestheestimatedruntimesettinginanapplicationprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime .

# ESTIMATED_RUNTIME setting in an application proﬁle overrides the ESTIMATED_RUNTIME setting in the queue and cluster
hpc:estimatedruntimesettinginanapplicationprofileoverridestheestimatedruntimesettinginthequeueandcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime .

# Features that use the ESTIMATED_RUNTIME value to schedule jobs
hpc:featuresthatusetheestimatedruntimevaluetoschedulejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Estimatedruntime ;
    rdfs:range hpc:Jobchunking | hpc:Advance
