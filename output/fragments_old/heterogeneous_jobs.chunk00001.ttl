hpc:jobComponent a owl:Class .

hpc:taskDistribution a owl:ObjectProperty .
hpc:taskDistribution rdfs:domain hpc:jobComponent ;
                      rdfs:range xsd:string .

hpc:heterogeneousJob a owl:Class .
hpc:heterogeneousJob rdfs:subClassOf hpc:jobComponent .

hpc:batchScript a owl:Class .
