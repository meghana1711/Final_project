hpc:Jobforwardinginformation a owl:Class .

hpc:Localqueue a owl:Class ;
    rdfs:subClassOf hpc:Jobforwardinginformation ;
    rdfs:domain hpc:Jobforwardinginformation .

hpc:Remotequeue a owl:Class ;
    rdfs:subClassOf hpc:Jobforwardinginformation .

hpc:jobFlow a owl:ObjectProperty ;
    rdfs:domain hpc:Localqueue ;
    rdfs:range xsd:string .

hpc:sndjobsTo a owl:DatatypeProperty ;
    rdfs:domain hpc:Localqueue ;
    rdfs:range xsd:string .

hpc:rcvjobsFrom a owl:DatatypeProperty ;
    rdfs:domain hpc:Localqueue ;
    rdfs:range xsd:string .

hpc:cluster a owl:ObjectProperty ;
    rdfs:domain (hpc:Localqueue | hpc:Remotequeue) ;
    rdfs:range xsd:string .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobforwardinginformation ;
    rdfs:range xsd:string .

hpc:ok a xsd:string .
hpc:disc a xsd:string .
hpc:reject a xsd:string .
