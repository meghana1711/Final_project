@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Advancereservation a owl:Class.
hpc:User a owl:Class.
hpc:Host a owl:Class.
hpc:Slot a owl:Class.
hpc:Configuration a owl:Class.

hpc:hasid a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range xsd:string.
hpc:createdby a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range hpc:User.
hpc:hasuser a owl:ObjectProperty;
    rdfs:domain hpc
