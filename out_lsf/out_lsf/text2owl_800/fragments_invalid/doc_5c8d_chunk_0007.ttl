hpc:Host a owl:Class .
hpc:Wlmhost a owl:Class .
hpc:Lnhost a owl:Class .

# Configuration properties
hpc:lsfconffile a owl:ObjectProperty .
hpc:csmparameters a owl:ObjectProperty .
hpc:lsbmodulesfile a owl:ObjectProperty .
hpc:hostsfile a owl:ObjectProperty .

# WLM specific properties
hpc:wlmparameters a owl:ObjectProperty, rdfs:domain hpc:wlmhost .
hpc:wlmlsbmodules a owl:ObjectProperty, rdfs:domain hpc:wlmhost .
hpc:wlmhosts a owl:ObjectProperty, rdfs:domain hpc:wlmhost .
hpc:Wlmparam LSB_MIG2PEND rdfs:range xsd:integer .
hpc:Wlmparam EGO_DEFINE_NCPUS rdfs:range xsd:string .
hpc:Wlmparam LSF_CSM_LIB_PATH rdfs:range xsd:string .
hpc:Wlmparam LSF_JSM_PATH rdfs:range xsd:string .
hpc:Wlmparam LSB_BJOBS_DISPLAY_ENH rdfs:range xsd:string .
hpc:Wlmparam LSB_SHORT_HOSTLIST rdfs:range xsd:string .
hpc:Wlmparam LSF_HPC_EXTENSIONS rdfs:range xsd:string .
hpc:Wlmparam LSB_BJOBS_PENDREASON_LEVEL rdfs:range xsd:integer .
hpc:Wlmparam LSF_ADD_HOST_PACK_FROM rdfs:range xsd:string .

# LN specific properties
hpc:lnparameters a owl:ObjectProperty, rdfs:domain hpc:lnhost .
hpc:lnlsbmodules a owl:ObjectProperty, rdfs:domain hpc:lnhost .
hpc:lnhosts a owl:ObjectProperty, rdfs:domain hpc:lnhost .
hpc:Lnparam LSF_LIM_PORT rdfs:range xsd:integer .
hpc:Lnparam LSB_MIG2PEND rdfs:range xsd:integer .
hpc:Lnparam LSB_RLA_PORT rdfs:range xsd:integer .
hpc:Lnparam LSF_SERVER_HOSTS rdfs:range xsd:string .
hpc:Lnparam LSF_CSM_LIB_PATH rdfs:range xsd:string .
hpc:Lnparam LSF_JSM_PATH rdfs:range xsd:string .
hpc:Lnparam LSB_CSM_JOBS rdfs:range xsd:string .
hpc:Lnparam LSB_EASY_PTILE rdfs:range xsd:integer .
hpc:Lnparam LSF_ADD_HOST_PACK_FROM rdfs:range xsd:string .
