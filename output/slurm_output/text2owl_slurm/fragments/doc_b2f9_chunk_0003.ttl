hpc:Gpujob a owl:Class .
hpc:Slurmselecttresplugin hpc:hassupportingplugin rdf:true .

hpc:cpuspergpu a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:gpubind a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujob .

hpc:gpufreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:nonNegativeFloat .

hpc:mempergpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:nonNegativeInteger .
