@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:SlurmUser
    a owl:Class ;
    rdfs:subClassOf ( rdf:type owl:Class ) ;
    rdfs:comment "The name of the user that the slurmdbd daemon executes as." .

hpc:SlurmUser
    rdfs:domain ( rdf:type owl:NamedIndividual ) ;
    rdfs:range xsd:string ;
    rdfs:comment "This user must exist on the machine executing the Slurm Database Daemon and have the same UID as the hosts on which slurmctld execute." .

hpc:recommendedSlurmUser
    a owl:Object
