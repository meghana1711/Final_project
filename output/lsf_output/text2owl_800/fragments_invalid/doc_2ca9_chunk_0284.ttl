hpc:Googleprovtemplates a owl:Class .
hpc:region a owl:ObjectProperty ;
    rdfs:domain hpc:Googleprovtemplates ;
    rdfs:range xsd:string .

hpc:Hostproject a owl:Class .

hpc:launchtemplateid a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion .
    rdfs:range xsd:string .

hpc:Hostproviders a owl:Class .
hpc:preprovpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostproviders ;
    rdfs:range xsd:string .
hpc:postprovpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostproviders ;
    rdfs:range xsd:string .
hpc:scripttimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostproviders ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Ibmcloudgen2config a owl:Class .
