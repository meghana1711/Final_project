hpc:Computerserver a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Host a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Job a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:stopcondition a owl:ObjectProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:allValuesFrom (hpc:Job) ] ;
  rdfs:range [ rdf:type rdf:List ; rdf:first hpc:Condition ] .

hpc:Condition a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Cscondition a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] ;
  rdfs:subClassOf hpc:Condition .

hpc:Idletimecondition a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] ;
  rdfs:subClassOf hpc:Condition .

hpc:Swapmemorycondition a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] ;
  rdfs:subClassOf hpc:Condition .

hpc:successexitvalues a owl:DatatypeProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:allValuesFrom (hpc:Job) ] ;
  rdfs:range xsd:nonNegativeInteger .

hpc:requeueExitValues a owl:DatatypeProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:allValuesFrom (hpc:Job) ] ;
  rdfs:range xsd:nonNegativeInteger .

hpc:successExitValues a owl:ObjectProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:allValuesFrom (hpc:Queue) ] ;
  rdfs:range [ rdf:type rdf:List ; rdf:first hpc:Successexitvalue ] .

hpc:Successexitvalue a owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Class ] .
