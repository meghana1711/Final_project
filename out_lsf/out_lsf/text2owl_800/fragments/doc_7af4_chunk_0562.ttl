hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:Resource a owl:Class .
hpc:resourcereserve a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:ResourceReserve rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Backfill rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Reserve rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:PerQueue rdfs:domain hpc:Queue ;
    rdfs:range hpc:Host .
hpc:Hosts rdfs:domain hpc:Queue ;
    rdfs:range hpc:Host .
hpc:Slots rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ResourceUsage rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PerJob rdfs:subClassOf hpc:ResourceUsage .
hpc:PerTask rdfs:subClassOf hpc:ResourceUsage .
hpc:AutoConfig rdfs:domain hpc:Queue ;
    rdfs:range hpc:Configuration .
hpc:ConfigFile rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:ReconfiugCommand rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Timebasedconfig rdfs:subClassOf hpc:AutoConfig .
hpc:Timeexpression rdfs:domain hpc:Timebasedconfig ;
    rdfs:range xsd:string .
hpc:Ifelseconfig rdfs:subClassOf hpc:Timebasedconfig .
hpc:Iftime rdfs:domain hpc:Ifelseconfig ;
    rdfs:range xsd:string .
hpc:Thenconfig rdfs:domain hpc:Ifelseconfig ;
    rdfs:range hpc:Configuration .
hpc:Elseconfig rdfs:domain hpc:Ifelseconfig ;
    rdfs:range hpc:Configuration .
hpc:Resourcetype a owl:Class .
hpc:MEM a hpc:ResourceType .
hpc:SWP a hpc:ResourceType .
hpc:TMP a hpc:ResourceType .
hpc:reservableresource a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcetype ;
    rdfs:range hpc:Resource .
hpc:Mem rdfs:subClassOf hpc:Reservableresource .
hpc:Swp rdfs:subClassOf hpc:Reservableresource .
hpc:Tmp rdfs:subClassOf hpc:Reservableresource .
