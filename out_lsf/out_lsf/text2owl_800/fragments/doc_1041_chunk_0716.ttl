hpc:Troubleshooting a owl:Class .
hpc:lsfNiosDebug a owl:DatatypeProperty .
hpc:lsfLogMask a owl:DatatypeProperty .
hpc:sshX11Forwarding a owl:ObjectProperty .
hpc:Schedule a owl:Class .
hpc:Properties a owl:Class .
hpc:Submission a owl:Class .

# Object properties
hpc:hasparameter a owl:ObjectProperty .
hpc:ispartof a owl:ObjectProperty .

# Datatype properties
hpc:value a owl:DatatypeProperty .

# Subclass relations
hpc:Troubleshooting rdfs:subClassOf hpc:Problemsolving .
hpc:Schedule rdfs:subClassOf hpc:Troubleshooting .
hpc:Properties rdfs:subClassOf hpc:Schedule .
hpc:Submission rdfs:subClassOf hpc:Properties .

# Domain and range restrictions
hpc:Hasparameter rdfs:domain hpc:Troubleshooting ;
  rdfs:range hpc:Parameter .
hpc:Ispartof rdfs:domain hpc:Troubleshooting ;
  rdfs:range hpc:Category .
hpc:Value rdfs:domain hpc:LsfNiosDebug ;
  rdfs:range xsd:integer .
hpc:Value rdfs:domain hpc:LsfLogMask ;
  rdfs:range xsd:string .
hpc:Value rdfs:domain hpc:SshX11Forwarding ;
  rdfs:range xsd:boolean .
