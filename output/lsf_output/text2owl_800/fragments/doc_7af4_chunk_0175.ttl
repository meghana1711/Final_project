hpc:Status a owl:Class .
hpc:triggername a owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:number a owl:DatatypeProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:integer .
hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range rdf:List .
hpc:Jobprovhost a owl:Class .
hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:string .
hpc:eventtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:dateTime .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:idx a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Provisionstatus ;
    rdfs:range xsd:integer .
hpc:ProvisionStarted a owl:NamedIndividual ;
    hpc:status 0 .
hpc:ProvisionDone a owl:NamedIndividual ;
    hpc:status 1 .
hpc:ProvisionFailed a owl:NamedIndividual ;
    hpc:status 2 .
hpc:Status rdfs:subClassOf owl:Class .
hpc:Event rdfs:subClassOf owl:Class .
hpc:Provisionstatus rdfs:subClassOf hpc:Status .
