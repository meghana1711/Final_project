hpc:Jobarray a owl:Class .
hpc:Job a owl:Class .
hpc:Checkpoint a owl:Class .
hpc:hasName an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .
hpc:containsAAA an owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Job .
hpc:job1 an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
hpc:dispatchedTo an owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range hpc:Host .
hpc:dispatchedFrom an owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range hpc:Queue .
hpc:submittedBy an owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range hpc:User .
hpc:all a owl:NamedIndividual ;
    rdf:value "all" .
hpc:Windowsuser a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:hasDomain an owl:DatatypeProperty ;
    rdfs:domain hpc:Windowsuser ;
    rdfs:range xsd:string .
hpc:jobID an owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range xsd:nonNegativeInteger .
hpc:indexList an owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range xsd:string .
hpc:periodicCheckpointing an owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint ;
    rdfs:range xsd:nonNegativeInteger .
hpc:host an owl:Class .
hpc:queue an owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Queue a owl:Class ;
    rdfs:subClassOf xsd:string .
