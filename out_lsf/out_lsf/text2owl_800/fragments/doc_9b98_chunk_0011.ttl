hpc:Datamanager a owl:Class .
hpc:hasmaster a owl:ObjectProperty .
hpc:port a owl:DatatypeProperty .
hpc:status a owl:DatatypeProperty .
hpc:Executioncluster a owl:Class .
hpc:hasdatarequirement a owl:ObjectProperty .
hpc:candidateexecutionclusters a owl:DatatypeProperty .
hpc:queuelevelforwardingdestination a owl:DatatypeProperty .
hpc:dataavailability a owl:DatatypeProperty .
hpc:Remotedatamanager a owl:Class .
hpc:remotedatamanagers a owl:ObjectProperty .
hpc:remotecacherefreshinterval a owl:DatatypeProperty .
hpc:cacheddata a owl:DatatypeProperty .

hpc:Datamanager rdfs:subClassOf owl:Class .
hpc:Executioncluster rdfs:subClassOf owl:Class .
hpc:Remotedatamanager rdfs:subClassOf owl:Class .

hpc:Hasmaster rdfs:domain hpc:Datamanager ;
                 rdfs:range hpc:Datamanager .
hpc:Port rdfs:domain hpc:Datamanager ;
             rdfs:range xsd:integer .
hpc:Status rdfs:domain hpc:Datamanager ;
             rdfs:range xsd:string .
hpc:Hasdatarequirement rdfs:domain hpc:Job ;
                      rdfs:range hpc:Executioncluster .
hpc:Candidateexecutionclusters rdfs:domain hpc:Job ;
                         rdfs:range xsd:string .
hpc:Queuelevelforwardingdestination rdfs:domain hpc:Queue ;
                               rdfs:range xsd:string .
hpc:Dataavailability rdfs:domain hpc:Job ;
                       rdfs:range xsd:string .
hpc:Remotedatamanagers rdfs:domain hpc:Executioncluster ;
                       rdfs:range hpc:Remotedatamanager .
hpc:Remotecacherefreshinterval rdfs:domain hpc:Remotedatamanager ;
                               rdfs:range xsd:integer .
hpc:Cacheddata rdfs:domain hpc:Remotedatamanager ;
                    rdfs:range xsd:integer .
