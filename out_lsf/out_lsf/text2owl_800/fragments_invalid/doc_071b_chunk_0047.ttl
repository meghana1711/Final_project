hpc:Jobexecutionhost a owl:Class .
hpc:Jobcontainer a owl:Class .
hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty .
hpc:JobIndex an owl:DatatypeProperty .
hpc:hostName an owl:DatatypeProperty .
hpc:shellPath an owl:DatatypeProperty .
hpc:binaryPath an owl:DatatypeProperty .
hpc:battach an owl:ObjectProperty .

hpc:Battach rdfs:domain hpc:Job .
hpc:Battach rdfs:range hpc:Jobexecutionhost .
hpc:battach rdfs:subPropertyOf hpc:connectTo .

hpc:Connectto rdfs:domain hpc:Job .
hpc:Connectto rdfs:range (hpc:Jobexecutionhost hpc:Jobcontainer) .

hpc:connectToWithoutOptions rdfs:subPropertyOf hpc:connectTo .
hpc:Connecttowithoutoptions rdfs:domain hpc:Job .

hpc:connectWithShell rdfs:subPropertyOf hpc:connectTo .
hpc:Connectwithshell rdfs:domain hpc:Job .
hpc:Connectwithshell rdfs:range hpc:Jobexecutionhost .

hpc:connectWithSpecifiedShell rdfs:subPropertyOf hpc:connectWithShell .
hpc:Connectwithspecifiedshell rdfs:domain hpc:Job .
hpc:Connectwithspecifiedshell rdfs:range hpc:Jobexecutionhost .
hpc:Shellpath rdfs:range xsd:string .

hpc:connectWithDockerHost rdfs:subPropertyOf hpc:connectTo .
hpc:Connectwithdockerhost rdfs:domain hpc:Job .
hpc:Connectwithdockerhost rdfs:range hpc:Hostname .
hpc:Hostname rdfs:range xsd:string .

hpc:Usedefaultshell rdfs:subClassOf hpc:Jobexecutionhost .
hpc:useDefaultShell rdfs:subPropertyOf hpc:hasDefaultShell .
hpc:Hasdefaultshell rdfs:domain hpc:Jobexecutionhost .
hpc:Hasdefaultshell rdfs:range xsd:string .

hpc:Usespecifiedshell rdfs:subClassOf hpc:Jobexecutionhost .
hpc:useSpecifiedShell rdfs:subPropertyOf hpc:hasSpecifiedShell .
hpc:Hasspecifiedshell rdfs:domain hpc:Jobexecutionhost .
hpc:Hasspecifiedshell rdfs:range xsd:string .

hpc:Isbinary rdfs:subClassOf hpc:Jobexecutionhost .
hpc:isBinary rdfs:subPropertyOf hpc:is .
hpc:Is rdfs:domain hpc:Jobexecutionhost .
hpc:Is rdfs:range xsd:boolean .
