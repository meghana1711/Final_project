hpc:Command a owl:Class .
hpc:debuglevel a owl:DatatypeProperty .
hpc:hostname a owl:ObjectProperty .
hpc:logfileName a owl:DatatypeProperty .
hpc:logqueueSize a owl:DatatypeProperty .
hpc:Log_queue_size_domain rdfs:integer .
hpc:Log_queue_size_range xsd:nonNegativeInteger .

hpc:Badmin a owl:Class .
hpc:badminSchddebug a owl:ObjectProperty .
hpc:BadminSchddebugDomain hpc:badmin .
hpc:BadminSchddebugRange hpc:command .
hpc:Badmin_schddebug_has_arg1 rdfs:label "class_name" .

hpc:Lsadmin a owl:Class .
hpc:lsadminLimdebug a owl:ObjectProperty .
hpc:LsadminLimdebugDomain hpc:lsadmin .
hpc:LsadminLimdebugRange hpc:command .
hpc:Lsadmin_limdebug_has_arg1 rdfs:label "class_name" .
hpc:Lsadmin_limdebug_has_arg2 rdfs:label "debug_level" .
hpc:Lsadmin_limdebug_has_arg3 rdfs:label "logfile_name" .
hpc:Lsadmin_limdebug_has_arg4 rdfs:label "host_name" .
hpc:Lsadmin_limdebug_has_arg5 rdfs:label "host_name" .

hpc:Command rdfs:subClassOf owl:Class .
hpc:Debuglevel rdfs:domain hpc:Command .
hpc:Hostname rdfs:domain hpc:Command .
hpc:LogfileName rdfs:domain hpc:Command .
hpc:LogqueueSize rdfs:domain hpc:Badmin .
