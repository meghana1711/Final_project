hpc:Options a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Displays information in a long multi-line format. Also displays share distribution if shares are configured. Expands the user groups recursively. The expanded list contains only user names; it does not contain the names of subgroups. Duplicate user names are listed only once. Wide format." .

hpc:displaysinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Displays information in a long multi-line format." .

hpc:displayssharedistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Also displays share distribution if shares are configured." .

hpc:expandsusergroups a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Expands the user groups recursively." .

hpc:Expandeduserlist a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The expanded list contains only user names; it does not contain the names of subgroups. Duplicate user names are listed only once." .

hpc:wideformat a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Displays user and user group names without truncating fields." .

hpc:usergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "Displays only information about the specified user groups." .

hpc:usergroupname a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the user group." .

hpc:usergroupinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:List ;
    rdfs:comment "Displays information about the specified user group." .

hpc:Userorsubgroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A user or a subgroup." .

hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Userorsubgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the user or subgroup." .

hpc:subgroupindicator a owl:DatatypeProperty ;
    rdfs:domain hpc:Userorsubgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "A name followed by a slash (/) indicates a subgroup." .

hpc:commandusage a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral
