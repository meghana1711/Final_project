hpc:hasLimit an owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:integer .

hpc:hasChildJobGroup an owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .

hpc:isAttachedToSLA an owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean .

hpc:Jobgroupcleanup a owl:Class ;
    rdfs:subClassOf hpc:Jobgroup .

hpc:Autodeletablejobgroup a owl:Class ;
    rdfs:subClassOf hpc:Jobgroup ;
    hpc:hasLimit rdf:nil ;
    hpc:hasChildJobGroup rdf:nil ;
    hpc:isAttachedToSLA rdf:false .

hpc:Hostgroup a owl:Class .
hpc:hasHost an owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .

hpc:Hostgroupinqueue a owl:Class ;
    rdfs:subClassOf hpc:Hostgroup .

hpc:Hostgroupinhostpartition a owl:Class ;
    rdfs:subClassOf hpc:Hostgroup .

hpc:Hostpartition a owl:Class .

hpc:Hostgroupdefinition a owl:Class .
hpc:usesWildcard an owl:DatatypeProperty ;
    rdfs:domain hpc:Hostgroupdefinition .

hpc:Condensedhostgroup a owl:Class ;
    rdfs:subClassOf hpc:Hostgroup .
