hpc:Installation a owl:Class .
hpc:LsfTop rdfs:domain hpc:Installation ;
    rdfs:range xsd:string .

hpc:Preemption a owl:Class .

hpc:JobControls rdfs:domain hpc:Preemption ;
    rdfs:range xsd:string .

hpc:LicSchedPreemptStop rdfs:domain hpc:Preemption ;
    rdfs:range xsd:boolean .

hpc:Theoreticallimit a owl:Class .

hpc:IbmSpectrumLsfLicenseScheduler rdfs:subClassOf hpc:Theoreticallimit ;
    rdfs:comment "Optimization engine for license utilization." .

hpc:Applicationbehavior a owl:Class ;
    rdfs:subClassOf hpc:Theoreticallimit .

hpc:Licenseinterdependencies a owl:Class ;
    rdfs:subClassOf hpc:Theoreticallimit .

hpc:licensecheckouttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationbehavior ;
    rdfs:range xsd:nonNegativeInteger .

hpc:applicationexecutiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationbehavior ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Lossoflicenseutilization a owl:Class ;
    rdfs:subClassOf hpc:Theoreticallimit .

hpc:Clustermode a owl:Class ;
    rdfs:subClassOf hpc:Lossoflicenseutilization .

hpc:FastDispatch a owl:Class ;
    rdfs:subClassOf hpc:Lossoflicenseutilization .

hpc:Featureservicedomaindatafile a owl:Class .

hpc:Largescaleconfiguration rdfs:subClassOf hpc:Featureservicedomaindatafile ;
    rdfs:comment "Causes potential performance issues with large-scale configuration." .

hpc:Preemptedjobredispatchedbeforependingjobs a owl:Class .

hpc:Accumulatedinusetokens rdfs:domain hpc:Preemptedjobredispatchedbeforependingjobs ;
    rdfs:range xsd:string .

hpc:Preemptedjobresumedbymbschd a owl:Class .

hpc:Incorrecthierarchicalfairshare a owl:Class .

hpc:Blinfo rdfs:domain hpc:Incorrecthierarchicalfairshare ;
    rdfs:range xsd:string .

hpc:OutputoptionG rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:boolean .
