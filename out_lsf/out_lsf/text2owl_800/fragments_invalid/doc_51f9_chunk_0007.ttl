hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a parallel job in an HPC system." .

hpc:hasrack a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "The rack(s) on which the job is placed." .

hpc:minRacks owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The minimum number of racks the job must be placed on." .

hpc:maxRacks owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of racks the job can span." .

hpc:minCUs owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The minimum number of CUs the job must use." .

hpc:maxCUs owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of CUs the job can use." .

hpc:Jobwithminmaxracks a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that must be placed on as few racks as possible, and cannot spread out to more than two racks." ;
    owl:equivalentClass [
        hpc:Job ;
        hpc:minRacks 1 ;
        hpc:maxRacks 2
    ] .
