hpc:Filepath a owl:Class .
hpc:lsfDiscardLog a owl:ObjectProperty .
hpc:LsfDiscardLog rdfs:domain hpc:Filepath ;
    rdfs:range xsd:boolean .
hpc:lsfLogQueueSize a owl:DatatypeProperty .
hpc:LsfLogQueueSize rdfs:domain hpc:Filepath ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsfLogThread a owl:ObjectProperty .
hpc:LsfLogThread rdfs:domain hpc:Filepath ;
    rdfs:range xsd:boolean .
hpc:lsfPlatformCompatibility a owl:ObjectProperty .
hpc:LsfPlatformCompatibility rdfs:domain hpc:Filepath ;
    rdfs:range xsd:string .
hpc:lsfRegFloatHosts a owl:ObjectProperty .
hpc:LsfRegFloatHosts rdfs:domain hpc:Filepath ;
    rdfs:range xsd:boolean .
hpc:lsfRegHostInterval a owl:DatatypeProperty .
hpc:LsfRegHostInterval rdfs:domain hpc:Filepath ;
    rdfs:range xsd:nonNegativeInteger .
