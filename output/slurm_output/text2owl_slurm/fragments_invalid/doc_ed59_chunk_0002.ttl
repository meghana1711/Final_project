hpc:Switch
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Support for mTLS authentication to the fabric manager." .

hpc:ConnectionManagementThreadPool
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Autodetect the available cpus, and automatically set the connection management thread pool size to 2x that value." .
    rdfs:domain hpc:Switch ;
    rdfs:range rdf:Property ;
    rdfs:label "conmgr_threads" .

hpc:Jobcomp
