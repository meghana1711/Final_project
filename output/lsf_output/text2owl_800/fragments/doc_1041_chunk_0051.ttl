    rdfs:domain hpc:Gpdccheck ;
    rdfs:range xsd:string .

hpc:lsbconfdir a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbenvironment ;
    rdfs:range xsd:string .

hpc:lsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbenvironment ;
    rdfs:range xsd:string .

hpc:envdir a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbenvironment ;
    rdfs:range xsd:string .

hpc:checkresult a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpdccheck ;
    rdfs:range xsd:string .

hpc:verbosemode a owl:ObjectProperty ;
    rdfs:domain hpc:Gpdccheck ;
    rdfs:range xsd:boolean .

hpc:classname a owl:ObjectProperty ;
    rdfs:domain hpc:Gpdccheck ;
    rdfs:range xsd:string .

hpc:debuglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpdccheck ;
    rdfs:range xsd:nonNegativeInteger .

hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpdccheck ;
