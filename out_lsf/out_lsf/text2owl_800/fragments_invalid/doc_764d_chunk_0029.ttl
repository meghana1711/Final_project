hpc:Sendjobsqueue a owl:Class .
hpc:Receivejobsqueue a owl:Class .

# Cluster class
hpc:Cluster a owl:Class .

# ConnectionStatus enumeration
hpc:ok a owl:EnumMember ;
   rdfs:label "ok" ;
   rdfs:comment "The two clusters can exchange information and the system is properly configured." .

hpc:disc a owl:EnumMember ;
   rdfs:label "dis" ;
   rdfs:comment "Communication between the two clusters has not been established." .

hpc:reject a owl:EnumMember ;
   rdfs:label "reject" ;
   rdfs:comment "The remote queue rejects jobs from the send-jobs queue." .

# Status property
hpc:hasstatus a owl:ObjectProperty ;
   rdfs:domain hpc:Queue .
hpc:Hasstatus rdfs:range hpc:Connectionstatus .

# Queue properties
hpc:hasname a owl:ObjectProperty ;
   rdfs:domain hpc:Queue .
hpc:Hasname rdfs:range xsd:string .

hpc:belongsto a owl:ObjectProperty ;
   rdfs:domain hpc:Queue .
   rdfs:range hpc:Cluster .

# Application class
hpc:Application a owl:Class .

# Application properties
hpc:hasname a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hasname rdfs:range xsd:string .

hpc:hasdescription a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hasdescription rdfs:range xsd:string .

hpc:hascpulimit a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hascpulimit rdfs:range xsd:string .

hpc:hasfilelimit a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hasfilelimit rdfs:range xsd:integer .

hpc:hasdatalimit a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hasdatalimit rdfs:range xsd:integer .

hpc:hascorelimit a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hascorelimit rdfs:range xsd:integer .

hpc:hasproclimit a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Hasproclimit rdfs:range xsd:integer .

hpc:haspreexec a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Haspreexec rdfs:range xsd:string .

hpc:haspostexec a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:Haspostexec rdfs:range xsd:string .

hpc:hasreqqueueexitvalues a owl:DatatypeProperty ;
   rdfs:domain hpc:Application .
hpc:has
