hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:Pamconfiguration a owl:Class .
hpc:Hasuser rdfs:domain hpc:Pamconfiguration ;
                        rdfs:range hpc:User .
hpc:Hasaccount rdfs:domain hpc:Pamconfiguration ;
                  rdfs:range hpc:Account .
hpc:Isallowed rdfs:domain hpc:Pamconfiguration ;
               rdfs:range xsd:boolean .
hpc:Isrequired rdfs:domain hpc:Pamconfiguration ;
               rdfs:range xsd:boolean .
hpc:Hasfile rdfs:domain hpc:Pamconfiguration ;
               rdfs:range xsd:string .
hpc:Hassense rdfs:domain hpc:Isallowed ;
               rdfs:range xsd:string .
hpc:Hassensevalue rdfs:domain hpc:Isallowed ;
               rdfs:range xsd:string .
hpc:Hasfilevalue rdfs:domain hpc:Hasfile ;
               rdfs:range xsd:string .
hpc:Hasmode rdfs:domain hpc:Hasfile ;
               rdfs:range xsd:integer .
hpc:Hasonerr rdfs:domain hpc:Hasfile ;
               rdfs:range xsd:string .
