@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Project a owl:Class .
hpc:processlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:nonNegativeInteger .

hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Processlimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Minute ;
    rdfs:range xsd:nonNegativeInteger .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Exitcode a owl:Class .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Resourcerequirement a owl:Class .
hpc:resizenotificationcmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:rcaccountname a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:stacklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:nonNegativeInteger .

hpc:signal a owl:DatatypeProperty ;
    rdfs:domain hdf:Project ;
    rdfs:range xsd:string .

hpc:serviceclass a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:smtvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Queue a owl:Class .

hpc:Resourcerequirement a rdfs:subClassOf hpc:Resourcerequirement .
