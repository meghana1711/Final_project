hpc:Unixhost a owl:Class .
hpc:Windowshost a owl:Class .
hpc:Lsfhost a owl:Class .
hpc:eauthkey a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:eautholdkey a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:eautholdkeyexpiry a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:dateTime .
hpc:eauthuseraccount a owl:ObjectProperty ;
    rdfs:domain hpc:Unixhost .
hpc:trusteduseraccount a owl:ObjectProperty ;
    rdfs:domain hpc:Unixhost .
hpc:defaulttrusteduseraccount a owl:ObjectProperty ;
    rdfs:domain hpc:Unixhost ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:range rdf:PlainLiteral "primary LSF administrator" .
hpc:windowsdefaulttrusteduseraccount a owl:ObjectProperty ;
    rdfs:domain hpc:Windowshost ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:range rdf:PlainLiteral "service account" .
