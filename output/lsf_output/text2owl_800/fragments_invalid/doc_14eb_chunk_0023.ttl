hpc:Managementhost a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:Windows a rdfs:subClassOf hpc:Operatingsystem .
hpc:Unix a rdfs:subClassOf hpc:Operatingsystem .
hpc:Linux a rdfs:subClassOf hpc:Operatingsystem .
hpc:Managementhost rdfs:subClassOf hpc:Operatingsystem .

hpc:firsthost a owl:ObjectProperty .
hpc:Firsthost rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Managementhost .

hpc:resourcemanager a owl:ObjectProperty .
hpc:Resourcemanager rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Managementhost .

hpc:controls a owl:ObjectProperty .
hpc:Controls rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Host .

hpc:Managementcandidate a owl:Class .
hpc:Managementhost rdfs:subClassOf hpc:Managementcandidate .

hpc:Failoverhost a owl:Class .
hpc:Managementcandidate rdfs:subClassOf hpc:Failoverhost .

hpc:Sessionmanagerhost a owl:Class .
hpc:sessionmanager a owl:ObjectProperty .
hpc:Sessionmanager rdfs:domain hpc:Sessionmanagerhost ;
    rdfs:range hpc:Sessionmanager .
hpc:Sessionmanagerhost rdfs:subClassOf hpc:Managementhost .

hpc:Computehost a owl:Class .
hpc:Cluster rdfs:subClassOf hpc:Computehost .

hpc:Cpuslot a owl:Class .
hpc:Computehost rdfs:subClassOf hpc:Resourceprovider .
hpc:Resourceprovider rdfs:subClassOf hpc:Host .

hpc:Serviceinstance a owl:Class .
hpc:SessionManager a rdfs:subPropertyOf hpc:Provides .
hpc:Provides rdfs:domain hpc:Cpuslot ;
    rdfs:range hpc:Serviceinstance .

hpc:Application a owl:Class .
hpc:SessionManager rdfs:subPropertyOf hpc:Serves .
hpc:Serves rdfs:domain hpc:Sessionmanager ;
    rdfs:range hpc:Application .
