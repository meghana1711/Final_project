hpc:resshutdown a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List ;
    rdfs:comment "Shuts down RES on the specified hosts or on all hosts in the cluster if the word all is specified." .

hpc:resshutdownconfirmation a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Prompts for confirmation to shutdown RES." .

hpc:restaskexit a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if all remote tasks have exited." .

hpc:resdisableinteraction a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Disables interaction and does not ask for confirmation for shutting down RES." .

hpc:sbdsshutdown a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Shuts down the sbatchd daemon on the specified hosts." .

hpc:sbdsnohostspecified a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "If no host is specified, the local host is assumed." .

hpc:Sbdslocalhost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "Represents the local host." .

hpc:Sbdsbatchserverhost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "Represents a batch server host." .

hpc:sbdsexit a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the sbatchd daemon has exited after receiving the request." .

hpc:sbdsdisableinteraction a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Disables interaction and does not ask for confirmation for shutting down sbatchd." .

hpc:help a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List ;
    rdfs:comment "Displays the syntax and functions of the specified subcommands." .

hpc:quit a owl:ObjectProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Exits the bctrld session." .
