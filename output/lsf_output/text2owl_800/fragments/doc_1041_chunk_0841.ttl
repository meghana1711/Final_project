hpc:TaskAllowedPerSlot
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskset ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of tasks that are allowed per slot. Set by the lsmake -c option." .

hpc:TotalSlotsAllocated
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskset ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of slots allocated. Might be limited by the lsmake -j or lsmake -m option." .

hpc:UpdateFrequency
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskset ;
    rdfs:range xsd:duration ;
    rdfs:comment "The time in the format hh:mm:s. The second value is the number of running tasks. For example:" .

hpc:UpdateFormat
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskset ;
    rdfs:range xsd:string ;
    rdfs:comment "The format of the lsmake.dat file, consisting of two values separated by a comma." .

hpc:IgnoredOptions
    a owl:ObjectProperty ;
    rdfs:domain hpc:Makefile ;
    rdfs:range hpc:Commandoption ;
    rdfs:comment "If a submake in a makefile specifies options that are specific to the lsmake command, they are ignored." .

hpc:IgnoredResourceRequirements
    a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Resourcerequirement ;
    rdfs:comment "The resource requirements of tasks in the remote task list are not considered when lsmake dispatches tasks." .

hpc:CommandLineOptions
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsmake ;
    rdfs:range hpc:Commandoption ;
    rdfs:comment "Only the command-line options are used." .

hpc:SeeAlso
    a owl:ObjectProperty ;
    rdfs:domain hpc:Documentation ;
    rdfs:range hpc:Documentation ;
    rdfs:comment "See also" .

hpc:PasswordLength
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Register ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Passwords must be 3 - 23 characters long." .

hpc:Makefile
    a owl:Class .
hpc:CommandOption
    a owl:Class .
hpc:TaskSet
    a owl:Class ;
    rdfs:subClassOf hpc:Tasklist .
hpc:TaskList
    a owl:Class .
hpc:Task
    a owl:Class .
hpc:Register
    a owl:Class .
hpc:ResourceRequirement
    a owl:Class .
hpc:Documentation
    a owl:Class .
