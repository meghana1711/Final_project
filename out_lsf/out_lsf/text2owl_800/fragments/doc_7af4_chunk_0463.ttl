hpc:LOCAL_MAX_PREEXEC_RETRY
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies the maximum number of times a job can be pre-executed." .

hpc:MANDATORY_EXTSCHED
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies mandatory external scheduling options for the queue." .

hpc:MANDATORY_EXTSCHED
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Queue ] ;
    rdfs:range [ rdf:type hpc:String ] ;
    rdfs:comment "The external scheduler options for the queue." .

hpc:external_scheduler_options
    a owl:DatatypeProperty ;
    rdfs:domain [ rdf:type hpc:MandatoryExtsched ] ;
    rdfs:range xsd:string ;
    rdfs:comment "The options for the external scheduler." .

hpc:MAX_JOB_PREEMPT
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies the maximum number of times a job can be preempted." .

hpc:MAX_JOB_PREEMPT
    a owl:DatatypeProperty ;
    rdfs:domain [ rdf:type hpc:Queue ] ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive "1"^^xsd:integer ;
    rdfs:maxInclusive "INFINIT_INT" ;
    rdfs:comment "The maximum number of times a job can be preempted." .

hpc:INFINIT_INT
    a owl:Datatype ;
    rdfs:subClassOf [ rdf:type xsd:integer ] ;
    rdfs:comment "Defined in lsf.h." .

hpc:MAX_JOB_REQUEUE
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies the maximum number of times to requeue a job automatically." .

hpc:MAX_JOB_REQUEUE
    a owl:DatatypeProperty ;
    rdfs:domain [ rdf:type hpc:Queue ] ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive "1"^^xsd:integer ;
    rdfs:maxInclusive "INFINIT_INT" ;
    rdfs:comment "The maximum number of times to requeue a job automatically." .

hpc:INFINIT_INT
    a owl:Datatype ;
    rdfs:subClassOf [ rdf:type xsd:integer ] ;
    rdfs:comment "Defined in lsf.h." .
