hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Appprofile a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Environmentvariable a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Appprofile ;
    rdfs:range xsd:integer .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:isrunning a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:hasappprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Appprofile .

hpc:hasenvironmentvariable a owl:ObjectProperty ;
    rdfs:domain hpc:Appprofile ;
    rdfs:range hpc:Environmentvariable .

hpc:overwrites a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range hpc:Environmentvariable .

hpc:islast a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:boolean .

hpc:isdefinedbeforecheckpoint a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:boolean .

hpc:isdefinedbeforerequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:boolean .

hpc:isoverwrittenbyuser a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range hpc:Environmentvariable .

hpc:isoverwrittenbyappprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range hpc:Appprofile .
