hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:EnergySavingState rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:PoweredOff rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:WorkingState rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:HostProvisioning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Slots rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostprovisioning ;
    rdfs:range xsd:integer .
hpc:LSFSwitching rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Workingstate .
hpc:bjobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
hpc:lsbEvents rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
hpc:lsbStreams rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
hpc:bresources rdf:type owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:PlainLiteral .
hpc:Powerpolicy a owl:Class .
hpc:NAME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:HOSTS rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:TIME_WINDOW rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:MIN_IDLE_TIME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:integer .
hpc:CYCLE_TIME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:integer .
hpc:APPLIED rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:badminOperation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:closed_Cu_Excl rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
