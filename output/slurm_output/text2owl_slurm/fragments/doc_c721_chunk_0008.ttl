hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:fairsharefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:User5 a hpc:User .
hpc:Job5 a hpc:Job ;
    hpc:fairShareFactor 1.0 .
hpc:User4 a hpc:User .
hpc:Job4 a hpc:Job ;
    hpc:fairShareFactor 0.8 .
hpc:User3 a hpc:User .
hpc:Job3 a hpc:Job ;
    hpc:fairShareFactor 0.7 .
hpc:User2 a hpc:User .
hpc:Job2 a hpc:Job ;
    hpc:fairShareFactor 0.6 .
hpc:User1 a hpc:User .
hpc:Job1 a hpc:Job ;
    hpc:fairShareFactor 0.5 .
