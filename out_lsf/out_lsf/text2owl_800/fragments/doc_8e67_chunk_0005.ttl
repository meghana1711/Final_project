hpc:Sparkapplication a owl:Class .
hpc:Sparkconf a owl:Class .
hpc:Sparkcontext a owl:Class .
hpc:textfile a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkcontext ;
    rdfs:range xsd:string .
hpc:contains a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkcontext ;
    rdfs:range xsd:string .
hpc:count a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkcontext ;
    rdfs:range xsd:integer .
hpc:cache a owl:ObjectProperty ;
    rdfs:domain hpc:Datastream .
hpc:Datastream a owl:Class ;
    rdfs:subClassOf hpc:Rdd .
hpc:Rdd a owl:Class .
hpc:filter a owl:ObjectProperty ;
    rdfs:domain hpc:Datastream ;
    rdfs:range hpc:Datastream .
hpc:Line a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:containsA a owl:DatatypeProperty ;
    rdfs:domain hpc:Line ;
    rdfs:range xsd:boolean .
hpc:containsB a owl:DatatypeProperty ;
    rdfs:domain hpc:Line ;
    rdfs:range xsd:boolean .
