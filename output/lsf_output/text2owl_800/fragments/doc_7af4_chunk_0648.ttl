hpc:Job a owl:Class .

# SubmitTime datatype property
hpc:submittime a owl:DatatypeProperty .
hpc:Submittime rdfs:domain hpc:Job .
hpc:Submittime rdfs:range xsd:string .

# Running status
hpc:running a owl:ObjectProperty .
hpc:Running rdfs:domain hpc:Job .
hpc:Running rdfs:range xsd:boolean .

# Finished status
hpc:finished a owl:ObjectProperty .
hpc:Finished rdfs:domain hpc:Job .
hpc:Finished rdfs:range xsd:boolean .

# NonExistentJob error
hpc:Nonexistentjob a owl:Class .
hpc:Nonexistentjob rdfs:subClassOf hpc:Error .

# Error class
hpc:Error a owl:Class .

# LSB_BJOBS_DISPLAY_ENH property
hpc:lsbBjobsDisplayEnh a owl:ObjectProperty .
hpc:LsbBjobsDisplayEnh rdfs:domain hpc:Job .
hpc:LsbBjobsDisplayEnh rdfs:range xsd:boolean .

# LSB_BJOBS_FORMAT property
hpc:lsbBjobsFormat a owl:DatatypeProperty .
hpc:LsbBjobsFormat rdfs:domain hpc:Job .
hpc:LsbBjobsFormat rdfs:range xsd:string .
