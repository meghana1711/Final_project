hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:Reservation a owl:Class .
hpc:ReservationName rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:StartTime rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:EndTime rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:Duration rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:NodeCnt rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Features rdf:type rdf:Property ;
    rdfs:domain hpc:Reservation ;
