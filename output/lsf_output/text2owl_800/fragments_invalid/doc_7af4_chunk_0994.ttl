@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:EgoAdminPassword a owl:Class .
hpc:lsfEgoAdminPasswd a owl:ObjectProperty ;
    rdfs:domain hpc:EgoAdminPassword ;
    rdfs:range xsd:string .

hpc:EgoAdminUser a owl:Class .
hpc:lsfEgoAdminUser a owl:ObjectProperty ;
    rdfs:domain hpc:EgoAdminUser ;
    rdfs:range xsd:string .

hpc:LsfHostUuid a owl:Class .
hpc:lsfHostUuid a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfHostUuid ;
    rdfs:range xsd:string .
