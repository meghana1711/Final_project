hpc:Computeunit a owl:Class .
hpc:hastype a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunittype .
hpc:Computeunittype a owl:Class .
hpc:isparentof a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunit .
hpc:hascondense a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit .
hpc:Computeunittype rdfs:subClassOf xsd:string .
