hpc:Managementhost a owl:Class .
hpc:Managementcandidatehost a owl:Class .
hpc:masterbatchdaemon a owl:ObjectProperty .
hpc:serverbatchdaemon a owl:ObjectProperty .
hpc:Masterlim a owl:Class .
hpc:Slavelim a owl:Class .
hpc:Masterelim a owl:Class .
hpc:masterqueueparentqueue a owl:ObjectProperty .
hpc:slavequeuechildqueue a owl:ObjectProperty .
hpc:masteresub a owl:ObjectProperty .
hpc:serverconfigfile a owl:DatatypeProperty .
hpc:Masterhost rdfs:subClassOf hpc:Managementhost .
hpc:Managementcandidatehost rdfs:subClassOf hpc:Managementhost .
hpc:Masterbatchdaemon rdfs:domain hpc:Managementhost ;
                          rdfs:range hpc:Masterbatchdaemon .
hpc:Serverbatchdaemon rdfs:domain hpc:Managementhost ;
                          rdfs:range hpc:Serverbatchdaemon .
hpc:Masterlim rdfs:subClassOf hpc:Managementhost .
hpc:Slavelim rdfs:subClassOf hpc:Managementhost .
hpc:Masterelim rdfs:subClassOf hpc:Managementhost .
hpc:Masterqueueparentqueue rdfs:domain hpc:Masterqueue ;
                             rdfs:range hpc:Queue .
hpc:Slavequeuechildqueue rdfs:domain hpc:Slavequeue ;
                             rdfs:range hpc:Queue .
hpc:Masteresub rdfs:domain hpc:Managementhost ;
                          rdfs:range hpc:Esub .
hpc:Serverconfigfile rdfs:domain hpc:Managementhost ;
                          rdfs:range xsd:string .
hpc:lsfgpuresourceignore a owl:DatatypeProperty .
hpc:lsfgpuautoconfig a owl:DatatypeProperty .
hpc:lsbgpunewsyntax a owl:DatatypeProperty .
hpc:Lsfgpuresourceignore rdfs:domain hpc:Managementhost ;
                          rdfs:range xsd:string .
hpc:Lsfgpuautoconfig rdfs:domain hpc:Managementhost ;
                          rdfs:range xsd:string .
hpc:Lsbgpunewsyntax rdfs:domain hpc:Managementhost ;
                          rdfs:range xsd:string .
