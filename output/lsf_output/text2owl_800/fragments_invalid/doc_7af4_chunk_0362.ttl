hpc:Preexecexcludehostexitvalues a owl:Class .
hpc:Hasexitvalue rdfs:domain hpc:Preexecexcludehostexitvalues ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:minimum 1 ;
    rdfs:maximum 254 ;
    rdfs:excludedValue 99 .

hpc:PreExecExcludeHostExitValues_all a owl:NamedIndividual ;
    hpc:hasExitValue rdf:nil .

hpc:PreexecexcludehostexitvaluesList a owl:Class ;
    rdfs:subClassOf hpc:Preexecexcludehostexitvalues .

hpc:preexecexcludehostexitvaluesListMember a owl:ObjectProperty ;
    rdfs:domain hpc:PreexecexcludehostexitvaluesList ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Privilegeduserforcebkill a owl:Class .
hpc:Hasvalue rdfs:domain hpc:Privilegeduserforcebkill ;
    rdfs:range xsd:string ;
    rdfs:literal true 'Y' .

hpc:PrivilegedUserForceBkill_default a owl:NamedIndividual .
