hpc:Feature a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:licensename a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .
hpc:servicedomainname a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string .
hpc:totaltokens a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:totalalloc a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:totaluse a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:integer .
hpc:Cluster a owl:Class .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:share a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
hpc:allocatedbyblddaemon a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .
hpc:clustermodesummaryoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Servicedomain .
hpc:clusteroutput a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Feature .
