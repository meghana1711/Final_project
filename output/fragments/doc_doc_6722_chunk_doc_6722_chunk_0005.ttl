hpc:BurstBufferFunction a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:CanBeKilledFunction a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferFunction .

hpc:CannotBeKilledFunction a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferFunction .

hpc:CalledFromSlurmctldFunction a owl:Class ;
    rdfs:subClassOf hpc:CannotBeKilledFunction .

hpc:CalledFromSlurmscriptdFunction a owl:Class ;
    rdfs:subClassOf hpc:CanBeKilledFunction .

hpc:CanBeKilledBySlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:CanBeKilledFunction ;
    rdfs:range rdf:Resource .

hpc:HasTimeout a owl:ObjectProperty ;
    rdfs:domain hpc:BurstBufferFunction ;
    rdfs:range xsd:nonNegativeInteger .
```
