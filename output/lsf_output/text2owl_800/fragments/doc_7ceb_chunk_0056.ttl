hpc:ProcessGroup
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a process group in LIM." .

hpc:ParentProcessID
    a owl:ObjectProperty ;
    rdfs:domain hpc:Processgroup ;
    rdfs:range xsd:integer ;
    rdfs:comment "The parent process ID of a process group." .

hpc:OrphanedProcess
    a owl:Class ;
    rdfs:subClassOf hpc:Processgroup ;
    rdfs:comment "A process group that is orphaned from its parent process." .

hpc:DaemonizedProcess
    a owl:Class ;
    rdfs:subClassOf hpc:Processgroup ;
    rdfs:comment "A process group that daemonizes itself." .

hpc:JobResProcessGroup
    a owl:Class ;
    rdfs:subClassOf hpc:Processgroup ;
    rdfs:comment "The process group under which a job runs initially." .

hpc:TrackableProcessGroup
    a owl:Class ;
    rdfs:subClassOf hpc:Processgroup ;
    rdfs:comment "A process group that can be tracked by PIM as part of a job." .

hpc:LSFHost
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a host used by LSF." .

hpc:HostFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the lsb.hosts file." .
