hpc:SelectConsTresPlugin a owl:Class .
hpc:Slurm a owl:Class .
hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:Partition a owl:Class .
hpc:ConsumableResource a owl:Class .
hpc:CR_Socket_Memory rdf:type hpc:ConsumableResource ;
    rdfs:label "CR_Socket_Memory"@en .
hpc:CR_CPU_Memory rdf:type hpc:ConsumableResource ;
    rdfs:label "CR_CPU_Memory"@en .

hpc:enabledBy a owl:ObjectProperty ;
    rdfs:domain hpc:SelectConsTresPlugin ;
    rdfs:range hpc:Slurm .

hpc:coScheduledOn a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:hasConsumableResource a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:ConsumableResource .

hpc:hasState a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:hasCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasSCTranslation a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Partition .

hpc:hasJob a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:Job .

hpc:hasName a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasStateTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:hasNodes a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:hasNodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasReason a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeList ;
    rdfs:range xsd:string .

hpc:hasExclusiveMode a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:boolean .

hpc:incompatible
