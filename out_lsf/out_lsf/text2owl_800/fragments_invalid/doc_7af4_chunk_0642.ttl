hpc:Lsresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Lsf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Computingsystem .

hpc:Haslsresource hpc:objectproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsresource .

hpc:LsbAfsBinDir hpc:datatypeproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:LsbAfsJobSupport hpc:datatypeproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral "Y"^^xsd:string ;
    rdfs:range rdf:PlainLiteral "N"^^xsd:string .

hpc:LsbAfsJobSupportSequentialjob hpc:objectproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Job .

hpc:LsbAfsJobSupportBlaunchjob hpc:objectproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Job .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workload .

hpc:Hasafsjobsupport hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:LsbAfsJobSupport .

hpc:Hasafsbindir hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:afsBinDirSearchOrder a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first xsd:string ;
    rdfs:range rdf:rest hpc:AfsBinDirSearchOrder .

hpc:AFS_BIN_DIR_SEARCH_ORDER_item1 a owl:NamedIndividual ;
    rdf:value "/bin" .

hpc:AFS_BIN_DIR_SEARCH_ORDER_item2 a owl:NamedIndividual ;
    rdf:value "/usr/bin" .

hpc:AFS_BIN_DIR_SEARCH_ORDER_item3 a owl:NamedIndividual ;
    rdf:value "/usr/local/bin" .

hpc:AFS_BIN_DIR_SEARCH_ORDER_item4 a owl:NamedIndividual ;
    rdf:value "/usr/afs/bin" .

hpc:Aklog a owl:Class ;
    rdfs:subClassOf hpc:Afsbinary .

hpc:Hasaklog hpc:objectproperty ;
    rdfs:domain hpc:Lsresource ;
    rdfs:range hpc:Ak
