hpc:Hadoopinstallationdirectory a owl:Class .
hpc:usehdfs a owl:ObjectProperty ;
    rdfs:domain hpc:Hadoopinstallationdirectory ;
    rdfs:range xsd:boolean .
hpc:Hdfsfilesystem a owl:Class .
hpc:jobbasedhadoopcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Hadoopinstallationdirectory ;
    rdfs:range hpc:Jobbasedhadoopcluster .
hpc:Jobbasedhadoopcluster a owl:Class .
hpc:jobdebug a owl:ObjectProperty ;
    rdfs:domain hpc:Jobbasedhadoopcluster ;
    rdfs:range xsd:boolean .
hpc:Csmintegrationpackage a owl:Class .
hpc:downloadcsmintegration a owl:ObjectProperty ;
    rdfs:domain hpc:Csmintegrationpackage ;
    rdfs:range xsd:string .
hpc:Ibmpower a owl:Class .
hpc:Lsfwithcsm a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Lsfjobwithcsm a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Directdatastagingjobwithcsm a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Csmcommandoptions a owl:Class .
