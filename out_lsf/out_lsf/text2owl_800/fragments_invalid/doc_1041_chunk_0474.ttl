hpc:Recursivesharetreeoutput a owl:Class ;
   rdfs:subClassOf hpc:Commandoutput .

hpc:Fairshareschedulingpolicy a owl:Class ;
   rdfs:subClassOf hpc:Schedulingpolicy .

hpc:Bqueue a owl:Class ;
   rdfs:subClassOf hpc:Computingresource .

hpc:Job a owl:Class ;
   rdfs:subClassOf hpc:Workflow .

hpc:Message a owl:Class ;
   rdfs:subClassOf hpc:Dataentity .

hpc:Datafile a owl:Class ;
   rdfs:subClassOf hpc:File .

# Object Properties
hpc:hasschedulingpolicy a owl:ObjectProperty ;
   rdfs:domain hpc:Queue ;
   rdfs:range hpc:Schedulingpolicy .

hpc:isassociatedwith a owl:ObjectProperty ;
   rdfs:domain hpc:Queue ;
   rdfs:range hpc:Bqueue .

hpc:readsmessages a owl:ObjectProperty ;
   rdfs:domain hpc:Job ;
   rdfs:range hpc:Message .

hpc:hasmessageindex a owl:ObjectProperty ;
   rdfs:domain hpc:Job ;
   rdfs:range xsd:nonNegativeInteger .

hpc:hasattacheddatafile a owl:ObjectProperty ;
   rdfs:domain hpc:Job ;
   rdfs:range hpc:Datafile .

hpc:canreadmessages a owl:ObjectProperty ;
   rdfs:domain hpc:User ;
   rdfs:range hpc:Job .

hpc:canreaddatafiles a owl:ObjectProperty ;
   rdfs:domain hpc:User ;
   rdfs:range hpc:Datafile .

# Datatype Properties
hpc:hasjobid a owl:DatatypeProperty ;
   rdfs:domain hpc:Command .
   rdfs:range xsd:string .

hpc:hasjobname a owl:DatatypeProperty ;
   rdfs:domain hpc:Command .
   rdfs:range xsd:string .

hpc:hasmessagedescription a owl:DatatypeProperty ;
   rdfs:domain hpc:Message .
   rdfs:range xsd:string .

hpc:hasfiletype a owl:DatatypeProperty ;
   rdfs:domain hpc:Datafile .
   rdfs:range xsd:string .
