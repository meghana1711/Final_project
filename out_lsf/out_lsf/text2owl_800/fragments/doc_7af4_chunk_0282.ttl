hpc:Mbatchquerycommand a owl:Class .
hpc:Commandfield1 rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:string .
hpc:Commandfield2 rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:string .
hpc:User rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:string .
hpc:Sendinghost rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:string .
hpc:Maxdatasize rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:decimal .
hpc:Queryoptions rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range xsd:string .
hpc:Logfilelocation rdfs:domain owl:Thing ;
    rdfs:range xsd:string .
hpc:setbycommandline a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchquerycommand ;
    rdfs:range owl:Thing .
hpc:overridesothersettings a owl:ObjectProperty ;
    rdfs:domain hpc:Logfilelocation ;
    rdfs:range owl:Thing .
hpc:defaultsetting a owl:ObjectProperty ;
    rdfs:domain hpc:Logfilelocation ;
    rdfs:range owl:Thing .
