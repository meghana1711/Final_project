hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job that reads its input from a file and stores standard output and error in files." .

hpc:jobEmailNotification a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether email notifications are sent for a job." .

hpc:jobEmailNotificationOff a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Value 'N' or 'n' disables email notifications for a job." .

hpc:jobEmailNotificationEnvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobEnvironment ;
    rdfs:comment "Environment variable that controls email notifications for a job." .

hpc:JobEnvironment a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Environment variables associated with a job." .

hpc:lsbJobReportMail a owl:ObjectProperty ;
    rdfs:domain hpc:JobEnvironment ;
    rdfs:range xsd:string ;
    rdfs:comment "When set in lsf.conf, email notifications for all jobs are disabled." .

hpc:esubJobSubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobSubmission ;
    rdfs:comment "Method of submitting a job using bsub –a xxx." .

hpc:esubJobSubmissionEmailNotification a owl:ObjectProperty ;
    rdfs:domain hpc:EsubJobSubmission ;
    rdfs:range hpc:JobEmailNotification ;
    rdfs:comment "Email notifications for a job submitted using bsub –a xxx." .

hpc:esubJobSubmissionEmailNotificationOff a owl:DatatypeProperty ;
    rdfs:domain hpc:EsubJobSubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "Value 'N' or 'n' disables email notifications for a job submitted using bsub –a xxx." .

hpc:esubScriptModifyEnvfile a owl:ObjectProperty ;
    rdfs:domain hpc:EsubJobSubmission ;
    rdfs:range hpc:Script ;
    rdfs:comment "Script used to modify the environment for a job submitted using bsub –a xxx." .
