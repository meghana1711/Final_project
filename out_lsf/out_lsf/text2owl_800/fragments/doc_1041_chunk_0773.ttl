hpc:Host a owl:Class .
hpc:className a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:debugLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:logFile a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:daemonName a owl:DatatypeProperty ;
    rdfs:domain hpc:LogFile .
hpc:localHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:Cluster a owl:Class .
hpc:submittedFrom a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:LocalHost .
hpc:ClassLcAfs a owl:Class ;
    rdfs:subClassOf hpc:Class .
hpc:ClassLc2Afs a owl:Class ;
    rdfs:subClassOf hpc:Class .
