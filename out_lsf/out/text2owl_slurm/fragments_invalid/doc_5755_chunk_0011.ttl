hpc:Node a owl:Class.
hpc:threadpercore a owl:DatatypeProperty.
hpc:Node hpc:Threadpercore rdfs:domain hpc:Node ;
                            rdfs:range xsd:nonNegativeInteger .

hpc:Job a owl:Class.
hpc:tasks a owl:DatatypeProperty.
hpc:Job hpc:Tasks rdfs:domain hpc:Job ;
              rdfs:range xsd:nonNegativeInteger .

hpc:Task a owl:Class.
hpc:assignedtonode a owl:ObjectProperty.
hpc:Task hpc
