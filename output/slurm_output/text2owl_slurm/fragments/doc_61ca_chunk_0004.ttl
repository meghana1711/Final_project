hpc:Jobrecord a owl:Class .
hpc:hasasyncprocessing a owl:ObjectProperty .
hpc:Hasasyncprocessing rdfs:domain hpc:Jobrecord ;
                          rdfs:range xsd:boolean .
hpc:Jobresult a owl:Class ;
                 rdfs:subClassOf [ a owl:Class ;
                                    rdfs:subClassOf owl:Thing ] .
hpc:Jobresult rdfs:subClassOf rdf:List .
hpc:Jobresult rdfs:subClassOf [ a owl:Class ;
                                   rdfs:subClassOf owl:Restriction ;
                                   owl:onProperty hpc:hasStatusCode ;
                                   owl:hasValue xsd:integer ] .
hpc:hasstatuscode a owl:DatatypeProperty ;
                    rdfs:domain hpc:Jobresult ;
                    rdfs:range xsd:integer .
hpc:SLURM_SUCCESS a xsd:integer .
hpc:SLURM_ERROR a xsd:integer .
