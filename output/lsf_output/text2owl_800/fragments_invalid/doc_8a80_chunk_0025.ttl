hpc:Lsfconfiguration a owl:Class .
hpc:Feature a owl:Class .
hpc:Cluster a owl:Class .

# Object Properties
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:hasrestrictfeaturename a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration .

hpc:hasrlmstatpath a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .

hpc:hasstandbyconntimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer .

hpc:belongstocluster a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster .

# Datatype Properties
hpc:hasnamewithhyphen a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

# Subclass Relations
hpc:Lsfconfiguration a owl:Class .
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty hpc:hasNameWithHyphen ;
        owl:hasValue "" ;
        owl:allValuesFrom xsd:string ] ] .

hpc:Feature a owl:Class .
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty hpc:hasNameWithHyphen ;
        owl:hasValue "" ;
        owl:someValuesFrom xsd:string ] ] .

# Data Type Restrictions
hpc:Rlmstatpath rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .

hpc:Standbyconntimeout rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer .

# Default Values
hpc:Lsfconfiguration a owl:Class .
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty hpc:RESTRICT_FEATURE_NAME ;
        owl:hasValue "N" ;
        owl:datatype xsd:string ] ] .

hpc:RLMSTAT_PATH rdf:value "LMSTAT_PATH" .
