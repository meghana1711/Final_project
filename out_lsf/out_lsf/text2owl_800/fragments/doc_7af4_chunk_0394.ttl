hpc:Queuedefinition a owl:Class ;
    rdfs:subClassOf hpc:Resourcedefinition .

hpc:hasqueuename a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .

hpc:includesfile a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .

hpc:administrators a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .

hpc:administratorsRange a rdfs:Class ;
    rdfs:subClassOf xsd:string .

hpc:administratorsDomain a rdfs:Class ;
    rdfs:subClassOf hpc:Queuedefinition .

hpc:apspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:decimal .
