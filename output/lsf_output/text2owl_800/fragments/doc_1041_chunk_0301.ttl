hpc:Filteredjob a owl:Class .
hpc:Resource a owl:Class .
hpc:Resources a owl:Class .
hpc:hasresource a owl:ObjectProperty .
hpc:hasresources a owl:ObjectProperty .

hpc:Filteredjob rdfs:subClassOf hpc:Job .
hpc:Resource rdfs:subClassOf rdf:Resource .
hpc:Resources rdfs:subClassOf rdf:Bag .

hpc:Hasresource rdfs:domain hpc:Job .
hpc:Hasresources rdfs:domain hpc:Filteredjob .
hpc:Hasresource rdfs:range hpc:Resource .
hpc:Hasresources rdfs:range hpc:Resources .

hpc:filteredjobbyresource a owl:ObjectProperty .
hpc:filteredjobbyresources a owl:ObjectProperty .

hpc:Filteredjobbyresource rdfs:domain hpc:Filteredjob .
hpc:Filteredjobbyresources rdfs:domain hpc:Filteredjob .
hpc:Filteredjobbyresource rdfs:range hpc:Resource .
hpc:Filteredjobbyresources rdfs:range hpc:Resources .

hpc:Filteredbyresource1 rdfs:subClassOf hpc:Filteredjobbyresource .
hpc:Filteredbyresource2 rdfs:subClassOf hpc:Filteredjobbyresource .
hpc:Filteredbyresources rdfs:subClassOf hpc:Filteredjobbyresources .

hpc:FilteredByResource1 rdfs:subPropertyOf hpc:hasResource .
hpc:FilteredByResource2 rdfs:subPropertyOf hpc:hasResource .
hpc:FilteredByResources rdfs:subPropertyOf hpc:hasResources .

hpc:alternativeresources a owl:ObjectProperty .

hpc:Alternativeresources rdfs:domain hpc:Rusage .
hpc:Alternativeresources rdfs:range hpc:Rusage .

hpc:Suspendedjob a owl:Class .
hpc:suspendingreason a owl:DatatypeProperty .

hpc:Suspendedjob rdfs:subClassOf hpc:Job .
hpc:Suspendedjob rdfs:subClassOf hpc:Filteredjob .

hpc:Suspendedjob rdfs:range xsd:boolean .
hpc:Suspendingreason rdfs:domain hpc:Suspendedjob .
hpc:Suspendingreason rdfs:range xsd:string .

hpc:State a owl:Class .
hpc:bjobs a owl:ObjectProperty .

hpc:State rdfs:subClassOf rdf:Resource .
hpc:Bjobs rdfs:domain hpc:Job .
