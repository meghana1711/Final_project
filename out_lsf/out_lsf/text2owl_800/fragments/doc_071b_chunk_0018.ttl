hpc:Lsfcluster a owl:Class .
hpc:Rootuser a owl:Class .
hpc:Limdaemon a owl:Class .
hpc:Mbatchddaemon a owl:Class .
hpc:reconfigcommand a owl:ObjectProperty .
hpc:Checksforconfigurationerrors rdfs:domain hpc:Reconfigcommand ;
                                   rdfs:range xsd:boolean .
hpc:Promptsforrestart rdfs:domain hpc:Reconfigcommand ;
                      rdfs:range xsd:string .
hpc:Restartsldaemononmanagementhosts rdfs:domain hpc:Reconfigcommand ;
                                      rdfs:range xsd:boolean .
hpc:Restartsldaemononallhosts rdfs:domain hpc:Reconfigcommand ;
                               rdfs:range xsd:boolean .
hpc:Unrecoverableerrors rdfs:domain hpc:Reconfigcommand ;
                        rdfs:range xsd:boolean .
hpc:Cancelsreconfiguration rdfs:domain hpc:Reconfigcommand ;
                           rdfs:range xsd:boolean .
hpc:badminreconfigcommand a owl:ObjectProperty .
hpc:Checksforconfigurationerrors rdfs:domain hpc:Badminreconfigcommand ;
                                   rdfs:range xsd:boolean .
hpc:Unrecoverableerrors rdfs:domain hpc:Badminreconfigcommand ;
                        rdfs:range xsd:boolean .
hpc:Cancelsreconfiguration rdfs:domain hpc:Badminreconfigcommand ;
                           rdfs:range xsd:boolean .
hpc:Lsfadminuser a owl:Class .
hpc:logsontohost a owl:ObjectProperty .
hpc:Isrootorlsfadmin rdfs:domain hpc:Logsontohost ;
                     rdfs:range hpc:Rootuser .
hpc:runslsadminreconfig a owl:ObjectProperty .
hpc:runsbadminreconfig a owl:ObjectProperty .
hpc:Lsfcluster rdfs:subClassOf owl:Class .
hpc:Rootuser rdfs:subClassOf owl:Class .
hpc:Limdaemon rdfs:subClassOf owl:Class .
hpc:Mbatchddaemon rdfs:subClassOf owl:Class .
hpc:Lsfadminuser rdfs:subClassOf owl:Class .
