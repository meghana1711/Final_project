hpc:Executionhost a owl:Class .
hpc:Firstexecutionhost rdfs:subClassOf hpc:Executionhost .
hpc:Nonfirstexecutionhost rdfs:subClassOf hpc:Executionhost .

hpc:heartbeatmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Nonfirstexecutionhost ;
    rdfs:range hpc:Executionhost .

hpc:acknowledgmentmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range hpc:Nonfirstexecutionhost .

hpc:resourceusagemessage a owl:ObjectProperty ;
    rdfs:domain hpc:Nonfirstexecutionhost ;
    rdfs:range hpc:Executionhost .

hpc:lsbDjobHbInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonfirstexecutionhost .

hpc:lsbDjobRuInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonfirstexecutionhost .

hpc:lsfResAliveTimeout a owl:DatatypeProperty .

hpc:djobHbInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:djobRuInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:LsbDjobHbInterval rdfs:range xsd:nonNegativeInteger .
hpc:LsbDjobRuInterval rdfs:range xsd:nonNegativeInteger .
hpc:DjobHbInterval rdfs:range xsd:nonNegativeInteger .
hpc:DjobRuInterval rdfs:range xsd:nonNegativeInteger .
