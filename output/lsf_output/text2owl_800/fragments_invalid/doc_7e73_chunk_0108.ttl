hpc:Ssdmounting a owl:Class .
hpc:exampleCode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ssdmounting ;
    rdfs:range hpc:Examplecode .

hpc:Examplecode a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       owl:equivalentClass [ a owl:Class ;
                                              rdf:type owl:Restriction ;
                                              owl:onProperty hpc:exampleCode ;
                                              owl:hasValue "<LSF_TOP>/<LSF_VERSION>/resource_connector/google/scripts/example_user_data.sh" ] ] .

hpc:Lsfinstance a owl:Class .
hpc:preemptibleVMInstance rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstance ;
    rdfs:range hpc:Preemptiblevminstance .

hpc:Preemptiblevminstance a owl:Class .
hpc:launchInstanceTemplate rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preemptiblevminstance ;
    rdfs:range hpc:Launchinstancetemplate .

hpc:Launchinstancetemplate a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       owl:equivalentClass [ a owl:Class ;
                                              rdf:type owl:Restriction ;
                                              owl:onProperty hpc:launchInstanceTemplateId ;
                                              owl:hasValue "template-f1-micro" ] ] .

hpc:LSFInstanceStartupScript rdf:type owl:ObjectProperty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstance ;
    rdfs:range xsd:string .

hpc:lsfinstancestartupscriptvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstancestartupscript ;
    rdfs:range xsd:string .

hpc:LSFInstanceStartupScriptValue "lsf_daemons start" .
hpc:Lsfinstancestartupscript hpc:lsfinstancestartupscriptvalue .

hpc:LSFInstanceStartupScriptUpdate rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstance ;
    rdfs:range hpc:Lsfinstancestartupscript .
