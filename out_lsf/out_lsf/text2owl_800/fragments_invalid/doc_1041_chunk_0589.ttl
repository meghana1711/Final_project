hpc:esubargument a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Arguments passed to esub or epsub." .

hpc:epsubargument a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Arguments passed to epsub." .

hpc:specialcharacter a owl:ObjectProperty ;
    rdfs:domain hpc:Esubargument ;
    rdfs:range xsd:string ;
    rdfs:comment "Special characters allowed in an esub or epsub argument." .

hpc:variable a owl:ObjectProperty ;
    rdfs:domain hpc:Esubargument ;
    rdfs:range xpc:ESubArgument ;
    rdfs:comment "Variables in an esub or epsub argument." .

hpc:programoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Esubargument ;
    rdfs:range xsd:string ;
    rdfs:comment "Program output in an esub or epsub argument." .

hpc:escapecharacter a owl:ObjectProperty ;
    rdfs:domain hpc:Esubargument ;
    rdfs:range xsd:string ;
    rdfs:comment "Escape character used in an esub or epsub argument." .

hpc:argumentwithseparators a owl:ObjectProperty ;
    rdfs:domain hpc:Esubargument ;
    rdfs:range xsd:string ;
    rdfs:comment "Arguments containing separators and space characters." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Esub a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job submitted with an esub." .

hpc:Epsub a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job submitted with an epsub." .

hpc:MaxArgumentLength a xsd:integer ;
    rdfs:comment "Maximum length allowed for an esub/epsub argument." .

hpc:MaxArgumentCount a xsd:integer ;
    rdfs:comment "Maximum number of arguments allowed for an esub/epsub." .
