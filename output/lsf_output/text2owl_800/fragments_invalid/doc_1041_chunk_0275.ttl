hpc:Cluster a owl:Class .
hpc:Job a owl:Class .

# Remote Cluster and Local Cluster Subclasses
hpc:Remotecluster rdfs:subClassOf hpc:Cluster .
hpc:Localcluster rdfs:subClassOf hpc:Cluster .

# Job States
hpc:Donejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:label "DoneJob" .
hpc:Exitedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:label "ExitedJob" .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:label "PendingJob" .
hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:label "RunningJob" .
hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:label "SuspendedJob" .

# Job Filters
hpc:Shortqueuefilter a owl:Class ;
    rdfs:label "ShortQueueFilter" .

# Job Properties
hpc:executionHost owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
hpc:User rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Queue rdfs:domain hpc:Job ;
    rdfs:range hpc:Shortqueuefilter .
hpc:State rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Normalizedcputime rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

# Job Formatting Properties
hpc:format a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:noheader a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:customoutputformat a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

# Custom Output Format Property Range
hpc:outputformat a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .
hpc:unitprefix a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:delimiter a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
