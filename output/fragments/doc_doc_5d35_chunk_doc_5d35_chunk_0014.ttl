hpc:Job a owl:Class .
hpc:HeterogeneousJob a owl:Class, rdfs:subClassOf hpc:Job .
hpc:Component a owl:Class, rdfs:subClassOf hpc:Job .

hpc:hasResourceLimit a owl:ObjectProperty .
hpc:hasResourceLimit rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .

hpc:concurrentRunningJobs a owl:DatatypeProperty ;
                          rdfs:domain hpc:User .

hpc:resourceAllocationGranularity a owl:ObjectProperty .
hpc:resourceAllocationGranularity rdfs:domain hpc:Job ;
                                 rdfs:range (hpc:WholeCore hpc:Socket hpc:Node) .
```
