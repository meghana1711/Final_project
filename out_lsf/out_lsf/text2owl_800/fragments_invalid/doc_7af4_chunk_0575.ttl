hpc:Serviceclass a owl:Class .
hpc:hasPriority an owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:integer .
hpc:runsJobs an owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass .
hpc:hasUserGroup an owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range rdf:List .
hpc:Usergroup a owl:Class .
hpc:isUserGroupMember an owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:XMLLiteral .
hpc:Guaranteedsla a owl:Class ;
    rdfs:subClassOf hpc:Serviceclass ;
    owl:hasKey hpc:hasPriority ;
    owl:incompatibleWith hpc:hasPriority .
hpc:niceparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Batchjob .
hpc:hasgoal a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedsla ;
    rdfs:range xsd:string .
