hpc:Jobslotlimit a owl:Class .
hpc:Queuelevel a owl:Class .
hpc:Userlevel a owl:Class .
hpc:Hostlevel a owl:Class .
hpc:preemptivescheduling a owl:ObjectProperty .
hpc:preemptfor a owl:ObjectProperty .
hpc:Runningjob a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:Highpriorityqueue a owl:Class .
hpc:Lowpriorityqueue a owl:Class .
hpc:Backfilljob a owl:Class .
hpc:resourcereservation a owl:ObjectProperty .
hpc:slotreservation a owl:ObjectProperty .
hpc:reservedjobslotcount a owl:DatatypeProperty .
hpc:preemptjob a owl:ObjectProperty .

hpc:Jobslotlimit rdfs:subClassOf owl:Class .
hpc:Queuelevel rdfs:subClassOf owl:Class .
hpc:Userlevel rdfs:subClassOf owl:Class .
hpc:Hostlevel rdfs:subClassOf owl:Class .
hpc:Preemptivescheduling rdfs:domain hpc:Jobslotlimit ;
                                rdfs:range xsd:boolean .
hpc:Preemptfor rdfs:domain hpc:Jobslotlimit ;
                                rdfs:range xsd:string .
hpc:Runningjob rdfs:subClassOf hpc:Jobslotlimit .
hpc:Suspendedjob rdfs:subClassOf hpc:Jobslotlimit .
hpc:Highpriorityqueue rdfs:subClassOf hpc:Queuelevel .
hpc:Lowpriorityqueue rdfs:subClassOf hpc:Queuelevel .
hpc:Backfilljob rdfs:subClassOf hpc:Jobslotlimit .
hpc:Resourcereservation rdfs:domain hpc:Highpriorityqueue ;
                                rdfs:range hpc:Jobslotlimit .
hpc:Slotreservation rdfs:domain hpc:Highpriorityqueue ;
                                rdfs:range xsd:integer .
hpc:Reservedjobslotcount rdfs:domain hpc:Reservedjobslot ;
                                rdfs:range xsd:integer .
hpc:Preemptjob rdfs:domain hpc:Highpriorityqueue ;
                                rdfs:range hpc:Jobslotlimit .
