hpc:Resource a owl:Class .
hpc:Easymodelsfjob a owl:Class .
hpc:numslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .
hpc:numnodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .
hpc:smtmode a owl:ObjectProperty ;
    rdfs:domain hpc:Easymodelsfjob ;
    rdfs:range xsd:integer .
hpc:Csmjob a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:csmvalidsmt a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .
