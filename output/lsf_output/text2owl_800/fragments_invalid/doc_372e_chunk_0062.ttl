hpc:Host rdfs:subClassOf owl:Thing .
hpc:Preferredhost rdfs:domain hpc:Host ;
                    rdfs:range hpc:Host ;
                    rdfs:subPropertyOf hpc:CandidateHost .
hpc:Candidatehost rdfs:domain hpc:Host .
hpc:Cluster rdfs:subClassOf owl:Thing .
hpc:Wan rdfs:subClassOf owl:Thing .
hpc:Maincluster rdfs:domain hpc:Wan ;
                 rdfs:range hpc:Cluster .
hpc:Licenseservercluster rdfs:domain hpc:Wan ;
                      rdfs:range hpc:Cluster .
hpc:Lsfconfdir rdfs:subClassOf owl:Thing .
hpc:Lsflicschedhosts rdfs:domain hpc:Lsfconfdir ;
                     rdfs:range hpc:Lsflicschedhostsdomain .
hpc:Lsfconf rdfs:subClassOf owl:Thing .
hpc:Lsflicsched a rdfs:domain hpc:Lsfconf ;
                 rdfs:range hpc:Lsflicscheddaemon .
hpc:Lsflicscheddaemon rdfs:domain hpc:Lsfconf ;
                      rdfs:range hpc:Host .
hpc:Lsflicschedmanagementhost rdfs:domain hpc:Lsfconf ;
                             rdfs:range hpc:Host .
