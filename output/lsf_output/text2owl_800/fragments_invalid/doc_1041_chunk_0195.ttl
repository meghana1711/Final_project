hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Hostmodel a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:Job a owl:Class .

hpc:starttime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:endtime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:Timeintervalformat a owl:Class .
