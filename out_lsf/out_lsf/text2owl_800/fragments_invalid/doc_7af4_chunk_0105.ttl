hpc:Resourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Strictresourcerequirement a owl:Class .
hpc:Nonconsumableresource a owl:Class .
hpc:Selectsection a owl:Class .
hpc:Rusagesection a owl:Class .
hpc:OrderSection rdf:type owl:ObjectProperty .
hpc:Rusagesection rdfs:domain hpc:Resourcerequirement ;
                      rdfs:range hpc:Rusagesection .
hpc:Selectsection rdfs:domain hpc:Resourcerequirement ;
                   rdfs:range hpc:Selectsection .
hpc:StrictSyntax rdf:type owl:ObjectProperty .
hpc:AppliesTo rdf:type owl:ObjectProperty .
hpc:AppliesTo domain hpc:ResourceRequirement ;
              rdfs:range xsd:string .
hpc:UnitForLimits rdf:type owl:ObjectProperty .
hpc:UnitForLimits domain hpc:LSF ;
               rdfs:range xsd:string .
hpc:OrOperator rdf:type owl:ObjectProperty .
hpc:OrOperator domain hpc:RusageSection ;
             rdfs:range rdf:Bag .
hpc:JobLevel rdf:type owl:ObjectProperty .
hpc:JobLevel domain hpc:RusageSection ;
           rdfs:range hpc:Rusagesection .
hpc:ApplicationLevel rdf:type owl:ObjectProperty .
hpc:ApplicationLevel domain hpc:RusageSection ;
           rdfs:range hpc:Rusagesection .
hpc:Overrides rdf:type owl:ObjectProperty .
hpc:Overrides domain hpc:RusageSection ;
           rdfs:range hpc:Rusagesection .
hpc:MultiPhase rdf:type owl:ObjectProperty .
hpc:MultiPhase domain hpc:RusageSection ;
         rdfs:range xsd:boolean .
hpc:NonConsumable rdf:type owl:DatatypeProperty .
hpc:NonConsumable domain hpc:RusageSection ;
          rdfs:range hpc:Nonconsumableresource .
