hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Tag a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:sourcepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:destination a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:hasstagingarea a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hpc:Stagingarea .
hpc:hassourcepath a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:hasdestination a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:Taginterface a owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    rdfs:subPropertyOf hpc:hasInterface .
hpc:Intermediatefile a owl:Class .
hpc:StagingArea a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The area where tags are stored." .
hpc:Job a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job that creates or uses data tags." .
hpc:User a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The user who runs the job." .
hpc:Tag a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A tag is an intermediate result in a larger workflow." .
hpc:TagInterface a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The interface for using tags with intermediate files only." .
hpc:IntermediateFile a rdfs:Resource ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An intermediate file is created by one job for use by a subsequent job." .
