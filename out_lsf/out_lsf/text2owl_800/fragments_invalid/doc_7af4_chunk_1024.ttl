hpc:ERR_TYPE
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Error types for jobs that can be automatically retried." .

hpc:error1, hpc:error2
    a owl:NamedIndividual ;
    rdf:type hpc:ERR_TYPE ;
    rdfs:label "error1" ;
    rdfs:comment "Error 1." .
    rdf:type hpc:ERR_TYPE ;
    rdfs:label "error2" ;
    rdfs:comment "Error 2." .

hpc:LSB_BSUB_ERR_RETRY
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Retrypolicy ;
    rdfs:comment "Retries jobs that exit with a particular error." .

hpc:RetryPolicy
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Policy for retrying jobs." .

hpc:RETRY_CNT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Retrypolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of retries for a job." .

hpc:XDR_ERROR
    a owl:NamedIndividual ;
    rdf:type hpc:Error ;
    rdfs:label "XDR Error" ;
    rdfs:comment "Error during XDR." .

hpc:MSG_SYS_FAILED_SEND_RECEIVE
    a owl:NamedIndividual ;
    rdf:type hpc:Error ;
    rdfs:label "Failed to send or receive a message. Internal library error." ;
    rdfs:comment "Error message: Failed to send or receive a message. Internal library error." .

hpc:LSB_BUSERS_FORMAT
    a owl:ObjectProperty ;
    rdfs:domain hpc:Commandline ;
    rdfs:range hpc:Parameterformat ;
    rdfs:comment "Parameter for setting the LSB user format." .

hpc:ParameterFormat
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Format for LSB parameters." .

hpc:lsf_conf
    a owl:NamedIndividual ;
    rdf:type hpc:ConfigurationFile ;
    rdfs:label "lsf.conf" ;
    rdfs:comment "Configuration file for LSF." .

hpc:LSB_CHKPNT_DIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range hpc:Checkpointdirectory ;
    rdfs:comment "Directory containing files related to the submitted checkpointable job." .

hpc:CheckpointDirectory
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Directory for checkpoint files." .
