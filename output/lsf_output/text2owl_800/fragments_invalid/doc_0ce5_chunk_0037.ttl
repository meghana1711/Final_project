hpc:Managementhost a owl:Class .
hpc:RootUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string .

hpc:SetLSBMaxJobDispatchPerSession rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost .

hpc:SetMaxSbdConns rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost .

hpc:TotalCPUs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NumberOfHostsInCluster rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:nonNegativeInteger .

