hpc:Scheduler a owl:Class .
hpc:jobsortingfeature a owl:ObjectProperty .
hpc:Host a owl:Class .
hpc:slot a owl:DatatypeProperty .
hpc:Job a owl:Class .
hpc:Schedulerperformance a owl:Class .
hpc:jobacceptinterval a owl:DatatypeProperty .
hpc:lsbMaxJobDispatchPerSession a owl:ObjectProperty .
hpc:schedulerThreads a owl:ObjectProperty .

hpc:Scheduler rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .

hpc:Jobsortingfeature rdfs:domain hpc:Scheduler ;
    rdfs:range owl:ObjectProperty ;
    rdfs:subPropertyOf owl:ObjectProperty .

hpc:Slot rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:Jobacceptinterval rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:integer .

hpc:LsbMaxJobDispatchPerSession rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:integer .

hpc:SchedulerThreads rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:integer .
