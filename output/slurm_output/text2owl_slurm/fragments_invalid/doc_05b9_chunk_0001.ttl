@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:QueryParameter
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Signal to send to Job, default: null" ;
    rdfs:label "QueryParameter" .

hpc:QueryParameter_flags
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Signalling flags, default: null" ;
    rdfs:label "QueryParameter_flags" .

hpc:ReturnType
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
