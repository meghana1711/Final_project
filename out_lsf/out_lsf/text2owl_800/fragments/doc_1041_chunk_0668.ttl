hpc:Jobsize a owl:Class .
hpc:Jobsizelist a owl:Class .
hpc:Job a owl:Class .
hpc:jobsizerequest a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:JobSizeList rdfs:subClassOf hpc:Jobsize .
hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsizerequest ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The default value for job size request when not specified." .
hpc:LsbApplications a owl:Class .
hpc:LsbQueues a owl:Class .
hpc:sndjobsTo a owl:ObjectProperty ;
    rdfs:domain hpc:LsbQueues ;
    rdfs:range hpc:LsbQueues .
hpc:processlimit a owl:ObjectProperty ;
    rdfs:domain hpc:LsbQueues ;
    rdfs:range xsd:nonNegativeInteger .
hpc:firstexecutionhostcandidates a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Host a owl:Class .
hpc:lsbHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:lsbMcpuHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:poe a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:span a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:network a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:protocol a owl:DatatypeProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range xsd:string .
hpc:lapi a owl:DatatypeProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range xsd:string .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range xsd:string .
hpc:instances a owl:DatatypeProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range xsd:nonNegativeInteger .
hpc:usage a owl:DatatypeProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range xsd:string .
