hpc:SlurmUser a owl:Class .
hpc:SlurmUser rdf:type hpc:User .

# SlurmDBD
hpc:SlurmDBD a owl:Class .
hpc:SlurmDBD rdf:type hpc:SlurmDaemon .

hpc:startSlurmDBD a owl:ObjectProperty .
hpc:startSlurmDBD rdfs:domain hpc:SlurmUser .
hpc:startSlurmDBD rdfs:range rdf:Literal .

hpc:verifySlurmDBDRunning a owl:ObjectProperty .
hpc:verifySlurmDBDRunning rdfs:domain hpc:SlurmUser .
hpc:verifySlurmDBDRunning rdfs:range rdf:Literal .

hpc:debugSlurmDBD a owl:ObjectProperty .
hpc:debugSlurmDBD rdfs:domain hpc:SlurmUser .
hpc:debugSlurmDBD rdfs:range rdf:Literal .

# SlurmDBD Archive and Purge

hpc:SlurmDBDArrchive a owl:Class .
hpc:SlurmDBDPurge a owl:Class .

# Archive Options
hpc:ArchiveAfter a owl:ObjectProperty .
hpc:ArchiveAfter rdfs:domain hpc:SlurmDBD .
hpc:ArchiveAfter rdfs:range xsd:duration .

# Purge Options
hpc:PurgeAfter a owl:ObjectProperty .
hpc:PurgeAfter rdfs:domain hpc:SlurmDBD .
hpc:PurgeAfter rdfs:range xsd:duration .

# Archive Server
hpc:SlurmArchiveServer a owl:Class .
hpc:SlurmArchiveServer rdf:type hpc:SlurmServer .

hpc:communicateWithProductionServer a owl:ObjectProperty .
hpc:communicateWithProductionServer rdfs:domain hpc:SlurmArchiveServer .
hpc:communicateWithProductionServer rdfs:range rdf:Literal .

hpc:separateMySQLInstances a owl:ObjectProperty .
hpc:separateMySQLInstances rdfs:domain hpc:SlurmArchiveServer .
hpc:separateMySQLInstances rdfs:range rdf:Literal .

