hpc:AwsEc2Fleet a owl:Class .
hpc:usesApi a owl:ObjectProperty ;
    rdfs:domain hpc:AwsEc2Fleet ;
    rdfs:range hpc:Api .

# LSF Resource Connector for AWS
hpc:LsfResourceConnectorAws a owl:Class .
hpc:usesApi a owl:ObjectProperty ;
    rdfs:domain hpc:LsfResourceConnectorAws ;
    rdfs:range hpc:AwsEc2Fleet .

# LSF Resource Connector API
hpc:LsfResourceConnectorApi a owl:Class .

# EC2 Fleet API
hpc:Ec2FleetApi a owl:Class .
hpc:Ec2FleetApi rdfs:subClassOf hpc:LsfResourceConnectorApi .

# IBM Cloud Gen 2 provider capacity error codes
hpc:IbmCloudGen2ProviderCapacityErrorCodes a owl:Class .
hpc:affectsParameter a owl:ObjectProperty ;
    rdfs:domain hpc:IbmCloudGen2ProviderCapacityErrorCodes ;
    rdfs:range hpc:Parameter .

# lsf.conf file
hpc:LsfConfFile a owl:Class .

# lsf.conf file parameter
hpc:lsfRcTemplateRequestDelay a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConfFile .

# IBM Spectrum LSF Version 10.1 Fix Pack 13
hpc:IbmSpectrumLsfVersion101FixPack13 a owl:Class .
