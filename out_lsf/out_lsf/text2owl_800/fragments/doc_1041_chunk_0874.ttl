hpc:fixes a owl:ObjectProperty ;
    rdfs:domain hpc:Patch ;
    rdfs:range hpc:Fix .

hpc:files a owl:ObjectProperty ;
    rdfs:domain hpc:Patch ;
    rdfs:range hpc:File .

hpc:File a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Patch a owl:Class .

hpc:Product a owl:Class .

hpc:binarytype a owl:DatatypeProperty ;
    rdfs:domain hpc:Patch .

hpc:Notes a owl:Class .

hpc:pversions a owl:ObjectProperty ;
    rdfs:domain hpc:Windows .

hpc:Windows a owl:Class .
