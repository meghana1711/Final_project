hpc:upgrade a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmversion ;
    rdfs:range hpc:Slurmversion .

hpc:compatibleversion a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmversion ;
    rdfs:range hpc:Slurmversion .

hpc:incompatibleversion a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmversion ;
    rdfs:range hpc:Slurmversion .

hpc:Runningjob a owl:Class .

hpc:Prereleaseversion a owl:Class ;
    rdfs:subClassOf hpc:Slurmversion .

hpc:Epelrepository a owl:Class .

hpc:excludeslurmfromupdates a owl:ObjectProperty ;
    rdfs:domain hpc:Epelrepository ;
    rdfs:range xsd:string .

hpc:Slurmversion a owl:Class .
