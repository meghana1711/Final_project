hpc:Lsbparams a owl:Class .
hpc:Lim a owl:Class .
hpc:Mbatchd a owl:Class .
hpc:Rcaccountparameter a owl:Class .
hpc:Joblevelrcaccount a owl:Class .
hpc:Projectlevelrcaccount a owl:Class .
hpc:Applicationlevelrcaccount a owl:Class .
hpc:Queuelevelrcaccount a owl:Class .
hpc:Lsbapplications a owl:Class .
hpc:Lsbqueues a owl:Class .
hpc:Lsfshared a owl:Class .
hpc:Vmtype a owl:Class .

hpc:hasparameter a owl:ObjectProperty .
hpc:hasconfigurationfile a owl:DatatypeProperty .
hpc:haslevel a owl:DatatypeProperty .
hpc:hasresourcename a owl:DatatypeProperty .
hpc:hastype a owl:DatatypeProperty .
hpc:hasdescription a owl:DatatypeProperty .
hpc:hasresource a owl:ObjectProperty .
hpc:hasvmtype a owl:ObjectProperty .

hpc:Lsbparams rdfs:subClassOf hpc:Resourceconnectorparameters .
hpc:Lim rdfs:subClassOf hpc:Resourcemanager .
hpc:Mbatchd rdfs:subClassOf hpc:Resourcemanager .
hpc:Rcaccountparameter rdfs:subClassOf hpc:Parameter .
hpc:Joblevelrcaccount rdfs:subClassOf hpc:Rcaccountparameter .
hpc:Projectlevelrcaccount rdfs:subClassOf hpc:Rcaccountparameter .
hpc:Applicationlevelrcaccount rdfs:subClassOf hpc:Rcaccountparameter .
hpc:Queuelevelrcaccount rdfs:subClassOf hpc:Rcaccountparameter .
hpc:Lsbapplications rdfs:subClassOf hpc:Resourcemanager .
hpc:Lsbqueues rdfs:subClassOf hpc:Resourcemanager .
hpc:Lsfshared rdfs:subClassOf hpc:Resourcemanager .
hpc:Vmtype rdfs:subClassOf xsd:string .

hpc:Hasparameter rdfs:domain hpc:Resourcemanager ;
                   rdfs:range hpc:Rcaccountparameter .
hpc:Hasconfigurationfile rdfs:domain hpc:Rcaccountparameter ;
                         rdfs:range xsd:string .
hpc:Haslevel rdfs:domain hpc:Rcaccountparameter ;
               rdfs:range xsd:string .
hpc:Hasresourcename rdfs:domain hpc:Resource ;
                    rdfs:range xsd:string .
hpc:Hastype rdfs:domain hpc:Resource ;
              rdfs:range xsd:string .
hpc:Hasdescription rdfs:domain hpc:Resource ;
                   rdfs:range xsd:string .
hpc:Hasresource rdfs:domain hpc:Resourcemanager ;
                rdfs:range hpc:Resource .
hpc:Hasvmtype rdfs:domain hpc:Job ;
               rdfs:range hpc:Vmtype .
