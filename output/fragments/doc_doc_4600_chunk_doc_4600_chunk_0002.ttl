hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:JobID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:BasePath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:OwnedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:AccessibleTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:IsEmpty rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Directory .

hpc:Directory a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:HasTmp rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Directory .

hpc:TaskProlog rdf:type owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:TaskPrologInContainer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TaskProlog .

hpc:InterfacesWithSPANKApi rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin .

hpc:JoinsContainerIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range [ a owl:Class ; owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty hpc:JoinsContainerIn ;
                                                      owl:hasValue spank_task_init_privileged ] ] .

hpc:JoinsContainerIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range [ a owl:Class ; owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty hpc:JoinsContainerIn ;
                                                      owl:hasValue spank_task_init ] ] .
```
