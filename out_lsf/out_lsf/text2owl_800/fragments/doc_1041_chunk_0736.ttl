hpc:Scheduledjob a owl:Class .
hpc:effectiveresourcerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Scheduledjob ;
    rdfs:range xsd:string .

hpc:bswitchModifyRusage a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduledjob .

hpc:bswitchcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduledjob .

hpc:autoattachment a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduledjob ;
    rdfs:range hpc:Scheduledjob .

hpc:Options a owl:Class .

hpc:switchmultiplejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Options .

hpc:Specifiedoptions a owl:Class .

hpc:applicationname a owl:DatatypeProperty ;
    rdfs:domain hpc:Options .

hpc:applicationspecificeswitchexecutablefile a owl:ObjectProperty ;
    rdfs:domain hpc:Options .

hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Scheduledjob .

hpc:Jobarray a owl:Class .

hpc:wildcardcharacter a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobname ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Bswitchcommand .
