hpc:Sshx11forwarding a owl:Class .
hpc:Sshclient rdfs:subClassOf owl:Class .
hpc:Submissionhost rdfs:subClassOf owl:Class .
hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Sshclient ;
    rdfs:range hpc:Bsubcommand .
hpc:bsuboptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsubcommand .
hpc:Lsf a owl:Class .
hpc:Sharedfilespace rdfs:subClassOf owl:Class .
hpc:Executionhost rdfs:subClassOf owl:Class .
hpc:bsubfcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Bsubfcommand .
hpc:bsubfdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsubfcommand .
hpc:Executiondirectory rdfs:subClassOf owl:Class .
hpc:Homedirectory rdfs:subClassOf owl:Class .
hpc:Netautomount rdfs:subClassOf owl:Class .
hpc:Tmpdirectory rdfs:subClassOf owl:Class .
hpc:Createdfiles rdfs:subClassOf owl:Class .
hpc:Standardoutputfile rdfs:subClassOf owl:Class .
hpc:Standarderrorfile rdfs:subClassOf owl:Class .
