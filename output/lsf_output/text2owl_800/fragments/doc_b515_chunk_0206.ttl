hpc:Resizablejob a owl:Class .
hpc:fairshareadjustmentfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:decimal .

hpc:userpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:decimal .

hpc:Jobcountbasedfairsharescheduling a owl:Class .
hpc:fairsharejobcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcountbasedfairsharescheduling ;
    rdfs:range xsd:boolean .

hpc:Jobcheckpointandrestart a owl:Class .

hpc:Jobcountbasedfairsharescheduling rdfs:subClassOf hpc:Jobcountbasedscheduling .
hpc:Resizablejob rdfs:subClassOf hpc:Job .
