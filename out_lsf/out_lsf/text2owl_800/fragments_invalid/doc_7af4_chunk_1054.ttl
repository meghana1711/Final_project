hpc:LsbUserBindJob a owl:Class .
hpc:LSF_BIND_JOB_VALUE an owl:DatatypeProperty ;
    rdfs:domain hpc:LsbUserBindJob ;
    rdfs:range xsd:string .
hpc:LsbBindJobValue a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:unionOf (hpc:Y hpc:N hpc:NONE hpc:BALANCE hpc:PACK hpc:ANY ) ] .
hpc:LsfAcJobNotification a owl:Class .
hpc:LSF_AC_JOB_NOTIFICATION_VALUE an owl:DatatypeProperty ;
    rdfs:domain hpc:LsfAcJobNotification ;
    rdfs:range xsd:string .
hpc:JobState an owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:unionOf (hpc:exit hpc:done hpc:start hpc:suspend ) ] .
hpc:LSF_AC_JOB_NOTIFICATION_STATE an owl:ObjectProperty ;
    rdfs:domain hpc:LsfAcJobNotification ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first hpc:Jobstate ;
    rdfs:range rdf:rest rdf:List .
hpc:LsfCmdLogdir a owl:Class .
hpc:LSF_CMD_LOGDIR_VALUE an owl:DatatypeProperty ;
    rdfs:domain (hpc:LsfCmdLogdir hpc:LsbCmdLogdir) ;
    rdfs:range xsd:string .
hpc:LsfDebugCmd a owl:Class .
hpc:LSF_DEBUG_CMD_VALUE an owl:DatatypeProperty ;
    rdfs:domain (hpc:LsfDebugCmd hpc:LsbDebugCmd) ;
    rdfs:range xsd:string .
