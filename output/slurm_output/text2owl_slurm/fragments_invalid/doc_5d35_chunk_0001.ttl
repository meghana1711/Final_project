@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Heterogeneousjob a owl:Class.
hpc:Component a owl:Class.
hpc:Joboption a owl:Class.
hpc:Propagatedoption a owl:Class.
hpc:Nonpropagatedoption a owl:Class.

hpc:hascomponent a owl:ObjectProperty ;
    rdfs:domain hpc:Heterogeneousjob ;
    rdfs:range hpc:Component .

hpc:hasjoboption a owl:ObjectProperty ;
    rdfs:domain hpc:Heterogeneousjob ;
    rdfs:range hpc:Joboption .

hpc:isPropagated a o
