hpc:Processlimit a owl:Class .
hpc:Pack a owl:Class .

hpc:hasProcessLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:submitPackJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Hpcsystem ;
    rdfs:range hpc:Jobpack .

hpc:Jobpack a owl:Class .
hpc:jobSubmissionFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range xsd:string .

hpc:Jobpacksubmissionfile a owl:Class ;
    rdfs:subClassOf hpc:Jobpack .

hpc:JobPackConflict rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpacksubmissionfile ;
    rdfs:range hpc:Jobpackoption .

hpc:Jobpackoption a owl:Class .
hpc:isNotCompatibleWith rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpackoption ;
    rdfs:range hpc:Jobpackoption .

hpc:JobPackOption_pack rdf:type hpc:JobPackOption ;
hpc:JobPackOption_I rdf:type hpc:JobPackOption ;
hpc:JobPackOption_Ip rdf:type hpc:JobPackOption ;
hpc:JobPackOption_Is rdf:type hpc:JobPackOption ;
hpc:JobPackOption_IS rdf:type hpc:JobPackOption ;
hpc:JobPackOption_ISp rdf:type hpc:JobPackOption ;
hpc:JobPackOption_ISs rdf:type hpc:JobPackOption ;
hpc:JobPackOption_IX rdf:type hpc:JobPackOption ;
hpc:JobPackOption_XF rdf:type hpc:JobPackOption ;
hpc:JobPackOption_K rdf:type hpc:JobPackOption ;
hpc:JobPackOption_jsdl rdf:type hpc:JobPackOption ;
hpc:JobPackOption_h rdf:type hpc:JobPackOption ;
hpc:JobPackOption_V rdf:type hpc:JobPackOption ;
