hpc:Lsfconf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The most important file in LSF. Contains paths and global configuration information." .

hpc:location rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The location of the lsf.conf file." .

# lsf.cluster.cluster_name
hpc:Clusterconfig a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Defines hosts, administrators, and shared resources for one cluster." .

hpc:hostName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clusterconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The host names in the cluster." .

hpc:model rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clusterconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The models of the hosts in the cluster." .

hpc:type rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clusterconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The types of the hosts in the cluster." .

hpc:adminUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clusterconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The user names of the LSF administrators." .

hpc:sharedResourceLocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clusterconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The locations of different shared resources for one cluster." .

# lsf.shared
hpc:Sharedconfig a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A dictionary that defines all the keywords used by the cluster." .

hpc:keyword rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sharedconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the names of resources or host types." .

# lsb.queues
hpc:Queueconfig a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Defines workload queues and their parameters for one cluster." .

hpc:queueName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queueconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The names of the workload queues." .

hpc:queueParameters rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queueconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "The parameters for the workload queues." .

# LSF Cluster Configuration Files
hpc:LsfClusterConfigFiles a owl:
