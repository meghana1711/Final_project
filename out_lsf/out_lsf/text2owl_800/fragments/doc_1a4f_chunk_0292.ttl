hpc:Sbatchddaemon a owl:Class .
hpc:Resdaemon a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Pamconfigurationfile a owl:Class .
hpc:authentication a owl:ObjectProperty .
hpc:authorization a owl:ObjectProperty .
hpc:resourcelimit a owl:ObjectProperty .
hpc:session a owl:ObjectProperty .
hpc:loadthreshold a owl:DatatypeProperty .
hpc:Automaticjobsuspension a owl:Class .
hpc:Hostsuspendingcondition a owl:Class .
hpc:Queuesuspendingcondition a owl:Class .
hpc:Loadcondition a owl:Class .
hpc:Pamconfigurationfile rdfs:subClassOf owl:Resource .
hpc:Executionhost rdfs:subClassOf owl:Resource .
hpc:Sbatchddaemon rdfs:subClassOf owl:Agent .
hpc:Resdaemon rdfs:subClassOf owl:Agent .
hpc:Authentication rdfs:domain hpc:Sbatchddaemon ;
    rdfs:range rdf:Resource .
hpc:Authorization rdfs:domain hpc:Sbatchddaemon ;
    rdfs:range rdf:Resource .
hpc:Resourcelimit rdfs:domain hpc:Sbatchddaemon ;
    rdfs:range rdf:Resource .
hpc:Session rdfs:domain hpc:Sbatchddaemon ;
    rdfs:range rdf:Resource .
hpc:Loadthreshold rdfs:domain hpc:Pamconfigurationfile ;
    rdfs:range xsd:decimal .
hpc:Automaticjobsuspension rdfs:subClassOf owl:Event .
hpc:Hostsuspendingcondition rdfs:subClassOf hpc:Loadcondition .
hpc:Queuesuspendingcondition rdfs:subClassOf hpc:Loadcondition .
