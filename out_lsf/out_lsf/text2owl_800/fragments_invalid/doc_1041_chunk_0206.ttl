hpc:Time a owl:Class .
hpc:Absolutetime a owl:Class .
hpc:Relativetime a owl:Class .

# Ranges
rdfs:range(hpc:Absolutetime) xsd:dateTime .
rdfs:range(hpc:Relativetime) xsd:dateTime .

# Subclasses
hpc:Intervaltime a owl:Class .
hpc:Pointtime a owl:Class .
hpc:Relativeintervaltime a owl:Class .
hpc:Relativepointtime a owl:Class .

# Object Properties
hpc:contains a owl:ObjectProperty .
hpc:overlaps a owl:ObjectProperty .

# Domains and Ranges
rdfs:domain(hpc:Intervaltime) hpc:Intervaltime .
rdfs:domain(hpc:Pointtime) hpc:Pointtime .
rdfs:domain(hpc:Contains) hpc:Intervaltime .
rdfs:domain(hpc:Overlaps) hpc:Intervaltime .
rdfs:range(hpc:Contains) hpc:Pointtime .
rdfs:range(hpc:Overlaps) hpc:Intervaltime .

# Examples
hpc:example1_8 a hpc:IntervalTime .
hpc:Example18 hpc:contains hpc:May_1_00_00_2008_T_00_00_00 .
hpc:Example18 hpc:contains hpc:May_8_23_59_2008_T_23_59_59 .

hpc:example4 a hpc:PointTime .
hpc:Example4 hpc:contains hpc:May_4_00_00_2008_T_00_00_00 .

hpc:example6 a hpc:IntervalTime .
hpc:Example6 hpc:contains hpc:May_6_00_00_2008_T_00_00_00 .
hpc:Example6 hpc:contains hpc:May_6_23_59_2008_T_23_59_59 .

hpc:example2_ a hpc:IntervalTime .
hpc:Example2 hpc:contains hpc:Feb_1_00_00_2008_T_00_00_00 .
hpc:Example2 hpc:contains hpc:Feb_28_23_59_2008_T_23_59_59 .
hpc:Example2 hpc:contains hpc:May_9_12_00_00_2008_T_00_00_00 .
hpc:Example2 hpc:contains hpc:May_9_12_59_2008_T_23_59_59 .

