hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:Orderphase a owl:Class .
hpc:Allocationphase a owl:Class .
hpc:Postprocessingphase a owl:Class .
hpc:Resourceintensivejob a owl:Class .
hpc:jobslot a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal .
hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Job .
hpc:hasorderphase a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:hasallocationphase a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:haspostprocessingphase a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:queueslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Orderphase .
hpc:jobdeadline a owl:DatatypeProperty ;
    rdfs:domain hpc:Orderphase .
hpc:fcfs a owl:ObjectProperty ;
    rdfs:domain hpc:Orderphase .
hpc:fairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Orderphase .
hpc:hostpartition a owl:ObjectProperty ;
    rdfs:domain hpc:Orderphase .
hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Usergroup a owl:Class .
hpc:Sharegroup a owl:Class .
hpc:reservedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceintensivejob .
hpc:preemption a owl:ObjectProperty ;
    rdfs:domain hpc:Postprocessingphase .
hpc:backfill a owl:ObjectProperty ;
    rdfs:domain hpc:Postprocessingphase .
hpc:Schedulerplugin a owl:Class .
hpc:Schedulerphase a owl:Class ;
    rdfs:subClassOf hpc:Phase .
hpc:Phase a owl:Class .
