hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a reservation." .

hpc:addreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Advancereservation ;
    rdfs:comment "Creates a new advance reservation." .

hpc:changereservationtype a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "Changes the reservation type (open or closed)." .

hpc:changeusersorusergroups a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "Changes users or user groups for the reservation." .

hpc:modifydescription a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "Modifies the reservation description." .

hpc
