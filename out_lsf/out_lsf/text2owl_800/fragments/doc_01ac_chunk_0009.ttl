hpc:Datamanager a owl:Class .
hpc:Job a owl:Class .
hpc:Clusterpreference a owl:Class .
hpc:Datafileinformation a owl:Class .
hpc:Localstagingarea a owl:Class .
hpc:stagedatafileinformation a owl:ObjectProperty .
hpc:informlsf a owl:ObjectProperty .
hpc:dataready a owl:ObjectProperty .
hpc:schedulejob a owl:ObjectProperty .
hpc:DatamanagerStagesdatafileinformation rdfs:domain hpc:Datamanager .
hpc:DatamanagerStagesdatafileinformation rdfs:range hpc:Datafileinformation .
hpc:DatafileinformationInlocalstagingarea rdfs:domain hpc:Datafileinformation .
hpc:DatafileinformationInlocalstagingarea rdfs:range hpc:Localstagingarea .
hpc:DatamanagerInformslsf rdfs:domain hpc:Datamanager .
hpc:DatamanagerInformslsf rdfs:range hpc:Job .
hpc:JobHasclusterpreference rdfs:domain hpc:Job .
hpc:JobHasclusterpreference rdfs:range hpc:Clusterpreference .
hpc:LocalstagingareaNotrequired rdfs:domain hpc:Localstagingarea .
hpc:LocalstagingareaNotrequired rdfs:range xsd:boolean .
hpc:DatamanagerSchedulesjob rdfs:domain hpc:Datamanager .
hpc:DatamanagerSchedulesjob rdfs:range hpc:Job .
hpc:DatamanagerSchedulesjob rdfs:subClassOf hpc:DatamanagerInformslsf .
hpc:DatamanagerSchedulesjob rdfs:subClassOf [ a owl:Restriction ;
                                                owl:onProperty hpc:dataReady ;
                                                owl:allValuesFrom xsd:boolean ] .
