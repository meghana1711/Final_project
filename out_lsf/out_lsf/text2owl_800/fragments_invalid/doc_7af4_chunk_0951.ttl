hpc:Servicedomain a owl:Class .
hpc:distributionpolicy a owl:ObjectProperty .
hpc:Project a owl:Class .
hpc:shareassignment a owl:DatatypeProperty .
hpc:licensesowned a owl:DatatypeProperty .

hpc:Servicedomain rdfs:subClassOf owl:Class .
hpc:Distributionpolicy rdfs:domain hpc:Servicedomain ;
                        rdfs:range rdf:List .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Shareassignment rdfs:domain hpc:Servicedomain ;
                     rdfs:range xsd:decimal .
hpc:Licensesowned rdfs:domain hpc:Project ;
                  rdfs:range xsd:nonNegativeInteger .

hpc:Servicedomain hpc:hasdistributionpolicy hpc:DistributionPolicy .
hpc:Distributionpolicy hpc:contains hpc:ShareAssignment ;
                     hpc:Contains hpc:licensesowned .
hpc:Shareassignment hpc:project rdf:first ;
                    hpc:share rdf:rest .
hpc:Licensesowned hpc:licenses rdf:first .

hpc:ShareAssignment rdf:type rdf:List ;
                     rdf:first hpc:project ;
                     rdf:rest rdf:List ;
                     rdf:first hpc:share ;
                     rdf:rest rdf:List ;
                     ( rdf:first xsd:decimal ;
                       rdf:rest rdf:List ;
                       rdf:first xsd:decimal ;
                       rdf:rest ( rdf:first xsd:string ;
                                   rdf:rest rdf:nil )
                     )* .

hpc:LicensesOwned rdf:type rdf:List ;
                  rdf:first xsd:nonNegativeInteger ;
                  rdf:rest rdf:List ;
                  rdf:first xsd:nonNegativeInteger ;
                  rdf:rest rdf:nil .
