hpc:ApsPriority a owl:Class .
hpc:weightfactors a owl:DatatypeProperty ;
    rdfs:domain hpc:ApsPriority ;
    rdfs:range xsd:decimal .
hpc:limitfactors a owl:DatatypeProperty ;
    rdfs:domain hpc:ApsPriority ;
    rdfs:range xsd:decimal .
hpc:factorgraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:ApsPriority ;
    rdfs:range xsd:duration .
hpc:Fairshare a hpc:APS_Priority ;
    hpc:WeightFactors "10000.00" ;
    hpc:LimitFactors "" ;
    hpc:FactorGracePeriod "" .
hpc:Resource a hpc:APS_Priority ;
    hpc:WeightFactors "101010.00" ;
    hpc:LimitFactors "" ;
    hpc:FactorGracePeriod "1010h" .
hpc:Processors a hpc:APS_Priority ;
    hpc:WeightFactors "-10.01" ;
    hpc:LimitFactors "" ;
    hpc:FactorGracePeriod "" .
hpc:Memory a hpc:APS_Priority ;
    hpc:WeightFactors "1000.00" ;
    hpc:LimitFactors "20010.00" ;
    hpc:FactorGracePeriod "3h" .
hpc:Swap a hpc:APS_Priority ;
    hpc:WeightFactors "10111.00" ;
    hpc:LimitFactors "" ;
    hpc:FactorGracePeriod "" .
hpc:Work a hpc:APS_Priority ;
    hpc:WeightFactors "1.00" ;
    hpc:LimitFactors "" ;
    hpc:FactorGracePeriod "" .
hpc:Jobpriority a owl:Class ;
    rdfs:subClassOf hpc:ApsPriority .
hpc:Queuepriority a owl:Class ;
    rdfs:subClassOf hpc:ApsPriority .
hpc:Usershares a owl:Class .
hpc:shareinfofor a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Shareinfo .
hpc:Usershare a owl:Class ;
    rdfs:subClassOf hpc:Usershares .
hpc:usersharefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Usershare ;
    rdfs:range xsd:decimal .
hpc:shareinfoforqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Shareinfofor .
hpc:Shareinfo a owl:Class .
hpc:usergroupsharespriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareinfo ;
    rdfs:range xsd:decimal .
hpc:started a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareinfo ;
    rdfs:range xsd:duration .
hpc
