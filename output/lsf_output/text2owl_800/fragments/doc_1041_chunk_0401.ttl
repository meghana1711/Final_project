hpc:Servicedomain a owl:Class .
hpc:UNKNOWN a owl:NamedIndividual .

hpc:Numberoflicenses a owl:Class .
hpc:INUSE a owl:NamedIndividual .

hpc:Effectiveproject a owl:Class .

hpc:Feature a owl:Class .
hpc:ServiceDomain rdfs:domain hpc:Feature ;
    rdfs:range hpc:Servicedomain ;
    rdfs:subPropertyOf hpc:hasServiceDomain .

hpc:User rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasUser .

hpc:Host rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasHost .

hpc:Nlics rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:hasNLICS .

hpc:Ntasks rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:hasNTASKS .

hpc:Others rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasOTHERS .

hpc:Displays rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasDISPLAYS .
