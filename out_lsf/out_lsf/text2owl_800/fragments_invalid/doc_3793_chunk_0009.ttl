@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .

hpc:queuename a owl:ObjectProperty .
hpc:Queuename rdfs:domain hpc:Queue .
hpc:Queuename rdfs:range xsd:string .

hpc:priority a owl:DatatypeProperty .
hpc:Priority rdfs:domain hpc:Queue .
hpc:Priority rdfs:range xsd:integer .

hpc:jobcontrols a owl:ObjectProperty .
hpc:Jobcontrols rdfs:domain hpc:Queue .
hpc:Jobcontrols rdfs:range xsd:string .

hpc:rerunnable a owl:DatatypeProperty .
hpc:Rerunnable rdfs:domain hpc:Queue .
hpc:Rerunnable rdfs:range xsd:boolean .

hpc:preemption a owl:DatatypeProperty .
hpc:Preemption rdfs:domain hpc:Queue .
hpc:Preemption rdfs:range xsd:string .

hpc:nice a owl:DatatypeProperty .
hpc:Nice rdfs:domain hpc:Queue .
hpc:Nice rdfs:range xsd:integer .

hpc:r1m a owl:DatatypeProperty .
hpc:R1m rdfs:domain hpc:Queue .
hpc:R1m rdfs:range xsd:decimal .

hpc:pg a owl:DatatypeProperty .
hpc:Pg rdfs:domain hpc:Queue .
hpc:Pg rdfs:range xsd:decimal .

hpc:io a owl:DatatypeProperty .
hpc:Io rdfs:domain hpc:Queue .
hpc:Io rdfs:range xsd:decimal .

hpc:swp a owl:DatatypeProperty .
hpc:Swp rdfs:domain hpc:Queue .
hpc:Swp rdfs:range xsd:decimal .

hpc:tmp a owl:DatatypeProperty .
hpc:Tmp rdfs:domain hpc:Queue .
hpc:Tmp rdfs:range xsd:decimal .

hpc:cpulimit a owl:DatatypeProperty .
hpc:Cpulimit rdfs:domain hpc:Queue .
hpc:Cpulimit rdfs:range xsd:string .

hpc:filelimit a owl:DatatypeProperty .
hpc:Filelimit rdfs:domain hpc:Queue .
hpc:Filelimit rdfs:range xsd:integer .

hpc:datalimit a owl:DatatypeProperty .
hpc:DAT
