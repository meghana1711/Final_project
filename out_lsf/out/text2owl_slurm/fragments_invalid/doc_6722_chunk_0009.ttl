hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A job that requests space from a burst buffer resource pool." .

hpc:poolspecification a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "A string that matches the name of the pool." .

hpc:capacityspecification a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment
