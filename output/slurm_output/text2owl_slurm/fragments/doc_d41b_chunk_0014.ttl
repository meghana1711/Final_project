hpc:Slurmjobsubmitpluginfunction a owl:Class .
hpc:Jobdescription a owl:Class .
hpc:Resourcedescription a owl:Class .
hpc:Tresdescription a owl:Class .
hpc:Gresresource a owl:Class .
hpc:Typedgresresource a owl:Class .
hpc:Genericgresresource a owl:Class .
hpc:Accountingstoragetres a owl:Class .

# Object Properties
hpc:hasslurmjobsubmitpluginfunction a owl:ObjectProperty .
hpc:hasjobdescription a owl:ObjectProperty .
hpc:hasresourcedescription a owl:ObjectProperty .
hpc:hastresdescription a owl:ObjectProperty .
hpc:requiresgresresource a owl:ObjectProperty .
hpc:hastype a owl:ObjectProperty .

# Datatype Properties
hpc:tresperjob a owl:DatatypeProperty .
hpc:trespersocket a owl:DatatypeProperty .
hpc:trespertask a owl:DatatypeProperty .
hpc:trespernode a owl:DatatypeProperty .
hpc:gresrequest a owl:DatatypeProperty .

# Subclass Relations
hpc:Typedgresresource rdfs:subClassOf hpc:Gresresource .

# Domain and Range
hpc:Hasslurmjobsubmitpluginfunction rdfs:domain hpc:Jobdescription ;
  rdfs:range hpc:Slurmjobsubmitpluginfunction .
hpc:Hasjobdescription rdfs:domain hpc:Slurmjobsubmitpluginfunction ;
  rdfs:range hpc:Jobdescription .
hpc:Hasresourcedescription rdfs:domain hpc:Jobdescription ;
  rdfs:range hpc:Resourcedescription .
hpc:Hastresdescription rdfs:domain hpc:Resourcedescription ;
  rdfs:range hpc:Tresdescription .
hpc:Requiresgresresource rdfs:domain hpc:Tresdescription ;
  rdfs:range hpc:Gresresource .
hpc:Hastype rdfs:domain hpc:Typedgresresource ;
  rdfs:range xsd:string .

# Accounting Storage TRES
hpc:Accountingstoragetres rdfs:subClassOf hpc:Gresresource .
hpc:Accountingstoragetres rdfs:domain hpc:Slurmconf .
hpc:Accountingstoragetres rdfs:range xsd:string .
