hpc:Serviceclass a owl:Class .

hpc:Accountinginformation a owl:Class .
hpc:Accountedonserviceclass rdfs:domain hpc:Accountinginformation ;
                             rdfs:range hpc:Serviceclass .

hpc:Job a owl:Class .

hpc:totalnumberofdonejobs a owl:DatatypeProperty ;
                            rdfs:domain hpc:Job ;
                            rdfs:range xsd:integer .
hpc:totalnumberofexitedjobs a owl:DatatypeProperty ;
                              rdfs:domain hpc:Job ;
                              rdfs:range xsd:integer .
hpc:totalcputimeconsumed a owl:DatatypeProperty ;
                            rdfs:domain hpc:Job ;
                            rdfs:range xsd:decimal .
hpc:averagecputimeconsumed a owl:DatatypeProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range xsd:decimal .
hpc:maximumcputimeofajob a owl:DatatypeProperty ;
                            rdfs:domain hpc:Job ;
                            rdfs:range xsd:dec
