hpc:Bdatacommand a owl:Class .
hpc:Reconfigurations hpc:Bdatacommand rdfs:subClassOf owl:Class .
hpc:Shutdown hpc:Bdatacommand rdfs:subClassOf owl:Class .
hpc:Helpoptions hpc:Bdatacommand rdfs:subClassOf owl:Class .

hpc:Reconfig hpc:reconfigurations rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bdatacommand ;
    rdfs:range hpc:Reconfig .

hpc:Shutdown hpc:bdatacommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bdatacommand ;
    rdfs:range hpc:Shutdownevent .

hpc:Help hpc:helpoptions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bdatacommand ;
    rdfs:range hpc:Helpoption .

hpc:Helpoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        owl:unionOf (hpc:DisplayUsage hpc:DisplayVersion) ] .

hpc:Displayusage a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Displays the command usage of the bdata command to stderr and exits." .

hpc:Displayversion a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Prints the IBM Spectrum LSF Data Manager release version to stderr and exits." .

hpc:Shutdownevent a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the event of shutting down the LSF data manager daemon." .

hpc:checkingconfigurationfiles a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:string .

hpc:reconfiguring a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:string .

hpc:initiated a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:string .

hpc:shuttingdown a owl:DatatypeProperty ;
    rdfs:domain hpc:Shutdownevent ;
    rdfs:range xsd:string .

hpc:done a owl:DatatypeProperty ;
    rdfs:domain hpc:Shutdownevent ;
    rdfs:range xsd:string .

hpc:hostunreachable a owl:DatatypeProperty ;
    rdfs:domain hpc:Shutdownevent ;
    rdfs:range xsd:string .

hpc:cannotshutdown a owl:DatatypeProperty ;
    rdfs:domain hpc:Shutdownevent ;
    rdfs:range xsd:string .
