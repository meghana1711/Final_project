hpc:Myapplicationoptions a owl:Class .
hpc:reserveinboundbandwidth a owl:ObjectProperty ;
    rdfs:domain hpc:Myapplicationoptions ;
    rdfs:range xsd:string .

hpc:configureelims a owl:ObjectProperty ;
    rdfs:domain hpc:Myapplicationoptions .

hpc:configurelsfcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Myapplicationoptions .

hpc:Ibmssfilesystem a owl:Class .
hpc:volumename a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:maxinbound a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:maxoutbound a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:checkinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:floatingavginterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:decimaldigits a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssfilesystem .

hpc:Ibmssnode a owl:Class .
hpc:addasserver a owl:ObjectProperty ;
    rdfs:domain hpc:Myapplicationoptions .

hpc:configureexternalloadindices a owl:ObjectProperty ;
    rdfs:domain hpc:Myapplicationoptions .

hpc:gstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssnode .

hpc:gbytesin a owl:DatatypeProperty ;
    rdfs:domain hpc:Ibmssnode .
