hpc:Lsfusermapping a owl:Class .
hpc:Submissionuser a owl:Class .
hpc:Hassubmissionuser rdfs:domain hpc:Lsfusermapping ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:mapsTo .
hpc:Hasexecutionuser rdfs:domain hpc:Lsfusermapping ;
    rdfs:range rdf:List .
hpc:mapsto a owl:ObjectProperty .
hpc:Mapsto rdfs:domain hpc:Lsfusermapping ;
    rdfs:range hpc:Submissionuser .
hpc:Bsubmitcommand a owl:Class .
hpc:Bsubmitexample a owl:Class .
hpc:Lsfusermappingfile a owl:Class .
hpc:Lsfusermappingfile rdfs:subClassOf hpc:File .
hpc:Lsfenvdir a owl:Class .
hpc:Ibmcloudgen2instance a owl:Class .
hpc:Ibmcloudgen2instance rdfs:subClassOf hpc:Instance .
hpc:Ibmcloudgen2config a owl:Class .
hpc:Ibmcloudgen2config rdfs:subClassOf hpc:Config .
hpc:Ibmcloudgen2configfile a owl:Class .
hpc:Ibmcloudgen2configfile rdfs:subClassOf hpc:File .
