hpc:Preemptivejob a owl:Class .
hpc:Pendingreason a owl:Class .
hpc:graceperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range xsd:integer .
hpc:Olderversion a owl:Class .
hpc:unknownpendingreason a owl:ObjectProperty ;
    rdfs:domain hpc:Olderversion ;
    rdfs:range xsd:integer .
hpc:Preemptparameter a owl:Class .
hpc:isdefined a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptparameter ;
    rdfs:range hpc:Preemptparameterdefinition .
hpc:Preemptparameterdefinition a owl:Class .
hpc:isoverriddenby a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptparameterdefinition ;
    rdfs:range (hpc:Lsbparams hpc:Lsbqueues hpc:Lsbapplications) .
hpc:hasdefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptparameterdefinition ;
    rdfs:range xsd:string .
hpc:preemptfor a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptparameter .
hpc:haskeyword a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptfor ;
    rdfs:range xsd:string .
hpc:Groupjlp a owl:Class .
hpc:Groupmax a owl:Class .
hpc:Hostjlu a owl:Class .
hpc:Leastruntime a owl:Class .
hpc:Minijob a owl:Class .
hpc:Userjlp a owl:Class .
hpc:Optimalminijob a owl:Class .
hpc:Busy a owl:Class .
hpc:Preemptable a owl:Class .
hpc:Preemptablerunningjob a owl:Class ;
    rdfs:subClassOf hpc:Preemptable .
hpc:Closedbusyhost a owl:Class .
hpc:preemptsslotsonclosedbusyhost a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range hpc:Closedbusyhost .
hpc:reservationtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptsslotsonclosedbusyhost ;
    rdfs:range xsd:duration .
hpc:preemptsnecessaryslots a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range hpc:Preemptable .
hpc:pendswithoutreservations a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range hpc:Preemptivejob .
