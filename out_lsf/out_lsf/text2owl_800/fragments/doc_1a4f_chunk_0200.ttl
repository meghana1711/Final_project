hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:Sharedresource a owl:Class .
hpc:Definedresource a owl:Class .
hpc:Exclusiveresource a owl:Class .

hpc:hasresource a owl:ObjectProperty .
hpc:isshared a owl:ObjectProperty .
hpc:isdefined a owl:ObjectProperty .
hpc:isexclusive a owl:ObjectProperty .

hpc:Job rdfs:subClassOf hpc:Resource .
hpc:Sharedresource rdfs:subClassOf hpc:Resource .
hpc:Definedresource rdfs:subClassOf hpc:Resource .
hpc:Exclusiveresource rdfs:subClassOf hpc:Resource .

hpc:Hasresource rdfs:domain hpc:Job .
hpc:Hasresource rdfs:range hpc:Resource .
hpc:Isshared rdfs:domain hpc:Resource .
hpc:Isdefined rdfs:domain hpc:Job .
hpc:Isexclusive rdfs:domain hpc:Job .

hpc:Resource rdfs:subPropertyOf rdf:type .
hpc:Hasresource rdfs:range hpc:Resource .
hpc:Isshared rdfs:range xsd:Boolean .
hpc:Isdefined rdfs:range xsd:Boolean .
hpc:Isexclusive rdfs:range xsd:Boolean .

hpc:Sharedresource rdfs:subClassOf hpc:Resource .
hpc:Definedresource rdfs:subClassOf hpc:Resource .
hpc:Exclusiveresource rdfs:subClassOf hpc:Resource .

hpc:definedresourcenames a owl:ObjectProperty .
hpc:supportedresourcenames a owl:ObjectProperty .
hpc:excludedresourcenames a owl:ObjectProperty .

hpc:Definedresourcenames rdfs:domain hpc:Definedresource .
hpc:Supportedresourcenames rdfs:domain hpc:Sharedresource .
hpc:Excludedresourcenames rdfs:domain hpc:Job .

hpc:Supportedresourcenames rdfs:range rdfs:Literal .
hpc:Excludedresourcenames rdfs:range rdfs:Literal .

hpc:Supportedresourcenames rdfs:range "lsf.shared" .
hpc:Excludedresourcenames rdfs:range "r15s r1m r15m ut pg io ls tmp swp mem ncpus ndisks maxmem rexpri server hname" .
