hpc:Job a owl:Class .
hpc:JobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:UserId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Name a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JobState a owl:EnumProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    owl:hasValue "PENDING" ;
    owl:hasValue "DRAINING" ;
    owl:hasValue "DRAINED" ;
    owl:hasValue "IDLE" .
hpc:Partition a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:BatchFlag a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Node a owl:Class .
hpc:NodeName a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:State a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string ;
    owl:hasValue "ALLOCATED" ;
    owl:hasValue "DRAIN" ;
    owl:hasValue "DRAINING" ;
    owl:hasValue "DRAINED" ;
    owl:hasValue "IDLE" .
hpc:CPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .
hpc:RealMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .
hpc:TmpDisk a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .
hpc:Weight a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .
hpc:Partition a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
