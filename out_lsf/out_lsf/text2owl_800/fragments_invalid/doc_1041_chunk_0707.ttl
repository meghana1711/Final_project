hpc:normalizedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:absoluterunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Hostmodel a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:defaulthostspec a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Host .

hpc:submithost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Lsfjob a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf (hpc:Job rdfs:subClassOf (hpc:Job [hpc:Absoluterunlimit rdf:value "Y"])) ;
    rdfs:subClassOf (hpc:Job [hpc:Normalizedruntime rdf:value true]) .

hpc:Multiclusterjob a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob ;
    rdfs:subClassOf (hpc:Job [hpc:Normalizedruntime rdf:value false]) .
