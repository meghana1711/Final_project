hpc:Jobsubmission a owl:Class .
hpc:Podmanappprofile a owl:Class .
hpc:Podmanq a owl:Class .
hpc:Podmancontainerjob a owl:Class .
hpc:lsbcontainerimage a owl:DatatypeProperty .
hpc:Haspodmanappprofile rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Podmanappprofile .
hpc:Haspodmanq rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Podmanq .
hpc:Haspodmancontainerjob rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Podmancontainerjob .
hpc:Haslsbcontainerimage rdfs:domain hpc:Podmancontainerjob ;
    rdfs:range xsd:string .
hpc:Enrootcontainerjob a owl:Class .
hpc:Lsf a owl:Class .
hpc:Esubscript a owl:Class .
hpc:Usesesubscript rdfs:domain hpc:Enrootcontainerjob ;
    rdfs:range hpc:Esubscript .
