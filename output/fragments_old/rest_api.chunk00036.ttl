hpc:Cluster a owl:Class .
hpc:ClusterName hpc:accounting_storage rdfs:domain hpc:Cluster .
hpc:ClusterName rdfs:range xsd:string .

hpc:Release hpc:release rdfs:domain hpc:Cluster .
hpc:Release rdfs:range xsd:string .

hpc:Version hpc:version rdfs:domain hpc:Cluster .
hpc:Version rdfs:subClassOf owl:Class .
hpc:Version rdfs:range hpc:VersionType .

hpc:Major hpc:major rdfs:domain hpc:Version .
hpc:Major rdfs:range xsd:nonNegativeInteger .

hpc:Minor hpc:minor rdfs:domain hpc:Version .
hpc:Minor rdfs:range xsd:nonNegativeInteger .

hpc:Micro hpc:micro rdfs:domain hpc:Version .
hpc:Micro rdfs:range xsd:nonNegativeInteger .

hpc:Association a owl:Class .

hpc:DeletedClusters hpc:deleted_clusters rdfs:domain hpc:Association .
hpc:DeletedClusters rdfs:range rdf:List .

hpc:Warning a owl:Class .
hpc:Description hpc:description rdfs:domain hpc:Warning .
hpc:Description rdfs:range xsd:string .
hpc:Source hpc:source rdfs:domain hpc:Warning .
hpc:Source rdfs:range xsd:string .

hpc:Error a owl:Class .
hpc:Description hpc:description rdfs:domain hpc:Error .
hpc:Description rdfs:range xsd:string .
hpc:Source hpc:source rdfs:domain hpc:Error .
hpc:Source rdfs:range xsd:string .
hpc:ErrorNumber hpc:error_number rdfs:domain hpc:Error .
hpc:ErrorNumber rdfs:range xsd:nonNegativeInteger .

hpc:QOS a owl:Class .
hpc:QOSName hpc:qos rdfs:domain hpc:QOS .
hpc:QOSName rdfs:range xsd:string .

hpc:RemovedQOS hpc:removed_qos rdfs:domain hpc:Association .
hpc:RemovedQOS rdfs:range rdf:List .

