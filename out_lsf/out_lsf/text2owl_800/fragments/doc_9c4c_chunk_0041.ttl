hpc:Lsfconfiguration a owl:Class .

# EGO_DAEMON_CONTROL property
hpc:egodaemoncontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .

# EGO_DAEMON_CONTROL property range restrictions
hpc:EGO_DAEMON_CONTROL rdfs:subPropertyOf hpc:datatypeProperty ;
    rdfs:range [ rdf:type owl:Restriction ;
                  rdfs:onDatatype xsd:string ;
                  rdfs:hasValue "Y" ;
                  owl:someValuesFrom [ rdf:type xsd:string ; xsd:enumeration "Y" ] ;
                  owl:someValuesFrom [ rdf:type xsd:string ; xsd:enumeration "N" ] ] .

# EGO_DAEMON_CONTROL property description
hpc:egoDaemonControl rdfs:comment "Enables EGO to control the LSF res and sbatchd daemons. Syntax: EGO_DAEMON_CONTROL=\"Y\" | \"N\"" .
