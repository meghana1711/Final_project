hpc:Job a owl:Class .
hpc:Licensefeature a owl:Class .
hpc:Clustermode a owl:Class .
hpc:rusage a owl:ObjectProperty .
hpc:Predeterminedpartofjob a owl:Class .
hpc:Unknownlicenserequirement a owl:Class .
hpc:Reservedforentirejob a owl:Class .
hpc:includedinrusage a owl:ObjectProperty .
hpc:Managedworkload a owl:Class .
hpc:Clustermodenotspecifiedduration a owl:Class .
hpc:Flexnetmanager a owl:Class .
hpc:reserve a owl:ObjectProperty .
hpc:Reservedbyflexnetmanager a owl:Class .
hpc:countedasothers a owl:ObjectProperty .
hpc:Blstatcommandoutput a owl:Class .
hpc:othersvalue a owl:DatatypeProperty .
hpc:freevalue a owl:DatatypeProperty .
hpc:Strictmode a owl:Class .
hpc:enabledynamicrusage a owl:ObjectProperty .
hpc:Projectmode a owl:Class .

hpc:Job rdfs:subClassOf owl:Thing .
hpc:Licensefeature rdfs:subClassOf owl:Thing .
hpc:Clustermode rdfs:subClassOf hpc:Job .
hpc:Rusage rdfs:domain hpc:Job ;
                             rdfs:range hpc:Licensefeature .
hpc:Predeterminedpartofjob rdfs:subClassOf hpc:Licensefeature .
hpc:Unknownlicenserequirement rdfs:subClassOf hpc:Licensefeature .
hpc:Reservedforentirejob rdfs:subClassOf hpc:Predeterminedpartofjob .
hpc:Includedinrusage rdfs:domain hpc:Job ;
                             rdfs:range hpc:Predeterminedpartofjob .
hpc:Managedworkload rdfs:subClassOf hpc:Clustermode .
hpc:Clustermodenotspecifiedduration rdfs:subClassOf hpc:Managedworkload .
hpc:Flexnetmanager rdfs:subClassOf owl:Thing .
hpc:Reserve rdfs:domain hpc:Flexnetmanager ;
                             rdfs:range hpc:Job .
hpc:Reservedbyflexnetmanager rdfs:subClassOf hpc:Reservedforentirejob .
hpc:Countedasothers rdfs:domain hpc:Reservedbyflexnetmanager ;
                             rdfs:range hpc:Blstatcommandoutput .
hpc:Blstatcommandoutput rdfs:subClassOf owl:Thing .
hpc:Othersvalue rdfs:domain hpc:Blstatcommandoutput ;
                             rdfs:range xsd:decimal .
hpc:Freevalue rdfs:domain hpc:Blstatcommandoutput ;
                             rdfs:range xsd:decimal .
hpc:Strictmode rdfs:subClassOf owl:Thing .
hpc:Enabledynamicrusage rdfs:domain hpc:Strictmode ;
                             rdfs:range hpc:Job .
hpc:ProjectMode rdfs:subClass
