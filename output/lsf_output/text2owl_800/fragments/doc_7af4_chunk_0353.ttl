hpc:LsfEnvdir a owl:Class .
hpc:Lsbatch a owl:Class .
hpc:ClusterName a owl:Class .
hpc:conﬁgdir a owl:Class .
hpc:lsbThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbatch ;
    rdfs:range xsd:string .

hpc:PersistLiveConfig a owl:Class ;
    rdfs:subClassOf hpc:LsbConfigOption .
hpc:PersistLiveConfigY a owl:Class ;
    rdfs:subClassOf hpc:PersistLiveConfig ;
    rdfs:subClassOf xsd:string .
hpc:PersistLiveConfigN a owl:Class ;
    rdfs:subClassOf hpc:PersistLiveConfig ;
    rdfs:subClassOf xsd:string .

hpc:PgSuspIt a owl:Class ;
    rdfs:subClassOf hpc:LsbConfigOption .
hpc:pgSuspItSeconds a owl:DatatypeProperty ;
    rdfs:domain hpc:PgSuspIt ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Plan a owl:Class .
hpc:PlanY a owl:Class ;
    rdfs:subClassOf hpc:Plan ;
    rdfs:subClassOf xsd:boolean .
hpc:PlanN a owl:Class ;
    rdfs:subClassOf hpc:Plan ;
    rdfs:subClassOf xsd:boolean .
hpc:planKey a owl:ObjectProperty .
hpc:planValue a owl:DatatypeProperty .
hpc:PlanDelay a owl:Class ;
    rdfs:subClassOf hpc:PlanKey ;
    rdfs:subClassOf xsd:nonNegativeInteger .
