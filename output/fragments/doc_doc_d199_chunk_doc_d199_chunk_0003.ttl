hpc:StaticClientCode a owl:Class .
hpc:OpenAPISchema a owl:Class .
hpc:VersionedPlugin a owl:Class .
hpc:ClientCompile a owl:ObjectProperty .
hpc:VersionTagged a owl:Class .
hpc:CommunicateWithSlurm a owl:ObjectProperty .
hpc:CompileSuccess a owl:ObjectProperty .
hpc:VersionRemovalCadence rdf:Datatype rdfs:Resource .
hpc:OpenAPISchemaVersion a xsd:string .
hpc:ClientCodeRepository rdf:Datatype rdfs:Resource .
hpc:StaticClientCode rdfs:subClassOf hpc:ClientCodeRepository .
hpc:OpenAPISchema rdfs:subClassOf hpc:ClientCodeRepository .
hpc:VersionedPlugin rdfs:subClassOf hpc:ClientCodeRepository .
hpc:VersionTagged rdfs:subClassOf hpc:ClientCodeRepository .
hpc:ClientCompile rdfs:domain hpc:StaticClientCode ;
    rdfs:range xsd:boolean .
hpc:CommunicateWithSlurm rdfs:domain hpc:VersionedPlugin ;
    rdfs:range xsd:boolean .
hpc:CompileSuccess rdfs:domain hpc:VersionedPlugin ;
    rdfs:range xsd:boolean .
hpc:VersionTagged rdf:subPropertyOf hpc:ClientCompile .
hpc:VersionRemovalCadence rdfs:domain hpc:VersionedPlugin ;
    rdfs:range xsd:string .
