hpc:Federatedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:haslocalresourceconstraints a owl:ObjectProperty ;
    rdfs:domain hpc:Federatedjob ;
    rdfs:range xsd:boolean .

hpc:runsonsinglecluster a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:boolean .

hpc:jobmodificationsuccessrequiresorigincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:jobmodificationscopeorigincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:sviewgriddisabled a owl:ObjectProperty ;
    rdfs:domain hpc:Federatedview ;
    rdfs:range xsd:boolean .

hpc:modificationtootherthanjobsdisabled a owl:ObjectProperty ;
    rdfs:domain hpc:Sview ;
    rdfs:range xsd:boolean .
