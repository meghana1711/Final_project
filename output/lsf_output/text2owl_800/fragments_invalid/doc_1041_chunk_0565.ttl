hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:RootAdmin a hpc:User .
hpc:LSFAdmin a hpc:User .
hpc:Ownjob a owl:Class .
hpc:Submittedjob a owl:Class .
hpc:setexternaljobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Submittedjob .
hpc:getexternaljobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Submittedjob .
hpc:hasjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .
hpc:JobNameLengthConstraint a owl:Restriction ;
    rdfs:onProperty hpc:JobName ;
    owl:onClass hpc:SubmittedJob ;
    xsd:maxLength "4094" .
hpc:OwnJob subClassOf hpc:SubmittedJob .
hpc:Rootadmin rdfs:subClassOf hpc:User ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( hpc:User
                                hpc:canSetExternalJobStatus ) ] .
hpc:Lsfadmin rdfs:subClassOf hpc:User ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( hpc:User
                                hpc:canSetExternalJobStatus ) ] .
hpc:cansetexternaljobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User ;
    rdfs:subPropertyOf hpc:canGetExternalJobStatus .
hpc:cangetexternaljobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Ownjob ;
    rdfs:subPropertyOf hpc:canSetExternalJobStatus .
