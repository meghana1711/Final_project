hpc:Application a owl:Class .
hpc:Datamanager a owl:Class .
hpc:Datalocality a owl:Class .
hpc:datastage a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datafile .
hpc:Datarepository a owl:Class .
hpc:datarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Datafile .
hpc:Datamanageradmin a owl:Class ;
    rdfs:subClassOf hpc:Lsfadministrator .
hpc:Datamanagerplan a owl:Class .
hpc:datamanagerinstall a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerplan ;
    rdfs:range hpc:Cluster .
hpc:datamanagersubmit a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Job .
hpc:datamanagercontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Job .
hpc:datamanagermonitor a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Job .
hpc:Datamanagerconfig a owl:Class .
hpc:datamanagerconfigfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanagerconfig ;
    rdfs:range xsd:string .
