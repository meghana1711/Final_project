hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:userDeleted a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:boolean .

hpc:Users a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf rdf:List .

hpc:usersDeleted a owl:DatatypeProperty ;
    rdfs:domain hpc:Users ;
    rdfs:range xsd:boolean .

hpc:Qos a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:qosWithDeleted a owl:ObjectProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:boolean .

hpc:Account a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:accountWithDeleted a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:boolean .
