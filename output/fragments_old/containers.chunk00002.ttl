# Container Runtime
hpc:ContainerRuntime a owl:Class .

hpc:crun a owl:Class ;
  rdfs:subClassOf hpc:ContainerRuntime .

hpc:nvidiaContainerRuntime a owl:Class ;
  rdfs:subClassOf hpc:ContainerRuntime .

hpc:Singularity a owl:Class ;
  rdfs:subClassOf hpc:ContainerRuntime .

hpc:hpcngSingularity a owl:Class ;
  rdfs:subClassOf hpc:Singularity .

hpc:Charliecloud a owl:Class ;
  rdfs:subClassOf hpc:ContainerRuntime .

# Common Properties
hpc:rootless a owl:ObjectProperty .
hpc:root a owl:ObjectProperty .
hpc:bundle a owl:ObjectProperty .
hpc:state a owl:ObjectProperty .
hpc:create a owl:ObjectProperty .
hpc:start a owl:ObjectProperty .
hpc:kill a owl:ObjectProperty .
hpc:delete a owl:ObjectProperty .
hpc:run a owl:ObjectProperty .

# crun specific properties
hpc:crunCreate a owl:ObjectProperty ;
  rdfs:domain hpc:crun ;
  rdfs:range xsd:string .
hpc:crunStart a owl:ObjectProperty ;
  rdfs:domain hpc:crun ;
  rdfs:range xsd:string .
hpc:crunKill a owl:ObjectProperty ;
  rdfs:domain hpc:crun ;
  rdfs:range xsd:string .
hpc:crunDelete a owl:ObjectProperty ;
  rdfs:domain hpc:crun ;
  rdfs:range xsd:string .

# nvidia-container-runtime specific properties
hpc:nvidiaContainerRuntimeCreate a owl:ObjectProperty ;
  rdfs:domain hpc:nvidiaContainerRuntime ;
  rdfs:range rdf:List .
hpc:nvidiaContainerRuntimeStart a owl:ObjectProperty ;
  rdfs:domain hpc:nvidiaContainerRuntime ;
  rdfs:range rdf:List .
hpc:nvidiaContainerRuntimeKill a owl:ObjectProperty ;
  rdfs:domain hpc:nvidiaContainerRuntime ;
  rdfs:range xsd:string .
hpc:nvidiaContainerRuntimeDelete a owl:ObjectProperty ;
  rdfs:domain hpc:nvidiaContainerRuntime ;
  rdfs:range xsd:string .
hpc:nvidiaContainerRuntimeRun a owl:ObjectProperty ;
