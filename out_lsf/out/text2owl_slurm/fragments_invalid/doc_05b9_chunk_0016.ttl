@base <http://example.org/hpc/>

hpc:Job a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf [ rdf:type hpc:Apiresponse ] .

hpc:Joblist a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf [ rdf:type hpc:Apiresponselist ] .

hpc:Job
    hpc:hasqueryparameter a owl:ObjectProperty ;
        rdfs:domain hpc:Job ;
        rdfs:range xsd:string .
    hpc:hasusers a owl:ObjectProperty ;
        rdfs:domain hpc:Job ;
        rdfs:range xsd:string .
    hpc:haswckey a owl:ObjectProperty ;
        rdfs:domain hpc:Job ;
        rdfs:range xsd:string .

hpc:Apiresponse a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Apiresponselist a owl:Class ;
    rdfs:subClass
