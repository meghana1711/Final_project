hpc:Host a owl:Class .
hpc:Host rdfs:subClassOf owl:Class .

hpc:Hostgroup a owl:Class .
hpc:Hostgroup rdfs:subClassOf owl:Class .

hpc:User a owl:Class .
hpc:User rdfs:subClassOf owl:Class .

hpc:Usergroup a owl:Class .
hpc:Usergroup rdfs:subClassOf owl:Class .

hpc:Project a owl:Class .
hpc:Project rdfs:subClassOf owl:Class .

hpc:Licproject a owl:Class .
hpc:Licproject rdfs:subClassOf owl:Class .

hpc:slots a owl:ObjectProperty .
hpc:Slots rdfs:domain hpc:Project ;
                             rdfs:range xsd:nonNegativeInteger .

hpc:slotsPerProcessor a owl:ObjectProperty .
hpc:SlotsPerProcessor rdfs:domain hpc:Project ;
                                 rdfs:range xsd:nonNegativeInteger .
