hpc:Lsbparams a owl:Class .
hpc:Mbatchddaemon a owl:Class .
hpc:Parameters a owl:Class .
hpc:lsbparamsfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:File .
hpc:usesforinitialization a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchddaemon ;
    rdfs:range hpc:Parameters .
hpc:isoptional a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparamsfile ;
    rdfs:range xsd:boolean .
hpc:hasparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Parameters ;
    rdfs:range hpc:Parameter .
hpc:controlstiming a owl:ObjectProperty ;
    rdfs:domain hpc:Parameters ;
    rdfs:range hpc:Timingcontrol .
hpc:defaultsettings a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters ;
    rdfs:range xsd:string .
hpc:isinstalledbydefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparamsfile ;
    rdfs:range xsd:boolean .
hpc:changeconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Badminreconfigure .
hpc:Automatictimebasedconfiguration a owl:Class .
hpc:definesinlsbparams a owl:ObjectProperty ;
    rdfs:domain hpc:Automatictimebasedconfiguration ;
    rdfs:range hpc:Ifelseconstruct .
hpc:usestimeexpressions a owl:ObjectProperty ;
    rdfs:domain hpc:Automatictimebasedconfiguration ;
    rdfs:range xsd:boolean .
hpc:iftimeexpression a owl:ObjectProperty ;
    rdfs:domain hpc:Automatictimebasedconfiguration ;
    rdfs:range hpc:Timeexpression .
hpc:Shortjobexpressperiod a owl:Class .
hpc:hastimeexpression a owl:ObjectProperty ;
    rdfs:domain hpc:Shortjobexpressperiod ;
    rdfs:range hpc:Timeexpression .
hpc:Defaultqueue a owl:Class .
hpc:isdefaultqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Shortjobexpressperiod ;
    rdfs:range hpc:Defaultqueue .
hpc:Normalqueue a owl:Class .
hpc:isnormalqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Timeexpression ;
    rdfs:range hdfs:normalQueue .
