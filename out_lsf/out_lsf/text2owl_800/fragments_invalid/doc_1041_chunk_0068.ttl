hpc:Lsfproxydhost a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Userathost a owl:Class .

# Object Properties
hpc:isblockedon a owl:ObjectProperty .
hpc:blocks a owl:ObjectProperty .

# Datatype Properties
hpc:Hasusername rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:Hashostname rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Hashostandusername rdfs:domain hpc:Userathost ;
    rdfs:range xsd:string .

# Subclass relations
hpc:Userathost a owl:Class ;
    rdfs:subClassOf hpc:User owl:Class ;
    rdfs:subClassOf hpc:Host owl:Class .

# Domain and Range
hpc:Isblockedon rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Userathost .
hpc:Blocks rdfs:domain hpc:Lsfproxydhost ;
    rdfs:domain hpc:User ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Userathost .

# Examples
hpc:LSFProxydHost1 a hpc:LSFProxydHost .
hpc:Lsfproxydhost1 hpc:isblockedon hpc:User1 .
hpc:Lsfproxydhost1 hpc:isblockedon hpc:User2 .
hpc:Lsfproxydhost1 hpc:blocks hpc:HostA .
hpc:Lsfproxydhost1 hpc:blocks hpc:HostB .
hpc:User1 a hpc:User ;
    hpc:hasUsername "user1" .
hpc:User2 a hpc:User ;
    hpc:hasUsername "user2" .
hpc:HostA a hpc:Host ;
    hpc:hasHostname "hostA" .
hpc:HostB a hpc:Host ;
    hpc:hasHostname "hostB" .
hpc:User1AtHost1 a hpc:UserAtHost ;
    hpc:hasUsername "user1" ;
    hpc:hasHostname "hostA" ;
    hpc:Isblockedon hpc:lsfproxydhost1 .
hpc:User1AtHost2 a hpc:UserAtHost ;
    hpc:hasUsername "user1" ;
    hpc:hasHostname "hostB" ;
    hpc:Isblockedon hpc:lsfproxydhost1 .
