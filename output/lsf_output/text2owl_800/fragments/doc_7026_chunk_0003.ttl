hpc:Lsfuser a owl:Class .
hpc:Lsfjob a owl:Class .
hpc:secureshell a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Lsfjob .
hpc:jobaccessrestriction a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:jobuserid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:jobsubmissionuserid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:bjobscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:bhistcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:Jobinformation a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Basicjobinformation a owl:Class ;
    rdfs:subClassOf hpc:Jobinformation .
hpc:Detailedjobinformation a owl:Class ;
    rdfs:subClassOf hpc:Jobinformation .
hpc:JobAccessLevel a owl:Enum ;
    rdfs:member "user" ;
    rdfs:member "administrator" .
hpc:jobstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range xsd:string .
hpc:jobuser a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range hpc:Lsfuser .
hpc:jobusergroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range xsd:string .
hpc:joballusers a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range xsd:string .
