hpc:Host a owl:Class .
hpc:Logging a owl:Class .
hpc:Debugoptions a owl:Class .
hpc:debuglevel a owl:DatatypeProperty .
hpc:HostHaslogging hpc:Logging rdfs:domain hpc:Host ;
                      rdfs:range xsd:boolean .
hpc:Logging_isEnabledByDefault rdf:value false .
hpc:LoggingIsdirectedto hpc:file .
hpc:File a owl:Class .
hpc:DebugoptionsHasdebuglevel hpc:debuglevel .
hpc:DebugLevel_isLevel1 rdf:value "LOG_WARNING" .
hpc:DebugLevel_isLevel2 rdf:value "LOG_INFO" .
hpc:DebugLevel_isLevel3 rdf:value "LOG_DEBUG" .
hpc:debugoptionsIslevel1 a owl:ObjectProperty ;
                            rdfs:subPropertyOf hpc:DebugOptions_hasDebugLevel ;
                            rdfs:domain hpc:Debugoptions .
hpc:debugoptionsIslevel2 a owl:ObjectProperty ;
                            rdfs:subPropertyOf hpc:DebugOptions_hasDebugLevel ;
                            rdfs:domain hpc:Debugoptions .
hpc:debugoptionsIslevel3 a owl:ObjectProperty ;
                            rdfs:subPropertyOf hpc:DebugOptions_hasDebugClass ;
                            rdfs:domain hpc:Debugoptions .
hpc:debugoptionsHasdebugclass a owl:ObjectProperty ;
                               rdfs:domain hpc:Debugoptions .
hpc:debugoptionsHasdebugmodules a owl:ObjectProperty ;
                                 rdfs:domain hpc:Debugoptions .
