hpc:Selection a owl:Class .
hpc:ordering a owl:ObjectProperty .
hpc:Resourceusage a owl:Class .
hpc:usage a owl:DatatypeProperty .
hpc:jobspanning a owl:ObjectProperty .
hpc:Same a owl:Class .
hpc:jobspanningacross a owl:DatatypeProperty .
hpc:Computeunit a owl:Class .
hpc:cpuandmemoryaffinity a owl:ObjectProperty .
hpc:Affinity a owl:Class .
hpc:cpuaffinity a owl:DatatypeProperty .
hpc:memoryaffinity a owl:DatatypeProperty .

hpc:Selection rdfs:subClassOf owl:Class .
hpc:Ordering rdfs:domain hpc:Selection ;
                               rdfs:range rdf:List .
hpc:Resourceusage rdfs:subClassOf owl:Class .
hpc:Jobspanning rdfs:domain hpc:Selection ;
                             rdfs:range hpc:Job .
hpc:Same rdfs:subClassOf owl:Class .
hpc:Computeunit rdfs:subClassOf owl:Class .
hpc:Cpuandmemoryaffinity rdfs:domain hpc:Job ;
                               rdfs:range hpc:Affinity .
hpc:Affinity rdfs:subClassOf owl:Class .
hpc:Cpuaffinity rdfs:domain hpc:Affinity ;
                          rdfs:range xsd:integer .
hpc:Memoryaffinity rdfs:domain hpc:Affinity ;
                          rdfs:range xsd:integer .
