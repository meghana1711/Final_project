hpc:Licenseschedulerjob a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:commonlicense a owl:ObjectProperty .
hpc:Preemptiblequeue a owl:Class .
hpc:preemptionqueuepreference a owl:ObjectProperty .
hpc:Preemptivequeue a owl:Class .
hpc:preemptionrelationship a owl:ObjectProperty .
hpc:memorypreemption a owl:ObjectProperty .
hpc:preemptableresources a owl:DatatypeProperty .
hpc:preemptablememory a owl:DatatypeProperty .
hpc:suspendedjobmemoryreservation a owl:ObjectProperty .
hpc:Ssuspjob a owl:Class .

hpc:Licenseschedulerjob rdfs:subClassOf owl:Class .
hpc:Suspendedjob rdfs:subClassOf hpc:Licenseschedulerjob .
hpc:Commonlicense rdfs:domain hpc:Licenseschedulerjob ;
                     rdfs:range hpc:Licenseschedulerjob .
hpc:Preemptiblequeue rdfs:subClassOf owl:Class .
hpc:Preemptionqueuepreference rdfs:domain hpc:Preemptiblequeue ;
                              rdfs:range hpc:Preemptiblequeue .
hpc:Preemptivequeue rdfs:subClassOf owl:Class .
hpc:Preemptionrelationship rdfs:domain hpc:Preemptivequeue ;
                            rdfs:range hpc:Preemptivequeue .
hpc:Memorypreemption rdfs:domain hpc:Preemptiblequeue ;
                     rdfs:range hpc:Preemptableresources .
hpc:Preemptableresources rdfs:range xsd:string .
hpc:Preemptablememory rdfs:domain hpc:Preemptableresources ;
                      rdfs:range xsd:string .
hpc:Suspendedjobmemoryreservation rdfs:domain hpc:Suspendedjob ;
                                   rdfs:range hpc:Preemptablememory .
hpc:Ssuspjob rdfs:subClassOf owl:Class .
