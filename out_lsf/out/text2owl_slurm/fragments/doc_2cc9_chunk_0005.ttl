hpc:Mpidefault a owl:Class .
hpc:Mpidefault rdfs:subClassOf xsd:string .

hpc:MPIPMI2 rdf:type hpc:MPIDefault ;
    rdfs:label "For PMI2-supporting MPI implementations" .

hpc:MPIPMix rdf:type hpc:MPIDefault ;
    rdfs:label "Exascale PMI implementation" .

hpc:None rdf:type hpc:MPIDefault ;
    rdfs:label "This works for most other MPI types" .

hpc:Processtracking a owl:Class .

hpc:Cgroup rdf:type hpc:ProcessTracking ;
    rdfs:label "Use Linux cgroup to create a job container and track processes" .

hpc:LinuxProc rdf:type hpc:ProcessTracking ;
    rdfs:label "Use parent process ID records, processes can escape from Slurm control" .

hpc:Pgid rdf:type hpc:ProcessTracking ;
    rdfs:label "Use Unix Process Group ID, processes changing their process group ID can escape from Slurm control" .

hpc:Selecttype a owl:Class .

hpc:cons_tres rdf:type hpc:SelectType ;
    rdfs:label "Allocate individual processors, memory, GPUs, and other trackable resources" .

hpc:Linear rdf:type hpc:SelectType ;
    rdfs:label "Node-base resource allocation, does not manage individual processor allocation" .

hpc:Tasklaunch a owl:Class .

hpc:None rdf:type hpc:TaskLaunch .

hpc:Affinity rdf:type hpc:TaskLaunch ;
    rdfs:label "CPU affinity support (see srun man pages for the --cpu-bind, --mem-bind, and -E options)" .

hpc:AllocatedResources rdf:type hpc:TaskLaunch ;
    rdfs:label "Allocated resources constraints enforcement using Linux Control Groups (see cgroup.conf man page)" .

hpc:Prologepilog a owl:Class .

hpc:Prolog rdf:type hpc:PrologEpilog ;
    rdfs:label "Path that will be executed as root on every node of a user's job before the job's tasks will be initiated there" .

hpc:Epilog rdf:type hpc:PrologEpilog ;
    rdfs:label "Path that will be executed as root on every node of a user's job after that job has terminated" .
