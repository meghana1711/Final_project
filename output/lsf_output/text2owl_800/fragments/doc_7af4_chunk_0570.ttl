hpc:Consumer a owl:Class .
hpc:hasconsumername a owl:ObjectProperty .
hpc:Hasconsumername rdfs:domain hpc:Consumer ;
                      rdfs:range xsd:string .

hpc:Sla a owl:Class ;
        rdfs:subClassOf owl:Class .

hpc:hasconsumer a owl:ObjectProperty ;
                rdfs:domain hpc:Sla .

hpc:Controlaction a owl:Class ;
                 rdfs:subClassOf owl:Class .

hpc:hasviolationperiod a owl:DatatypeProperty ;
                       rdfs:domain hpc:Controlaction ;
                       rdfs:range xsd:nonNegativeInteger .

hpc:hascommand a owl:ObjectProperty ;
               rdfs:domain hpc:Controlaction ;
               rdfs:range xsd:string .

hpc:Description a owl:Class ;
               rdfs:subClassOf owl:Class .
hpc:hasdescription a owl:DatatypeProperty ;
                  rdfs:domain hpc:Description ;
                  rdfs:range xsd:string .
