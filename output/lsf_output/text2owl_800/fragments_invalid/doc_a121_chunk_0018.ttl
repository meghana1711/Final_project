hpc:Serviceclass a owl:Class .
hpc:Jobgroup a owl:Class .
hpc:Jobpriority a owl:Class .
hpc:advancereservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .
hpc:esub a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .
hpc:sla a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass .
    rdfs:range hpc:Job .
hpc:Jobgroup rdfs:subClassOf hpc:Serviceclass .
hpc:Jobpriority rdfs:subClassOf hpc:Serviceclass .
hpc:killreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .
hpc:suspendreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .
