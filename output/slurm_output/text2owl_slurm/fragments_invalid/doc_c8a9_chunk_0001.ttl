hpc:Job a owl:Class.
hpc:Preemptablejob a owl:Class.
hpc:Highpriorityjob a owl:Class.
hpc:Lowpriorityjob a owl:Class.

hpc:preemption a owl:ObjectProperty.
hpc:Preemptedby rdfs:domain hpc:Job ;
                rdfs:range hpc:Preemptablejob.
hpc:Preempts rdfs:domain hpc:Preemptablejob ;
              rdfs:range hpc:Job.

hpc:Partition a owl:Class.
hpc:prioritytier a owl:Dat
