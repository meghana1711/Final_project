hpc:Jobslot a owl:Class .
hpc:Jobslot rdfs:subClassOf owl:Class .
hpc:JobSlot rdfs:comment "A job slot is a bucket into which a single unit of work is assigned in the LSF system." .

hpc:Jobslot rdfs:domain hpc:Job .

hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf owl:Class .
hpc:Job rdfs:comment "Jobs can be complex problems, simulation scenarios, extensive calculations, or anything that needs compute power." .

hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:Queue rdfs:comment "A cluster-wide container for jobs. All jobs wait in queues until they are scheduled and dispatched to hosts." .

hpc:Queue rdfs:domain hpc:Cluster .

hpc:Cluster a owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:comment "A cluster of servers." .

hpc:Host a owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Host rdfs:comment "A server in a cluster." .

hpc:Host rdfs:domain hpc:Cluster .

hpc:hasjobslot hpc:jobslot a owl:ObjectProperty .
hpc:Hasjobslot rdfs:domain hpc:Host .
hpc:Hasjobslot rdfs:range hpc:Jobslot .

hpc:hasqueue hpc:queue a owl:ObjectProperty .
hpc:Hasqueue rdfs:domain hpc:Job .
hpc:Hasqueue rdfs:range hpc:Queue .

hpc:Cluster rdfs:subPropertyOf hpc:hasQueue .

hpc:Hasresource rdfs:domain hpc:Resource .
hpc:Hasresource rdfs:range hpc:Host .

hpc:Resource a owl:Class .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:Resource rdfs:comment "Resources are the objects in your cluster that are available to run work." .

hpc:Resource rdfs:subClassOf rdf:List .
hpc:Resource rdfs:member rdfs:Resource .

hpc:hascpu hpc:cpu a owl:DatatypeProperty .
hpc:Hascpu rdfs:domain hpc:Host .
hpc:Hascpu rdfs:range xsd:nonNegativeInteger .

hpc:CPU rdfs:datatype xsd:nonNegativeInteger .
