hpc:Host a owl:Class .
hpc:Hostname hpc:Host rdfs:domain xsd:string .
hpc:Type hpc:Host rdfs:domain xsd:string .
hpc:Server hpc:Host rdfs:domain xsd:string .
hpc:Resource hpc:Host rdfs:domain xsd:string .
hpc:Resources hpc:Host rdfs:domain xsd:string .
hpc:Hosta hpc:host a owl:NamedIndividual ;
    hpc:HOSTNAME "hostA" ;
    hpc:type "NTX86" ;
    hpc:server "1" ;
    hpc:tmp " - - - " ;
    hpc:resource "(msts)" .

hpc:Tsjobcounter hpc:objectproperty .
hpc:Tsjobcounter rdfs:domain hpc:Host .
hpc:Tsjobcounter rdfs:range xsd:integer .

hpc:Tsjob hpc:objectproperty .
hpc:Tsjob rdfs:domain hpc:Host .
hpc:Tsjob rdfs:range hpc:Tsjob .

hpc:Tsjobcountervalue hpc:datatypeproperty .
hpc:Tsjobcountervalue rdfs:domain hpc:Host .
hpc:Tsjobcountervalue rdfs:range xsd:integer .

hpc:Tsjobresource hpc:objectproperty .
hpc:Tsjobresource rdfs:domain hpc:Host .
hpc:Tsjobresource rdfs:range xsd:string .

hpc:tsjobcounter a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:tsjobCounterValue .

hpc:tsjob a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:tsjobResource .

hpc:tsjobcountervalue a owl:DatatypeProperty .

hpc:tsjobresource a owl:ObjectProperty .

hpc:Win hpc:objectproperty .
hpc:Win rdfs:domain hpc:Tsjob .
hpc:Win rdfs:range xsd:string .

hpc:Tsjobmap hpc:objectproperty .
hpc:Tsjobmap rdfs:domain hpc:Tsjob .
hpc:Tsjobmap rdfs:range hpc:Tsjobmapvalue .

hpc:Tsjobmapvalue hpc:datatypeproperty .
hpc:Tsjobmapvalue rdfs:domain hpc:Tsjobmap .
hpc:Tsjobmapvalue rdfs:range xsd:integer .
