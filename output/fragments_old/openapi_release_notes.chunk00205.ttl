hpc:JobInfo a owl:Class .
hpc:JobState a owl:Class .
hpc:Licenses a owl:Class .

hpc:jobInfoResponse a owl:ObjectProperty .
hpc:jobStateResponse a owl:ObjectProperty .
hpc:licensesResponse a owl:ObjectProperty .

hpc:jobInfoResponse rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf hpc:jobStateResponse .

hpc:jobStateResponse rdfs:domain hpc:JobState ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf hpc:jobInfoResponse .

hpc:licensesResponse rdfs:domain hpc:Licenses ;
    rdfs:range xsd:anyURI .
```
