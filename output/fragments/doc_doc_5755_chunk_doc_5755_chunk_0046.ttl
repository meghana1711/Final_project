hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:Database a owl:Class .
hpc:File a owl:Class .
hpc:Directory a owl:Class .
hpc:PAMConfiguration a owl:Class .

hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:User .

hpc:isInAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .

hpc:hasFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range hpc:File .

hpc:hasPAMConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range hpc:PAMConfiguration .

hpc:hasSufficientFlag rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PAMConfiguration ;
    rdfs:range xsd:string .

hpc:hasItem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PAMConfiguration ;
    rdfs:range xsd:string .

hpc:hasFileForItem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PAMConfiguration ;
    rdfs:range hpc:File .

hpc:hasSense rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PAMConfiguration ;
    rdfs:range xsd:string .

hpc:hasOnerr rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PAMConfiguration ;
    rdfs:range xsd:string .

hpc:hasCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .

hpc:hasOldAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .

hpc:hasNewAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Account .

hpc:hasUID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:User .

hpc:requiresRestart rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
```
