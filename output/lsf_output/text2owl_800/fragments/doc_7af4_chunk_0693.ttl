hpc:Excludedhostperiod a owl:Class .
hpc:mbdSleepTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Excludedhostperiod ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsbExcludeHostPeriod a owl:DatatypeProperty ;
    rdfs:domain hpc:Excludedhostperiod ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsbFanoutTimeoutPerLayer a owl:DatatypeProperty ;
    rdfs:domain hpc:Excludedhostperiod ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LSB_FANOUT_TIMEOUT_PER_LAYER_Default a xsd:integer .
hpc:lsbForkJobRequest a owl:ObjectProperty ;
    rdfs:domain hpc:Excludedhostperiod ;
    rdfs:range xsd:string .
hpc:LSB_FORK_JOB_REQUEST_Default a xsd:string .
hpc:lsbGpdCluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Excludedhostperiod ;
    rdfs:range xsd:string .
