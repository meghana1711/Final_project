hpc:Resourcerequirement a owl:Class .
hpc:Implicitselect a owl:Class .
hpc:Explicitselect a owl:Class .
hpc:Section a owl:Class .
hpc:Resourcerequirementspecification a owl:Class .
hpc:Resourcerequirementstring a owl:Class .
hpc:Selectsection a owl:Class .
hpc:Keyword a owl:Class .

# Object Properties
hpc:hasimplicitselect a owl:ObjectProperty .
hpc:hasexplicitselect a owl:ObjectProperty .
hpc:hasresourcerequirementspecification a owl:ObjectProperty .
hpc:hasresourcerequirementstring a owl:ObjectProperty .
hpc:hasselectsection a owl:ObjectProperty .
hpc:haskeyword a owl:ObjectProperty .

# Datatype Properties
hpc:format a owl:DatatypeProperty .

# Domain and Range
hpc:Resourcerequirement rdfs:domain hpc:Resourcerequirementspecification ;
    rdfs:range hpc:Resourcerequirementspecification .
hpc:Resourcerequirementspecification rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirementspecification .
hpc:Resourcerequirementstring rdfs:domain hpc:Resourcerequirementspecification ;
    rdfs:range hpc:Resourcerequirementstring .
hpc:Selectsection rdfs:domain hpc:Resourcerequirementstring ;
    rdfs:range hpc:Selectsection .
hpc:Keyword rdfs:domain hpc:Selectsection ;
    rdfs:range xsd:string .

# Subclass Relations
hpc:Explicitselect rdfs:subClassOf hpc:Selectsection .
hpc:Implicitselect rdfs:subClassOf hpc:Selectsection .

# Examples
hpc:Example1 a hpc:ResourceRequirementSpecification ;
    hpc:hasResourceRequirementString [
        hpc:format xsd:string ;
        hpc:hasImplicitSelect [
            hpc:format xsd:string ;
            hpc:hasKeyword [ rdf:value "(r15s * 2 + r15m) < 3.0" ] ;
            hpc:hasKeyword [ rdf:value "< 3.0" ] ;
            hpc:hasKeyword [ rdf:value "&&" ] ;
            hpc:hasKeyword [ rdf:value "!=" ] ;
            hpc:hasKeyword [ rdf:value "||" ] ;
            hpc:hasKeyword [ rdf:value "==" ] ;
            hpc:hasKeyword [ rdf:value "myjob" ]
        ] ;
        hpc:hasExplicitSelect [
