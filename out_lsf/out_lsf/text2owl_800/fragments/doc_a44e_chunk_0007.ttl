hpc:lsfDataPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

hpc:lsfDataSkipGroupCheck a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchddaemon ;
    rdfs:range xsd:string .

hpc:lsfStageInExec a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range hpc:Directdatastaging .

hpc:lsbStageOutExec a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range hpc:Directdatastaging .

hpc:lsbStageStorage a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:lsbStageTransferRate a owl:DatatypeProperty ;
    rdfs:domain hpc:Directdatastaging ;
    rdfs:range xsd:decimal .

hpc:lsbTimeDmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range xsd:positiveInteger .

hpc:LsbTimeDmd rdfs:subClassOf owl:Property ;
    rdfs:comment "Time usage is logged in milliseconds." .

hpc:lsfDataHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Dmddaemon ;
    rdfs:range rdf:List .
