hpc:LSFDataTransferJob
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an LSF data transfer job." .

hpc:hasTransferQueue
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The queue of the transfer job." .

hpc:transferJobEnvironment
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The environment for the transfer job." .

hpc:runsAsExecutionUser
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The execution user of the data job that triggered the transfer job." .

hpc:submissionHost
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The current mbatchd management host." .

hpc:currentWorkingDirectory
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The current working directory of the transfer job." .

hpc:cannotBeRequeued
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range xsd:integer ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The special exit code 100 if the transfer job cannot be requeued." .

hpc:transferJobExitCode100
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range xsd:integer ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The special exit code 100 if the command specified by the FILE_TRANSFER_CMD parameter does not exist or is not executable by the transfer job user." .

hpc:transferJobDefaultUserGroup
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The DEFAULT_USER_GROUP parameter applies to transfer jobs." .

hpc:transferJobDefaultProject
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The DEFAULT_PROJECT parameter applies to transfer jobs." .

hpc:transferJobDefaultJobCWDNotApplicable
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatatransferjob ;
    rdfs:range xsd:boolean ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Indicates that a current working directory specific to LSF data manager is required for transfer jobs." .
