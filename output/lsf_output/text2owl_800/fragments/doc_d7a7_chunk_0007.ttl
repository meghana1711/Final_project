hpc:Cluster a owl:Class .
hpc:Feature a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Parameter a owl:Class .
hpc:Lsflicensescheduler a owl:Class .

hpc:hascluster a owl:ObjectProperty .
hpc:hasservicedomain a owl:ObjectProperty .
hpc:hasparameter a owl:ObjectProperty .
hpc:supports a owl:ObjectProperty .

hpc:Cluster rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Servicedomain rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:Feature rdfs:subClassOf hpc:Lsflicensescheduler .

hpc:Cluster rdfs:domain hpc:Lsflicensescheduler .
hpc:Servicedomain rdfs:domain hpc:Lsflicensescheduler .
hpc:Feature rdfs:domain hpc:Lsflicensescheduler .

hpc:Hascluster rdfs:range hpc:Cluster .
hpc:Hasservicedomain rdfs:range hpc:Servicedomain .
hpc:Hasparameter rdfs:range hpc:Parameter .

hpc:ClusterMode rdfs:domain hpc:Parameter .
hpc:ClusterDistribution rdfs:domain hpc:Cluster .

hpc:ClusterMode rdfs:range xsd:string .
hpc:ClusterDistribution rdfs:range hpc:Lsserver .

hpc:CLUSTER_MODE rdfs:subPropertyOf hpc:supports .
hpc:CLUSTER_DISTRIBUTION rdfs:subPropertyOf hpc:hasCluster .
