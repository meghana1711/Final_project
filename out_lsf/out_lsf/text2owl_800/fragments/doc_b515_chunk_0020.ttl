hpc:Computeunit a owl:Class .
hpc:pref a owl:ObjectProperty .
hpc:Maxavail rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:integer .
hpc:Minavail rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:integer .
hpc:maxcus a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:usablecuslots a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:type a owl:ObjectProperty .
hpc:Type rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunittype .
hpc:excl a owl:ObjectProperty .
hpc:Excl rdfs:domain hpc:Computeunit .
hpc:ComputeUnitType rdf:type owl:Class .
hpc:Hasenclosure rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Enclosure .
hpc:Enclosure rdf:type owl:Class .
hpc:Hasmaxslots rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasnjobs rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasnjobsrunning rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasssusp rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasususp rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasrsvp rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasstatus rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:string .
hpc:Hasrack rdfs:domain hpc:Enclosure ;
    rdfs:range hpc:Rack .
hpc:Rack rdf:type owl:Class .
