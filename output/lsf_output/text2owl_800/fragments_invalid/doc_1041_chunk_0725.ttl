hpc:Job a owl:Class .
hpc:CommandLineBuffer an owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:StdoutBuffer an owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:StderrBuffer an owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:ExecutionHost an owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:HomeDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:TemporaryHomeDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:CurrentWorkingDirectoryOnSubmissionHost an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:CurrentWorkingDirectoryOnExecutionHost an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:DefaultWorkingDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:SearchForWorkingDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:StripTempMnt an owl:ObjectProperty ;
    rdfs:domain hpc:Searchforworkingdirectory .
hpc:CheckAutoMaster an owl:ObjectProperty ;
    rdfs:domain hpc:Searchforworkingdirectory .
hpc:ReplaceFirstComponentWithAutoMasterKey an owl:ObjectProperty ;
    rdfs:domain hpc:Checkautomaster .
hpc:ReplaceFirstTwoComponentsWithAutoMasterKey an owl:ObjectProperty ;
    rdfs:domain hpc:Checkautomaster .
hpc:StripFirstLevelPath an owl:ObjectProperty ;
    rdfs:domain hpcl:ReplaceFirstTwoComponentsWithAutoMasterKey .
hpc:LSBExitIfCWDNotExist an owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:ExitCode2 an owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:NoCommandSupplied an owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:PromptForCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Nocommandsupplied .
hpc:InputTermination an owl:ObjectProperty ;
    rdfs:domain hpc:Promptforcommand .
hpc:UnixInputTermination an owl:ObjectProperty ;
    rdfs:subClassOf hpc:Inputtermination ;
    rdfs:comment "Terminated by entering CTRL-D on a new line." .
