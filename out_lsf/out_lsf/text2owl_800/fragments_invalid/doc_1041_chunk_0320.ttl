hpc:Rss a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:vsz a owl:DatatypeProperty ;
    rdfs:domain hpc:Rss ;
    rdfs:range xsd:nonNegativeInteger .

hpc:swapusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Rss ;
    rdfs:range xsd:nonNegativeInteger .

hpc:nthread a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:pgid a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:pid a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xdfs:nonNegativeInteger .

