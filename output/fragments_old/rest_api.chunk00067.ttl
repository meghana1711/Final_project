hpc:Name a owl:Class .

hpc:UsageThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Name ;
    rdfs:range xsd:decimal .

hpc:UsageFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Name ;
    rdfs:range xsd:decimal .

hpc:Id a owl:DatatypeProperty ;
    rdfs:domain hpc:Name ;
    rdfs:range xsd:integer .

hpc:Priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Name ;
    rdfs:range xsd:decimal .

hpc:Limits a owl:Class ;
    rdfs:subClassOf hpc:Name .

hpc:Min a owl:Class ;
    rdfs:subClassOf hpc:Limits .

hpc:Max a owl:Class ;
    rdfs:subClassOf hpc:Limits .

hpc:PriorityThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Min ;
    rdfs:range xsd:decimal .

hpc:Tres a owl:Class ;
    rdfs:subClassOf hpc:Min ;
    rdfs:subClassOf hpc:Max .

hpc:Per a owl:ObjectProperty ;
    rdfs:domain hpc:Tres ;
    rdfs:range hpc:Job .

hpc:Job a owl:Class .

hpc:ActiveJobs a owl:Class ;
    rdfs:subClassOf hpc:Max .

hpc:Accruing a owl:Class ;
    rdfs:subClassOf hpc:Max .

hpc:Total a owl:Class ;
    rdfs:subClassOf hpc:Tres .

hpc:Minutes a owl:Class ;
    rdfs:subClassOf hpc:Total .

hpc:Qos a owl:Class ;
    rdfs:subClassOf hpc:Minutes .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Qos .

hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Qos .

hpc:Account a owl:Class ;
    rdfs:subClassOf hpc:Qos .

hpc:WallClock a owl:Class ;
    rdfs:subClassOf hpc:Max .

hpc:ActiveJobs a owl:Class ;
    rdfs:subClassOf hpc:WallClock .

hpc:Accruing a owl:Class ;
    rdfs:subClassOf hpc:WallClock .

hpc:Tres a owl:Class ;
    rdfs:subClassOf hpc:WallClock .
```
