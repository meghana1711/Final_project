# Command
hpc:Command a owl:Class .

# Salloc
hpc:Salloc a owl:Class .
hpc:Salloc waitsFor hpc:AllNodesReady .
hpc:Salloc hasOption hpc:WaitAllNodes .

# Sbatch
hpc:Sbatch a owl:Class .
hpc:Sbatch waitsFor hpc:AllNodesReady .
hpc:Sbatch hasOption hpc:WaitAllNodes .

# SlurmctldParameters
hpc:SlurmctldParameters a owl:Class .

# cloud_dns
hpc:cloud_dns a owl:ObjectProperty .

# idle_on_node_suspend
hpc:idle_on_node_suspend a owl:ObjectProperty .

# node_reg_mem_percent
hpc:node_reg_mem_percent a owl:DatatypeProperty .
hpc:node_reg_mem_percent rdfs:domain hpc:Node .
hpc:node_reg_mem_percent rdfs:range xsd:decimal .

# power_save_interval
hpc:power_save_interval a owl:DatatypeProperty .
hpc:power_save_interval rdfs:domain hpc:SlurmctldParameters .
hpc:power_save_interval rdfs:range xsd:decimal .

# power_save_min_interval
hpc:power_save_min_interval a owl:DatatypeProperty .
hpc:power_save_min_interval rdfs:domain hpc:SlurmctldParameters .
hpc:power_save_min_interval rdfs:range xsd:decimal .

# SuspendExcNodes
hpc:SuspendExcNodes a owl:ObjectProperty .

# SuspendExcParts
hpc:SuspendExcParts a owl:ObjectProperty .

# SuspendExcStates
hpc:SuspendExcStates a owl:ObjectProperty .
hpc:SuspendExcStates rdfs:range rdf:PlainLiteral .

# SuspendProgram
hpc:SuspendProgram a owl:ObjectProperty .

# SuspendRate
hpc:SuspendRate a owl:DatatypeProperty .
hpc:SuspendRate rdfs:domain hpc:SlurmctldParameters .
hpc:SuspendRate rdfs:range xsd:nonNegativeInteger .

# SuspendTime
hpc:SuspendTime a owl:DatatypeProperty .
hpc:SuspendTime rdfs:domain hpc:SlurmctldParameters .
hpc:SuspendTime rdfs:range xsd:nonNegativeInteger .

# SuspendTimeout
hpc:SuspendTimeout a owl:DatatypeProperty
