hpc:Preemptablejob a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:Highpriorityqueue a owl:Class .
hpc:Lowpriorityqueue a owl:Class .
hpc:memorypreemption a owl:ObjectProperty .
hpc:Hostmemory a owl:Class .
hpc:Numanodememory a owl:Class .
hpc:Preemptablenumanodememory a owl:Class .
hpc:Cpuaffinitybinding a owl:Class .
hpc:Linuxcgroupcpuset a owl:Class .
hpc:jobcpuaffinity a owl:ObjectProperty .
hpc:jobmemorybinding a owl:ObjectProperty .
hpc:Coreaffinity a owl:Class .
hpc:Localprefermemorybinding a owl:Class .
hpc:processcpuaffinity a owl:DatatypeProperty .
hpc:processmemoryaffinity a owl:DatatypeProperty .

hpc:Preemptablejob rdfs:subClassOf owl:Class .
hpc:Suspendedjob rdfs:subClassOf hpc:Preemptablejob .
hpc:Highpriorityqueue rdfs:subClassOf owl:Class .
hpc:Lowpriorityqueue rdfs:subClassOf owl:Class .
hpc:Memorypreemption rdfs:domain hpc:Preemptablejob ;
                             rdfs:range hpc:Suspendedjob .
hpc:Hostmemory rdfs:subClassOf owl:Class .
hpc:Numanodememory rdfs:subClassOf owl:Class .
hpc:Preemptablenumanodememory rdfs:subClassOf hpc:Numanodememory .
hpc:Cpuaffinitybinding rdfs:subClassOf owl:Class .
hpc:Linuxcgroupcpuset rdfs:subClassOf hpc:Cpuaffinitybinding .
hpc:Jobcpuaffinity rdfs:domain hpc:Cpuaffinitybinding ;
                         rdfs:range hpc:Job .
hpc:Jobmemorybinding rdfs:domain hpc:Cpuaffinitybinding ;
                         rdfs:range xsd:string .
hpc:Coreaffinity rdfs:subClassOf hpc:Cpuaffinitybinding .
hpc:Localprefermemorybinding rdfs:subClassOf hpc:Jobmemorybinding .
hpc:Processcpuaffinity rdfs:domain hpc:Job ;
                          rdfs:range xsd:integer .
hpc:Processmemoryaffinity rdfs:domain hpc:Job ;
                          rdfs:range xsd:integer .
