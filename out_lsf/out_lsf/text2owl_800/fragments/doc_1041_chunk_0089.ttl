hpc:Logfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a log file for timing messages." .

hpc:haslogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Logfile ;
    rdfs:comment "Relates a daemon to the log file where its timing messages are stored." .

hpc:logfileformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the format of the log file." .

hpc:logfilecreationrule a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Describes the rule for creating the log file." .

hpc:logfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the location of the log file." .

hpc:logfileonunix a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the location of the log file on UNIX and Linux systems when the specified path is invalid." .

hpc:logfileonwindows a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the action taken when the specified path is invalid on Windows." .

hpc:logfilesshared a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range rdf:List ;
    rdfs:comment "Relates a daemon to the list of log files where its timing and debug messages are stored." .

hpc:resettimingsettings a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Timingsettings ;
    rdfs:comment "Resets the timing settings of a daemon to the default state." .

hpc:settiminglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the timing level on the specified host or hosts." .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a host in the system." .

hpc:Daemon a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a daemon in the system." .
