hpc:Genericresource a owl:Class .
hpc:hasgres a owl:ObjectProperty .
hpc:Gresstring rdfs:domain hpc:Genericresource ;
    rdfs:range xsd:string .
hpc:Greslist rdfs:domain hpc:Genericresource ;
    rdfs:range rdf:List .
hpc:Greslistelement a owl:Class ;
    rdfs:subClassOf hpc:Genericresource ;
    rdfs:subClassOf rdf:List .
hpc:greslistelementid a owl:DatatypeProperty ;
    rdfs:domain hpc:Greslistelement ;
    rdfs:range xsd:integer .
hpc:greslistelementresource a owl:ObjectProperty ;
    rdfs:domain hpc:Greslistelement .

hpc:Gresnode a owl:Class ;
    rdfs:subClassOf hpc:Genericresource .
hpc:Gresnodestate a owl:Class .
hpc:Gresjob a owl:Class ;
    rdfs:subClassOf hpc:Genericresource .
hpc:Gresjobstate a owl:Class .
hpc:Gresjobstep a owl:Class ;
    rdfs:subClassOf hpc:Genericresource .
hpc:Gresjobstepstate a owl:Class .
