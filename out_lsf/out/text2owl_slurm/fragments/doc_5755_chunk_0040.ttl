hpc:Slurmnode a owl:Class .
hpc:Slurmpartition a owl:Class .
hpc:Slurmdaemon a owl:Class .
hpc:Slurmctld a hpc:SlurmDaemon .
hpc:Slurmd a hpc:SlurmDaemon .
hpc:Slurmstepd a hpc:SlurmDaemon .
hpc:healthcheckprogram a owl:ObjectProperty .
hpc:SlurmdTimeout a xsd:nonNegativeInteger .
hpc:State a owl:Class .
hpc:Drain a hpc:State .
hpc:reason a owl:DatatypeProperty .
hpc:NodeName a xsd:string .
hpc:Slurmupdate a owl:Class .
hpc:nodehealthcheck a owl:ObjectProperty .
hpc:MemoryExhaustion a xsd:boolean .

hpc:Slurmnode rdfs:subClassOf owl:Class .
hpc:Slurmpartition rdfs:subClassOf owl:Class .
hpc:Slurmdaemon rdfs:subClassOf owl:Class .
hpc:Slurmctld rdfs:subClassOf hpc:Slurmdaemon .
hpc:Slurmd rdfs:subClassOf hpc:Slurmdaemon .
hpc:Slurmstepd rdfs:subClassOf hpc:Slurmdaemon .
hpc:Healthcheckprogram rdfs:domain hpc:Slurmnode ;
                          rdfs:range rdf:Resource .
hpc:Slurmdtimeout rdfs:domain hpc:Slurmpartition ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:State rdfs:subClassOf owl:Class .
hpc:Drain rdfs:subClassOf hpc:State .
hpc:Reason rdfs:domain hpc:Drain ;
               rdfs:range xsd:string .
hpc:Nodename rdfs:domain hpc:Reason ;
              rdfs:range xsd:string .
hpc:Slurmupdate rdfs:subClassOf owl:Class .
hpc:Nodehealthcheck rdfs:domain hpc:Slurmnode ;
                     rdfs:range rdf:Resource .
hpc:Memoryexhaustion rdfs:domain hpc:Slurmd .
