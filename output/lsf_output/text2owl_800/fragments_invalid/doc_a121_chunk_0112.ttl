hpc:Job a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Lsfsystem a owl:Class .

hpc:hasExecutionHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executionhost .

hpc:isUnavailable rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:boolean .

hpc:fails rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsystem ;
    rdfs:range xsd:boolean .

hpc:hasJobID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:isRequeueable rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:isRequeueableByQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:isRequeueableByUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .

hpc:isRequeueableByLSFAdmin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range hpc:Job .

hpc:causesRequeue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Condition ;
    rdfs:range hpc:Job .

hpc:Condition a owl:Class .
hpc:ExecutionHostFailure a hpc:Condition ;
hpc:SystemFailure a hpc:Condition .

hpc:isResizable rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:isReexecutedOnAnotherHost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Queue a owl:Class .
hpc:Jobsubmission a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmission .

hpc:enablesAutomaticJobRerun rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobsubmission .

hpc:disablesAutomaticJobRerun rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:disablesPostExecutionForReRunnableJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:User a owl:Class .
hpc:Lsfadmin a owl:Class .
