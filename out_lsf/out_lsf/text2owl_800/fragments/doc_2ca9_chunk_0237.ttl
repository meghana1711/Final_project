hpc:Fixpack14 a owl:Class .
hpc:Lsf a owl:Class .
hpc:Automatictimebasedconfiguration a owl:Class .
hpc:Timezone a owl:Class .
hpc:Standardtimezoneabbreviation a owl:Class .
hpc:Localsystemtimezone a owl:Class .
hpc:Files a owl:Class .
hpc:Lsbapplications a owl:Class .
hpc:Lsbhosts a owl:Class .
hpc:Lsbparams a owl:Class .
hpc:Lsbqueues a owl:Class .
hpc:Lsbresources a owl:Class .
hpc:enablecpuacounting a owl:ObjectProperty .
hpc:Enablecpuacounting rdfs:domain hpc:Lsf ;
                          rdfs:range hpc:Boolean .
hpc:enablegpusupport a owl:ObjectProperty .
hpc:Enablegpusupport rdfs:domain hpc:Lsf ;
                          rdfs:range hpc:Boolean .
hpc:eligiblependingtimelimit a owl:DatatypeProperty .
hpc:Eligiblependingtimelimit rdfs:domain hpc:Lsbapplications ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:pendingtimelimit a owl:DatatypeProperty .
hpc:Pendingtimelimit rdfs:domain hpc:Lsbapplications ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:Container a owl:Class .
hpc:Docker a owl:Class .
hpc:Shifter a owl:Class .
hpc:Singularity a owl:Class .
hpc:Preexecutionscript a owl:Class .
hpc:Containerjob a owl:Class .
hpc:Containerjob rdfs:subClassOf hpc:Job .
hpc:containerstartupoptions a owl:DatatypeProperty .
hpc:Containerstartupoptions rdfs:domain hpc:Preexecutionscript ;
                                   rdfs:range xsd:string .
