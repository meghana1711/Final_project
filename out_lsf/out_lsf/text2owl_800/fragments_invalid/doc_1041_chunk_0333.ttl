hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in the LSF system." .

hpc:bkillcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Bkillcommandexecution ;
    rdfs:comment "The act of executing the bkill command on a job." .

hpc:Bkillcommandexecution a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the execution of the bkill command on a job." .

hpc:Privilegeduser a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a user with privileges to execute the bkill -r command." .

hpc:Rootuser a owl:Class ;
    rdfs:subClassOf hpc:Privilegeduser ;
    rdfs:comment "Represents the root user." .

hpc:Lsfadministrator a owl:Class ;
    rdfs:subClassOf hpc:Privilegeduser ;
    rdfs:comment "Represents an LSF administrator." .

hpc:Unknwnstate a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in UNKNWN state." .

hpc:Zombiestate a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in ZOMBI state." .

hpc:Exitstate a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in EXIT state." .

hpc:Jobresource a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the resources monitored by LSF for a job." .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents an application profile associated with a job." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The ID of the job." .

hpc:killreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Bkillcommandexecution ;
    rdfs:range xsd:string ;
    rdfs:comment "The reason for killing the job." .

hpc:maxkillreasonlength a owl:DatatypeProperty ;
    rdfs:domain hpc:Killreason ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the kill reason." .

hpc:Parameterfile a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the lsb.params file." .

hpc:privilegeduserforcebkill a owl:DatatypeProperty
