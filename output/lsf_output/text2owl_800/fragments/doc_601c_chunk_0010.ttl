hpc:Httpsproxyserver a owl:Class .
hpc:logontohttpsproxy a owl:ObjectProperty .
hpc:Username rdfs:domain hpc:Logontohttpsproxy ;
    rdfs:range xsd:string .
hpc:Password rdfs:domain hpc:Logontohttpsproxy ;
    rdfs:range xsd:string .
hpc:Url rdfs:domain hpc:Logontohttpsproxy ;
    rdfs:range xsd:string .
hpc:Port rdfs:domain hpc:Logontohttpsproxy ;
    rdfs:range xsd:integer .
hpc:Apachehttpserver a owl:Class .
hpc:Apachehttpserverconfigurationfile rdfs:domain hpc:Apachehttpserver ;
    rdfs:range xsd:string .
hpc:Listeningport rdfs:domain hpc:Apachehttpserverconfigurationfile ;
    rdfs:range xsd:integer .
hpc:sslproxycheckpeername a owl:DatatypeProperty .
hpc:Sslproxycheckpeername rdfs:domain hpc:Apachehttpserverconfigurationfile ;
    rdfs:range xsd:boolean .
hpc:ipaddresslogin a owl:ObjectProperty .
hpc:Ipaddresslogin rdfs:subClassOf hpc:Logontohttpsproxy .
