hpc:LsfCommunicationTimeout a owl:Class .
hpc:hasrecvtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfCommunicationTimeout ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LsfLicenseScheduler a owl:Class .

hpc:FlexnetLicenseScheduler a owl:Class ;
    rdfs:subClassOf hpc:LsfLicenseScheduler .

hpc:handleRemoval a owl:ObjectProperty ;
    rdfs:domain hpc:FlexnetLicenseScheduler ;
    rdfs:range xsd:boolean .

hpc:displayInformation a owl:DatatypeProperty ;
    rdfs:domain hpc:FlexnetLicenseScheduler .

hpc:lmRemoveByHandle a owl:DatatypeProperty ;
    rdfs:domain hpc:FlexnetLicenseScheduler .

hpc:preemptionAction a owl:ObjectProperty ;
    rdfs:domain hpc:FlexnetLicenseScheduler .

hpc:lmRemoveInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLicenseScheduler .

hpc:preemptionInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLicenseScheduler ;
    rdfs:range xsd:nonNegativeInteger .

hpc:jobPreemption a owl:ObjectProperty ;
    rdfs:domain hpc:LsfLicenseScheduler .

hpc:lmRemoveSuspJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLicenseScheduler .
