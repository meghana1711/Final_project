hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:Executiondomain a owl:Class .
hpc:runson a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:runsas a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:hasexecutiondomain a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executiondomain .
hpc:lsfUserDomain a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:lsfExecuteDomain a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:SALES a hpc:ExecutionDomain .
hpc:ENGINEERING a hpc:ExecutionDomain .
hpc:BUSINESS a hpc:ExecutionDomain .
hpc:UNIX a hpc:Host .
hpc:Windows a hpc:Host .
hpc:user1 a hpc:User .
hpc:SUPPORT a hpc:User .
hpc:ENGINEERING a hpc:User .

hpc:User_runs_on rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Host .
hpc:User_runs_as rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User .
hpc:Job_runs_on rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Job_runs_as rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:Job_has_execution_domain rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executiondomain .
hpc:Host_contains_user rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:User .
hpc:Host_is_in_LSF_USER_DOMAIN rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Executiondomain .
hpc:User_has_LSF_EXECUTE_DOMAIN rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

hpc:Job_submitted_by rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:Job_monitored_by rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job
