hpc:LoginNode a owl:Class .
hpc:RestdNode a owl:Class .
hpc:HighAvailabilityNode a owl:Class .

# Object Properties
hpc:hasSlurmConfFile owl:ObjectProperty .
hpc:hasAuthMethod owl:ObjectProperty .
hpc:hasSlurmDaemons owl:ObjectProperty .
hpc:hasRestdDaemon owl:ObjectProperty .
hpc:hasBackupHosts owl:ObjectProperty .
hpc:hasStateSaveLocation owl:ObjectProperty .
hpc:hasSlurmctldHost rdfs:domain hpc:HighAvailabilityNode ;
    rdfs:range rdf:Resource .

# Datatype Properties
hpc:isConfiguredForRestdMode xsd:boolean .
hpc:isRunningAsUnixService xsd:boolean .
hpc:isRunningAsInetService xsd:boolean .
hpc:hasSlurmctldPrimaryOnProg xsd:string .
hpc:hasSlurmctldPrimaryOffProg xsd:string .
hpc:hasSaveMaxWait xsd:integer .

# Classes for Slurm Components
hpc:Slurmctld a owl:Class .
hpc:Slurmdbd a owl:Class .

# Object Properties for Slurm Components
hpc:hasSlurmctldHost rdfs:subPropertyOf hpc:hasBackupHosts ;
    rdfs:domain hpc:Slurmctld .
hpc:hasAccountingStorageBackupHost rdfs:subPropertyOf hpc:hasBackupHosts ;
    rdfs:domain hpc:Slurmdbd .

# Class for Authentication
hpc:Authentication a owl:Class .
hpc:Munge a owl:Class ;
    rdfs:subClassOf hpc:Authentication .
hpc:SlurmAuth a owl:Class ;
    rdfs:subClassOf hpc:Authentication .

# Object Properties for Authentication
hpc:requiresMungeKeyFile owl:ObjectProperty .
hpc:requiresJwtPackage owl:ObjectProperty .
hpc:requiresNTP rdfs:domain hpc:Authentication .

# Class for Scheduler
hpc:Scheduler a owl:Class .

# Object Properties for Scheduler
hpc:hasPriorityType owl:ObjectProperty .
hpc:hasSchedType owl:ObjectProperty .
hpc:hasSelectType owl:ObjectProperty .

# Class for Resource Selection
hpc:ResourceSelection a owl:Class .
hpc:ConsTrackableResources a owl:Class ;
    rdfs:subClassOf hpc:ResourceSelection .

# Class for Logging
hpc:Logging a owl:Class .

# Class for Accounting
hpc:Accounting a owl:Class .

# Class for Compute Node Access
hpc:ComputeNodeAccess a owl:Class .
hpc:PAM a owl:Class ;
    rdfs:subClassOf hpc:ComputeNodeAccess .

# Object Properties for Compute Node Access
hpc:hasEpilogScript owl:ObjectProperty .
hpc:hasPAMModule rdfs:domain hpc:ComputeNodeAccess .

# Class for Configuration
hpc:Configuration a owl:Class .
hpc:
