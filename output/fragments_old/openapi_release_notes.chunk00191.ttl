hpc:Job a owl:Class .
hpc:JobPostResponse a owl:Class .
hpc:JobDeleteResponse a owl:Class .

# Job ID property
hpc:jobId a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

# Job response properties
hpc:responseContent a owl:ObjectProperty ;
    rdfs:domain hpc:JobPostResponse, hpc:JobDeleteResponse ;
    rdfs:range xsd:anyURI .

hpc:responseSchema a owl:ObjectProperty ;
    rdfs:domain hpc:JobPostResponse, hpc:JobDeleteResponse ;
    rdfs:range xsd:anyURI .

# Job Post Response schema reference
hpc:v0_0_40_openapi_job_post_response a owl:Class ;
    rdf:type owl:NamedIndividual ;
    hpc:responseSchema rdf:value http://example.org/hpc#v0.0.40_openapi_job_post_response .

# Job Delete Response schema reference
hpc:v0_0_40_openapi_resp a owl:Class ;
    rdf:type owl:NamedIndividual ;
    hpc:responseSchema rdf:value http://example.org/hpc#v0.0.40_openapi_resp .

# Job YAML content
hpc:applicationYAML a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPostResponse, hpc:JobDeleteResponse ;
    rdfs:range xsd:anyURI .
```
