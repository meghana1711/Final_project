@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that can have pending allocation requests." .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Runningjob ;
    rdfs:comment "A job that is currently executing." .

hpc:Pendingallocationrequest a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequest ;
    rdfs:comment "An extra resource request attached to a resizable job." .

hpc:Resourcerequest a owl:Class ;
    rdfs
