hpc:JobDescriptionMsg a owl:Class .
hpc:rlimits a owl:Class .
hpc:fsize rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:integer .
hpc:memlock rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:integer .
hpc:as rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:integer .
hpc:begin_time rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:dateTime .
hpc:time_limit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:duration .
hpc:required_switches rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range rdf:List .
hpc:memory_per_node rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescriptionMsg ;
    rdfs:range xsd:integer .
hpc:ExtSensorData a owl:Class .
hpc:consumed_energy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ExtSensorData ;
    rdfs:range xsd:float .
hpc:temperature rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ExtSensorData ;
    rdfs:range xsd:float .
hpc:StatsMsg a owl:Class .
hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:StatsMsg ;
    rdfs:range xsd:integer .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:StatsMsg ;
    rdfs:range xsd:string .
hpc:JobResNodes a owl:Class .
hpc:JobResNodes rdf:type owl:Class ;
    rdfs:subClassOf hpc:StatsMsg .
hpc:openapi_licenses_resp a owl:Class .
hpc:last_update rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:openapi_licenses_resp ;
    rdfs:range xsd:dateTime .
hpc:StatsMsg_rpcs_by_user a owl:Class .
hpc:job_states_ts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StatsMsg_rpcs_by_user ;
    rdfs:range xsd:dateTime .
hpc:req_time_start rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StatsMsg_rpcs_by_user ;
    rdfs:range xsd:dateTime .
hpc:req_time rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StatsMsg_rpcs_by_user ;
    rdfs:range xsd:duration .
