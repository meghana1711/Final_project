hpc:Preemptablejob a owl:Class .
hpc:Resizablejob a owl:Class .
hpc:Ssuspstate a owl:Class .
hpc:Pendingallocationrequest a owl:Class .
hpc:preemptionpolicy a owl:ObjectProperty .
hpc:jobcounters a owl:DatatypeProperty .
hpc:resourceallocation a owl:ObjectProperty .
hpc:resizerequest a owl:DatatypeProperty .
hpc:preemptableslots a owl:DatatypeProperty .
hpc:Exclusivejob a owl:Class .
hpc:Backfilljob a owl:Class .
hpc:Brunjob a owl:Class .

hpc:Preemptablejob rdfs:subClassOf hpc:Job .
hpc:Resizablejob rdfs:subClassOf hpc:Preemptablejob .
hpc:Ssuspstate rdfs:subClassOf hpc:Jobstate .
hpc:Pendingallocationrequest rdfs:subClassOf hpc:Resourcerequest .

hpc:Preemptionpolicy rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Preemptionpolicyvalue .

hpc:Jobcounters rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Resourceallocation rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Resourceallocationvalue .

hpc:Resizerequest rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Preemptableslots rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Exclusivejob rdfs:subClassOf hpc:Preemptablejob .
hpc:Exclusivejob rdfs:subClassOf hpc:Jobwithexclusiveresources .

hpc:Backfilljob rdfs:subClassOf hpc:Preemptablejob .

hpc:Brunjob rdfs:subClassOf hpc:Preemptablejob .

hpc:Jobwithexclusiveresources rdfs:subClassOf hpc:Job .
