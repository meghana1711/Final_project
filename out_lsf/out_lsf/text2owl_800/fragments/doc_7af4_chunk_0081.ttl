hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:jobpreproctimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specify a timeout in minutes for job pre-execution processing." .

hpc:jobpostproctimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Define the timeout for host-based post execution processing." .

hpc:hasjobpreproctimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobpreproctimeout ;
    rdfs:comment "The timeout for job pre-execution processing, if set." .

hpc:hasjobpostproctimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobpostproctimeout ;
    rdfs:comment "The timeout for host-based post execution processing, if set." .

hpc:JobPreprocTimeoutDefault a xsd:anyURI ;
    rdfs:comment "The default value for JobPreprocTimeout when not defined." .

hpc:JobPreprocTimeoutSyntax a xsd:string ;
    rdfs:comment "The syntax for defining JobPreprocTimeout." .

hpc:JobPreprocTimeoutDescription a xsd:string ;
    rdfs:comment "A description of what JobPreprocTimeout does." .

hpc:JobPreprocTimeoutOverrides a xsd:string ;
    rdfs:comment "A statement about JobPreprocTimeout being overridden in an application profile." .

hpc:JobPreprocTimeoutInUserEnvironment a xsd:string ;
    rdfs:comment "A statement about JobPreprocTimeout not being defined in the user environment." .

hpc:JobPreprocTimeoutInApplications a xsd:string ;
    rdfs:comment "A statement about JobPreprocTimeout being defined in an application profile." .

hpc:JobPreprocRetryThreshold a xsd:nonNegativeInteger ;
    rdfs:comment "The number of pre-execution retries before a job is suspended instead of requeued." .

hpc:JobPreprocKillMethodOnUnix a xsd:string ;
    rdfs:comment "The method used to kill the entire process group of the job's pre-execution processes on UNIX and Linux." .

hpc:JobPreprocKillMethodOnWindows a xsd:string ;
    rdfs:comment "The method used to kill the parent process of the pre-execution command on Windows." .
