hpc:Datamanager a owl:Class .
hpc:Datafile a owl:Class .
hpc:Datatag a owl:Class .
hpc:Filegroup a owl:Class .
hpc:changeGroupAccess an owl:ObjectProperty .
hpc:hasfile a owl:ObjectProperty .
hpc:hastag a owl:ObjectProperty .
hpc:Hasgroup rdfs:domain hpc:Filegroup ;
    rdfs:range xsd:string .
hpc:Hasuser rdfs:domain hpc:Filegroup ;
    rdfs:range xsd:string .
hpc:Haspermission rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .
hpc:issharedby a owl:ObjectProperty .
hpc:istaggedby a owl:ObjectProperty .
hpc:Requiresaccesscontrol rdfs:subClassOf hpc:Datamanager .
hpc:Requiresconfigparam rdfs:subClassOf hpc:Datamanager .
hpc:Requireschgrpcommand rdfs:subClassOf hpc:Datamanager .
hpc:Requiresdatajob rdfs:subClassOf hpc:Datafile .
hpc:Requirestag rdfs:subClassOf hpc:Datatag .
hpc:Requirestagusage rdfs:subClassOf hpc:Datatag .

hpc:CACHE_ACCESS_CONTROL rdf:datatype xsd:boolean .
hpc:bdatachgrp a owl:ObjectProperty .
hpc:bsubdata a owl:ObjectProperty .

hpc:Datamanager a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:requiresConfigParam ;
                        owl:hasValue "Y" ] .
hpc:Datafile rdfs:subClassOf [ a owl:Restriction ;
                                 owl:onProperty hpc:requiresAccessControl ;
                                 owl:hasValue true ] .
hpc:Filegroup rdfs:subClassOf [ a owl:Restriction ;
                                   owl:onProperty hpc:hasGroup ;
                                   owl:hasValue "" ] .
hpc:changeGroupAccess
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datafile .
hpc:hasFile
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datafile .
hpc:hasTag
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datatag .
hpc:Hasgroup rdfs:domain hpc:Filegroup ;
    rdfs:range xsd:string .
hpc:Hasuser rdfs:domain hpc:Filegroup ;
    rdfs:range xsd:string .
hpc:Haspermission rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .
hpc:isSharedBy
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Filegroup .
hpc:isTaggedBy
    rdfs:domain hpc:Datatag ;
    rdfs:range hpc:Datafile .
