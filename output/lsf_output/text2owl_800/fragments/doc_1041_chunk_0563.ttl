hpc:Tag
    a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdf:first hpc:hasTagName ;
                        owl:onProperty hpc:tagName ] .

hpc:tagName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .

hpc:ValidTagName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Tagname ;
    rdfs:range xsd:string ;
    rdfs:range [ a xsd:string ;
                 xsd:pattern "^(?!.*[../|./|~/]).*$" ] .

hpc:copyFilesInto
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Tag ;
    rdfs:subPropertyOf hpc:hasPermission .

hpc:hasTagFolder
    a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hpc:Folder ;
    rdfs:subPropertyOf hpc:hasLocation .

hpc:User
    a owl:Class .

hpc:Folder
    a owl:Class .

hpc:hasLocation
    a owl:ObjectProperty .

hpc:CACHE_ACCESS_CONTROL
    a xsd:boolean .

hpc:bdataTagsClean
    a owl:ObjectProperty .

hpc:bdataChgrp
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Tag ;
    rdfs:subPropertyOf hpc:hasPermission ;
    rdfs:domain [ a owl:Restriction ;
                    rdf:first hpc:hasGroup ;
                    owl:onProperty hpc:associatedGroup ] .

hpc:hasGroup
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .

hpc:associatedGroup
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
