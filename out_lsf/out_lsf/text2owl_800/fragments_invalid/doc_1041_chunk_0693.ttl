hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Represents a job with specified resource requirements." .

hpc:resourcerequirementstring a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource requirement string for job submission." .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Represents a task within a job." .

hpc:Hosttype a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Represents a type of host." .

hpc:SolarisHostType a hpc:HostType ;
    rdfs:comment "Represents a Solaris host type." .

hpc:Linux86HostType a hpc:HostType ;
    rdfs:comment "Represents a Linux86 host type." .

hpc:taskcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of tasks for a specific host type." .

hpc:hosttyperequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Hosttype ;
    rdfs:comment "The host type requirement for a job." .

hpc:taskcountconflict a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates a job submission is rejected due to conflicting task counts." .

hpc:Jobsubmissionrejected a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job submission that was rejected due to conflicting task counts." .

hpc:noption a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The value of the -n option provided at the job level." .

hpc:consistentwith a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates whether the values specified with the -n option are consistent with the values implied by the resource requirement string." .

hpc:Gpuresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Represents GPU resource requirements for a job." .

hpc:ngpusphysical a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of physical GPUs requested." .

hpc:gmodel a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd
