hpc:Pammodule a owl:Class .
hpc:Accountstackingstrategy a owl:Class .
hpc:PAM_Localuser a hpc:PAMModule ;
    rdfs:subClassOf hpc:Pammodule ;
    rdfs:domain hpc:Accountstackingstrategy .
hpc:PAM_Systemd a hpc:PAMModule ;
    rdfs:subClassOf hpc:Pammodule ;
    rdfs:domain hpc:Accountstackingstrategy .
hpc:AdministrativeAccess a hpc:AccountStackingStrategy .
hpc:RootUserAccess a hpc:AdministrativeAccess .
hpc:SlurmConfigCheck a hpc:AdministrativeAccess .
hpc:AdminUser a hpc:AdministrativeAccess ;
    rdfs:subClassOf hpc:Administrativeaccess .
hpc:PAM_Access a hpc:PAMModule ;
    rdfs:subClassOf hpc:Pammodule .
hpc:PAM_Listfile a hpc:PAMModule .
hpc:AllowsLogin a hpc:PAMModule .
hpc:pamStackorder a owl:ObjectProperty .
hpc:PamStackorder rdfs:domain hpc:Administrativeaccess ;
    rdfs:range hpc:Pammodule .
hpc:Admingroup a owl:Class .
hpc:WheelGroup a hpc:AdminGroup .
hpc:UserInFile a hpc:AdminGroup .
hpc:accessdeniedmessage a owl:DatatypeProperty .
hpc:Accessdeniedmessage rdfs:domain hpc:Pammodule ;
    rdfs:range xsd:string .
hpc:SessionAdoption a hpc:PAMModule .
hpc:sessionadoptionrequiresjob a owl:ObjectProperty .
hpc:Sessionadoptionrequiresjob rdfs:domain hpc:Pammodule ;
    rdfs:range xsd:boolean .
hpc:AdminUserAccount a hpc:User ;
    rdfs:subClassOf hpc:User ;
    rdfs:subClassOf hpc:Admingroup .
