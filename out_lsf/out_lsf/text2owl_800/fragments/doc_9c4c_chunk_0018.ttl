hpc:Lsfserverhost a owl:Class .
hpc:hostsetup a owl:ObjectProperty .
hpc:Top rdfs:domain hpc:Hostsetup ;
    rdfs:range xsd:string .
hpc:Boot rdfs:domain hpc:Hostsetup ;
    rdfs:range xsd:boolean .
hpc:LsfCluster rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string .
hpc:Lsfuser a owl:Class .
hpc:LsfConfdir rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:Singleusercluster rdfs:subClassOf hpc:Lsfuser .
hpc:Multiusercluster rdfs:subClassOf hpc:Lsfuser .
hpc:Fileownership rdfs:domain hpc:Singleusercluster, hpc:Multiusercluster ;
    rdfs:range xsd:string .
hpc:Permissions rdfs:domain hpc:Singleusercluster, hpc:Multiusercluster ;
    rdfs:range xsd:string .
hpc:Nonrootstart rdfs:subClassOf hpc:Lsfuser .
hpc:LsfDaemonsstartatboot rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:boolean .
hpc:LsfCommands rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string .
hpc:Userlsfconfig rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
