hpc:Globalfairsharescheduling a owl:Class .
hpc:Globalpolicydaemon a owl:Class .
hpc:Globalpolicy a owl:Class .
hpc:Globalpolicydaemoncluster a owl:Class .
hpc:Globalfairshareparticipatingcluster a owl:Class .
hpc:Globalfairshareparticipatingqueue a owl:Class .
hpc:Fairsharetree a owl:Class .
hpc:Shareaccount a owl:Class .
hpc:Globalshareaccount a owl:Class .

hpc:hasglobalfairsharescheduling a owl:ObjectProperty .
hpc:Runsglobalpolicydaemon rdfs:domain hpc:Globalpolicydaemoncluster ;
                            rdfs:range hpc:Globalpolicydaemon .
hpc:Participatesinglobalfairshare rdfs:domain hpc:Globalpolicydaemoncluster ;
                                     rdfs:range hpc:Globalfairsharepolicy .
hpc:Hasglobalpolicydaemon rdfs:domain hpc:Globalpolicydaemoncluster ;
                           rdfs:range hpc:Globalpolicydaemon .
hpc:Hasglobalpolicy rdfs:domain hpc:Globalpolicydaemoncluster ;
                     rdfs:range hpc:Globalpolicy .
hpc:Hasglobalfairshareparticipatingcluster rdfs:domain hpc:Globalpolicy ;
                                               rdfs:range hpc:Globalfairshareparticipatingcluster .
hpc:Hasglobalfairshareparticipatingqueue rdfs:domain hpc:Globalfairshareparticipatingcluster ;
                                                   rdfs:range hpc:Globalfairshareparticipatingqueue .
hpc:Hasfairsharetree rdfs:domain hpc:Globalfairshareparticipatingqueue ;
                      rdfs:range hpc:Fairsharetree .
hpc:Hasshareaccount rdfs:domain hpc:Fairsharetree ;
                     rdfs:range hpc:Shareaccount .
hpc:Participatesinglobalshareaccount rdfs:domain hpc:Shareaccount ;
                                          rdfs:range hpc:Globalshareaccount .
