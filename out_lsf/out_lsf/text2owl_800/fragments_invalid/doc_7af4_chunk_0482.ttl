hpc:Job a owl:Class .
hpc:FinishedJob a hpc:Job .
hpc:PendingJob a hpc:Job .
hpc:Resourceallocation a owl:Class .
hpc:userconstraint a owl:ObjectProperty .
hpc:groupconstraint a owl:ObjectProperty .
hpc:projectconstraint a owl:ObjectProperty .
hpc:shareconstraint a owl:ObjectProperty .
hpc:Userconstraint rdfs:domain hpc:Finishedjob ;
    rdfs:range hpc:Pendingjob .
hpc:Groupconstraint rdfs:domain hpc:Finishedjob ;
    rdfs:range hpc:Pendingjob .
hpc:Projectconstraint rdfs:domain hpc:Finishedjob ;
    rdfs:range hpc:Pendingjob .
hpc:Shareconstraint rdfs:domain hpc:Finishedjob ;
    rdfs:range hpc:Pendingjob .
hpc:UserConstraint rdfs:subPropertyOf hpc:ShareConstraint ;
    rdfs:subClassOf hpc:User .
hpc:GroupConstraint rdfs:subPropertyOf hpc:ShareConstraint ;
    rdfs:subClassOf hpc:Group .
hpc:ProjectConstraint rdfs:subPropertyOf hpc:ShareConstraint ;
    rdfs:subClassOf hpc:Project .
hpc:User rdfs:subClassOf hpc:Pendingjob .
hpc:Group rdfs:subClassOf hpc:Pendingjob .
hpc:Project rdfs:subClassOf hpc:Pendingjob .
hpc:UserConstraint rdfs:label "user"@en ;
    hpc:GroupConstraint rdfs:label "group"@en ;
    hpc:ProjectConstraint rdfs:label "project"@en .
