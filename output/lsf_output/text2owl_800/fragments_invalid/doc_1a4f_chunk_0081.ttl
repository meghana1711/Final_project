hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:Jobstate a owl:Class .
hpc:closeQueue an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Queue .
hpc:switchJobs an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Queue, hpc:Queue .
hpc:Lostandfoundqueue rdfs:subClassOf hpc:Queue .
hpc:Pendingjob rdfs:subClassOf hpc:Job .
hpc:Runningjob rdfs:subClassOf hpc:Job .
hpc:Jobid rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Queuename rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:State rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstate .
hpc:Fromhost rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
