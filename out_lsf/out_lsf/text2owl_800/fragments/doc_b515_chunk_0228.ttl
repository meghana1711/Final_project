hpc:Resizablejob a owl:Class .
hpc:Applicationprofile a owl:Class .
hpc:resizenotificationcommand a owl:DatatypeProperty .
hpc:joblevelresizenotificationcommand a owl:ObjectProperty .
hpc:Automaticallyresizablejob a owl:Class .
hpc:bsubcommand a owl:ObjectProperty .

hpc:Resizablejob rdfs:subClassOf hpc:Job .
hpc:Automaticallyresizablejob rdfs:subClassOf hpc:Resizablejob .

hpc:Applicationprofile rdfs:domain hpc:Resizablejob .
hpc:Joblevelresizenotificationcommand rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .
hpc:Bsubcommand rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .
