hpc:Highthroughputcluster a owl:Class ;
    rdfs:comment "Template for clusters that mainly run short jobs." .

hpc:Longrunningcluster a owl:Class ;
    rdfs:comment "Configuration for long running parallel jobs." .

hpc:IsResponsive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Highthroughputcluster ;
    rdfs:range xsd:boolean .

hpc:TurnoverRate rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Highthroughputcluster ;
    rdfs:range xsd:decimal .

hpc:RequiresResources rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Longrunningcluster ;
    rdfs:range xsd:boolean .

hpc:Lsfexpressedition a owl:Class ;
    rdfs:subClassOf hpc:Edition .

hpc:Advancededition a owl:Class ;
    rdfs:subClassOf hpc:Edition .

hpc:Spectrumlsfanalytics a owl:Class ;
    rdfs:subClassOf hpc:Edition .

hpc:Spectrumlsfapplicationcenter a owl:Class ;
    rdfs:subClassOf hpc:Edition .

hpc:ENABLE_STREAM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Spectrumlsfanalytics ;
    rdfs:range xsd:boolean .

hpc:ENABLE_STREAM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Spectrumlsfapplicationcenter ;
    rdfs:range xsd:boolean .

hpc:CustomChangesBackup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:SILENT_INSTALL rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:boolean .

hpc:LSF_SILENT_INSTALL_TARLIST rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:SilentInstallation rdf:type owl:Class ;
    rdfs:subClassOf hpc:Installation .

hpc:QuietInstallation rdf:type owl:Class ;
    rdfs:subClassOf hpc:Installation .

hpc:Edition a owl:Class .
hpc:Installation a owl:Class .
hpc:Cluster a owl:Class .
