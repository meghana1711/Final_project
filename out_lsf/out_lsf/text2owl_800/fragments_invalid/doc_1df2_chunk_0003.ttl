@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Exclusiveexecution a owl:Class .
hpc:operatingsystemname a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:token .

hpc:operatingsystemversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:string .

hpc:cpuarchitecturename a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:token .

hpc:individualcpuspeed a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:individualcpucount a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:nonNegativeInteger .

hpc:individualphysicalmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:individualvirtualmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:individualnetworkbandwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:totalcpucount a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:nonNegativeInteger .

hpc:totalphysicalmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:totalvirtualmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:decimal .

hpc:totalresourcecount a owl:DatatypeProperty ;
    rdfs:domain hpc:Exclusiveexecution ;
    rdfs:range xsd:nonNegativeInteger .

hpc:filename a owl:DatatypeProperty ;
    rdfs:domain ?DataStaging ;
    rdfs:range xsd:string .

hpc:creationflag a owl:DatatypeProperty ;
    rdfs:domain ?DataStaging ;
    rdfs:range xsd:string .
