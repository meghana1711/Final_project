hpc:JobInfo a owl:Class .
hpc:JobState a owl:Class .

hpc:hasJobInfo a owl:ObjectProperty .
hpc:state a owl:ObjectProperty .

hpc:hasJobInfo rdfs:domain hpc:Job .
hpc:state rdfs:domain hpc:Job .

hpc:JobInfo rdfs:subClassOf owl:NamedIndividual .
hpc:Job rdfs:subClassOf owl:NamedIndividual .

