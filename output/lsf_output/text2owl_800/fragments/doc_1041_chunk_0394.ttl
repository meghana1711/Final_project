hpc:taskid a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:Preemptedtask a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "Displays information only about tasks with PREEMPTED status." .

hpc:Runtask a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "Displays information only about tasks with RUN status." .

hpc:Waittask a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "Displays information only about tasks with WAIT status." .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:projectassociatedtask a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Task ;
    rdfs:comment "Displays information only about tasks that are associated with the specified projects." .

hpc:hostsubmittedtask a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:terminalname a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:lsprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
