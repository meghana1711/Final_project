hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Reservation a owl:Class .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Host .
hpc:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:Isopenreservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .
hpc:Isclosedreservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .
hpc:hasResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Resource .
hpc:Isrecurringreservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .
hpc:Isplaceholderreservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .
hpc:hasTimeWindow rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:hasDisabledDays rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Recurringreservation ;
    rdfs:range xsd:gDay .
