@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Switch a owl:Class.
hpc:Node a owl:Class.
hpc:hasswitch a owl:ObjectProperty.
hpc:hasnode a owl:ObjectProperty.
hpc:haslinkspeed a owl:DatatypeProperty.
hpc:Linkspeed rdfs:range xsd:nonNegativeInteger.

hpc:Switch rdfs:subClassOf owl:Class.
hpc:Node rdfs:subClassOf owl:Class.
hpc:Hasswitch rdfs:domain hpc:Switch.
hpc:Hasswitch rdfs:range hpc:Switch.
hpc:Hasnode rdfs:domain hpc:Node.
hpc:Hasnode r
