hpc:Node a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:Task a owl:Class .
hpc:App a owl:Class .
hpc:ComputationallyBound a owl:Class .
hpc:MemoryBound a owl:Class .
hpc:CommunicationBound a owl:Class .

hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Node .

hpc:hasSocket rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Socket .

hpc:hasCore rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:Core .

hpc:hasHint rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:ApplicationHint .

hpc:ApplicationHint a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf [ a owl:Class ;
            rdfs:subClassOf [ a owl:Class ;
                rdfs:subClassOf [ a owl:Class ;
                    rdfs:subClassOf owl:Thing ;
                    rdf:type owl:Restriction ;
                    owl:onProperty hpc:hasHint ;
                    owl:hasValue compute_bound ] ] ] ] .

hpc:hasHintMemoryBound rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .

hpc:hasHintMultithread rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .

hpc:hasCpuBind rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
```
