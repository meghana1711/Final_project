@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>
@prefix hpc: <http://example.org/hpc#>

hpc:Slurm a owl:Class.
hpc:Slurmconf rdf:type hpc:hasresourcespecification.
hpc:Slurmconf rdfs:domain hpc:Slurm.
hpc:Slurmconf rdfs:subClassOf owl:Class.
hpc:Taskplugin rdf:type rdfs:Property.
hpc:Taskplugin rdfs:domain hpc:Slurm.
hpc:Taskplugin rdfs:range xsd:string.
hpc:taskplugin a owl:ObjectProperty.
hpc:Build rdf:type owl:Class.
hpc:Build rdfs:domain hpc:Slurm.
