hpc:Job a owl:Class .
hpc:Requeueexitvalues a owl:Class .
hpc:lsbJobpend a owl:ObjectProperty .
hpc:lsbJobexitStat a owl:DatatypeProperty .
hpc:Executionenvironment a owl:Class .
hpc:commandpath a owl:DatatypeProperty .
hpc:preexecutioncommand a owl:ObjectProperty .
hpc:postexecutioncommand a owl:ObjectProperty .
hpc:path a owl:DatatypeProperty .
hpc:stdinstdoutstderr a owl:ObjectProperty .
hpc:Unix a owl:Class .
hpc:Windows a owl:Class .
hpc:Shellfeatures a owl:Class .
hpc:preexecutioncommanddirectory a owl:DatatypeProperty .
hpc:preexecutioncommandfile a owl:DatatypeProperty .
hpc:postexecutioncommanduser a owl:ObjectProperty .
hpc:userPostexec a owl:DatatypeProperty .
hpc:absolutepath a owl:DatatypeProperty .
hpc:lsbPrePostExecUser a owl:ObjectProperty .
hpc:Hostbasedpostexecutionprocessing a owl:Class .
hpc:preexecutioncommandrununder a owl:DatatypeProperty .
