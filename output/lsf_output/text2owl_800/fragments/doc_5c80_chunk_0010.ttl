hpc:Job a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:attachjob a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range hpc:Job .
hpc:detachjob a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range hpc:Job .
hpc:modifyjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Jobgroup a owl:Class .
hpc:jobgrouppath a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:jobarray a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobarray .
hpc:Jobgroupmodificationrestriction a owl:Class .
hpc:cannotcombinewithotherbmodoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupmodificationrestriction .
hpc:cannotoperateonrunningorfinishedjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupmodificationrestriction .
hpc:cannotmovejobarrayelements a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupmodificationrestriction .
hpc:cannotmodifyjobgroupofattachedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupmodificationrestriction .
