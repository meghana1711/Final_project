hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Queue a owl:Class .

hpc:Hasuser rdfs:domain hpc:User ;
    rdfs:range rdf:List ;
    rdfs:subClassOf owl:ObjectProperty .

hpc:Hasproject rdfs:domain hpc:Project ;
    rdfs:range rdf:List ;
    rdfs:subClassOf owl:ObjectProperty .

hpc:Hasqueue rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:subClassOf owl:ObjectProperty .

hpc:Projectname rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:subClassOf owl:DatatypeProperty .

hpc:Projects a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:Projects ;
                        owl:hasValue "all" ;
                        owl:allValuesFrom hpc:Project ] .

hpc:Projectlist a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasProject ;
                        owl:hasValue rdf:List ] .

hpc:Projectnamelist a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:ProjectName ;
                        owl:hasValue rdf:List ] .

hpc:Projectnamelength rdfs:domain hpc:Projectname ;
    rdfs:range xsd:integer ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:ProjectName ;
                        owl:with datatype xsd:integer ;
                        owl:minValue 1 ;
                        owl:maxValue 511 ] .

hpc:Excludedprojects a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:Projects ;
                        owl:hasValue "~" ] .

hpc:Projectincluster rdfs:domain hpc:Project ;
    rdfs:range hpc:Cluster ;
    rdfs:subClassOf owl:ObjectProperty .
