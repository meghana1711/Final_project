hpc:Job a owl:Class .
hpc:autoresizableattribute a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:networkschedulingoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Networkschedulingoption .

hpc:removenetworkschedulingoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:hostfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Hostallocationfile a owl:Class .
hpc:hostallocationfile a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:hostrankfile a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:Hostfileconflict a owl:Class .

hpc:Taskgeometryenabledjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:advancereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:cannotusehostfilewithnetworkoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:cannotcombinehostfilewithcompoundresreq a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:donotusehostfilewithtaskgeometry a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
