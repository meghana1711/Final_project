hpc:Clearingjob a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:clearTime ;
                        owl:hasValue "00:00"^^xsd:time ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:clearDay ;
                        owl:allValuesFrom [ a owl:Class ;
                                             rdfs:label "Day" ] ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:clearDay ;
                        owl:someValuesFrom [ a owl:Class ;
                                             rdfs:label "Sunday" ] ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:clearDay ;
                        owl:someValuesFrom [ a owl:Class ;
                                             rdfs:label "Monday" ;
                                             rdfs:first [ a owl:Class ;
