hpc:Googlecloudplatformresourceconnector a owl:Class .

hpc:gcloudprojectid a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudplatformresourceconnector ;
    rdfs:range xsd:string .

hpc:gcloudcredentialsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudplatformresourceconnector ;
    rdfs:range xsd:string .

hpc:gcloudregion a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudplatformresourceconnector ;
    rdfs:range xsd:string .

hpc:GoogleCloudProjectID hasValue ?projectID .
hpc:GoogleCloudCredentialsFile hasValue ?credentialsFile .
hpc:GoogleCloudRegion hasValue ?region .
