hpc:Schedulingdecision a owl:Class .
hpc:hasQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingdecision ;
    rdfs:range hpc:Queue .
hpc:isFinal rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingdecision .
hpc:cannotBePreempted rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingdecision ;
    rdfs:range xsd:boolean .
hpc:Highestpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:Lsfdaemon a owl:Class .
hpc:Cpucore a owl:Class .
hpc:Cpubinding a owl:Class .
hpc:bindsTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemon ;
    rdfs:range hpc:Cpucore .
hpc:isBoundBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpubinding ;
    rdfs:range hpc:Lsfdaemon .
hpc:lsfIntelligentCpuBind a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:lsfEnvdir a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:cpuBinding a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:host_name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cpubinding .
hpc:cluster_name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cpubinding .
hpc:automaticBindingPolicy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpubinding .
hpc:topologyDetection rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:bindsAccordingTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:exists rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpubinding .
hpc:restarts rdf:type owl:ObjectProperty ;
    rdfs:domain hcp:LSF .
hpc:bctrldRestart rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Restarts .
hpc:sbdRestart rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Restarts .
hpc:mdmRestart rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Restarts .
hpc:supportsCommentsFalse rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpubinding .
hpc:takesPrecedence rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfIntelligentCpuBind .
