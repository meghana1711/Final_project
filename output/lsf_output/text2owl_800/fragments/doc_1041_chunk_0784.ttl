hpc:Cluster a owl:Class .
hpc:clusterstatus a owl:ObjectProperty .
hpc:Clustername rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Status a owl:Enum ;
    rdfs:member hpc:ok ;
    rdfs:member hpc:unavail .
hpc:Masterhost rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Useraccount rdfs:domain hpc:Masterhost ;
    rdfs:range xsd:string .
hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:servers a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
