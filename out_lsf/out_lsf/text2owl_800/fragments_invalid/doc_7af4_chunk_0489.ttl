hpc:Compoundresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Simpleresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Queuelevelresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:subClassOf hpc:Simpleresourcerequirement ;
    rdfs:subClassOf hpc:Compoundresourcerequirement .

hpc:Joblevelresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:subClassOf hpc:Simpleresourcerequirement ;
    rdfs:subClassOf hpc:Compoundresourcerequirement .

hpc:Applicationlevelresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:subClassOf hpc:Simpleresourcerequirement ;
    rdfs:subClassOf hpc:Compoundresourcerequirement .

hpc:Resourcerequirementstring a owl:Class ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .

hpc:Strictresourcerequirementsyntax a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementstring .

hpc:Nonconsumableresource a owl:Class ;
    rdfs:domain rusage : rdfs:range xsd:string .

hpc:Mergeableresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Mergedresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Mergeableresourcerequirement .

hpc:Queuebasedresource a owl:Class ;
    rdfs:domain hpc:Joblevelresourcerequirement ;
    rdfs:range hpc:Resource .

hpc:Jobbasedresource a owl:Class ;
    rdfs:domain hpc:Mergedresourcerequirement ;
    rdfs:range hpc:Resource .

hpc:Selectsection a owl:Class ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirementstring .

hpc:cupriority a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:integer .

hpc:affinity a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .

hpc:rusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
