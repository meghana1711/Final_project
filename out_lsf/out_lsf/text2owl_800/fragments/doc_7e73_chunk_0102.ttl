hpc:Lsfinstallation a owl:Class .
hpc:Serverconfig a owl:Class .
hpc:Resource a owl:Class .
hpc:Googlecloudresource a owl:Class .
hpc:Lsfhost a owl:Class .

# Object Properties
hpc:hasinstallationdirectory a owl:ObjectProperty .
hpc:hasadmin a owl:ObjectProperty .
hpc:hastardirectory a owl:ObjectProperty .
hpc:haslicense a owl:ObjectProperty .
hpc:hasserverhosts a owl:ObjectProperty .
hpc:haslocalresources a owl:ObjectProperty .
hpc:haslimport a owl:ObjectProperty .
hpc:getconf a owl:ObjectProperty .

# Datatype Properties
hpc:hastopdirectory a owl:DatatypeProperty .
hpc:hasversion a owl:DatatypeProperty .

# Domain and Range
hpc:Hasinstallationdirectory rdfs:domain hpc:Lsfinstallation ;
 rdfs:range xsd:string .
hpc:Hasadmin rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:string .
hpc:Hastardirectory rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:string .
hpc:Haslicense rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:string .
hpc:Hasserverhosts rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:string .
hpc:Haslocalresources rdfs:domain hpc:Serverconfig ;
 rdfs:range hpc:Resource .
hpc:Haslimport rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:integer .
hpc:Getconf rdfs:domain hpc:Serverconfig ;
 rdfs:range xsd:string .
hpc:Hastopdirectory rdfs:domain hpc:Lsfinstallation ;
 rdfs:range xsd:string .
hpc:Hasversion rdfs:domain hpc:Lsfinstallation ;
 rdfs:range xsd:string .
