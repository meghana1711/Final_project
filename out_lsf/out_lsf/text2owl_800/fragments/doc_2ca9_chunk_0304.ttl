hpc:Operatingsystem a owl:Class .
hpc:Version a owl:Class .
hpc:Cpu a owl:Class .
hpc:Hardware a owl:Class .
hpc:packagename a owl:DatatypeProperty .
hpc:support a owl:ObjectProperty .
hpc:certified a owl:ObjectProperty .

hpc:Solaris a hpc:OperatingSystem ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf hpc:Unixoperatingsystem ] .
hpc:SolarisOnSPARC a hpc:Solaris ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf hpc:Solaris ] .
hpc:SolarisOnSPARC_10 a hpc:SolarisOnSPARC ;
    rdfs:subClassOf [ a owl:Class ] .
    hpc:Packagename rdfs:range xsd:string .
    hpc:Support rdfs:domain hpc:Solarisonsparc10 ;
        rdfs:range xsd:string .
hpc:SolarisOnx86_64 a hpc:Solaris ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf hpc:Solaris ] .
hpc:SolarisOnx86_64_10 a hpc:SolarisOnx86_64 ;
    rdfs:subClassOf [ a owl:Class ] .
    hpc:Packagename rdfs:range xsd:string .
    hpc:Support rdfs:domain hpc:Solarisonx866410 ;
        rdfs:range xsd:string .
hpc:Linux a hpc:OperatingSystem ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf hpc:Unixoperatingsystem ] .
hpc:LinuxX64 a hpc:Linux ;
    rdfs:subClassOf [ a owl:Class ] .
    hpc:Kernel rdfs:range xsd:string .
    hpc:Glibc rdfs:range xsd:string .
hpc:RHEL a hpc:LinuxX64 ;
    rdfs:subClassOf [ a owl:Class ] .
hpc:SLES a hpc:LinuxX64 ;
    rdfs:subClassOf [ a owl:Class ] .
hpc:IBM_Power_LE a hpc:CPU ;
    rdfs:subClassOf [ a owl:Class ] .
hpc:Ubuntu a hpc:LinuxX64 ;
    rdfs:subClassOf [ a owl:Class ] .
hpc:Microsoft_Windows a hpc:OperatingSystem ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf hpc:Windowsoperatingsystem ] .
hpc:IBM_Spectrum_LSF a hpc:OperatingSystem ;
    rdfs:subClassOf [ a owl:Class ] .
