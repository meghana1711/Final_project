hpc:Simpleshell a owl:Class .
hpc:chcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Simpleshell ;
    rdfs:range rdf:List .

hpc:Homedirectory a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:currentworkingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Simpleshell ;
    rdfs:range hpc:Homedirectory ;
    owl:hasValue xsd:currentDirectory .

hpc:commandexecutionenvironment a owl:DatatypeProperty ;
    rdfs:domain hpc:Simpleshell ;
    rdfs:range xsd:anyURI ;
    owl:hasValue xsd:executionEnvironment .

hpc:Builtincommand a owl:Class .

hpc:postcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Simpleshell ;
    rdfs:range hpc:Backgroundjob .

hpc:Backgroundjob a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:contactcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Simpleshell ;
    rdfs:range hpc:Backgroundjob .

hpc:tildepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Pathname ;
    rdfs:range hpc:Homedirectory ;
    owl:hasValue xsd:tilde .

hpc:userhomedirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Username ;
    rdfs:range hpc:Homedirectory ;
    owl:hasValue xsd:homeDirectory .

hpc:shellcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Pathname ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:shellCommand .

hpc:pipe a owl:ObjectProperty ;
    rdfs:domain hpc:Shellcommand ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:pipe .

hpc:listofcommands a owl:ObjectProperty ;
    rdfs:domain hpc:Shellcommand ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:listOfCommands .

hpc:standardinputredirection a owl:ObjectProperty ;
    rdfs:domain hpc:Shellcommand ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:standardInputRedirection .

hpc:standardoutputredirection a owl:ObjectProperty ;
    rdfs:domain hpc:Shellcommand ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:standardOutputRedirection .

hpc:Bourneshell a owl:Class ;
    rdfs:subClassOf xsd:string .
