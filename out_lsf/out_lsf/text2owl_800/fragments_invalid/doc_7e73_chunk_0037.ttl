hpc:Lsf a owl:Class .
hpc:Fixpack a owl:Class .
hpc:Configurationfile a owl:Class .
hpc:Directory a owl:Class .
hpc:File a owl:Class .
hpc:providername a owl:DatatypeProperty .
hpc:LSF_TOP a xsd:string .
hpc:lsfRcExternalHostFlag a owl:ObjectProperty .
hpc:BooleanResourceName a xsd:string .
hpc:Pluginmodule a owl:Class .
hpc:schmoddemand a owl:ObjectProperty .
hpc:Awsresource a owl:Class .
hpc:AWS_ENABLE_SH a xsd:string .
hpc:AWS_ENABLE_CONFIG a xsd:string .
hpc:LSF_VERSION a xsd:string .
hpc:Install a xsd:string .
hpc:sourcelsfprofile a owl:ObjectProperty .
hpc:ProfileLSF a xsd:string .

hpc:LSF subClassOf owl:Class .
hpc:FixPack subClassOf hpc:LSF .
hpc:Configurationfile a owl:Class .
hpc:Directory a owl:Class .
hpc:File a owl:Class .
hpc:Providername rdfs:domain hpc:Configurationfile ;
                  rdfs:range xsd:string .
hpc:LsfTop rdfs:range xsd:string .
hpc:LsfRcExternalHostFlag rdfs:domain hpc:Lsf ;
                               rdfs:range hpc:Booleanresourcename .
hpc:PluginModule subClassOf hpc:LSF .
hpc:Schmoddemand rdfs:domain hpc:Pluginmodule ;
                   rdfs:range hpc:File .
hpc:Awsresource a owl:Class .
hpc:AwsEnableSh rdfs:range xsd:string .
hpc:AwsEnableConfig rdfs:range xsd:string .
hpc:LsfVersion rdfs:range xsd:string .
hpc:Install rdfs:range xsd:string .
hpc:Sourcelsfprofile rdfs:domain hpc:Awsresource ;
                       rdfs:range hpc:File .
