hpc:Lsf a owl:Class .
hpc:erenewscript a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Script .

hpc:aklog a owl:ObjectProperty ;
    rdfs:domain hpc:Erenewscript ;
    rdfs:range hpc:Command .

hpc:jobSpoolDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:lsbAfsJobSupport a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:lsbAfsBinDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:lsbKrbTgtDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:akloginafs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Boolean .

hpc:Kerberosauthentication a owl:Class .
hpc:securedataexchange a owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosauthentication ;
    rdfs:range hpc:Boolean .

hpc:remotehostcredentialforwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosauthentication ;
    rdfs:range hpc:Boolean .

hpc:supportedon a owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosauthentication ;
    rdfs:range hpc:Operatingsystem .

hpc:Operatingsystem a owl:Class .
