hpc:Slurm a owl:Class .
hpc:Researcher hpc:uses hpc:Slurm .
hpc:CiteWork a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .

hpc:User hpc:uses hpc:Slurm .

hpc:DesignJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:RunMultipleJobs a owl:ObjectProperty ;
    rdfs:domain hpc:DesignJob ;
    rdfs:range hpc:Job .

hpc:RunJobAllocation a owl:ObjectProperty ;
    rdfs:domain hpc:DesignJob ;
    rdfs:range hpc:Job .

hpc:CPU a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Thread a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:RunNodeTask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:TaskID a owl:DatatypeProperty ;
    rdfs:domain hpc:BatchJob ;
    rdfs:range xsd:integer .

hpc:Environment a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:MakeCommand a owl:ObjectProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range hpc:Command .

hpc:RunAnsys a owl:ObjectProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range hpc:Program .

hpc:SubmitJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:IgnoredSrunOptions a owl:ObjectProperty ;
    rdfs:domain hpc:SubmitJob ;
    rdfs:range xsd:string .

hpc:OvercommitSrunOption a owl:ObjectProperty ;
    rdfs:domain hpc:SubmitJob ;
    rdfs:range xsd:boolean .
```
