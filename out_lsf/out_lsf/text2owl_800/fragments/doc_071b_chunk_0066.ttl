hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:lsbJobReportMail a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether an email will be sent by sbatchd after the job is done." .

hpc:jobdoneevent a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "The event that occurs after the job is done." .

hpc:emailsentevent a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "The event that occurs when an email is sent by sbatchd." .

hpc:jobrerun a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "The event that occurs when a job is scheduled to rerun on another host." .

hpc:modifyingenvfileinesubscript a owl:ObjectProperty ;
    rdfs:domain hpc:Esub ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the value of the LSB_SUB_MODIFY_ENVFILE parameter can be changed in the esub script." .

hpc:Esub a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents an esub script in the HPC system." .
