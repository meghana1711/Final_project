hpc:v0_0_40_openapi_ping_array_resp a owl:Class .
hpc:v0_0_40_openapi_resp a owl:Class .
hpc:v0_0_40_openapi_reservation_resp a owl:Class .

hpc:hasContent a owl:ObjectProperty ;
    rdfs:domain hpc:Response ;
    rdfs:range rdf:Resource .

hpc:contentApplicationXYAML hpc:hasContent ;
    rdfs:subClassOf hpc:hasContent ;
    rdfs:comment "Content in application/x-yaml format" .

hpc:contentApplicationYAML hpc:hasContent ;
    rdfs:subClassOf hpc:hasContent ;
    rdfs:comment "Content in application/yaml format" .

hpc:contentTextYAML hpc:hasContent ;
    rdfs:subClassOf hpc:hasContent ;
    rdfs:comment "Content in text/yaml format" .

hpc:contentApplicationJSONRequest hpc:hasContent ;
    rdfs:subClassOf hpc:hasContent ;
    rdfs:comment "Content in application/jsonrequest format" .

# Classes for paths
hpc:SlurmPing a owl:Class ;
    rdfs:subClassOf hpc:Response .

hpc:SlurmReconfigure a owl:Class ;
    rdfs:subClassOf hpc:Response .

hpc:SlurmReservation a owl:Class ;
    rdfs:subClassOf hpc:Response .

# Object property for path
hpc:path a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPing ;
    rdfs:domain hpc:SlurmReconfigure ;
    rdfs:domain hpc:SlurmReservation ;
    rdfs:range rdf:Property .

# Datatype property for path
hpc:pathRef a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmPing ;
    rdfs:domain hpc:SlurmReconfigure ;
    rdfs:domain hpc:SlurmReservation ;
    rdfs:range xsd:anyURI .
```
