hpc:Operatingsystem a owl:Class .
hpc:Computehost a owl:Class .
hpc:Arm64 a owl:Class .
hpc:X8664 a owl:Class .
hpc:Ia64 a owl:Class .
hpc:Sparc a owl:Class .
hpc:Itanium2 a owl:Class .
hpc:Power9 a owl:Class .
hpc:Power10 a owl:Class .
hpc:Aix a owl:Class .
hpc:Solaris a owl:Class .
hpc:Hpux a owl:Class .
hpc:Windows a owl:Class .
hpc:Windows10 a owl:Class .
hpc:Windows11 a owl:Class .
hpc:Windowsserver2016 a owl:Class .
hpc:Windowsserver2019 a owl:Class .
hpc:Windowsserver2022 a owl:Class .

hpc:certified a owl:ObjectProperty .
hpc:supported a owl:ObjectProperty .
hpc:endoflife a owl:ObjectProperty .

hpc:Operatingsystem rdfs:subClassOf [ a owl:Class ;
                                      rdfs:subClassOf hpc:Computehost ] .
hpc:Arm64 rdfs:subClassOf hpc:X8664 .
hpc:Sparc rdfs:subClassOf hpc:X8664 .
hpc:Itanium2 rdfs:subClassOf hpc:X8664 .
hpc:Power9 rdfs:subClassOf hpc:Power10 .
hpc:Power10 rdfs:subClassOf hpc:Aix .
hpc:Aix rdfs:subClassOf hpc:Operatingsystem .
hpc:Solaris rdfs:subClassOf hpc:Operatingsystem .
hpc:Hpux rdfs:subClassOf hpc:Operatingsystem .
hpc:Windows rdfs:subClassOf hpc:Operatingsystem .

hpc:Certified rdfs:domain hpc:Operatingsystem ;
                 rdfs:range xsd:boolean .
hpc:Supported rdfs:domain hpc:Operatingsystem ;
                 rdfs:range xsd:boolean .
hpc:Endoflife rdfs:domain hpc:Operatingsystem ;
                 rdfs:range xsd:boolean .
