hpc:Command a owl:Class .
hpc:hasEnvironmentVariables rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List .

hpc:LSB_JOBPGIDS rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:integer .

hpc:LSB_JOBPIDS rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:integer .

hpc:commandPath rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:maxCommandPathLength rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger .

hpc:defaultCommandPathLength rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger .

hpc:onUnixResumeAction rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:onWindowsResumeAction rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:jobControlMessages rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List .

hpc:RTASK_GONE_ACTION rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:IGNORE_TASKCRASH rdf:Property ;
    rdfs:domain hpc:RtaskGoneAction ;
    rdfs:range xsd:boolean .

hpc:Job a owl:Class .
hpc:hasCommand rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command .
