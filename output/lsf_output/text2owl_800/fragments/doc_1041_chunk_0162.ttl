hpc:Lsfdatamanager a owl:Class .
hpc:activedatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .

hpc:connectionstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .

hpc:master a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Lsfdatamanager .

hpc:Outgoingremote a owl:Class .
hpc:outgoingremotecluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .
hpc:outgoingremotedatahosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .
hpc:outgoingremotedataport a owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:integer .
hpc:outgoingremotestatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .

hpc:Incomingremote a owl:Class .
hpc:incomingremotecluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range xsd:string .

hpc:Cluster a owl:Class .
hpc:lsfDataHosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
hpc:lsfDataPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:integer .
