@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .

hpc:QueueName rdfs:domain hpc:Queue .
hpc:QueueName rdfs:range xsd:string .

hpc:Priority rdfs:domain hpc:Queue .
hpc:Priority rdfs:range xsd:integer .

hpc:Nice rdfs:domain hpc:Queue .
hpc:Nice rdfs:range xsd:integer .

hpc:TerminateWhen rdfs:domain hpc:Queue .
hpc:TerminateWhen rdfs:range xsd:string .

hpc:Rerunnable rdfs:domain hpc:Queue .
hpc:Rerunnable rdfs:range xsd:boolean .

hpc:Interactive rdfs:domain hpc:Queue .
hpc:Interactive rdfs:range xsd:boolean .

hpc:Description rdfs:domain hpc:Queue .
hpc:Description rdfs:range xsd:string .

hpc:ResReq rdfs:domain hpc:Queue .
hpc:ResReq rdfs:range rdf:Resource .

hpc:RequeueExitValues rdfs:domain hpc:Queue .
hpc:RequeueExitValues rdfs:range xsd:integer .

hpc:hpc_linux_tv a hpc:Queue .
hpc:HpcLinuxTv hpc:priority 30 .
hpc:HpcLinuxTv hpc:nice 20 .
hpc:HpcLinuxTv hpc:terminateWhen "LOAD PREEMPT WINDOW" .
hpc:HpcLinuxTv hpc:rerunnable "NO" .
hpc:HpcLinuxTv hpc:interactive "NO" .
hpc:HpcLinuxTv hpc:description "IBM Spectrum LSF 10.1 for linux debug queue. End Queue" .

hpc:hpc_ibm a hpc:Queue .
hpc:HpcIbm hpc:priority 30 .
hpc:HpcIbm hpc:nice 20 .
hpc:HpcIbm hpc:resReq [ poe > 0 ] EXCLUSIVE "Y" .
hpc:HpcIbm hpc:requeueExitValues 133 134 135 .
hpc:HpcIbm hpc:description "IBM Spectrum L
