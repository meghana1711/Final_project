hpc:hasFeatureGroup
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Projectgroup ;
    rdfs:comment "Represents the parent-child relationship between project groups." .

hpc:hasFeature
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Feature ;
    rdfs:comment "Assigns a feature to a project group." .

hpc:Feature
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a feature of a project group." .

hpc:hasShares
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the number of shares for a project group." .

hpc:hasOwnership
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the ownership of a project group." .

hpc:hasLimit
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the limit for a project group." .

hpc:isNonShared
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a project group has exclusive, non-shared licenses." .
