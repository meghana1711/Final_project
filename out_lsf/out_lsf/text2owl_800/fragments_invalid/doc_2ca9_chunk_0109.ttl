hpc:lsbUpdateContainerImage a owl:ObjectProperty .
hpc:LsbUpdateContainerImage rdfs:domain hpc:Lsf .
hpc:LsbUpdateContainerImage rdfs:range xsd:string .

# Error handling for LSF jobs with IBM Cluster Systems Manager
hpc:csmErrorHandling a owl:ObjectProperty .
hpc:CsmErrorHandling rdfs:domain hpc:Lsf .
hpc:CsmErrorHandling rdfs:range xsd:boolean .

# lsb.resources file
hpc:killJobsOverRunlimit a owl:ObjectProperty .
hpc:KillJobsOverRunlimit rdfs:domain hpc:Lsf .
hpc:KillJobsOverRunlimit rdfs:range xsd:string .

# Display the exit reason in the bjobs -l -pac command
hpc:exitReason a owl:DatatypeProperty .
hpc:ExitReason rdfs:domain hpc:Job .
hpc:ExitReason rdfs:range xsd:string .

# New platform support
hpc:Sles15 a owl:Class .
hpc:Sles15 rdfs:subClassOf hpc:Platform .
hpc:SLES_15 rdfs:comment "SLES 15" .
hpc:SLES_15 rdfs:label "SLES 15" .

hpc:Kernel41214 a owl:Class .
