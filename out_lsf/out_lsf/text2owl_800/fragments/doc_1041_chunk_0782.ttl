hpc:Dynamichost a owl:Class .
hpc:instanceid a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamichost ;
    rdfs:range xsd:string .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamichost .
hpc:Expiredhost a owl:Class ;
    rdfs:subClassOf hpc:Dynamichost .
hpc:expirehost a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range hpc:Expiredhost .
hpc:lsadminexpirecommand a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range hpc:Expiredhost .
hpc:lsloadcommand a owl:ObjectProperty ;
    rdfs:domain xsd:string .
hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain xsd:string .
hpc:lshostscommand a owl:ObjectProperty ;
    rdfs:domain xsd:string .
hpc:bjobscommand a owl:ObjectProperty ;
    rdfs:domain xsd:string .
hpc:helpcommand a owl:ObjectProperty ;
    rdfs:domain xsd:string .
