hpc:OpenapiPartitionResp a owl:Class .
hpc:OpenapiPingArrayResp a owl:Class .

# Slurm Partition response properties
hpc:openapiPartitionResp a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPartitionResp ;
    rdfs:range hpc:OpenapiPartitionResp .

# Slurm Ping response properties
hpc:openapiPingArrayResp a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPingArrayResp ;
    rdfs:range hpc:OpenapiPingArrayResp .

# Content media types for Slurm Partition and Ping responses
hpc:applicationJsonRequest a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPartitionResp, hpc:OpenapiPingArrayResp ;
    rdfs:range xsd:string .
hpc:applicationXYaml a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPartitionResp, hpc:OpenapiPingArrayResp ;
    rdfs:range xsd:string .
hpc:textYaml a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPartitionResp, hpc:OpenapiPingArrayResp ;
    rdfs:range xsd:string .
hpc:applicationYaml a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPartitionResp, hpc:OpenapiPingArrayResp ;
    rdfs:range xsd:string .

# Slurm Partition and Ping response schema references
hpc:openapiPartitionRespSchema a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPartitionResp, hpc:OpenapiPingArrayResp ;
    rdfs:range xsd:anyURI .

# Subclass relations for Slurm Partition and Ping responses
hpc:OpenapiPartitionResp rdfs:subClassOf hpc:OpenapiResponse .
hpc:OpenapiPingArrayResp rdfs:subClassOf hpc:OpenapiResponse .

# Slurm Reconfigure response properties and media types (incomplete due to missing information)
hpc:openapiReconfigureResp a owl:Class .
hpc:applicationJsonRequest_reconfigure a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiReconfigureResp ;
    rdfs:range xsd:string .
hpc:applicationXYaml_reconfigure a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiReconfigureResp ;
    rdfs:range xsd:string .
hpc:textYaml_reconfigure a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiReconfigureResp ;
    rdfs:range xsd:string .
hpc:applicationYaml_reconfigure a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiReconfigureResp ;
    rdfs:range xsd:string .
hpc:openapiReconfigureRespSchema a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiReconfigureResp ;
    rdfs:range xsd:anyURI .
hpc
