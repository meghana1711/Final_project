hpc:Lockid a owl:Class .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lockid ;
    rdfs:range xsd:integer .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Lockid ;
    rdfs:range xsd:string .
hpc:message a owl:DatatypeProperty ;
    rdfs:domain hpc:Lockid ;
    rdfs:range xsd:string .

hpc:Attrcreate a owl:Class .
hpc:version a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrcreate ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrcreate ;
    rdfs:range xsd:string .
hpc:attrnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrcreate ;
    rdfs:range xsd:integer .
hpc:attributelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrcreate ;
    rdfs:range xsd:string .
hpc:hostnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrcreate ;
    rdfs:range xsd:integer .
