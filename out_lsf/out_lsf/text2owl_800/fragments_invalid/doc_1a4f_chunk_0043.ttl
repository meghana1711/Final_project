hpc:Elimexecutable a owl:Class .
hpc:checkingheader a owl:ObjectProperty ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range hpc:Checkingheader .

hpc:exitswithelimAbortValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range xsd:integer .

hpc:restarts a owl:ObjectProperty ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range hpc:Elimexecutable .

hpc:maxrestartfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range xsd:integer .

hpc:Melim a owl:Class .

hpc:collectsloadinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

hpc:checkssyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

hpc:mergesloadreports a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

hpc:sendsloadinformationtolim a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

hpc:reportslatestvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Melim ;
    rdfs:range rdf:Resource .

hpc:logsactivities a owl:ObjectProperty ;
    rdfs:domain hpc:Melim ;
    rdfs:range rdf:Resource .

hpc:logsintologfile a owl:ObjectProperty ;
    rdfs:domain hpc:Melim ;
    rdfs:range rdf:Literal .

hpc:increasessystemreliability a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

hpc:buffersoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Melim .

# LSF Configuration

hpc:Configuration a owl:Class .

hpc:runsonlywhenexpected a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range hpc:Elimexecutable .

hpc:providesconfigurationoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration .

hpc:controlselimexecutables a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration .

hpc:mapsexternalresourcenames a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range rdf:Resource .

hpc:optionallyusesenvironmentvariables a owl:ObjectProperty ;
    rdfs:domain hpc:Elimexecutable .

# Resource Mapping and Elim Hosts

hpc:Resourcemapping a owl:Class .

hpc:determineselimhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemapping ;
    rdfs:range hpc:Host .

hpc
