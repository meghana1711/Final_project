hpc:Lsfproxyddaemon a owl:Class .
hpc:Mbatchddaemon a owl:Class .
hpc:Ratelimiter a owl:Class .
hpc:Requesttoken a owl:Class .
hpc:Queryprocess a owl:Class .
hpc:Cpu a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:Linux a owl:Class ;
    rdfs:subClassOf hpc:Operatingsystem .
hpc:Polaris a owl:Class ;
    rdfs:subClassOf hpc:Operatingsystem .

hpc:offloadusing a owl:ObjectProperty .
hpc:isboundto a owl:ObjectProperty .
hpc:hasratelimiter a owl:ObjectProperty .
hpc:haslsfproxyddaemon a owl:ObjectProperty .
hpc:hasrequesttoken a owl:ObjectProperty .
hpc:hasqueryprocess a owl:ObjectProperty .
hpc:hascpu a owl:ObjectProperty .
hpc:hasoperatingsystem a owl:ObjectProperty .

hpc:Linuxcommand a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Polariscommand a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:tasksetCommand a hpc:LinuxCommand ;
    rdfs:range hpc:Linuxcommand ;
    rdfs:domain hpc:Isboundto .

hpc:psCommand a hpc:PolarisCommand ;
    rdfs:range hpc:Polariscommand ;
    rdfs:domain hpc:Isboundto .

hpc:Lsfproxyddaemon rdfs:subClassOf hpc:Daemon .
hpc:Mbatchddaemon rdfs:subClassOf hpc:Daemon .
hpc:Daemon a owl:Class .

hpc:Ratelimiter rdfs:domain hpc:Lsfproxyddaemon .
hpc:Lsfproxyddaemon rdfs:domain hpc:Cluster .
hpc:Cluster a owl:Class .

hpc:Requesttoken rdfs:domain hpc:Lsfproxyddaemon .
hpc:Queryprocess rdfs:domain hpc:Cpu .
hpc:Cpu rdfs:domain hpc:System .
hpc:System a owl:Class .

hpc:max a xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:nominal a xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:throttle a xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .
hpc:proxydPolicies a owl:DatatypeProperty .
hpc:Lsfproxyddaemon rdfs:range hpc:Lsfproxyddaemon .
hpc:lsf.confFile a owl:DatatypeProperty .
hpc:lsfProxyHosts a owl:DatatypeProperty .
hpc:lsfProxyPort a owl:DatatypeProperty .
