hpc:Pam a owl:Class .
hpc:MpiApp a owl:Class .
hpc:argument a owl:ObjectProperty .
hpc:V a xsd:boolean .

hpc:hasArgument domain hpc:MPI_App ;
    rdfs:range xsd:string .

hpc:ispamapp a owl:ObjectProperty .
hpc:hasV a xsd:boolean .

hpc:usesvendormpilibrary a owl:ObjectProperty .
hpc:usespjl a owl:ObjectProperty .
hpc:startsparalleljob a owl:ObjectProperty .
hpc:contactsres a owl:ObjectProperty .
hpc:queriesresourceusage a owl:ObjectProperty .
hpc:sendscontrolsignals a owl:ObjectProperty .
hpc:cleansuptasks a owl:ObjectProperty .
hpc:passesjoblevelresourceusage a owl:ObjectProperty .
hpc:passespids a owl:ObjectProperty .
hpc:passespgids a owl:ObjectProperty .
hpc:collectsresourceusageinfo a owl:ObjectProperty .
hpc:collectsexitstatus a owl:ObjectProperty .

hpc:MpiJob a owl:Class .
hpc:Task a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Resourcemanager a owl:Class .
hpc:Pjl a owl:Class .
hpc:Taskstarter a owl:Class .
hpc:LsfAwareMpiSystem a owl:Class .
hpc:Vendormpilibrary a owl:Class .
hpc:Childprocess a owl:Class .

hpc:MPI_Job subClassOf hpc:ParallelApplication .
hpc:Task subClassOf hpc:ParallelTask .
hpc:ExecutionHost subClassOf hpc:Host .
hpc:ResourceManager subClassOf hpc:ResourceManagementSystem .
hpc:PJL subClassOf hpc:ParallelJobLauncher .
hpc:TaskStarter subClassOf hpc:TaskManager .
hpc:LSF_Aware_MPI_System subClassOf hpc:MPI_System .
hpc:vendorMPILibrary subClassOf hpc:MPILibrary .
hpc:childProcess subClassOf hpc:Process .

hpc:usesVendorMPILibrary domain hpc:MPI_App ;
    rdfs:range hpc:Vendormpilibrary .
hpc:startsParallelJob domain hpc:MPI_App ;
    rdfs:range hpc:MpiJob .
hpc:contactsRES domain hpc:MPI_Job ;
    rdfs:range hpc:Resourcemanager .
hpc:queriesResourceUsage domain hpc:MPI_Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:sendsControlSignals domain hpc:MPI_Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cleansUpTasks domain hpc:MPI_Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:passesJobLevelResourceUsage domain hpc:MPI_Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:passes
