hpc:TRES a owl:Class .
hpc:AccountingStorageTRES rdf:type hpc:TRES .
hpc:PWTRES rdf:type hpc:TRES .

hpc:hasTRES a owl:ObjectProperty .
hpc:hasTRES rdfs:domain hpc:TRES ;
                        rdfs:range rdf:List .

hpc:TRESName a owl:DatatypeProperty .
hpc:TRESName rdfs:domain hpc:GRES ;
                      rdfs:domain hpc:License ;
                      rdfs:domain hpc:BB .
hpc:TRESName rdfs:range xsd:string .

hpc:GRES a owl:Class .
hpc:License a owl:Class .
hpc:BB a owl:Class .

hpc:GRESSubtype a owl:ObjectProperty .
hpc:GRESSubtype rdfs:domain hpc:GRES ;
                      rdfs:range hpc:GRES .

hpc:hasTRESWeight a owl:DatatypeProperty .
hpc:hasTRESWeight rdfs:domain hpc:PWTRES ;
                       rdfs:range xsd:integer .
```
