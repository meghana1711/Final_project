hpc:Job a owl:Class .
hpc:ProxiedAuthenticationSystem a owl:Class .
hpc:LinuxPOSIXACLsAndTrusts a owl:Class .
hpc:ModelOfTrust a owl:Class .
hpc:SlurmJWTPlugin a owl:Class .
hpc:ExternalJWTGeneration a owl:Class .
hpc:AuthenticatingProxy a owl:Class .
hpc:Nginx a owl:Class ; rdfs:subClassOf hpc:AuthenticatingProxy .
hpc:Apache a owl:Class ; rdfs:subClassOf hpc:AuthenticatingProxy .
hpc:OtherNonTrivialProxy a owl:Class ; rdfs:subClassOf hpc:AuthenticatingProxy .
hpc:CloudAuthenticationSystem a owl:Class .
hpc:AmazonCognito a owl:Class ; rdfs:subClassOf hpc:CloudAuthenticationSystem .
hpc:Keycloak a owl:Class .

hpc:queuedJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:runsWithPermissions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:LinuxPOSIXACLsAndTrusts .

hpc:usesTrustModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:ModelOfTrust .

hpc:hasPluginImplementation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ModelOfTrust ;
    rdfs:range hpc:SlurmJWTPlugin .

hpc:requiresExternalJWTGeneration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Site ;
    rdfs:range hpc:ExternalJWTGeneration .

hpc:implementsAuthenticatingProxy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Site ;
    rdfs:range hpc:AuthenticatingProxy .

hpc:hasSlurmUserRootToken rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthenticatingProxy ;
    rdfs:range xsd:string .

hpc:proxiesForUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthenticatingProxy ;
    rdfs:range hpc:User .

hpc:hasXSLURMUSERTOKENHeader rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthenticatingProxy ;
    rdfs:range xsd:string .

hpc:hasXSLURMUSERNAMEHeader rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AuthenticatingProxy ;
    rdfs:range xsd:string .

hpc:usesSignedPublicKeys rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:CloudAuthenticationSystem ;
    rdfs:range xsd:boolean .
```
