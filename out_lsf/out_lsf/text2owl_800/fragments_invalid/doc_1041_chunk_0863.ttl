hpc:Pam a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Command for running MPI applications on a cluster." .

hpc:pamOptions a owl:ObjectProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional options for the PAM command." .

hpc:g a owl:ObjectProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of processors required to run the MPI application." .

hpc:arg a owl:ObjectProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range hpc:Argument ;
    rdfs:comment "An argument passed to the PAM command." .

hpc:Argument a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A value passed as an argument to a command." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A job to be run on the cluster." .

hpc:jobOptions a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Additional options for the job." .

hpc:a a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the MPI application to be run." .

hpc:b a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Group name for the job." .

hpc:n a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of tasks for the job." .

hpc:numTasks a owl:DatatypeProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of tasks that the PAM command specifies." .

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range hpc:Command ;
    rdfs:comment "The bsub command used in the same job submission." .

hpc:exitStatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Pam ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Exit status of the mpirun command or the PJL wrapper." .

hpc:Command a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A command to be run on the cluster." .

hpc:Patchinstall a owl:Class ;
    rdfs:subClass
