hpc:Jobgroup a owl:Class .
hpc:Job a owl:Class .
hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:movejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:jobgrouppath a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:JobGroupPathValue rdf:datatype xsd:string .
hpc:JobGroupPathValue "http://example.org/risk_group" .
hpc:JobGroupPathValue "/risk_group/portfolio2/monthly" .
hpc:resumealljobsingroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:CanOperateOnPendingJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup .
hpc:CanModifyOwnJobGroups rdf:type owl:ObjectProperty ;
    rdfs:domain hdfs:User .
hpc:CanModifyOtherUsersJobGroups rdf:type owl:ObjectProperty ;
    rdfs:domain hdfs:User .
hpc:CanOperateOnRunningJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hdfs:User ;
    rdfs:range xsd:boolean .
hpc:LSB_MOD_ALL_JOBS rdf:type owl:DatatypeProperty ;
    rdfs:domain hdfs:User ;
    rdfs:range xsd:boolean .
