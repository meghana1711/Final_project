hpc:Perslot
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobbasedresource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Duration
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobbasedresource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Decay
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobbasedresource ;
