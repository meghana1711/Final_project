hpc:LsfLogonDesktop a owl:Class ;
    rdfs:comment "Indicates if jobs run in interactive foreground sessions." .

hpc:LsbTsjob a owl:Class ;
    rdfs:comment "Indicates that the job is a Terminal Services job." .

hpc:cannotmodifyjob a owl:ObjectProperty ;
    rdfs:domain hpc:LsfLogonDesktop ;
    rdfs:range hpc:Job ;
    rdfs:comment "Cannot use the bmod command to modify a job that is submitted as a Terminal Services job." .

hpc:nooutfilesupport a owl:ObjectProperty ;
    rdfs:domain hpc:LsbTsjob ;
    rdfs:range hpc:Command ;
    rdfs:comment "The bsub -o out_file option is not supported for the tssub command." .

hpc:windowsbsuboptionsonly a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "Only Windows bsub options are supported for the tssub command." .

hpc:unsupportedoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Windowsbsuboptionsonly ;
    rdfs:range xsd:string ;
    rdfs:comment "For example, you cannot use the bsub options -Ip, -Is, -L login_shell with the tssub command." .

hpc:interactivebsuboptionsnotsupported a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "Interactive bsub options (-I, -Ip, -Is) are not supported by the tssub command on Linux." .

hpc:usermappingrequiresprivileges a owl:ObjectProperty ;
    rdfs:domain hpc:LsbTsjob ;
    rdfs:range hpc:User ;
    rdfs:comment "If user mapping is defined, the user who runs the tspeek command must have the required privileges to access the session." .

hpc:multiclusternotsupported a owl:ObjectProperty ;
    rdfs:domain hpc:LsfLogonDesktop ;
    rdfs:range hpc:Capability ;
    rdfs:comment "LSF multicluster capability is not supported." .

hpc:Command a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "The job can be specified by a command line, or through the standard input if the command is not present on the command line." .
