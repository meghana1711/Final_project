hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Queue a owl:Class .
hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobid .
hpc:jobcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:outputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:errorfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:emailnotification a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:jobsubmittedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobsubmittedwithcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:bsubqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range xsd:string .
hpc:bsuboutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range xsd:string .
hpc:bsuberror a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range xsd:string .
hpc:Homedirectory a owl:Class .
hpc:jobsubdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Homedirectory ;
    rdfs:range xsd:string .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Homedirectory .
hpc:useraccount a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
