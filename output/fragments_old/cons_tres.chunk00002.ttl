# Job
hpc:Job a owl:Class .
hpc:hasJobID a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:isRunning a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isQueued a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isPending a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasState a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasTime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
hpc:hasNodes a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:getNodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

# Node
hpc:Node a owl:Class .
hpc:hasNodeID a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:hasProcessorCount a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasCPU a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasIdleCPUs a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasAllocatedCPUs a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasNodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

# Resource
hpc:Resource
