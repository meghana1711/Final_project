@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:EGO_LOCAL_CONFDIR
    a owl:Class ;
    rdfs:subClassOf owl:String .

hpc:EGO_SERVERDIR
    a owl:Class ;
    rdfs:subClassOf owl:String .

hpc:EGO_TOP
    a owl:Class ;
    rdfs:subClassOf owl:String .

hpc:LSF_CONFDIR
    a owl:Class .

hpc:hasEGO_LOCAL_CONFDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:EgoLocalConfdir .

hpc:hasEGO_SERVERDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:EgoServerdir .

hpc:hasEGO_TOP
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:EgoTop .

hpc:Host
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf [ a owl:Class ;
                                          rdfs:subClassOf xsd:string ] ] .

hpc:hasOfficialIPAddress
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hasOfficialHostName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hasAliases
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
