hpc:Kerberosauthentication a owl:Class .
hpc:Unixhost a owl:Class .
hpc:Linuxhost a owl:Class .
hpc:Solaris a owl:Class .
hpc:Irix65 a owl:Class .
hpc:Linux2x a owl:Class .

hpc:Lsfmanagementcommand a owl:Class .
hpc:badmin a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:lsadmin a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:egosh a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:utmpreg a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:swtblApi a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:ntblApi a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:lstblNid a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .
hpc:swtblPoe a owl:ObjectProperty, rdfs:domain hpc:lsfmanagementcommand ;
    rdfs:range hpc:Executablefile .

hpc:Lsfconfiguration a owl:Class .
hpc:lsfAuth a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:string .
hpc:lsfAuthDaemon a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:integer .
hpc:lsbKrbTgtFwd a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:string .
hpc:lsbKrbTgtDir a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:string .
hpc:lsbKrbCheckInterval a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:integer .
hpc:lsbKrbRenewMargin a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:integer .
hpc:lsbKrbLibPath a owl:DatatypeProperty, rdfs:domain hpc:lsfconfiguration ;
    rdfs:range xsd:string .
hpc:LSB_EAUTH_EACH_SU
