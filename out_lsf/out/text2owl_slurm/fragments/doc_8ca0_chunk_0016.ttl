hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:Cloudnode a owl:Class .
hpc:Onpremisenode a owl:Class .
hpc:partitionname a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:nodename a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:sockets a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:corespersocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:threadspercore a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:weight a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:feature a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:state a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:maxtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:duration .
hpc:nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:default a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .
hpc:suspendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:suspendprogram a owl:ObjectProperty .
hpc:resumeprogram a owl:ObjectProperty .
hpc:treewidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Selecttypeparameters ;
    rdfs:range xsd:nonNegativeInteger .
hpc:selecttype a owl:ObjectProperty .
hpc:Selecttypeparameters a owl:Class .
hpc:crCoreMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Selecttypeparameters ;
    rdfs:range xsd:string .
