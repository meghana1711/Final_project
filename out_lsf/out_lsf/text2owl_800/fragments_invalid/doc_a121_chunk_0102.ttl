hpc:Apsvalue a owl:Class .
hpc:Currentresourcereservationpolicy a owl:Class .
hpc:Preemption a owl:Class .
hpc:Queuepolicy a owl:Class .
hpc:Chunkjob a owl:Class .
hpc:submittinguser a owl:ObjectProperty .
hpc:resourcerequirements a owl:ObjectProperty .
hpc:hostrequirements a owl:ObjectProperty .
hpc:queueorapplicationprofile a owl:ObjectProperty .
hpc:jobpriority a owl:ObjectProperty .
hpc:backfillscheduling a owl:ObjectProperty .
hpc:Advancereservation a owl:Class .
hpc:Resizablejob a owl:Class .
hpc:Originaljob a owl:Class .
hpc:Subsequentcalculation a owl:Class .
hpc:Factor a owl:Class .
