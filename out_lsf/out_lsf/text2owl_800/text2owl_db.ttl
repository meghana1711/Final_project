hpc:LsfConfiguration a owl:Class .
hpc:libConntimeout a owl:DatatypeProperty .
hpc:libRecvtimeout a owl:DatatypeProperty .
hpc:lmRemoveByHandle a owl:ObjectProperty .
hpc:lmRemoveInterval a owl:DatatypeProperty .

hpc:LibConntimeout rdfs:domain hpc:LsfConfiguration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies a timeout value in seconds for communication between LSF License Scheduler and LSF APIs. LIB_CONNTIMEOUT=0 indicates no timeout. Used for both project mode and cluster mode. Default 5 seconds." .

hpc:LibRecvtimeout rdfs:domain hpc:LsfConfiguration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies a timeout value in seconds for communication between LSF License Scheduler and LSF. LIB_RECVTIMEOUT=0 indicates no timeout. Used for both project mode and cluster mode. Default 5 seconds." .

hpc:LmRemoveByHandle rdfs:domain hpc:LsfConfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "Applicable to FlexNet only. Enables LSF License Scheduler to use the handle that is included in the license usage information instead of the display (tty) information while calling lmremove to remove license features from each recently-suspended job. LSF License Scheduler still uses the display (tty) information while calling the lmremove command if the license usage information does not include a handle, even if the LM_REMOVE_BY_HANDLE parameter is defined as Y." .

hpc:LmRemoveInterval rdfs:domain hpc:LsfConfiguration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the minimum time a job must have a license checked out before lmremove (for FlexNet) or rlmremove (for Reprise License Manager) can remove the license (using preemption). lmremove or rlmremove causes the license manager daemon and vendor daemons to close the TCP connection with the application. LSF License Scheduler only considers preempting a job after this interval has elapsed. When using lmremove or rlmremove as part of the preemption action (LM_REMOVE_SUSP_JOBS), define LM_REMOVE_INTERVAL=0 to ensure that LSF License Scheduler can preempt a job immediately after checkout. After suspending the job, LSF License Scheduler then uses lmremove or rlmremove to release licenses from the job. Used for both project mode and cluster mode." .

# Fragment: doc_8a80_chunk_0011.ttl
hpc:Lsflicensescheduler a owl:Class .
hpc:lmRemoveSuspJobs a owl:ObjectProperty .
hpc:lmRemoveSuspJobsInterval a owl:ObjectProperty .

hpc:LSFLicenseScheduler
  rdfs:subClassOf [ a owl:Class ;
                    rdfs:subClassOf owl:NamedIndividual ] .

hpc:LM_REMOVE_SUSP_JOBS
  rdfs:domain hpc:Lsflicensescheduler ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:comment "Enables LSF License Scheduler to use lmremove (for FlexNet) or rlmremove (for Reprise License Manager) to remove license features from each recently-suspended job." .

hpc:LM_REMOVE_SUSP_JOBS_INTERVAL
  rdfs:domain hpc:Lsflicensescheduler ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:comment "Specifies the minimum length of time between subsequent child processes that LSF License Scheduler forks to run lmremove (for FlexNet) or rlmremove (for Reprise License Manager) every time it receives an update from a license collector daemon (blcollect)." .

# Fragment: doc_8a80_chunk_0013.ttl
hpc:LsfLicenseSchedulerConfig a owl:Class .
hpc:lmStatInterval a owl:DatatypeProperty .
hpc:LmStatInterval rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Deﬁnes a time interval between calls that LSF License Scheduler makes to collect license usage information from the license manager. Default 60 seconds" .

hpc:lmStatPerFeature a owl:ObjectProperty .
hpc:LmStatPerFeature rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Starting in Fix Pack 15, controls how the blcollect (license collector daemon) command retrieves license usage data from FlexNet license servers. When LM_STAT_PER_FEATURE is set to Y, the blcollect command retrieves usage data for individual licenses from the license server using the lmstat or lmutil -f commands, rather than retrieving data for all features using lmstat or lmutil -a commands. If LM_STAT_PER_FEATURE is set to N, or is not deﬁned, the blcollect command retrieves data for all features by calling the lmstat or lmutil -a commands. LM_STAT_PER_FEATURE only takes effect when the LM_TYPE value is set to FLEXLM. If the LM_TYPE value is set to RLM, then the LM_STAT_PER_FEATURE parameter will be ignored. Conﬁgure the LM_STAT_PER_FEATURE parameter to allow LSF License Scheduler to manage a small set of licenses from a license server that handles hundreds or thousands of licenses. Implementing this parameter may enhance blcollect's data collection capabilities. However, do not use this when LSF License Scheduler manages the bulk of licenses from the license server. Default" .

hpc:lmStatTimeout a owl:DatatypeProperty .
hpc:LmStatTimeout rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Sets the timeout value passed to the lmutil lmstat, lmstat, rlmutil rlmstat, or rlmstat command." .

