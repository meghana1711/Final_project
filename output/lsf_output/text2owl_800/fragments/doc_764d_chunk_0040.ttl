hpc:Job a owl:Class .
hpc:Receivejobsqueue a owl:Class .
hpc:Sendjobsqueue a owl:Class .
hpc:Executioncluster a owl:Class .
hpc:Submissioncluster a owl:Class .
hpc:jobrerun a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:sortbysubmittime a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Job .
hpc:jobmigration a owl:ObjectProperty .
hpc:checkpoint a owl:ObjectProperty ;
    rdfs:domain hpc:Multiclusterjob ;
    rdfs:range xsd:boolean .
hpc:absolutepriorityscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:strictresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:computeunitrequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Rerunnablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Checkpointablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Multiclusterjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:userspecifiedjobmigration a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
