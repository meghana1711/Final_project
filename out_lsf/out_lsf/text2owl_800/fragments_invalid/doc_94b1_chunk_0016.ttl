hpc:Yes a owl:Class .
hpc:closed_Adm rdf:type owl:Class .
hpc:closed_Busy rdf:type owl:Class .
hpc:closed_Lock rdf:type owl:Class .
hpc:closed_Wind rdf:type owl:Class .
hpc:closed_Full rdf:type owl:Class .
hpc:closed_Excl rdf:type owl:Class .
hpc:closed_LIM rdf:type owl:Class .
hpc:unavailable rdf:type owl:Class .
hpc:unreach rdf:type owl:Class .
hpc:closed_EGO rdf:type owl:Class .

hpc:powerSavedMode rdf:type owl:Class .
hpc:host rdf:type owl:Class .
hpc:cannotEnterPowerSavedMode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Powersavedmode .

hpc:powerOnStatus rdf:type owl:Class .
hpc:mustBeInPowerOnStatus rdf:type owl:ObjectProperty ;
    rdfs:domain (hpc:Poweroperationfeature | hpc:Resourcedefinition) ;
    rdfs:range hpc:Poweronstatus .

hpc:powerOperationFeature rdf:type owl:Class .
hpc:cannotDisable rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Poweroperationfeature ;
    rdfs:range hpc:Poweronstatus .

hpc:lsf_shared rdf:type owl:Class .
hpc:lsf_cluster rdf:type owl:Class .
hpc:mustBeInPowerOnStatusForChange rdf:type owl:ObjectProperty ;
    rdfs:domain (hpc:LsfShared | hpc:LsfCluster) ;
    rdfs:range hpc:Poweronstatus .

hpc:AdvanceReservation rdf:type owl:Class .
hpc:takesPrecedence rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Powerpolicy .

hpc:powerSavedModeResume rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Host .

hpc:manualPowerOperations rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Poweroperation .

hpc:systemAR rdf:type owl:Class .
hpc:doesNotAssumePowerSavedMode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Systemar ;
    rdfs:range hpc:Powerpolicy .

hpc:powerSavedModeBreaksCYCLE_TIME rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Powersavedmode ;
    rdfs:range xsd:boolean .
