@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:jobid a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:partition a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:name a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:user a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:st a owl:DatatypeProperty;
    rdfs
