hpc:Node a owl:Class .
hpc:Feature a owl:Class .
hpc:Helper a owl:Class .
hpc:State a owl:Class .
hpc:Selecttype a owl:Class .
hpc:Selecttypeparameters a owl:Class .
hpc:suspendprogram a owl:ObjectProperty .
hpc:resumeprogram a owl:ObjectProperty .
hpc:suspendtime a owl:DatatypeProperty .
hpc:suspendexcnodes a owl:ObjectProperty .
hpc:treewidth a owl:DatatypeProperty .
hpc:nodename a owl:DatatypeProperty .
hpc:sockets a owl:DatatypeProperty .
hpc:corespersocket a owl:DatatypeProperty .
hpc:threadspercore a owl:DatatypeProperty .
hpc:weight a owl:DatatypeProperty .
hpc:Feature rdfs:domain hpc:Node ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasFeature .
hpc:Helper rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:State rdfs:domain hpc:Node .
hpc:Selecttype rdfs:domain hpc:Partition .
hpc:Selecttypeparameters rdfs:domain hpc:Selecttype .
hpc:Suspendprogram rdfs:domain hpc:Partition .
hpc:Resumeprogram rdfs:domain hpc:Partition .
hpc:Suspendtime rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Suspendexcnodes rdfs:domain hpc:Partition .
hpc:Treewidth rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Nodename rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:Sockets rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Corespersocket rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Threadspercore rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Weight rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
