hpc:Enrootcontainerjob a owl:Class .
hpc:starter a owl:ObjectProperty ;
    rdfs:domain hpc:Enrootcontainerjob ;
    rdfs:range xsd:string .
hpc:serverdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Starter ;
    rdfs:range xsd:string .
hpc:user a owl:NamedIndividual ;
    hpc:serverdir "/path/to/serverdir/enroot-starter.py" .
hpc:GpuReq a owl:Class .
hpc:gvendor a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuReq ;
    rdfs:range xsd:string .
hpc:nvlink a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuReq ;
    rdfs:range xsd:string .
hpc:glink a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuReq ;
    rdfs:range xsd:string .
hpc:ChunkJobSize a owl:Class .
hpc:NetworkReq a owl:Class .
hpc:podmanversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmanversion ;
    rdfs:range xsd:string .
hpc:container a owl:ObjectProperty ;
    rdfs:domain hpc:Podmanversion ;
    rdfs:range hpc:Podmanconfiguration .
hpc:execDriver a owl:DatatypeProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:controller a owl:ObjectProperty ;
    rdfs:domain hpc:Podmanconfiguration ;
    rdfs:range xsd:string .
