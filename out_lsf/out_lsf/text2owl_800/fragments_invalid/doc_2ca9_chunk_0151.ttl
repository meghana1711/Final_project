hpc:Resourceprovisioningpolicy a owl:Class .
hpc:policy_configFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourceprovisioningpolicy ;
    rdfs:range hpc:File .

# Host Providers
hpc:Hostprovider a owl:Class .

# Resource Units
hpc:Resourceunit a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:ZB rdf:type hpc:ResourceUnit ;
    rdfs:label "ZB" .
hpc:KB rdf:type hpc:ResourceUnit ;
    rdfs:label "KB" .
hpc:MB rdf:type hpc:ResourceUnit ;
    rdfs:label "MB" .
hpc:GB rdf:type hpc:ResourceUnit ;
    rdfs:label "GB" .
hpc:TB rdf:type hpc:ResourceUnit ;
    rdfs:label "TB" .
hpc:PB rdf:type hpc:ResourceUnit ;
    rdfs:label "PB" .
hpc:EB rdf:type hpc:ResourceUnit ;
    rdfs:label "EB" .

# LSF Parameters
hpc:Lsfparameter a owl:Class .
hpc:LSF_UNIT_FOR_LIMITS rdf:type hpc:LSFParameter ;
    rdfs:label "LSF_UNIT_FOR_LIMITS" .
hpc:LSF_ENABLE_TMP_UNIT rdf:type hpc:LSFParameter ;
    rdfs:label "LSF_ENABLE_TMP_UNIT" .

# Resource Requirements and Limits
hpc:Resourcerequirement a owl:Class .
hpc:Resourcelimit a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .
hpc:mem rdf:type hpc:ResourceRequirement ;
    rdfs:label "mem" .
hpc:swp rdf:type hpc:ResourceRequirement ;
    rdfs:label "swp" .
hpc:tmp rdf:type hpc:ResourceRequirement ;
    rdfs:label "tmp" .
hpc:hasUnit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourceunit .

# Command Output Formatting
hpc:Commandoutputformatting a owl:Class .
hpc:hostInfoOutputFormat rdf:type hpc:CommandOutputFormatting ;
    rdfs:label "hostInfoOutputFormat" .
hpc:queueInfoOutputFormat rdf:type hpc:CommandOutputFormatting ;
    rdfs:label "queueInfoOutputFormat" .

# Customizing Output
hpc:Customizedoutput a owl:Class .
hpc:customizeHostInfoOutput rdf:type hpc:CustomizedOutput ;
    rdfs:label "customizeHostInfoOutput" .
hpc:customizeQueueInfoOutput rdf:type hpc:CustomizedOutput ;
    rdfs:label "customizeQueueInfoOutput" .

# Command Options
hpc:Commandoption a owl:Class .
hpc:bjobs_o rdf:type hpc:
