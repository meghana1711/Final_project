hpc:Function a owl:Class .
hpc:hasTimeoutValue rdf:Type xsd:integer ;
    rdfs:domain hpc:Function .

hpc:BurstBuffer a owl:Class .
hpc:callsFunction rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range hpc:Function .

hpc:SignalHandler a owl:Class .
hpc:isCalledFromSlurmctld rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:SignalHandler .

hpc:BurstBufferResourcePool a owl:Class .
hpc:hasSpace rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBufferResourcePool .

hpc:Job a owl:Class .
hpc:requestsSpace rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:PoolSpace a owl:DatatypeProperty ;
    rdfs:domain hpc:BurstBufferResourcePool ;
    rdfs:range xsd:decimal .

hpc:DefaultPool rdf:Type hpc:BurstBufferResourcePool .

hpc:Datawarp a owl:Class .
hpc:definesPool rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Datawarp .

hpc:LuaPlugin a owl:Class .
hpc:hasOptionalPool rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:LuaPlugin .
```
