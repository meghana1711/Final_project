hpc:APIResponse a owl:Class .
hpc:APIResponse rdfs:subClassOf owl:Thing .

hpc:QueryParameters a owl:Class .
hpc:QueryParameters rdfs:subClassOf owl:Thing .

hpc:UsageEnd a owl:DatatypeProperty ;
    rdfs:domain hpc:APIResponse ;
    rdfs:range xsd:xsd:int .

hpc:UsageStart a owl:DatatypeProperty ;
    rdfs:domain hpc:APIResponse ;
    rdfs:range xsd:xsd:int .

hpc:WithDeleted a owl:ObjectProperty ;
    rdfs:domain hpc:APIResponse ;
    rdfs:range hpc:APIResponse .

hpc:WithUsage a owl:ObjectProperty ;
    rdfs:domain hpc:APIResponse ;
    rdfs:range hpc:APIResponse .

hpc:Clusters a owl:Class .
hpc:Clusters rdfs:subClassOf hpc:APIResponse .

hpc:ListOfClusters a owl:Class .
hpc:ListOfClusters rdfs:subClassOf hpc:APIResponse .

hpc:SlurmdbdConfig a owl:Class .
hpc:SlurmdbdConfig rdfs:subClassOf hpc:APIResponse .

hpc:SlurmdbdStats a owl:Class .
hpc:SlurmdbdStats rdfs:subClassOf hpc:APIResponse .

hpc:InstanceInfo a owl:Class .
