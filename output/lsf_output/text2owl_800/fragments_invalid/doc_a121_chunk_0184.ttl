hpc:Validatingjobsubmission a owl:Class .
hpc:Modifyingjobsubmission a owl:Class .
hpc:Monitoringexecution a owl:Class .

# Job submission properties
hpc:projectname a owl:ObjectProperty ;
    rdfs:domain hpc:Validatingjobsubmission ;
    rdfs:range xsd:string .

hpc:username a owl:ObjectProperty ;
    rdfs:domain hpc:Modifyingjobsubmission ;
    rdfs:range xsd:string .

hpc:queuename a owl:ObjectProperty ;
    rdfs:domain hpc:Modifyingjobsubmission ;
    rdfs:range xsd:string .

hpc:shellname a owl:ObjectProperty ;
    rdfs:domain hpc:Modifyingjobsubmission ;
    rdfs:range xsd:string .

hpc:allowedprojects a owl:ObjectProperty ;
    rdfs:domain hpc:Validatingjobsubmission ;
    rdfs:range rdf:List .

hpc:allowedusers a owl:ObjectProperty ;
    rdfs:domain hpc:Validatingjobsubmission ;
    rdfs:range rdf:List .

# Job execution properties
hpc:executionenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Monitoringexecution ;
    rdfs:range xsd:string .

# Subclass relations
hpc:ValidatingJobSubmission a hpc:JobSubmissionControl ;
hpc:ModifyingJobSubmission a hpc:JobSubmissionControl ;
hpc:MonitoringExecution a hpc:JobExecutionControl .

# Data type restrictions
hpc:allowedProjects rdfs:subPropertyOf hpc:projectName ;
    rdfs:range rdf:List ;
    rdfs:range rdf:List ;
    rdfs:range xsd:string ;
    rdfs:range xsd:string .

hpc:allowedUsers rdfs:subPropertyOf hpc:userName ;
    rdfs:range rdf:List ;
    rdfs:range rdf:List ;
    rdfs:range xsd:string ;
    rdfs:range xsd:string .
