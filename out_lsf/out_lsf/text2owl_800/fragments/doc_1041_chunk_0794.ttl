hpc:Hostoperationmode a owl:Class .
hpc:hostfileoption a owl:ObjectProperty ;
    rdfs:domain hpc:Hostoperationmode ;
    rdfs:range hpc:Hostfile .

hpc:hostnameoption a owl:ObjectProperty ;
    rdfs:domain hpc:Hostoperationmode ;
    rdfs:range xsd:string .

hpc:numprocessorsoption a owl:ObjectProperty ;
    rdfs:domain hpc:Hostoperationmode ;
    rdfs:range xsd:nonNegativeInteger .

hpc:mutuallyexclusiveoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Hostoperationmode ;
    rdfs:range hpc:Hostoperationmode .

hpc:lsfugrouptransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Hostoperationmode ;
    rdfs:range xsd:boolean .

hpc:Interactiveoperationmode a owl:Class ;
    rdfs:subClassOf hpc:Hostoperationmode .

hpc:Parallelrunmode a owl:Class ;
    rdfs:subClassOf hpc:Hostoperationmode .

hpc:Pseudoterminal a owl:Class ;
    rdfs:subClassOf hpc:Hostoperationmode .

hpc:Shellmode a owl:Class ;
    rdfs:subClassOf hpc:Pseudoterminal .

hpc:windowssupport a owl:ObjectProperty ;
    rdfs:domain hpc:Pseudoterminal ;
    rdfs:range xsd:boolean .

hpc:faststartup a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelrunmode ;
    rdfs:range xsd:boolean .

hpc:arbitraryoutputorder a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelrunmode ;
    rdfs:range xsd:boolean .

hpc:pseudoterminalttysupport a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelrunmode ;
    rdfs:range xsd:boolean .

hpc:ignorepoption a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelrunmode ;
    rdfs:range xsd:boolean .

hpc:Unixhost a owl:Class .
hpc:Linuxhost a owl:Class ;
    rdfs:subClassOf hpc:Unixhost .

hpc:vicommand a owl:ObjectProperty ;
    rdfs:domain hpc:Pseudoterminal ;
    rdfs:range xsd:string .

hpc:jove a owl:ObjectProperty ;
    rdfs:domain hpc:Shellmode ;
    rdfs:range xsd:string .

hpc:shellmodesupport a owl:ObjectProperty ;
    rdfs:domain hpc:Shellmode ;
    rdfs:range xsd:boolean .

hpc:windowssupport a owl:ObjectProperty ;
    rdfs:domain hpc:Pseudoterminal ;
    rdfs:range xsd:boolean .
