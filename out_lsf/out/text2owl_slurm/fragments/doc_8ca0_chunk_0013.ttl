hpc:Slurmctld a owl:Class .
hpc:gracefultermination a owl:ObjectProperty .
hpc:Gracefultermination rdfs:domain hpc:Slurmctld ;
                          rdfs:range xsd:decimal .
hpc:Gracefulterminationtime rdfs:range xsd:decimal .
hpc:Suspendtimeout rdfs:range xsd:decimal .
hpc:Resumetimeout rdfs:range xsd:decimal .
hpc:Suspendprogram a owl:Class .
hpc:Resumeprogram a owl:Class .
hpc:slurmResumeFile a owl:DatatypeProperty .
hpc:SlurmResumeFile rdfs:domain hpc:Resumeprogram ;
                          rdfs:range xsd:anyURI .
hpc:bootdifferentimages a owl:ObjectProperty .
hpc:Bootdifferentimages rdfs:domain hpc:Resumeprogram .
hpc:jobassociation a owl:ObjectProperty .
hpc:Jobassociation rdfs:domain hpc:Resumeprogram ;
                      rdfs:range hpc:Job .
hpc:nodefeatureplugins a owl:ObjectProperty .
hpc:Nodefeatureplugins rdfs:domain hpc:Resumeprogram .
hpc:imagemapping a owl:ObjectProperty .
hpc:Imagemapping rdfs:domain hpc:Nodefeatureplugins ;
                    rdfs:range hpc:Image .
hpc:Resourceallocation a owl:Class .
hpc:resourceallocationrequest a owl:ObjectProperty .
hpc:Resourceallocationrequest rdfs:domain hpc:Resourceallocation ;
                               rdfs:range hpc:Resource .
hpc:nodesavailabilitywarning a owl:ObjectProperty .
hpc:Nodesavailabilitywarning rdfs:domain hpc:Resourceallocation .
