hpc:Host a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdf:Resource ] .

hpc:hasHostName an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hostType an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hostModel an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:cpuFactor an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:numCPUs an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:totalMemory an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:totalSwapSpace an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:isServerHost an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:staticResources an owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:localCluster an owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:equivalentRemoteCluster an owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:jobForwardingModel an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:resourceLeasingModel an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:dynamicCluster an owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:jobvm an owl:ObjectProperty ;
    rdfs:domain hpc:Dynamiccluster ;
    rdfs:range xsd:string .

hpc:dchost an owl:ObjectProperty ;
    rdfs:domain hpc:Dynamiccluster ;
    rdfs:range xsd:string .

hpc:gpuTopology an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:customizedOutput an owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:jsonFormat an owl:ObjectProperty ;
    rdfs:domain hpc:Customizedoutput ;
    rdfs:range xsd:string .

hpc:lshostsCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Customizedoutput ;
    rdfs:range xsd:string .

hpc:staticResourcesProperty an o
