hpc:Yes a owl:Class .
hpc:No a owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Yes ;
    rdfs:subClassOf hpc:No ;
    rdfs:domain hpc:Job .

hpc:gpuusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:pendingrequests a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Yes .

hpc:block a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Yes .

hpc:gpack a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Yes .

hpc:gvendor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:gmodel a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:gmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
