hpc:LSF_INTELLIGENT_CPU_BIND
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Takes precedence over other CPU binding parameters." .

hpc:ignores
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfIntelligentCpuBind ;
    rdfs:range rdf:List ;
    rdfs:comment "LSF ignores the following parameters:" .

hpc:EGO_DAEMONS_CPUS
    a rdf:List ;
    rdf:first hpc:EGO_DAEMONS_CPUS .

hpc:ESTIMATOR_CPUS
    a rdf:List ;
    rdfs:first hpc:ESTIMATOR_CPUS .

hpc:LSF_DAEMONS_CPUS
    a rdf:List ;
    rdfs:first hpc:LSF_DAEMONS_CPUS .

hpc:MBD_QUERY_CPUS
    a rdf:List ;
    rdfs:first hpc:MBD_QUERY_CPUS .

hpc:hasMinimumCores
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfIntelligentCpuBind ;
    rdfs:range xsd:integer ;
    rdfs:comment "Because this feature binds LSF daemons to eight CPU cores, the LSF_INTELLIGENT_CPU_BIND parameter is ignored if the management and management candidate hosts have fewer than eight CPU cores." .

hpc:LSF_QUERY_ES_SERVERS
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfExplorer .

hpc:LSF_QUERY_ES_FUNCTIONS
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfExplorer .

hpc:LSF_EXPLORER
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Used to improve the performance of the bacct and bhist commands, or to retrieve additional data." .

hpc:improvesPerformance
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfExplorer ;
    rdfs:range rdf:List ;
    rdfs:comment "Improves the performance of the bacct and bhist commands by avoiding the need for parsing large log files whenever you run these commands." .

hpc:integrates
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfExplorer ;
    rdfs:range rdf:List ;
    rdfs:comment "Can integrate LSF Explorer energy accounting into LSF." .

hpc:collectsEnergyData
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfExplorer ;
    rdfs:range rdf:List ;
    rdfs:comment "LSF uses LSF Explorer to collect energy data from each host by the LSF Beats services (lsfbeat tool)." .

hpc:
