hpc:Project a owl:Class .
hpc:Task a owl:Class .
hpc:Licensetoken a owl:Class .
hpc:connecttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:effectiveproject a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Project .
hpc:licenseproject a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Licensetoken .
hpc:outputforloption a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:terminal a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:pgid a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:integer .
hpc:cpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:keyboardidlesince a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:resreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:waitstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .
