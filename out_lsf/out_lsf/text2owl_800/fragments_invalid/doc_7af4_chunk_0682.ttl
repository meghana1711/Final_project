hpc:LsbDebugSch a owl:Class ;
   rdfs:subClassOf hpc:Configurationparameter .

hpc:LsbDockerPassEnv a owl:Class ;
   rdfs:subClassOf hpc:Configurationparameter .

hpc:LsbDisableLimlockExcl a owl:Class ;
   rdfs:subClassOf hpc:Configurationparameter .

# Object Properties
hpc:hasvalue a owl:ObjectProperty ;
   rdfs:domain hpc:Configurationparameter ;
   rdfs:range xsd:string .

# Datatype Properties
hpc:logClass rdf:type owl:DatatypeProperty ;
   rdfs:domain hpc:LsbDebugSch .

hpc:value rdf:type owl:DatatypeProperty ;
   rdfs:domain hpc:LsbDockerPassEnv ;
   rdfs:domain hpc:LsbDisableLimlockExcl .


This ontology defines three classes for LSB configuration parameters: `LSB_DEBUG_SCH`, `LSB_DOCKER_PASS_ENV`, and `LSB_DISABLE_LIMLOCK_EXCL`. It also defines two datatype properties: `logClass` for `LSB_DEBUG_SCH` and `value` for all three classes. The `value` property is used to specify the value of the configuration parameter.
