hpc:Checkpointdirectory a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The file path of the checkpoint directory." .

hpc:filesizelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the maximum number of characters for the file path." .

hpc:initialcheckpointperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the initial checkpoint period in minutes." .

hpc:checkpointperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the checkpoint period for the application in minutes." .

hpc:isset a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the checkpoint period is set or not." .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The application profile that contains the checkpoint settings." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The job that is being checkpointed." .
