hpc:Lsfadministrator a owl:Class .
hpc:Primarylsfadministrator a owl:Class .
hpc:clusterwideoperation a owl:ObjectProperty .
hpc:lsfconfigurationfile a owl:ObjectProperty .
hpc:Lsfuserdomain a owl:Class .
hpc:Globaladmins a owl:Class .
hpc:Localadmins a owl:Class .
hpc:Powerusers a owl:Class .
hpc:Domainadmin a owl:Class .
hpc:Workgroupadmin a owl:Class .
hpc:Compatibility a owl:Class .
hpc:clustermanager a owl:ObjectProperty, rdfs:subPropertyOf hpc:clusteradmins .
hpc:manager a owl:ObjectProperty, rdfs:subPropertyOf hpc:clusteradmins .
hpc:clusteradmins a owl:ObjectProperty .
hpc:Lsfcluster a owl:Class .
hpc:AdministratorList a rdfs:DatatypeProperty .
hpc:Host a owl:Class .

hpc:Clusterwideoperation rdfs:domain hpc:Lsfadministrator ;
    rdfs:range rdf:Resource .

hpc:Lsfconfigurationfile rdfs:domain hpc:Primarylsfadministrator ;
    rdfs:range rdf:Resource .

hpc:Lsfuserdomain rdfs:subClassOf rdf:Resource .

hpc:Globaladmins rdfs:subClassOf hpc:Lsfadministrator ;
    rdfs:subClassOf hpc:Powerusers .

hpc:Localadmins rdfs:subClassOf rdf:Resource .

hpc:Powerusers rdfs:subClassOf rdf:Resource .

hpc:Domainadmin rdfs:subClassOf hpc:Powerusers .

hpc:Workgroupadmin rdfs:subClassOf rdf:Resource .

hpc:Compatibility rdfs:subClassOf rdf:Resource .

hpc:Clustermanager rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .

hpc:Manager rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .

hpc:Clusteradmins rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:List .

hpc:Administratorlist rdfs:range rdf:List .

hpc:Host rdfs:subClassOf rdf:Resource .
