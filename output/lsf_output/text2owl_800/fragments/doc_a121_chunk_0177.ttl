hpc:LsbSub4PendTimeLimit a owl:Class .
hpc:LsbSubNotifyBegin a owl:Class .
hpc:LsbSubNotifyEnd a owl:Class .
hpc:lsbSubNumProcessors a owl:DatatypeProperty .
hpc:LsbSubOtherFiles a owl:Class .
hpc:lsbSubOtherFilesNumber a owl:DatatypeProperty .
hpc:lsbSubOtherFilesFilePath a owl:DatatypeProperty .
hpc:lsbSubOtherFilesSpecifiedBy a owl:ObjectProperty .
hpc:LsbSubOtherFilesReset a owl:Class .
hpc:LsbSub4OutDir a owl:Class .
hpc:lsbSubOutFile a owl:DatatypeProperty .
hpc:lsbSubPreExec a owl:ObjectProperty .
hpc:LsbSubOutDir rdfs:domain hpc:LsbSub4OutDir ;
    rdfs:range xsd:string .
hpc:LsbSubOutFile rdfs:domain hpc:LsbSub4OutDir ;
    rdfs:range xsd:string .
hpc:LsbSubNumProcessors rdfs:domain hpc:LsbSubPendTimeLimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LsbSubOtherFilesSpecifiedBy rdfs:domain hpc:LsbSubOtherFiles ;
    rdfs:range hpc:LsbSubOtherFiles .
hpc:LsbSubOtherFilesReset rdfs:subClassOf hpc:LsbSubOtherFiles ;
    rdfs:comment "Indicates the number of files to be transferred. The value is SUB_RESET if bmod is being used to reset the number of files to be transferred." .
