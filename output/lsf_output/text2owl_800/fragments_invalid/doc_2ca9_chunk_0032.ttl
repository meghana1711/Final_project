hpc:Fixpack13 a owl:Class .
hpc:hasdefaultvaluefor a owl:ObjectProperty .

hpc:LsfGpuAutoconfig hpc:hasdefaultvaluefor hpc:FixPack13 ;
    rdfs:domain hpc:Fixpack13 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSF_GPU_AUTOCONFIG parameter." .

hpc:LsbGpuNewSyntax hpc:hasdefaultvaluefor hpc:FixPack13 ;
    rdfs:domain hpc:Fixpack13 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSB_GPU_NEW_SYNTAX parameter." .

hpc:LsfGpuResourceIgnore hpc:hasdefaultvaluefor hpc:FixPack13 ;
    rdfs:domain hpc:Fixpack13 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSF_GPU_RESOURCE_IGNORE parameter." .

hpc:lsfGpuAutoconfigOlddefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Fixpack12 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSF_GPU_AUTOCONFIG parameter in Fix Pack 12 or earlier." .

hpc:lsbGpuNewSyntaxOlddefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Fixpack12 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSB_GPU_NEW_SYNTAX parameter in Fix Pack 12 or earlier." .

hpc:lsfGpuResourceIgnoreOlddefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Fixpack12 ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value for LSF_GPU_RESOURCE_IGNORE parameter in Fix Pack 12 or earlier." .

hpc:Podmansupport a owl:Class .
hpc:supportsversion a owl:ObjectProperty .

hpc:Podmanversion331 hpc:supportsversion hpc:PodmanSupport ;
    rdfs:domain hpc:Podmansupport ;
    rdfs:range xsd:string ;
    rdfs:comment "Version of Podman supported by LSF." .

hpc:Apptainersupport a owl:Class .
hpc:acceptscontainername a owl:ObjectProperty .

hpc:Singularitycontainer hpc:acceptscontainername hpc:ApptainerSupport ;
    rdfs:domain hpc:Apptainersupport ;
    rdfs:range xsd:string ;
    rdfs:comment "Container name accepted by LSF when using Apptainer." .

