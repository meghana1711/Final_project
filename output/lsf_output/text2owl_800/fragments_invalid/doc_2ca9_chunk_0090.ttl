hpc:decay a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:decimal .

hpc:Reservationresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationresourcerequirement ;
    rdfs:range hpc:Rusagetype .

hpc:Rusagetype a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf hpc:Resourcerequirementtype .

hpc:rusagetype/mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusagetype ;
    rdfs:range xsd:decimal .

hpc:rusagetype/task:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusagetype ;
    rdfs:range xsd:decimal .

hpc:rusagetype/task:decay a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusagetype ;
    rdfs:range xsd:decimal .

# GPU Requirements
hpc:numgpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Gpurequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:gpurequirement/task:mode a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:gpurequirement/task:j_exclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:boolean .

# Job Striping
hpc:span a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Spantype .

hpc:Spantype a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf hpc:Resourcerequirementtype .

hpc:spantype/stripe a owl:DatatypeProperty ;
    rdfs:domain hpc:Spantype ;
    rdfs:range xsd:nonNegativeInteger .

# Email Notification
hpc:jobexitstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:lsbJobReportMail a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbconfiguration ;
    rdfs:range xsd:string .

hpc:Lsbconfiguration a owl:Class .

hpc:Job a owl:Class .
