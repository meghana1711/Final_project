hpc:notoperator a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range hpc:Usergrouporuser .

hpc:alloperator a owl:ObjectProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range hpc:Usergrouporuser .

hpc:Usergrouporuser a owl:Class .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Usergrouporuser .
hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Usergrouporuser .

hpc:Queuedefinition a owl:Class .
hpc:users a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .

hpc:Automatictimebasedconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Queuedefinition .
hpc:Variableconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Automatictimebasedconfiguration .
hpc:ifelseconstruct a owl:ObjectProperty ;
    rdfs:domain hpc:Variableconfiguration .
hpc:timeexpression a owl:DatatypeProperty ;
    rdfs:domain hpc:Ifelseconstruct .

hpc:Pendingreasonmessage a owl:Class .
hpc:lsbreasons a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuedefinition ;
    rdfs:range xsd:string .
