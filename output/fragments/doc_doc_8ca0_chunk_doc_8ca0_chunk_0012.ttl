hpc:SlurmUser rdf:type owl:Class .
hpc:SlurmDaemon rdf:type owl:Class .
hpc:Node rdf:type owl:Class .
hpc:SuspendProgram a owl:Class ;
    rdfs:subClassOf hpc:Program .
hpc:ResumeProgram a owl:Class ;
    rdfs:subClassOf hpc:Program .
hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SuspendProgram ;
    rdfs:range hpc:Node .
hpc:hasLogFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Program .
hpc:Program rdf:type owl:Class .
hpc:FaultTolerant rdf:type owl:Class .
hpc:SuspendTimeout a xsd:nonNegativeInteger .
hpc:ResumeTimeout a xsd:nonNegativeInteger .
hpc:Program rdfs:subClassOf hpc:FaultTolerant .
