hpc:Job a owl:Class .
hpc:MCSLabel a owl:Class .
hpc:Plugin a owl:Class .

hpc:hasMCSLabel a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:MCSLabel .

hpc:usesPlugin a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:MCSParameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:Plugin_none a hpc:Plugin ;
    rdfs:label "none" .

hpc:Plugin_account a hpc:Plugin ;
    rdfs:label "account" .

hpc:Plugin_group a hpc:Plugin ;
    rdfs:label "group" .

hpc:Plugin_user a hpc:Plugin ;
    rdfs:label "user" .

hpc:Plugin_label a hpc:Plugin ;
    rdfs:label "label" .

hpc:Job_with_Exclusive_MCS a hpc:Job ;
    rdfs:subClassOf [
        a owl:Class ;
        rdfs:label "Job with exclusive MCS" ;
        rdfs:subClassOf (hpc:Job [ hpc:hasMCSLabel some (hpc:MCSLabel [ rdf:value ?label ] ) ]) ;
        rdfs:subClassOf (hpc:Job [
            filter (exists (hpc:hasMCSLabel ?jobLabel) (hpc:hasMCSLabel ?job ?jobLabel) (hpc:MCSParameters ?job "enforced") (hpc:select ?job true)) ;
            rdfs:subClassOf (hpc:Job [
                filter (not exists (hpc:hasMCSLabel ?otherJob ?label)) (hpc:hasMCSLabel ?otherJob ?otherLabel) (hpc:Job ?otherJob)
            ])
        ])
    ] .
```
