hpc:Threshold a owl:Class .
hpc:haslowerbound a owl:DatatypeProperty ;
    rdfs:domain hpc:Threshold ;
    rdfs:range xsd:decimal .
hpc:hasupperbound a owl:DatatypeProperty ;
    rdfs:domain hpc:Threshold ;
    rdfs:range xsd:decimal .
hpc:Job a owl:Class .
hpc:hasthreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Threshold .
