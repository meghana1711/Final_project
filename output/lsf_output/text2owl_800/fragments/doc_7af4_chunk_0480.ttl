hpc:Lsf a owl:Class .
hpc:RcDemandPolicy a owl:Class .
hpc:numPendJobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:Mbschd a owl:Class .
hpc:RcHosts a owl:Class .
hpc:rcHostsDefault a owl:ObjectProperty ;
    rdfs:domain hpc:RcHosts ;
    rdfs:range xsd:string .
hpc:rcHostsBorrow a owl:ObjectProperty ;
    rdfs:domain hpc:RcHosts ;
    rdfs:range hpc:Hosttype .
hpc:Hosttype a owl:Class .
hpc:LsbRcExternalHostFlag a owl:Class .
hpc:Queue a owl:Class .
hpc:rcHostsQueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:RcHosts .
hpc:RC_HOSTS_none a owl:NamedIndividual .
hpc:RC_HOSTS_all a owl:NamedIndividual .
hpc:rcHostsDefaultValue a owl:ObjectProperty ;
    rdfs:domain hpc:RcHostsNone ;
    rdfs:range xsd:string .
hpc:rcDemandPolicyThreshold a owl:ObjectProperty ;
    rdfs:domain hpc:RcDemandPolicy ;
    rdfs:range xsd:integer .
hpc:queueHasRcDemandPolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:RcDemandPolicy .
hpc:queueHasRcHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:RcHosts .
