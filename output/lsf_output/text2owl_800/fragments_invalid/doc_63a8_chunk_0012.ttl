hpc:Job a owl:Class .
hpc:Datatag a owl:Class .
hpc:bsgatag a owl:DatatypeProperty .
hpc:propname a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Datatag rdfs:subClassOf owl:Class .

hpc:Bsgatag rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:regularExpression "^[A-Za-z0-9._-][A-Za-z0-9._-]*$" .

hpc:Propname rdfs:domain hpc:Job ;
    rdfs:range rdf:Property .

hpc:DataTagCreated by hpc:BSGATag ;
    rdfs:subPropertyOf hpc:propName .

hpc:DataTagUsed by hpc:propName ;
    rdfs:subPropertyOf hpc:propName .

hpc:DataTagListed rdfs:subPropertyOf hpc:propName .

hpc:DataTagCleaned rdfs:subPropertyOf hpc:propName .
