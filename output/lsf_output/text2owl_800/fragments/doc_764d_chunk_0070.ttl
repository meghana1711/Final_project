hpc:Lsf a owl:Class .
hpc:pendingmulticlusterjoblimit a owl:DatatypeProperty .
hpc:imptJobbklg a owl:ObjectProperty .
hpc:Haspendingmulticlusterjoblimit rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .
hpc:configuredPendingMultiClusterJobLimit rdfs:subPropertyOf hpc:IMPT_JOBBKLG ;
    rdfs:range xsd:nonNegativeInteger .
hpc:infinitePendingMultiClusterJobLimit rdfs:subPropertyOf hpc:IMPT_JOBBKLG ;
    rdfs:range xsd:string .
hpc:Considerations a owl:Class .
hpc:makeSureEnoughJobsInQueue rdfs:subPropertyOf hpc:considerations ;
    rdfs:domain hpc:Lsf .
hpc:setLimitConsideringJobFlow rdfs:subPropertyOf hpc:considerations ;
    rdfs:domain hpc:Lsf .
hpc:estimatejobflow a owl:ObjectProperty .
hpc:setLimitHigherThanEstimate rdfs:subPropertyOf hpc:setLimitConsideringJobFlow ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:float .
