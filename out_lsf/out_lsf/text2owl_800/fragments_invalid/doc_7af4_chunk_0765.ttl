hpc:LsbStdoutDirect a owl:Class ;
   rdfs:subClassOf owl:NamedIndividual ;
   rdfs:label "LSB_STDOUT_DIRECT" ;
   rdfs:comment "Option for redirecting standard output or standard error from the job directly to a file as the job runs." .

hpc:LsbStopIgnoreIt a owl:Class ;
   rdfs:subClassOf owl:NamedIndividual ;
   rdfs:label "LSB_STOP_IGNORE_IT" ;
   rdfs:comment "Option to allow a solitary job to be stopped regardless of the idle time (IT) of the host that the job is running on." .

hpc:LsbSubCommandname a owl:Class ;
   rdfs:subClassOf owl:NamedIndividual ;
   rdfs:label "LSB_SUB_COMMANDNAME" ;
   rdfs:comment "Option to enable esub to use the variable LSB_SUB_COMMAND_LINE in the esub job parameter file." .

hpc:LsbSubkShowExecHost a owl:Class ;
   rdfs:subClassOf owl:NamedIndividual ;
   rdfs:label "LSB_SUBK_SHOW_EXEC_HOST" ;
   rdfs:comment "Option to display the execution host in the output of the command bsub -K." .

# Object Properties
hpc:hasvalue a owl:ObjectProperty ;
   rdfs:domain hpc:LsbStdoutDirect ;
   rdfs:range xsd:string ;
   rdfs:label "hasValue" ;
   rdfs:comment "The value of LSB_STDOUT_DIRECT." .

hpc:allows a owl:ObjectProperty ;
   rdfs:domain hpc:LsbStopIgnoreIt ;
   rdfs:range xsd:string ;
   rdfs:label "allows" ;
   rdfs:comment "The value that allows a solitary job to be stopped regardless of the idle time." .

hpc:uses a owl:ObjectProperty ;
   rdfs:domain hpc:LsbSubCommandname ;
   rdfs:range hpc:LsbSubParmFile ;
   rdfs:label "uses" ;
   rdfs:comment "The LSB_SUB_PARM_FILE that is used by LSB_SUB_COMMANDNAME." .

hpc:displays a owl:ObjectProperty ;
   rdfs:domain hpc:LsbSubkShowExecHost ;
   rdfs:range xsd:string ;
   rdfs:label "displays" ;
   rdfs:comment "The execution host that is displayed by LSB_SUBK_SHOW_EXEC_HOST." .

# Datatype Properties
hpc:defaultvalue a owl:DatatypeProperty ;
   rdfs:domain hpc:LsbStdoutDirect ;
   rdfs:range xsd:string ;
   rdfs:label "defaultValue" ;
   rdfs:comment "The default value of LSB_STDO
