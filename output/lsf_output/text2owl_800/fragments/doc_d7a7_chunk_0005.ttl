hpc:Windowshost a owl:Class .
hpc:Licenseschedulerclientpackage a owl:Class .
hpc:readme a owl:DatatypeProperty .
hpc:commands a owl:ObjectProperty .
hpc:blstat rdf:value "blstat.exe" ;
        rdfs:range xsd:string .
hpc:blcstat rdf:value "blcstat.exe" ;
        rdfs:range xsd:string .
hpc:blinfo rdf:value "blinfo.exe" ;
        rdfs:range xsd:string .
hpc:blusers rdf:value "blusers.exe" ;
        rdfs:range xsd:string .
hpc:bladmin rdf:value "bladmin.exe" ;
        rdfs:range xsd:string .
hpc:blhosts rdf:value "blhosts.exe" ;
        rdfs:range xsd:string .
hpc:blkill rdf:value "blkill.exe" ;
        rdfs:range xsd:string .
hpc:bltasks rdf:value "bltasks.exe" ;
        rdfs:range xsd:string .
hpc:blparams rdf:value "blparams.exe" ;
        rdfs:range xsd:string .
hpc:taskman rdf:value "taskman.exe" ;
        rdfs:range xsd:string .
hpc:lsflicensescheduler a owl:DatatypeProperty .
hpc:lsfconf a owl:DatatypeProperty .
hpc:installlicenseschedulerwithlsf a owl:ObjectProperty .
hpc:Windowshost rdfs:subClassOf [ a owl:Class ;
                                   rdfs:comment "Windows hosts in an HPC cluster" ] .
hpc:Installlicenseschedulerwithlsf rdfs:domain hpc:Windowshost ;
                                     rdfs:range hpc:Licenseschedulerclientpackage .
