hpc:Project a owl:Class .
hpc:Activeproject a owl:Class .
hpc:ownership a owl:ObjectProperty .
hpc:totalactiveownership a owl:DatatypeProperty .
hpc:Defaultproject a owl:Class .
hpc:requireslicense a owl:ObjectProperty .
hpc:haslicensetokens a owl:DatatypeProperty .
hpc:Pendingjobs a owl:Class .

hpc:Project rdfs:subClassOf rdf:Resource .
hpc:Activeproject rdfs:subClassOf hpc:Project ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal .
hpc:Ownership rdfs:domain hpc:Activeproject ;
    rdfs:range hpc:Project .
hpc:Totalactiveownership rdfs:domain hpc:Activeproject ;
    rdfs:range xsd:decimal .
hpc:Defaultproject rdfs:subClassOf hpc:Project ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal .
hpc:Requireslicense rdfs:domain hpc:Project ;
    rdfs:range hpc:Project .
hpc:Haslicensetokens rdfs:domain hpc:Defaultproject ;
    rdfs:range xsd:decimal .
hpc:Pendingjobs rdfs:subClassOf rdf:Resource .

hpc:Activeproject hpc:ownership ( ( hpc:Project hpc:owns x ) ( hpc:Project hpc:owns y ) ) ;
    hpc:TotalActiveOwnership x + y .
hpc:ActiveProject ( ( hpc:Project hpc:owns 50% ) ( hpc:Project hpc:owns 30% ) ) ;
    hpc:TotalActiveOwnership 80% .
hpc:ActiveProject ( ( hpc:Project hpc:owns 50% ) ( hpc:Project hpc:owns 30% ) ( hpc:Project hpc:owns 30% ) ) ;
    hpc:TotalActiveOwnership 110% ;
    hpc:Ownership ( ( hpc:Project hpc:owns 46% ) ( hpc:Project hpc:owns 27% ) ( hpc:Project hpc:owns 27% ) ) .
hpc:ActiveProject ( ( hpc:Project hpc:owns 50% ) ( hpc:Project hpc:owns 30% ) ( hpc:Project hpc:owns 30% ) ( hpc:Project hpc:owns 30% ) ) ;
    hpc:TotalActiveOwnership 140% ;
    hpc:Ownership ( ( hpc:Project hpc:owns 37% ) ( hpc:Project hpc:owns 21% ) ( hpc:Project hpc:owns 21% ) ( hpc:Project hpc:owns 21% ) ) .
hpc:Defaultproject hpc:requireslicense hpc:DefaultProject .
hpc:Defaultproject hpc:haslicensetokens x ;
    hpc:PendingJobs hpc
