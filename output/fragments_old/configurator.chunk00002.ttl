# Resources
hpc:Resource a owl:Class .
hpc:Processor a hpc:Resource .
hpc:Memory a hpc:Resource .
hpc:GPU a hpc:Resource .

# Linear Resource Allocation
hpc:LinearAllocation a owl:Class .
hpc:allocates hpc:LinearAllocation rdfs:domain hpc:Resource .

# Task Launch
hpc:TaskLaunchPlugin a owl:Class .
hpc:TaskPlugin rdf:datatype xsd:string ;
    rdfs:domain hpc:TaskLaunchPlugin .
hpc:None a hpc:TaskPlugin .
hpc:Affinity a hpc:TaskPlugin .
hpc:Cgroup a hpc:TaskPlugin .

# Prolog and Epilog
hpc:Prolog a owl:Class .
hpc:Epilog a owl:Class .
hpc:PrologPath rdf:datatype xsd:string ;
    rdfs:domain hpc:Prolog .
hpc:EpilogPath rdf:datatype xsd:string ;
    rdfs:domain hpc:Epilog .
hpc:SrunProlog a hpc:Prolog .
hpc:SrunEpilog a hpc:Epilog .
hpc:TaskProlog a hpc:Prolog .
hpc:TaskEpilog a hpc:Epilog .

# Event Logging
hpc:EventLogLevel a owl:Enum .
hpc:EventLogLevel "0" .
hpc:EventLogLevel "1" .
...
hpc:EventLogLevel "7" .
hpc:SlurmctldDebug rdf:datatype xsd:string ;
    rdfs:domain hpc:EventLog .
hpc:SlurmctldLogFile rdf:datatype xsd:string ;
    rdfs:domain hpc:EventLog .
hpc:SlurmdDebug rdf:datatype xsd:string ;
    rdfs:domain hpc:EventLog .
hpc:SlurmdLogFile rdf:datatype xsd:string ;
    rdfs:domain hpc:EventLog .

# Job Completion Logging
hpc:JobCompletionType a owl:Enum .
hpc:JobCompletionType "None" .
hpc:JobCompletionType "Elasticsearch" .
hpc:JobCompletionType "FileTxt" .
hpc:JobCompletionType "Kafka" .
hpc:JobCompletionType "Lua" .
hpc:JobCompletionType "Script" .
hpc:JobCompletionType "MySQL" .
hpc:JobCompLoc rdf:datatype xsd:string ;
    rdfs:domain hpc:Job
