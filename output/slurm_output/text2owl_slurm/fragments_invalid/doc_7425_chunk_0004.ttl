hpc:Jobdescmsg a owl:Class .
hpc:memlock a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdescmsg ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Locked-in-memory address space (Locked-in-memory address space) (64 bit integer number with flags)" .

