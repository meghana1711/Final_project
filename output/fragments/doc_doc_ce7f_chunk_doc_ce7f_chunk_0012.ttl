hpc:SlurmConf a owl:Class .
hpc:ControlMachine a owl:Class ;
    rdfs:subClassOf hpc:Machine .
hpc:HostName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ControlMachine ;
    rdfs:range xsd:string .
hpc:CommunicationName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ControlMachine ;
    rdfs:range xsd:string .
hpc:CommunicationPort rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ControlMachine ;
    rdfs:range xsd:integer .
hpc:TimerValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ControlMachine ;
    rdfs:range xsd:integer .
hpc:SlurmUser rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range xsd:string .
hpc:LogDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:Directory .
hpc:PIDDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:Directory .
hpc:StateSaveDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:Directory .
hpc:StateSaveLocation rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range xsd:string .
hpc:LowLatencyDisk rdf:type owl:Class .
hpc:BackupHost rdf:type owl:Class .
hpc:SharedMount rdf:type owl:Class .
hpc:LowLatencyReadWrite rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SharedMount ;
    rdfs:range xsd:boolean .
hpc:AccessibleToTwoControllers rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StateSaveLocation ;
    rdfs:range hpc:BackupHost .
hpc:NoNFS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StateSaveLocation ;
    rdfs:range xsd:boolean .
hpc:LackOfStateInformationResultInJobCancellation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:StateSaveLocation ;
    rdfs:range hpc:ControlMachine .
```
