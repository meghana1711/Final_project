hpc:Filesubmission a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies the path to a file for submission to a job." .

hpc:filecopy a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of copying a file from the submission host to the execution host." .

hpc:filecopysuccess a owl:ObjectProperty ;
    rdfs:domain hpc:Filecopy ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the file copy was successful." .

hpc:remotecopyaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether remote copy (rcp) access is allowed." .

hpc:filesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:integer ;
    rdfs:comment "The size of the input file in characters." .

hpc:maxfilesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum allowed size of the input file in characters." .

hpc:jobcompletion a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The job that the file submission is associated with." .

hpc:jobspooldir a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where the spooled file is located." .

hpc:spooledfile a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The spooled file used as input for the job." .

hpc:originalinputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The original input file." .

hpc:ismodified a owl:ObjectProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the input file was modified or removed before the job completes." .

hpc:unixlinuxfilesizelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum allowed size of the input file in characters for UNIX and Linux." .

hpc:windowsfilesizelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesubmission ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum allowed size of the input file in characters for Windows." .
``
