hpc:Podmancontainerjob a owl:Class .
hpc:Dockercontainerjob a owl:Class ;
    rdfs:subClassOf hpc:Podmancontainerjob .

hpc:Enrootcontainerjob a owl:Class .
hpc:enrootcontainerjobstarter a owl:ObjectProperty ;
    rdfs:domain hpc:Enrootcontainerjob ;
    rdfs:range xsd:string .

hpc:starterfilepermission a owl:DatatypeProperty ;
    rdfs:domain hpc:Enrootcontainerjob ;
    rdfs:range xsd:integer .

hpc:context a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmancontainerjob ;
    rdfs:range xsd:string .

hpc:monitor a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmancontainerjob ;
    rdfs:range xsd:string .

hpc:controller a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmancontainerjob ;
    rdfs:range xsd:string .

hpc:gpuReq a owl:ObjectProperty ;
    rdfs:domain hpc:Podmancontainerjob ;

hpc:gvendor a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:nvlink a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:glink a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:chunkJobSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmancontainerjob ;
    rdfs:obsolete true .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Podmancontainerjob ;
    rdfs:obsolete true .
