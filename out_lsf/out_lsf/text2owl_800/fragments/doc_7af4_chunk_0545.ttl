hpc:tmp a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .

hpc:users a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasLimitedBy .

hpc:User a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

hpc:hasgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .

hpc:all a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:All .

hpc:All a owl:Class .
