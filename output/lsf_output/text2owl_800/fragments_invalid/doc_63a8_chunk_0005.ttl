hpc:DataFileRequirementWithAsterisk
    a owl:Class ;
    rdfs:subClassOf hpc:Datafilerequirement ;
    rdfs:comment "The data file requirements must be in quotation marks." .

hpc:DefaultHostName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafilerequirement ;
    rdfs:range xsd:string .

hpc:SubmissionHostName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafilerequirement ;
    rdfs:range xsd:string .

