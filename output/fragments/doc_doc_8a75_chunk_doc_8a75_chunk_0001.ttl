hpc:SlurmProlog a owl:Class .
hpc:SlurmEpilog a owl:Class .
hpc:SrunProlog a owl:Class .
hpc:TaskProlog a owl:Class .
hpc:TaskEpilog a owl:Class .
hpc:SrunEpilog a owl:Class .

hpc:isInvokedBy a owl:ObjectProperty .
hpc:isExecutedOn a owl:ObjectProperty .
hpc:isLocation a owl:ObjectProperty .

hpc:SlurmProlog rdfs:subClassOf hpc:SlurmScript .
hpc:SlurmEpilog rdfs:subClassOf hpc:SlurmScript .
hpc:SrunProlog rdfs:subClassOf hpc:SrunScript .
hpc:TaskProlog rdfs:subClassOf hpc:TaskScript .
hpc:TaskEpilog rdfs:subClassOf hpc:TaskScript .
hpc:SrunEpilog rdfs:subClassOf hpc:SrunScript .

hpc:SlurmScript rdf:type owl:Class .
hpc:SrunScript rdf:type owl:Class .
hpc:TaskScript rdf:type owl:Class .

hpc:isInvokedBy rdfs:domain hpc:SlurmScript ;
                 rdfs:domain hpc:SrunScript ;
                 rdfs:domain hpc:TaskScript .
hpc:isInvokedBy rdfs:range hpc:User .

hpc:isExecutedOn rdfs:domain hpc:SlurmScript ;
                 rdfs:domain hpc:SrunScript ;
                 rdfs:domain hpc:TaskScript .
hpc:isExecutedOn rdfs:range hpc:Node .

hpc:isLocation rdfs:domain hpc:SlurmScript ;
                rdfs:domain hpc:SrunScript ;
                rdfs:domain hpc:TaskScript .
hpc:isLocation rdfs:range hpcd:Location .

hpc:SlurmScript rdfs:subClassOf hpc:ScriptWithFlags .
hpc:ScriptWithFlags rdf:type owl:Class .

hpc:PrologFlags a owl:DatatypeProperty .
hpc:PrologFlags rdfs:domain hpc:SlurmScript .
```
