hpc:PingArrayResp a owl:Class .
hpc:Ping a hpc:PingArrayResp ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf [ a owl:NamedIndividual ] ] .

hpc:Pinged a owl:DatatypeProperty ;
    rdfs:domain hpc:Ping .

hpc:Error a owl:DatatypeProperty ;
    rdfs:domain hpc:Ping .

hpc:ReconfigureResp a owl:Class .
hpc:Reconfigure a hpc:ReconfigureResp ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf [ a owl:NamedIndividual ] ] .

hpc:Error a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfigure .

hpc:ReservationResp a owl:Class .
hpc:Reservation a hpc:ReservationResp ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf [ a owl:NamedIndividual ] ] .

hpc:ReservationName a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:UpdateTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation .

hpc:ReservationInfo a owl:Class .

hpc:JobPostResponse a owl:Class .
hpc:JobAllocResp a hpc:JobPostResponse ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf [ a owl:NamedIndividual ] ] .

hpc:JobSubmitUserMsg a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocResp .

hpc:Error a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocResp .

hpc:JobSubmitResponse a owl:Class .
hpc:JobSubmitReq a owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmitResponse .

hpc:JobSubmitUserMsg a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSubmitResponse .

hpc:Error a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSubmitResponse .
```
