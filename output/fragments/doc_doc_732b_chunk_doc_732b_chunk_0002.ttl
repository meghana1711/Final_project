hpc:Module has rdf:type owl:Class .
hpc:Module rdfs:subClassOf owl:NamedIndividual .

hpc:RequiresOption has rdf:type owl:ObjectProperty .
hpc:RequiresOption rdfs:domain hpc:Module ;
                      rdfs:range xsd:string .

hpc:HasLocalSteps has rdf:type owl:ObjectProperty .
hpc:HasLocalSteps rdfs:domain hpc:Module ;
                   rdfs:range xsd:boolean .

hpc:HasExternStep has rdf:type owl:ObjectProperty .
hpc:HasExternStep rdfs:domain hpc:Module ;
                   rdfs:range xsd:boolean .

hpc:LaunchParameters has rdf:type owl:ObjectProperty .
hpc:LaunchParameters rdfs:domain hpc:Module ;
                       rdfs:range xsd:string .

hpc:UsePAM has rdf:type owl:ObjectProperty .
hpc:UsePAM rdfs:domain hpc:Module ;
                   rdfs:range xsd:boolean .

hpc:SSHConfiguration has rdf:type owl:Class .
hpc:SSHConfiguration rdfs:subClassOf hpc:Configuration .

hpc:SSHConfigurationRequiresPAMOn has rdf:type owl:ObjectProperty .
hpc:SSHConfigurationRequiresPAMOn rdfs:domain hpc:SSHConfiguration ;
                                     rdfs:range xsd:boolean .

hpc:SSHConfigurationSupportedMethods has rdf:type owl:ObjectProperty .
hpc:SSHConfigurationSupportedMethods rdfs:domain hpc:SSHConfiguration ;
                                         rdfs:range xsd:string .

hpc:SSHConfigurationUnsupportedMethods has rdf:type owl:ObjectProperty .
hpc:SSHConfigurationUnsupportedMethods rdfs:domain hsd:SSHConfiguration ;
                                            rdfs:range xsd:string .

hpc:PAMConfiguration has rdf:type owl:Class .
hpc:PAMConfiguration rdfs:subClassOf hpc:Configuration .

hpc:PAMConfigurationAccount has rdf:type owl:Class .
hpc:PAMConfigurationAccount rdfs:subClassOf hpc:PAMConfiguration .

hpc:PAMConfigurationAccountRequires has rdf:type owl:ObjectProperty .
hpc:PAMConfigurationAccountRequires rdfs:domain hpc:PAMConfigurationAccount ;
                                          rdfs:range xsd:string .

hpc:PAMConfigurationAccountType has rdf:type owl:DatatypeProperty .
hpc:PAMConfigurationAccountType rdfs:domain hpc:PAMConfigurationAccount ;
                                      rdfs:range xsd:string .

hpc:PAMConfigurationAccountControlFlag has rdf:type owl:DatatypeProperty .
hpc:PAMConfigurationAccountControlFlag rdfs:domain hpc:PAMConfigurationAccount ;
                                               rdfs:range xsd:string .

hpc:PAMConfigurationAccountOrder has rdf:type owl:ObjectProperty .
hpc:PAMConfigurationAccountOrder rdfs:domain hpc:PAMConfigurationAccount ;
                                       rd
