hpc:Lsfversion a owl:Class .
hpc:Command a owl:Class .

# Specific LSF Version Classes
hpc:LSFVersion10_1_FP9 a hpc:LSFVersion .
hpc:LSFVersion10_1_FP3 a hpc:LSFVersion .
hpc:LSFVersion10_1_FP4 a hpc:LSFVersion .
hpc:LSFVersion10_1_FP6 a hpc:LSFVersion .
hpc:LSFVersion10_1_FP10 a hpc:LSFVersion .

# Commands
hpc:lsload a hpc:Command .

# Command Options
hpc:ooption a owl:ObjectProperty .
hpc:jsonOption a hpc:oOption .
hpc:gpuOption a hpc:oOption .
hpc:gpuloadOption a hpc:oOption .
hpc:locOption a hpc:oOption .
hpc:sOption a hpc:oOption .
hpc:lOption a hpc:oOption .

# Command Output Fields (Datatype Properties)
hpc:portstatus a owl:DatatypeProperty .
hpc:gpuStatus a hpc:portStatus .
hpc:gpuError a hpc:portStatus .
hpc:gpuhostinfo a owl:DatatypeProperty .

# Domain and Range restrictions
hpc:Lsload rdfs:domain hpc:Command ;
    rdfs:range rdf:List .
hpc:Jsonoption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Gpuoption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Gpuloadoption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Locoption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Soption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Loption rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .
hpc:Portstatus rdfs:domain hpc:Lsload ;
    rdfs:range xsd:string .

# Subclassing for GPU Status Fields
hpc:gpuStatus0 a hpc:portStatus ;
    rdfs:subClassOf hpc:Gpustatus .
hpc:gpuStatus1 a hpc:portStatus ;
    rdfs:subClassOf hpc:Gpustatus .

# Subclassing for GPU Error Fields
hpc:gpuError0 a hpc:portStatus ;
    rdfs:subClassOf hpc:Gpuerror .
hpc:gpuError1 a hpc:portStatus ;
    rdfs:subClassOf hpc:Gpuerror .
