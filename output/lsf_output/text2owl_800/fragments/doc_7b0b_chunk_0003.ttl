hpc:Tsjobhelper a owl:Class .
hpc:hasinstallcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Tsjobhelper ;
    rdfs:range xsd:string .
hpc:hasuninstallcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Tsjobhelper ;
    rdfs:range xsd:string .
hpc:location a owl:DatatypeProperty ;
    rdfs:domain hpc:Tsjobhelper ;
    rdfs:range xsd:string .
hpc:lsbTsjobsHelperPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexecutionhost ;
    rdfs:range xsd:integer .
hpc:lsbTsjobsHelperTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexecutionhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Jobexecutionhost a owl:Class .
hpc:Job a owl:Class .
hpc:hasjobexecutionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobexecutionhost .
hpc:Jobexecutionsession a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:hasuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexecutionsession ;
    rdfs:range xsd:string .
hpc:postexecutionjobprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Jobexecutionhost ;
    rdfs:range hpc:Postexecutionjobprocessing .
hpc:Postexecutionjobprocessing a owl:Class .
hpc:jobIncludePostproc a owl:DatatypeProperty ;
    rdfs:domain hpc:Postexecutionjobprocessing ;
    rdfs:range xsd:boolean .
hpc:Cluster a owl:Class ;
    rdfs:subClassOf hpc:Postexecutionjobprocessing .
hpc:Application a owl:Class ;
    rdfs:subClassOf hpc:Postexecutionjobprocessing .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Postexecutionjobprocessing .
hpc:jobIncludePostproc a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
