hpc:Resourcereservation a owl:Class .
hpc:hasresources a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range rdf:Resource .
hpc:hastimeperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:dateTime .
hpc:isassociatedwithpartition a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:Partition .
hpc:spansOverMultiplePartitions rdf:PlainLiteral "false"^^xsd:boolean .
hpc:createdby a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:User .
hpc:Cancreatereservation a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:Isrootuser a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:hasconfiguredslurmuser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User .
hpc:isCompatibleWithGangScheduler rdf:PlainLiteral "false"^^xsd:boolean .
hpc:Reservedresourcetype a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:isCore a hpc:reservedResourceType .
hpc:isNode a hpc:reservedResourceType .
hpc:isLicense a hpc:reservedResourceType .
hpc:isBurstBuffer a hpc:reservedResourceType .
hpc:canUseExplicitlyRequestedNodes rdf:PlainLiteral "true"^^xsd:boolean .
hpc:canChangeBehaviorUsingFLEXFlag rdf:PlainLiteral "true"^^xsd:boolean .
hpc:isReservedForExclusiveUse rdf:PlainLiteral "true"^^xsd:boolean .
hpc:isNotExclusivelyReserved rdf:PlainLiteral "true"^^xsd:boolean .
hpc:isAvailableToAnyJob rdf:PlainLiteral "true"^^xsd:boolean .
hpc:canbeviewedbyrootandconfiguredslurmuser a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:User .
hpc:canbeviewedbyall a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:User .
hpc:Systemdowntimereservation a owl:Class ;
    rdfs:subClassOf hpc:Resourcereservation .
