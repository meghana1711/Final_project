hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hasstatus ;
    rdfs:subClassOf hpc:Hasexitaction ;
    rdfs:subClassOf hpc:Canbepreempted .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasexitaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:HasStatus .

hpc:SUSPEND a xsd:string .
hpc:EXIT a xsd:string .

hpc:maxJobPreempt a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:rangeMin xsd:1 ;
    rdfs:rangeMax xsd:infinite .

hpc:INFINIT_INT a xsd:string ;
    rdfs:comment "Defined in lsf.h." .

hpc:STRICT_DEFAULT a xsd:string ;
    rdfs:comment "Not defined." .

hpc:localMaxPreexecRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:MAX_JOB_PREEMPT .
