hpc:Bsub a owl:Class .
hpc:signal a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:integer .
hpc:Sla a owl:Class .
hpc:serviceclassname a owl:ObjectProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Sla .
hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf hpc:Sla .
hpc:jobgroupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Sla ;
    rdfs:range hpc:Jobgroup .
hpc:sladefault a owl:ObjectProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Sla .
hpc:slafowardcompatibility a owl:ObjectProperty ;
    rdfs:domain hpc:Sla ;
    rdfs:range xsd:boolean .
hpc:slaexists a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla ;
    rdfs:range xsd:boolean .
hpc:slaaccess a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla ;
    rdfs:range xsd:boolean .
