hpc:Queue a owl:Class .
hpc:Job a owl:Class .
hpc:Runwindow a owl:Class .
hpc:terminateWhen a owl:ObjectProperty .
hpc:jobControls a owl:ObjectProperty .
hpc:lsbSigstop a owl:DatatypeProperty .

hpc:Queue rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .
hpc:Runwindow rdfs:subClassOf owl:Class .
hpc:TerminateWhen rdfs:domain hpc:Queue ;
                        rdfs:range xsd:string .
hpc:JobControls rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:LsbSigstop rdfs:domain hpc:Queue ;
                 rdfs:range xsd:string .

hpc:TERMINATE_WHEN WINDOW rdf:type hpc:TERMINATE_WHEN ;
                      rdfs:comment "Defines a queue that will kill jobs if the run window closes." .
hpc:JOB_CONTROLS "TERMINATE[ kill -KILL $LSB_JOBPIDS; \
                   echo \"job $LSB_JOBID killed by queue run window\" | \
                   mail $USER ]" rdf:type hpc:JOB_CONTROLS ;
                    rdfs:comment "Command to terminate a job." .
