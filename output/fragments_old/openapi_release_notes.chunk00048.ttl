hpc:Clusters a owl:Class .
hpc:ClusterFlags a owl:Class .
hpc:JobQOS a owl:Class .
hpc:NodeTresWeighted a owl:Class .
hpc:SlurmCluster a owl:Class .

hpc:hasFlags a owl:ObjectProperty .
hpc:hasQOS a owl:ObjectProperty .
hpc:hasTresWeighted a owl:ObjectProperty .

hpc:ClusterFlags enum "FEDERATION" , "EXTERNAL" .
hpc:JobQOS rdf:type rdfs:Literal ;
    rdfs:label "Quality of Service assigned to the job, if pending the QOS requested"@en .

hpc:SlurmCluster rdfs:subClassOf hpc:Clusters .
hpc:SlurmCluster rdf:type rdfs:Class ;
    rdfs:label "Slurm Cluster"@en .

hpc:hasFlags rdfs:domain hpc:SlurmCluster ;
    rdfs:range hpc:ClusterFlags .

hpc:info a owl:Class .
hpc:dataParsers a owl:Class .
hpc:dataParsersPlugin a owl:ObjectProperty .
hpc:openapi a owl:ObjectProperty .
hpc:release a owl:DatatypeProperty .
hpc:version a owl:DatatypeProperty .
hpc:version rdfs:subPropertyOf xsd:string .

hpc:dataParsersFlags a owl:ObjectProperty .
hpc:dataParsersFlags rdfs:domain hpc:dataParsers ;
    rdfs:range rdfs:Resource .

hpc:dataParsersPlugin rdfs:domain hpc:dataParsers ;
    rdfs:range rdfs:Literal .

hpc:openapi rdfs:domain hpc:info ;
    rdfs:range rdfs:Resource .

hpc:release rdfs:domain hpc:info ;
    rdfs:range rdfs:Literal .

hpc:version rdfs:domain hpc:info ;
    rdfs:range rdfs:Literal .

hpc:major rdfs:subPropertyOf hpc:version ;
    rdfs:domain hpc:version ;
    rdfs:range xsd:nonNegativeInteger .

hpc:micro rdfs:subPropertyOf hpc:version ;
    rdfs:domain hpc:version ;
    rdfs:range xsd:nonNegativeInteger .

hpc:minor rdfs:subPropertyOf hpc:version ;
    rdfs:domain hpc:version ;
    rdfs:range x
