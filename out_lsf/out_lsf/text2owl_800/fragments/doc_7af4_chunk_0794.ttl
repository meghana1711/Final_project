    rdfs:range hpc:Bstagecommand .
hpc:quietmode a owl:ObjectProperty ;
    rdfs:domain hpc:Sshcommand ;
    rdfs:range xsd:boolean .
hpc:passwordauthentication a owl:DatatypeProperty ;
