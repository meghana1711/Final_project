hpc:SlurmEntity a owl:Class .
hpc:Node a hpc:SlurmEntity .
hpc:Partition a owl:Class .
hpc:Configurability a owl:Class .

hpc:countOfProcessors rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:sizeOfRealMemory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:sizeOfTemporaryDiskSpace rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:state rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node .
hpc:weight rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:features rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:name rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
hpc:associatedNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
hpc:state rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
hpc:maxJobTimeLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:maxNodeCountPerJob rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:groupAccessList rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:priority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:sharedNodeAccessPolicy rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:overSubscriptionLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .

hpc:BitMap a owl:Class .
hpc:schedulingDecision rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BitMap .
