hpc:Unixhost a owl:Class .
hpc:Daemon a owl:Class .
hpc:Rootdaemon a owl:Class .
hpc:lsfshutdown a owl:ObjectProperty .
hpc:lsfstartup a owl:ObjectProperty .
hpc:lsfconf a owl:ObjectProperty .
hpc:lsflogfileowner a owl:DatatypeProperty .
hpc:Logfileowner rdfs:range xsd:string .
hpc:Shutdowndaemon rdfs:domain hpc:Daemon ;
    rdfs:subPropertyOf hpc:lsfshutdown .
hpc:Startupdaemon rdfs:domain hpc:Daemon ;
    rdfs:subPropertyOf hpc:lsfstartup .
hpc:Editlsfconf rdfs:domain hpc:Unixhost ;
    rdfs:range hpc:Lsfconf ;
    rdfs:subPropertyOf hpc:lsfConf .
hpc:Clearlogfiles rdfs:domain hpc:Unixhost .
