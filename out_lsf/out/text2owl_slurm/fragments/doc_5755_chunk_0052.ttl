hpc:Slurmconfiguration a owl:Class .
hpc:useInteractiveStep a owl:ObjectProperty .
hpc:UseInteractiveStep rdfs:domain hpc:Slurmconfiguration ;
    rdfs:range xsd:boolean .

hpc:Tmpfsjobcontainer a owl:Class .
hpc:jobcontainertype a owl:DatatypeProperty ;
    rdfs:domain hpc:Tmpfsjobcontainer ;
    rdfs:range xsd:string .

hpc:JobContainerConf a owl:Class .
hpc:jobcontainerconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Tmpfsjobcontainer .

hpc:basepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Tmpfsjobcontainer .

hpc:mountPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Tmpfsjobcontainer .

hpc:PrivateTmp a owl:Class .
hpc:PrivateTmp rdfs:subClassOf hpc:Tmpfsjobcontainer .

hpc:PrivateShm a owl:Class .
hpc:PrivateShm rdfs:subClassOf hpc:Tmpfsjobcontainer .
