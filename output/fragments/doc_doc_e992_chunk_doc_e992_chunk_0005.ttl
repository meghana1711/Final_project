hpc:hetJobNnodes a xsd:unsignedInt .
hpc:hetJobNtasks a xsd:unsignedInt .
hpc:hetJobTaskCnts a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmStepLaunchParams ;
    rdfs:range rdf:List .
hpc:hetJobTids a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmStepLaunchParams ;
    rdfs:range rdf:List .
hpc:hetJobNodeList a owl:ObjectProperty .
hpc:hetJobJobEnv a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmStepLaunchParams ;
    rdfs:range rdf:List .

hpc:SpankJobEnv a owl:Class .
