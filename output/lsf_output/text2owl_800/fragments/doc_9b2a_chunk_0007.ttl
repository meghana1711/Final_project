hpc:Licensefeature a owl:Class .
hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensefeature ;
    rdfs:range xsd:positiveInteger .

hpc:Errorlog a owl:Class ;
    rdfs:subClassOf hpc:Logfile .

hpc:logfilelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range xsd:string .

hpc:logfilename a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range xsd:string .

hpc:logfilegrowth a owl:DatatypeProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range xsd:string .

hpc:logfileclearance a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range xsd:string .

hpc:logfilerenaming a owl:ObjectProperty ;
    rdfs:domain hpc:Errorlog ;
    rdfs:range xsd:string .

hpc:Blcollect a owl:Class ;
    rdfs:subClassOf hpc:Errorlog .

hpc:blcollectlogtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcollect .

hpc:blcollectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcollect .

hpc:blcollectstatusreport a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcollect .

hpc:servicedomainname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcollectname ;
    rdfs:range xsd:string .
