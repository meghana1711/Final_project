hpc:Host a owl:Class .
hpc:Rlahost a owl:Class .
hpc:operatingsystem a owl:DatatypeProperty ;
    rdfs:domain hpc:Rlahost ;
    rdfs:range xsd:string .
hpc:totalcpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Rlahost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:brlainfo a owl:ObjectProperty ;
    rdfs:domain hpc:Rlahost ;
    rdfs:range rdf:Resource .
hpc:brlainfolong a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:brlainfo .
hpc:brlainfohostname a owl:ObjectProperty ;
    rdfs:domain hpc:Brlainfo ;
    rdfs:range hpc:Rlahost .
