hpc:Jobslotlimit rdfs:domain hpc:Queue .
hpc:Joblimit rdfs:domain hpc:Queue .
hpc:Reservationlimit rdfs:domain hpc:Resource .

hpc:Jobslot rdfs:subClassOf hpc:Resource .
hpc:Runningjob rdfs:subClassOf hpc:Job .
hpc:Suspendedjob rdfs:subClassOf hpc:Job .
