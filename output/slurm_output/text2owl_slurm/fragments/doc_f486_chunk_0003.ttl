hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:terminatejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:shrinkjoballocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joballocation .

hpc:packjobstate a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstate .

hpc:unpackjobstate a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstate .

hpc:packnodestate a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Nodestate .

hpc:unpacknodestate a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Nodestate .
