hpc:Solarismachine a owl:Class .

hpc:Keywordreservation a owl:Class .
hpc:resourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Keywordreservation ;
    rdfs:range xsd:string .

hpc:Dynamicresource a owl:Class .
hpc:updateinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicresource ;
    rdfs:range xsd:integer .

hpc:Numericresource a owl:Class .
hpc:increasing a owl:ObjectProperty ;
    rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:boolean .

hpc:Sharednumericresource a owl:Class .
hpc:releasable a owl:ObjectProperty ;
    rdfs:domain hpc:Sharednumericresource ;
    rdfs:range xsd:boolean .

hpc:Consumableresource a owl:Class .
hpc:Staticresource a owl:Class .
hpc:Dynamicnumericresource a owl:Class .

hpc:consumable a owl:ObjectProperty ;
    rdfs:domain hpc:Consumableresource ;
    rdfs:range xsd:boolean .

hpc:Builtinindex a owl:Class .
hpc:Consumablebuiltinindex a owl:Class .
hpc:Nonconsumablebuiltinindex a owl:Class .
hpc:Consumablebuiltinindex rdfs:subClassOf hpc:Consumableresource .
hpc:Nonconsumablebuiltinindex rdfs:subClassOf hpc:Resource .

hpc:ConsumableBuiltInIndex rdf:value "r15s" .
hpc:ConsumableBuiltInIndex rdf:value "r1m" .
hpc:ConsumableBuiltInIndex rdf:value "r15m" .
hpc:ConsumableBuiltInIndex rdf:value "ut" .
hpc:ConsumableBuiltInIndex rdf:value "pg" .
hpc:ConsumableBuiltInIndex rdf:value "io" .
hpc:ConsumableBuiltInIndex rdf:value "ls" .
hpc:ConsumableBuiltInIndex rdf:value "it" .
hpc:ConsumableBuiltInIndex rdf:value "tmp" .
hpc:ConsumableBuiltInIndex rdf:value "swp" .
hpc:ConsumableBuiltInIndex rdf:value "mem" .
hpc:NonConsumableBuiltInIndex rdf:value "ncpus" .
hpc:NonConsumableBuiltInIndex rdf:value "ndisks" .
hpc:NonConsumableBuiltInIndex rdf:value "maxmem" .
hpc:NonConsumableBuiltInIndex rdf:value "maxswp" .
hpc:NonConsumableBuiltInIndex rdf
