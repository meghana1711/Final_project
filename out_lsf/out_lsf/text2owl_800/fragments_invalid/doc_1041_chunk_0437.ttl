hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:RootUser a hpc:User .
hpc:LSFAdmin a hpc:User .
hpc:jobname a owl:DatatypeProperty .
hpc:Hasjobname rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .

hpc:jobid a owl:DatatypeProperty .
hpc:Hasjobid rdfs:domain hpc:Job ;
            rdfs:range xsd:string .

hpc:ownjob a owl:ObjectProperty .
hpc:canSendMessagesToOwnJob rdfs:subPropertyOf hpc:OwnJob ;
                             rdfs:domain hpc:User ;
                             rdfs:range hpc:Job .
hpc:canSendDataToOwnJob rdfs:subPropertyOf hpc:OwnJob ;
                         rdfs:domain hpc:User ;
                         rdfs:range hpc:Job .

hpc:otherusersjob a owl:ObjectProperty .
hpc:cannotSendMessagesToOtherUsersJob rdfs:subPropertyOf hpc:OtherUsersJob ;
                                         rdfs:domain hpc:User ;
                                         rdfs:range hpc:Job .
hpc:cannotSendDataToOtherUsersJob rdfs:subPropertyOf hpc:OtherUsersJob ;
                                   rdfs:domain hpc:User ;
                                   rdfs:range hpc:Job .

hpc:RootCanSendMessagesToOwnJob rdfs:subPropertyOf hpc:OwnJob ;
                                 rdfs:domain hpc:Rootuser ;
                                 rdfs:range hpc:Job .
hpc:LSFCanSendMessagesToOwnJob rdfs:subPropertyOf hpc:OwnJob ;
                               rdfs:domain hpc:Lsfadmin ;
                               rdfs:range hpc:Job .
hpc:RootCannotSendDataToOtherUsersJob rdfs:subPropertyOf hpc:OtherUsersJob ;
                                      rdfs:domain hpc:Rootuser ;
                                      rdfs:range hpc:Job .
hpc:LSFCannotSendDataToOtherUsersJob rdfs:subPropertyOf hpc:OtherUsersJob ;
                                     rdfs:domain hpc:Lsfadmin ;
                                     rdfs:range hpc:Job .

hpc:jobcleaningtime a owl:DatatypeProperty .
hpc:Hasjobcleaningtime rdfs:domain hpc:Job ;
                rdfs:range xsd:dateTime .

hpc:associatedmessage a owl:ObjectProperty .
hpc:canAssociateMessagesWithJob rdfs:subPropertyOf hpc:AssociatedMessage ;
                                 rdfs:domain hpc:Job ;
                                 rdfs:range hpc:Message .

hpc:associateddatafile a owl:ObjectProperty .
hpc:canAttachDataToJob rdfs:subPropertyOf hpc:AssociatedDataFile ;
                       rdfs:domain hpc:Job ;
                       rdfs:range hpc:Datafile .

hpc:jobstatus a owl:DatatypeProperty .
hpc:Hasjobstatus rdfs:domain
