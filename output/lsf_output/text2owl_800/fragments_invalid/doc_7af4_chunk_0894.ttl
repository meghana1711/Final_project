@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:MQTT_BROKER_PORT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the TCP port for the MQTT message broker daemon (mosquitto)." .

hpc:ebrokerd
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The MQTT message broker receives provider host information from ebrokerd and publishes that information for the bhosts -rc and bhosts -rconly command options to display." .

hpc:LSF_RSH_ONLY
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets LSF remote execution commands to use only the remote shell defined in the LSF_RSH parameter, even if remote shell startup fails." .

hpc:XLSF_APPDIR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "(UNIX only; optional) Directory in which X application default files for LSF products are installed." .

hpc:XLSF_UIDDIR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "(UNIX only) Directory in which Motif User Interface Definition files are stored. These files are platform-specific." .
