# Class and Property Domain and Range
hpc:SlurmWorkloadManager rdfs:subClassOf hpc:Version .
hpc:Version rdfs:subClassOf owl:Thing .
hpc:Release rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:Version .
hpc:MajorRelease rdfs:subClassOf hpc:Release ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:MajorRelease .
hpc:MaintenanceRelease rdfs:subClassOf hpc:Release ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:MaintenanceRelease .
