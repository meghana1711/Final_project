hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:ScheduledJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is scheduled but not yet running." .
hpc:RunningJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is currently running." .
hpc:SuspendedJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is currently suspended." .
hpc:ReleasedJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is no longer suspended." .
hpc:HoldableJob a hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that can be held or released." .
hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .
hpc:hasNode a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .
hpc:hasPriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:suspendJob a owl:ObjectProperty ;
    rdfs:domain hpc:HoldableJob ;
    rdfs:range hpc:Job .
hpc:resumeJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:holdJob a owl:ObjectProperty ;
    rdfs:domain hpc:HoldableJob ;
    rdfs:range hpc:Job .
hpc:releaseJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:updateJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:printJobID a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Writes the job's Slurm job ID to its standard output." .
```
