hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Hasproject hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Project .

hpc:Defaultqueue hpc:project rdf:Property ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Queue .

hpc:Defaultusergroup hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .

hpc:Defaultqueue hpc:project rdf:Property ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Queue .

hpc:Defaultusergroup hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .

hpc:Defaultqueue hpc:project rdf:Property ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Queue .

hpc:Hasdefaultqueue hpc:project rdf:Property ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Hasdefaultusergroup hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Commfailaction hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:commfailaction hpc:job a owl:DatatypeProperty .

hpc:Envscript hpc:job rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:envscript hpc:job a owl:DatatypeProperty .
