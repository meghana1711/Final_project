hpc:changehost a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Host .

hpc:Globalpolicydaemon a owl:Class .
hpc:Loadinfomanager a owl:Class .
hpc:Lim a owl:Class .
hpc:Accountingstatistics a owl:Class .
hpc:Mergetasklogfiles a owl:Class .
hpc:Administrativetool a owl:Class .
hpc:Clustersconfig a owl:Class .
hpc:Installationconfiguration a owl:Class .
hpc:Restartdaemons a owl:Class .
hpc:Shutdowndaemons a owl:Class .
hpc:Startupdaemons a owl:Class .
hpc:Runtaskonhosts a owl:Class .
hpc:Hostsinfo a owl:Class .
hpc:Id a owl:Class .
hpc:Configurationinfo a owl:Class .

hpc:Propchangehost rdfs:domain hpc:Command ;
    rdfs:range hpc:Host .
hpc:Propdisplayinfo rdfs:domain hpc:Globalpolicydaemon ;
    rdfs:range xsd:string .
hpc:Proploadinfomanager rdfs:domain hpc:Lim ;
    rdfs:range xsd:string .
hpc:Propaccountingstatistics rdfs:domain hpc:Accountingstatistics ;
    rdfs:range xsd:string .
hpc:Propmergetasklogfiles rdfs:domain hpc:Mergetasklogfiles ;
    rdfs:range xsd:string .
hpc:Propadministrativetool rdfs:domain hpc:Administrativetool ;
    rdfs:range xsd:string .
hpc:Propclustersconfig rdfs:domain hpc:Clustersconfig ;
    rdfs:range xsd:string .
hpc:Propinstallationconfiguration rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:Proprestartdaemons rdfs:domain hpc:Restartdaemons ;
    rdfs:range xsd:string .
hpc:Propshutdowndaemons rdfs:domain hpc:Shutdowndaemons ;
    rdfs:range xsd:string .
hpc:Propstartupdaemons rdfs:domain hpc:Startupdaemons ;
    rdfs:range xsd:string .
hpc:Propruntaskonhosts rdfs:domain hpc:Runtaskonhosts ;
    rdfs:range xsd:string .
hpc:Prophostsinfo rdfs:domain hpc:Hostsinfo ;
    rdfs:range xsd:string .
hpc:Propid rdfs:domain hpc:Id ;
    rdfs:range xsd:string .
hpc:Propconfigurationinfo rdfs:domain hpc:Configurationinfo ;
    rdfs:range xsd:string .
