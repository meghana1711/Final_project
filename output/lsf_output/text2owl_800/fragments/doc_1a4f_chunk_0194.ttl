hpc:Applicationlevelrequirement a owl:Class .
hpc:Queuelevelrequirement a owl:Class .
hpc:Compoundjoblevelrequirement a owl:Class .
hpc:Resourcerequirement a owl:Class .

hpc:hasresourcerequirement a owl:ObjectProperty .
hpc:mergeswith a owl:ObjectProperty .
hpc:overrides a owl:ObjectProperty .

hpc:Resourcerequirement rdfs:subClassOf hpc:Compoundjoblevelrequirement .
hpc:Compoundjoblevelrequirement rdfs:subClassOf hpc:Joblevelrequirement .

hpc:Resourcerequirement rdfs:domain hpc:Joblevelrequirement .
hpc:Resourcerequirement rdfs:domain hpc:Compoundjoblevelrequirement .

hpc:Hasmem rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasduration rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasdecay rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasresourcerequirement rdfs:range hpc:Resourcerequirement .
hpc:Mergeswith rdfs:domain hpc:Joblevelrequirement ;
    rdfs:domain hpc:Applicationlevelrequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:Overrides rdfs:domain hpc:Joblevelrequirement ;
    rdfs:domain hpc:Applicationlevelrequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:Noresourcerequirement a owl:Class .
hpc:hasnoresourcerequirement a owl:ObjectProperty .

hpc:Noresourcerequirement rdfs:subClassOf hpc:Queuelevelrequirement .
hpc:Hasnoresourcerequirement rdfs:domain hpc:Queuelevelrequirement .
