hpc:Job a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Enclosure a owl:Class .
hpc:Balancedallocation a owl:Class .
hpc:Exclusivecomputeunit a owl:Class .
hpc:Resizablejob a owl:Class .
hpc:Autoresizablejob a owl:Class .
hpc:maxcu a owl:ObjectProperty .
hpc:type a owl:DatatypeProperty .
hpc:cutype a owl:DatatypeProperty .
hpc:exclusivity a owl:ObjectProperty .
hpc:cuexclusivity a owl:DatatypeProperty .
hpc:usablecuslots a owl:DatatypeProperty .
hpc:balance a owl:ObjectProperty .
hpc:pref a owl:ObjectProperty .
hpc:bestfit a owl:DatatypeProperty .
hpc:span a owl:ObjectProperty .
hpc:ptile a owl:DatatypeProperty .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Alternativeresourcerequirement a owl:Class .

hpc:Job rdfs:subClassOf rdf:Resource .
hpc:Computeunit rdfs:subClassOf rdf:Resource .
hpc:Enclosure rdfs:subClassOf hpc:Computeunit .
hpc:Balancedallocation rdfs:subClassOf rdf:Resource .
hpc:Exclusivecomputeunit rdfs:subClassOf hpc:Computeunit .
hpc:Resizablejob rdfs:subClassOf hpc:Job .
hpc:Autoresizablejob rdfs:subClassOf hpc:Resizablejob .

hpc:Maxcu rdfs:domain hpc:Job ;
    rdfs:range hpc:Computeunit .
hpc:Type rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:Cutype rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:Exclusivity rdfs:domain hpc:Job ;
    rdfs:range hpc:Cuexclusivity .
hpc:Cuexclusivity rdfs:domain xsd:nonNegativeInteger ;
    rdfs:range hpc:Computeunit .
hpc:Usablecuslots rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Balance rdfs:domain hpc:Job ;
    rdfs:range hpc:Balancedallocation .
hpc:Pref rdfs:domain hpc:Job ;
    rdfs:range hpc:Balancedallocation .
hpc:Bestfit rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Span rdfs:domain hpc:Job ;
    rdfs:range hpc:Balancedallocation .
hpc:Ptile rdfs:domain hpc:Balancedallocation ;
    rdfs:range xsd:positiveInteger .

hpc:Compoundresourcerequirement a owl:Class .
