hpc:FairTreeAlgorithm a owl:Class .
hpc:NormUsage a owl:Class .
hpc:SlurmConfiguration a owl:Class .
hpc:PriorityType a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConfiguration ;
    rdfs:range xsd:string .
hpc:PriorityCalcPeriod a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfiguration ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PriorityCalcPeriodFrequency a xsd:nonNegativeInteger .
hpc:PriortyWeights a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConfiguration ;
    rdfs:range xsd:nonNegativeFloat .
hpc:PriorityWeightsFairshare a xsd:nonNegativeFloat .
hpc:SlurmAccountingDatabase a owl:Class .
hpc:UsageInformation a owl:Class .
hpc:AssignedSharesValues a owl:Class .
hpc:FairTreeRequires a owl:ObjectProperty ;
    rdfs:domain hpc:FairTreeAlgorithm ;
    rdfs:range (hpc:SlurmAccountingDatabase, hpc:UsageInformation, hpc:AssignedSharesValues) .
hpc:ScontrolReconfigureDoesNotImmediatelyRun a owl:ObjectProperty ;
    rdfs:domain hpc:FairTreeAlgorithm ;
    rdfs:range xsd:boolean .
hpc:ImportantNotes a owl:Class .
hpc:AdministratorCarefulConsideration a owl:ObjectProperty ;
    rdfs:domain hpc:ImportantNotes ;
    rdfs:range xsd:string .
hpc:FairTreeRanksAllUsers a owl:ObjectProperty ;
    rdfs:domain hpc:FairTreeAlgorithm ;
    rdfs:range xsd:boolean .
