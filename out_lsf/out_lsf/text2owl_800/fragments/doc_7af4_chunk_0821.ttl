hpc:LSF_HPC_PJL_LOADENV_TIMEOUT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Timeout value in seconds for PJL to load or unload the environment." .

hpc:LSF_HWLOC_DYNAMIC
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables LSF to dynamically load the hardware locality (hwloc) library from system library paths to detect newer hardware." .

hpc:LSF_ID_PORT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The network port number used to communicate with the authentication daemon when LSF_AUTH is set to ident." .

hpc:LSF_IMAGE_INFO_EXPIRE_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the amount of time, in seconds, that the host image information is valid in mosquitto." .
