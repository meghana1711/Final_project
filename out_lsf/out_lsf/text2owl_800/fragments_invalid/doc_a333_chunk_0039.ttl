hpc:LsbSub3Job a owl:Class .
hpc:requeueQ a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Job ;
    rdfs:range xsd:string .
hpc:REQUEUE_Q_SUB_RESET rdf:value "SUB_RESET" .

hpc:lsbSub3Mig a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Job ;
    rdfs:range xsd:integer .

hpc:lsbSub3Pos a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Job ;
    rdfs:range xsd:string .

hpc:tExecEp a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Pos ;
    rdfs:range xsd:string .

hpc:lsbSub3ResizNotifyCmd a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Job ;
    rdfs:range xsd:string .

hpc:LSB_SUB3_RESIZE_NOTIFY_CMD_SUB_RESET rdf:value "SUB_RESET" .

hpc:LsbSub3Run a owl:Class ;
    rdfs:subClassOf hpc:LsbSub3Job .

hpc:RuntimeEstimation a owl:Class ;
    rdfs:subClassOf hpc:LsbSub3Run .

hpc:RUNTIME_ESTIMATION_We rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:RuntimeEstimation ;
    rdfs:range xsd:integer .

hpc:RUNTIME_ESTIMATION_ACC rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:RuntimeEstimation ;
    rdfs:range xsd:integer .

hpc:RUNTIME_ESTIMATION_PERC rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:RuntimeEstimation ;
    rdfs:range xsd:integer .

hpc:LsbSub3Use a owl:Class ;
    rdfs:subClassOf hpc:LsbSub3Run .

hpc:R_SHELL_LIMIT_S rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Use ;
    rdfs:range xsd:boolean .

hpc:LSB_SUB_INTERACTIVE rdf:type owl:Class ;
    rdfs:subClassOf hpc:LsbSub3Job .

hpc:LSB_SUB_SIM_CPUFACTOR rdf:type owl:Class ;
    rdfs:subClassOf hpc:LsbSub3Job .

hpc:SIM_CPUFACTOR rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSubSimCpufactor ;
    rdfs:range
