hpc:SlurmDaemon a owl:Class .
hpc:Slurmctld a hpc:SlurmDaemon ;
  rdfs:subClassOf hpc:SlurmDaemon ;
  rdfs:comment "Slurm Control Daemon." .
hpc:Slurmd a hpc:SlurmDaemon ;
  rdfs:subClassOf hpc:SlurmDaemon ;
  rdfs:comment "Slurm Node Daemon." .

# Slurm Daemon Properties
hpc:daemonState a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmDaemon ;
  rdfs:range xsd:string ;
  rdfs:comment "Current state of the Slurm daemon." .
hpc:isOperative a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmDaemon ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Indicates whether the Slurm daemon is currently operative." .
hpc:isStarting a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmDaemon ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Indicates whether the Slurm daemon is currently being started." .
hpc:hasError a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmDaemon ;
  rdfs:range xsd:string ;
  rdfs:comment "Error message, if any, associated with the Slurm daemon." .

# Slurm Job
hpc:SlurmJob a owl:Class .
hpc:JobId a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Unique identifier for the Slurm job." .
hpc:UserId a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:integer ;
  rdfs:comment "User ID associated with the Slurm job." .
hpc:JobName a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:string ;
  rdfs:comment "Name of the Slurm job." .
hpc:JobState a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:string ;
  rdfs:comment "Current state of the Slurm job." .
hpc:Priority a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Priority of the Slurm job." .
hpc:Partition a owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range xsd:string ;
  rdfs:comment "Partition associated with the Slurm job." .
hpc:AllocNode a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmJob ;
  rdfs:range hpc:AllocNode ;
  rdfs:comment "Nodes allocated for the Slurm job." .
hpc:
