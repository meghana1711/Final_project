hpc:Usergroup a owl:Class .
hpc:GroupName rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string ;
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:groupName ;
    owl:hasValue '_' ;
    owl:allValueFrom (xsd:string "'all'" "'/'") .

hpc:groupname a owl:ObjectProperty .

hpc:GroupMember rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:List ;
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:groupMember ;
    owl:hasValue '_' .

hpc:groupmember a owl:ObjectProperty .

hpc:UserShares rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:List ;
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:userShares ;
    owl:hasValue '_' .

hpc:usershares a owl:ObjectProperty .

hpc:FsPolicy rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string ;
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:fsPolicy ;
    owl:hasValue '_' .

hpc:fspolicy a owl:ObjectProperty .
