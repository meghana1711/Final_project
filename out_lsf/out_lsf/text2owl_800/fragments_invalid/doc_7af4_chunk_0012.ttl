hpc:Hostname a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:hostName ;
                        rdfs:hasValue "" ;
                        owl:minLength 1 ;
                        owl:maxLength 24 ;
                        owl:pattern ^([A-Z][A-Z0-9.-]{1,22}[A-Z0-9])$ ] .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range xsd:string .

hpc:hasalias a owl:ObjectProperty .

hpc:Alias a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:hasAlias ;
                        rdfs:hasValue "" ;
                        owl:minLength 1 ;
                        owl:maxLength 24 ;
                        owl:pattern ^([A-Z0-9.-]{1,24})$ ] .

hpc:aliasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Alias ;
    rdfs:range xsd:string .
