hpc:usePamCreds a owl:DatatypeProperty .
hpc:LsfPamService a owl:Class .
hpc:lsf a hpc:LSF_PAM_SERVICE .
hpc:lsf_clustername a hpc:LSF_PAM_SERVICE .

hpc:haspamservice a owl:ObjectProperty .
hpc:Haspamservice rdfs:domain hpc:Lsf .
hpc:Haspamservice rdfs:range hpc:LsfPamService .

hpc:USE_PAM_CREDS_Y_OR_LIMITS rdf:type owl:Class .
hpc:USE_PAM_CREDS_SESSION rdf:type owl:Class .
hpc:USE_PAM_CREDS_LIMITS_SESSION rdf:type owl:Class .

hpc:UsePamCredsYOrLimits rdfs:subClassOf hpc:UsePamCreds .
hpc:UsePamCredsSession rdfs:subClassOf hpc:UsePamCreds .
hpc:UsePamCredsLimitsSession rdfs:subClassOf hpc:UsePamCreds .

hpc:assumedLSFService rdf:type owl:ObjectProperty .
hpc:Assumedlsfservice rdfs:domain hpc:UsePamCredsYOrLimits .
hpc:Assumedlsfservice rdfs:range hpc:LsfPamService .
hpc:assumedLSFService_Session rdf:type owl:ObjectProperty .
hpc:AssumedlsfserviceSession rdfs:domain hpc:UsePamCredsSession .
hpc:AssumedlsfserviceSession rdfs:range hpc:LsfPamService .
hpc:assumedLSFService_Limits_Session rdf:type owl:ObjectProperty .
hpc:AssumedlsfserviceLimitsSession rdfs:domain hpc:UsePamCredsLimitsSession .
hpc:AssumedlsfserviceLimitsSession rdfs:range hpc:LsfPamService .

# WATCHDOG
hpc:watchdog a owl:DatatypeProperty .
hpc:Scriptfile a owl:Class .
hpc:initdelay a owl:DatatypeProperty .
hpc:period a owl:DatatypeProperty .

hpc:hasscriptfile a owl:ObjectProperty .
hpc:Hasscriptfile rdfs:domain hpc:Watchdog .
hpc:Hasscriptfile rdfs:range hpc:Scriptfile .
hpc:hasinitdelay a owl:DatatypeProperty .
hpc:hasperiod a owl:DatatypeProperty .
