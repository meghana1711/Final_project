# Node
hpc:Node a owl:Class .

hpc:nodeName a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:nodeAddr a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:sockets a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:coresPerSocket a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:threadsPerCore a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:procs a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:state a rdf:Property ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

# Partition
hpc:Partition a owl:Class .

hpc:partitionName a rdf:Property ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:nodes a rdf:Property ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:overSubscribe a rdf:Property ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .

hpc:default a rdf:Property ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .

hpc:state a rdf:Property ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

# CPU Management
hpc:cpuAllocation a owl:Class .
hpc:cpuAllocationType a rdf:Property ;
    rdfs:domain hpc:cpuAllocation ;
    rdfs:range xsd:string .

hpc:cores a rdf:Property ;
    rdfs:domain hpc:cpuAllocation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:nodes a rdf:Property ;
    rdfs:domain hpc:cpuAllocation ;
    rdfs:range xsd:nonNegativeInteger .

