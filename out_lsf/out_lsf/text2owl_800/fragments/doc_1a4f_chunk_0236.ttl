hpc:Computeunittype a owl:Class .
hpc:computeunitschedulingpreference a owl:ObjectProperty .
hpc:Computeunit a owl:Class .
hpc:freeslot a owl:DatatypeProperty .
hpc:Bestfitpreference a owl:Class .
hpc:Configpreference a owl:Class .
hpc:Maxavailpreference a owl:Class .
hpc:Minavailpreference a owl:Class .
hpc:Balancepreference a owl:Class .

hpc:Computeunittype rdfs:subClassOf owl:Class .
hpc:Computeunitschedulingpreference rdfs:domain hpc:Computeunittype ;
                                      rdfs:range hpc:Computeunit .
hpc:Freeslot rdfs:domain hpc:Computeunit ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Bestfitpreference rdfs:subClassOf hpc:Computeunittype .
hpc:Configpreference rdfs:subClassOf hpc:Computeunittype .
hpc:Maxavailpreference rdfs:subClassOf hpc:Computeunittype .
hpc:Minavailpreference rdfs:subClassOf hpc:Computeunittype .
hpc:Balancepreference rdfs:subClassOf hpc:Computeunittype .

hpc:Bestfitpreference rdfs:subClassOf hpc:Computeunittype ;
                      rdfs:comment "Places the job in as few compute units as possible while preferring to use compute units with fewer free slots to reduce fragmentation in the cluster." .
hpc:Configpreference rdfs:subClassOf hpc:Computeunittype ;
                      rdfs:comment "Lists compute units in the order they appear in the ComputeUnit section of lsb.hosts." .
hpc:Maxavailpreference rdfs:subClassOf hpc:Computeunittype ;
                       rdfs:comment "Lists compute units with more free slots first." .
hpc:Minavailpreference rdfs:subClassOf hpc:Computeunittype ;
                       rdfs:comment "Lists compute units with fewer free slots first." .
hpc:Balancepreference rdfs:subClassOf hpc:Computeunittype ;
                      rdfs:comment "Takes precedence over other preferences when used with the keyword balance." .
