hpc:Tag a owl:Class .
hpc:Name a rdf:Property ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:User a rdf:Property ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
hpc:LastUpload a rdf:Property ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:dateTime .
hpc:LastDownload a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:dateTime .

# Tag with unfinished first upload
hpc:Unfinishedupload a owl:Class ;
    rdfs:subClassOf hpc:Tag .
hpc:LastUploadUnspecified a rdf:Property ;
    rdfs:domain hpc:Unfinishedupload ;
    rdfs:range xsd:string .

# LSF data management configuration
hpc:Lsfdatamanagementconfiguration a owl:Class .
hpc:Admins a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:CacheInputGracePeriod a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:nonNegativeInteger .
hpc:CacheOutputGracePeriod a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:nonNegativeInteger .
hpc:CachePermissions a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:FileTransferCmd a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:LSB_TIME_DMD a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LSF_DataHosts a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:LSF_DataPort a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:positiveInteger .
hpc:LSF_LogDir a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:LSF_Log_Mask a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:string .
hpc:CacheAccessControl a rdf:Property ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:boolean .
hpc:Query_NThreads a rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagementconfiguration ;
    rdfs:range xsd:non
