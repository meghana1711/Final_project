hpc:Lim a owl:Class .
hpc:Configurationfile a owl:Class .
hpc:limrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range rdf:Resource .
hpc:reconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range rdf:Resource .
hpc:forcerestart a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:boolean .
hpc:batchmode a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:boolean .
hpc:lsadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range rdf:Resource .
hpc:bctrld a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range rdf:Resource .
hpc:promptconfirmation a owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:boolean .
hpc:Allhosts a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Restartres ;
    rdfs:range xsd:string .
hpc:Res a owl:Class .
hpc:restartres a owl:ObjectProperty ;
    rdfs:domain hpc:Res ;
    rdfs:range hpc:Resource .
hpc:Localhost a owl:Class ;
    rdfs:subClassOf hpc:Resource .
