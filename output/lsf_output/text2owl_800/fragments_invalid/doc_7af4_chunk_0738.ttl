# Domain and Range
hpc:Appliesto rdfs:domain hpc:Bsuboption ;
    rdfs:range hpc:Joboption .
hpc:Hasdelimiter rdfs:domain hpc:Bsuboption ;
    rdfs:range xsd:string .
hpc:Hasvalue rdfs:domain hpc:Joboption ;
    rdfs:range hpc:Cmdoption .
hpc:Hascmd rdfs:domain hpc:Cmdoption ;
    rdfs:range xsd:string .
hpc:Hascwd rdfs:domain hpc:Cwdoption ;
    rdfs:range xsd:string .
