hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hasjobid ;
    rdfs:subClassOf hpc:Hasjobstate ;
    rdfs:subClassOf hpc:Hasexecutionenvironment ;
    rdfs:subClassOf hpc:Hassubmissionhost ;
    rdfs:subClassOf hpc:Hasexecutionhost ;
    rdfs:subClassOf hpc:Hasqueue ;

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;

hpc:jobstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;

hpc:HasJobID rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobid ;

hpc:HasJobState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstate ;

hpc:HasExecutionEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executionenvironment ;

hpc:HasSubmissionHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;

hpc:HasExecutionHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;

hpc:HasQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue ;

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;

hpc:Host a owl:Class ;

hpc:Executionenvironment a owl:Class ;

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Clientorserver ;
    rdfs:range hpc:Job ;

hpc:DefaultQueue a hpc:Queue ;

hpc:lsfSharedir a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;

hpc:clusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;

hpc:logdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;

hpc:maxInfoDirs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger ;
