hpc:Dockerjob a owl:Class .
hpc:containerremoval a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:boolean .

hpc:nethost a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob .

hpc:lsfuserid a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerjob .

hpc:lsfusername a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerjob .

hpc:Unixlinuxpasswordfileformat a owl:Class .
hpc:Unixlinuxpasswordfileformat rdfs:subClassOf owl:Class .

hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:string .

hpc:colon a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:string .

hpc:x a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:string .

hpc:colonx a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:string .

hpc:usernumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixlinuxpasswordfileformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:execDriver a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob .

hpc:Context a owl:Class .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Context .

hpc:Starter a owl:Class ;
    rdfs:subClassOf hpc:Context .

hpc:Controller a owl:Class ;
    rdfs:subClassOf hpc:Context .

hpc:Monitor a owl:Class ;
    rdfs:subClassOf hpc:Context .

hpc:pathtoserverdir a owl:DatatypeProperty ;
    rdfs:domain hpc:ExecDriver .

hpc:dockerImageAffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob .
