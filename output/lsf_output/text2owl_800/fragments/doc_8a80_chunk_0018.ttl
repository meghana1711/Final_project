hpc:Loglevel a owl:Class;
    rdfs:subClassOf owl:Class;
    rdfs:subClassOf hpc:Namedloglevel .

hpc:Namedloglevel a owl:Class .

hpc:LOG_ERR a hpc:LogLevel .
hpc:LOG_WARNING a hpc:LogLevel .
hpc:LOG_INFO a hpc:LogLevel .
hpc:LOG_DEBUG a hpc:LogLevel .
hpc:LOG_DEBUG1 a hpc:LogLevel .
hpc:LOG_DEBUG2 a hpc:LogLevel .
hpc:LOG_DEBUG3 a hpc:LogLevel .

hpc:logmask a owl:ObjectProperty .
hpc:Logmask rdfs:domain hpc:LsLogMask ;
    rdfs:range hpc:Loglevel .

hpc:LS_LOG_MASK a hpc:NamedLogLevel .

hpc:maxstreamfilenumber a owl:DatatypeProperty .
hpc:Maxstreamfilenumber rdfs:domain hpc:LsMaxStreamFileNumber ;
    rdfs:range xsd:integer .

hpc:LS_MAX_STREAM_FILE_NUMBER a xsd:nonNegativeInteger .

hpc:maxstreamsize a owl:DatatypeProperty .
hpc:Maxstreamsize rdfs:domain hpc:LsMaxStreamSize ;
    rdfs:range xsd:decimal .

hpc:LS_MAX_STREAM_SIZE a xsd:nonNegativeInteger .
