hpc:Lsfversion a owl:Class .
hpc:Lsfversion rdfs:subClassOf xsd:nonNegativeInteger .

# Job Killing
hpc:jobkilling a owl:ObjectProperty .
hpc:Jobkilling rdfs:domain hpc:Job .
hpc:Jobkilling rdfs:range hpc:Memorylimit .

# Job ID Display
hpc:jobiddisplay a owl:ObjectProperty .
hpc:Jobiddisplay rdfs:domain hpc:Commandoption .
hpc:Jobiddisplay rdfs:range hpc:Job .
hpc:JobIDDisplay rdfs:subPropertyOf hpc:JobKilling .

# Host Affinity Preferences
hpc:hostaffinitypreferences a owl:ObjectProperty .
hpc:Hostaffinitypreferences rdfs:domain hpc:Commandoption .
hpc:Hostaffinitypreferences rdfs:range hpc:Job .

# JSON Submission
hpc:jsonsubmission a owl:ObjectProperty .
hpc:Jsonsubmission rdfs:domain hpc:Commandoption .
hpc:Jsonsubmission rdfs:range hpc:Job .

# YAML Submission
hpc:yamlsubmission a owl:ObjectProperty .
hpc:Yamlsubmission rdfs:domain hpc:Commandoption .
hpc:Yamlsubmission rdfs:range hpc:Job .

# bsub -gpu Changes

# nocvd
hpc:nocvd a owl:ObjectProperty .
hpc:Nocvd rdfs:domain hpc:Gpuresourcerequirements .
hpc:Nocvd rdfs:range xsd:string .

# block
hpc:block a owl:ObjectProperty .
hpc:Block rdfs:domain hpc:Gpuresourcerequirements .
hpc:Block rdfs:range xsd:string .

# gpack
hpc:gpack a owl:ObjectProperty .
hpc:Gpack rdfs:domain hpc:Gpuresourcerequirements .
hpc:Gpack rdfs:range xsd:string .

# LSF Version 10.1 Fix Pack 11

# Account Name Assignment
hpc:accountnameassignment a owl:ObjectProperty .
hpc:Accountnameassignment rdfs:domain hpc:Commandoption .
hpc:Accountnameassignment rdfs:range hpc:Job .
hpc:AccountNameAssignment rdfs:subPropertyOf hpc:ResourceConnectorAccountName .

# Resource Connector Account Name
hpc:resourceconnectoraccountname a owl:ObjectProperty .
hpc:Resourceconnectoraccountname rdfs:domain hpc:Commandoption .
hpc:Resourceconnectoraccountname rdfs:range hsd:LSFResourceConnectorAccount .

# Account Name Tagging
hpc:accountnametagging a owl:ObjectProperty .
hpc:Accountnametagging rdfs:domain hpc:Resourceconnectorhost .
hpc:Accountnametagging rdfs:range hsd:LSFResourceConnectorAccount .

# ENABLE_RC_ACCOUNT_REQUEST_BY_USER
hpc:enablercaccountrequestbyuser a owl:DatatypeProperty .
hpc:EnableRCAccountRequestByUser rdfs
