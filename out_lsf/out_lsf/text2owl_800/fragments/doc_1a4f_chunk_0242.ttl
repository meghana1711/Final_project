hpc:Exclusivelevel a owl:Class .
hpc:Exclusivelevel rdfs:subClassOf owl:Class .
hpc:Exclusivelevel rdfs:subClassOf hpc:Level .

hpc:Exclusivescope a owl:Class .
hpc:Exclusivescope rdfs:subClassOf owl:Class .

hpc:Exclusivescope rdfs:subClassOf hpc:Scope .

hpc:Intask rdfs:domain hpc:Exclusivescope ;
    rdfs:range hpc:Exclusivelevel .

hpc:Injob rdfs:domain hpc:Exclusivescope ;
    rdfs:range hpc:Exclusivelevel .

hpc:Alljobs rdfs:domain hpc:Exclusivescope ;
    rdfs:range hpc:Exclusivelevel .

hpc:affinity a owl:ObjectProperty .
hpc:Affinity rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinity .

hpc:Affinity a owl:Class .
hpc:Affinity rdfs:subClassOf owl:Class .

hpc:Count rdfs:domain hpc:Affinity ;
    rdfs:range xsd:nonNegativeInteger .

hpc:cpubind a owl:DatatypeProperty .
hpc:Cpubind rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:Numa rdfs:subClassOf hpc:Cpubinding .
hpc:Socket rdfs:subClassOf hpc:Cpubinding .
hpc:Core rdfs:subClassOf hpc:Cpubinding .
hpc:Thread rdfs:subClassOf hpc:Cpubinding .
