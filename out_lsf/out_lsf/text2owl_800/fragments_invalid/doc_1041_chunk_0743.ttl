hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Subgroup a owl:Class .
hpc:Administrator a owl:Class .
hpc:Apspriorityfactor a owl:Class .
hpc:Usershare a owl:Class .

# Object Properties
hpc:hasName an owl:ObjectProperty .
hpc:isSubgroupOf an owl:ObjectProperty .
hpc:isAdminOf an owl:ObjectProperty .
hpc:hasAPSPriorityFactor an owl:ObjectProperty .
hpc:hasUserShare an owl:ObjectProperty .

# Datatype Properties
hpc:hasGroup an owl:DatatypeProperty .
hpc:hasNameValue an owl:DatatypeProperty .

# Domain and Range
hpc:User hpc:Hasname rdfs:domain hpc:Hasname .
hpc:Usergroup hpc:Hasname rdfs:domain hpc:Hasname .
hpc:Subgroup rdfs:subClassOf hpc:Usergroup .
hpc:Subgroup rdfs:domain hpc:Issubgroupof .
hpc:Administrator rdfs:subClassOf hpc:User .
hpc:Apspriorityfactor rdfs:subClassOf hpc:User .
hpc:Usershare rdfs:subClassOf hpc:User .
hpc:Hasgroup rdfs:domain hpc:User .
hpc:Hasgroup rdfs:range xsd:string .
hpc:Hasnamevalue rdfs:domain hpc:User .
hpc:Hasnamevalue rdfs:range xsd:string .
