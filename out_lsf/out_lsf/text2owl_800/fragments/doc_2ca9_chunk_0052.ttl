hpc:LsbParams a owl:Class .
hpc:defaultRcAccountPerProject a owl:ObjectProperty .
hpc:enableRcAccountRequestByUser a owl:ObjectProperty .
hpc:rcAccount a owl:DatatypeProperty .
hpc:Project a owl:Class .
hpc:Account a owl:Class .
hpc:Job a owl:Class .
hpc:ResourceManagement a owl:Class .
hpc:PerConsumerGlobalLimits a owl:Class .
hpc:GlobalLimitScheduling a owl:Class .
hpc:Limit a owl:Class .
hpc:perApp a owl:DatatypeProperty .
hpc:perLicProject a owl:DatatypeProperty .
hpc:perProject a owl:DatatypeProperty .
hpc:perQueue a owl:DatatypeProperty .
hpc:perUser a owl:DatatypeProperty .

hpc:LsbParams rdfs:subClassOf owl:Class .
hpc:DefaultRcAccountPerProject rdfs:domain hpc:LsbParams ;
                                     rdfs:range hpc:Project .
hpc:EnableRcAccountRequestByUser rdfs:domain hpc:LsbParams ;
                                         rdfs:range hpc:Job .
hpc:RcAccount rdfs:domain hpc:Job ;
                    rdfs:range xsd:string .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Account rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .
hpc:ResourceManagement a owl:Class .
hpc:PerConsumerGlobalLimits a owl:Class .
hpc:GlobalLimitScheduling a owl:Class .
hpc:Limit a owl:Class .
hpc:PerApp rdfs:domain hpc:Limit ;
               rdfs:range xsd:string .
hpc:PerLicProject rdfs:domain hpc:Limit ;
                        rdfs:range xsd:string .
hpc:PerProject rdfs:domain hpc:Limit ;
                   rdfs:range xsd:string .
hpc:PerQueue rdfs:domain hpc:Limit ;
                   rdfs:range xsd:string .
hpc:PerUser rdfs:domain hpc:Limit ;
                  rdfs:range xsd:string .
