hpc:DownloadFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Files that implement the fix." .

hpc:FileName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Downloadfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the file." .

hpc:DownloadInstruction
    a owl:ObjectProperty ;
    rdfs:domain hpc:Downloadfile ;
    rdfs:range hpc:Readmefile ;
    rdfs:comment "Instructions to apply the fix." .

hpc:ReadmeFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Readme file downloaded with the fix." .

hpc:NotificationSubscription
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Subscription to notifications about LSF fixes on Fix Central." .

hpc:Product
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Product for which fixes are available." .

hpc:FixPack
    a owl:Class ;
    rdfs:subClassOf hpc:Product ;
    rdfs:comment "Fix Pack for a specific version of a product." .

hpc:IBMFixCentral
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "IBM Fix Central website." .
