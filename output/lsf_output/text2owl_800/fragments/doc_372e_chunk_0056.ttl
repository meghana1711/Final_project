hpc:Expression a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hastime .

hpc:hastime a owl:ObjectProperty ;
    rdfs:domain hpc:Expression ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdf:type .

hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Expression ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive 0 ;
    rdfs:maxInclusive 23 .

hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Expression ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive 0 ;
    rdfs:maxInclusive 59 .

hpc:day a owl:DatatypeProperty ;
    rdfs:domain hpc:Expression ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive 0 ;
    rdfs:maxInclusive 7 .

hpc:Timewindow a owl:Class ;
    rdfs:subClassOf hpc:Hastime ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:HasTime .

hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:HasTime .

hpc:Dailywindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Overnightwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow ;
    rdfs:subClassOf owl:NamedIndividual .
