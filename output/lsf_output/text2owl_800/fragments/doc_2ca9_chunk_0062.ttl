hpc:gpuReq a owl:ObjectProperty .
hpc:GpuReq rdfs:domain hpc:Queue .
hpc:GpuReq rdfs:domain hpc:Application .
hpc:Packscheduling a owl:Class .
hpc:candidatehosts a owl:ObjectProperty .
hpc:Candidatehosts rdfs:domain hpc:Packscheduling .
hpc:candidategpus a owl:ObjectProperty .
hpc:Candidategpus rdfs:domain hpc:Packscheduling .
hpc:sortedhosts a owl:ObjectProperty .
hpc:Sortedhosts rdfs:domain hpc:Packscheduling .
hpc:sortedgpus a owl:ObjectProperty .
hpc:Sortedgpus rdfs:domain hpc:Packscheduling .
hpc:allocatedgpu a owl:ObjectProperty .
