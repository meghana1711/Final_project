hpc:Host a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Host" ;
    rdfs:comment "Represents a host in the host topology." .

hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;
    rdfs:label "hostName" ;
    rdfs:comment "The name of the host." .

hpc:hostType a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;
    rdfs:label "hostType" ;
    rdfs:comment "The host type." .

hpc:hostModel a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;
    rdfs:label "hostModel" ;
    rdfs:comment "The host model." .

hpc:hostCpuf a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal ;
    rdfs:label "cpuFactor" ;
    rdfs:comment "The relative CPU performance factor." .
