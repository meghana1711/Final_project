hpc:Hostgroup a owl:Class .
hpc:Host a owl:Class .
hpc:Cluster a owl:Class .
hpc:Administers hpc:objectproperty .
hpc:Hasname hpc:datatypeproperty .
hpc:Isleasedin hpc:objectproperty .
hpc:Isvirtual hpc:objectproperty .
hpc:Belongsto hpc:objectproperty .
hpc:Hasadmin rdfs:domain hpc:Hostgroup ;
    rdfs:range rdf:List .
hpc:Hasname rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Isleasedin rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Isvirtual rdfs:domain hpc:Host .
hpc:Belongsto rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster .
hpc:Hostgroup rdfs:subClassOf [ a owl:Class ;
    owl:unionOf (hpc:ComputeUnit hpc:HostGroup) ] .
hpc:Computeunit rdfs:subClassOf [ a owl:Class ;
    owl:unionOf (hpc:HostPartition hpc:HostGroup) ] .
hpc:Hostpartition rdfs:subClassOf [ a owl:Class ] .
