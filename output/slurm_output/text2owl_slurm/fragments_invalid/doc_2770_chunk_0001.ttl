hpc:Slurmscheduler a owl:Class.
hpc:Eventtriggeredscheduling a owl:Class.
hpc:defaultqueuedepth a owl:DatatypeProperty;
    rdfs:domain hpc:Eventtriggeredscheduling;
    rdfs:range xsd:nonNegativeInteger.
hpc:schedinterval a owl:DatatypeProperty;
    rdfs:domain hpc:Eventtriggeredscheduling;
    rdfs:range xsd:duration.
hpc:partitionjobdepth a owl:DatatypeProperty;
    rdfs:domain hpc:Eventtriggeredscheduling;
    rdfs:range xsd:nonNegativeInteger.
hpc:jobevaluationorder a owl:ObjectProperty;
    rdfs:domain hpc:Eventtriggeredscheduling;
    rdfs:range hpc:Job.
hpc:jobpending a owl:ObjectProperty;
    rdfs:domain hpc:Eventtriggeredscheduling;
    rdfs:range hpc:Job.
hpc:mainschedulingloop a owl:ObjectProperty;
    rdfs:domain hpc:Slurmscheduler;
    rdfs:range hpc:Eventtriggeredscheduling.
hpc
