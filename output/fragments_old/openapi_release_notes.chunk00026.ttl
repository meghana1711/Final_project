hpc:NodeState a owl:Class .
hpc:nodeStates hpc:NodeState rdfs:subClassOf xsd:string .

hpc:POWERING_UP, hpc:MAINTENANCE, hpc:REBOOT_REQUESTED, hpc:REBOOT_CANCELED, hpc:POWERING_DOWN, hpc:DYNAMIC_FUTURE, hpc:REBOOT_ISSUED, hpc:PLANNED, hpc:INVALID_REG, hpc:POWER_DOWN, hpc:POWER_UP, hpc:POWER_DRAIN, hpc:DYNAMIC_NORM a hpc:NodeState .

hpc:OpenMode a owl:Class .
hpc:openMode hpc:OpenMode rdfs:subClassOf xsd:string .
hpc:APPEND, hpc:TRUNCATE a hpc:OpenMode .

