hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The application profile the job was submitted to." .

hpc:jobcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The job command." .

hpc:detailedhistory a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "Detailed history includes job group modification, the date, and time the job was forwarded and the name of the cluster to which the job was forwarded." .

hpc:initialcheckpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The initial checkpoint period that is specified at the job level with the bsub -k option, or in an application profile with the CHKPNT_INITPERIOD parameter in the lsb.applications file." .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The checkpoint period that is specified at the job level with the bsub -k option, in the queue with the CHKPNT parameter in the lsb.queues file, or in an application profile with the CHKPNT_PERIOD parameter in the lsb.applications file." .

hpc:checkpointdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The checkpoint directory that is specified at the job level with the bsub -k option, in the queue with the CHKPNT parameter in the lsb.queues file, or in an application profile with the CHKPNT_DIR parameter in the lsb.applications file." .

hpc:migrationthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The migration threshold that is specified at the job level, with the bsub -mig option." .

hpc:requestedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "Shows all the resource requirement strings that you specified in the bsub command." .

hpc:executioncwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The actual current working directory (CWD) that is used when job runs." .

hpc:hostfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The path to a user-specified host file that is used when you submitted or modified the job." .

hpc:executionrusage a owl:ObjectProperty ;
    rdfs:domain
