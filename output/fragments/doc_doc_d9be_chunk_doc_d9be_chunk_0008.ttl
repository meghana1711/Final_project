hpc:Job a owl:Class .
hpc:RequiresCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:HasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:HasCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Node a owl:Class .
hpc:AllocatedCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Partition a owl:Class .

hpc:DefaultPartition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Partition .

hpc:SelectType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:SelectTypeParameters rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:HasNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NodeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:NodeName0 a hpc:Node ;
    hpc:NodeName "n0" .
hpc:NodeName1 a hpc:Node ;
    hpc:NodeName "n1" .
hpc:NodeName2 a hpc:Node ;
    hpc:NodeName "n2" .

hpc:JobExample2 a hpc:Job ;
    hpc:RequiresCPUs 6 ;
    hpc:HasTask 2 ;
    hpc:HasCPUs 6 ;
    hpc:HasNodes 1 ;
    hpc:DefaultPartition "default" .

hpc:JobExample3 a hpc:Job ;
    hpc:RequiresCPUs 9 ;
    hpc:HasTask 3 ;
    hpc:HasCPUs 9 ;
    hpc:HasNodes 3 ;
    hpc:DefaultPartition "default" .

hpc:JobExample4 a hpc:Job ;
    hpc:RequiresCPUs 12 ;
    hpc:HasTask 12 ;
    hpc:HasCPUs 12 ;
    hpc:DefaultPartition "default" .
```
