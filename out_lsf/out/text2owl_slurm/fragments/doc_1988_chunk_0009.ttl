hpc:Job a owl:Class .
hpc:runsfor a owl:ObjectProperty .
hpc:Runsfor rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:isahead a owl:ObjectProperty .
hpc:Isahead rdfs:domain hpc:Job ;
                   rdfs:range hpc:Job .
hpc:pinnedtocore a owl:ObjectProperty .
hpc:Pinnedtocore rdfs:domain hpc:Job ;
                   rdfs:range hpc:Core .
hpc:supportscpubinding a owl:ObjectProperty .
hpc:Supportscpubinding rdfs:domain hpc:Resourcemanager .
hpc:releasescpus a owl:ObjectProperty .
hpc:Releasescpus rdfs:domain hpc:Jobaction ;
                   rdfs:range hpc:Cpus .
hpc:suspendsjob a owl:ObjectProperty .
hpc:Suspendsjob rdfs:domain hpc:User ;
                   rdfs:range hpc:Job .
hpc:resumesjob a owl:ObjectProperty .
hpc:Resumesjob rdfs:domain hpc:User ;
                   rdfs:range hpc:Job .
hpc:allocatessamecpus a owl:ObjectProperty .
hpc:Allocatessamecpus rdfs:domain hpc:Job .
hpc:triggersgangscheduling a owl:ObjectProperty .
hpc:scancelcommand a owl:ObjectProperty .
hpc:Scancelcommand rdfs:domain hpc:User ;
                      rdfs:range xsd:string .
hpc:stopsjob a owl:ObjectProperty .
hpc:Stopsjob rdfs:domain hpc:User ;
                   rdfs:range hpc:Job .
hpc:Core a owl:Class .
hpc:Cpus a owl:Class .
hpc:Resourcemanager a owl:Class .
hpc:Jobaction a owl:Class .
hpc:User a owl:Class .
