hpc:Lsfbatchworkloadsystem a owl:Class .
hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbatchworkloadsystem ;
    rdfs:range xsd:string .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:maxjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:runningjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:suspendedbyuserjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:suspendedbysystemjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:reservedjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Lsfbatchworkloadsystemconfiguration a owl:Class .
hpc:checkconfigcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbatchworkloadsystemconfiguration ;
    rdfs:range xsd:string .

hpc:batchsystemstatuscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbatchworkloadsystemconfiguration ;
    rdfs:range xsd:string .

hpc:troubleshootingcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbatchworkloadsystemconfiguration ;
    rdfs:range xsd:string .

hpc:commandreferencecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbatchworkloadsystemconfiguration ;
    rdfs:range xsd:string .

hpc:Batchsystemstatus a owl:Class ;
    rdfs:subClassOf hpc:Lsfbatchworkloadsystem .

hpc:Host a owl:Class .
