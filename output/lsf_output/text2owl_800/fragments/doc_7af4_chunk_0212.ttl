hpc:tmp a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconsumer ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum amount of tmp space available to resource consumers. Specify a value in MB or the unit set in LSF_UNIT_FOR_LIMITS in lsf.conf as a positive integer greater than or equal 0." .

hpc:Nolimit a owl:Class ;
    rdfs:subClassOf hpc:Integervalue .

hpc:Percentage a owl:Class ;
    rdfs:subClassOf hpc:Tmp ;
    rdfs:comment "TMP specified as a percentage." .

hpc:Hosts a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Listed hosts." .

hpc:Queues a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Listed queues." .

hpc:Users a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Listed users or user groups." .

hpc:Projects a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Listed projects." .

hpc:Verticalformat a owl:Class ;
    rdfs:subClassOf hpc:Limitsection ;
    rdfs:comment "In vertical format." .

hpc:Horizontalformat a owl:Class ;
    rdfs:subClassOf hpc:Limitsection ;
    rdfs:comment "In horizontal format." .

hpc:Limitsection a owl:Class ;
    rdfs:subClassOf hpc:Resourceconfiguration ;
    rdfs:comment "A section in the configuration file for setting limits." .
