hpc:Host a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .
hpc:hasSocket an owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range hpc:Socket .
hpc:contains an owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:Core .
hpc:hasThread an owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range hpc:Thread .
hpc:Node a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:hasSocket an owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Socket .
