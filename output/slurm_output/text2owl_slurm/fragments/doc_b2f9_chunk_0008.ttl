hpc:Gpudevicefile a owl:Class .
hpc:Linuxminornumberassignment rdfs:subClassOf hpc:Gpudevicefile .
hpc:Pcibusidassignment rdfs:subClassOf hpc:Gpudevicefile .
hpc:mappingbetweenassignments a owl:ObjectProperty .
hpc:Nondeterministicsystemdependent rdfs:domain hpc:Mappingbetweenassignments ;
                                     rdfs:range xsd:boolean .
hpc:Stableassignment rdfs:domain hpc:Mappingbetweenassignments ;
                      rdfs:range xsd:boolean .
hpc:Afterbootupcheck rdfs:subClassOf hpc:Mappingbetweenassignments .
hpc:Cudadocumentation rdfs:subClassOf hpc:Mappingbetweenassignments ;
                      rdfs:range xsd:string .

hpc:Mps a owl:Class .
hpc:Cudamultiprocessservice rdfs:subClassOf hpc:Mps .
hpc:Resourcesharing rdfs:subClassOf hpc:Mps .
hpc:Job rdfs:subClassOf hpc:Resourcesharing .
hpc:Gpuresource rdfs:subClassOf hpc:Resourcesharing .
hpc:Slurmconf rdfs:subClassOf hpc:Resourcesharing ;
                 rdfs:range xsd:string .
hpc:Gres rdfs:subClassOf hpc:Resourcesharing ;
          rdfs:domain hpc:Slurmconf ;
          rdfs:range xsd:string .
hpc:Nodename rdfs:domain hpc:Gres ;
             rdfs:range xsd:string .
hpc:Gpucount rdfs:domain hpc:Gres ;
             rdfs:range xsd:nonNegativeInteger .
hpc:Mpscount rdfs:domain hpc:Gres ;
             rdfs:range xsd:nonNegativeInteger .
hpc:Gresmps rdfs:subClassOf hpc:Gres .
hpc:Nompsconfiguration rdfs:subClassOf hpc:Gresmps .
hpc:Evenlydistributed rdfs:subClassOf hpc:Gresmps .
hpc:Mpsconfiguration rdfs:subClassOf hpc:Gresmps .
hpc:Name rdfs:domain hpc:Mpsconfiguration ;
             rdfs:range xsd:string .
hpc:Count rdfs:domain hpc:Mpsconfiguration ;
             rdfs:range xsd:nonNegativeInteger .
hpc:File rdfs:domain hpc:Mpsconfiguration ;
             rdfs:range xsd:string .
hpc:Devicefilepath rdfs:domain hpc:File ;
              rdfs:range xsd:string .
hpc:Gpudevice rdfs:domain hpc:File ;
             rdfs:range xsd:string .
hpc:Resourcesavailable rdfs:domain hpc:Gpudevice ;
             rdfs:range xsd:nonNegativeInteger .
