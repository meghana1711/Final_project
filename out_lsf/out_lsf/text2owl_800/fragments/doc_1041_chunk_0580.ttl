hpc:Cpufrequency a owl:Class .
hpc:fairShareScheduling rdf:type owl:ObjectProperty .
hpc:group rdf:type owl:Class .
hpc:jobGroup rdf:type owl:Class .
hpc:Gpuresources a owl:Class .
hpc:PSUSPState rdf:type owl:Class .
hpc:hostBasedMemoryLimit rdf:type owl:ObjectProperty .
hpc:hostFile rdf:type owl:ObjectProperty .
hpc:interactiveJob rdf:type owl:Class .
hpc:pseudoTerminal rdf:type owl:ObjectProperty .
hpc:secureShell rdf:type owl:ObjectProperty .
hpc:shellModeSupport rdf:type owl:ObjectProperty .

hpc:Cpufrequency rdfs:subClassOf owl:Class .
hpc:Fairsharescheduling rdfs:domain hpc:Cpufrequency ;
                             rdfs:range hpc:Group .
hpc:Group rdfs:subClassOf owl:Class .
hpc:Jobgroup rdfs:subClassOf owl:Class .
hpc:Gpuresources rdfs:subClassOf owl:Class .
hpc:Psuspstate rdfs:subClassOf owl:Class .
hpc:Hostbasedmemorylimit rdfs:domain hpc:Cpufrequency ;
                             rdfs:range xsd:decimal .
hpc:Hostfile rdfs:domain hpc:Cpufrequency .
hpc:Interactivejob rdfs:subClassOf owl:Class .
hpc:Pseudoterminal rdfs:domain hpc:Interactivejob ;
                             rdfs:range xsd:boolean .
hpc:Secureshell rdfs:domain hpc:Interactivejob .
hpc:Shellmodesupport rdfs:domain hpc:Interactivejob ;
                             rdfs:range xsd:boolean .
