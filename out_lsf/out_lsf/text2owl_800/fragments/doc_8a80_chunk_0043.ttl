hpc:Project a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Licensedemand a owl:Class .
hpc:Licenseallocation a owl:Class .
hpc:disablepreemption a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:boolean .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range rdf:List .
hpc:servicedomainmember a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range hpc:Project .
hpc:Licensescheduler a owl:Class .
hpc:Projectmode a owl:Class ;
    rdfs:subClassOf hpc:Project .
hpc:Clustermode a owl:Class ;
    rdfs:subClassOf hpc:Project .
