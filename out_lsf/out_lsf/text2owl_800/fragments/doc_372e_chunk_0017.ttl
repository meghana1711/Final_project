hpc:Serviceclass a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A class for service classes." ;
    rdfs:label "ServiceClass" .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .

hpc:goals a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range rdfs:Class ;
    rdfs:comment "The goals of a service class." ;
    rdfs:label "GOALS" .

hpc:accessControl a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range rdfs:Class ;
    rdfs:comment "The access control for a service class." ;
    rdfs:label "ACCESS_CONTROL" .

hpc:autoAttach a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether jobs are automatically attached to the service class." ;
    rdfs:label "AUTO_ATTACH" .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string ;
    rdfs:comment "A description of the service class." ;
    rdfs:label "DESCRIPTION" .

hpc:Proj1 a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "A license project." ;
    rdfs:label "proj1" .

hpc:LicProjects a owl:Class ;
    rdfs:subClassOf rdfs:Resource ;
    rdfs:comment "A class for license projects." ;
    rdfs:label "LIC_PROJECTS" .

hpc:sla1 a hpc:ServiceClass ;
    hpc:NAME "sla1" ;
    hpc:GOALS <http://example.org/hpc#GUARANTEE> ;
    hpc:ACCESS_CONTROL <http://example.org/hpc#LIC_PROJECTS[proj1]> ;
    hpc:DESCRIPTION "A guarantee SLA with access restricted to the license project proj1." ;
    hpc:AUTO_ATTACH "Y" .
