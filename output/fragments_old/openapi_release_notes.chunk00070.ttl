hpc:OpenapiResponse a owl:Class .

# Response content media types
hpc:ApplicationJsonRequest a owl:Class ;
  rdfs:subClassOf hpc:OpenapiResponse .
hpc:ApplicationXYAML a owl:Class ;
  rdfs:subClassOf hpc:OpenapiResponse .
hpc:TextYAML a owl:Class ;
  rdfs:subClassOf hpc:OpenapiResponse .
hpc:ApplicationYAML a owl:Class ;
  rdfs:subClassOf hpc:OpenapiResponse .

# Response content schema
hpc:OpenapiResponseSchema a owl:Class .

# Response content schema reference
hpc:OpenapiResponseSchema $ref a xsd:anyURI .

# POST /slurm/v0.0.42/node/{node_name}
hpc:PostSlurmNodeNodeName a owl:Class ;
  rdfs:subClassOf rdf:Resource .

hpc:postSlurmNodeNodeNameResponse200 a owl:ObjectProperty ;
  rdfs:domain hpc:PostSlurmNodeNodeName ;
  rdfs:range hpc:ApplicationJsonRequest , hpc:ApplicationXYAML , hpc:TextYAML , hpc:ApplicationYAML .

hpc:postSlurmNodeNodeNameResponseDefault a owl:ObjectProperty ;
  rdfs:domain hpc:PostSlurmNodeNodeName ;
  rdfs:range hpc:ApplicationJsonRequest , hpc:ApplicationXYAML , hpc:TextYAML , hpc:ApplicationYAML .

hpc:postSlurmNodeNodeNameDeleteResponse200 a owl:ObjectProperty ;
  rdfs:domain hpc:PostSlurmNodeNodeName ;
  rdfs:range hpc:ApplicationJsonRequest , hpc:ApplicationXYAML , hpc:TextYAML , hpc:ApplicationYAML .

hpc:postSlurmNodeNodeNameDeleteResponseDefault a owl:ObjectProperty ;
  rdfs:domain hpc:PostSlurmNodeNodeName ;
  rdfs:range hpc:ApplicationJsonRequest , hpc:ApplicationXYAML , hpc:TextYAML , hpc:ApplicationYAML .
