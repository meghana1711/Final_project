hpc:Job a owl:Class .
hpc:taskgeometry a owl:ObjectProperty .
hpc:taskid a owl:DatatypeProperty .
hpc:Node a owl:Class .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Taskgeometry rdfs:domain hpc:Job ;
                   rdfs:range xsd:string .
hpc:Taskid rdfs:domain hpc:Job ;
             rdfs:range xsd:nonNegativeInteger .
hpc:Node rdfs:subClassOf owl:Class .

hpc:Taskgeometry rdfs:range rdf:List ;
                   rdfs:range hpc:Taskgroup .
hpc:Taskgroup rdfs:subClassOf owl:Class ;
                 rdfs:range rdf:List ;
                 rdfs:range hpc:Task .

hpc:Taskgeometry rdfs:domain hpc:Job ;
                   rdfs:range hpc:Taskgroup ;
                   rdfs:range hpc:Taskgroup .

hpc:Taskgroup rdfs:subClassOf owl:Class ;
               rdfs:range rdf:List ;
               rdfs:range hpc:Task .

hpc:Task rdfs:subClassOf owl:Class .

hpc:Taskgeometry rdfs:domain hpc:Job ;
                   rdfs:range hpc:Taskgroup ;
                   rdfs:range hpc:Taskgroup .

hpc:Taskgroup rdfs:subClassOf owl:Class ;
               rdfs:range rdf:List ;
               rdfs:range hpc:Task .

hpc:Task rdfs:subClassOf owl:Class .

hpc:Task rdfs:subPropertyOf hpc:TaskGeometry ;
        rdfs:domain hpc:Task .

hpc:TaskID rdfs:subPropertyOf hpc:TaskGeometry ;
          rdfs:domain hpc:Task .

hpc:Task rdfs:range xsd:nonNegativeInteger .

hpc:Node rdfs:subClassOf owl:Class .

hpc:Task rdfs:range hpc:Node .
