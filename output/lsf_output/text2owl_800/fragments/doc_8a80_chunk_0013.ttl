hpc:LsfLicenseSchedulerConfig a owl:Class .
hpc:lmStatInterval a owl:DatatypeProperty .
hpc:LmStatInterval rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Deﬁnes a time interval between calls that LSF License Scheduler makes to collect license usage information from the license manager. Default 60 seconds" .

hpc:lmStatPerFeature a owl:ObjectProperty .
hpc:LmStatPerFeature rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Starting in Fix Pack 15, controls how the blcollect (license collector daemon) command retrieves license usage data from FlexNet license servers. When LM_STAT_PER_FEATURE is set to Y, the blcollect command retrieves usage data for individual licenses from the license server using the lmstat or lmutil -f commands, rather than retrieving data for all features using lmstat or lmutil -a commands. If LM_STAT_PER_FEATURE is set to N, or is not deﬁned, the blcollect command retrieves data for all features by calling the lmstat or lmutil -a commands. LM_STAT_PER_FEATURE only takes effect when the LM_TYPE value is set to FLEXLM. If the LM_TYPE value is set to RLM, then the LM_STAT_PER_FEATURE parameter will be ignored. Conﬁgure the LM_STAT_PER_FEATURE parameter to allow LSF License Scheduler to manage a small set of licenses from a license server that handles hundreds or thousands of licenses. Implementing this parameter may enhance blcollect's data collection capabilities. However, do not use this when LSF License Scheduler manages the bulk of licenses from the license server. Default" .

hpc:lmStatTimeout a owl:DatatypeProperty .
hpc:LmStatTimeout rdfs:domain hpc:LsfLicenseSchedulerConfig ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Sets the timeout value passed to the lmutil lmstat, lmstat, rlmutil rlmstat, or rlmstat command." .
