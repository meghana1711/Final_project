hpc:Job a owl:Class .
hpc:Interactivetask a owl:Class .
hpc:Taskmancommand a owl:Class .
hpc:Displayterminal a owl:Class .
hpc:Checkedoutlicenses a owl:Class .
hpc:Licenseserver a owl:Class .
hpc:portnumber a owl:DatatypeProperty .
hpc:hostname a owl:DatatypeProperty .
hpc:tokenname a owl:DatatypeProperty .
hpc:username a owl:DatatypeProperty .
hpc:display a owl:DatatypeProperty .
hpc:Flexnetlicenses a owl:Class .
hpc:Repriselicensemanager a owl:Class .
hpc:Customizedpreemptionscript a owl:Class .
hpc:lsflicenseschedulerreleaseversion a owl:DatatypeProperty .
hpc:Servicedomain a owl:Class .
hpc:featurename a owl:DatatypeProperty .
hpc:Rlm a owl:Class .
hpc:vendor a owl:DatatypeProperty .
hpc:handle a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Thing .
hpc:Interactivetask rdfs:subClassOf hpc:Job .
hpc:Taskmancommand rdfs:subClassOf owl:ObjectProperty .
hpc:Displayterminal rdfs:subClassOf hpc:Job .
hpc:Checkedoutlicenses rdfs:subClassOf hpc:Job .
hpc:Licenseserver rdfs:subClassOf owl:Thing .

hpc:Portnumber rdfs:domain hpc:Licenseserver ;
                 rdfs:range xsd:integer .
hpc:Hostname rdfs:domain hpc:Licenseserver ;
                 rdfs:range xsd:string .
hpc:Tokenname rdfs:domain hpc:Licenseserver ;
                 rdfs:range xsd:string .
hpc:Username rdfs:domain hpc:Licenseserver ;
                 rdfs:range xsd:string .
hpc:Display rdfs:domain hpc:Licenseserver ;
                 rdfs:range xsd:string .

hpc:Flexnetlicenses rdfs:subClassOf hpc:Checkedoutlicenses .
hpc:Repriselicensemanager rdfs:subClassOf hpc:Checkedoutlicenses .
hpc:Customizedpreemptionscript rdfs:subClassOf owl:ObjectProperty .
hpc:Lsflicenseschedulerreleaseversion rdfs:subClassOf hpc:Repriselicensemanager .

hpc:Servicedomain rdfs:domain hpc:Checkedoutlicenses ;
                 rdfs:range xsd:string .
hpc:Featurename rdfs:domain hpc:Checkedoutlicenses ;
                 rdfs:range xsd:string .
hpc:Vendor rdfs:domain hpc:Rlm ;
                 rdfs:range xsd:string .
hpc:Handle rdfs:domain hpc:Rlm ;
                 rdfs:range xsd:string .
