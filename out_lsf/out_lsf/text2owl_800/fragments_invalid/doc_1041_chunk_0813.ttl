hpc:Managementhost a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The management host is dynamically selected from all hosts in the cluster." .

hpc:selectmanagementhost a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The method used to select the management host in the cluster." .

# LSF Info
hpc:Lsfinfo a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Displays LSF configuration information." .

hpc:displayallinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether to display all LSF configuration information." .

hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the resource." .

hpc:resourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of the resource." .

hpc:resourcedescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range xsd:string ;
    rdfs:comment "The description of the resource." .

hpc:defaultsortorder a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range xsd:string ;
    rdfs:comment "The default sort order for the resource." .

hpc:lsfclusterfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The file that defines the host names." .

hpc:lsfsharedfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The file that defines the cluster names." .

hpc:lsgetclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Gets the name of the current LSF cluster." .

hpc:lsgetmastername a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Gets the name of the master host in the current LSF cluster." .

hpc:lsinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinfo ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Displays LSF conﬁguration information." .

hpc:resourcefilter a owl:ObjectProperty ;
    rdfs:domain hpc:Ls
