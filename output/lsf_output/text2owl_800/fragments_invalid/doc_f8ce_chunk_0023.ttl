hpc:Transfercommand a owl:Class.
hpc:executablebyusers a owl:ObjectProperty.
hpc:Executablebyusers rdfs:domain hpc:Transfercommand;
                        rdfs:range rdf:Resource.

hpc:returnssuccess a owl:ObjectProperty.
hpc:Returnssuccess rdfs:domain hpc:Transfercommand;
                     rdfs:range xsd:integer.

hpc:acceptspathdescriptor a owl:ObjectProperty.
hpc:Acceptspathdescriptor rdfs:domain hpc:Transfercommand;
                            rdfs:range rdf:DataRange.

hpc:acceptshostname a owl:ObjectProperty.
hpc:Acceptshostname rdfs:domain hpc:Pathdescriptor;
                      rdfs:range xsd:boolean.

hpc:DefaultTransferCommand a hpc:TransferCommand;
                             hpc:ExecutableByUsers /data_transfer_nodes;
                             hpc:AcceptsPathDescriptor "/usr/bin/scp"^^xsd:string;
                             rdf:value "/usr/bin/scp"^^xsd:string.

hpc:Datatransfernode a owl:Class.
