    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:sbatchCommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Task .

hpc:HDF5Group a owl:Class ;
    rdfs:subClassOf hpc:HDF5 .

hpc:HDF5DataSet a owl:Class ;
    rdfs:subClassOf hpc:HDF5 .

hpc:HDF5Attribute a owl:DatatypeProperty ;
    rdfs:domain hpc:HDF5Group .

hpc:CSV a owl:Class .
hpc:DataExport a owl:ObjectProperty ;
