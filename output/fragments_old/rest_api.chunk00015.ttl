# Job Information Response
hpc:JobInfoResponse a owl:Class .

# Job Information Response properties
hpc:lastBackfill a owl:ObjectProperty ;
    rdfs:domain hpc:JobInfoResponse ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( xsd:integer ; xsd:boolean ) ] .

hpc:meta a owl:ObjectProperty ;
    rdfs:domain hpc:JobInfoResponse .

hpc:slurm a owl:Class ;
    rdfs:subClassOf hpc:Meta .

hpc:cluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm .

hpc:release a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm .

hpc:version a owl:Class ;
    rdfs:subClassOf hpc:Slurm .

hpc:major a owl:DatatypeProperty ;
    rdfs:domain hpc:Version .

hpc:minor a owl:DatatypeProperty ;
    rdfs:domain hpc:Version .

hpc:micro a owl:DatatypeProperty ;
    rdfs:domain hpc:Version .

hpc:plugin a owl:Class ;
    rdfs:subClassOf hpc:Meta .

hpc:accountingStorage a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin .

hpc:dataParser a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin .

hpc:client a owl:Class ;
    rdfs:subClassOf hpc:Meta .

hpc:source a owl:DatatypeProperty ;
    rdfs:domain hpc:Client .

hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Client .

hpc:group a owl:DatatypeProperty ;
    rdfs:domain hpc:Client .

hpc:command a owl:DatatypeProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range rdf:List .

hpc:job a owl:Class ;
    rdfs:subClassOf hpc:JobInfoResponse .

hpc:container a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

