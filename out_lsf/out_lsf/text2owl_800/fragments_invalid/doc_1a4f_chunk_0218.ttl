hpc:Duration
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Decay
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:decimal .

hpc:ReservationMethod
    a owl:ObjectProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:string .

hpc:DefaultDecay
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range xsd:decimal ;
    rdfs:default (xsd:decimal "0"^^xsd:decimal) .

hpc:NoReservation
    a owl:Class ;
    rdfs:subClassOf hpc:Sharedresource .

hpc:LimitSection
    a owl:Class ;
    rdfs:subClassOf hpc:Sharedresource ;
    rdfs:subClassOf hpc:Noreservation .

hpc:UnsupportedDecayValue
    a owl:Class ;
    rdfs:subClassOf xsd:decimal ;
    rdf:first hpc:Decay ;
    rdf:rest rdf:nil .

hpc:ReserveTotalAmount
    a owl:ObjectProperty ;
    rdfs:domain hpc:Sharedresource ;
    rdfs:range hpc:Amount ;
    rdfs:subPropertyOf hpc:ReservationMethod ;
    rdfs:subPropertyOf hpc:ReserveAmount .

hpc:ReserveAmount
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Amount .

hpc:Amount
    a owl:DatatypeProperty ;
    rdfs:domain hdfs:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Job
    a owl:Class .
