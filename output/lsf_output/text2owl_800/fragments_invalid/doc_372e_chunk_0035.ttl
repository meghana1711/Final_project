hpc:hasProject
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List ;
    rdfs:comment "The projects that belong to a group." .

hpc:share
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer ;
    rdfs:comment "The percentage of shared licenses a project uses." .

hpc:ownership
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupmember ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of licenses a group member owns." .

hpc:ownershipLimit
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of licenses a project can use." .

hpc:nonShared
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupmember ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of non-shared licenses a group member uses exclusively." .

hpc:description
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:string ;
    rdfs:maxLength "64" ;
    rdfs:comment "A brief description of the group." .

hpc:GroupMember
    a owl:Class ;
    rdfs:subClassOf hpc:Project ;
    rdfs:comment "A project that is a member of a group." .

hpc:Project
    a owl:Class ;
    rdfs:subClassOf hpc:Groupmember ;
    rdfs:comment "A project in the hierarchy." .

hpc:groupDistribution
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The top level of the ProjectGroup section hierarchy." .


This is the ontology fragment for the given documentation chunk. It defines classes, properties, and their relationships for the ProjectGroup hierarchy, including properties for shares, ownership, ownership limit, non-shared licenses, and a description. The ontology also includes a property for group distribution, which is used to store the top level of the ProjectGroup section hierarchy.
