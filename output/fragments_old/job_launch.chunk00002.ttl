hpc:JobAccountingRecord a owl:Class .
hpc:Job a owl:Class, rdfs:subClassOf hpc:JobAccountingRecord .
hpc:ExternStep a owl:Class, rdfs:subClassOf hpc:JobStep .
hpc:BatchStep a owl:Class, rdfs:subClassOf hpc:JobStep .
hpc:InteractiveStep a owl:Class, rdfs:subClassOf hpc:JobStep .
hpc:NormalStep a owl:Class, rdfs:subClassOf hpc:JobStep .

hpc:hasJob a owl:ObjectProperty, rdfs:domain hpc:JobAccountingRecord ;
        rdfs:range hpc:Job .

hpc:hasExternStep a owl:ObjectProperty, rdfs:domain hpc:Job ;
        rdfs:range hpc:ExternStep .
hpc:hasBatchStep a owl:ObjectProperty, rdfs:domain hpc:Job ;
        rdfs:range hpc:BatchStep .
hpc:hasInteractiveStep a owl:ObjectProperty, rdfs:domain hpc:Job ;
        rdfs:range hpc:InteractiveStep .
hpc:hasNormalStep a owl:ObjectProperty, rdfs:domain hpc:Job ;
        rdfs:range hpc:NormalStep .

hpc:hasPrologFlags a owl:DatatypeProperty, rdfs:domain hpc:ExternStep ;
    rdfs:range xsd:string .
hpc:isBatchStep a owl:DatatypeProperty, rdfs:domain hpc:JobStep ;
    rdfs:range xsd:boolean .
hpc:isInteractiveStep a owl:DatatypeProperty, rdfs:domain hpc:JobStep ;
    rdfs:range xsd:boolean .
```
