hpc:Host a owl:Class .
hpc:Queue a owl:Class .

hpc:hasdispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:Dispatchwindow a owl:Class .
hpc:starttime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

hpc:queuedispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .

hpc:Jobdeadlineconstraint a owl:Class .
hpc:runwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
hpc:terminationtime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

hpc:Jobtimebasedresourceusagelimit a owl:Class .
hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Queue subClassOf hpc:Resource .
hpc:Host subClassOf hpc:Resource .
