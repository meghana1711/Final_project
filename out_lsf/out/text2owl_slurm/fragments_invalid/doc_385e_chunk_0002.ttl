hpc:Socketmemory a owl:Class.
hpc:Corememory a owl:Class.
hpc:Cpumemory a owl:Class.

hpc:oversubscribe a owl:DatatypeProperty;
    rdfs:domain hpc:Crsocketmemory.
    rdfs:domain hpc:Crcorememory.
    rdfs:domain hpc:Crcpumemory.
    rdfs:range xsd:string.

hpc:defmempergpu a owl:DatatypeProperty;
    rdfs:domain hpc:Crcpumemory.
    rdfs:range xsd:nonNegativeInteger.
