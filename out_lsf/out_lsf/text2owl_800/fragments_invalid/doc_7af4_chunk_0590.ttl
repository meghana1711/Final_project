hpc:Usergroup a owl:Class .
hpc:Group a owl:Class .
hpc:pergroupjobslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:nonNegativeInteger .
hpc:peruserjobslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:perprocessorjobslotlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:nonNegativeReal .
hpc:HasSubgroup rdf:Property ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Group .
hpc:IncludesKeyword rdf:Property ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:string .
hpc:IsAllUserGroup rdf:Property ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:boolean .
hpc:HasDefaultJobSlotLimit rdf:Property ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:EnforceOneUGLimit rdf:Property ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:boolean .
