hpc:JobLimit a owl:Class .
hpc:Preempt a owl:Class .
hpc:Factor a owl:DatatypeProperty .
hpc:GraceTime a xsd:nonNegativeInteger .

hpc:exemptTime a owl:ObjectProperty .
hpc:list a owl:ObjectProperty .
hpc:mode a owl:ObjectProperty .

hpc:count a owl:DatatypeProperty .
hpc:accruing a owl:DatatypeProperty .

hpc:JobLimit_count rdfs:domain hpc:JobLimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:count .

hpc:JobLimit_accruing rdfs:domain hpc:JobLimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:accruing .

hpc:Preempt_exemptTime rdfs:domain hpc:Preempt ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:exemptTime .

hpc:Preempt_list rdfs:domain hpc:Preempt ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:list .

hpc:Preempt_mode rdfs:domain hpc:Preempt ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf rdf:list .

hpc:WallClock a hpc:JobLimit ;
    hpc:count 5 ;
    hpc:set true ;
    hpc:infinite true .

hpc:activeJobs a hpc:JobLimit ;
    hpc:count 5 ;
    hpc:set true ;
    hpc:infinite true .

hpc:factor a xsd:float .

hpc:preempt a hpc:Preempt ;
    hpc:mode [ rdf:first "DISABLED" ; rdf:rest [ rdf:first "DISABLED" ] ] ;
    hpc:exemptTime 5 ;
    hpc:exemptTime rdf:type xsd:nonNegativeInteger ;
    hpc:exemptTime rdf:datatype xsd:integer ;
    hpc:list [ rdf:first "list" ; rdf:rest [ rdf:first "list" ] ] .

hpc:flags a rdf:List .
hpc:name a xsd:string .
hpc:usageThreshold a hpc:JobLimit ;
    hpc:count 2.027123023002322 ;
    hpc:set true ;
    hpc:infinite true .
hpc:description a xsd:string .
hpc:usageFactor a xsd:float .
hpc:priority a hpc:JobLimit ;
    hpc:count 5 ;
    hpc:set true ;
    hpc:infinite true .
hpc:limits a owl:ObjectProperty .
hpc:min a owl:ObjectProperty .
hpc:tres
