hpc:Qos a owl:Class .
hpc:Partition a owl:Class .
hpc:Comment a owl:Class .

hpc:hasLineage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range hpc:Lineage .

hpc:hasCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range hpc:Cluster .

hpc:shares_raw rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tres ;
    rdfs:range xsd:integer .

hpc:max rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Tres ;
    rdfs:range hpc:Max .

hpc:Max rdf:type hpc:Tres_max ;
    rdf:type owl:Class .

hpc:hasJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Max ;
    rdfs:range hpc:Jobs .

hpc:Jobs rdf:type hpc:Tres_max_jobs ;
    rdf:type owl:Class .

hpc:hasTotal rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobs ;
    rdfs:range hpc:Total .

hpc:Total rdf:type hpc:Jobs_total ;
    rdf:type owl:Class .

hpc:hasNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Total ;
    rdfs:range xsd:integer .

