hpc:Job a owl:Class .
hpc:jobpriority a owl:ObjectProperty .
hpc:maxuserpriority a owl:DatatypeProperty .
hpc:defaultsubmissionpriority a owl:DatatypeProperty .
hpc:jobpriorityovertime a owl:DatatypeProperty .
hpc:Jobdependency a owl:Class .
hpc:jobid a owl:DatatypeProperty .
hpc:parent a owl:ObjectProperty .
hpc:parentstatus a owl:DatatypeProperty .
hpc:parentname a owl:DatatypeProperty .
hpc:level a owl:DatatypeProperty .
hpc:child a owl:ObjectProperty .
hpc:childstatus a owl:DatatypeProperty .
hpc:childname a owl:DatatypeProperty .
hpc:pend a owl:DatatypeProperty .
hpc:satisfied a owl:DatatypeProperty .
hpc:condition a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf hpc:Job .
hpc:Jobpriority rdfs:domain hpc:Job ;
                 rdfs:range xsd:decimal .
hpc:Maxuserpriority rdfs:domain hpc:Job ;
                   rdfs:range xsd:decimal .
hpc:Defaultsubmissionpriority rdfs:domain hpc:Job ;
                   rdfs:range xsd:decimal .
hpc:Jobpriorityovertime rdfs:domain hpc:Job ;
                      rdfs:range xsd:decimal .
hpc:Jobdependency rdfs:subClassOf hpc:Job .
hpc:Jobid rdfs:domain hpc:Job ;
               rdfs:range xsd:integer .
hpc:Parent rdfs:domain hpc:Job ;
           rdfs:range hpc:Job .
hpc:Parentstatus rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:Parentname rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:Level rdfs:domain hpc:Job ;
           rdfs:range xsd:integer .
hpc:Child rdfs:domain hpc:Job ;
         rdfs:range hpc:Job .
hpc:Childstatus rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:Childname rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:Pend rdfs:domain hpc:Job ;
           rdfs:range xsd:string .
hpc:Satisfied rdfs:domain hpc:Job ;
           rdfs:range xsd:string .
hpc:Condition rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
