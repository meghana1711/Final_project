hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Limit a owl:Class .
hpc:perhost a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Host .
hpc:perlicproject a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range rdf:List .
hpc:licprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Licproject .
hpc:All a owl:NamedIndividual ;
    hpc:PerHost rdf:nil .
hpc:not a owl:ObjectProperty ;
    rdfs:domain hpc:All ;
    rdfs:range hpc:Host .
hpc:Licproject a owl:Class ;
    rdfs:subClassOf hpc:String .
hpc:Limitspecification a owl:Class ;
    rdfs:subClassOf hpc:Namedindividual .
hpc:perlicprojectspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Limitspecification ;
    rdfs:range rdf:List .
hpc:licprojectnamespecification a owl:DatatypeProperty ;
    rdfs:domain hpc:Licprojectspecification ;
    rdfs:range hpc:Licprojectname .
