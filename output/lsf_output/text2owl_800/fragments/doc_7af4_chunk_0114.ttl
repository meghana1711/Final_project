hpc:absRunlimit a owl:DatatypeProperty .
hpc:AbsRunlimit rdfs:domain hpc:Jobprofile ;
                  rdfs:range xsd:string .

hpc:Runtime a owl:Class ;
            rdfs:subClassOf hpc:Timelimit .

hpc:EstimatedRuntime a owl:Class ;
                       rdfs:subClassOf hpc:Timelimit .

hpc:runlimit a owl:ObjectProperty ;
             rdfs:domain hpc:Jobprofile ;
             rdfs:range xsd:nonNegativeInteger .

hpc:stacklimit a owl:DatatypeProperty ;
               rdfs:domain hpc:Queue ;
               rdfs:range xsd:nonNegativeInteger .

hpc:Strict a owl:Class .
hpc:deprecated a owl:ObjectProperty ;
              rdfs:domain hpc:Parameter ;
              rdfs:range hpc:Boolean .
