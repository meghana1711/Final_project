hpc:Resource a owl:Class .
hpc:Builtinresource a owl:Class .
hpc:Externalresource a owl:Class .

# Object Properties
hpc:hasname a owl:ObjectProperty .
hpc:hasstatus a owl:ObjectProperty .
hpc:hasr15s a owl:ObjectProperty .
hpc:hasr1m a owl:ObjectProperty .
hpc:hasr15m a owl:ObjectProperty .
hpc:hasut a owl:ObjectProperty .
hpc:haspg a owl:ObjectProperty .
hpc:hasls a owl:ObjectProperty .
hpc:hasit a owl:ObjectProperty .
hpc:hasio a owl:ObjectProperty .
hpc:hastmp a owl:ObjectProperty .
hpc:hasswp a owl:ObjectProperty .
hpc:hasmem a owl:ObjectProperty .
hpc:hasgpustatus a owl:ObjectProperty .
hpc:hasgpuerror a owl:ObjectProperty .

# Datatype Properties
hpc:width a owl:DatatypeProperty .
hpc:units a owl:DatatypeProperty .

# Domain and Range
hpc:Hasname rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:Hasstatus rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasr15s rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasr1m rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasr15m rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasut rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Haspg rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasls rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasit rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasio rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hastmp rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasswp rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasmem rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasgpustatus rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Hasgpuerror rdfs:domain hpc:Builtinresource ;
    rdfs:range xsd:string .
hpc:Width rdfs:domain hpc:Fielddefinition ;
    rdfs
