hpc:Craylinuxmachine a owl:Class .
hpc:Cluster a owl:Class .
hpc:hostbasedresourceusage a owl:ObjectProperty .
hpc:LsfHpcExtensions rdfs:domain hpc:Craylinuxmachine ;
    rdfs:range xsd:string .
hpc:resourceutilityreporting a owl:ObjectProperty .
hpc:lsfCrayRurDir a owl:DatatypeProperty .
hpc:RurDirContainsaccountingfiles rdfs:domain hpc:Resourceutilityreporting ;
    rdfs:range xsd:boolean .
hpc:RurOutputfile rdfs:domain hpc:Resourceutilityreporting ;
    rdfs:range xsd:string .
hpc:Ibmspectrumlsf a owl:Class .
hpc:Apachespark a owl:Class .
hpc:integration a owl:ObjectProperty .
hpc:Apachesparkintegration rdfs:subClassOf hpc:Integration ;
    rdfs:domain hpc:Ibmspectrumlsf .
hpc:deployapachespark a owl:ObjectProperty .
hpc:preparelsf a owl:ObjectProperty .
hpc:preparesparkapplication a owl:ObjectProperty .
hpc:buildsparkapplication a owl:ObjectProperty .
hpc:submitsparkapplication a owl:ObjectProperty .
hpc:runsparkshell a owl:ObjectProperty .
hpc:interactivejob a owl:ObjectProperty .
hpc:IbmSpectrumLsfWithApacheSpark a owl:Class .
hpc:Apachehadoop a owl:Class .
hpc:Inmemoryclustercomputingsystem a owl:Class .
hpc:highlevelapis a owl:ObjectProperty .
hpc:javascalapython a owl:DatatypeProperty .
hpc:optimizedengine a owl:ObjectProperty .
hpc:generalexecutiongraphs a owl:DatatypeProperty .
hpc:sparksql a owl:ObjectProperty .
hpc:sparkstreaming a owl:ObjectProperty .
hpc:mlib a owl:ObjectProperty .
