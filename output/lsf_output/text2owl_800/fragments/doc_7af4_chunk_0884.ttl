hpc:lsfShiftJisInput a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:boolean .

hpc:lsfStrictChecking a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSFConfigurationProperty .

hpc:LSF_STRICT_CHECKING_Y a owl:NamedIndividual ;
    hpc:LSF_STRICT_CHECKING "Y" .

hpc:LSF_STRICT_CHECKING_N a owl:NamedIndividual ;
    hpc:LSF_STRICT_CHECKING "N" .

hpc:LSF_STRICT_CHECKING_ENHANCED a owl:NamedIndividual ;
    hpc:LSF_STRICT_CHECKING "ENHANCED" .

hpc:Lsfconfiguration a owl:Class .
hpc:lsfconfigurationproperty a owl:ObjectProperty .
