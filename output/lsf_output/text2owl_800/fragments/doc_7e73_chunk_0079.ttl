hpc:LsfTop a owl:Class .
hpc:Conf a owl:Class .
hpc:lsf_conf a hpc:conf .
hpc:lsbRcExternalHostFlag a owl:DatatypeProperty .
hpc:LsbRcExternalHostFlag rdfs:domain hpc:LsfConf ;
                                 rdfs:range xsd:string .
hpc:rcHosts a owl:ObjectProperty .
hpc:RcHosts rdfs:domain hpc:Queue ;
                              rdfs:range xsd:string .
hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf hpc:Resource .
hpc:Resource a owl:Class .
hpc:borrowingenabled a owl:ObjectProperty .
hpc:Borrowingenabled rdfs:domain hpc:Queue ;
                             rdfs:range xsd:boolean .
hpc:lsfDynamicHostWaitTime a owl:DatatypeProperty .
hpc:LsfDynamicHostWaitTime rdfs:domain hpc:LsfConf ;
                                      rdfs:range xsd:nonNegativeInteger .
