hpc:jobinputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:jobcommandfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:Lsfspooleddirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Directory created and removed by LSF for spooling job files." .

hpc:readablewritablebyalljobsubmissionusers a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfspooleddirectory ;
    rdfs:range rdf:XMLLiteral .

hpc:jobspoolingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfspooleddirectory ;
    rdfs:range rdf:XMLLiteral .

hpc:Jobsubmissionuser a owl:Class .

hpc:LSBCmdDir a hpc:LSFSpooledDirectory ;
    hpc:Jobcommandfile hpc:jobsubmissionuser .

hpc:LSFIndir a hpc:LSFSpooledDirectory ;
    hpc:Jobinputfile hpc:jobsubmissionuser .

hpc:Job a owl:Class .
