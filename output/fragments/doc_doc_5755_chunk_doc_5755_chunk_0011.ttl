hpc:Node a owl:Class .
hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Allocation a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .
hpc:NodeHasCore rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Core .
hpc:CoreHasThread rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range hpc:Thread .
hpc:NodeHasAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Allocation .
hpc:AllocationHasJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range hpc:Job .
hpc:JobHasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .
hpc:NodeHasThreadsPerCore rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .
hpc:JobHasThreadsPerCoreViaCore rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Core .
hpc:TaskHasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Node .
hpc:DistributionMethod a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdf:type owl:Class .
hpc:ArbitraryDistribution a hpc:DistributionMethod .
hpc:TaskLayout a owl:Class .
hpc:TaskLayoutOnNode a hpc:TaskLayout ;
    rdfs:subClassOf owl:FunctionalClass .
hpc:TaskLayoutOnNodeHasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TaskLayoutOnNode ;
    rdfs:range hpc:Node .
hpc:TaskLayoutOnNodeHasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TaskLayoutOnNode ;
    rdfs:range hpc:Task .
hpc:TaskLayoutOnNodeHasIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:TaskLayoutOnNode ;
    rdfs:range xsd:nonNegativeInteger .
```
