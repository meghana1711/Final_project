hpc:SlurmUser
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdf:type owl:Restriction ;
                       rdfs:domain hpc:SlurmUser ;
                       owl:onProperty hpc:executesAs ;
                       owl:hasValue "root" ] ;
    rdfs:subClassOf [ a owl:Class ;
                       rdf:type owl:Restriction ;
                       rdfs:domain hpc:SlurmUser ;
                       owl:onProperty hpc:sameAsOnAllClusters ] ;
    rdfs:subClassOf [ a owl:Class ;
                       rdf:type owl:Restriction ;
                       rdfs:domain hpc:SlurmUser ;
                       owl:onProperty hpc:differsFromSlurmctld ;
                       owl:hasValue "root" ] ;
    rdfs:subClassOf [ a owl:Class ;
                       rdf:type owl:Restriction ;
                       rdfs:domain hpc:SlurmUser ;
                       owl:onProperty hpc:needsAccountingAdminLevel ;
                       owl:hasValue xsd:string ] .

hpc:SlurmUser rdfs:subClassOf owl:NamedIndividual .

hpc:executesAs
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser ;
    rdfs:range xsd:string .

hpc:sameAsOnAllClusters
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser ;
    rdfs:range xsd:string .

hpc:differsFromSlurmctld
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser ;
    rdfs:range xsd:boolean .

hpc:needsAccountingAdminLevel
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmUser ;
    rdfs:range xsd:string .

hpc:StorageHost
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:StorageLoc
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf [ a owl:Class ;
                       rdf:type owl:Restriction ;
                       rdfs:domain hpc:StorageLoc ;
                       owl:onProperty hpc:hasNoSlash ] .

hpc:StorageLoc rdfs:subClassOf owl:DatatypeProperty .

hpc:StoragePass
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:StoragePort
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:hasNoSlash
    a owl:ObjectProperty ;
    rdfs:domain hpc:StorageLoc ;
    rdfs:range xsd:boolean .
```
