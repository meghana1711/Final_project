hpc:Job a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:Submitjob hpc:a owl:ObjectProperty .
hpc:Serviceclass hpc:Submitjob rdfs:domain hpc:Job ;
                                rdfs:range hpc:Serviceclass .
hpc:Runtime hpc:Submitjob rdfs:domain hpc:Job ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:Sla hpc:Submitjob rdfs:domain hpc:Job ;
              rdfs:range hpc:Serviceclass .
hpc:Forwardedcluster hpc:Sla rdfs:domain hpc:Sla ;
                      rdfs:range hpc:Cluster .
hpc:Serviceclassname hpc:Sla rdfs:domain hpc:Sla ;
                      rdfs:range xsd:string .
hpc:Serviceclassexistence hpc:Sla rdfs:subClassOf hpc:Sla .
hpc:Usermembership hpc:Sla rdfs:subClassOf hpc:Sla .
hpc:Timewindow hpc:Sla rdfs:subClassOf hpc:Sla .
hpc:Activesla hpc:Sla a owl:Class ;
                   rdfs:subClassOf hpc:Sla .
hpc:activeSLA rdfs:subPropertyOf hpc:active .
hpc:Inactivesla a owl:Class ;
                 rdfs:subClassOf hpc:Sla .
hpc:inactiveSLA rdfs:subPropertyOf hpc:inactive .
hpc:Serviceclassexists hpc:sla rdfs:subPropertyOf hpc:serviceClassExistence .
hpc:Userismember hpc:sla rdfs:subPropertyOf hpc:userMembership .
hpc:Outsidetimewindow hpc:sla rdfs:subPropertyOf hpc:inactiveSLA .
