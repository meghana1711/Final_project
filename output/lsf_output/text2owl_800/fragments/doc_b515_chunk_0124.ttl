hpc:Resourcereservation a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .
hpc:users a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .
hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .
hpc:timeWindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .

hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Reservation a owl:Class .

hpc:cancreatereservation a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Reservation .
hpc:candeletereservation a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Reservation .
