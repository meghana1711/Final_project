hpc:Packagetop a owl:Class .
hpc:Workloadsnapshot a owl:Class .
hpc:Lsfconfiguration a owl:Class .
hpc:Experiment a owl:Class .

hpc:hasvolumemountingoutside a owl:ObjectProperty .
hpc:hasvolumemountinginside a owl:ObjectProperty .
hpc:Path rdfs:domain hpc:Volumemounting .
hpc:Path rdfs:range xsd:string .

hpc:Packagetop rdfs:subClassOf [ a owl:Class ;
                                  rdfs:comment "Full directory created when extracting the original installation package" ] .

hpc:Workloadsnapshot rdfs:subClassOf [ a owl:Class ;
                                         rdfs:comment "Set of job submissions and completion records imported from the LSF cluster events files" ] .

hpc:Lsfconfiguration rdfs:subClassOf [ a owl:Class ;
                                         rdfs:comment "Full set of LSF cluster configurations and workload policies" ] .

hpc:Experiment rdfs:subClassOf [ a owl:Class ;
                                   rdfs:comment "LSF simulation run that uses a selected LSF configuration and workload snapshot" ] .

hpc:PackagetopOutside hpc:hasvolumemountingoutside rdf:Property .
hpc:PackagetopInside hpc:hasvolumemountinginside rdf:Property .

hpc:PackagetopOutside rdfs:domain hpc:Packagetop .
hpc:PackagetopInside rdfs:domain hpc:Packagetop .

hpc:WorkloadsnapshotPath hpc:hasvolumemountinginside rdf:Property .
hpc:LsfconfigurationPath hpc:hasvolumemountingoutside rdf:Property .

hpc:WorkloadsnapshotPath rdfs:domain hpc:Workloadsnapshot .
hpc:LsfconfigurationPath rdfs:domain hpc:Lsfconfiguration .

hpc:WorkloadsnapshotPath rdfs:range xsd:string .
hpc:LsfconfigurationPath rdfs:range xsd:string .

hpc:OutsideContainer hpc:hasvolumemountingoutside rdf:Property .
hpc:InsideContainer hpc:hasvolumemountinginside rdf:Property .

hpc:OutsideContainer rdfs:domain hpc:Lsfconfiguration .
hpc:InsideContainer rdfs:domain hpc:Lsfpredictorservice .

hpc:OutsideContainer rdfs:range xsd:string .
hpc:InsideContainer rdfs:range xsd:string .
