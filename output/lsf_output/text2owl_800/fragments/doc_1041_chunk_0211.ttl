hpc:Bhostscommand a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Detailedbhostsoutput a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Customizedoutputformat a owl:Class ;
    rdfs:subClassOf owl:Class .

# Object Properties
hpc:hasoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostscommand ;
    rdfs:range hpc:Option .

hpc:appliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Option ;
    rdfs:range hpc:Bhostscommand .

# Datatype Properties
hpc:hasfield a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:haswidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:justification a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string .

hpc:isunlimited a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:boolean .

hpc:truncates a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:boolean .

hpc:hasallfields a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:boolean .
