hpc:LaunchTemplate
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an AWS launch template." .

hpc:Efa
    a owl:Class ;
    rdfs:comment "Specifies whether an Enhanced Networking (EFA) network interface is attached to the template." .

hpc:NonEFA
    a owl:Class ;
    rdfs:subClassOf hpc:Efa ;
    rdfs:comment "Represents a non-EFA network interface." .

hpc:EFAInterface
    a owl:ObjectProperty ;
    rdfs:domain hpc:Launchtemplate ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The EFA interface associated with the launch template." .

hpc:DefaultNetworkInterface
    a owl:Class ;
    rdfs:subClassOf hpc:Efainterface ;
    rdfs:comment "The default value for EFA interface, which specifies a non-EFA network interface." .

hpc:SecurityGroupId
    a owl:ObjectProperty ;
    rdfs:domain hpc:Launchtemplate ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of AWS security groups applied to instances." .

hpc:OptionalSecurityGroupId
    a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:SecurityGroupId ;
    rdfs:comment "An optional security group ID." .

hpc:DefaultSecurityGroup
    a owl:Class ;
    rdfs:comment "The default security group used if no securityGroupIds are specified." .

hpc:InstanceProfile
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "An AWS IAM instance profile to assign to the requested instance." .

hpc:ShortInstanceProfile
    a owl:Class ;
    rdfs:subClassOf hpc:Instanceprofile ;
    rdfs:comment "An instance profile specified by a short name." .

hpc:ShortName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Shortinstanceprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The short name of the instance profile." .

hpc:ARN
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Instanceprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The AWS Amazon Resource Name (ARN) of the instance profile." .

hpc:InstanceTag
    a owl:ObjectProperty ;
    rdfs:domain hpc:Launchtemplate ;
    rdfs:range rdf:List ;
    rdfs:comment "A string that represents a list of keys and their values used to tag the instance." .

hpc:KeyValuePair
    a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:comment "A key-value pair used to tag the instance." .

hpc:Key
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Keyvaluepair ;
    rdfs:range xsd:string ;
    rdfs:comment
