hpc:directorychange a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Directory .

hpc:hostchange a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Host .

hpc:postcommand a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Command .

hpc:TaskID rdf:type xsd:string .

hpc:contacttask a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Command ;
    rdfs:subPropertyOf hpc:PostCommand .

hpc:BackgroundCommand rdf:type owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:ForegroundCommand rdf:type owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:exit a owl:ObjectProperty ;
    rdfs:domain hpc:User .
