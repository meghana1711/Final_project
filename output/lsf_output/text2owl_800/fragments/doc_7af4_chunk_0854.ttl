hpc:LsfMasterList a owl:Class .
hpc:LsfServerHosts a owl:Class .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:LsfMasterList ;
    rdfs:range hpc:Host .

hpc:islast a owl:ObjectProperty ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range hpc:Host .

hpc:lsfMasterNslookupTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfMasterList ;
    rdfs:range xsd:integer .

hpc:lsfMaxTryAddHost a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range xsd:integer .

hpc:lsfMcForwardFairshareChargeDuration a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:duration .

hpc:lsfMcNonPrivilegedPorts a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:boolean .
