hpc:Serviceclass a owl:Class .
hpc:hasdescription a owl:DatatypeProperty .
hpc:priority a owl:ObjectProperty .
hpc:usergroup a owl:DatatypeProperty .
hpc:goaltype a owl:DatatypeProperty .
hpc:activewindow a owl:ObjectProperty .
hpc:status a owl:DatatypeProperty .
hpc:throughput a owl:DatatypeProperty .

hpc:Serviceclass rdfs:subClassOf owl:Class .
hpc:Hasdescription rdfs:domain hpc:Serviceclass ;
                     rdfs:range xsd:string .
hpc:Priority rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:decimal .
hpc:Usergroup rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:string .
hpc:Goaltype rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:string .
hpc:Activewindow rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:string .
hpc:Throughput rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:decimal .
