hpc:Useraccountmapping a owl:Class .
hpc:Systemlevelaccountmapping a owl:Class .
hpc:Userlevelaccountmapping a owl:Class .
hpc:proposeusermapping a owl:ObjectProperty .
hpc:acceptusermapping a owl:ObjectProperty .
hpc:Usermap a owl:Class .
hpc:export a owl:DatatypeProperty .
hpc:import a owl:DatatypeProperty .

hpc:Useraccountmapping rdfs:subClassOf owl:Class .
hpc:Systemlevelaccountmapping rdfs:subClassOf hpc:Useraccountmapping .
hpc:Userlevelaccountmapping rdfs:subClassOf hpc:Useraccountmapping .
hpc:Proposeusermapping rdfs:domain hpc:Systemlevelaccountmapping ;
                                 rdfs:range hpc:Usermap .
hpc:Acceptusermapping rdfs:domain hpc:Usermap ;
                             rdfs:range hpc:Usermap .
hpc:Usermap rdfs:domain hpc:Systemlevelaccountmapping ;
               rdfs:range hpc:Userlevelaccountmapping .
hpc:Export rdfs:domain hpc:Usermap ;
             rdfs:range xsd:string .
hpc:Import rdfs:domain hpc:Usermap ;
             rdfs:range xsd:string .
