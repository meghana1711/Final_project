hpc:Histhours a owl:Class .
hpc:hosts a owl:ObjectProperty .
hpc:inuseFromRusage a owl:DatatypeProperty .
hpc:libConntimeout a owl:DatatypeProperty .

rdfs:domain hpc:Histhours rdf:Type rdfs:Resource ;
    rdfs:range xsd:nonNegativeInteger .

rdfs:domain hpc:Hosts rdf:Type rdfs:Resource ;
    rdfs:range rdf:Resource .

rdfs:domain hpc:InuseFromRusage rdf:Type rdf:Boolean .

rdfs:domain hpc:LibConntimeout rdf:Type xsd:nonNegativeInteger .
