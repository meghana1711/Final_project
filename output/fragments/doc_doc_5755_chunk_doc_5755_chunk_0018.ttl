hpc:SSHConnection
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Resource> .

hpc:SshCommand
    a owl:Class ;
    rdfs:subClassOf hpc:SSHConnection ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Seq> ;
    rdfs:domain hpc:SSHConnection ;
    rdfs:range rdf:List ;
    rdfs:comment "A sequence of SSH commands." .

hpc:GitCommand
    a owl:Class ;
    rdfs:subClassOf hpc:SshCommand ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Seq> ;
    rdfs:domain hpc:SSHConnection ;
    rdfs:range rdf:List ;
    rdfs:comment "A sequence of Git commands." .

hpc:Plugin
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Resource> .

hpc:CProgram
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Resource> .

hpc:CompileCommand
    a owl:Class ;
    rdfs:subClassOf hpc:CProgram ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Seq> ;
    rdfs:domain hpc:CProgram ;
    rdfs:range rdf:List ;
    rdfs:comment "A sequence of commands to compile a C program." .

hpc:InstallCommand
    a owl:Class ;
    rdfs:subClassOf hpc:SSHConnection ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Seq> ;
    rdfs:domain hpc:SSHConnection ;
    rdfs:range rdf:List ;
    rdfs:comment "A sequence of commands to install a software." .

hpc:ConfigureCommand
    a owl:Class ;
    rdfs:subClassOf hpc:SSHConnection ;
    rdfs:subClassOf <http://www.w3.org/2000/01/rdf-schema#Seq> ;
    rdfs:domain hpc:SSHConnection ;
    rdfs:range rdf:List ;
    rdfs:comment "A sequence of commands to configure a software." .

