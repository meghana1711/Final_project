hpc:Containerimage a owl:Class .
hpc:imagename a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:string .
hpc:size a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:decimal .
hpc:demand a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:repo a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:string .
hpc:tags a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:string .
hpc:imagenameSize a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range hpc:Containerimage .
hpc:containerimageDemand a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range hpc:Containerimage .
hpc:containerimageRepo a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range hpc:Containerimage .
hpc:containerimageTags a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range hpc:Containerimage .
hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:string .
hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:nctnrs a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lastUsed a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:dateTime .
hpc:totalNjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:pulledTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:dateTime .
hpc:imageId a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:string .

# Default Output
hpc:ContainerimageDefault a owl:Class .
hpc:ContainerimageDefault rdfs:subClassOf hpc:Containerimage .
hpc:ContainerimageDefault hpc:imagenameSize rdfs:subPropertyOf hpc:ContainerImage_ImageName_Size .
hpc:ContainerimageDefault hpc:containerimageDemand rdfs:subPropertyOf hpc:ContainerImage_ContainerImage_Demand .
