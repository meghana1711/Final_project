hpc:Consumer a owl:Class .
hpc:Businessservice rdfs:subClassOf hpc:Consumer .
hpc:Businessprocess rdfs:subClassOf hpc:Consumer .
hpc:Individualuser rdfs:subClassOf hpc:Consumer .
hpc:Lineofbusiness rdfs:subClassOf hpc:Consumer .

hpc:Resource a owl:Class .
hpc:Application rdfs:subClassOf hpc:Resource .

hpc:hasresource a owl:ObjectProperty .
rdf:type rdfs:domain hpc:Consumer .
rdf:type rdfs:range hpc:Resource .

hpc:Resourcegroup a owl:Class .
hpc:hasresourcegroup a owl:ObjectProperty .
rdf:type rdfs:domain hpc:Resource .
rdf:type rdfs:range hpc:Resourcegroup .

hpc:Resourcedistributiontree a owl:Class .
rdf:type rdfs:domain hpc:Cluster .

xsd:string rdfs:range hpc:Resourcegroup .
