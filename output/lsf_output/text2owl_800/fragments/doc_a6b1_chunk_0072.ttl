hpc:Managementhost a owl:Class .
hpc:Managementhost rdfs:subClassOf owl:Class .

hpc:addprincipal a owl:ObjectProperty .
hpc:Addprincipal rdfs:domain hpc:Managementhost .
hpc:Addprincipal rdfs:range rdf:Resource .

hpc:ktadd a owl:ObjectProperty .
hpc:Ktadd rdfs:domain hpc:Managementhost .
hpc:Ktadd rdfs:range rdf:Resource .

hpc:keytabfile a owl:DatatypeProperty .
hpc:Keytabfile rdfs:domain hpc:Managementhost .
hpc:Keytabfile rdfs:range xsd:string .

hpc:principalname a owl:DatatypeProperty .
hpc:Principalname rdfs:domain hpc:Principal .
hpc:Principalname rdfs:range xsd:string .

hpc:principalpassword a owl:DatatypeProperty .
hpc:Principalpassword rdfs:domain hpc:Principal .
hpc:Principalpassword rdfs:range xsd:string .

hpc:realmname a owl:DatatypeProperty .
hpc:Realmname rdfs:domain hpc:Principal .
hpc:Realmname rdfs:range xsd:string .

hpc:Hostprincipal a owl:Class .
hpc:Hostprincipal rdfs:subClassOf hpc:Principal .

hpc:Lsfserverhost a owl:Class .
hpc:Lsfserverhost rdfs:subClassOf hpc:Hostprincipal .

hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfmanagementhost rdfs:subClassOf hpc:Managementhost .
