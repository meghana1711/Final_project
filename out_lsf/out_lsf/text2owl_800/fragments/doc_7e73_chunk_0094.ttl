hpc:LSF_conf
    a owl:Class ;
    rdfs:subClassOf hpc:LsfTop .

hpc:lsf_conf_file
    a owl:Class ;
    rdfs:subClassOf hpc:LsfTop .

hpc:lsf_conf_parameter
    a owl:Class ;
    rdfs:subClassOf hpc:LsfConfFile .

hpc:LSB_RC_EXTERNAL_HOST_FLAG
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConfParameter ;
    rdfs:range xsd:string .

hpc:LSB_RC_EXTERNAL_HOST
    a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:rc_hosts
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsbRcExternalHost ;
    rdfs:range xsd:string .

hpc:queue
    a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:borrowing_enabled
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:lsf_cluster
    a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:dynamic_hosts_enabled
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:boolean .

hpc:LSF_DYNAMIC_HOST_WAIT_TIME
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:nonNegativeInteger .
