hpc:Ratelimiter a owl:Class .
hpc:Token a owl:Class .
hpc:Inusetoken a owl:Class .
hpc:Adminuser a owl:Class .
hpc:Rootadmin a owl:Class .
hpc:Clusteradmin a owl:Class .
hpc:Request a owl:Class .
hpc:Requestcategory a owl:Class .
hpc:Requesttype a owl:Class .
hpc:Queryrequest a owl:Class .
hpc:Submissionrequest a owl:Class .
hpc:Otherrequest a owl:Class .
hpc:hasrequestcategory a owl:ObjectProperty .
hpc:hasrequesttype a owl:ObjectProperty .
hpc:hastokenlimit a owl:DatatypeProperty .
hpc:tokensinuse a owl:DatatypeProperty .
hpc:MaxTokensInUse a xsd:nonNegativeInteger .
hpc:WaitTimeMilliseconds a xsd:nonNegativeInteger .
hpc:RetryLimit a xsd:nonNegativeInteger .
hpc:BypassPolicy a xsd:string .
hpc:HeartbeatInterval a xsd:nonNegativeInteger .
hpc:TokenAgeLimit a xsd:nonNegativeInteger .
hpc:RateLimiterEnabled a xsd:boolean .
hpc:InUseToken_InUseToken a owl:FunctionalProperty .
hpc:RequestInusetoken rdfs:domain hpc:Request ;
                             rdfs:range hpc:Inusetoken .
hpc:InusetokenRequest rdfs:domain hpc:Inusetoken ;
                             rdfs:range hpc:Request .
hpc:RatelimiterTokenlimit rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hpc:Maxtokensinuse .
hpc:RatelimiterWaittime rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hp:WaitTimeMilliseconds .
hpc:RatelimiterRetrylimit rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hpc:Retrylimit .
hpc:RatelimiterBypasspolicy rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hpc:Bypasspolicy .
hpc:RatelimiterHeartbeatinterval rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hpc:Heartbeatinterval .
hpc:RatelimiterTokenagelimit rdfs:domain hpc:Ratelimiter ;
                             rdfs:range hpc:Tokenagelimit .
hpc:RatelimiterRatelimiterenabled rdfs:domain hpc:Ratelimiter ;
                             rdfs:range xsd:boolean .
