hpc:Installation a owl:Class .
hpc:Hasconfigurationmenu rdfs:domain hpc:Installation ;
                            rdfs:range hpc:Installationoptions .
hpc:Installationoptions a owl:Class .
hpc:Enablesoptions rdfs:domain hpc:Installationoptions ;
                      rdfs:range hpc:Option .
hpc:Option a owl:Class .
hpc:Ismysqloption rdfs:subClassOf hpc:Option ;
                rdfs:domain hpc:Installationoptions ;
                rdfs:range xsd:boolean .
hpc:Isguitoolsoption rdfs:subClassOf hpc:Option ;
                rdfs:domain hpc:Installationoptions ;
                rdfs:range xsd:boolean .
