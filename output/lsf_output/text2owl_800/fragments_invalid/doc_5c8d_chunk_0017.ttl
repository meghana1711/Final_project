hpc:Lsfhost a owl:Class .
hpc:WlmHost a hpc:LSFHost .

hpc:Lsfconf a owl:Class .
hpc:Lsbparams a owl:Class .
hpc:Lsbqueue a owl:Class .
hpc:Directdatastaging a owl:Class .

hpc:hasLsfConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Lsfconf .

hpc:hasLsbParams rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Lsbparams .

hpc:hasLsbQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Lsbqueue .

hpc:hasDirectDataStaging rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Directdatastaging .

hpc:lsfconf:LSB_STAGE_IN_EXEC a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .

hpc:lsfconf:LSB_STAGE_OUT_EXEC a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .

hpc:lsfconf:LSB_STAGE_MAX_STAGE_IN a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsfconf:LSB_STAGE_STORAGE a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .

hpc:lsfconf:LSB_STAGE_TRANSFER_RATE a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:decimal .

hpc:lsbparams:ALLOCATION_PLANNER a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:string .

hpc:lsbqueue:QUEUE_NAME a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string .

hpc:lsbqueue:PRIORITY a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbqueue:DATA_TRANSFER a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:xsdboolean .

hpc:lsbqueue:PLAN a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string .

hpc:lsbqueue:HOSTS a owl:DatatypeProperty ;
