hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourcepool ;
    rdfs:comment "A queue from which jobs can borrow resources." .

hpc:Loanpolicy a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Loanpolicytype ;
    rdfs:comment "Policies that govern the loaning of resources from a queue." .

hpc:Loanpolicytype a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Different types of loan policies for queues." .

hpc:CLOSE_ON_DEMAND a hpc:LoanPolicyType ;
    rdfs:comment "LSF stops loaning out from a pool whenever there is pending demand from jobs with guarantees in the pool." .

hpc:DURATION a hpc:LoanPolicyType ;
    rdfs:comment "Allows jobs to borrow resources if the job run limit (or estimated run time) is no larger than the specified minutes." .
    rdfs:domain hpc:Duration .
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of minutes for the duration policy." .

hpc:IDLE_BUFFER a hpc:LoanPolicyType ;
    rdfs:comment "Enables LSF to try to keep idle the specified amount of resources as long as there are unused guarantees." .
    rdfs:domain hpc:IdleBuffer .
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The percentage of resources to be kept idle." .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Loanpolicy ;
    rdfs:range xsd:string ;
    rdfs:comment "A description of the guarantee policy." .

hpc:administrators a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:comment "The administrators of the queue." .
    rdfs:subPropertyOf rdf:list ;
    rdfs:range rdf:List ;
    rdfs:range rdf:List ;
