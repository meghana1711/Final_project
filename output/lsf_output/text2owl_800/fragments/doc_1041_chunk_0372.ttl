hpc:Distribution a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:string .
hpc:configurationfile a owl:ObjectProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:string .
hpc:defaultoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Distribution .
hpc:clusterlocalityoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:boolean .
hpc:licensefeaturetokenname a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:string .
hpc:lmLicenseName a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:string .
hpc:Clusterlocality a owl:Class .
hpc:Clusterlocality rdfs:subClassOf hpc:Distribution .
hpc:Clusterlocality rdfs:subClassOf hpc:Clusterlocalityoutput .
hpc:clusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterlocality ;
    rdfs:range xsd:string .
hpc:Feature a owl:Class .
hpc:Feature rdfs:subClassOf hpc:Licensefeaturetokenname .
hpc:serviceDomain a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .
