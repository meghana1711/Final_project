@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Energypolicytag a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:defaultfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:nodeenergyuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:cpufrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .
hpc:estusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .
hpc:enervar a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .
hpc:estruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .
hpc:runtimevar a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .
hpc:power a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequencydatapoint ;
    rdfs:range xsd:decimal .

hpc:Cpufrequencydatapoint a owl:Class ;
    rdfs:subClassOf hpc:Job .
