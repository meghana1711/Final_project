hpc:Usergroup a owl:Class .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Usergroup .

hpc:Receivejobsqueue a owl:Class .
hpc:Sendjobsqueue a owl:Class ;
    rdfs:subClassOf hpc:Receivejobsqueue .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range hpc:User .

hpc:rcvjobsFrom a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:string .

hpc:sndjobsTo a owl:DatatypeProperty ;
    rdfs:domain hpc:Sendjobsqueue ;
    rdfs:range xsd:string .

hpc:fwdUsers a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:string .

hpc:queueName a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:string .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:integer .

hpc:nice a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:integer .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range xsd:string .

hpc:Remoteonlyqueue a owl:Class .
hpc:remoteonly a owl:ObjectProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range hpc:Remoteonlyqueue .
