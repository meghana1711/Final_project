hpc:Resourcereservation a owl:Class .
hpc:Jobresourcereservation a owl:Class .
hpc:Hostmapping a owl:Class .
hpc:Loadadjustment a owl:Class .
hpc:Interactivejobresourcereservation a owl:Class .

hpc:hasresourcereservation a owl:ObjectProperty .
hpc:Hasjob a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Job .
hpc:Hashost a rdfs:domain hpc:Hostmapping ;
                                rdfs:range hpc:Host .
hpc:Adjustsload a rdfs:domain hpc:Loadadjustment ;
                                rdfs:range hpc:Job .

hpc:Resourcerequirement a owl:Class .
hpc:Consumableresource a owl:Class .
hpc:Nonconsumableresource a owl:Class .
hpc:Multiphaseresource a owl:Class .
hpc:Constantresource a owl:Class .
hpc:Decreasingresource a owl:Class .

hpc:hasresourcerequirement a owl:ObjectProperty .
hpc:Hasconsumableresource a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Consumableresource .
hpc:Hasnonconsumableresource a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Nonconsumableresource .
hpc:Hasmultiphaseresource a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Multiphaseresource .
hpc:Hasconstantresource a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Constantresource .
hpc:Hasdecreasingresource a rdfs:domain hpc:Resourcereservation ;
                                rdfs:range hpc:Decreasingresource .

hpc:Resourcereservationlimit a owl:Class .
hpc:Queueresourcereservationlimit a owl:Class .
hpc:Jobapplicationresourcereservationlimit a owl:Class .

hpc:hasresourcereservationlimit a owl:ObjectProperty .
hpc:Hasqueueresourcereservationlimit a rdfs:domain hpc:Queue ;
                                        rdfs:range hpc:Queueresourcereservationlimit .
hpc:Hasjobapplicationresourcereservationlimit a rdfs:domain hpc:Job ;
                                                rdfs:range hpc:Jobapplicationresourcereservationlimit .

hpc:RESRSV_LIMIT a xsd:nonNegativeInteger .
hpc:RES_REQ a xsd:nonNegative
