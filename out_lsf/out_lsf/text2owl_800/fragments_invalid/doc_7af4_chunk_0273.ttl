hpc:Project a owl:Class .
hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Host a owl:Class .
hpc:jobcwd a owl:ObjectProperty .
hpc:cwd a owl:DatatypeProperty .
hpc:defaultjobcwd a owl:DatatypeProperty .
hpc:submissiondirectory a owl:DatatypeProperty .

hpc:Project rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Usergroup rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .

hpc:Jobcwd rdfs:domain hpc:Job .
hpc:Cwd rdfs:domain hpc:User .
hpc:Defaultjobcwd rdfs:domain hpc:Project .
hpc:Submissiondirectory rdfs:domain hpc:Project .

hpc:Jobcwd rdfs:range xsd:string .
hpc:Cwd rdfs:range xsd:string .
hpc:Defaultjobcwd rdfs:range xsd:string .
hpc:Submissiondirectory rdfs:range xsd:string .

hpc:JobCWD rdf:type owl:ObjectProperty .
hpc:CWD rdf:type owl:DatatypeProperty .
hpc:DefaultJobCWD rdf:type owl:DatatypeProperty .
hpc:SubmissionDirectory rdf:type owl:DatatypeProperty .

hpc:JobCWD "is determined by the following sequence:" rdfs:comment "." .
hpc:CWD "is the current working directory for a user." rdfs:comment "." .
hpc:DefaultJobCWD "is the default job CWD for a project." rdfs:comment "." .
hpc:SubmissionDirectory "is the directory where the job submission takes place." rdfs:comment "." .

hpc:JobCWD "If not defined, LSF goes to steps 2 and 3." rdfs:comment "." .
hpc:CWD "If not defined, LSF goes to steps 3 and 4." rdfs:comment "." .
hpc:DefaultJobCWD "If not defined, LSF goes to step 4." rdfs:comment "." .
hpc:SubmissionDirectory "If not defined, it means there is no CWD and the submission directory will be used instead." rdfs:comment "." .

hpc:JobCWD "For every job, the CWD is determined by the following sequence:" rdfs:comment "1. bsub -cwd. If not deﬁned, LSF goes to steps 2 and 3." .
hpc:CWD "The job CWD will be created by LSF before the job starts running based on CWD parameter values." rdfs:comment "For example:" .
hpc:DefaultJobCWD "LSF only creates the directory if CWD includes dynamic patterns." rdfs:comment "For example:" .
hpc:SubmissionDirectory "Unsupported patterns are treated as text." rdfs:comment "Literals in square brackets (e.g., [%U], [%J_%I]) are considered dynamic patterns." .
