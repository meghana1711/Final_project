hpc:LsfLogMask a owl:Class .
hpc:LsfLogMask rdfs:subClassOf owl:Class .
hpc:LsfLogMask rdfs:subClassOf hpc:Parameter .

hpc:loglevel a owl:ObjectProperty .
hpc:Loglevel rdfs:domain hpc:LsfLogMask ;
                 rdfs:range xsd:string .

hpc:LsfLicSchedHosts a owl:Class .
hpc:LsfLicSchedHosts rdfs:subClassOf owl:Class .
hpc:LsfLicSchedHosts rdfs:subClassOf hpc:Hostlist .

hpc:preemptaction a owl:ObjectProperty .
hpc:Preemptaction rdfs:domain hpc:LsfLicSchedHosts ;
                 rdfs:range xsd:string .

hpc:preemptslotrelease a owl:ObjectProperty .
hpc:Preemptslotrelease rdfs:domain hpc:LsfLicSchedHosts ;
                 rdfs:range xsd:boolean .

hpc:preemptstop a owl:ObjectProperty .
hpc:Preemptstop rdfs:domain hpc:LsfLicSchedHosts ;
                 rdfs:range xsd:boolean .

hpc:Blstat a owl:Class .
hpc:Blstat rdfs:subClassOf owl:Class .
hpc:Blstat rdfs:subClassOf hpc:Command .

hpc:dynamiclicenseinfo a owl:ObjectProperty .
hpc:Dynamiclicenseinfo rdfs:domain hpc:Blstat ;
                 rdfs:range rdf:Resource .
