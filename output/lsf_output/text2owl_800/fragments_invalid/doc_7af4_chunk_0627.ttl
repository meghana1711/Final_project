@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LsbJobidDispLength a owl:Class .
hpc:LsbJobMemlimit a owl:Class .
hpc:LsbJobOutputLogging a owl:Class .
hpc:LsbJobReportMail a owl:Class .
hpc:LsbJobScriptTrapSignals a owl:Class .
hpc:LsbJobTmpdir a owl:Class .
hpc:LsbJobidDispLengthLength rdfs:domain hpc:LsbJobidDispLength ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LsbJobMemlimitEnforcement rdfs:domain hpc:LsbJobMemlimit ;
    rdfs:range xsd:boolean .
hpc:LsbJobOutputLoggingEnabled rdfs:domain hpc:LsbJobOutputLogging ;
    rdfs:range xsd:boolean .
hpc:LsbJobReportMailEnabled rdfs:domain hpc:LsbJobReportMail ;
    rdfs:range xsd:boolean .
hpc:LsbJobScriptTrapSignalsEnabled rdfs:domain hpc:LsbJobScriptTrapSignals ;
    rdfs:range xsd:boolean .
hpc:LsbJobTmpdirPath rdfs:domain hpc:LsbJobTmpdir ;
    rdfs:range xsd:string .
hpc:LsbJobinfoDir a owl:Class .
hpc:LsbJsmDefault a owl:Class .
hpc:LsbKeepDependentJob a owl:Class .
hpc:LsbKeepSysdefRlimit a owl:Class .
hpc:LsbKrbAixLoadIbmNas a owl:Class .
hpc:LsbKrbCheckInterval a owl:Class .
hpc:LsbKrbImpersonate a owl:Class .
hpc:LsbKrbLibPath a owl:Class .
hpc:LsbKrbRenewMargin a owl:Class .
hpc:LsbKrbTgtFwd a owl:Class .
hpc:LsbKrbTgtDir a owl:Class .
hpc:LSB_LOCALDIR a o
