hpc:Ec2fleettemplate a owl:Class .
hpc:templateid a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:string .
hpc:maxnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:string .
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:string .
hpc:awshost a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:boolean .
hpc:ec2fleetconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:string .
hpc:ondemandtargetcapacityratio a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:decimal .
hpc:instancetags a owl:DatatypeProperty ;
    rdfs:domain hpc:Ec2fleettemplate ;
    rdfs:range xsd:string .

hpc:Azureprovconfig a owl:Class .
hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Azureprovconfig ;
    rdfs:range xsd:string .
hpc:azureCredentialFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Azureprovconfig ;
    rdfs:range xsd:string .
hpc:azureRegion a owl:DatatypeProperty ;
    rdfs:domain hpc:Azureprovconfig ;
    rdfs:range xsd:string .

hpc:Azureprovtemplates a owl:Class .
