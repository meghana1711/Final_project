hpc:Queue a owl:Class .
hpc:deactivatequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Resource .
hpc:activatequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Resource .
hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Deactivatequeue, hpc:Activatequeue ;
    rdfs:range xsd:string .
hpc:Allqueues rdfs:subClassOf hpc:Queue .
hpc:Systemdefaultqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:jobdispatch a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .
hpc:queueinactivated a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Boolean .
hpc:queueopen a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Boolean .
