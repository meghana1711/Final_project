hpc:Lsfserver a owl:Class .
hpc:Lsftopdirectory a owl:Class .
hpc:Lsbsharedir a owl:Class .
hpc:Reghostscachefile a owl:Class .
hpc:Hostregistration a owl:Class .
hpc:hasLSFServer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range hpc:Lsfserver .
hpc:hasLSBShareDir rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbsharedir ;
    rdfs:range hpc:Lsfserver .
hpc:hasReghostscacheFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range hpc:Reghostscachefile .
hpc:hasHostRegistration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range hpc:Hostregistration .
hpc:hasHost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostregistration ;
    rdfs:range xsd:string .
hpc:hasIP rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostregistration ;
    rdfs:range xsd:string .
hpc:hasSID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostregistration ;
    rdfs:range xsd:string .
hpc:LSFServer subClassOf hpc:LSFServerOrDirectory .
hpc:LSBShareDir subClassOf hpc:LSFServerOrDirectory .
hpc:LSFTopDirectory subClassOf hpc:LSFServerOrDirectory .
hpc:Lsfserverordirectory rdfs:subClassOf hpc:Resource .
