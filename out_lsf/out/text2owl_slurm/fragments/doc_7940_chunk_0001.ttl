hpc:Federation a owl:Class .
hpc:Cluster a owl:Class .
hpc:Job a owl:Class .
hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Job .
hpc:federationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:addfederation a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:addclustertofederation a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:removeclusterfromfederation a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:modifyfederation a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:addclustertofederationorremove a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:modifyclusterfederation a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Cluster .
hpc:modifyfederationclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Agent ;
    rdfs:range hpc:Federation .
hpc:clusterinfederation a owl:ObjectProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range hpc:Cluster .
hpc:federationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range xsd:string .
