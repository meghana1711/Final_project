@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Guaranteedresourcepool a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .

hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range hpc:Resourcepooltype .

hpc:Resourcepooltype a owl:Class .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcepooltype ;
    rdfs:range rdf:List .
hpc:Distribution rdfs:subPropertyOf hpc:HasResourceDistribution .

hpc:hasresourcedistribution a owl:ObjectProperty .
hpc:Hasresourcedistribution rdfs:domain hpc:Resourcepooltype ;
    rdfs:range hpc:Resourcedistribution .

hpc:Resourcedistribution a owl:Class .
hpc:Serviceclass a owl:Class ;
    rdfs:subClassOf hpc:Resourceclass .
hpc:amount a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcedistribution ;
    rdfs:range xsd:decimal .

hpc:Resource a owl:Class .
hpc:rsrcname a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
    rdfs:range xsd:string .

hpc:Package a owl:Class .
hpc:numslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:nonNegativeInteger .
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:nonNegativeDecimal .

hpc:slots a hpc:ResourcePoolType .
hpc:hosts a hpc:ResourcePoolType .
hpc:package a hpc:ResourcePoolType .

hpc:serviceClass a hpc:Resource .
hpc:rsrc_name a hpc:Resource .
