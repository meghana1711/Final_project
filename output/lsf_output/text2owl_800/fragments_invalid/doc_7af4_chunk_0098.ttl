@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Preexecutioncommand a owl:Class .
hpc:Applicationlevelpreexecutioncommand rdfs:subClassOf hpc:Preexecutioncommand .
hpc:Joblevelpreexecutioncommand rdfs:subClassOf hpc:Preexecutioncommand .
hpc:Queuelevelpreexecutioncommand rdfs:subClassOf hpc:Preexecutioncommand .

hpc:path rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:environmentVariables rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:userAccount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:commandLength rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:integer .

hpc:executionOrder rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range hpc:Preexecutioncommand .

hpc:runUnderShell rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:runDirectory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:outputFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:inputFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:errorFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .

hpc:commandPathLength rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:integer .

hpc:processLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:integer .

hpc:Applicationprofile a owl:Class .
