hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:dependency a owl:ObjectProperty .
hpc:status a owl:DatatypeProperty .
hpc:Queuestatus rdfs:domain hpc:Queue ;
                 rdfs:range xsd:string .
hpc:Jobstatus rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Hasuser rdfs:domain hpc:Job ;
                 rdfs:range hpc:User .
hpc:Isinqueue rdfs:domain hpc:Job ;
                 rdfs:range hpc:Queue .
hpc:Hasdependency rdfs:domain hpc:Job ;
                 rdfs:range hpc:Job .

hpc:Job_preProcess1 a hpc:Job ;
                     hpc:HasUser "userA" ;
                     hpc:IsInQueue "normal" ;
                     hpc:Status "RUN" .
hpc:Job_preProcess2 a hpc:Job ;
                     hpc:HasUser "userA" ;
                     hpc:IsInQueue "normal" ;
                     hpc:Status "RUN" .
hpc:Job_execution1 a hpc:Job ;
                    hpc:HasUser "userA" ;
                    hpc:IsInQueue "normal" ;
                    hpc:Status "RUN" ;
                    hpc:HasDependency <8021> ;
                    hpc:HasDependency <8022> .
hpc:Job_execution2 a hpc:Job ;
                    hpc:HasUser "userA" ;
                    hpc:IsInQueue "normal" ;
                    hpc:Status "RUN" ;
                    hpc:HasDependency <8021> ;
                    hpc:HasDependency <8022> .
hpc:Job_execution3 a hpc:Job ;
                    hpc:HasUser "userA" ;
                    hpc:IsInQueue "normal" ;
                    hpc:Status "RUN" ;
                    hpc:HasDependency <8021> ;
                    hpc:HasDependency <8022> .
hpc:Job_execution4 a hpc:Job ;
                    hpc:HasUser "userA" ;
                    hpc:IsInQueue "normal" ;
                    hpc:Status "RUN" ;
                    hpc:HasDependency <8021> ;
                    hpc:HasDependency <8022> .
hpc:Job_postProcess a hpc:Job ;
                    hpc:HasUser "userA" ;
                    hpc:IsInQueue "normal" ;
                    hpc:Status "RUN" ;
                    hpc:HasDependency <8023> .
