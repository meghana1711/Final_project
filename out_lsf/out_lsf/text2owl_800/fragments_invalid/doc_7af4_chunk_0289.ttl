@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Enablegpuhistruntime a owl:Class .
hpc:EnableGpuHistRunTime rdfs:domain hpc:Enablegpuhistruntime ;
                               rdfs:range xsd:string ;
                               rdfs:subClassOf owl:Enum .

hpc:Enablehistruntimeforfairshare a owl:Class .
hpc:EnableHistRunTime rdfs:domain hpc:Enablehistruntimeforfairshare ;
                               rdfs:range xsd:string ;
                               rdfs:subClassOf owl:Enum .

hpc:Enablehistruntimeforglobalfairsharequeue a owl:Class .
hpc:EnableHistRunTime rdfs:domain hpc:Enablehistruntimeforglobalfairsharequeue ;
                               rdfs:range xsd:string ;
                               rdfs:subClassOf owl:Enum .

hpc:Enablehostintersection a owl:Class .
hpc:EnableHostIntersection rdfs:domain hpc:Enablehostintersection ;
                               rdfs:range xsd:string ;
                               rdfs:subClassOf owl:Enum .

hpc:Enablejobinfobyadminrole a owl:Class .
hpc:EnableJobInfoByAdminRole rdfs:domain hpc:Enablejobinfobyadminrole ;
                                    rdfs:range xsd:string ;
                                    rdfs:subClassOf owl:DatatypeProperty .
