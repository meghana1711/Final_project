@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Clearcasemountdir a owl:Class .
hpc:Clearcaseroot a owl:Class .
hpc:daemonwrapdebug a owl:ObjectProperty .
hpc:elimabortvalue a owl:DatatypeProperty .

rdfs:subClassOf hpc:Clearcasemountdir rdf:Literal .
rdfs:subClassOf hpc:Clearcaseroot rdf:PlainLiteral .

rdfs:domain hpc:Daemonwrapdebug hpc:Clearcasemountdir .
rdfs:range xsd:integer .

rdfs:domain hpc:Elimabortvalue hpc:Elim .
