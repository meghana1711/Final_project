# Job Description
hpc:JobDescMsg a owl:Class .
hpc:segment_size a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .
hpc:resv_mpi_ports a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescMsg ;
    rdfs:range xsd:integer .

# Job Info
hpc:JobInfo a owl:Class .
hpc:cores_per_socket a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:integer .
hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .

# Job States Query Schema
hpc:OpenapiJobStateResp a owl:Class .

# Kill Jobs Messages
hpc:KillJobsMsg a owl:Class .
hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:KillJobsMsg ;
    rdfs:range xsd:string .

# OpenAPI Job Info Response
hpc:OpenapiJobInfoResp a owl:Class .
hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiJobInfoResp ;
    rdfs:range xsd:string .

# Kill Jobs Response
hpc:OpenapiKillJobsResp a owl:Class .

# Kill Jobs Response Message
hpc:KillJobsRespMsg a owl:Class .
