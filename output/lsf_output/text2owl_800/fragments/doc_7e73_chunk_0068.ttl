hpc:Customrole a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Customrole ;
    rdfs:range xsd:string .

hpc:iscustom a owl:DatatypeProperty ;
    rdfs:domain hpc:Customrole ;
    rdfs:range xsd:boolean .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Customrole ;
    rdfs:range xsd:string .

hpc:actions a owl:ObjectProperty ;
    rdfs:domain hpc:Customrole .

hpc:notactions a owl:ObjectProperty ;
    rdfs:domain hpc:Customrole .

hpc:assignablescopes a owl:ObjectProperty ;
    rdfs:domain hpc:Customrole .

hpc:Customrolewithsubscription a owl:Class ;
    rdfs:subClassOf hpc:Customrole .

hpc:Subscription a owl:Class .
