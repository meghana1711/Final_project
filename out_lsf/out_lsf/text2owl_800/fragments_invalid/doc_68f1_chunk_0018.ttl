hpc:Userapplication a owl:Class .
hpc:Jobsubmission a owl:Class .
hpc:MainLicenseFeature owl:ObjectProperty .
hpc:AdditionalLicenseFeature owl:ObjectProperty .
hpc:NumberOfAdditionalFeatures owl:DatatypeProperty .
hpc:Unknownlicenseuse a owl:Class .
hpc:Requestwithoutlsfverification a owl:Class .
hpc:Authorization a owl:Class .
hpc:Licenserequest a owl:Class .
hpc:Projectmode a owl:Class .
hpc:Knownlicenserequirements a owl:Class .
hpc:Rusagesection a owl:Class .
hpc:DefaultReservationDuration owl:DatatypeProperty .
hpc:Dynamicduration a owl:Class .
hpc:Unknownlicenserequirements a owl:Class .
hpc:Managedworkload a owl:Class .
hpc:Enabledynamicrusage a owl:Class .
hpc:Clustermode a owl:Class .
hpc:Knownclusterlicenserequirements a owl:Class .

hpc:Userapplication rdfs:subClassOf owl:Thing .
hpc:Jobsubmission rdfs:subClassOf owl:Thing .
hpc:Mainlicensefeature rdfs:domain hpc:Userapplication ;
                                rdfs:range owl:Resource .
hpc:Additionallicensefeature rdfs:domain hpc:Userapplication ;
                                rdfs:range owl:Resource .
hpc:Numberofadditionalfeatures rdfs:domain hpc:Userapplication ;
                                rdfs:range xsd:nonNegativeInteger .
hpc:Unknownlicenseuse rdfs:subClassOf hpc:Userapplication .
hpc:Requestwithoutlsfverification rdfs:subClassOf hpc:Userapplication .
hpc:Authorization rdfs:subClassOf hpc:Userapplication .
hpc:Licenserequest rdfs:subClassOf hpc:Userapplication .
hpc:Projectmode rdfs:subClassOf owl:Thing .
hpc:Knownlicenserequirements rdfs:subClassOf hpc:Projectmode .
hpc:Rusagesection rdfs:subClassOf hpc:Projectmode .
hpc:Defaultreservationduration rdfs:domain hpc:Rusagesection ;
                                rdfs:range xsd:duration .
hpc:Dynamicduration rdfs:subClassOf hpc:Rusagesection .
hpc:Unknownlicenserequirements rdfs:subClassOf hpc:Projectmode .
hpc:Managedworkload rdfs:subClassOf hpc:Projectmode .
hpc:Enabledynamicrusage rdfs:subClassOf hpc:Projectmode .
hpc:Clustermode rdfs:subClassOf owl:Thing .
hpc:Knownclusterlicenserequirements rdfs:subClassOf hpc:Clustermode .
