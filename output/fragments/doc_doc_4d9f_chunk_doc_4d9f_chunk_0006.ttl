hpc:AfterOkClause a owl:Class .
hpc:AfterNotOkClause a owl:Class .
hpc:ArrayJobId a xsd:string .
hpc:ArrayTaskId a xsd:string .
hpc:SViewCommand a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:CommandOutput .

hpc:MaxArraySize a owl:DatatypeProperty ;
    rdfs:domain hpc:HPCConfiguration .
    rdfs:range xsd:integer .

hpc:JobArray a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:JobArraySize a owl:DatatypeProperty ;
    rdfs:domain hpc:JobArray .
    rdfs:range xsd:integer .

hpc:JobArrayElement a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:RunnableJob a owl:Class .
hpc:ImpactsScheduling a owl:ObjectProperty ;
    rdfs:domain hpc:JobArrayElement ;
    rdfs:range hpc:JobArrayElement .

hpc:SingleJobRecord a owl:Class .
hpc:CreatedWhenStarted a owl:ObjectProperty ;
    rdfs:domain hpc:JobArray .
    rdfs:range hpc:Job .
