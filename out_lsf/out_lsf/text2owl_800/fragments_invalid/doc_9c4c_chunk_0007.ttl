hpc:Linuxx8664platform a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] .

hpc:Linuxjreplatform a owl:Class ;
    rdfs:subClassOf hpc:Linuxx8664platform ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] ;
    rdfs:comment "Requires approximately 120 MB." .

hpc:Otherplatform a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] .

hpc:Jrerequiredplatform a owl:Class ;
    rdfs:subClassOf hpc:Otherplatform ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] ;
    rdfs:comment "Requires approximately 1300 MB." .

hpc:Nojrerequiredplatform a owl:Class ;
    rdfs:subClassOf hpc:Otherplatform ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] ;
    rdfs:comment "JRE version 1.4 or higher must already be installed on the system. Requires approximately 1 MB." .

hpc:Installerscriptpackage a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] .

hpc:extractedinstallerscript a owl:ObjectProperty ;
    rdfs:domain hpc:Installerscriptpackage ;
    rdfs:range hpc:Installerscript .

hpc:Linuxx8664installerscript a owl:Class ;
    rdfs:subClassOf hpc:Installerscriptpackage ;
    rdfs:comment "# zcat lsf<version>_lsfinstall_linux_x86_64.tar. Z | tar xvf -" .

hpc:Otherplatforminstallerscript a owl:Class ;
    rdfs:subClassOf hpc:Installerscriptpackage ;
    rdfs:comment "# zcat lsf<version>_lsfinstall.tar. Z | tar xvf -" .

hpc:Nojreinstallerscript a owl:Class ;
    rdfs:subClassOf hpc:Installerscriptpackage ;
    rdfs:comment "# zcat lsf<version>_no_jre_lsfinstall.tar. Z | tar xvf -" .

hpc:Distributionpackage a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] .

hpc:Linux26kernelglibc23 a owl:Class ;
    rdfs:subClassOf hpc:Distributionpackage ;
    rdfs:comment "lsf<version>_linux2.6-glibc2.3-x86_64.tar.Z" .

hpc
