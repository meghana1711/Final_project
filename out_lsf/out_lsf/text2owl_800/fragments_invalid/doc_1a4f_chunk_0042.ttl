hpc:Operatingsystem a owl:Class .
hpc:operatingsystemname hpc:operatingsystemname a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .

hpc:operatingsystemversion hpc:operatingsystemversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .

hpc:cpuarchitecturename hpc:cpuarchitecturename a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .

hpc:individualcpuspeed hpc:individualcpuspeed a owl:DatatypeProperty ;
    rdfs:domain some hpc:Resource ;
    rdfs:range xsd:int64 .

hpc:individualnetworkbandwidth hpc:individualnetworkbandwidth a owl:DatatypeProperty ;
    rdfs:domain some hpc:Resource ;
    rdfs:range xsd:int64 ;
    rdfs:comment "The maximum bandwidth." .

hpc:Resourcemap a owl:Class .
hpc:Elimexecutable a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Location rdfs:domain hpc:Resourcemap ;
    rdfs:range xsd:string .

hpc:startselimexecutables hpc:startselimexecutables a owl:ObjectProperty ;
    rdfs:domain hpc:Managementelim ;
    rdfs:range hpc:Elimexecutable .

hpc:Managementelim hpc:Managementelim a owl:Class ;
    rdfs:subClassOf hpc:Resource .
