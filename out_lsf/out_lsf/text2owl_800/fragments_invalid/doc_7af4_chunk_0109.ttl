hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Autoresizablejob a owl:Class ;
    rdfs:subClassOf hpc:Resizablejob .

hpc:Manualresizablejob a owl:Class ;
    rdfs:subClassOf hpc:Resizablejob .

hpc:Resizablejobprofile a owl:Class ;
    rdfs:subClassOf hpc:Applicationprofile .

hpc:hasresizablejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Resizablejobprofile .

hpc:ResizableJobProfileType a owl:Enum ;
    rdfs:member hpc:Auto ;
    rdfs:member hpc:Y .

hpc:resizablejobrequirescompoundresource a owl:ObjectProperty .

hpc:Compoundresourcerequirement a owl:Class .

hpc:hasjoblevelautoresizableattribute a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob .
    rdfs:range xsd:boolean .

hpc:resizenotifycmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob .
    rdfs:range xsd:string .

hpc:resizenotifycmdmaxlength a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizenotifycmd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:defaultresizablejobstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejobprofile ;
    rdfs:range xsd:boolean .

hpc:ResizeNotifyCmdNotDefined a owl:NamedIndividual ;
    hpc:Resizenotifycmd hpc:resizenotifycmd .

hpc:autoresizablejobrequiresnotification a owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob .
    rdfs:range hpc:Resizenotifycmd .
