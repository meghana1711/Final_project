hpc:BlockSize a owl:Class .
hpc:BestFitAlgorithm a owl:ObjectProperty ;
    rdfs:domain hpc:ResourceAllocation .

hpc:Block a owl:Class .
hpc:hasBaseBlocks owl:ObjectProperty ;
    rdfs:domain hpc:Block .

hpc:BaseBlock a owl:Class .

hpc:Job a owl:Class .
hpc:hasResourceRequest owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:ResourceRequest a owl:Class .

hpc:LowerLevelBlock a owl:Class .
hpc:isComponentOf owl:ObjectProperty ;
    rdfs:domain hpc:LowerLevelBlock .
    rdfs:range hpc:Block .

hpc:ResourceAllocation a owl:Class .
hpc:allocatesFrom owl:ObjectProperty ;
    rdfs:domain hpc:ResourceAllocation .
    rdfs:range hpc:BaseBlock .

hpc:BlockTopology a owl:Class .

hpc:NodeCountRange a owl:Class .
hpc:hasValue xsd:integer .

hpc:OptimizedConfiguration a owl:Class .
hpc:hasMaxSwitchWait xsd:nonNegativeInteger .

hpc:TopologyPlugin a owl:Class .
hpc:hasMaxSwitchWait xsd:nonNegativeInteger .

hpc:HostlistFunction a owl:Class .
hpc:expandsToBlock owl:ObjectProperty ;
    rdfs:domain hpc:HostlistFunction .
    rdfs:range hpc:Block .

hpc:BlockWithNode a owl:Class .
hpc:hasSameBlockAs owl:ObjectProperty ;
    rdfs:domain hpc:BlockWithNode .
    rdfs:range hpc:Node .

hpc:SwitchWithNode a owl:Class .
hpc:hasSameSwitchAs owl:ObjectProperty ;
    rdfs:domain hpc:SwitchWithNode .
    rdfs:range hpc:Node .

hpc:AdjacentBlocks a owl:Class .
