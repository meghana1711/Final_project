hpc:Duncan a owl:Class .
hpc:sleepjob a owl:ObjectProperty ;
    rdfs:domain hpc:Duncan ;
    rdfs:range hpc:Sleepjob .
hpc:Sleepjob rdfs:subClassOf owl:NamedIndividual .

hpc:sleepcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Sleepjob ;
    rdfs:range xsd:string .

hpc:sleeptime a owl:DatatypeProperty ;
    rdfs:domain hpc:Sleepjob ;
    rdfs:range xsd:integer .

hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Duncan ;
    rdfs:range hpc:Job .

hpc:Job a owl:Class .

hpc:Csmjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:smtmode a owl:ObjectProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:integer .

hpc:userpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:integer .

hpc:Host a owl:Class .
hpc:Core a owl:Class .
hpc:Network a owl:Class .
hpc:Ibadapter a owl:Class .
hpc:Window a owl:Class .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:Collection ;
    rdfs:member hpc:Host .

hpc:hascore a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Core .

hpc:hasnetwork a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Network .

hpc:hasibadapter a owl:ObjectProperty ;
    rdfs:domain hpc:Network ;
    rdfs:range hpc:Ibadapter .

hpc:haswindow a owl:ObjectProperty ;
    rdfs:domain hpc:Ibadapter ;
    rdfs:range hpc:Window .
