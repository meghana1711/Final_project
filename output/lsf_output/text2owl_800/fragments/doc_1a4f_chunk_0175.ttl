hpc:Resourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:Slot a owl:Class .
hpc:Compoundresourcerequirement rdfs:domain hpc:Resourcerequirement ;
                                 rdfs:range hpc:Compoundresourcerequirement .
hpc:Simpleresourcerequirement rdfs:domain hpc:Compoundresourcerequirement ;
                                 rdfs:range hpc:Simpleresourcerequirement .
hpc:Resourcename rdfs:domain hpc:Simpleresourcerequirement ;
                   rdfs:range xsd:string .
hpc:Slot rdfs:domain hpc:Simpleresourcerequirement ;
              rdfs:range hpc:Slot .
