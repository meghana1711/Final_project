hpc:Unixusergroup a owl:Class .
hpc:Lsfusergroup a owl:Class .
hpc:getgroupmembership a owl:ObjectProperty .

hpc:Unixusergroup rdfs:subClassOf hpc:Group .
hpc:Lsfusergroup rdfs:subClassOf hpc:Group .

hpc:Unixusergroup rdfs:domain xsd:string .
hpc:Lsfusergroup rdfs:domain xsd:string .

hpc:Getgroupmembership rdfs:domain hpc:Lsfusergroup .
hpc:Getgroupmembership rdfs:range xsd:string .

hpc:UnixusergroupCreation rdfs:subClassOf hpc:Lsfusergroup .
hpc:UnixusergroupCreation rdfs:domain xsd:string .

hpc:UNIXUserGroup_creation rdf:seeAlso hpc:UNIXUserGroup_creation_note .
hpc:UNIXUserGroup_creation_note rdf:datatype xsd:string ;
    rdfs:label "The first time you specify a UNIX user group, LSF automatically creates an LSF user group with that name, and the group membership is retrieved by getgrnam(3) on the management host at the time mbatchd starts. The membership of the group might be different from the one on another host." .

hpc:UnixusergroupHomogeneity rdfs:subClassOf hpc:Unixusergroup .
hpc:UnixusergroupHomogeneity rdfs:domain xsd:string .

hpc:UNIXUserGroup_homogeneity rdf:seeAlso hpc:UNIXUserGroup_homogeneity_note .
hpc:UNIXUserGroup_homogeneity_note rdf:datatype xsd:string ;
    rdfs:label "UNIX group definitions referenced by LSF configuration files must be uniform across all hosts in the cluster. Unexpected results can occur if the UNIX group definitions are not homogeneous across machines." .

hpc:UnixusergroupNameWithSlash rdfs:subClassOf hpc:Unixusergroup .
hpc:UnixusergroupNameWithSlash rdfs:domain xsd:string .

hpc:UNIXUserGroup_name_with_slash rdf:seeAlso hpc:UNIXUserGroup_name_with_slash_note .
hpc:UNIXUserGroup_name_with_slash_note rdf:datatype xsd:string ;
    rdfs:label "To specify a UNIX user group that has the same name as a user, use a slash (/) immediately after the group name:" .
