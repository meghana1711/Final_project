hpc:supportedcommand a owl:ObjectProperty .
hpc:Supportedcommand rdfs:domain hpc:Queue .
hpc:Supportedcommand rdfs:range xsd:string .

hpc:preexec a owl:ObjectProperty .
hpc:Preexec rdfs:domain hpc:Queue .
hpc:Preexec rdfs:subClassOf hpc:Supportedcommand .

hpc:Hostbasedpreexec a owl:Class .
hpc:Hostbasedpreexec rdfs:subClassOf hpc:Preexec .
hpc:HostBasedPreExec rdfs:comment "Cannot be executed on Windows platforms." .

hpc:hostlimitperjob a owl:DatatypeProperty .
hpc:Hostlimitperjob rdfs:domain hpc:Queue .
hpc:Hostlimitperjob rdfs:range xsd:integer .
hpc:HostLimitPerJob rdfs:default (unspecified) .

hpc:HostLimitPerJobUnlimited a owl:NamedIndividual .
hpc:HostLimitPerJobUnlimited rdf:type hpc:HostLimitPerJob .
hpc:HostLimitPerJobUnlimited rdf:value "unlimited" .

hpc:hosts a owl:ObjectProperty .
hpc:Hosts rdfs:domain hpc:Queue .
hpc:Hosts rdfs:range rdf:List .

hpc:Host a owl:Class .
hpc:Host rdfs:subClassOf rdf:Resource .

hpc:hostname a owl:DatatypeProperty .
hpc:Hostname rdfs:domain hpc:Host .
hpc:Hostname rdfs:range xsd:string .

hpc:clustername a owl:DatatypeProperty .
hpc:Clustername rdfs:domain hpc:Hostname .
hpc:Clustername rdfs:range xsd:string .

hpc:preflevel a owl:DatatypeProperty .
hpc:Preflevel rdfs:domain hpc:Hostname .
hpc:Preflevel rdfs:range xsd:integer .

hpc:Hostpartition a owl:Class .
hpc:Hostpartition rdfs:subClassOf hpc:Host .

hpc:Hostgroup a owl:Class .
hpc:Hostgroup rdfs:subClassOf hpc:Host .

hpc:Computeunit a owl:Class .
hpc:Computeunit rdfs:subClassOf hpc:Host .

hpc:Others a owl:Class .
hpc:Others rdfs:subClassOf hpc:Host .
hpc:Others rdfs:comment "This item can only appear once in the list." .

hpc:All a owl:Class .
hpc:All rdfs:subClassOf hpc:Host .
hpc:All rdfs:comment "Deprecated, might be removed in a future version of LSF." .

hpc:Hostlist a owl:Class .
hpc:Hostlist rdfs:subClassOf rdf:List .
hpc:Hostlist rdfs:subClassOf hpc:Host .
