hpc:Useraccount a owl:Class .
hpc:hasDockerGroupMembership rdf:type owl:ObjectProperty .
hpc:hasDockerUserName rdf:type owl:DatatypeProperty .
hpc:isDefaultUser rdf:type owl:ObjectProperty .
hpc:isRootUser rdf:type owl:ObjectProperty .
hpc:isLSFPrimaryAdministrator rdf:type owl:ObjectProperty .
hpc:scriptLocation rdf:type owl:DatatypeProperty .
hpc:Script a owl:Class .
hpc:Executiondriverscript a owl:Class .
hpc:Starterscript a owl:Class .
hpc:Monitorscript a owl:Class .
hpc:Controlscript a owl:Class .
hpc:EnrootContainerJob rdf:type owl:Class .
hpc:DockerContainerJob rdf:type owl:Class .
hpc:PodmanContainerJob rdf:type owl:Class .

hpc:Useraccount rdfs:subClassOf owl:Class .
hpc:Executiondriverscript rdfs:subClassOf hpc:Script .
hpc:Starterscript rdfs:subClassOf hpc:Executiondriverscript .
hpc:Monitorscript rdfs:subClassOf hpc:Executiondriverscript .
hpc:Controlscript rdfs:subClassOf hpc:Executiondriverscript .
hpc:Enrootcontainerjob rdfs:subClassOf hpc:Dockercontainerjob .
hpc:Dockercontainerjob rdfs:subClassOf hpc:Containerjob .
hpc:Podmancontainerjob rdfs:subClassOf hpc:Containerjob .

hpc:Hasdockergroupmembership rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:Hasdockerusername rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:string .
hpc:Isdefaultuser rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:Isrootuser rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:Islsfprimaryadministrator rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:Scriptlocation rdfs:domain hpc:Script ;
    rdfs:range xsd:string .
