    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:ResourcesNotAvailable a owl:Class .
hpc:resources rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:SchedDefer a owl:Class .
hpc:schedulerParameters rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:SystemFailure a owl:Class .
hpc:systemFailure rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:TimeLimitExceeded a owl:Class .
hpc:timeLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
