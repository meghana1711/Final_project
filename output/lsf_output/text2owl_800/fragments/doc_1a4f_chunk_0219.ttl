hpc:Resourcereservationmethod a owl:Class .
hpc:PerTaskReservation a hpc:ResourceReservationMethod .
hpc:PerJobReservation a hpc:ResourceReservationMethod .
hpc:PerHostReservation a hpc:ResourceReservationMethod .

hpc:hasreservationmethod a owl:ObjectProperty .
hpc:Hasreservationmethod rdfs:domain hpc:Resource .
hpc:Hasreservationmethod rdfs:range hpc:Resourcereservationmethod .

hpc:Resourceusage a owl:Class .
hpc:Resourceusage rdfs:subClassOf hpc:Resource .
hpc:hasresourceusage a owl:DatatypeProperty .
hpc:Hasresourceusage rdfs:domain hpc:Resource .
hpc:Hasresourceusage rdfs:range xsd:string .

hpc:Resource rdfs:subClassOf owl:Class .
hpc:hasvalue a owl:DatatypeProperty .
hpc:Hasvalue rdfs:domain hpc:Resource .
hpc:Hasvalue rdfs:range xsd:decimal .

hpc:duration a owl:DatatypeProperty .
hpc:Duration rdfs:domain hpc:Resourceusage .
hpc:Duration rdfs:range xsd:nonNegativeInteger .

hpc:decay a owl:DatatypeProperty .
hpc:Decay rdfs:domain hpc:Resourceusage .
hpc:Decay rdfs:range xsd:nonNegativeInteger .

hpc:Resourcerequirement a owl:Class .
hpc:Resourcerequirement rdfs:subClassOf hpc:Resourceusage .
hpc:hasphase a owl:ObjectProperty .
hpc:Hasphase rdfs:domain hpc:Resourcerequirement .
hpc:Hasphase rdfs:range xsd:nonNegativeInteger .

hpc:hasvaluelist a owl:ObjectProperty .
hpc:Hasvaluelist rdfs:domain hpc:Resourcerequirement .
hpc:Hasvaluelist rdfs:range xsd:string .

hpc:Queuelevelresourcerequirement a owl:Class .
hpc:Queuelevelresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .

hpc:Joblevelresourcerequirement a owl:Class .
hpc:Joblevelresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .
