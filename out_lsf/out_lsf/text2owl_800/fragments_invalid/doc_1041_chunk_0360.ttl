hpc:Resourceallocationlimit a owl:Class .
hpc:Blimitscommand a owl:Class .
hpc:resourceremoval a owl:ObjectProperty ;
    rdfs:domain hpc:Blimitscommand ;
    rdfs:range hpc:Resourceallocationlimit .
hpc:resourceaddition a owl:ObjectProperty ;
    rdfs:domain hpc:Blimitscommand ;
    rdfs:range hps:ResourceAllocationLimit .
hpc:localclusterinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Blimitscommand ;
    rdfs:range hpc:Resourceallocationlimit .
hpc:allocationlimitconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Lsbresourcesfile .
hpc:customizedoutputformat a owl:ObjectProperty ;
    rdfs:domain hpc:Blimitscommand .
hpc:specifiedfield a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat .
hpc:FieldWidth a xsd:integer .
hpc:Justification a xsd:string .
hpc:UnlimitedWidth a xsd:string .
hpc:TruncatedWidth a xsd:integer .
