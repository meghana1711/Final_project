hpc:Jobwithnoovercommitmentandcpuoversubscription a owl:Class .
hpc:Requirescpus rdfs:domain hpc:Jobwithnoovercommitmentandcpuoversubscription ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:Runonnode rdfs:domain hpc:Jobwithnoovercommitmentandcpuoversubscription ;
                 rdfs:range hpc:Node .
hpc:Allocateonlyonethreadpercore rdfs:domain hpc:Jobwithnoovercommitmentandcpuoversubscription ;
                                     rdfs:range xsd:boolean .

