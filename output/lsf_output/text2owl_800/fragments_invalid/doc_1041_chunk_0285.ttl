hpc:Pendstate a owl:Class .
hpc:ependtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendstate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ipendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendstate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:pendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendstate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:estimatedsimstarttime a owl:DatatypeProperty ;
    rdfs:domain ?Job ;
    rdfs:range xsd:dateTime .
hpc:effectiveplimit a owl:DatatypeProperty ;
    rdfs:domain ?Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:plimitremain a owl:DatatypeProperty ;
    rdfs:domain ?Job ;
    rdfs:range xsd:nonPositiveInteger .
