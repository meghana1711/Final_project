hpc:Countpreemptable a owl:Class .
hpc:preemptablequeuepriority a owl:ObjectProperty .
hpc:pendingwhennoslots a owl:ObjectProperty .
hpc:highqueuepriority a owl:ObjectProperty .
hpc:Dynamicclusterweighting a owl:Class .
hpc:queuepreference a owl:DatatypeProperty .
hpc:actualavailableslots a owl:DatatypeProperty .
hpc:pendingratio a owl:DatatypeProperty .
hpc:importantslotblockinglimit a owl:DatatypeProperty .
hpc:meetsslotrequirements a owl:ObjectProperty .

hpc:Countpreemptable rdfs:subClassOf owl:Class .
hpc:Preemptablequeuepriority rdfs:domain hpc:Countpreemptable ;
                               rdfs:range xsd:integer .
hpc:Pendingwhennoslots rdfs:domain hpc:Countpreemptable ;
                         rdfs:range xsd:boolean .
hpc:Highqueuepriority rdfs:domain hpc:Countpreemptable ;
                       rdfs:range xsd:integer .
hpc:Dynamicclusterweighting rdfs:subClassOf owl:Class .
hpc:Queuepreference rdfs:domain hpc:Dynamicclusterweighting ;
                      rdfs:range xsd:integer .
hpc:Actualavailableslots rdfs:domain hpc:Dynamicclusterweighting ;
                          rdfs:range xsd:integer .
hpc:Pendingratio rdfs:domain hpc:Dynamicclusterweighting ;
                   rdfs:range xsd:decimal .
hpc:Importantslotblockinglimit rdfs:domain hpc:Dynamicclusterweighting ;
                                 rdfs:range xsd:integer .
hpc:Meetsslotrequirements rdfs:domain hpc:Dynamicclusterweighting ;
                            rdfs:range hpc:Queue .
