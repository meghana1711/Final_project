# Runtime
hpc:Runtime a owl:Class .

# OCI Runtime
hpc:OCIRuntime a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:Runtime ] .

# Configuration File
hpc:OCIConfigFile a owl:Class .

# IgnoreFileConfigJson
hpc:IgnoreFileConfigJson a owl:ObjectProperty .
hpc:IgnoreFileConfigJson rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:boolean .

# CreateEnvFile
hpc:CreateEnvFile a owl:ObjectProperty .
hpc:CreateEnvFile rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# EnvExclude
hpc:EnvExclude a owl:ObjectProperty .
hpc:EnvExclude rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# RunTimeEnvExclude
hpc:RunTimeEnvExclude a owl:ObjectProperty .
hpc:RunTimeEnvExclude rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# RunTimeRun
hpc:RunTimeRun a owl:ObjectProperty .
hpc:RunTimeRun rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# RunTimeKill
hpc:RunTimeKill a owl:ObjectProperty .
hpc:RunTimeKill rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# RunTimeDelete
hpc:RunTimeDelete a owl:ObjectProperty .
hpc:RunTimeDelete rdfs:domain hpc:OCIConfigFile ;
                               rdfs:range xsd:string .

# Wrapper Script
hpc:WrapperScript a owl:Class .

# RunTimeRun (for Wrapper Script)
hpc:RunTimeRun_WrapperScript a owl:ObjectProperty .
hpc:RunTimeRun_WrapperScript rdfs:domain hpc:WrapperScript ;
                                 rdfs:range xsd:string .

# User-specific run configuration
hpc:UserSpecificRunConfiguration a owl:Class .

# ~/.slurm-oci-run
hpc:SlurmOciRun a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:UserSpecificRunConfiguration ] .

