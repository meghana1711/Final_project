hpc:Lsfprimaryadministrator a owl:Class .
hpc:Awsfederatedaccount a owl:Class .
hpc:Awsidentityfederation a owl:Class .
hpc:Awsresource a owl:Class .
hpc:awsCredentialScript a owl:ObjectProperty .
hpc:Launchtemplate a owl:Class .
hpc:Ec2instance a owl:Class .
hpc:amiid a owl:DatatypeProperty .
hpc:instancetype a owl:DatatypeProperty .
hpc:networksettings a owl:DatatypeProperty .
hpc:AwsCredentialScript rdfs:domain hpc:Lsfprimaryadministrator ;
    rdfs:range xsd:string .
hpc:AwsCredentialScript rdfs:range hpc:Awsfederatedaccount ;
    rdfs:subPropertyOf hpc:executes .
hpc:Hastemporarycredentials rdfs:domain hpc:Awsfederatedaccount ;
    rdfs:range xsd:string .
hpc:Useslaunchtemplate rdfs:domain hpc:Launchtemplate ;
    rdfs:range hpc:Ec2instance .
hpc:Hasamiid rdfs:domain hpc:Ec2instance ;
    rdfs:range xsd:string .
hpc:Hasinstancetype rdfs:domain hpc:Ec2instance ;
    rdfs:range xsd:string .
hpc:Hasnetworksettings rdfs:domain hpc:Ec2instance ;
    rdfs:range xsd:string .
