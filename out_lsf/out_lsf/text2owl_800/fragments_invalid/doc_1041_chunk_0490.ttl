@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:Reserved a owl:Class .
hpc:ReservedY a hpc:Reserved .
hpc:ReservedYStar a hpc:Reserved .
hpc:ReservedNot a hpc:Reserved .
hpc:Resource a owl:Class .
hpc:brestart a owl:ObjectProperty .

hpc:Name rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Reserved rdfs:subClassOf owl:Class ;
    rdfs:subClass [ a owl:Restriction ;
                     owl:onProperty hpc:Brestart ;
                     owl:hasValue "Y" ] ;
    rdfs:subClass [ a owl:Restriction ;
                     owl:onProperty hpc:Brestart ;
                     owl:hasValue "Y*" ] ;
    rdfs:subClass [ a owl:Restriction ;
                     owl:onProperty hpc:Brestart ;
                     owl:hasValue "-" ] .
hpc:Resource rdfs:subClassOf owl:Class ;
    rdfs:subClass [ a owl:Restriction ;
                     owl:onProperty hpc:Brestart ;
                     owl:hasValue "brestart" ] .
