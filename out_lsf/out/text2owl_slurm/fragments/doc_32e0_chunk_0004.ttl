hpc:Jobcomp a owl:Class .
hpc:Kafkaplugin a owl:Class .

hpc:logsToJobCompDebugFlag rdf:type owl:ObjectProperty .
hpc:Logstojobcompdebugflag rdfs:domain hpc:Jobcomp .
hpc:Logstojobcompdebugflag rdfs:range xsd:boolean .

hpc:logsToStderr rdf:type owl:ObjectProperty .
hpc:Logstostderr rdfs:domain hpc:Librdkafka .
hpc:Logstostderr rdfs:range xsd:boolean .

hpc:forcesLogToSyslog rdf:type owl:ObjectProperty .
hpc:Forceslogtosyslog rdfs:domain hpc:Librdkafka .
hpc:Forceslogtosyslog rdfs:range xsd:boolean .

hpc:libraryLoggingLevel rdf:type owl:DatatypeProperty .
hpc:Librarylogginglevel rdfs:domain hpc:Librdkafka .
hpc:Librarylogginglevel rdfs:range xsd:string .

hpc:debugContexts rdf:type owl:DatatypeProperty .
hpc:Debugcontexts rdfs:domain hpc:Librdkafka .
hpc:Debugcontexts rdfs:range xsd:string .

hpc:configuredViaJobCompLoc rdf:type owl:ObjectProperty .
hpc:Configuredviajobcomploc rdfs:domain hpc:Librdkafka .
hpc:Configuredviajobcomploc rdfs:range hpc:Jobcomploc .

