hpc:Project a owl:Class .
hpc:user_name owl:DatatypeProperty .
hpc:ProjectName rdfs:domain hpc:Project ;
                  rdfs:range xsd:string .

hpc:Project rdfs:subClassOf owl:Class .
hpc:UserName rdfs:subClassOf xsd:string .
hpc:ProjectName rdfs:subClassOf xsd:string .

hpc:hasuser a owl:ObjectProperty ;
             rdfs:domain hpc:Project ;
             rdfs:range hpc:UserName .

hpc:Licenseserver a owl:Class .
hpc:inuse a owl:DatatypeProperty ;
           rdfs:domain hpc:Licenseserver ;
           rdfs:range xsd:integer .
hpc:free a owl:DatatypeProperty ;
         rdfs:domain hpc:Licenseserver ;
         rdfs:range xsd:integer .

hpc:Licensefeature a owl:Class .
hpc:assignedto a owl:ObjectProperty ;
               rdfs:domain hpc:Licensefeature ;
               rdfs:range hpc:Licenseserver .

hpc:Servicedomain a owl:Class .
hpc:licensefeature a owl:ObjectProperty ;
               rdfs:domain hpc:Servicedomain ;
               rdfs:range hpc:Licensefeature .
hpc:serversinusefree a owl:DatatypeProperty ;
                 rdfs:domain hpc:Servicedomain ;
                 rdfs:range xsd:string .
