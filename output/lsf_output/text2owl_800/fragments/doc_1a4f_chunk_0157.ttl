hpc:Jobgroup a owl:Class .
hpc:Jobslot a owl:Class .
hpc:hasowner a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:User .
hpc:hasjobslot a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobslot .
hpc:hasnjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:haspending a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasssusp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasususp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasfinish a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:dateTime .
hpc:hassla a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:duration .
hpc:hasjlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:duration .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Jobslot .
hpc:JobGroup_s_X a hpc:JobGroup ;
    hpc:hasName "bjgroup" .
hpc:JobSlot_X a hpc:JobSlot ;
    hpc:hasName "puccini" ;
    hpc:hasNJobs "25/100" ;
    hpc:hasOwner "user1" .
hpc:JobSlot_X_Y a hpc:JobSlot ;
    hpc:hasName "Y" ;
    hpc:hasNJobs "20" ;
    hpc:hasOwner "user1" .
hpc:JobSlot_X_Z a hpc:JobSlot ;
    hpc:hasName "Z" ;
    hpc:hasNJobs "5" ;
    hpc:hasOwner "user2" .
