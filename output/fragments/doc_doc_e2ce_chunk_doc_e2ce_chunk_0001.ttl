hpc:SlurmController a owl:Class .
hpc:Slurmd a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:NodeSet a owl:Class .
hpc:Feature a owl:Class .

hpc:hasMaxNodeCount a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:integer .

hpc:setSelectType a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range rdfs:Literal .

hpc:isDynamicNodeSupported a owl:ObjectProperty ;
    rdfs:domain hpc:SelectType ;
    rdfs:range rdfs:Literal .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range hpc:Partition .

hpc:hasNodeSet a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:NodeSet .

hpc:hasFeature a owl:ObjectProperty ;
    rdfs:domain hpc:NodeSet ;
    rdfs:range hpc:Feature .

hpc:hasPartitionName a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range rdfs:Literal .

hpc:hasNodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range rdfs:Literal .

hpc:hasDefaultValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .

hpc:hasNodeAddr a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range rdfs:Literal .

hpc:hasNodeHostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range rdfs:Literal .

hpc:hasState a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range rdfs:Literal .

hpc:hasCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasBoards a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasSocketsPerBoard a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasCoresPerSocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasThreadsPerCore a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasRealMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
