hpc:Lsfcluster a owl:Class .
hpc:Host a owl:Class .
hpc:addServers an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:List .
hpc:installconfig a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .
hpc:reconfigureLIM an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:reconfigureMBatchd an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:setupHost an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:List .
hpc:top a owl:DatatypeProperty ;
    rdfs:domain hpc:Setuphostaction ;
    rdfs:range xsd:string .
hpc:boot an owl:DatatypeProperty ;
    rdfs:domain hpc:Setuphostaction ;
    rdfs:range xsd:boolean .
hpc:startLim an owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:startRes an owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:startSbd an owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:testChanges an owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:dynamicallyaddhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
