hpc:SocketMemory a owl:Class .
hpc:MemoryCore a owl:Class .
hpc:CPUMemory a owl:Class .
hpc:OverSubscribe a xsd:string .

hpc:hasOverSubscribe a owl:ObjectProperty ;
    rdfs:domain hpc:CPUMemory ;
    rdfs:range xsd:string .

hpc:consTresPlugin a owl:Class .
hpc:DefMemPerGPU a xsd:decimal .

hpc:numCpusPerGPU a owl:DatatypeProperty ;
    rdfs:domain hpc:consTresPlugin .

hpc:countGPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:consTresPlugin .

hpc:gpuBind a owl:ObjectProperty .
hpc:gpuFreq a owl:DatatypeProperty .
hpc:gpusPerNode a owl:DatatypeProperty .
```
