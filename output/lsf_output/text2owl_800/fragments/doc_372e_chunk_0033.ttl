hpc:Feature a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Project a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:resourcerusage a owl:ObjectProperty .
hpc:effectiveproject a owl:ObjectProperty .
hpc:totalinuse a owl:DatatypeProperty .
hpc:totalreserve a owl:DatatypeProperty .
hpc:totalfree a owl:DatatypeProperty .
hpc:others a owl:DatatypeProperty .
hpc:projectshare a owl:ObjectProperty .
hpc:own a owl:ObjectProperty .

hpc:Feature rdfs:subClassOf hpc:Resource .
hpc:Servicedomain rdfs:domain hpc:Feature ;
                   rdfs:range rdf:Resource .
hpc:Project rdfs:domain hpc:Feature ;
               rdfs:range rdf:Resource .
hpc:User rdfs:domain hpc:Job ;
              rdfs:range rdf:Resource .
hpc:Host rdfs:domain hpc:Job ;
             rdfs:range rdf:Resource .
hpc:Resourcerusage rdfs:domain hpc:Job ;
                rdfs:range hpc:Feature .
hpc:Effectiveproject rdfs:domain hpc:Job ;
                rdfs:range hpc:Feature .
hpc:Totalinuse rdfs:domain hpc:Feature ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Totalreserve rdfs:domain hpc:Feature ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Totalfree rdfs:domain hpc:Feature ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Others rdfs:domain hpc:Feature ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Projectshare rdfs:domain hpc:Feature ;
               rdfs:range hpc:Project .
hpc:Own rdfs:domain hpc:Feature ;
              rdfs:range hpc:Project .
