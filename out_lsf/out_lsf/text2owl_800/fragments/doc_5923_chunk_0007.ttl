hpc:Task a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Task in the system." .

hpc:taskname a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string ;
    rdfs:comment "Task name." .

hpc:taskoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "Bit mask of task options." .

hpc:TASK_IN_FILE a owl:NamedIndividual ;
    rdfs:label "Specify input file" ;
    rdfs:comment "Option for specifying input file." .

hpc:TASK_OUT_FILE a owl:NamedIndividual ;
    rdfs:label "Specify output file" ;
    rdfs:comment "Option for specifying output file." .

hpc:TASK_ERR_FILE a owl:NamedIndividual ;
    rdfs:label "Specify error file" ;
    rdfs:comment "Option for specifying error file." .

hpc:TASK_PRE_EXEC a owl:NamedIndividual ;
    rdfs:label "Specify pre-execution command" ;
    rdfs:comment "Option for specifying pre-execution command." .

hpc:TASK_POST_EXEC a owl:NamedIndividual ;
    rdfs:label "Specify post-execution command" ;
    rdfs:comment "Option for specifying post-execution command." .

hpc:TASK_NAME a owl:NamedIndividual ;
    rdfs:label "Specify task name" ;
    rdfs:comment "Option for specifying task name." .
