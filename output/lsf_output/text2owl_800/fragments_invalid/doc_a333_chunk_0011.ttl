hpc:Simulatorcontainer a owl:Class .
hpc:shareMemory an owl:DatatypeProperty ;
    rdfs:domain hpc:Simulatorcontainer ;
    rdfs:range xsd:decimal .
hpc:Hostdevice a owl:Class .
hpc:installationDirectory an owl:ObjectProperty ;
    rdfs:domain hpc:Hostdevice ;
    rdfs:range hpc:Directory .
hpc:runScript an owl:ObjectProperty ;
    rdfs:domain hpc:Simulatorcontainer ;
    rdfs:range hpc:Script .
hpc:dockerRunCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Runscript ;
    rdfs:range hpc:Dockerruncommand .
hpc:shmSize an owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerruncommand ;
    rdfs:range xsd:decimal .
hpc:privileged a owl:ObjectProperty .
hpc:link a owl:ObjectProperty .
hpc:capadd a owl:ObjectProperty .
hpc:Directory a owl:Class .
hpc:Script a owl:Class .
hpc:Dockerruncommand a owl:Class .

hpc:Simulatorservice a owl:Class .
hpc:startService an owl:ObjectProperty ;
    rdfs:domain hpc:Simulatorservice ;
    rdfs:range hpc:Startservicecommand .
hpc:directoryMapping an owl:ObjectProperty ;
    rdfs:domain hpc:Startservicecommand ;
    rdfs:range hpc:Directorymapping .
hpc:lsftop a owl:DatatypeProperty ;
    rdfs:domain hpc:Startservicecommand ;
    rdfs:range xsd:string .
hpc:Startservicecommand a owl:Class .
hpc:Directorymapping a owl:Class .
