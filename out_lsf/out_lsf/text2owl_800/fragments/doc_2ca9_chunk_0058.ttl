hpc:Enrootinstallationpackage a owl:Class .
hpc:enrootversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Enrootinstallationpackage ;
    rdfs:range xsd:string .

# IBM Spectrum LSF with Enroot
hpc:IbmSpectrumLsfWithEnroot a owl:Class ;
    rdfs:subClassOf hpc:Enrootinstallationpackage .

# CONTAINER and EXEC_DRIVER parameters
hpc:container a owl:ObjectProperty .
hpc:execDriver a owl:ObjectProperty .

# Parameters in lsb.applications and lsb.queues files
hpc:Lsbapplicationsfile a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:Lsbqueuesfile a owl:Class ;
    rdfs:subClassOf rdf:Resource .

# Command output formatting
hpc:Commandoutputformatting a owl:Class .
hpc:unitprefix a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandoutputformatting ;
    rdfs:range xsd:string .
hpc:displayvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandoutputformatting ;
    rdfs:range xsd:string .

# Units for resource fields
hpc:KB a xsd:nonNegativeInteger .
hpc:MB a xsd:nonNegativeInteger .
hpc:GB a xsd:nonNegativeInteger .
hpc:TB a xsd:nonNegativeInteger .
hpc:PB a xsd:nonNegativeInteger .
hpc:EB a xsd:nonNegativeInteger .
hpc:ZB a xsd:nonNegativeInteger .
hpc:S a xsd:string .

# bjobs -o command option and LSB_BJOBS_FORMAT parameter
hpc:Bjobsocommandoption a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:LsbBjobsFormat a owl:Class ;
    rdfs:subClassOf rdf:Resource .

# LSB_UNIT_FOR_JOBS_DISPLAY parameter
hpc:LsbUnitForJobsDisplay a owl:Class ;
    rdfs:subClassOf rdf:Resource .

# Other changes to IBM Spectrum LSF
hpc:StrictOutputRules a owl:Class .

# Default width for resource fields
hpc:defaultwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandoutputformatting ;
    rdfs:range xsd:nonNegativeInteger .
