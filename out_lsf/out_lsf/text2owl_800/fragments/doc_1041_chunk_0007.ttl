                 rdfs:domain hpc:Bstage .
hpc:bsub         a owl:ObjectProperty ;
                 rdfs:domain hpc:Bjob .
hpc:bsubmit      a owl:ObjectProperty ;
                 rdfs:domain hpc:Buser ;
                 rdfs:range hpc:Bsub .
hpc:bswitch      a owl:ObjectProperty ;
                 rdfs:domain hpc:Bstage .
hpc:btop         a owl:ObjectProperty ;
                 rdfs:domain hpc:Bstage .
hpc:Bugroup      a owl:Class .
hpc:Buuser       a owl:Class .
hpc:bwait        a owl:ObjectProperty ;
                 rdfs:domain hpc:Bjob .
hpc:ch           a owl:ObjectProperty ;
                 rdfs:domain hpc:Buser .
