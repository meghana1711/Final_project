hpc:clusteraffinityttl a owl:DatatypeProperty .
hpc:Clusteraffinityttl rdfs:domain hpc:Cluster .
hpc:Clusteraffinityttl rdfs:range xsd:nonNegativeInteger .

hpc:ClusterAffinityTTLMin rdf:value "10min" .
hpc:ClusterAffinityTTLMax rdf:value "100h" .
hpc:ClusterAffinityTTLDefault rdf:value "1h" .

hpc:cleanperioddone a owl:DatatypeProperty .
hpc:Cleanperioddone rdfs:domain hpc:Job .

hpc:Computeunittypes a owl:Class .
hpc:Computeunittypes rdfs:subClassOf owl:Collection .
hpc:ComputeUnitType rdf:type owl:Class .
hpc:Computeunittype rdfs:subClassOf hpc:Computeunittypes .
hpc:contains rdf:type owl:ObjectProperty .
hpc:Contains rdfs:domain hpc:Computeunittype .
hpc:Contains rdfs:range hpc:Computeunittype .
hpc:defaultComputeUnitType rdf:type owl:DatatypeProperty .
hpc:Defaultcomputeunittype rdfs:domain hpc:Computeunittypes .
