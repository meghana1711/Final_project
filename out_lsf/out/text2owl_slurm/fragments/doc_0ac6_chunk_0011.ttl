hpc:Dockercontainer a owl:Class .
hpc:Sharedfilesystem a owl:Class .
hpc:DataRoot rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedfilesystem ;
    rdfs:range xsd:string .
hpc:ExecRoot rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Sharedfilesystem ;
    rdfs:range xsd:string .
hpc:ReadAccess rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dockercontainer ;
    rdfs:range hpc:Accesslevel .
hpc:WriteAccess rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dockercontainer ;
    rdfs:range hpc:Accesslevel .
hpc:Accesslevel a owl:Class .
hpc:NoNetwork rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dockercontainer .
hpc:Slurmintegration a owl:Class .
hpc:mungeauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmintegration ;
    rdfs:range hpc:Authenticationmethod .
hpc:Podmanintegration a owl:Class .
hpc:SlurmScrun rdf:type owl:Class .
hpc:RequiresNoSpecialPermissions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Podmanintegration .
