hpc:Host a owl:Class .
hpc:jobstatestatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobslotlimits a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Queue a owl:Class .
hpc:jobslotstatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobstatestatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bpeek a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource ;
    rdfs:domain rdfs:Resource .
hpc:bpeekoutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Bpeek ;
    rdfs:range xsd:string .

hpc:bhost a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Host .

hpc:bqueues a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Queue .

hpc:bbot a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Job .

hpc:btop a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Job .

hpc:bchkpnt a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Job .

hpc:bkill a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Job .

hpc:bmod a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Job .

hpc:User a owl:Class .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

hpc:Lsfuser a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Queueadmin a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Lsfadmin a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobuserid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Userid .
