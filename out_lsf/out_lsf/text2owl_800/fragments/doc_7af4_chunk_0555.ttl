hpc:Administrator a owl:Class .
hpc:UserName rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
hpc:UserGroup rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
hpc:manage_GuaranteedResourcePool rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Guaranteedresourcepool .
hpc:DOMAIN_NAME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:UserName ;
    rdfs:range xsd:string .
hpc:bconf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Administrator .
hpc:cluster_administrator rdf:type owl:Class ;
    rdfs:subClassOf hpc:Administrator .
hpc:Resourcereservation a owl:Class .
hpc:NAME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .
hpc:USERS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:User .
hpc:HOSTS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range hpc:Host .
hpc:TIME_WINDOW rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:string .
hpc:add_reservation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Reservation .
hpc:Reservation a owl:Class .
hpc:user rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:host rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:time_window rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
