hpc:Jobgroup a owl:Class .
hpc:owner a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:User .

hpc:groupName a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .

hpc:nslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:pend a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:ssusp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:ususp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:rsv a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:sla a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .

hpc:User a owl:Class .
hpc:Batch a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:puccini a hpc:User .
hpc:user1 a hpc:User .
hpc:wagner a hpc:User .
hpc:batch a hpc:Batch .

hpc:X hpc:puccini hpc:user1 .
hpc:XY hpc:x 20 xsd:integer .
hpc:XZ hpc:x 5 xsd:integer .
hpc:A hpc:batch .
hpc:AB hpc:a 0 .
hpc:AB hpc:x hpc:user1 .
hpc:AB hpc:nslots 0 .
hpc:AB hpc:pend 0 .
hpc:AB hpc:run 0 .
hpc:AB hpc:ssusp 0 .
hpc:AB hpc:ususp 0 .
hpc:AB hpc:rsv 0 .
hpc:AB hpc:sla 0 .
