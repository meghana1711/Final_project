# Job Scheduling Parameters
hpc:JobSchedulingParameter a owl:Class .

hpc:defer a owl:ObjectProperty ;
    rdfs:domain hpc:JobSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:defer_batch a owl:ObjectProperty ;
    rdfs:domain hpc:JobSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:sched_min_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:default_queue_depth a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSchedulingParameter ;
    rdfs:range xsd:integer .

# Backfill Scheduling Parameters
hpc:BackfillSchedulingParameter a owl:Class .

hpc:bf_max_job_test a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:bf_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:bf_min_age_reserve a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:bf_resolution a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:bf_yield_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:partition_job_depth a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

hpc:sched_max_job_start a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillSchedulingParameter ;
    rdfs:range xsd:integer .

# Slurmctld Parameters
hpc:SlurmctldParameter a owl:Class .

hpc:conmgr_max_connections a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmctldParameter ;
    rdfs:range xsd:integer .

