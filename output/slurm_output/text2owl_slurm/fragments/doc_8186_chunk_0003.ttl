hpc:Plugin a owl:Class .
hpc:Plugin rdfs:subClassOf owl:Class .

hpc:communicateswith a owl:ObjectProperty .
hpc:Communicateswith rdfs:domain hpc:Plugin ;
    rdfs:range hpc:Slurmversion .

hpc:Slurmversion a owl:Class .

hpc:api a owl:ObjectProperty .
hpc:Api rdfs:domain hpc:Plugin ;
    rdfs:range hpc:Apiversion .

hpc:Apiversion a owl:Class .

hpc:Highavailability a owl:Class .
hpc:Highavailability rdfs:subClassOf owl:Class .

hpc:loadbalancing a owl:ObjectProperty .
hpc:Loadbalancing rdfs:domain hpc:Highavailability .

hpc:failover a owl:ObjectProperty .
hpc:Failover rdfs:domain hpc:Highavailability .

hpc:Security a owl:Class .
hpc:Security rdfs:subClassOf owl:Class .

hpc:authentication a owl:ObjectProperty .
hpc:Authentication rdfs:domain hpc:Security .

hpc:communicationtype a owl:DatatypeProperty .
hpc:Communicationtype rdfs:domain hpc:Security ;
    rdfs:range xsd:string .

hpc:encryption a owl:DatatypeProperty .
hpc:Encryption rdfs:domain hpc:Security ;
    rdfs:range xsd:boolean .

hpc:compression a owl:DatatypeProperty .
hpc:Compression rdfs:domain hpc:Security ;
    rdfs:range xsd:boolean .
