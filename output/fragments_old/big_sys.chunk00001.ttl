hpc:SlurmWorkloadManager a owl:Class .
hpc:SlurmVersion a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:string .

# Using
hpc:Documentation a owl:Class .
hpc:FAQ a owl:Class ;
    rdfs:subClassOf hpc:Documentation .
hpc:Publications a owl:Class ;
    rdfs:subClassOf hpc:Documentation .

# Installing
hpc:InstallationGuide a owl:Class .
hpc:Download a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range hpc:InstallationGuide .

# Getting Help
hpc:MailingLists a owl:Class .
hpc:SupportAndTraining a owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .
hpc:Troubleshooting a owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .

# Performance
hpc:LargeCluster a owl:Class ;
    rdfs:subClassOf hpc:SlurmWorkloadManager .
hpc:TaskExecutionTime a owl:DatatypeProperty ;
    rdfs:domain hpc:LargeCluster .

# System Configuration
hpc:FileMax a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:integer .
hpc:TcpMaxSynBacklog a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:integer .
hpc:Somaxconn a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:integer .
hpc:Txqueuelen a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:integer .

# Thread/Process Limit
hpc:ThreadProcessLimit a owl:Class ;
    rdfs:subClassOf hpc:SlurmWorkloadManager .
hpc:TasksMax a owl:DatatypeProperty ;
    rdfs:domain hpc:ThreadProcessLimit .

# User Limits
hpc:Ulimit a owl:Class ;
    rdfs:subClassOf hpc:SlurmWorkloadManager .

# Node Selection Plugin
hpc:SelectType a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager .

# Job Accounting Gather Plugin
hpc:JobAcctGatherType a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager .
hpc:JobAcctGatherFrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAcctGatherType .

# Node Configuration
hpc:NodeConfiguration a owl:Class ;
    rdfs:subClassOf hpc:SlurmWorkloadManager .
hpc:RealMemory a owl:DatatypeProperty
