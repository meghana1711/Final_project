hpc:Jobexceptionjob a owl:Class .
hpc:job_id rdf:domain hpc:JobExceptionJob ;
    rdfs:range xsd:string .

hpc:Jobarray a owl:Class .

hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Jobexceptionjob ;
    rdfs:range rdf:Resource .

hpc:Filter a owl:Class .
hpc:State a owl:Class .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .

hpc:Categories rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command .

hpc:Category a owl:Class .

hpc:synopsisvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Synopsis ;
    rdfs:range xsd:string .

hpc:descriptionvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Description ;
    rdfs:range xsd:string .

hpc:example a owl:ObjectProperty ;
    rdfs:domain hpc:Command .

hpc:Command a owl:Class .

hpc:CleanPeriod rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams .
    rdfs:range xsd:nonNegativeInteger .

hpc:Lsbparams a owl:Class .

hpc:JobArrayID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:IndexList rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:FullArraySpecification rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Jobarray .

hpc:ShowFinishedJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Job .

hpc:ShowJobArray rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range hpc:Jobarray .

hpc:ShowJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range hpc:Job .

hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf hpc:Jobexceptionjob .

hpc:JobArraySpecification rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Jobarrayspecification .

hpc:Jobarrayspecification a owl:Class .
