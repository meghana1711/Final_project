hpc:LSB_ENABLE_PERF_METRICS_LOG
    a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range hpc:Boolean .

hpc:LSB_PERF_METRICS_SAMPLE_PERIOD
    a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LoggingDirectory
    a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range xsd:string .

hpc:PerformanceMetricData
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf owl:NamedIndividual ] .

hpc:SamplePeriod
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricdata ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LoggingDuration
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricdata ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LogFile
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricdata ;
    rdfs:range xsd:string .

hpc:PerformanceLoggingFeature
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf owl:NamedIndividual ] .

hpc:Static
    a owl:ObjectProperty ;
    rdfs:domain hpc:Performanceloggingfeature ;
    rdfs:range hpc:Boolean .

hpc:Dynamic
    a owl:ObjectProperty ;
    rdfs:domain hpc:Performanceloggingfeature ;
    rdfs:range hpc:Boolean .
