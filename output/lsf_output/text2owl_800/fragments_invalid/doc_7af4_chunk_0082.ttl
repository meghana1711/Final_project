hpc:Preexecutionprocessing a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "On Windows, only the parent process of the pre-execution command is killed when the timeout expires, the child processes of the pre-execution command are not killed." .

hpc:Defaulttimeout a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Default Not defined. Pre-execution processing does not time out." .

hpc:Hostbasedpreexecutionprocessing a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "When running host-based pre-execution processing, you cannot use the inﬁnite value or it will fail. You must conﬁgure a reasonable value." .

hpc:InfiniteValue a xsd:string ;
    rdfs:range xsd:string .

hpc:JobSizeList a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A list of job sizes (number of tasks) that are allowed on this application." .

hpc:Jobsize a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:JobSizeList ;
    rdfs:range xsd:nonNegativeInteger .

hpc:DefaultJobSize rdf:first hpc:JobSize ;
    rdfs:comment "The first value in this list is the default job size, which is the assigned job size request if the job was submitted without requesting one." .

hpc:AllowedJobSize rdf:first hpc:JobSize ;
    rdfs:comment "The remaining values are the other job sizes allowed in the queue, and may be deﬁned in any order." .

hpc:Jobsizelistspecification a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A specification of the job sizes allowed on an application profile." .

hpc:JobSizeListSpecification rdfs:subPropertyOf rdf:list ;
    rdfs:domain hpc:JobSizeList ;
    rdfs:range rdf:List .

hpc:JobSizeList rdf:first hpc:JobSizeListSpecification ;
    rdfs:comment "The list of job sizes specified for a queue or an application profile." .

hpc:Lsbqueue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A queue in LSF." .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "An application profile in LSF." .

hpc:Jobsizerequest a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc
