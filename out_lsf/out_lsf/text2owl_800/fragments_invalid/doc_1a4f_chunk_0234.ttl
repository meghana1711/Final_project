hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:HasResource an owl:ObjectProperty .
hpc:hassameresource a owl:ObjectProperty .
hpc:Resizablejob a owl:Class .
hpc:sameresourcerequirement a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:Hasresource rdfs:domain hpc:Host ;
                        rdfs:range hpc:Resource .
hpc:Hassameresource rdfs:domain hpc:Host ;
                        rdfs:range hpc:Resource .
hpc:Resizablejob rdfs:subClassOf hpc:Host .
hpc:Sameresourcerequirement rdfs:domain hpc:Resizablejob ;
                            rdfs:range xsd:string .
