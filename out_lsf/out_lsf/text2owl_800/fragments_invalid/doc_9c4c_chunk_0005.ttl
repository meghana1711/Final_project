hpc:Quietinstallation a owl:Class .
hpc:Ego a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:controlservice a owl:ObjectProperty .
hpc:managementhostselection a owl:ObjectProperty .
hpc:performancescalability a owl:ObjectProperty .
hpc:Powerfulmanagementhost rdfs:domain hpc:Managementhostselection ;
    rdfs:range hpc:Managementhost .
hpc:egocontrol a owl:DatatypeProperty .
hpc:MinimumCPURequirement xsd:string ;
    rdfs:range xsd:string .
hpc:SufficientMemory xsd:string ;
    rdfs:range xsd:string .
hpc:SwapSpace xsd:string ;
    rdfs:range xsd:string .
hpc:MemoryUsage xsd:float ;
    rdfs:range xsd:float .
hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfmanagementhost rdfs:subClassOf hpc:Managementhost .
hpc:LSFDaemonsMemoryUsage xsd:float ;
    rdfs:range xsd:float .
hpc:Quietinstallation rdfs:subClassOf hpc:Installation .
hpc:Ego rdfs:subClassOf hpc:Component .
hpc:Lsfcluster rdfs:subClassOf hpc:Cluster .
hpc:EGOControlOfSbatchdAndResDaemons rdfs:subPropertyOf hpc:EGOControl .
hpc:Managementhostselection rdfs:domain hpc:Lsfcluster .
hpc:Egocontrollableservice rdfs:subClassOf hpc:Service .
hpc:EGOFailover rdfs:label "Failover among multiple management hosts" ;
    rdfs:comment "EGO allows failover among multiple management hosts." .
hpc:EGOClusterCommands rdfs:label "EGO cluster commands" ;
    rdfs:comment "EGO cluster commands to start, stop, and restart the services." .
hpc:ManageLSFonEGO rdfs:label "Manage LSF on EGO" ;
    rdfs:comment "See Manage LSF on EGO for more details on the benefits of enabling EGO and using EGO to control the services." .
