@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:selectionsection a owl:ObjectProperty .
hpc:orderingsection a owl:ObjectProperty .

hpc:Hasqueue rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:Hasresourcerequirement rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirement .
hpc:Requiresselectionsection rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Selectionsection .
hpc:Requiresorderingsection rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Orderingsection .

hpc:Selectionsection rdfs:subClassOf hpc:Resourcerequirement .
hpc:Orderingsection rdfs:subClassOf hpc:Resourcerequirement .
