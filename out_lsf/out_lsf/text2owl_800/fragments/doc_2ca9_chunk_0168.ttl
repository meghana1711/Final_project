hpc:Mbschd a owl:Class .
hpc:Mbatchd a owl:Class .

hpc:Eligiblependinginformation a owl:Class ;
    rdfs:subClassOf hpc:Pendinginformation .
hpc:Ineligiblependinginformation a owl:Class ;
    rdfs:subClassOf hpc:Pendinginformation .

hpc:Pendinginformation a owl:Class .

hpc:snapshotinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbschd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:eligiblependingtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:duration .

hpc:pendingtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:duration .

hpc:Lsf a owl:Class .
hpc:Ibmspectrumlsfrtm a owl:Class ;
    rdfs:subClassOf hpc:Lsf .

hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:Application a owl:Class .

hpc:ptl a owl:ObjectProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Pendingtimelimit .

hpc:eptl a owl:ObjectProperty ;
    rdfs:domain hpc:Bmod ;
    rdfs:range hpc:Eligiblependingtimelimit .

hpc:Lsbparamsfile a owl:Class .
hpc:Lsbqueues a owl:Class .
hpc:Lsbapplications a owl:Class .
hpc:Lsbrtm a owl:Class .
hpc:usernotification a owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsfrtm ;
    rdfs:range hpc:User .
hpc:jobcontrolaction a owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsfrtm ;
    rdfs:range hpc:Jobcontrolaction .
hpc:alarm a owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsfrtm ;
    rdfs:range hpc:Alarm .

hpc:Jobcontrolaction a owl:Class .
hpc:Alarm a owl:Class .
hpc:User a owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Pendingstate .

hpc:Eligiblependingstate a owl:Class ;
    rdfs:subClassOf hpc:Pendingstate .

hpc:Pendingstate a owl:Class .
