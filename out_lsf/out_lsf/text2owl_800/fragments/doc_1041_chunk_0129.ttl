hpc:Deletedusergroup a owl:Class .
hpc:Maxallowedusergroups a owl:Class .
hpc:restartcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Deletedusergroup ;
    rdfs:range xsd:string .
hpc:reconfigcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Deletedusergroup ;
    rdfs:range xsd:string .
hpc:Updatedobject a owl:Class .
hpc:ObjectType a owl:EnumClass ;
    rdfs:subClassOf hpc:Updatedobject ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Any block that is enclosed by BeginSection ... EndSection in a conﬁguration ﬁle" .
hpc:ObjectType_user a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_usergroup a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_host a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_hostgroup a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_queue a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_limit a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:ObjectType_gpool a owl:NamedIndividual ;
    rdf:type hpc:ObjectType .
hpc:Object a owl:Class ;
    rdfs:subClassOf hpc:Updatedobject ;
    rdfs:subClassOf owl:Class .
hpc:objectType a owl:DatatypeProperty ;
    rdfs:domain hpc:Object ;
    rdfs:range hpc:Objecttype .
hpc:objectName a owl:DatatypeProperty ;
    rdfs:domain hpc:Object ;
    rdfs:range xsd:string .
hpc:objectKeys a owl:DatatypeProperty ;
    rdfs:domain hpc:Object ;
    rdfs:range xsd:string .
hpc:action a owl:ObjectProperty ;
    rdfs:domain hpc:Object ;
    rdfs:range xsd:string .
hpc:Valuepair a owl:Class .
hpc:valuepairKey a owl:DatatypeProperty ;
    rdfs:domain hpc:Valuepair ;
    rdfs:range xsd:string .
hpc:valuepairValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Valuepair ;
    rdfs:range xsd:string .
hpc:Keyword a owl:Class .
hpc:keywordValue a owl:DatatypeProperty ;
    rdfs:domain hpc:Keyword ;
    rdfs:range xsd:string .
