hpc:Ipv4address a owl:Class .
hpc:Ipv6address a owl:Class .
hpc:Host a owl:Class .
hpc:alias a owl:ObjectProperty .
hpc:Officialname rdfs:domain hpc:Host .
hpc:Officialname rdfs:range xsd:string .
hpc:Hasipaddress rdfs:domain hpc:Host .
hpc:Hasipaddress rdfs:range hpc:Ipv4address, hpc:Ipv6address .
hpc:Hasalias rdfs:domain hpc:Host .
hpc:Hasalias rdfs:range xsd:string .

hpc:IPv4Address_192_168_2_2 a hpc:IPv4Address .
hpc:IPv6Address_3ffe_b80_3_1a91_2 a hpc:IPv6Address .
hpc:IPv6Address_3ffe_b80_3_1a91_3 a hpc:IPv6Address .
hpc:hostA a hpc:Host .
