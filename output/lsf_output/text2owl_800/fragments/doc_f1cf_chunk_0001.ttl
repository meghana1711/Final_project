hpc:Remoteuser a owl:Class .
hpc:Corporatenetwork a owl:Class .
hpc:vpn a owl:ObjectProperty .
hpc:xdisplayserver a owl:ObjectProperty .
hpc:displayenvironmentvariable a owl:DatatypeProperty .
hpc:Localmachine a owl:Class .
hpc:localipaddress a owl:DatatypeProperty .
hpc:Remotemachine a owl:Class .
hpc:remotehostnameoripaddress a owl:DatatypeProperty .
hpc:ssh a owl:ObjectProperty .
hpc:Sshsession a owl:Class .
hpc:sshprompt a owl:DatatypeProperty .
hpc:x11protocol a owl:DatatypeProperty .
hpc:x11forwarding a owl:ObjectProperty .
hpc:Loginscript a owl:Class .
hpc:changeddisplay a owl:ObjectProperty .
hpc:remotemachineprompt a owl:DatatypeProperty .
hpc:lsfenvironment a owl:ObjectProperty .

hpc:Remoteuser rdfs:subClassOf owl:Thing .
hpc:Corporatenetwork rdfs:subClassOf owl:Class .
hpc:Vpn rdfs:domain hpc:Remoteuser ;
    rdfs:range hpc:Xdisplayserver .
hpc:Xdisplayserver rdfs:subClassOf owl:Class .
hpc:Displayenvironmentvariable rdfs:domain hpc:Remoteuser ;
    rdfs:range xsd:string .
hpc:Localmachine rdfs:subClassOf owl:Class .
hpc:Localipaddress rdfs:domain hpc:Localmachine ;
    rdfs:range xsd:string .
hpc:Remotemachine rdfs:subClassOf owl:Class .
hpc:Remotehostnameoripaddress rdfs:domain hpc:Remotemachine ;
    rdfs:range xsd:string .
hpc:Ssh rdfs:domain hpc:Remoteuser ;
    rdfs:range hpc:Sshsession .
hpc:Sshsession rdfs:subClassOf owl:Class .
hpc:Sshprompt rdfs:domain hpc:Sshsession ;
    rdfs:range xsd:string .
hpc:X11protocol rdfs:domain hpc:Sshsession ;
    rdfs:range xsd:string .
hpc:X11forwarding rdfs:domain hpc:Sshsession .
hpc:Loginscript rdfs:subClassOf owl:Class .
hpc:Changeddisplay rdfs:domain hpc:Loginscript ;
    rdfs:range hpc:X11forwarding .
hpc:Remotemachineprompt rdfs:domain hpc:Sshsession ;
    rdfs:range xsd:string .
hpc:Lsfenvironment rdfs:domain hpc:Remoteuser .
