hpc:Jobstarttimeestimation a owl:Class .
hpc:estimatedjobstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarttimeestimation ;
    rdfs:range xsd:dateTime .
hpc:simulatedjobstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarttimeestimation ;
    rdfs:range xsd:dateTime .
hpc:Hostallocation a owl:Class ;
    rdfs:subClassOf hpc:Jobstarttimeestimation .
hpc:Executioncluster hpc:hostallocation ;
    rdfs:range xsd:string .
hpc:Lowerboundestimate a owl:Class ;
    rdfs:subClassOf hpc:Jobstarttimeestimation .
hpc:boundestimate a owl:DatatypeProperty ;
    rdfs:domain hpc:Lowerboundestimate ;
    rdfs:range xsd:dateTime .
