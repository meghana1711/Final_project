hpc:Procedure a owl:Class .
hpc:logon a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Host .
hpc:runcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpclsfshutdown .
hpc:findname a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Nismanagementhost .
hpc:editfile a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:File .
hpc:addcontent a owl:ObjectProperty ;
    rdfs:domain hpc:Editfile ;
    rdfs:range hpc:Content .
hpc:changedirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Directory .
hpc:runcommand2 a owl:ObjectProperty ;
    rdfs:domain hpc:Nismanagementhost ;
    rdfs:range hpc:Command .
hpc:ypmake a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Ypmakeservice .
hpc:Nismanagementhost a owl:Class .
hpc:Host a owl:Class .
hpc:File a owl:Class .
hpc:content a owl:DatatypeProperty .
hpc:Directory a owl:Class .
hpc:Command a owl:Class .
hpc:Ypmakeservice a owl:Class .
hpc:Content rdfs:range xsd:string .
hpc:Ypmakeservice rdfs:subClassOf hpc:Command .
