hpc:MaxTRESCalculation a owl:Class .
hpc:IndividualTRESCalculation a owl:Class .
hpc:NodeGRESCalculation a owl:Class .
hpc:TRESBilling a owl:Class .
hpc:TotalCPUsBilling a owl:Class .
hpc:TRESBillingWeightsBilling a owl:Class .
hpc:PriorityFlags a owl:DatatypeProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range xsd:string .
hpc:CalculatedTRES a owl:DatatypeProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range xsd:decimal .
hpc:MaxTRESCalculation rdfs:subClassOf hpc:TRESBilling .
hpc:IndividualTRESCalculation rdfs:subClassOf hpc:MaxTRESCalculation .
hpc:NodeGRESCalculation rdfs:subClassOf hpc:MaxTRESCalculation .
hpc:TotalCPUsBilling rdfs:subClassOf hpc:IndividualTRESCalculation .
hpc:TRESBillingWeightsBilling rdfs:subClassOf hpc:TRESBilling .
hpc:cpus hpc:IndividualTRESCalculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range hpc:IndividualTRESCalculation .
hpc:mem hpc:IndividualTRESCalculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range hpc:IndividualTRESCalculation .
hpc:gres hpc:NodeGRESCalculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range hpc:NodeGRESCalculation .
hpc:licenses hpc:MaxTRESCalculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TRESBilling ;
    rdfs:range xsd:decimal .
