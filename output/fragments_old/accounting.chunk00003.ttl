hpc:Database a owl:Class .
hpc:MySQLDatabase a hpc:Database .
hpc:RowFormat a owl:Class .
hpc:DynamicRowFormat a hpc:RowFormat .
hpc:InnoDB a hpc:Database .

hpc:Table a owl:Class .
hpc:SlurmTable a hpc:Table .

hpc:TableStatus a owl:Class .
hpc:DatabaseName datatype xsd:string ;
    rdfs:domain hpc:TableStatus .

# Error and Warning Related Classes and Properties

hpc:Error a owl:Class .
hpc:InnoDBError a hpc:Error .
hpc:Warning a owl:Class .
hpc:InnoDBWarning a hpc:Warning .

hpc:ErrorMessage datatype xsd:string ;
    rdfs:domain hpc:Error .

# Collation Related Classes and Properties

hpc:Collation a owl:Class .
hpc:CaseInsensitiveCollation a hpc:Collation .

hpc:CollationName datatype xsd:string ;
    rdfs:domain hpc:Collation .

# Slurm Configuration Parameters and Properties

hpc:SlurmConfiguration a owl:Class .
hpc:AccountingStorageEnforce a hpc:SlurmConfiguration .
hpc:Associations a owl:ObjectProperty ;
    rdfs:domain hpc:AccountingStorageEnforce ;
    rdfs:range hpc:Option .

hpc:Option datatype xsd:string ;
    rdfs:subClassOf owl:Class .

hpc:AccountingStorageExternalHost a hpc:SlurmConfiguration .
hpc:AccountingStorageHost a hpc:SlurmConfiguration .
hpc:AccountingStoragePass a hpc:SlurmConfiguration .
hpc:AccountingStoragePort a hpc:SlurmConfiguration .
hpc:AccountingStorageType a hpc:SlurmConfiguration .
hpc:ClusterName a hpc:SlurmConfiguration .
hpc:TrackWCKey a hpc:SlurmConfiguration .
hpc:SlurmdbdConfig a hpc:SlurmConfiguration .
hpc:AuthInfo a hpc:SlurmdbdConfig .
hpc:AuthType a hpc:SlurmdbdConfig .
```
