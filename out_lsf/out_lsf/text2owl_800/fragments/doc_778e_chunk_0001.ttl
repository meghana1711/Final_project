hpc:Quickstartguide a owl:Class .
hpc:IBMSpectrumLSFQuickStartGuide a hpc:QuickStartGuide ;
    rdfs:label "IBM® Spectrum LSF quick start guide"@en ;
    rdfs:subClassOf hpc:Documentation .

hpc:Documentation a owl:Class .
hpc:ReleaseNotes a hpc:Documentation ;
    rdfs:label "IBM Spectrum LSF release notes"@en .
hpc:QuickReference a hpc:Documentation ;
    rdfs:label "IBM Spectrum LSF quick reference"@en .
hpc:AccessibilityFeatures a hpc:Documentation ;
    rdfs:label "Accessibility features for LSF"@en .
hpc:Troubleshooting a hpc:Documentation ;
    rdfs:label "Troubleshooting LSF problems"@en .
hpc:ErrorAndEventLogging a hpc:Documentation ;
    rdfs:label "Error and event logging"@en .
hpc:FixedBugLists a hpc:Documentation ;
    rdfs:label "Fixed bug lists - IBM Spectrum LSF 10.1"@en .
hpc:TroubleshootingSupportPortal a hpc:Documentation ;
    rdfs:label "Troubleshooting - IBM Spectrum LSF support portal"@en .
hpc:GettingStarted a hpc:Documentation ;
    rdfs:label "Getting started with IBM Spectrum LSF"@en .
hpc:GetStartedUsingIBMSpectrumLSFVersion10_1_0 a hpc:GettingStarted ;
    rdfs:label "Get started using IBM Spectrum LSF Version 10.1.0"@en .

hpc:Product a owl:Class .
hpc:IBMSpectrumLSF a hpc:Product ;
    rdfs:label "IBM Spectrum LSF"@en .

hpc:version a owl:DatatypeProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range xsd:string .

hpc:requires a owl:ObjectProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range hpc:Systemrequirement .

hpc:Systemrequirement a owl:Class .
