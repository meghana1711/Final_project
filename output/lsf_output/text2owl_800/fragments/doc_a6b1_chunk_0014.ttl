hpc:LsbLocaldir a owl:Class .
hpc:LsbSharedir a owl:Class .
hpc:Primaryeventlog a owl:Class .
hpc:Duplicatelog a owl:Class .
hpc:Backupcopy a owl:Class .
hpc:Reducedload a owl:Class .
hpc:Increasedload a owl:Class .
hpc:Failedfileserver a owl:Class .
hpc:Failedfirstmanagementhost a owl:Class .
hpc:Newmanagementhost a owl:Class .
hpc:Restoredstate a owl:Class .
hpc:logfilereplication a owl:ObjectProperty .
hpc:processesjobs a owl:ObjectProperty .
hpc:readslsbSharedir a owl:ObjectProperty .
hpc:recovers a owl:ObjectProperty .
hpc:selectsnewmanagementhost a owl:ObjectProperty .
hpc:usesduplicatefiles a owl:ObjectProperty .
hpc:updatesprimarycopies a owl:ObjectProperty .
hpc:Simultaneousfailure a owl:Class .
hpc:Networkpartitioning a owl:Class .

hpc:LsbLocaldir rdfs:subClassOf hpc:Primaryeventlog .
hpc:LsbSharedir rdfs:subClassOf hpc:Duplicatelog .
hpc:Backupcopy rdfs:subClassOf hpc:Duplicatelog .
hpc:Reducedload rdfs:subClassOf hpc:Effect .
hpc:Increasedload rdfs:subClassOf hpc:Effect .
hpc:Failedfileserver rdfs:subClassOf hpc:Problem .
hpc:Failedfirstmanagementhost rdfs:subClassOf hpc:Problem .
hpc:Newmanagementhost rdfs:subClassOf hpc:Recovery .
hpc:Restoredstate rdfs:subClassOf hpc:Recovery .
hpc:Logfilereplication rdfs:domain hpc:Duplicatelog ;
                             rdfs:range hpc:Primaryeventlog .
hpc:Processesjobs rdfs:domain hpc:LsbSharedir ;
                    rdfs:range xsd:boolean .
hpc:ReadslsbSharedir rdfs:domain hpc:Clientcommand ;
                         rdfs:range hpc:LsbSharedir .
hpc:Recovers rdfs:domain hpc:Fileserver ;
                   rdfs:range hpc:LsbSharedir .
hpc:Selectsnewmanagementhost rdfs:domain hpc:Failedfirstmanagementhost ;
                               rdfs:range hpc:Newmanagementhost .
hpc:Usesduplicatefiles rdfs:domain hpc:Newmanagementhost ;
                          rdfs:range hpc:LsbSharedir .
hpc:Updatesprimarycopies rdfs:domain hpc:Recoveredfileserver ;
                            rdfs:range hpc:LsbLocaldir .
hpc:Simultaneousfailure rdfs:subClassOf hpc:Problem .
hpc:Networkpartitioning rdfs:subClassOf hpc:Problem .
