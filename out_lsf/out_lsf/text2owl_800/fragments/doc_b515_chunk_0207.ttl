hpc:Lsf a owl:Class .
hpc:Job a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Checkpointablejob a owl:Class .
hpc:Checkpointableexecutionhost a owl:Class .
hpc:checkpointdirectory a owl:DatatypeProperty .
hpc:checkpointableatjoblevel a owl:ObjectProperty .
hpc:checkpointableatqueuelevel a owl:ObjectProperty .
hpc:checkpointablebyjobsubmission a owl:ObjectProperty .
hpc:checkpointablebyqueueconfiguration a owl:ObjectProperty .
hpc:checkpointablebyjobconfiguration a owl:ObjectProperty .
hpc:checkpointablebyjobstate a owl:ObjectProperty .
hpc:checkpointablebyjobcheckpointing a owl:ObjectProperty .
hpc:checkpointablebyjobrestart a owl:ObjectProperty .
hpc:checkpointfile a owl:DatatypeProperty .
hpc:checkpointing a owl:ObjectProperty .
hpc:restart a owl:ObjectProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:executionenvironment a owl:DatatypeProperty .
hpc:newjobid a owl:DatatypeProperty .
hpc:echkpnt a owl:ObjectProperty .
hpc:erestart a owl:ObjectProperty .
hpc:Checkpointingdirectory rdfs:range xsd:string .
hpc:Checkpointfile rdfs:range xsd:string .
hpc:Jobid rdfs:range xsd:string .
hpc:Executionenvironment rdfs:range xsd:string .
hpc:Newjobid rdfs:range xsd:string .
hpc:Checkpointablejob rdfs:subClassOf hpc:Job .
hpc:Checkpointableexecutionhost rdfs:subClassOf hpc:Executionhost .
hpc:Checkpointableatjoblevel rdfs:domain hpc:Checkpointablejob ;
    rdfs:range hpc:Checkpointablebyjobconfiguration .
hpc:Checkpointableatqueuelevel rdfs:domain hpc:Queue ;
    rdfs:range hpc:Checkpointdirectory .
hpc:Checkpointablebyjobsubmission rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointdirectory .
hpc:Checkpointablebyqueueconfiguration rdfs:domain hpc:Queue ;
    rdfs:range hpc:Checkpointdirectory .
hpc:Checkpointablebyjobconfiguration rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointableatjoblevel .
hpc:Checkpointablebyjobstate rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointablebyjobcheckpointing .
hpc:Checkpointablebyjobcheckpointing rdfs:domain hpc:Job ;
    rdfs:range hpc:Echkpnt .
hpc:Checkpointablebyjobrestart rdfs:domain hpc:Job ;
    rdfs:range hpc:Erestart .
