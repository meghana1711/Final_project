hpc:Smartmemorylimitenforcement a owl:Class .
hpc:lsbMemlimitEnfControl a owl:ObjectProperty .
hpc:Osmemorylimitenforcement a owl:Class .
hpc:processlimit a owl:ObjectProperty .
hpc:ProcesslimitProcessLimit rdfs:domain hpc:Smartmemorylimitenforcement ;
                                  rdfs:range xsd:integer .
hpc:Queuesyntax a owl:Class .
hpc:Jobsyntax a owl:Class .
hpc:JobsyntaxBsub rdfs:subClassOf hpc:Jobsyntax ;
                   rdfs:domain hpc:Smartmemorylimitenforcement .
hpc:QueuesyntaxLsbQueues rdfs:subClassOf hpc:Queuesyntax ;
                           rdfs:domain hpc:Smartmemorylimitenforcement .
hpc:Unsupportedos a owl:Class .
hpc:UnsupportedosMicrosoftwindows rdfs:subClassOf hpc:Unsupportedos ;
                                     rdfs:domain hpc:Osmemorylimitenforcement .
hpc:UnsupportedosSunsolaris2x rdfs:subClassOf hpc:Unsupportedos ;
                                 rdfs:domain hpc:Osmemorylimitenforcement .
