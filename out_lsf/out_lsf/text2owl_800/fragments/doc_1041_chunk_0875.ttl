hpc:Productversion a owl:Class .
hpc:productName a owl:ObjectProperty ;
    rdfs:domain hpc:Productversion ;
    rdfs:range xsd:string .

hpc:Windows a owl:Class .
hpc:pversions a owl:ObjectProperty ;
    rdfs:domain hpc:Windows ;
    rdfs:range xsd:string .

hpc:EGO a hpc:ProductName .
hpc:LSF a hpc:ProductName .
hpc:Symphony a hpc:ProductName .
hpc:ssacct a owl:ObjectProperty ;
    rdfs:domain hpc:Windows ;
    rdfs:range xsd:string .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Windows .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Windows .

hpc:options a owl:DatatypeProperty ;
    rdfs:domain hpc:Windows .

hpc:jobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Ssacct .

hpc:taskId a owl:DatatypeProperty ;
    rdfs:domain hpc:Ssacct .

hpc:logFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Ssacct .

hpc:index a xsd:nonNegativeInteger .

hpc:product_for_version_info a hpc:ProductName .
hpc:LsfVersionInfo rdfs:subClassOf hpc:Productversion .
hpc:EgoVersionInfo rdfs:subClassOf hpc:Productversion .
hpc:SymphonyVersionInfo rdfs:subClassOf hpc:Productversion .
