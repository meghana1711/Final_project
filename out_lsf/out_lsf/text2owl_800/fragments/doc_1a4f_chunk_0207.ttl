hpc:Host a owl:Class .
hpc:status a owl:DatatypeProperty .
hpc:OK a xsd:string .
hpc:MaxNJobs a xsd:nonNegativeInteger .
hpc:RUN a xsd:nonNegativeInteger .
hpc:SSUSP a xsd:nonNegativeInteger .
hpc:USUP a xsd:nonNegativeInteger .
hpc:RSV a xsd:nonNegativeInteger .

hpc:Job a owl:Class .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Status .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Sortableresource a owl:Class .
hpc:Unsortableresource a owl:Class .

hpc:sortbyindex a owl:ObjectProperty ;
    rdfs:domain hpc:Sortableresource .

hpc:hassortorder a owl:DatatypeProperty ;
    rdfs:domain hpc:Sortableresource .

hpc:reversedsort a owl:ObjectProperty ;
    rdfs:domain hpc:Sortableresource .

hpc:candidatehost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Scheduler a owl:Class .

hpc:slot a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Consumableresource a owl:Class ;
    rdfs:subClassOf hpc:Sortableresource .

hpc:Nonconsumableresource a owl:Class ;
    rdfs:subClassOf hpc:Unsortableresource .

hpc:SortAscending a xsd:string .
hpc:SortDescending a xsd:string .

hpc:SortAscendingHost a hpc:SortableResource ;
    hpc:Sortbyindex hpc:slot ;
    hpc:Hassortorder hpc:sortascending .

hpc:SortDescendingHost a hpc:SortableResource ;
    hpc:Sortbyindex hpc:slot ;
    hpc:Hassortorder hpc:sortdescending ;
    hpc:ReversedSort true .
