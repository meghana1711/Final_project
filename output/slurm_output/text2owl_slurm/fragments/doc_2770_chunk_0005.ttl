hpc:bfMaxjobtest a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of jobs consider for backfill scheduling in each backfill cycle. Default value is 100 jobs." .

hpc:bfMaxjobuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of jobs to initiate per user in each backfill cycle. Default value is 0 (no limit)." .

hpc:bfMaxtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum time in seconds the backfill scheduler can spend (including time spent sleeping when locks are released) before discontinuing. The default value is the value of bf_interval, which defaults to 30 seconds." .

hpc:bfOneresvperjob a owl:ObjectProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Disallow adding more than one backfill reservation per job. This option makes it so that a job submitted to multiple partitions will stop reserving resources once the first job-partition pair has booked a backfill reservation." .

hpc:bfResolution a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Time resolution of backfill scheduling." .
