hpc:Historicaljob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:bhist0 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Historicaljob ;
    rdfs:range xsd:void .

hpc:submission_cluster_name rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Historicaljob ;
    rdfs:range xsd:string .

hpc:releaseVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Historicaljob ;
    rdfs:range xsd:string .

hpc:defaultFormat rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Historicaljob ;
    rdfs:range xsd:string .

hpc:Memoryusage a owl:Class ;
    rdfs:subClassOf hpc:Jobusage .

hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:nonNegativeInteger .

hpc:avgmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:nonNegativeInteger .

hpc:memefficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:float .

hpc:rusage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Cpuusage a owl:Class ;
    rdfs:subClassOf hpc:Jobusage .

hpc:cpuefficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range xsd:float .

hpc:cpupeakusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range xsd:nonNegativeInteger .

hpc:FixPack14 rdf:type owl:Class .

hpc:displaysMaxCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range hpc:Cpuusage .

hpc:displaysPeakDuration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range xsd:duration .

hpc:cpuAverageEfficiency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range xsd:float .

hpc:cpuPeakEfficiency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cpuusage ;
    rdfs:range xsd:float .

hpc:cpuPeakSampleDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

