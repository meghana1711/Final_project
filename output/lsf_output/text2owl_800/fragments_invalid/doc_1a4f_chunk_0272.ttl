hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A job submitted to a queue for processing." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A queue where jobs are submitted for processing." .

hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum run limit for jobs in the queue." .

hpc:defaultrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The default run limit assigned to jobs in the queue." .

hpc:specifiedrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The run limit specified for a job at submission." .

hpc:Queuedefinition a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A definition of the resource usage limits for a queue." .

hpc:Joblevelresourceusagelimit a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A resource usage limit specified at the job level." .

hpc:corelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The core limit for a job." .

hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The CPU time limit for a job." .

hpc:datalimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The data segment size limit for a job." .

hpc:filelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The file size limit for a job." .

hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The memory limit for a job." .

hpc:processlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The process limit for a job." .

hpc:runlimitoverridesqueuedefinition a owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelresourceusagelimit ;
    rdfs:range hpc:Queuedefinition ;
    rdfs
