hpc:Featurename a owl:Class ;
    rdfs:subClassOf owl:String ;
    rdfs:comment "Features with a name that uses a hyphen are accepted." .

hpc:restrictfeaturename a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:boolean ;
    rdfs:comment "If set to N or n, a warning message displays." .

hpc:Warningmessage a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Displays when LSF can not define scheduling policies with a hyphen." .

hpc:rlmstatpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the full path to the location of the Reprise License Manager commands." .

hpc:defaultpath a owl:ObjectProperty ;
    rdfs:domain hpc:Rlmstatpath ;
    rdfs:range xsd:string ;
    rdfs:comment "Default if not defined." .

hpc:standbyconntimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:integer ;
    rdfs:comment "Sets the connection timeout the standby bld waits when trying to contact each host." .

hpc:Clusters a owl:Class ;
    rdfs:subClassOf owl:Collection ;
    rdfs:comment "Required. Lists the clusters that can use License Scheduler." .

hpc:beginclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:Begincluster .

hpc:endclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:Endcluster .
