hpc:Hungjob a owl:Class .
hpc:Hostunavail a owl:Class ;
  rdfs:subClassOf hpc:Hungjob .
hpc:Runlimit a owl:Class ;
  rdfs:subClassOf hpc:Hungjob .
hpc:Allconditions a owl:Class ;
  rdfs:subClassOf hpc:Hungjob .

hpc:hastimeout a owl:ObjectProperty ;
  rdfs:domain hpc:Hungjob ;
  rdfs:range xsd:duration .

hpc:isremovedby a owl:ObjectProperty ;
  rdfs:domain hpc:Hungjob ;
  rdfs:range hpc:Removalagent .

hpc:Removalagent a owl:Class .
hpc:MBatchd a hpc:RemovalAgent .

hpc:jobstatus a owl:DatatypeProperty ;
  rdfs:domain hpc:Hungjob .
  rdfs:range xsd:string .

hpc:runlimitreached a owl:ObjectProperty ;
  rdfs:domain hpc:Hungjob ;
  rdfs:range xsd:boolean .

hpc:hostunavailable a owl:ObjectProperty ;
  rdfs:domain hpc:Hungjob ;
  rdfs:range xsd:boolean .

hpc:waittime a owl:DatatypeProperty ;
  rdfs:domain hpc:Hungjob ;
  rdfs:range xsd:duration .

hpc:RunLimit a hpc:RunLimitReached ;
  rdfs:range true .
hpc:HostUnavail a hpc:HostUnavailable ;
  rdfs:range true .
hpc:All a hpc:AllConditions .
