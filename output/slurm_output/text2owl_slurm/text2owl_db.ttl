hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job with configured memory limits." .

hpc:maximumdatasegmentsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum data segment size for a job." .

hpc:maximumvirtualmemorysize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum virtual memory size for a job." .

hpc:Jobaccounting a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents job accounting configuration." .

hpc:jobacctgathertype a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaccounting ;
    rdfs:range hpc:Jobacctgathertype ;
    rdfs:comment "Type of job accounting gathering." .

hpc:jobacctgatherfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobaccounting ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Frequency of job accounting gathering." .

hpc:Jobpreemption a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents job preemption configuration." .

hpc:preemptmode a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreemption ;
    rdfs:range hpc:Preemptmode ;
    rdfs:comment "Mechanism used to preempt jobs or enable gang scheduling." .

hpc:preempttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpreemption ;
    rdfs:range hpc:Preempttype ;
    rdfs:comment "Type of preemption for the cluster or partition." .

hpc:Preemptablejob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a preemptable job." .

hpc:PreemptModeOff a owl:NamedIndividual ;
    a hpc:PreemptMode ;
    rdfs:label "OFF"@en ;
    rdfs:comment "Disables job preemption and gang scheduling." .

hpc:PreemptModeStrict a owl:NamedIndividual ;
    a hpc:PreemptMode ;
    rdfs:label "STRICT"@en ;
    rdfs:comment "Enforces strict memory limits and cancels jobs that exceed them." .

# Fragment: doc_c8a9_chunk_0004.ttl
hpc:PreemptedJob
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A job that will be cancelled." .

hpc:GangScheduling
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Enables time slicing of jobs in the same partition and resuming of suspended jobs." .

hpc:GangSchedulingOption
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The option that must be specified at the cluster level to use gang scheduling." .

hpc:GangSchedulingType
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies the type of gang scheduling." .

hpc:PreemptType
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Specifies the plugin used to identify which jobs can be preempted." .

# Fragment: doc_c8a9_chunk_0005.ttl
hpc:Preempttype a owl:Class .
hpc:Preempttype rdfs:subClassOf owl:Class .

hpc:preemptNone a owl:NamedIndividual ;
    rdfs:label "Job preemption is disabled (default)"@en ;
    rdfs:comment "Job preemption is disabled (default)" .

hpc:preemptPartitionPrio a owl:NamedIndividual ;
    rdfs:label "Job preemption is based upon partition PriorityTier. Jobs in higher PriorityTier partitions may preempt jobs from lower PriorityTier partitions. This is not compatible with PreemptMode=OFF."@en ;
    rdfs:comment "Job preemption is based upon partition PriorityTier. Jobs in higher PriorityTier partitions may preempt jobs from lower PriorityTier partitions. This is not compatible with PreemptMode=OFF." .

hpc:preemptQOS a owl:NamedIndividual ;
    rdfs:label "Job preemption rules are specified by Quality Of Service (QOS) specifications in the Slurm database. In the case of PreemptMode=SUSPEND, a preempting job needs to be submitted to a partition with a higher PriorityTier or to the same partition. This option is not compatible with PreemptMode=OFF. A configuration of PreemptMode=SUSPEND is only supported by the SelectType=select/cons_tres plugin. See the sacctmgr man page to configure the options of preempt/qos."@en ;
    rdfs:comment "Job preemption rules are specified by Quality Of Service (QOS) specifications in the Slurm database. In the case of PreemptMode=SUSPEND, a preempting job needs to be submitted to a partition with a higher PriorityTier or to the same partition. This option is not compatible with PreemptMode=OFF. A configuration of PreemptMode=SUSPEND is only supported by the SelectType=select/cons_tres plugin. See the sacctmgr man page to configure the options of preempt/qos." .

