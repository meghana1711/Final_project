hpc:Compoundresourcerequirement a owl:Class .
hpc:simplestring1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:string .
hpc:simplestring2 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:string .
hpc:simplestring3 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:string .
hpc:num1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:num2 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:num3 a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xpc:nonNegativeInteger .
hpc:Firstexecutionhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:satisfiesrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Firstexecutionhost ;
    rdfs:range hpc:Compoundresourcerequirement .
hpc:Simpleresourcerequirementatjoblevel a owl:Class .
hpc:Simpleresourcerequirementatapplicationlevel a owl:Class .
hpc:Simpleresourcerequirementatqueuelevel a owl:Class .
hpc:selectstring a owl:ObjectProperty ;
    rdfs:domain hpc:Firstexecutionhost ;
    rdfs:range hpc:Simpleresourcerequirementatjoblevel,
             hpc:SimpleResourceRequirementAtApplicationLevel,
             hpc:SimpleResourceRequirementAtQueueLevel .
hpc:samestring a owl:ObjectProperty ;
    rdfs:domain hpc:Firstexecutionhost ;
    rdfs:range hpc:Combinedsimpleresourcerequirement .
hpc:Combinedsimpleresourcerequirement a owl:Class .
hpc:ordersection a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:spansection a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:cusection a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:usagestring a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Rusage .
hpc:Rusage a owl:Class .
