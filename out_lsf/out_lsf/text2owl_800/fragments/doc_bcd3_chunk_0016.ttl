hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Queue a owl:Class .
hpc:Command a owl:Class .
hpc:Status a owl:Class .
hpc:Host a owl:Class .
hpc:cwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
hpc:submittedfrom a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:startedon a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:executionhome a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:executioncwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Queuelevelrunlimit a owl:Class ;
    rdfs:subClassOf hpc:Runlimit .
hpc:Joblevelrunlimit a owl:Class .
hpc:Interruptiblebackfillqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:Lazyqueue a owl:Class ;
    rdfs:subClassOf hpc:Interruptiblebackfillqueue .
hpc:runlimitof a owl:ObjectProperty ;
    rdfs:domain hpc:Queuelevelrunlimit ;
    rdfs:range xsd:duration .
