hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Cpu a owl:Class .
hpc:Node a owl:Class .
hpc:Core a owl:Class .
hpc:Processor a owl:Class .

hpc:hastask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:isboundto a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Cpu .

hpc:ison a owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range hpc:Node .

hpc:hascore a owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range hpc:Core .

hpc:hasprocessor a owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range hpc:Processor .

hpc:blockdistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:cyclicdistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:blockcyclicdistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:Highlevelsrunflag a owl:Class .
hpc:distributionmethod a owl:DatatypeProperty ;
    rdfs:domain hpc:Highlevelsrunflag ;
    rdfs:range xsd:string .
