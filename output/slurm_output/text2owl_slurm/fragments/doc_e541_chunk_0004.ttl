hpc:profileenergysample a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipmi ;
    rdfs:range xsd:float .

hpc:Ipmi a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Energysample .

hpc:ipmirate a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipmi ;
    rdfs:range xsd:float .

hpc:Ipmilost a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:energyipmifrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Intelprocessor ;
    rdfs:range xsd:integer ;
    rdfs:rangeMinInclusive "3"^^xsd:integer .

hpc:Intelprocessor a owl:Class .

hpc:Profilingjob a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:datacollection a owl:ObjectProperty ;
    rdfs:domain hpc:Profilingjob ;
    rdfs:range hpc:Data .

hpc:Data a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hdf5file .

hpc:Hdf5file a owl:Class .

hpc:profileoption a owl:ObjectProperty ;
    rdfs:domain hpc:Profilingjob ;
    rdfs:range hpc:Profile .

hpc:Profile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Datacollection .

hpc:Alldata a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Nodata a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Energydata a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Filesystemdata a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Networkdata a owl:Class ;
    rdfs:subClassOf hpc:Profile .

hpc:Lustrefilesystem a owl:Class ;
    rdfs:subClassOf hpc:Filesystem .

hpc:Infiniband a owl:Class ;
    rdfs:subClassOf hpc:Network .
