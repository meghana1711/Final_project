hpc:CoresPerSocket a owl:Class .
hpc:coresPerSocket a owl:DatatypeProperty ;
    rdfs:domain hpc:CoresPerSocket ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ThreadsPerCore a owl:Class .
hpc:threadsPerCore a owl:DatatypeProperty ;
    rdfs:domain hpc:ThreadsPerCore ;
    rdfs:range xsd:nonNegativeInteger .

hpc:RealMemory a owl:Class .
hpc:realMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:RealMemory ;
    rdfs:range xsd:nonNegativeDecimal .

hpc:SlurmUser a owl:Class .

hpc:statePreservation a owl:Class .
hpc:statePreservationDirectory a owl:ObjectProperty ;
    rdfs:domain hpc:statePreservation ;
    rdfs:range xsd:string .

hpc:SlurmdStateSaveDirectory a owl:ObjectProperty ;
    rdfs:domain hpc:statePreservation ;
    rdfs:range xsd:string .

hpc:ReturnToService a owl:Enum ;
    rdfs:member (0 "0: When explicitly restored to service by an administrator"^^xsd:string) ;
    rdfs:member (1 "1: Upon registration with a valid configuration only if it was set DOWN due to being non-responsive"^^xsd:string) .
```
