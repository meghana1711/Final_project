hpc:Socket a owl:Class .
hpc:CoresPerSocket a owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ThreadsPerCore a owl:ObjectProperty ;
    rdfs:domain hpc:PhysicalCore ;
    rdfs:range xsd:nonNegativeInteger .
hpc:RealMemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SlurmUser a owl:Class .
hpc:SlurmctldPort a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SlurmdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range xsd:nonNegativeInteger .
hpc:StatePreservationDirectory a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:string .
hpc:PhysicalCore a owl:Class .
hpc:Resource a owl:Class .
hpc:SlurmController a owl:Class .
hpc:ComputeNode a owl:Class .
```
