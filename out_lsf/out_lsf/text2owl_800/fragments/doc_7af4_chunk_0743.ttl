hpc:Mbdprofile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The mbatchd proﬁler runs with the following settings." ;
    rdfs:label "MBDProfile" .

hpc:lsbProfileMbd a owl:ObjectProperty ;
    rdfs:domain hpc:Mbdprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "The default settings for the mbatchd proﬁler." ;
    rdfs:label "LSB_PROFILE_MBD" .

hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbdprofile ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the sampling interval, which is how often the proﬁler dumps the proﬁle data." ;
    rdfs:label "INTERVAL" .

hpc:threshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbdprofile ;
    rdfs:range xsd:float ;
    rdfs:comment "Specifies a threshold value that represents the portion of the last sampling interval." ;
    rdfs:label "THRESHOLD" .

hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbdprofile ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the level at which to log the proﬁle." ;
    rdfs:label "LOG_LEVEL" .

hpc:timelevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbdprofile ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies a timing level for checking how long the proﬁler runs, in milliseconds." ;
    rdfs:label "TIME_LEVEL" .
