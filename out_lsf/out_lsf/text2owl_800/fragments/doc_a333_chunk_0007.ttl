hpc:Dynamichost a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:lsfresourceconnector a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Boolean .
hpc:lsfmulticlustercapability a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Boolean .
hpc:lsfdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Boolean .
hpc:timecompressionfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamichost ;
    rdfs:range xsd:decimal .
hpc:SimulatedAsStaticHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dynamichost ;
    rdfs:range hpc:Lsfcluster .
hpc:Supports rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Boolean .
hpc:SimulationTimeCompression rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Timecompressionfactor ;
    rdfs:range xsd:decimal .
