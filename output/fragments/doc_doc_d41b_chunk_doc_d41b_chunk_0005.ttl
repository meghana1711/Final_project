hpc:Fairshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

hpc:FairshareParent a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Association .

hpc:GrpJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

hpc:GrpJobsAccrue a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

hpc:GrpSubmitJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

hpc:Association a owl:Class .
hpc:User a owl:Class .
