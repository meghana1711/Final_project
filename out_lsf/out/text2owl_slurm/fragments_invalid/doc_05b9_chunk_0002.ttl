@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Jobstateinformation v0.0.43_openapi_job_info_resp a owl:Class.
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstateinformation ;
    rdfs:range xsd:string .

hpc:Licenses v0.0.43_openapi_licenses_resp a owl:Class.
hpc:License a owl:Class ;
    rdfs:subClassOf hpc:Licenses .
hpc:remote a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:boolean .
