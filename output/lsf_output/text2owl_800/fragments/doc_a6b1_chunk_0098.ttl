    rdfs:range xsd:string ;
    rdfs:subClassOf owl:ObjectProperty .

hpc:Elimscompatibilityversion rdfs:domain hpc:Elimscompatibility ;
    rdfs:range xsd:string ;
    rdfs:subClassOf owl:DatatypeProperty .

hpc:Elimbinarylocation rdfs:domain hpc:Intelxeonphiresource ;
