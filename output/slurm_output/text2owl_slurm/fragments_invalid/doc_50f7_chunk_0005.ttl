@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Mcsjob a owl:Class.
hpc:mcsplugin a owl:ObjectProperty.
hpc:mcsparameters a owl:DatatypeProperty.
hpc:LabelEnforcement a owl:Enum;
                      rdfs:member "enforced" ;
                      rdfs:member "ondemand" .
hpc:NodeFilter a owl:Enum;
                 rdfs:member "noselect" ;
                 rdfs:member "select" ;
                 rdfs:member "ondemandselect" ;
                 rdfs:member "always" .
hpc:Exclusivity a owl:Enum;
                 rdfs:member "mcs" .

hpc:Mcs
