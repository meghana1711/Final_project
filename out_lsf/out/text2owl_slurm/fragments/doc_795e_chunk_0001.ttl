hpc:Cluster a owl:Class .
hpc:Command a owl:Class .
hpc:Node a owl:Class .
hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:User a owl:Class .
hpc:State a owl:Class .
hpc:Time a xsd:duration .
hpc:nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:partitionid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:User .
hpc:state a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:hasnode a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:haspartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:managedby a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:communicateswith a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:Multiclusterenvironment a owl:Class .
hpc:Slurmdbd a owl:Class .
hpc:accountingstoragetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm .
hpc:slurmdbd a rdfs:Resource .
hpc:Munge a owl:Class .
hpc:communicationkey a owl:DatatypeProperty ;
    rdfs:domain hpc:Munge .
hpc:communicationkeyforcommunicationwithincluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Munge .
hpc:communicationkeyforcrossclusters a owl:DatatypeProperty ;
    rdfs:domain hpc:Munge .
hpc:multiclusterfunctionality a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:requiresslurmdbd a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:usesmunge a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:communicateswithclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:submissionhostaccessibility a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:earlieststarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .
