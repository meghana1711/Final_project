hpc:LsfDataManager a owl:Class .
hpc:limCommand a owl:ObjectProperty .
hpc:managementCommand a owl:ObjectProperty .
hpc:scpCommand a owl:DatatypeProperty .
hpc:sshCommand a owl:DatatypeProperty .
hpc:LsfDataScpCmd rdfs:domain hpc:LsfDataManager ;
                        rdfs:range xsd:string .
hpc:LsfDataSshCmd rdfs:domain hpc:LsfDataManager ;
                        rdfs:range xsd:string .
hpc:LimCommand rdfs:subClassOf owl:ObjectProperty ;
                 rdfs:domain hpc:LsfDataManager ;
                 rdfs:range rdf:Resource .
hpc:ManagementCommand rdfs:subClassOf owl:ObjectProperty ;
                 rdfs:domain hpc:LsfDataManager ;
                 rdfs:range rdf:Resource .
