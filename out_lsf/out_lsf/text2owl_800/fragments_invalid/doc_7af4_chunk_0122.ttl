hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Application ;
    rdfs:comment "A job that can have a thread limit calculated based on the number of tasks." .

hpc:threadlimitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The maximum number of threads a job can use." .

hpc:threadlimitpertask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The number of threads per task for a job, used to calculate the job's thread limit." .

hpc:Threadlimitpertaskatapplicationlevel a owl:Class ;
    rdfs:subClassOf hpc:Threadlimitvalue ;
    rdfs:comment "The thread limit per task at the application level." .

hpc:Threadlimitpertaskatqueuelevel a owl:Class ;
    rdfs:subClassOf hpc:Threadlimitvalue ;
    rdfs:comment "The thread limit per task at the queue level." .

hpc:jobcanhavethreadlimitcalculatedbasedonnumberoftasks a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates whether a job's thread limit is calculated based on the number of tasks." .

hpc:threadlimitcannotexceedthreadlimitpertaskmultipliedbynumberoftasksforjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job and application level thread limit cannot exceed the thread limit per task multiplied by the number of tasks for the job." .

hpc:applicationlevelthreadlimitcannotexceedqueuelevelthreadlimitpertask a owl:ObjectProperty ;
    rdfs:domain hpc:Threadlimitpertaskatapplicationlevel ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the application level thread limit per task cannot exceed the queue level thread limit per task." .

hpc:applicationlevelthreadlimitcannotexceedqueuelevelthreadlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Threadlimitpertaskatapplicationlevel ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the application level thread limit per task cannot exceed the queue level thread limit." .

hpc:forresizablejobsthreadlimitiscalculatedbasedoncurrentnumberoftasksmultipliedbythreadlimitpertask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether for resizable jobs, the thread limit is calculated based on the current number of tasks multiplied by the thread limit per task." .

hpc:forjobsnotyetrunningthreadlimitiscalculatedbasedonmaxvaluemultipliedbythreadlimitpertask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether for jobs submitted but not yet running, the thread limit is
