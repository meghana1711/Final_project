hpc:Queue a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Queue ] ;
                                          rdfs:hasValue xsd:decimal '10' ] ] .

hpc:Host a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Host ] ;
                                          rdfs:hasValue xsd:decimal '16' ] ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Host ;
                                                             rdfs:range rdf:PlainLiteral 'right' ] ] ] .

hpc:separator a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:PlainLiteral .

hpc:displayresourceconfigurations a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourceconfiguration .

hpc:displaygloballimits a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Globallimitconfiguration .

hpc:displaygloballimitswithmulticluster a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Globallimitconfiguration .

hpc:displayforwardslotallocationlimits a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Forwardslotallocationlimitconfiguration .

hpc:displayforwardslotallocationlimitsforcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Forwardslotallocationlimitconfiguration .

hpc:displaycurrentusageofgloballimits a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Globallimitusage .

hpc:displaycurrentusageofgloballimitswithmulticluster a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Globallimitusage .

hpc:displaywideformat a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hdfs:Boolean .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Forwardslotallocationlimitconfiguration ;
    rdfs:range xsd:string .

hpc:clusternames a owl:DatatypeProperty ;
    rdfs:domain hpc:Forwardslotallocationlimitconfigurationforcluster ;
    rdfs:range xsd:string .

hpc
