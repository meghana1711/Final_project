hpc:Jobfinishrecord a owl:Class .
hpc:Accountingfile a owl:Class .
hpc:Archivefile a owl:Class .

hpc:hasJobFinishRecord rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Accountingfile ;
    rdfs:range hpc:Jobfinishrecord .

hpc:hasArchiveFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Accountingfile ;
    rdfs:range hpc:Archivefile .

hpc:ACCT_ARCHIVE_TIME a xsd:time ;
    rdfs:range xsd:time .

hpc:MAX_ACCT_ARCHIVE_FILE a xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ACCT_ARCHIVE_AGE a xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ACCT_ARCHIVE_SIZE a xsd:positiveInteger ;
    rdfs:range xsd:positiveInteger .

hpc:Site a owl:Class .
hpc:Cluster a owl:Class ;
    rdfs:subClassOf hpc:Site .

hpc:DailyThroughput a xsd:positiveInteger ;
    rdfs:range xsd:positiveInteger ;
    rdfs:domain hpc:Cluster .

hpc:MaintainedRecords a xsd:positiveInteger ;
    rdfs:range xsd:positiveInteger ;
    rdfs:domain hpc:Accountingfile .
