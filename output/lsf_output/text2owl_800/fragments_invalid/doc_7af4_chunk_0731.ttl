hpc:Mbdconnectfailmsg a owl:Class ;
    rdfs:subClassOf owl:String ;
    rdfs:comment "Specifies the message displayed when internal system connections to mbatchd fail." .

hpc:Mbdconnectfailmsg rdfs:domain lsb:BatchCommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Define this parameter if you want to customize the message." .

hpc:MBDConnectFailMsg rdfs:subPropertyOf rdf:type ;
    rdfs:domain lsb:Parameter ;
    rdfs:range hpc:Mbdconnectfailmsg .

hpc:Mbddownmsg a owl:Class ;
    rdfs:subClassOf owl:String ;
    rdfs:comment "Specifies the message displayed by the bhosts command when mbatchd is down or there is no process listening at either the LSB_MBD_PORT or the LSB_QUERY_PORT." .

hpc:Mbddownmsg rdfs:domain lsb:BatchCommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Define this parameter if you want to customize the message." .

hpc:MBDDownMsg rdfs:subPropertyOf rdf:type ;
    rdfs:domain lsb:Parameter ;
    rdfs:range hpc:Mbddownmsg .

hpc:lsbapiconntimeout a owl:DatatypeProperty ;
    rdfs:domain lsb:BatchCommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the interval for retrying the connection to mbatchd." .

hpc:lsbapircvtimeout a owl:DatatypeProperty ;
    rdfs:domain lsb:BatchCommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the interval for retrying the connection to mbatchd." .
