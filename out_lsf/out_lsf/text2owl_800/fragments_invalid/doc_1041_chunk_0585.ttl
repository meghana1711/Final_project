hpc:Jobpriority a owl:Class .
hpc:Stage a owl:Class .
hpc:stepcgroup a owl:ObjectProperty .
hpc:Stepcgroup rdfs:domain hpc:Job .
hpc:Stepcgroup rdfs:range ( xsd:integer ; xsd:nonNegativeInteger ) .
hpc:cgrouplimit a owl:DatatypeProperty .
hpc:Cgrouplimit rdfs:domain hpc:Stepcgroup .
hpc:Cgrouplimit rdfs:range xsd:integer .
hpc:deadline a owl:DatatypeProperty .
hpc:Deadline rdfs:domain hpc:Stepcgroup .
hpc:Deadline rdfs:range xsd:dateTime .
hpc:Termination a owl:Class .
hpc:Termination rdfs:subClassOf hpc:Jobpriority .
hpc:orphantermination a owl:ObjectProperty .
hpc:Orphantermination rdfs:domain hpc:Termination .
hpc:Orphantermination rdfs:range hpc:Job .
hpc:Interactive a owl:Class .
hpc:outputmessages a owl:ObjectProperty .
hpc:Outputmessages rdfs:domain hpc:Interactive .
hpc:reservation a owl:ObjectProperty .
hpc:Reservation rdfs:domain hpc:Job .
hpc:emaildestination a owl:DatatypeProperty .
hpc:Emaildestination rdfs:domain hpc:Job .
hpc:usershelllimits a owl:ObjectProperty .
hpc:Usershelllimits rdfs:domain hpc:Job .
hpc:virtualmemorylimit a owl:DatatypeProperty .
hpc:Virtualmemorylimit rdfs:domain hpc:Job .
hpc:runtimelimit a owl:DatatypeProperty .
hpc:Runtimelimit rdfs:domain hpc:Job .
