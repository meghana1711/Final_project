hpc:resources a owl:DatatypeProperty .

hpc:Host a rdfs:subClassOf owl:Class .
hpc:Statichost rdfs:subClassOf hpc:Host .
hpc:Dynamichost rdfs:subClassOf hpc:Host .
hpc:Server rdfs:subClassOf hpc:Host .
hpc:Client rdfs:subClassOf hpc:Host .
