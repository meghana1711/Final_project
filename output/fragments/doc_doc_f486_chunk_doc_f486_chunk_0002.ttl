hpc:ResourceAllocationData a owl:Class .
hpc:OverSubscribeConfiguration a owl:Class .
hpc:ComputeResource a owl:Class .
hpc:Partition a owl:Class .
hpc:JobSelectionPlugin a owl:Class .
hpc:NewJob a owl:Class .
hpc:UsableNodesBitmap a owl:Class .
hpc:ResourceRequirement a owl:Class .
hpc:BestFitAlgorithm a owl:Class .
hpc:NodeGroupingStrategy a owl:Class .
hpc:NetworkTopology a owl:Class .
hpc:ConsecutiveNodes a owl:Class .
hpc:ResourceAllocation a owl:ObjectProperty .
hpc:hasOverSubscribeConfiguration rdfs:domain hpc:ResourceAllocationData ;
  rdfs:range hpc:OverSubscribeConfiguration .
hpc:hasComputeResource rdfs:domain hpc:ResourceAllocationData ;
  rdfs:range hpc:ComputeResource .
hpc:hasPartition rdfs:domain hpc:ResourceAllocationData ;
  rdfs:range hpc:Partition .
hpc:usesPlugin rdfs:domain hpc:JobSelectionPlugin ;
  rdfs:range rdf:Resource .
hpc:hasNewJob rdfs:domain hpc:JobSelectionPlugin ;
  rdfs:range hpc:NewJob .
hpc:hasUsableNodesBitmap rdfs:domain hpc:JobSelectionPlugin ;
  rdfs:range hpc:UsableNodesBitmap .
hpc:hasResourceRequirement rdfs:domain hpc:JobSelectionPlugin ;
  rdfs:range hpc:ResourceRequirement .
hpc:hasBestFitAlgorithm rdfs:domain hpc:ResourceRequirement ;
  rdfs:range hpc:BestFitAlgorithm .
hpc:hasNodeGroupingStrategy rdfs:domain hpc:BestFitAlgorithm ;
  rdfs:range rdf:List .
hpc:hasNetworkTopology rdfs:domain hpc:NodeGroupingStrategy ;
  rdfs:range hpc:NetworkTopology .
hpc:hasConsecutiveNodes rdfs:domain hpc:NodeGroupingStrategy ;
  rdfs:range hpc:ConsecutiveNodes .
