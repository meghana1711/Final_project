hpc:Connectedlocalcluster a owl:Class .
hpc:managementhostname a owl:ObjectProperty .
hpc:connectionstatus a owl:DatatypeProperty .
hpc:lsfDataPort a owl:DatatypeProperty .
hpc:lsfDataHosts a owl:ObjectProperty .
hpc:Clustermasterstatus a owl:Class .
hpc:Cluster a owl:Class .
hpc:master a owl:ObjectProperty .
hpc:status a owl:DatatypeProperty .
hpc:Outgoingremote a owl:Class .
hpc:Forwardingcluster a owl:Class .
hpc:Mbatchddaemon a owl:Class .
hpc:Incomingremote a owl:Class .
hpc:Datamanager a owl:Class .

hpc:Connectedlocalcluster rdfs:subClassOf owl:Class .
hpc:Managementhostname rdfs:domain hpc:Connectedlocalcluster ;
                          rdfs:range xsd:string .
hpc:Connectionstatus rdfs:domain hpc:Connectedlocalcluster ;
                       rdfs:range xsd:string .
hpc:LsfDataPort rdfs:domain hpc:Connectedlocalcluster ;
                  rdfs:range xsd:integer .
hpc:LsfDataHosts rdfs:domain hpc:Connectedlocalcluster ;
                  rdfs:range rdf:List .
hpc:Clustermasterstatus rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Master rdfs:domain hpc:Cluster ;
               rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Cluster ;
              rdfs:range xsd:string .
hpc:Outgoingremote rdfs:subClassOf owl:Class .
hpc:Forwardingcluster rdfs:subClassOf hpc:Outgoingremote .
hpc:Mbatchddaemon rdfs:subClassOf hpc:Outgoingremote .
hpc:Incomingremote rdfs:subClassOf owl:Class .
hpc:Datamanager rdfs:subClassOf hpc:Incomingremote .

hpc:Cluster1 hpc:managementhostname "hostB" .
hpc:Cluster2 hpc:managementhostname "hostC" .
hpc:Cluster3 hpc:managementhostname "hostD" .
hpc:Cluster1 hpc:connectionstatus "ok" .
hpc:Cluster2 hpc:connectionstatus "ok" .
hpc:Cluster3 hpc:connectionstatus "disc" .
hpc:hamburg a hpc:ForwardingCluster ;
             hpc:ManagementHostName "*dmd1.hamburg" ;
             hpc:LSF_DATA_PORT 4104 ;
             hpc:ConnectionStatus "ok" .
hpc:Toulouse hpc:managementhostname "dmd2.toulouse" ;
                 hpc:LSF_DATA_PORT 12058 ;
                 hpc:ConnectionStatus "disc" .
