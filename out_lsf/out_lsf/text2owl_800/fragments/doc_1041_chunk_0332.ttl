hpc:Bkillcommand a owl:Class .
hpc:hassupportedsignals a owl:ObjectProperty .
hpc:Hassupportedsignals rdfs:domain hpc:Bkillcommand ;
                          rdfs:range xsd:string .
hpc:killsjob a owl:ObjectProperty .
hpc:Killsjob rdfs:domain hpc:Bkillcommand ;
               rdfs:range hpc:Job .
hpc:logsjob a owl:ObjectProperty .
hpc:Logsjob rdfs:domain hpc:Bkillcommand ;
              rdfs:range xsd:boolean .
hpc:operationinprogress a owl:ObjectProperty .
hpc:Operationinprogress rdfs:domain hpc:Bkillcommand ;
                          rdfs:range xsd:boolean .
hpc:removesjob a owl:ObjectProperty .
hpc:Removesjob rdfs:domain hpc:Bkillcommand ;
                rdfs:range hpc:Job .
hpc:remoteclusteroperation a owl:ObjectProperty .
hpc:Remoteclusteroperation rdfs:domain hpc:Bkillcommand ;
                             rdfs:range xsd:boolean .
hpc:silentlyskipsjob a owl:ObjectProperty .
hpc:Silentlyskipsjob rdfs:domain hpc:Bkillcommand ;
                       rdfs:range xsd:boolean .
hpc:Startedjob a owl:Class .
hpc:Startedjob rdfs:subClassOf hpc:Job .
hpc:startedjobinstate a owl:ObjectProperty .
hpc:Startedjobinstate rdfs:domain hpc:Startedjob ;
                        rdfs:range xsd:string .
hpc:Job a owl:Class .
