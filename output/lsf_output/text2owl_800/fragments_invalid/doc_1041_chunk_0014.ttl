hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the LSF system." .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is currently running." .

hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is currently suspended." .

hpc:Submittedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has been submitted but not yet dispatched." .

hpc:Donejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has completed with a DONE status." .

hpc:Exitedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has completed with an EXIT status." .

# Logging status
hpc:Loggedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is logged in the lsb.acct file." .

# Accounting statistics properties
hpc:cpuaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "Displays information about jobs with CPU affinity resource requirement for each task in the job." .

hpc:memoryaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "Detailed memory binding information for each task in the job." .

hpc:eligiblependingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Eligible pending time used in accounting statistics calculations." .

hpc:totalpendingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total pending time." .

hpc:waittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Wait time calculated with eligible pending time instead of total pending time." .

hpc:turnaroundtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Turnaround time calculated with eligible pending time instead of total pending time." .

hpc:expansionfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeReal ;
    rdfs:comment "Turnaround time divided by run time." .

hpc:HogFactor
