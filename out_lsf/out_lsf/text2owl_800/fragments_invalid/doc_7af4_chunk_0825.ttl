hpc:jobstandardoutputmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:jobstandarderrormessage a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:lsfmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstandarderrormessage ;
    rdfs:range rdf:Resource .

hpc:niosstandardmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstandarderrormessage ;
    rdfs:range rdf:Resource .

hpc:niosdebugmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstandarderrormessage ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf hpc:NIOSStandardMessage .

hpc:lsfNiosDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:boolean .

# Command Support
hpc:interactivetaskcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf rdf:type .

hpc:bsub_I a rdf:List ;
    rdf:first hpc:bsub ;
    rdf:rest rdf:List ;
    rdf:rest rdf:first hpc:I .

hpc:bsub_Ip a rdf:List ;
    rdf:first hpc:bsub ;
    rdf:rest rdf:List ;
    rdf:rest rdf:first hpc:Ip .

hpc:bsub_Is a rdf:List ;
    rdf:first hpc:bsub ;
    rdf:rest rdf:List ;
    rdf:rest rdf:first hpc:Is .

hpc:lsrun a rdf:List ;
    rdf:first hpc:lsrun ;
    rdf:rest rdf:List .

hpc:lsgrun a rdf:List ;
    rdf:first hpc:lsgrun ;
    rdf:rest rdf:List .

hpc:lsmake a rdf:List ;
    rdf:first hpc:lsmake ;
    rdf:rest rdf:List .

hpc:bsub_pam a rdf:List ;
    rdf:first hpc:bsub ;
    rdf:rest rdf:List ;
    rdf:rest rdf:first hpc:pam ;
    rdf:rest rdf:rest rdf:first owl:imports hpc:HPCFeatures .

# Limitations
hpc:pseudoterminallimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:synchronizationlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

# LSF_LIM_MULTICORE_ADJUST
