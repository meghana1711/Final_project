hpc:Submissioncwd a owl:Class .
hpc:numnetwork a owl:DatatypeProperty .
hpc:Networkalloc a owl:Class .
hpc:networkid a owl:DatatypeProperty .
hpc:numwindow a owl:DatatypeProperty .
hpc:affinity a owl:DatatypeProperty .
hpc:serialJobEnergy a xsd:float .
hpc:cpi a xsd:float .
hpc:gips a xsd:float .
hpc:gbs a xsd:float .
hpc:gflops a xsd:float .
hpc:numallocslots a owl:DatatypeProperty .

hpc:Submissioncwd rdfs:subClassOf rdf:Resource .
hpc:Numnetwork rdfs:domain hpc:Submissioncwd ;
                 rdfs:range xsd:integer .
hpc:Networkalloc rdfs:subClassOf rdf:List ;
                 rdfs:subClassOf rdf:Resource .
hpc:Networkid rdfs:domain hpc:Networkalloc ;
              rdfs:range xsd:string .
hpc:Numwindow rdfs:domain hpc:Networkid ;
              rdfs:range xsd:integer .
hpc:Affinity rdfs:domain hpc:Networkid ;
              rdfs:range xsd:string .
hpc:Serialjobenergy rdfs:domain hpc:Networkid ;
               rdfs:range xsd:float .
hpc:Cpi rdfs:domain hpc:Networkid ;
              rdfs:range xsd:float .
hpc:Gips rdfs:domain hpc:Networkid ;
              rdfs:range xsd:float .
hpc:Gbs rdfs:domain hpc:Networkid ;
              rdfs:range xsd:float .
hpc:Gflops rdfs:domain hpc:Networkid ;
              rdfs:range xsd:float .
hpc:Numallocslots rdfs:domain hpc:Networkid ;
               rdfs:range xsd:integer .
