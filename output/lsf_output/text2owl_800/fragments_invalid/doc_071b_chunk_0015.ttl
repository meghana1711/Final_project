hpc:LSF_SERVERDIR rdf:type owl:DatatypeProperty .
hpc:LsfServerdir rdfs:domain hpc:Cluster .
hpc:LsfServerdir rdfs:range xsd:string .

hpc:LSF_BINDIR rdf:type owl:DatatypeProperty .
hpc:LsfBindir rdfs:domain hpc:Directory .
hpc:LsfBindir rdfs:range xsd:string .

hpc:LSF_STARTUP_USERS rdf:type owl:ObjectProperty .
hpc:LsfStartupUsers rdfs:domain hpc:Cluster .
hpc:LsfStartupUsers rdfs:range hpc:User .

hpc:LSF_STARTUP_PATH rdf:type owl:ObjectProperty .
hpc:LsfStartupPath rdfs:domain hpc:Cluster .
hpc:LsfStartupPath rdfs:range hpc:Directory .

hpc:LSF_EGO_ADMIN_USER rdf:type owl:DatatypeProperty .
hpc:LsfEgoAdminUser rdfs:domain hpc:Cluster .
hpc:LsfEgoAdminUser rdfs:range xsd:string .

hpc:LSF_EGO_ADMIN_PASSWORD rdf:type owl:DatatypeProperty .
hpc:LsfEgoAdminPassword rdfs:domain hpc:Cluster .
hpc:LsfEgoAdminPassword rdfs:range xsd:string .

hpc:EGO_ADMIN_LOGIN_BYPASS rdf:type owl:ObjectProperty .
hpc:EgoAdminLoginBypass rdfs:domain hpc:Daemon .
hpc:EgoAdminLoginBypass rdfs:range hpc:Boolean .

hpc:requires_ego_admin_login rdf:type owl:ObjectProperty .
hpc:RequiresEgoAdminLogin rdfs:domain hpc:Daemon .
hpc:RequiresEgoAdminLogin rdfs:range hpc:Boolean .

hpc:LSF_EGO_ADMIN_USER_REQUIRED rdf:type owl:Class .
hpc:LsfEgoAdminUserRequired rdfs:subClassOf hpc:Daemon .
hpc:LsfEgoAdminUserRequired hpc:egoAdminLoginBypass "false" .

hpc:LSF_EGO_ADMIN_PASSWORD_REQUIRED rdf:type owl:Class .
hpc:LsfEgoAdminPasswordRequired rdfs:subClassOf hpc:Daemon .
hpc:LsfEgoAdminPasswordRequired hpc:egoAdminLoginBypass "false" .

hpc:EGO_ADMIN_LOGIN_BYPASSED rdf:type owl:Class .
hpc:EgoAdminLoginBypassed rdfs:subClassOf hpc:Daemon .
hpc:EGO_ADMIN_LOG
