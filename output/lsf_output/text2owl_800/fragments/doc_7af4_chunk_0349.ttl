hpc:Mbatchd a owl:Class .
hpc:hasChildMBatchD rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Mbatchd .

hpc:pushesNewJobEvent rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:boolean .

hpc:isAwareOfJobStatus rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:boolean .

hpc:reflectsJobControlCommandResults rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:boolean .

hpc:isCreatedAfter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Mbatchd .

hpc:noPreemptFinishTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NO_PREEMPT_FINISH_TIME_MINUTES rdf:type xsd:QName ;
    rdf:about "http://example.org/hpc#NO_PREEMPT_FINISH_TIME_MINUTES" .

hpc:NO_PREEMPT_FINISH_TIME_PERCENTAGE rdf:type xsd:QName ;
    rdf:about "http://example.org/hpc#NO_PREEMPT_FINISH_TIME_PERCENTAGE" .

hpc:NO_PREEMPT_RUN_TIME rdf:type xsd:QName ;
    rdf:about "http://example.org/hpc#NO_PREEMPT_RUN_TIME" .

hpc:noPreemptInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MBD_REFRESH_TIME rdf:type xsd:QName ;
    rdf:about "http://example.org/hpc#MBD_REFRESH_TIME" .
