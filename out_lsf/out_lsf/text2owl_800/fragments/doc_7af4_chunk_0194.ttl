hpc:slots a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:users a owl:ObjectProperty .
hpc:apps a owl:ObjectProperty .

hpc:Slots rdfs:domain hpc:Limit .
hpc:Swp rdfs:domain hpc:Limit .
hpc:Users rdfs:domain hpc:Limit .
hpc:Apps rdfs:domain hpc:Limit .

hpc:Apps rdfs:range rdf:List .
hpc:Apps rdfs:range xsd:string .

hpc:APPS_all a owl:NamedIndividual .
hpc:APPS_all rdf:type hpc:APPLICATION_PROFILE_NAME .

hpc:APPS_exclude a owl:NamedIndividual .
hpc:APPS_exclude rdf:type hpc:APPLICATION_PROFILE_NAME .

hpc:AppsAll rdfs:subClassOf hpc:ApplicationProfileName .
hpc:AppsExclude rdfs:subClassOf hpc:ApplicationProfileName .

hpc:APPS_all rdfs:subPropertyOf hpc:APPS .
hpc:APPS_exclude rdfs:subPropertyOf hpc:APPS .

hpc:AppsAll rdfs:range [ a owl:Restriction ;
                             rdf:type xsd:string ;
                             owl:allValuesFrom rdf:nil ] .
hpc:AppsExclude rdfs:range [ a owl:Restriction ;
                                 rdf:type xsd:string ;
                                 owl:someValuesFrom rdf:nil ] .
