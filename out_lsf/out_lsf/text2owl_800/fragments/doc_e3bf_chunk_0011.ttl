hpc:Servicepassword a owl:Class.
hpc:ServicePassword rdfs:comment "Actual password of the system services execution user OS account.".
hpc:ServicePassword rdfs:label "SERVICEPASSWORD".
hpc:Servicepassword rdfs:domain rdf:Resource.
hpc:Servicepassword rdfs:range xsd:string.

hpc:baseport a owl:DatatypeProperty.
hpc:BASEPORT rdfs:comment "Base connection port. LSF uses four consecutive ports that start from the base port.".
hpc:BASEPORT rdfs:label "BASEPORT".
hpc:Baseport rdfs:domain rdf:Resource.
hpc:Baseport rdfs:range xsd:integer.

hpc:resport a owl:DatatypeProperty.
hpc:RESPORT rdfs:comment "LSF res service port.".
hpc:RESPORT rdfs:label "RESPORT".
hpc:Resport rdfs:domain rdf:Resource.
hpc:Resport rdfs:range xsd:integer.

hpc:sbdport a owl:DatatypeProperty.
hpc:SBDPORT rdfs:comment "LSF sbatchd service port.".
