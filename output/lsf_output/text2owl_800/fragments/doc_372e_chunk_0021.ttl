hpc:restartcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Lsfcluster .

hpc:reconfigbld a owl:ObjectProperty ;
    rdfs:domain hpc:Bld ;
    rdfs:range hpc:Bld .

hpc:viewguaranteedresourcepool a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Resourcepool .

hpc:configureresourcepool a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Resourcepoolconfiguration .

hpc:projectmode a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Projectmode .

hpc:licensedistributionpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range hpc:Distributionpolicy .

hpc:mapprojecttolsfproject a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range hpc:Mapping .

hpc:configureparameters a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Parameterconfiguration .

hpc:clustermode a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:boolean .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:string .

hpc:Lsfcluster a owl:Class .
hpc:Bld a owl:Class .
hpc:Resourcepool a owl:Class .
hpc:Resourcepoolconfiguration a owl:Class .
hpc:Projectmode a owl:Class .
hpc:Distributionpolicy a owl:Class .
hpc:Mapping a owl:Class .
hpc:Parameterconfiguration a owl:Class .
hpc:Feature a owl:Class .
hpc:System a owl:Class .
