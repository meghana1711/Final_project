hpc:Timeinterval a owl:Class .

# Properties related to time interval
hpc:hasstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeinterval ;
    rdfs:range xsd:dateTime .
hpc:hasendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeinterval ;
    rdfs:range xsd:dateTime .

# User-related class
hpc:User a owl:Class .

# Properties related to users
hpc:ownstask a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Task .

# Task-related class
hpc:Task a owl:Class .

# Properties related to tasks
hpc:hasstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:hasendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:dateTime .
hpc:hasprocessid a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:integer .

# Output format class
hpc:Outputformat a owl:Class .

# Default output format
hpc:Summary a hpc:OutputFormat .

# Subclass relations
hpc:Timeinterval a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasStartTime ;
                        owl:hasValue "_"^^xsd:string ;
                        owl:allValuesFrom [ a hpc:TimeInterval ] ] .
hpc:Timeinterval a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasEndTime ;
                        owl:hasValue "_"^^xsd:string ;
                        owl:allValuesFrom [ a hpc:TimeInterval ] ] .

# Command-line options class
hpc:Commandlineoption a owl:Class .

# Properties related to command-line options
hpc:hasargument a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandlineoption .
hpc:overridesalloptionsexcept a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlineoption ;
    rdfs:range [ a hpc:Commandlineoption ;
                    owl:allValuesFrom [ a hpc:CommandLineOption ;
                                        owl:onProperty [ a owl:ObjectProperty ;
                                                          rdfs:range hpc:Commandlineoption ] ] ] .
hpc:printsusage a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlineoption .
hpc:printsversion a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlineoption .
