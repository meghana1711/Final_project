hpc:Relativeqos a owl:Class ;
    rdfs:subClassOf hpc:Qos ;
    rdfs:comment "The QOS limits will be treated as percentages of the cluster or partition instead of absolute limits." .

hpc:usagefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float ;
    rdfs:comment "A float that is factored into a job's TRES usage." .

