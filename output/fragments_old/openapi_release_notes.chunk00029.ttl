hpc:PartitionInfo a owl:Class .

hpc:selectType a owl:ObjectProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:string ;
    rdf:type owl:Property ;
    rdf:subPropertyOf owl:string .

hpc:suspendTime a owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:integer .

hpc:timeouts a owl:ObjectProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range hpc:Timeouts .

hpc:Timeouts a owl:Class .

hpc:resume a owl:ObjectProperty ;
    rdfs:domain hpc:Timeouts ;
    rdfs:range xsd:integer ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:integer .

hpc:suspend a owl:ObjectProperty ;
    rdfs:domain hpc:Timeouts ;
    rdfs:range xsd:integer ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:integer .

hpc:topology a owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:string .

hpc:tres a owl:ObjectProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range hpc:TRES .

hpc:TRES a owl:Class .

hpc:billingWeights a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:integer .

hpc:configured a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdf:type owl:Property ;
    rdf:subPropertyOf xsd:integer .

hpc:PartitionStates a rdfs:Class .

hpc:INACTIVE rdf:type hpc:PartitionStates .
hpc:UNKNOWN rdf:type hpc:PartitionStates .
hpc:UP rdf:type hpc:PartitionStates .
hpc:DOWN rdf:type hpc:PartitionStates .
hpc:DRAIN rdf:type hpc:PartitionStates .

hpc:processExitCodeStatus a rdfs:Class .

hpc:INVALID rdf:type hpc:processExitCodeStatus .
hpc:PENDING rdf:type hpc:processExitCode
