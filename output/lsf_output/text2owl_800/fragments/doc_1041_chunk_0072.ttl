hpc:Timinglevel a owl:Class .
hpc:logfileName a owl:DatatypeProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range xsd:string .
hpc:Root a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:LsfAdministrator a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:settiminglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range hpc:Timinglevel .
hpc:withtiminginfo a owl:ObjectProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range rdf:Resource .
hpc:samplingperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range xsd:nonNegativeInteger .
hpc:logfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range xsd:string .
hpc:optional a owl:ObjectProperty ;
    rdfs:domain hpc:Timinglevel ;
    rdfs:range rdf:Resource .
hpc:Performanceproblem a owl:Class .
hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Performanceproblem ;
    rdfs:range rdf:Resource .
hpc:jobstatusrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Performanceproblem ;
    rdfs:range rdf:Resource .
hpc:jobrusagerequest a owl:ObjectProperty ;
    rdfs:domain hpc:Performanceproblem ;
    rdfs:range rdf:Resource .
