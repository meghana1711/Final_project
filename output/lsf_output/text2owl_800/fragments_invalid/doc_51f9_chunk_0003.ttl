hpc:Switch a owl:Class .
hpc:Rack a owl:Class .
hpc:Building a owl:Class .
hpc:Hasswitch hpc:Rack rdfs:domain hpc:Rack ;
    rdfs:range hpc:Switch .
hpc:Hasrack hpc:Building rdfs:domain hpc:Building ;
    rdfs:range hpc:Rack .
hpc:HasswitchDefault rdfs:subClassOf hpc:Switch ;
    rdfs:comment "Default level for jobs with CU topology requirements." .
hpc:HasrackDefault rdfs:subClassOf hpc:Rack .
