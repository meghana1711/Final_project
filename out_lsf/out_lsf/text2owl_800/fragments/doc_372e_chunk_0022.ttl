hpc:Host a owl:Class .
hpc:hosts a owl:ObjectProperty .
hpc:Hosts rdfs:domain hpc:Installation .
hpc:Hosts rdfs:range rdf:List .
hpc:Host rdf:type hpc:Host .
hpc:Host rdfs:subClassOf hpc:Hosts .
hpc:Host rdfs:comment "The most preferred host for the license scheduler management." .

hpc:PreferredHost rdf:type hpc:Host .
hpc:Preferredhost rdfs:subClassOf hpc:Host .
hpc:PreferredHost rdfs:comment "The first host in the HOSTS parameter." .

hpc:LeastPreferredHost rdf:type hpc:Host .
hpc:Leastpreferredhost rdfs:subClassOf hpc:Host .
hpc:LeastPreferredHost rdfs:comment "The least preferred host in the HOSTS parameter." .

hpc:HostsOrder rdf:type owl:ObjectProperty .
hpc:Hostsorder rdfs:domain hpc:Preferredhost .
hpc:Hostsorder rdfs:range rdf:List .
hpc:HostsOrder rdfs:comment "The order of hosts from most preferred to least preferred." .

hpc:lmStatInterval a owl:DatatypeProperty .
hpc:LmStatInterval rdfs:domain hpc:Installation .
hpc:LmStatInterval rdfs:range xsd:integer .
hpc:LM_STAT_INTERVAL rdfs:comment "The data collection frequency between License Scheduler and the license manager." .

hpc:lmstatPath a owl:DatatypeProperty .
hpc:LmstatPath rdfs:domain hpc:Installation .
hpc:LmstatPath rdfs:range xsd:string .
hpc:LMSTAT_PATH rdfs:comment "The file path to the commands for the license managers." .

hpc:FlexNet rdf:type hpc:LicenseManager .
hpc:FlexNet rdfs:comment "A type of license manager." .

hpc:Reprise rdf:type hpc:LicenseManager .
hpc:Reprise rdfs:comment "A type of license manager." .

hpc:LM_COMMAND rdf:type owl:ObjectProperty .
hpc:LmCommand rdfs:domain hpc:Licensemanager .
hpc:LmCommand rdfs:range xsd:string .
hpc:LM_COMMAND rdfs:comment "The path to the command for the license managers." .
