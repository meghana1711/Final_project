hpc:Multithreadmbatchdjobquerydaemon a owl:Class .
hpc:Lsfinstallationparameter a owl:Class .
hpc:lsfqueryport a owl:DatatypeProperty ;
    rdfs:domain hpc:Multithreadmbatchdjobquerydaemon ;
    rdfs:range xsd:integer .
hpc:lsfqueryenhancement a owl:DatatypeProperty ;
    rdfs:domain hpc:Multithreadmbatchdjobquerydaemon ;
    rdfs:range xsd:boolean .
hpc:Containersupport a owl:Class .
hpc:Shifter a owl:Class ;
    rdfs:subClassOf hpc:Containersupport .
hpc:shifterversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Shifter ;
    rdfs:range xsd:string .
hpc:Singularity a owl:Class ;
    rdfs:subClassOf hpc:Containersupport .
hpc:singularityversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Singularity ;
    rdfs:range xsd:string .
hpc:ibmSpectrumLsfWithShifter a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Shifter .
hpc:ibmSpectrumLsfWithSingularity a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Singularity .
hpc:NvidiaDataCenterGpuManager a owl:Class .
hpc:dcgmintegration a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:NvidiaDataCenterGpuManager .
hpc:gpuusageinformation a owl:ObjectProperty ;
    rdfs:domain hpc:ExclusiveProcessModeJob ;
    rdfs:range hpc:Gpu .
hpc:gpustatuscheck a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Gpu .
