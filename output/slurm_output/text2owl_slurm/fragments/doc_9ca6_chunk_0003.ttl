hpc:Maximumresourceallocation a owl:Class .
hpc:totalresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Maximumresourceallocation ;
    rdfs:range xsd:integer .
hpc:allocatedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Maximumresourceallocation ;
    rdfs:range hpc:Resource .
hpc:lowerlevels a owl:ObjectProperty ;
    rdfs:domain hpc:Maximumresourceallocation ;
    rdfs:range hpc:Maximumresourceallocation .
hpc:Resource a owl:Class .
