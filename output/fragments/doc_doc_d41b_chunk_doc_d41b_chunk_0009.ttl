hpc:GrpSubmitJobs a owl:Class .
hpc:GrpTRES a owl:Class .
hpc:GrpTRESMins a owl:Class .
hpc:GrpTRESRunMins a owl:Class .

hpc:hasQOS a owl:ObjectProperty ;
    rdfs:domain hpc:GrpSubmitJobs ;
    rdfs:range hpc:QOS .

hpc:hasTRES a owl:ObjectProperty ;
    rdfs:domain hpc:GrpTRES .

hpc:hasTRESMins a owl:ObjectProperty ;
    rdfs:domain hpc:GrpTRESMins .

hpc:hasTRESRunMins a owl:ObjectProperty ;
    rdfs:domain hpc:GrpTRESRunMins .

hpc:hasQOSMins a owl:DatatypeProperty ;
    rdfs:domain hpc:GrpTRESMins ;
    rdfs:range xsd:decimal .

hpc:hasTRESRunMinsUsed a owl:DatatypeProperty ;
    rdfs:domain hpc:GrpTRESRunMins ;
    rdfs:range xsd:decimal .

hpc:QOS a owl:Class .
hpc:NoDecay a owl:ObjectProperty ;
    rdfs:domain hpc:QOS .

hpc:PriorityDecayHalfLife a xsd:nonNegativeInteger .
hpc:PriorityUsageResetPeriod a xsd:nonNegativeInteger .
```
