hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandlinetool ;
    rdfs:range xsd:string .
hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Diagnosecommand ;
    rdfs:range xsd:nonNegativeInteger .
hpc:output a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlinetool ;
    rdfs:range hpc:Logfilename .
hpc:Diagnosecommand a owl:Class ;
    rdfs:subClassOf hpc:Commandlinetool .
hpc:Querycommand a owl:Class ;
    rdfs:subClassOf hpc:Diagnosecommand .
hpc:Lsfproxycommand a owl:Class ;
    rdfs:subClassOf hpc:Diagnosecommand .
hpc:Gpdconfig a owl:Class .
hpc:Gpddebug a owl:Class ;
    rdfs:subClassOf hpc:Commandlinetool .
hpc:Class_Name rdf:Datatype xsd:string .
hpc:Debug_Level rdf:Datatype xsd:nonNegativeInteger .
hpc:LogFileName_For_GpdDebug rdf:Datatype xsd:string .
hpc:gpdrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlinetool .
