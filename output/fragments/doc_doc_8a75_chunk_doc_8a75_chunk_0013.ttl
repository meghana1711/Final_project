                                     rdfs:domain TaskProlog ;
                                     rdfs:domain SrunEpilog ;
                                     rdfs:domain TaskEpilog .
hpc:SLURM_TOPOLOGY_ADDR_PATTERN rdfs:range xsd:string .

hpc:SLURM_WCKEY a owl:ObjectProperty .
hpc:SLURM_WCKEY rdfs:domain PrologSlurmctld ;
                             rdfs:domain EpilogSlurmctld .
hpc:SLURM_WCKEY rdfs:range xsd:string .

