@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Command a owl:Class .
hpc:Option a owl:Class .
hpc:Argument a owl:Class .

hpc:hasoption a owl:ObjectProperty .
hpc:hasargument a owl:ObjectProperty .
hpc:hasvalue a owl:DatatypeProperty .

hpc:Command rdfs:subClassOf owl:Class .
hpc:Option rdfs:subClassOf hpc:Command .
hpc:Argument rdfs:subClassOf hpc:Option .

hpc:Hasoption rdfs:domain hpc:Command .
hpc:Hasoption rdfs:range hpc:Option .
hpc:Hasargument rdfs:domain hpc:Option .
hpc:Hasargument rdfs:range hpc:Argument .
hpc:Hasvalue rdfs:domain hpc:Argument .
hpc:Hasvalue rdfs:range xsd:string .

hpc:Delimiter rdfs:range xsd:string .
hpc:M rdfs:domain hpc:Command .
hpc:U rdfs:domain hpc:Option .
hpc:Queue rdfs:range rdf:List .
hpc:Queue rdfs:domain hpc:Option .
hpc:queue rdfs:subPropertyOf hpc:hasValue .
hpc:alloc rdfs:subPropertyOf hpc:hasOption .
hpc:w rdfs:subPropertyOf hpc:hasArgument .
hpc:O rdfs:domain hpc:Command .
hpc:O rdfs:range rdf:List .
hpc:o rdfs:subPropertyOf hpc:hasArgument .
hpc:FieldName rdfs:range xsd:string .
hpc:OutputWidth rdfs:range xsd:nonNegativeInteger .
hpc:output_width rdfs:subPropertyOf hpc:o .
