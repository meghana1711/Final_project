hpc:Jobcompletionpercentage a owl:Class .
hpc:estimatedcompletionstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcompletionpercentage ;
    rdfs:range xsd:string .

hpc:Jobinformation a owl:Class .
hpc:noncondensedoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range hpc:Jobinformation .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .

hpc:Hostgroup a owl:Class .
hpc:Computeunit a owl:Class .

hpc:Jobexception a owl:Class .
hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Jobid .

hpc:Jobstate a owl:Class .
hpc:exceptionstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstate .

hpc:Bjobscommand a owl:Class .
hpc:WP a hpc:BjobsCommand ;
    rdfs:comment "Displays the current estimated completion percentage of jobs." .
hpc:w a hpc:BjobsCommand ;
    rdfs:comment "Displays noncondensed output for host groups and compute units." .
hpc:X a hpc:BjobsCommand ;
    rdfs:comment "Examples: bjobs -X 101 102 203 509" .
hpc:x a hpc:BjobsCommand ;
    rdfs:comment "Use with the -l option to show the actual exception status. Use with -a to display all jobs that have triggered a job exception." .

hpc:Synopsis a rdf:Property ;
    rdfs:range xsd:string .
hpc:Output a rdf:Property ;
    rdfs:range xsd:string .
hpc:Description a rdf:Property ;
    rdfs:range xsd:string .
hpc:Examples a rdf:Property ;
    rdfs:range xsd:string .
hpc:Categories a rdf:Property ;
    rdfs:range xsd:string .
