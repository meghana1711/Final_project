hpc:FederatedJob a owl:Class .
hpc:OriginCluster a owl:Class .
hpc:SiblingCluster a owl:Class .
hpc:LocalCluster a owl:Class .
hpc:SiblingJob a owl:Class .
hpc:OriginJob a owl:Class .
hpc:RevokedState a owl:Class .

hpc:hasJobID rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FederatedJob ;
    rdfs:range xsd:string .

hpc:hasOriginCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FederatedJob ;
    rdfs:range hpc:OriginCluster .

hpc:hasSiblingCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SiblingJob ;
    rdfs:range hpc:SiblingCluster .

hpc:isLocalCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command .
    rdfs:range hpc:LocalCluster .

hpc:isOriginCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command .
    rdfs:range hpc:OriginCluster .

hpc:hasSibling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FederatedJob ;
    rdfs:range hpc:SiblingJob .

hpc:isRevoked rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OriginJob ;
    rdfs:range hpc:RevokedState .

hpc:cluster rdf:type owl:DatatypeProperty ;
    rdfs:domain squeue .
    rdfs:range xsd:string .

hpc:siblingsactive rdf:type owl:DatatypeProperty ;
    rdfs:domain squeue .
    rdfs:range xsd:string .

hpc:siblingsactiveraw rdf:type owl:DatatypeProperty ;
    rdfs:domain squeue .
    rdfs:range xsd:string .

hpc:siblingsviable rdf:type owl:DatatypeProperty ;
    rdfs:domain squeue .
    rdfs:range xsd:string .

hpc:siblingsviableraw rdf:type owl:DatatypeProperty ;
    rdfs:domain squeue .
    rdfs:range xsd:string .

hpc:hasPartition rdf:type owl:ObjectProperty ;
    rdfs:domain sinfo .
    rdfs:range hpc:Partition .

hpc:hasCluster rdf:type owl:ObjectProperty ;
    rdfs:domain sinfo .
    rdfs:range hpc:Cluster .

hpc:priority rdf:type owl:DatatypeProperty ;
    rdfs:domain sprio .
    rdfs:range xsd:integer .

hpc:clusterReportingJob rdf:type owl:DatatypeProperty ;
    rdfs:domain sprio .
    rdfs:range xsd:string .

hpc:hasJobReport rdf:type owl:ObjectProperty ;
    rd
