hpc:Preexecutionprocessing a owl:Class .
hpc:Postexecutionprocessing a owl:Class .
hpc:preexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionprocessing ;
    rdfs:range xsd:string .
hpc:postexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutionprocessing ;
    rdfs:range xsd:string .
hpc:issupportedby a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionprocessing ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdf:type .
hpc:supportsversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutionprocessing ;
    rdfs:range xsd:string .
hpc:requirescommandexitcode a owl:DatatypeProperty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runsonexecutionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .
hpc:usessameenvironmentvariables a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:domain hpc:Postexecutioncommand .
hpc:requeuesjob a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:boolean .
hpc:jobbased a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:boolean .
