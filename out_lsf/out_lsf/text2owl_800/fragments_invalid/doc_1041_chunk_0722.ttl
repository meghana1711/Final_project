hpc:Job a owl:Class .
hpc:SubmitJob an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class .
hpc:CommandLineArgument an owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Shellscript a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    hpc:spooled an owl:DatatypeProperty ;
    rdfs:domain hpc:Shellscript ;
    rdfs:range xsd:boolean .

hpc:Defaultshellscript a owl:Class ;
    rdfs:subClassOf hpc:Shellscript .
hpc:Cshscript a owl:Class ;
    rdfs:subClassOf hpc:Shellscript .

hpc:Queue a owl:Class .
hpc:NightQueue a hpc:Queue .
hpc:TestQueue a hpc:Queue .

hpc:Jobscript a owl:Class .
