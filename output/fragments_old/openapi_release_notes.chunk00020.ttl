hpc:JobResource a owl:Class .
hpc:SelectType a owl:DatatypeProperty ;
    rdfs:domain hpc:JobResource ;
    rdfs:range xsd:string .
hpc:SelectType rdf:type owl:Array .

hpc:SelectTypeItems a owl:Class ;
    rdf:type owl:Restriction ;
    rdfs:subClassOf hpc:SelectType .
hpc:SelectTypeItems rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SelectType ;
    rdfs:range xsd:string .
hpc:SelectTypeItems rdf:type owl:Array .

hpc:ReservedType a owl:EnumRestriction ;
    rdfs:subClassOf hpc:SelectTypeItems ;
    owl:someValuesFrom ( "RESERVED" ) .

hpc:JobResource_v0_0_43 a owl:Class ;
    rdf:type owl:EquivalentClass ;
    owl:equivalentClass hpc:JobResource .

hpc:Nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:JobResource_v0_0_43 ;
    rdfs:range xsd:string .
hpc:Nodes rdf:type owl:Array .

hpc:ThreadsPerCore a owl:DatatypeProperty ;
    rdfs:domain hpc:JobResource_v0_0_43 ;
    rdfs:range xsd:string ;
    rdfs:comment "Number of processor threads per CPU core (16 bit integer number with flags)" .

hpc:Core a owl:Class .
hpc:Status a owl:DatatypeProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range xsd:string .
hpc:Status rdf:type owl:Array .
hpc:StatusItems a owl:Class ;
    rdf:type owl:EnumRestriction ;
    owl:someValuesFrom ( "INVALID" "UNALLOCATED" "ALLOCATED" "IN_USE" ) .

hpc:Core_v0_0_43 a owl:Class ;
    rdf:type owl:EquivalentClass ;
    owl:equivalentClass hpc:Core .
