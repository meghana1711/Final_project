hpc:JobStep rdf:type owl:NamedIndividual ;
    hpc:hasCudaVisibleDevices owl:DatatypeProperty [
        rdfs:domain hpc:JobStep ;
        rdfs:range xsd:string
    ] .

hpc:TresUsage a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    hpc:hasCpu owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:duration
    ] ;
    hpc:hasEnergy owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:double
    ] ;
    hpc:hasFsDisk owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:integer
    ] ;
    hpc:hasGresGpuMem owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:decimal
    ] ;
    hpc:hasGresGpuUtil owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:integer
    ] ;
    hpc:hasMem owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:integer
    ] ;
    hpc:hasPages owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:integer
    ] ;
    hpc:hasVmem owl:DatatypeProperty [
        rdfs:domain hpc:TresUsage ;
        rdf:type xsd:integer
    ] .

hpc:GresConfFile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:GresPluginForGpus a owl:Class .

hpc:SlurmGresPluginForGpus a hpc:GresPluginForGpus ;
    hpc:usesCudaVisibleDevicesEnvironmentVariable owl:ObjectProperty [
        rdfs:domain hpc:SlurmGresPluginForGpus
    ] .

hpc:CudaVersion a owl:Class ;
    hpc:requiresCudaVisibleDevicesEnvironmentVariable owl:ObjectProperty [
        rdfs:domain hpc:CudaVersion
    ] .

hpc:Node a owl:Class ;
    hpc:hasGraphicsDevices owl:ObjectProperty [
        rdfs:domain hpc:Node
    ] .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    hpc:hasJobStep owl:ObjectProperty [
        rdfs:domain hpc:Job
    ] ;
    hpc:hasGresConfFile owl:ObjectProperty [
        rdfs:domain hpc:Job
    ] ;
    hpc:hasCudaVersion owl:ObjectProperty [
        rdfs:domain hpc:Job
    ] ;
