hpc:JobControls
    a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range [ a owl:Class ; owl:equivalentClass [ a owl:Class ;
                                                         rdfs:subClassOf [ a owl:Class ;
                                                                           owl:intersectionOf ( ( hpc:PreemptableJob hpc:UsingPreemptionResources )
                                                                                                 ( hpc:QueueUsingPreemptionResources ) ) ] ] ] ;
    rdfs:label "SUSPEND with brequeue $LSB_JOBID" .

hpc:TerminateWhen
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:label "Kill jobs with" .

hpc:Preempt
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range [ a owl:Class ; owl:equivalentClass [ a owl:Class ;
                                                         rdfs:subClassOf [ a owl:Class ;
                                                                           owl:intersectionOf ( ( hpc:PreemptableJob hpc:UsingPreemptionResources )
                                                                                                 ( hpc:QueueUsingPreemptionResources ) ) ] ] ] ;
    rdfs:label "Kill preempted jobs instead of suspending them" .

hpc:PreemptionWaitTime
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Configure the preemption wait time" .

hpc:MemoryPreemption
    a owl:Class ;
    rdfs:subClassOf hpc:Preemption ;
    rdfs:label "Memory preemption" .

hpc:PreemptableResources
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:label "Resources that can be preempted" .

hpc:PreemptionWaitTime
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Configure the preemption wait time" .

hpc:PreemptableMemory
    a owl:Class ;
    rdfs:subClassOf hpc:Preemptableresources ;
    rdfs:label "Memory that can be preempted" .

hpc:RusageDuration
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:label "Jobs with rusage duration on memory" .
