hpc:Servicedomain a owl:Class .
hpc:Servicedomain rdfs:subClassOf owl:Class .

hpc:hasname a owl:ObjectProperty .
hpc:Hasname rdfs:domain hpc:Servicedomain ;
                               rdfs:range xsd:string .

hpc:Cluster a owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .

hpc:hasclustername a owl:ObjectProperty .
hpc:Hasclustername rdfs:domain hpc:Cluster ;
                               rdfs:range xsd:string .

hpc:haswanservicedomain a owl:ObjectProperty .
hpc:Haswanservicedomain rdfs:domain hpc:Cluster ;
                               rdfs:range hpc:Servicedomain .

hpc:Wanservicedomain a owl:Class .
hpc:Wanservicedomain rdfs:subClassOf owl:Class .

hpc:haswanservicedomainname a owl:ObjectProperty .
hpc:Haswanservicedomainname rdfs:domain hpc:Wanservicedomain ;
                                     rdfs:range xsd:string .

hpc:hasminallocation a owl:DatatypeProperty .
hpc:Hasminallocation rdfs:domain hpc:Wanservicedomain ;
                             rdfs:range xsd:integer .

hpc:hasmaxallocation a owl:DatatypeProperty .
hpc:Hasmaxallocation rdfs:domain hpc:Wanservicedomain ;
                             rdfs:range xsd:integer .

hpc:hasdynamiclicensesharing a owl:ObjectProperty .
hpc:Hasdynamiclicensesharing rdfs:domain hpc:Wanservicedomain .
