@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Monitorjobinformation a owl:Class.

hpc:bjobs a owl:ObjectProperty;
    rdfs:domain hpc:Monitorjobinformation;
    rdfs:range hpc:Jobinformation.

hpc:bhist a owl:ObjectProperty;
    rdfs:domain hpc:Monitorjobinformation;
    rdfs:range hpc:Jobhistory.

hpc:bjdepinfo a owl:ObjectProperty;
    rdfs:domain hpc:Monitorjobinformation;
    rdfs:range hpc:Jobdependency.

hpc:bhosts a owl:ObjectProperty;
    rdfs:
