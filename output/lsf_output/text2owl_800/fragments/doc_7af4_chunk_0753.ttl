hpc:Lsfcluster a owl:Class .
hpc:Lsfhost a owl:Class .
hpc:Cpuenforcement a owl:Class .
hpc:Memoryenforcement a owl:Class .
hpc:Gpuenforcement a owl:Class .
hpc:Migdeviceisolation a owl:Class .
hpc:lsbresourceenforce a owl:ObjectProperty .
hpc:lsfprocesstracking a owl:ObjectProperty .
hpc:lsflinuxcgroupacct a owl:ObjectProperty .
hpc:Lsfproccesstrackingdomain rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Boolean .
hpc:Lsflinuxcgroupacctdomain rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Boolean .
hpc:Lsbresourceenforcedomain rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:CPUEnforcementRequires rdfs:subPropertyOf hpc:LSBResourceEnforce ;
    rdfs:range hpc:Cpuenforcement .
hpc:MemoryEnforcementRequires rdfs:subPropertyOf hpc:LSBResourceEnforce ;
    rdfs:range hpc:Memoryenforcement .
hpc:GPUEnforcementRequires rdfs:subPropertyOf hpc:LSBResourceEnforce ;
    rdfs:range hpc:Gpuenforcement .
hpc:MIGDeviceIsolationRequires rdfs:subPropertyOf hpc:LSBResourceEnforce ;
    rdfs:range hpc:Migdeviceisolation .
hpc:Gpujobdevice rdfs:subClassOf hpc:Gpuenforcement ;
    rdfs:range hpc:Gpujobdevice .
hpc:Gpujobdevicegpus rdfs:domain hpc:Gpujobdevice ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Cudaversion70ornewer rdfs:subClassOf hpc:Gpuenforcement ;
    rdfs:range xsd:boolean .
hpc:cudavisibledevices a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuenforcement ;
    rdfs:range xsd:string .
