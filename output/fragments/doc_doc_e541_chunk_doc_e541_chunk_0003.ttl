hpc:ProfileHDF5Default a owl:Class .

hpc:options rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:ProfileHDF5Default ;
    rdfs:range xsd:string .

hpc:TimeSeriesControlParameters rdf:type owl:Class .

hpc:JobAcctGatherFrequency rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TimeSeriesControlParameters ;
    rdfs:range xsd:nonNegativeInteger .

hpc:acctgFreq rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TimeSeriesControlParameters ;
    rdfs:range xsd:nonNegativeInteger .

hpc:task rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:acctgFreq ;
    rdfs:range xsd:nonNegativeInteger .

hpc:energy rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:acctgFreq ;
    rdfs:range xsd:nonNegativeInteger .

hpc:filesystem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:acctgFreq ;
    rdfs:range xsd:nonNegativeInteger .

hpc:network rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:acctgFreq ;
    rdfs:range xsd:nonNegativeInteger .

hpc:IPMIenergyPlugin rdf:type owl:Class .

hpc:EnergyIPMIFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:IPMIenergyPlugin ;
    rdfs:range xsd:nonNegativeInteger .
