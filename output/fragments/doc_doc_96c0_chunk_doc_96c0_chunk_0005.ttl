hpc:ComputeNode a owl:Class .
hpc:SlurmdDaemon a owl:Class .
hpc:Features a owl:Class .
hpc:AvailableFeatures a owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range rdf:List .
hpc:ActiveFeatures a owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range rdf:List .
hpc:KnlSpecificFeature a owl:Class .
hpc:NonKnlSpecificFeature a owl:Class ;
    rdfs:subClassOf hpc:Feature .
hpc:SystemType a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode .
hpc:SyscfgTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode .
hpc:NodeFeaturesPlugin a owl:Class .
hpc:KnlFeaturesPlugin a owl:Class ;
    rdfs:subClassOf hpc:NodeFeaturesPlugin .
hpc:Mcdram a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode .
hpc:Numa a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode .
hpc:AvailableNuma a owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range rdf:List .
hpc:ActiveNuma a owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range rdf:List .
hpc:NodeBooted a owl:ObjectProperty ;
    rdfs:domain hpc:ComputeNode ;
    rdfs:range xsd:boolean .
hpc:JobAllocation a owl:Class .
hpc:RequestedMcdram a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocation .
hpc:RequestedNuma a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAllocation .
hpc:InsufficientResources a owl:Class .
hpc:RebootProgram a owl:DatatypeProperty ;
    rdfs:domain hpc:ComputeNode .
hpc:KnlCluster a owl:Class .
hpc:KnlGenericPlugin a owl:Class ;
    rdfs:subClassOf hpc:KnlFeaturesPlugin .
hpc:LinuxReboot a owl:ObjectProperty ;
    rdfs:domain hdfs:KnlGenericPlugin .
