hpc:Library a owl:Class .
hpc:Loggingsystem a owl:Class .
hpc:Stderr a rdf:PlainLiteral .
hpc:Syslog a rdf:PlainLiteral .
hpc:librarylogging a owl:ObjectProperty ;
    rdfs:domain hpc:Library ;
    rdfs:range hpc:Loggingsystem .
hpc:logginglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Library ;
    rdfs:range xsd:string .
hpc:jobcomploc a owl:DatatypeProperty ;
    rdfs:domain hpc:Library ;
    rdfs:range xsd:string .
hpc:libraryconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Library .
