hpc:Error a owl:Class .
hpc:start a owl:ObjectProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range hpc:Starttime .
hpc:StartTime rdfs:datatype xsd:string .

hpc:Schedulerparams a owl:Class .
hpc:resourcerequirements a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range hpc:Resourcerequirement .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:string .
hpc:Resourcerequirement a owl:Class .
hpc:rerunnable a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:boolean .
hpc:userpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:positiveInteger .
hpc:serviceclass a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:string .
hpc:group a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:string .
hpc:externalscheduler a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:string .
hpc:hold a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:boolean .
hpc:jobgroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparams ;
    rdfs:range xsd:string .

hpc:deadline a owl:ObjectProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range hpc:Deadlinetime .
hpc:DeadlineTime rdfs:datatype xsd:string .

hpc:reservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:string .

hpc:dependencies a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:string .
