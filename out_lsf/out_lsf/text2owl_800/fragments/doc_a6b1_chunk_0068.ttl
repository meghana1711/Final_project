hpc:lsbKrbCheckInterval a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Controls the time interval for TGT checking." .

hpc:lsbKrbRenewMargin a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:nonNegativeTime ;
    rdfs:comment "Controls how much elapses before TGT is renewed." .

hpc:lsbKrbTgtDir a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Specifies where to store TGT on the execution host." .

hpc:Executionhost a owl:Class .
