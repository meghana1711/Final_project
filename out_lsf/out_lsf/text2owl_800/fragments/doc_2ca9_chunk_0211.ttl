hpc:Lsfversion a owl:Class .
hpc:Fixpack a owl:Class .

# LSF Version has Fix Pack
hpc:Lsfversion rdfs:subClassOf owl:Class .
hpc:Lsfversion rdfs:subClassOf hpc:Version .
hpc:Fixpack rdfs:subClassOf owl:Class .
hpc:Fixpack rdfs:subClassOf hpc:Version .
hpc:Version rdfs:subClassOf owl:Class .

# bhosts -aff
hpc:bhostsaffoption a owl:ObjectProperty .
hpc:Bhostsaffoption rdfs:domain hpc:Command .
hpc:Bhostsaffoption rdfs:range hpc:Option .

# bhosts -rc and bhosts -rconly
hpc:bhostsrccommand a owl:ObjectProperty .
hpc:Bhostsrccommand rdfs:domain hpc:Command .
hpc:bhostsrconlycommand a owl:ObjectProperty .
hpc:Bhostsrconlycommand rdfs:domain hpc:Command .

# mosquitto message queue application
hpc:Mosquitto a owl:Class .

# LSF_MQ_BROKER_HOSTS
hpc:lsfMqBrokerHosts a owl:DatatypeProperty .
hpc:LsfMqBrokerHosts rdfs:domain hpc:Configuration .
hpc:LsfMqBrokerHosts rdfs:range xsd:string .

# bhosts -rc and bhosts -rconly in LSF Version 10.1 Fix Pack 8
hpc:provisionedhostinstanceid a owl:DatatypeProperty .
hpc:Provisionedhostinstanceid rdfs:domain hpc:Provisionedhost .
hpc:Provisionedhostinstanceid rdfs:range xsd:string .

# bhosts -l in LSF Version 10.1 Fix Pack 10
hpc:lockedid a owl:DatatypeProperty .
hpc:Lockedid rdfs:domain hpc:Closedhost .
hpc:lockid a owl:DatatypeProperty .
hpc:Lockid rdfs:domain hpc:Lock .
hpc:lockcomment a owl:DatatypeProperty .
hpc:Lockcomment rdfs:domain hpc:Lock .

# bhosts -l in LSF Version 10.1 Fix Pack 10 (detailed information)
hpc:hostattribute a owl:DatatypeProperty .
hpc:Hostattribute rdfs:domain hpc:Host .
hpc:Hostattribute rdfs:range xsd:string .

# bhosts -attr in LSF Version 10.1 Fix Pack 10
hpc:hostattributeaffinityscheduling a owl:ObjectProperty .
hpc:Hostattributeaffinityscheduling rdfs:domain hpc:Command .
hpc:Hostattributeaffinityscheduling rdfs:range hpc:Hostattribute .

# bhosts -o in LSF Version 10.1
