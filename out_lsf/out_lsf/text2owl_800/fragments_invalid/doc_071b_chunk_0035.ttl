hpc:HostModel rdfs:subPropertyOf hpc:Host .
hpc:Cpuperformance rdfs:domain hpc:Host .
hpc:Cpu rdfs:range xsd:string .
hpc:Ncpus rdfs:range xsd:nonNegativeInteger .
hpc:Maxmem rdfs:range xsd:string .
hpc:Maxswp rdfs:range xsd:string .
