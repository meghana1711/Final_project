hpc:AdministratorUser a hpc:User .
hpc:PrimaryAdministrator a hpc:AdministratorUser .

hpc:hasrights a owl:ObjectProperty .

hpc:RunBhistAT a hpc:HasRights .

hpc:Regularuser rdfs:subClassOf hpc:User .
hpc:Administratoruser rdfs:subClassOf hpc:User .
hpc:Primaryadministrator rdfs:subClassOf hpc:Administratoruser .

hpc:Regularuser rdfs:domain hpc:Hasrights .
hpc:Primaryadministrator rdfs:domain hpc:Hasrights .

hpc:Hasrights rdfs:range xsd:boolean .

