hpc:Chcommand a owl:Class .
hpc:Hasprompt rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:string .
hpc:Supportsscript rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:boolean .
hpc:Supportshistory rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:boolean .
hpc:Supportsalias rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:boolean .
hpc:Suspendsbyctrz rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:boolean .
hpc:Showsprompt rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:string .
hpc:Exitstatus rdfs:domain hpc:Chcommand ;
    rdfs:range xsd:nonPositiveInteger .
hpc:Relatedcommand rdfs:domain hpc:Chcommand ;
    rdfs:range rdf:* .
hpc:Lsfglobalpolicydaemon a owl:Class .
hpc:Runsonlsfmanagementhost rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:boolean .
hpc:Readslsfconf rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:string .
hpc:Startsnewdaemononfailure rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:boolean .
hpc:Checkssyntax rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:boolean .
hpc:Verbosemessages rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:boolean .
hpc:Doesnotrunonmanagementhost rdfs:domain hpc:Lsfglobalpolicydaemon ;
    rdfs:range xsd:boolean .
hpc:lsfserverdir a owl:ObjectProperty .
hpc:Debuglevel rdfs:domain hpc:Lsfserverdir ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Help rdfs:domain hpc:Lsfserverdir ;
    rdfs:range xsd:string .
hpc:Lsfenvironmentdirectory rdfs:domain hpc:Lsfserverdir ;
    rdfs:range xsd:string .
