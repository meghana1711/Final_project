hpc:SlurmNode a owl:Class .

hpc:OpenApiNodeResponse a owl:Class ;
  rdfs:subClassOf hpc:SlurmNode .

hpc:UpdateNodeMsg a owl:Class ;
  rdfs:subClassOf hpc:SlurmNode .

hpc:OpenApiResp a owl:Class ;
  rdfs:subClassOf hpc:SlurmNode .

hpc:updateNodeMsgProp a owl:ObjectProperty ;
  rdfs:domain hpc:UpdateNodeMsg ;
  rdfs:range hpc:SlurmNode .

hpc:openapi_nodes_resp a owl:ObjectProperty ;
  rdfs:domain hpc:OpenApiNodeResponse ;
  rdfs:range hpc:SlurmNode .

hpc:openapi_resp a owl:ObjectProperty ;
  rdfs:domain hpc:OpenApiResp ;
  rdfs:range hpc:SlurmNode .
