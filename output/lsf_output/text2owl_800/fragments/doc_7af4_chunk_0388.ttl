hpc:slatimer a owl:DatatypeProperty ;
    rdfs:domain hpc:Slascheduler ;
    rdfs:range xsd:integer ;
    rdfs:minLength 2 ;
    rdfs:maxLength 21474847 .

hpc:sschedAcctDir a owl:ObjectProperty ;
    rdfs:domain hpc:Sessionscheduler ;
    rdfs:range xsd:string ;
    rdfs:maxLength 4096 .

hpc:sschedMaxRunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger .
