hpc:Object a owl:Class .

hpc:qos_resp a owl:Class .
hpc:Qos a owl:Class ;
    rdfs:subClassOf hpc:Object ;
    rdfs:domain hpc:qos_resp ;
    rdfs:range rdf:Resource .

hpc:limits a owl:Class ;
    rdfs:subClassOf hpc:Qos ;
    rdfs:domain hpc:qos_resp ;
    rdfs:range rdf:List .

hpc:limit a owl:Class ;
    rdfs:subClassOf hpc:Qos ;
    rdfs:domain hpc:limits ;
    rdfs:range xsd:string .

hpc:tres a owl:Class ;
    rdfs:subClassOf hpc:limit ;
    rdfs:domain hpc:limits ;
    rdfs:range xsd:duration .

hpc:minutes a owl:Class ;
    rdfs:subClassOf hpc:Tres ;
    rdfs:domain hpc:limits ;
    rdfs:range xsd:nonNegativeInteger .

hpc:total a owl:Class ;
    rdfs:subClassOf hpc:Minutes ;
    rdfs:domain hpc:limits ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Error a owl:Class ;
    rdfs:subClassOf hpc:Object .

hpc:errors a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range rdf:List .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:string .

hpc:error a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:string .

hpc:error_number a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:int .

hpc:source a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range xsd:string .

hpc:meta a owl:DatatypeProperty ;
    rdfs:domain hpc:Error ;
    rdfs:range rdf:List .

hpc:client a owl:Class ;
    rdfs:subClassOf hpc:Meta .

hpc:group a owl:DatatypeProperty ;
    rdfs:domain hpc:Client ;
    rdfs
