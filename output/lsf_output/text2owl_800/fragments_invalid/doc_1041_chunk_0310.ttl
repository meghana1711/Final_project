hpc:Bjobs a owl:Class .
hpc:Commandoption a owl:Class .
hpc:Filtercategory a owl:Class .
hpc:Optiondescription a owl:Class .
hpc:Synopsis a owl:Class .
hpc:Conflictingoptions a owl:Class .

hpc:hasdescription a owl:ObjectProperty ;
    rdfs:domain hpc:Commandoption ;
    rdfs:range xsd:string .

hpc:belongstocategory a owl:ObjectProperty ;
    rdfs:domain hpc:Commandoption ;
    rdfs:range hpc:Filtercategory .

hpc:hasdetaileddescription a owl:ObjectProperty ;
    rdfs:domain hpc:Commandoption ;
    rdfs:range xsd:string .

hpc:conflictswith a owl:ObjectProperty ;
    rdfs:domain wfs:CommandOption ;
    rdfs:range wfs:CommandOption .

hpc:defaultdisplay a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .

hpc:condensedoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:boolean .

hpc:noncondensedoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:boolean .

hpc:shorthostlist a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:boolean .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Bjobs .

hpc:hasautomaticallyresizableattribute a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .

hpc:hasresizenotificationcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .
