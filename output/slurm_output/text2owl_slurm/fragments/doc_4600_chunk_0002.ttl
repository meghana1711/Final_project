hpc:Job a owl:Class .
hpc:basepath a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:isrunning a owl:ObjectProperty ;
    rdfs:range xsd:boolean .

hpc:hastmpdir a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Directory .

hpc:Directory a owl:Class .

hpc:isownedby a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:string .

hpc:isaccessibleto a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:string .

hpc:isempty a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:boolean .

hpc:isbindmounted a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:boolean .

hpc:Taskprolog a owl:Class .

hpc:isexecutedinsidecontainer a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Taskprolog .

hpc:interfaceswithspankapi a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:spankTaskInitPrivileged a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:spankTaskInit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
