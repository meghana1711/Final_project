hpc:Jobcontrolaction a owl:Class .
hpc:SuspendJobControl a hpc:JobControlAction ;
    rdfs:subClassOf hpc:Jobcontrolaction ;
    rdfs:domain hpc:Application .
hpc:ResumeJobControl a hpc:JobControlAction ;
    rdfs:subClassOf hpc:Jobcontrolaction ;
    rdfs:domain hpc:Application .
hpc:jobcontrolsignal a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspendjobcontrol ;
    rdfs:range xsd:string .
hpc:resumeaction a owl:DatatypeProperty ;
    rdfs:domain hpc:Resumejobcontrol ;
    rdfs:range xsd:string .
hpc:Preemptedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:KillAndRequeueJobControl a hpc:JobControlAction ;
    rdfs:subClassOf hpc:Jobcontrolaction ;
    rdfs:domain hpc:Application .
