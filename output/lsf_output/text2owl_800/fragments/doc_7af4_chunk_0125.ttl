hpc:Watchdog a owl:Class .

hpc:script a owl:ObjectProperty ;
    rdfs:domain hpc:Watchdog ;
    rdfs:range xsd:string .

hpc:init a owl:DatatypeProperty ;
    rdfs:domain hpc:Watchdog ;
    rdfs:range xsd:integer .

hpc:period a owl:DatatypeProperty ;
    rdfs:domain hpc:Watchdog ;
    rdfs:range xsd:integer .

hpc:lsbGpuAllocInfo a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobAvgMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobCpuTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobMaxMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobNthread a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobPgids a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobPids a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .
hpc:lsbJobSwap a owl:DatatypeProperty ;
    rdfs:domain hpc:Script .

hpc:InitDelay rdfs:subClassOf hpc:Watchdog .
hpc:StartInterval rdfs:subClassOf hpc:Watchdog .
