hpc:Killjobtaskexit rdfs:subClassOf hpc:Remotetask .

hpc:IGNORE_TASKCRASH a owl:NamedIndividual ;
    hpc:LSB_DJob_RTask_Gone_Action "IGNORE_TASKCRASH" .

