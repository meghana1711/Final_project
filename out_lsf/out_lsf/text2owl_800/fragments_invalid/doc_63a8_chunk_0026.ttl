hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:domain hpc:Datamanager .

# File
hpc:File a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:domain hpc:Datamanager .

# Cache
hpc:cache a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Job .

# HashStatus
hpc:hashstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

# XferJob
hpc:xferjob a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

# Grace
hpc:grace a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

# Input
hpc:input a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .

# Output
hpc:output a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .

# TO
hpc:to a owl:ObjectProperty ;
    rdfs:domain hpc:Output ;
    rdfs:range hpc:File .

# Example: Job 84044
hpc:Job_84044 a hpc:Job ;
    hpc:Cache "bdata cache 84044" .

hpc:Job84044 hpc:input [
    hpc:File_data2 a hpc:File ;
        hpc:HashStatus "68990b*" ;
        hpc:XferJob "" ;
        hpc:Grace "" .

    hpc:File_data3 a hpc:File ;
        hpc:HashStatus "e2fff4*" ;
        hpc:XferJob "" ;
        hpc:Grace "" .
] .

hpc:Job84044 hpc:output [
    hpc:File_data2 a hpc:File ;
        hpc:TO "hostB:/home/user1/data2" .

    hpc:FileData2 hpc:output [
        hpc:File_data2_out a hpc:File ;
            hpc:HashStatus "68990b*" ;
            hpc:XferJob "84091@cluster1" ;
            hpc:Grace "" .

        hpc:FileData2Out hpc:to "hostA:/scratch/user1/workspace" .
    ] .

    hpc:FileData3 hpc:output [
        hpc:File_data3_xfer a hpc:File ;
            hpc:HashStatus "e2fff4*" ;
            hpc:XferJob "84056@cluster1" ;
            hpc:Grace "" .
    ] .
] .
