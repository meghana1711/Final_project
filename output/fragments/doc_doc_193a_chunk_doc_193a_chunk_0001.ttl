hpc:ConfiglessSlurm a owl:Class .
hpc:SlurmController a owl:Class .
hpc:SlurmNode a owl:Class .
hpc:LoginNode a owl:Class, rdfs:subClassOf hpc:SlurmNode .
hpc:SlurmdProcess a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:SlurmCTLDConfigFile a owl:Class .
hpc:SlurmdStartup a owl:ObjectProperty .
hpc:SlurmdStartup rdfs:domain hpc:SlurmdProcess ;
                   rdfs:range hpc:SlurmController .
hpc:DNSRecord a owl:Class .
hpc:DNSRecord rdfs:subClassOf xsd:string .
hpc:HasDNSRecord a owl:ObjectProperty .
hpc:HasDNSRecord rdfs:domain hpc:SlurmController ;
                  rdfs:range hpc:DNSRecord .
hpc:Sackd a owl:Class .
hpc:ManagesConfigFiles a owl:ObjectProperty .
hpc:ManagesConfigFiles rdfs:domain hpc:SlurmNode ;
                        rdfs:range hpc:Sackd .
hpc:SlurmConfigless a owl:ObjectProperty .
hpc:SlurmConfigless rdfs:domain hpc:SlurmController ;
                     rdfs:range hpc:ConfiglessSlurm .
hpc:SlurmConfiglessMode a owl:ObjectProperty .
hpc:SlurmConfiglessMode rdfs:domain hpc:SlurmController ;
                         rdfs:range hpc:Boolean .
hpc:SlurmCTLDConfigFileLocation a owl:DatatypeProperty .
hpc:SlurmCTLDConfigFileLocation rdfs:domain hpc:SlurmCTLDConfigFile .
hpc:SlurmConf a owl:Class .
```
