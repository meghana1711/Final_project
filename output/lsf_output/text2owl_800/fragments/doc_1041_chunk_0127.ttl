hpc:Usergroup a owl:Class .
hpc:action a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .

hpc:addmember a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Action ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .

hpc:remmember a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Action ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .

hpc:objecttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Action .

hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Action ;
    rdfs:range xsd:string .

hpc:valuepair a owl:DatatypeProperty ;
    rdfs:domain hpc:Objecttype ;
    rdfs:range xsd:string .

hpc:Reservedword a owl:Class .
hpc:Excludedelement a owl:Class .
hpc:Regularexpression a owl:Class .
