hpc:Command a owl:Class .
hpc:hasDefaultBehavior rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Defaultbehavior .
hpc:Defaultbehavior a owl:Class .
hpc:hasReregistrationInterval rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:integer .
hpc:hasReleaseVersion rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:changeHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:homeHost rdf:type owl:Class .
hpc:shellModeSupport rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:boolean .
hpc:runTimeDisplay rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:boolean .
hpc:chCommand rdf:type owl:Class ;
    rdfs:subClassOf hpc:Command .
hpc:helpCommand rdf:type owl:Class ;
    rdfs:subClassOf hpc:Command .
hpc:versionCommand rdf:type owl:Class ;
    rdfs:subClassOf hpc:Command .
