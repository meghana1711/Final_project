hpc:Resizablejob a owl:Class .
hpc:alternativeresourcerequirement a owl:ObjectProperty .
hpc:compoundresourcerequirement a owl:ObjectProperty .
hpc:computeunitrequirement a owl:ObjectProperty .
hpc:maxcus a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:Enclosure a owl:Class .
hpc:balance a owl:ObjectProperty .
hpc:usablecuslots a owl:DatatypeProperty .
hpc:excl a owl:ObjectProperty .
hpc:Autoresizablejob a owl:Class .

hpc:Resizablejob rdfs:subClassOf hpc:Job .
hpc:Alternativeresourcerequirement rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Resourcerequirement .
hpc:Compoundresourcerequirement rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Compoundresource .
hpc:Computeunitrequirement rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Computeunitrequirement .
hpc:Maxcus rdfs:domain hpc:Computeunitrequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Type rdfs:domain hpc:Computeunitrequirement ;
    rdfs:range hpc:Enclosure .
hpc:Balance rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Resourceallocation .
hpc:Usablecuslots rdfs:domain hpc:Computeunitrequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Excl rdfs:domain hpc:Computeunitrequirement ;
    rdfs:range hpc:Computeunit .
