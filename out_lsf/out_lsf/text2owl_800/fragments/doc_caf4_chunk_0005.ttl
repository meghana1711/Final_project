hpc:ResReq a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Queue ] .

hpc:AppProfileResReq a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:ResReq ] .

hpc:in a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Queue .

hpc:inAppProfile a owl:ObjectProperty ;
    rdfs:domain hpc:AppProfileResReq ;
    rdfs:range hpc:ResReq .
