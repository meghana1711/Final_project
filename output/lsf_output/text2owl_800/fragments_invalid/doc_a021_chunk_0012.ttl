hpc:Provisioningscript a owl:Class .
hpc:Preprovisioningscript a owl:Class .
hpc:Postprovisioningscript a owl:Class .
hpc:Instance a owl:Class .

# Object Properties
hpc:hasresult a owl:ObjectProperty .
hpc:hasmessage a owl:ObjectProperty .
hpc:hasmachine a owl:ObjectProperty .

# Datatype Properties
hpc:resulttype a owl:DatatypeProperty .
hpc:message a owl:DatatypeProperty .
hpc:machinename a owl:DatatypeProperty .

# Domain and Range
rdfs:domain hpc:Hasresult hpc:Provisioningscript .
rdfs:domain hpc:Hasmessage hpc:Provisioningscript .
rdfs:domain hpc:Hasmachine hpc:Provisioningscript .
rdfs:range hpc:Resulttype xsd:string .
rdfs:range hpc:Message xsd:string .
rdfs:range hpc:Machinename xsd:string .

# Example Pre-Provisioning Script
hpc:PreProvisioningScript1 a hpc:PreProvisioningScript .
hpc:hasResult(hpc:PreProvisioningScript1) owl:someValuesFrom xsd:string .
hpc:hasMessage(hpc:PreProvisioningScript1) owl:someValuesFrom xsd:string .
hpc:hasMachine(hpc:PreProvisioningScript1) rdfs:subPropertyOf hpc:hasMachine .

# Example Post-Provisioning Script
hpc:PostProvisioningScript2 a hpc:PostProvisioningScript .
hpc:hasResult(hpc:PostProvisioningScript2) owl:someValuesFrom xsd:string .
hpc:hasMessage(hpc:PostProvisioningScript2) owl:someValuesFrom xsd:string .
hpc:hasMachine(hpc:PostProvisioningScript2) rdfs:subPropertyOf hpc:hasMachine .

# Example Instance
hpc:Instance1 a hpc:Instance .
hpc:hasMachineName(hpc:Instance1) "instance name" .
