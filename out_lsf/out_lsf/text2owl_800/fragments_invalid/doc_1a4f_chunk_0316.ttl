hpc:Preemptivescheduling a owl:Class .
hpc:preemptableresources a owl:ObjectProperty .
hpc:Preemptableresources rdfs:domain hpc:Preemptivescheduling .
hpc:Preemptableresources rdfs:range rdf:List .
hpc:Preemptableresources rdfs:range rdf:first hpc:Jobslot .
hpc:Preemptableresources rdfs:range rdf:rest* rdf:Resource .
hpc:Preemptableresources rdfs:range rdf:rest rdf:first rdf:Description ;
  hpc:resourceName ?resource .

hpc:custompreemptionaction a owl:ObjectProperty .
hpc:Custompreemptionaction rdfs:domain hpc:Preemptivescheduling .
hpc:Custompreemptionaction rdfs:range rdf:Resource .

hpc:Preemptedjob a owl:Class .
hpc:Preemptedjob rdfs:subClassOf rdf:Resource .

hpc:suspendjobcontrol a owl:ObjectProperty .
hpc:Suspendjobcontrol rdfs:domain hpc:Preemptedjob .
hpc:Suspendjobcontrol rdfs:range rdf:Resource .

hpc:resumejobcontrol a owl:ObjectProperty .
hpc:Resumejobcontrol rdfs:domain hpc:Preemptedjob .
hpc:Resumejobcontrol rdfs:range rdf:Resource .

hpc:releaseresource a owl:ObjectProperty .
hpc:Releaseresource rdfs:domain hpc:Preemptedjob .
hpc:Releaseresource rdfs:range rdf:Resource .

hpc:customsuspendjobcontrol a owl:ObjectProperty .
hpc:Customsuspendjobcontrol rdfs:domain hpc:Preemptedjob .
hpc:Customsuspendjobcontrol rdfs:range rdf:Resource .

hpc:brequequesuspendjobcontrol a owl:ObjectProperty .
hpc:Brequequesuspendjobcontrol rdfs:domain hpc:Preemptedjob .
hpc:Brequequesuspendjobcontrol rdfs:range rdf:Resource .
