hpc:EgoDaemon a owl:Class .
hpc:LsfDaemon a owl:Class .
hpc:OperatingsystemDaemonControl a owl:Class .
hpc:EgoServiceController a owl:Class .

hpc:vemkd a owl:ObjectProperty ;
    rdfs:domain hpc:EgoDaemon ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Started by lim on management host" .

hpc:pem a owl:ObjectProperty ;
    rdfs:domain hpc:EgoDaemon ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Started by lim on every host" .

hpc:egosc a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:EgoDaemon ;
    rdfs:comment "Started by vemkd on management host" .

hpc:mbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Started by sbatchd on management host" .

hpc:mbschd a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Started by mbatchd on management host" .

hpc:sbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:EgoDaemon ;
    rdfs:comment "Under OS startup mode, sbatchd is started by pem as an EGO service on every host" .

hpc:res a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:EgoDaemon ;
    rdfs:comment "Under OS startup mode, res is started by pem as an EGO service on every host" .

hpc:lim a owl:ObjectProperty ;
    rdfs:domain hpc:EgoDaemon ;
    rdfs:range xsd:string ;
    rdfs:comment "lim runs on every host" .

hpc:pim a owl:ObjectProperty ;
    rdfs:domain hpc:EgoDaemon ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Started by lim on every host" .

hpc:operatingsystemStartupMode a owl:ObjectProperty ;
    rdfs:domain hpc:OperatingsystemDaemonControl ;
    rdfs:range hpc:LsfDaemon ;
    rdfs:comment "Operating system startup mode is the same as previous releases" .

