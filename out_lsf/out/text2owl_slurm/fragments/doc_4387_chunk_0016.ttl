hpc:Mysqlconnection a owl:Class .
hpc:mysqlserverversion a owl:DatatypeProperty .
hpc:Mysqlserverversion rdfs:domain hpc:Mysqlconnection .
hpc:Mysqlserverversion rdfs:range xsd:string .

hpc:Mysqluser a owl:Class .
hpc:mysqluserid a owl:DatatypeProperty .
hpc:Mysqluserid rdfs:domain hpc:Mysqluser .
hpc:Mysqluserid rdfs:range xsd:string .
hpc:mysqluserpassword a owl:DatatypeProperty .
hpc:Mysqluserpassword rdfs:domain hpc:Mysqluser .
hpc:Mysqluserpassword rdfs:range xsd:string .

hpc:grantallprivilegesondatabase a owl:ObjectProperty .
hpc:Grantallprivilegesondatabase rdfs:domain hpc:Mysqlconnection .
hpc:Grantallprivilegesondatabase rdfs:range hpc:Mysqluser .

hpc:hostname a owl:DatatypeProperty .
hpc:Hostname rdfs:domain hpc:Mysqluser .
hpc:Hostname rdfs:range xsd:string .

hpc:Database a owl:Class .
hpc:databasename a owl:DatatypeProperty .
hpc:Databasename rdfs:domain hpc:Database .
hpc:Databasename rdfs:range xsd:string .

hpc:grantoption a owl:ObjectProperty .
hpc:Grantoption rdfs:domain hpc:Grantallprivilegesondatabase .
hpc:Grantoption rdfs:range rdf:Resource .

hpc:Slurmaccountdatabase a owl:Class .
hpc:Slurmaccountdatabase rdfs:subClassOf hpc:Database .

hpc:Systemhost a owl:Class .
hpc:Systemhost rdfs:subClassOf hpc:Hostname .
