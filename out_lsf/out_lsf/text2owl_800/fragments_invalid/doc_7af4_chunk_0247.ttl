hpc:Encl3 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:hasHost rdf:List ( hpc:hostA hpc:hostB ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "noncondensed"^^xsd:string .

hpc:Encl4 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:hasHost rdf:List ( ?hgroupX ) ;
    hpc:hasHost rdf:List ( ?hostB ) ;
    hpc:excludesHost rdf:List ( hpc:hostB ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "noncondensed"^^xsd:string ;
    hpc:administeredBy rdf:List ( hpc:clusterAdmin ) .

hpc:Encl5 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:hasHost rdf:List ( ?hostC ?hostC101 ?hostC150 ) ;
    hpc:hasHost rdf:List ( ?hostC ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "condensed"^^xsd:string ;
    hpc:administeredBy rdf:List ( hpc:usergroupJ ) .

hpc:Rack1 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:containsRack rdf:List ( hpc:encl1 hpc:encl2 hpc:encl3 ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "condensed"^^xsd:string .

hpc:Rack2 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:containsRack rdf:List ( hpc:encl4 hpc:encl5 ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "uncondensed"^^xsd:string .

hpc:Rack3 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:containsRack rdf:List ( hpc:encl6 ) ;
    hpc:outputType owl:Thing ;
    hpc:showOutput rdfs:Literal "uncondensed"^^xsd:string .

hpc:Cbnt1 a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    hpc:containsRack rdf:List ( hpc:rack1 hpc:rack2 ) .
