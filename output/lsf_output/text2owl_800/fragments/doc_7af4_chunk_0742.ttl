hpc:LsbProfileMbd a owl:Class .
hpc:hasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:LsbProfileMbd ;
    rdfs:range xsd:string .

hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbProfileMbd ;
    rdfs:range xsd:integer .

hpc:IntervalSeconds rdfs:subClassOf xsd:nonNegativeInteger .

hpc:threshold a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbProfileMbd ;
    rdfs:range xsd:float .

hpc:ThresholdThresholdPortion rdfs:subClassOf xsd:float .

hpc:logLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbProfileMbd ;
    rdfs:range xsd:string .

hpc:LogInfo rdfs:subClassOf xsd:string .

hpc:timeLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbProfileMbd ;
    rdfs:range xsd:integer .

hpc:TimeLevelMilliseconds rdfs:subClassOf xsd:nonNegativeInteger .
