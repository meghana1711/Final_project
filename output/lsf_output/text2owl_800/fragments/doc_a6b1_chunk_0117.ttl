hpc:Executioncluster a owl:Class .
hpc:Org a owl:Class .
hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Saap a owl:Class .
hpc:Remotecluster a owl:Class .
hpc:Multiclusterenvironment a owl:Class .
hpc:Globalfairsharescheduling a owl:Class .
hpc:Queueleveluserbasedfairsharescheduling a owl:Class .
hpc:Allmodesynchronization a owl:Class .
hpc:Lsbglobalpoliciesconfigurationfile a owl:Class .
hpc:SyncInterval a xsd:nonNegativeInteger .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:affectssaap a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Saap .

hpc:hassaapremote a owl:ObjectProperty ;
    rdfs:domain hpc:Saap ;
    rdfs:range hpc:Remotecluster .

hpc:hasorg a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Org .

hpc:ispartof a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Multiclusterenvironment .

hpc:hasglobalfairsharescheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Globalfairsharescheduling .

hpc:hasqueueleveluserbasedfairsharescheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Globalfairsharescheduling ;
    rdfs:range hpc:Queueleveluserbasedfairsharescheduling .

hpc:hasallmodesynchronization a owl:ObjectProperty ;
    rdfs:domain hpc:Queueleveluserbasedfairsharescheduling ;
    rdfs:range hpc:Allmodesynchronization .

hpc:haslsbglobalpoliciesconfigurationfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Globalfairsharescheduling ;
    rdfs:range hpc:Lsbglobalpoliciesconfigurationfile .

hpc:hassyncinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbglobalpoliciesconfigurationfile ;
    rdfs:range xsd:nonNegativeInteger .

hpc:HighIOOrgs a hpc:Tree ;
    rdfs:subClassOf hpc:Executioncluster .

hpc:Cluster1 a hpc:ExecutionCluster ;
    hpc:Ispartof hpc:highioorgs ;
    hpc:Hasorg hpc:orga ;
    hpc:Hasorg hpc:orgb .

hpc:Cluster2 a hpc:ExecutionCluster ;
    hpc:Ispartof hpc:highioorgs ;
    hpc:Hasorg hpc:orga ;
    hpc:Hasorg hpc:orgb .
