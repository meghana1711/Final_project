hpc:Dmddaemon a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the local dmd daemon that collects information for the scheduler forwarding decision." .

hpc:configuredincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Dmddaemon ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "Indicates the cluster where the dmd daemon is configured." .

hpc:Excludedfromscheduling a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a cluster that is excluded from being scheduled for job forwarding." .

hpc:Forwardingcluster a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a candidate forwarding cluster." .

hpc:scheduledforjobforwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:Forwardingcluster ;
    rdfs:comment "Indicates the forwarding cluster that is scheduled for job forwarding by the scheduler." .
