@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Projectgroup a owl:Class .
hpc:Group a owl:Class .
hpc:Project a owl:Class .

hpc:hasChildGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Group .

hpc:hasChildProject rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Project .

hpc:P6 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Project .

hpc:P7 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Project .

hpc:P8 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Project .

hpc:P2 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Project .

hpc:P3 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range rdf:Resource .

hpc:P4 rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .

hpc:P5 rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .

hpc:inuseUsage rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .

hpc:priority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
