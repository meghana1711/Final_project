hpc:Jobarray a owl:Class .
hpc:jobSwitch a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Event .
hpc:jobSwitch2 a owl:ObjectProperty ;
    rdfs:subClassOf hpc:JobSwitch ;
    rdfs:comment "Reduces memory usage of mbatchd when replaying bswitch destination_queue job_ID, reduces reading records from lsb.events, and improves management batch scheduler performance." .
hpc:memoryusagereduction a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSwitch2 ;
    rdfs:range xsd:decimal .
hpc:timereduction a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSwitch2 ;
    rdfs:range xsd:decimal .
hpc:Queue a owl:Class .
hpc:dispatchbyqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Schedulingdecision .
hpc:Schedulingsession a owl:Class ;
    rdfs:subClassOf hpc:Schedulingdecision .
hpc:queueresponsiveness a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .
hpc:signal a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Switchevent .
hpc:Switchevent a owl:Class .
