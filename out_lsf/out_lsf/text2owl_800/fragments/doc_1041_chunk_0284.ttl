hpc:specifiedterminatetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:timeStamp .

hpc:Terminatetime a owl:Class .

hpc:timeleft a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:seconds .

hpc:finishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:timeStamp .

hpc:estimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:ertime .

hpc:ruutime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:seconds .

hpc:rstime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:seconds .

hpc:percentcomplete a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:warningaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobaction .

hpc:actionwarningtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:warn_time .

hpc:Pendstate a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf [ a owl:Class ;
                                         rdfs:subClassOf owl:Thing ] ] .
