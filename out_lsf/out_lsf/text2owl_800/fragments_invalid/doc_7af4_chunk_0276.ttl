hpc:Defaultjobgroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Default Job Group" ;
    rdfs:comment "The name of the default job group. When you submit a job to LSF without explicitly specifying a job group, LSF associates the job with the specified job group.";

hpc:hasdefaultjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Defaultjobgroup ;
    rdfs:label "hasDefaultJobGroup" ;
    rdfs:comment "The default job group associated with a job submission.";

hpc:jobgroupname a owl:DatatypeProperty ;
    rdfs:domain hpc:Defaultjobgroup ;
    rdfs:range xsd:string ;
    rdfs:label "jobGroupName" ;
    rdfs:comment "The name of the default job group.";

hpc:jobgroupnameformat a owl:ObjectProperty ;
    rdfs:domain hpc:Defaultjobgroup ;
    rdfs:range xsd:string ;
    rdfs:label "jobGroupNameFormat" ;
    rdfs:comment "The format of the default job group name.";

hpc:startswithslash a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupnameformat ;
    rdfs:range xsd:boolean ;
    rdfs:label "startsWithSlash" ;
    rdfs:comment "Indicates whether the default job group name starts with a slash.";
