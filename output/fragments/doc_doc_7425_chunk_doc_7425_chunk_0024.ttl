hpc:PartitionInfo a owl:Class;
    rdfs:subClassOf <http://example.org/hpc#PartitionInfo_v0_0_39>.

hpc:PartitionInfo_v0_0_39 rdf:type owl:Class;
    rdfs:subClassOf owl:Class;
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:cpusPerNode;
                       owl:maxValue xsd:integer ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:cpusPerSocket;
                       owl:maxValue xsd:integer ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:memoryPerCpu;
                       owl:hasValue xsd:decimal ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:nodes;
                       owl:maxValue xsd:integer ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:shares;
                       owl:maxValue xsd:integer ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:time;
                       owl:maxValue xsd:duration ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:priority;
                       owl:hasValue xsd:decimal ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:timeouts;
                       owl:hasValue xsd:boolean ];

hpc:JobInfo a owl:Class;
    rdf:type owl:Class;
    rdfs:subClassOf <http://example.org/hpc#JobInfo_v0_0_39>.

hpc:JobInfo_v0_0_39 rdf:type owl:Class;
    rdfs:subClassOf owl:Class;
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:requiredMemPerCpu;
                       owl:hasValue xsd:decimal ];
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:requiredMemPerNode;
                       owl:hasValue xsd:decimal ];

hpc:StatsRpc a owl:Class;
    rdf:type owl:Class;
    rdfs:subClassOf <http://example.org/hpc#StatsRpc_v0_0_39>.

hpc:StatsRpc_v0_0_39 rdf:type owl:Class;
    rdfs:subClassOf owl:Class;
    rdfs:subClassOf [ a owl:Restriction;
                       owl:onProperty hpc:time;
                       owl:hasValue xsd:duration ];

