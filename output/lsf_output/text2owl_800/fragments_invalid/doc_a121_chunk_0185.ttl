# Classes
hpc:Host a owl:Class .
hpc:Task a owl:Class .
hpc:Taskfile a owl:Class .
hpc:Jobsubmission a owl:Class .

# Object Properties
hpc:hashost a owl:ObjectProperty .
hpc:hastaskfile a owl:ObjectProperty .
hpc:submitsjob a owl:ObjectProperty .

# Datatype Properties
hpc:taskdirectory a owl:DatatypeProperty .
hpc:jobpid a owl:DatatypeProperty .
hpc:user a owl:DatatypeProperty .
hpc:pollinterval a owl:DatatypeProperty .
hpc:queue a owl:DatatypeProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:joberr a owl:DatatypeProperty .

# Domain and Range
hpc:Hashost rdfs:domain hpc:Host ;
    rdfs:range hpc:Host .
hpc:Hastaskfile rdfs:domain hpc:Task ;
    rdfs:range hpc:Taskfile .
hpc:Submitsjob rdfs:domain hpc:Host ;
    rdfs:range hpc:Jobsubmission .
hpc:Taskdirectory rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:Jobpid rdfs:domain hpc:Taskfile ;
    rdfs:range xsd:string .
hpc:User rdfs:domain hpc:Taskfile ;
    rdfs:range xsd:string .
hpc:Pollinterval rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Queue rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:Jobid rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:Joberr rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .

# Subclass relations
hpc:Host a rdfs:subClassOf owl:Class .
hpc:Task a rdfs:subClassOf hpc:Host .
hpc:Taskfile a rdfs:subClassOf hpc:Task .
hpc:Jobsubmission a rdfs:subClassOf hpc:Task .
