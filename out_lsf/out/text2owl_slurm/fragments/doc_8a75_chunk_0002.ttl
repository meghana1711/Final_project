hpc:Taskprolog a owl:Class .
hpc:Taskepilog a owl:Class .
hpc:prologslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Taskprolog ;
    rdfs:range hpc:Taskprologepilogslurmctld .
hpc:epilogslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Taskepilog ;
    rdfs:range hpc:Taskepilogslurmctld .
hpc:taskprologenvironmentvariablesetting a owl:ObjectProperty ;
    rdfs:domain hpc:Taskprolog ;
    rdfs:range xsd:string .
hpc:taskprologmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Taskprolog ;
    rdfs:range xsd:string .
hpc:Taskprologfailurestate a owl:Class ;
    rdfs:subClassOf hpc:Taskprolog ;
    rdfs:comment "The state of the node when the Prolog fails." .
hpc:Taskprologdrainstate a owl:Class ;
    rdfs:subClassOf hpc:Taskprolog ;
    rdfs:comment "The state of the node when the Prolog causes the node to be set to a DRAIN state." .
hpc:Taskprologloggedfailurestate a owl:Class ;
    rdfs:subClassOf hpc:Taskprolog ;
    rdfs:comment "The state of the job when the Prolog failure is only logged." .
hpc:Taskepilogfailurestate a owl:Class ;
    rdfs:subClassOf hpc:Taskepilog ;
    rdfs:comment "The state of the job when the Epilog fails." .
hpc:Taskepilogloggedfailurestate a owl:Class ;
    rdfs:subClassOf hpc:Taskepilog ;
    rdfs:comment "The state of the job when the Epilog failure is only logged." .
hpc:variablesetting a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskprologenvironmentvariablesetting ;
    rdfs:range xsd:string .
hpc:message a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskprologmessage ;
    rdfs:range xsd:string .
