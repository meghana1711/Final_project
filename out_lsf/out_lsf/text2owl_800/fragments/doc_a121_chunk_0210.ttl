hpc:Lsf a owl:Class .
hpc:Task a owl:Class .
hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:cpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runqueuelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Resource .
hpc:bestavailablehostselection a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .
hpc:specificresourceselection a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .
hpc:specifichostselection a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .
hpc:pseudoterminalselection a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .
hpc:sequentialexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Task .
hpc:parallelexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range rdf:List .
hpc:hostfileselection a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:resourcereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Batchjob ;
    rdfs:range hpc:Resource .
hpc:resourceusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Lsfbase a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
hpc:Lim a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
