hpc:Name rdfs:domain hpc:Guaranteedresourcepool ;
    hpc:NAME rdf:range xsd:string ;
    hpc:Type rdfs:domain hpc:Guaranteedresourcepool ;
    hpc:TYPE rdf:range hpc:PoolType ;
    hpc:Distribution rdfs:domain hpc:Guaranteedresourcepool ;
    hpc:DISTRIBUTION rdf:type owl:ObjectProperty ;
    hpc:Distribution rdfs:range hpc:Distribution ;
    hpc:LoanPolicies rdfs:domain hpc:Guaranteedresourcepool ;
    hpc:LOAN_POLICIES rdf:type owl:ObjectProperty ;
    hpc:LoanPolicies rdfs:range hpc:Loanpolicylist .

hpc:PoolType
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "PoolType" ;
    rdfs:subClass [ a owl:Class ;
                      rdfs:subClassOf hpc:Pooltype ;
                      rdfs:label "package" ;
                      hpc:Slots rdfs:domain self ;
                      hpc:slots rdf:range xsd:nonNegativeInteger ] .

hpc:Distribution
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "Distribution" ;
    rdfs:domain hpc:Distribution ;
    rdfs:subClass [ a owl:Class ;
                      rdfs:subClassOf hpc:Distribution ;
                      rdfs:label "ServiceClassDistribution" ;
                      hpc:Serviceclass rdfs:domain self ;
                      hpc:serviceClass rdf:range hpc:ServiceClass ;
                      hpc:Quantity rdfs:domain self ;
                      hpc:quantity rdf:range xsd:nonNegativeInteger ] .

hpc:ServiceClass
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "ServiceClass" .

hpc:LoanPolicyList
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "LoanPolicyList" ;
    rdfs:subClass [ a owl:Class ;
                      rdfs:subClassOf hpc:Loanpolicylist ;
                      rdfs:label "Queue" ;
                      hpc:Queuename rdfs:domain self ;
                      hpc:queueName rdf:
