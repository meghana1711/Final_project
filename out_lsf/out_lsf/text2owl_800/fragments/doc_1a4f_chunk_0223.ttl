    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:decimal .
hpc:Mem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:decimal .
hpc:Swp rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:decimal .
hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage .
hpc:Slotbasedresource a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage .
hpc:Jobbasedresource a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage .
hpc:Hostbasedresource a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage .
hpc:Duration rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Decay rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Or rdf:type owl:ObjectProperty .
