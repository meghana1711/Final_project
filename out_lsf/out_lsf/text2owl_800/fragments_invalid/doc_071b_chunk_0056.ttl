# HostRange instances
hpc:HostRange1 a hpc:HostRange ;
    rdfs:label "host[1:10,20,30:39].example.com" ;
    rdfs:subClassOf hpc:Hostrange ;
    rdfs:comment "Hosts from 1 to 10, 20, and 30 to 39" ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
