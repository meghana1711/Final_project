hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:Script a owl:Class .
hpc:prioritytier a owl:DatatypeProperty;
    rdfs:domain hpc:Partition;
    rdfs:range xsd:integer.
hpc:default a owl:DatatypeProperty;
    rdfs:domain hpc:Partition;
    rdfs:range xsd:boolean.
hpc:nodes a owl:DatatypeProperty;
    rdfs:domain hpc:Partition;
    rdfs:range xsd:nonNegativeInteger.
hpc:oversubscribe a owl:ObjectProperty;
    rdfs:domain hpc:Partition;
    rdfs:range hpc:Oversubscribetype.
hpc:preemptmode a owl:ObjectProperty;
    rdfs:domain hpc:Partition;
    rdfs:range hpc:Preemptmodetype.
hpc:hasnode a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Node.
hpc:hasscript a owl:ObjectProperty;
