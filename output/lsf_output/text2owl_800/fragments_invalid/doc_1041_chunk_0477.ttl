hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the LSF system." .

# JobID
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

# MSG_ID
hpc:msgId a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:integer .

# FROM
hpc:from a owl:ObjectProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:string .

# POST_TIME
hpc:postTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:dateTime .

# DESCRIPTION
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:string .

# NOTIFICATION
hpc:notification a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:boolean .

# Message
hpc:Message a owl:Class ;
    rdfs:subClassOf hpc:Event ;
    rdfs:comment "Represents a message associated with a job." .

# JobArray
hpc:Jobarray a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an array of jobs." .

# JobArrayElement
hpc:Jobarrayelement a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents an element in a job array." .

# JobArrayElementID
hpc:jobarrayelementid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarrayelement ;
    rdfs:range xsd:nonNegativeInteger .

# JobArrayName
hpc:jobarrayname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

# Command
hpc:Command a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a command used in job management." .

# CommandUsage
hpc:commandusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

# LSFReleaseVersion
hpc:lsfreleaseversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

# JobOwnership
hpc:jobownership a owl:ObjectProperty ;
    rdfs:domain hdfs:Job ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "Indicates the owner of a job." .

# JobQueue
hpc:Jobqueue a owl:Class ;
    rdfs:subClassOf owl:Thing ;
