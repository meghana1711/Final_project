hpc:Jobstarter a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "A script or command that sets up an environment for a job to run." .

hpc:runs a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstarter ;
    rdfs:range hpc:Job ;
    rdfs:comment "The command or script that actually runs when the job starter is executed." .

# C-Shell Job Starter
hpc:CShellJobStarter a hpc:JobStarter ;
    rdfs:subClassOf hpc:Jobstarter ;
    rdfs:comment "A job starter specific to C-shell." .

# DOS Shell Job Starter
hpc:DOSJobStarter a hpc:JobStarter ;
    rdfs:subClassOf hpc:Jobstarter ;
    rdfs:comment "A job starter specific to DOS shell." .

# Queue-level Job Starter
hpc:QueueLevelJobStarter a hpc:JobStarter ;
    rdfs:subClassOf hpc:Jobstarter ;
    rdfs:comment "A job starter defined for an individual queue." .

hpc:affectsqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queueleveljobstarter ;
    rdfs:range hpc:Queue ;
    rdfs:comment "The queue that the queue-level job starter applies to." .

# Job
hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "A task or work unit that is submitted to a job scheduler." .

hpc:hasstarter a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstarter ;
    rdfs:comment "The job starter for a specific job." .

# Queue
hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "A collection of jobs managed by a job scheduler." .

hpc:hasjobstarter a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queueleveljobstarter ;
    rdfs:comment "The queue-level job starter for a specific queue." .
