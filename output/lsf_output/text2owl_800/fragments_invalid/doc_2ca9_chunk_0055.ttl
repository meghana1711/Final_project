hpc:Lsf a owl:Class .
hpc:LsfConf hpc:lsfConfiguration hpc:hasFile rdf:PlainLiteral "lsf.conf" .
hpc:LsfSudoers hpc:lsfConfiguration hpc:hasFile rdf:PlainLiteral "lsf.sudoers" .
hpc:LsfDisableLsrun hpc:lsfConfiguration hpc:hasParameter owl:DatatypeProperty rdf:PlainLiteral "LSF_DISABLE_LSRUN" .
hpc:LsfKrbImpersonate hpc:lsfConfiguration hpc:hasParameter owl:DatatypeProperty rdf:PlainLiteral "LSB_KRB_IMPERSONATE" .
hpc:LsfEauthDataReuse hpc:lsfConfiguration hpc:hasParameter owl:DatatypeProperty rdf:PlainLiteral "LSF_EAUTH_DATA_REUSE" .
hpc:LsfAdministrator hpc:Lsf a rdfs:subClassOf owl:Class .
hpc:LsfDaemon hpc:Lsf a rdfs:subClassOf owl:Class .
hpc:AllowsLsfAdministratorsToStart hpc:lsfDaemon hpc:startedBy hpc:LSF_administrator .
hpc:RestrictsUserAccessToLsmake hpc:Lsf a rdfs:subClassOf owl:Class .
hpc:RestrictsUserAccessToRemoteHosts hpc:Lsf a rdfs:subClassOf owl:Class .
hpc:RequiresKerberosUserImpersonation hpc:Lsf a rdfs:subClassOf owl:Class .
hpc:HasKerberosTgt hpc:lsfJob hpc:hasUser rdf:PlainLiteral "Kerberos TGT user" .
hpc:changesOsSubmissionUser hpc:lsf a owl:ObjectProperty .
hpc:ObtainsKerberosTgt hpc:kerberosCommand hpc:executes rdf:PlainLiteral "kinit -r user_name" .
hpc:DoesNotWorkProperlyWithTokenUserNotOsSubmissionUser hpc:bpeek hpc:dependsOn hpc:OS_file_permissions .
hpc:DoesNotWorkProperlyWithTokenUserNotOsSubmissionUser hpc:brestart hpc:dependsOn hpc:OS_file_permissions .
