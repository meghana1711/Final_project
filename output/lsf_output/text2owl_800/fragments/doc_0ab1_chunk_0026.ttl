    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:glink a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:xgmi a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Affinityjob a owl:Class ;
