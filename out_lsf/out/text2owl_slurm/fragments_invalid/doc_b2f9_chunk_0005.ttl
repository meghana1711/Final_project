@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Gpu a owl:Class .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string .

hpc:file a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu .

hpc:cores a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu .

hpc:link a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu .
