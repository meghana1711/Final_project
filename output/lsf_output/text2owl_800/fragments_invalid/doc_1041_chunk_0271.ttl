hpc:Gpurequirement a owl:Class .
hpc:accountname a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:clusteraffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobarrayjoblimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:decimal .

hpc:jobarrayjoblimitpercent a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:decimal .

hpc:Jobidleexception a owl:Class .

hpc:joblimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:decimal .

hpc:joblimitpercent a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:decimal .

hpc:jobreservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobsynchronousexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:jobType a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:oneOf (hpc:SessionSchedulerJob hpc:JobArray) .

hpc:Pendingjob a owl:Class .

hpc:queueparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:queueparameterjobIdle a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Resourcerequirement a owl:Class .

hpc:resourcerequirementorder a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:resourcerequirementrusage a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Rusage .

hpc:resourcerequirementselect a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:Rusage a owl:Class .

hpc:rusagebasedusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusage ;
    rdfs:range xsd:decimal .

hpc:rusagecharge a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusage ;
    rdfs:range xsd:decimal .

