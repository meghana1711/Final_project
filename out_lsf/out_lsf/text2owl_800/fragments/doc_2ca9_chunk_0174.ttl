hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourceallocation ;
    rdfs:comment "The total of the initial and subsequent job allocations." .

hpc:Computeunittype a owl:Class ;
    rdfs:subClassOf hpc:Resourceallocation ;
    rdfs:comment "The default compute unit type set in the COMPUTE_UNIT_TYPES parameter." .

hpc:computeunitorder a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Computeunit ;
    rdfs:comment "The order of compute units specified by the user." .

hpc:hostpreference a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The host preference specified by the user." .

hpc:computeunitprefpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string ;
    rdfs:comment "The compute unit preference policies." .

hpc:mcSortBySubmitTime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Allows forwarded jobs to be sorted and run based on their original submission time." .

hpc:Computeunitfeaturefunction a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Compute unit feature functions with alternative and compound resource requirements." .

hpc:alternativeresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunitfeaturefunction ;
    rdfs:range xsd:string ;
    rdfs:comment "The merged result of the queue-, application-, and job-level resource requirement is compound or alternative." .

hpc:compoundresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunitfeaturefunction ;
    rdfs:range xsd:string ;
    rdfs:comment "The merged result of the queue-, application-, and job-level resource requirement is compound." .
