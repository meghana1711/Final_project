hpc:Sequentialjob a owl:Class .
hpc:memoryrequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Sequentialjob ;
    rdfs:range xsd:decimal .
hpc:runningtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Sequentialjob ;
    rdfs:range xsd:decimal .
hpc:Jobslot a owl:Class .
hpc:Jobreservation a owl:Class .
hpc:Resourceallocationlimit a owl:Class .
hpc:Resourceconsumer a owl:Class .
hpc:Jobstate a owl:Class .
hpc:freememory a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range xsd:decimal .
hpc:Operatingsystemsoftware a owl:Class .
hpc:Jobscheduling a owl:Class .
hpc:Jobqueue a owl:Class .
hpc:Project a owl:Class .
hpc:Joblimit a owl:Class .
hpc:Limitsection a owl:Class .
hpc:limitappliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Limitsection ;
    rdfs:range hpc:Resourceconsumer .
hpc:resourcelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitsection ;
    rdfs:range xsd:decimal .
hpc:jobslotreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Sequentialjob ;
    rdfs:range hpc:Jobslot .
hpc:memoryreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Sequentialjob ;
    rdfs:range hpc:Resourceallocationlimit .
hpc:freememoryrange a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Freememory .
hpc:operatingsystemorsoftwareusage a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Operatingsystemsoftware .
hpc:jobschedulinglimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Jobscheduling .
hpc:jobqueuelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Jobqueue .
hpc:projectlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Project .
hpc:joblimitnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblimit ;
    rdfs:range xsd:nonNegativeInteger .
