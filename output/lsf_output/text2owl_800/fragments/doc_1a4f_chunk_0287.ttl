hpc:Lsfjob a owl:Class .
hpc:Linuxcgroupmemoryenforcement a owl:Class .
hpc:lsbresourceenforcememory a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Linuxcgroupmemoryenforcement .
hpc:lsfprocesstracking a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:boolean .
hpc:lsflinuxcgroupaccounting a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:boolean .
hpc:lsfjobmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:decimal .
hpc:Linuxcgroupmemoryenforcement rdfs:subClassOf owl:Class .
hpc:LinuxCGroupMemoryEnforcement rdf:type owl:Class .
hpc:LSBResourceEnforceMemory rdf:type owl:ObjectProperty .
hpc:LSFProcessTracking rdf:type owl:ObjectProperty .
hpc:LSFLinuxCGroupAccounting rdf:type owl:ObjectProperty .
hpc:LSFJobMemoryLimit rdf:type owl:DatatypeProperty .
hpc:Linuxcgroupmemoryenforcement rdfs:subClassOf hpc:Linuxcgroupmemoryenforcement ;
    rdfs:comment "Enforcement based on Linux cgroup memory subsystem" .
hpc:Lsbresourceenforcememory rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Linuxcgroupmemoryenforcement ;
    rdfs:subPropertyOf hpc:LinuxCGroupMemoryEnforcement ;
    rdfs:comment "Enforced on a per job and per host basis" .
hpc:Lsfprocesstracking rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:LinuxCGroupMemoryEnforcement ;
    rdfs:comment "Enables LSF to kill jobs cleanly after memory and swap limits are exceeded" .
hpc:Lsflinuxcgroupaccounting rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:LinuxCGroupMemoryEnforcement ;
    rdfs:comment "Provides more accurate memory and swap consumption data for memory and swap enforcement checking" .
hpc:Lsfjobmemorylimit rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf hpc:LinuxCGroupMemoryEnforcement ;
    rdfs:comment "Memory limit for LSF jobs" .
