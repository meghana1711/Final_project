hpc:Jobslotreservation a owl:Class .
hpc:slotReserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslotreservation ;
    rdfs:range xsd:integer .
hpc:maxReserveTime a owl:DatatypeProperty ;
    rdfs:domain hpc:SlotReserve ;
    rdfs:range xsd:integer .
hpc:mbdSleepTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslotreservation ;
    rdfs:range xsd:integer ;
    rdfs:comment "Defined in lsb.params; the default value is 60 seconds." .
hpc:ResourceReserve rdfs:subClassOf hpc:Jobslotreservation .
hpc:Jobslotreservationoverriddenbyresourcereserve rdfs:subClassOf hpc:Jobslotreservation ;
    rdfs:comment "Job slot reservation and memory reservation are enabled and an error is displayed when the cluster is reconﬁgured. SLOT_RESERVE is ignored." .
hpc:errordisplayedonclusterreconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslotreservationoverriddenbyresourcereserve .
hpc:Paralleljobslotreservation rdfs:subClassOf hpc:Jobslotreservation ;
    rdfs:comment "Job slot reservation for parallel jobs is enabled by RESOURCE_RESERVE if the LSF scheduler plug-in module names for both resource reservation and parallel batch jobs (schmod_parallel and schmod_reserve) are conﬁgured in the lsb.modules file: The schmod_parallel name must come before schmod_reserve in lsb.modules." .
hpc:lsbschedulerpluginmodulenames a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljobslotreservation .
hpc:Backfilljob a owl:Class .
hpc:Backfilljobcanusereservedslotsbyotherjobs rdfs:subClassOf hpc:Backfilljob ;
    rdfs:comment "Backﬁll parallel jobs can use job slots reserved by the other jobs, as long as the backﬁll job can ﬁnish before the predicted start time of the jobs with the reservation." .
hpc:canfinishbeforepredictedstarttime a owl:ObjectProperty ;
    rdfs:domain hpc:Backfilljobcanusereservedslotsbyotherjobs .
