hpc:Globalfairsharepolicy a owl:Class .
hpc:Globalfairsharetree a owl:Class .
hpc:Participant a owl:Class .
hpc:Shareaccount a owl:Class .
hpc:shareattributeaccountpath a owl:DatatypeProperty .
hpc:globalresourceusage a owl:DatatypeProperty .
hpc:Cluster a owl:Class .
hpc:Job a owl:Class .
hpc:runs a owl:ObjectProperty .
hpc:synchronize a owl:ObjectProperty .
hpc:gpolicyd a owl:ObjectProperty .
hpc:Distributed a owl:Class .
hpc:Saap rdfs:domain hpc:Shareaccount ;
    rdfs:range xsd:string .
hpc:Globalresourceusage rdfs:domain hpc:Globalfairsharetree ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Runs rdfs:domain hpc:Participant ;
    rdfs:range hpc:Cluster .
hpc:Synchronize rdfs:domain hpc:Shareaccount ;
    rdfs:range hpc:Shareaccount ;
    rdfs:subPropertyOf hpc:runs .
hpc:Globalfairsharetree rdfs:subClassOf hpc:Distributed .
