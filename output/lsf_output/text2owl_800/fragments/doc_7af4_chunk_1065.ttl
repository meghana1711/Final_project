hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Multithreadedjob a owl:Class .
hpc:Openmpjob a owl:Class .
hpc:Noaffinityjob a owl:Class .
hpc:hasnumcpus a owl:DatatypeProperty .
hpc:Hasnumcpus rdfs:domain hpc:Task ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromenvironment a owl:ObjectProperty ;
                               rdfs:domain hpc:Task ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromjobsubmission a owl:ObjectProperty ;
                                 rdfs:domain hpc:Job ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromaffinityresourcerequest a owl:ObjectProperty ;
                                         rdfs:domain hpc:Job ;
                                         rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromopenmpsub a owl:ObjectProperty ;
                              rdfs:domain hpc:Job ;
                              rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromspan a owl:ObjectProperty ;
                        rdfs:domain hpc:Job ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromspanhosts a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromspanptile a owl:ObjectProperty ;
                              rdfs:domain hpc:Job ;
                              rdfs:range xsd:nonNegativeInteger .
hpc:hasnumcpusfromsubtasks a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:hasnumpus a owl:DatatypeProperty ;
                 rdfs:domain hpc:Job ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:hasnumsubtasks a owl:DatatypeProperty ;
                     rdfs:domain hpc:Job ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:usescshortcsh a owl:ObjectProperty ;
                   rdfs:domain hpc:Job ;
                   rdfs:range hpc:Task .
hpc:usesshkshorbash a owl:ObjectProperty ;
                      rdfs:domain hpc:Job ;
                      rdfs:range hpc:Task .
hpc:setsompnumthreads a owl:ObjectProperty ;
                       rdfs:domain hpc:Task ;
                       rdfs:range hpc:Job .
hpc:nocheckviewpostexec a owl:ObjectProperty ;
                          rdfs:domain hpc:Task ;
                          rdfs:range xsd:boolean .
