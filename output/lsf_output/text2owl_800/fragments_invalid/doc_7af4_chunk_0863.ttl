@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:EgoPimSleeptimeUpdate a owl:Class .
hpc:lsfPimSleeptime a owl:DatatypeProperty ;
    rdfs:domain hpc:EgoPimSleeptimeUpdate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LsfPlatformCompatibility a owl:Class .
hpc:lsfPlatformCompatibilityValue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfPlatformCompatibility ;
    rdfs:range xsd:string .
hpc:lsfPoeTimeoutBind a owl:DatatypeProperty ;
    rdfs:domain hpc:Unspecified ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsfPoeTimeoutSelect a owl:DatatypeProperty ;
    rdfs:domain hpc:Unspecified ;
    rdfs:range xsd:nonNegativeInteger .

hpc:EGO_PIM_SLEEPTIME_UPDATE
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:LSF_PIM_SLEEPTIME ;
                      owl:hasValue 'y' ] .
hpc:LSF_PLATFORM_COMPATIBILITY
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:LSF_PLATFORM_COMPATIBILITY_VALUE ;
                      rdf:first hpc:unspecified ;
                      owl:someValuesFrom [ rdf:first 'y' ; rdf:rest 'n' ] ] .
