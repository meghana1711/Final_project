hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Jobortask ;
    rdfs:comment "Represents a LSF Session Scheduler job." .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Jobortask ;
    rdfs:comment "Represents a task in a LSF Session Scheduler job." .

hpc:Jobortask a owl:Class ;
    rdfs:comment "Represents a job or a task in a LSF Session Scheduler." .

hpc:hasindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobortask ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of the job or task." .

hpc:hastaskid a owl:ObjectProperty ;
    rdfs:domain hpc:Jobortask ;
    rdfs:range hpc:Taskid ;
    rdfs:comment "The task ID of the job or task." .

hpc:hasjobid a owl:ObjectProperty ;
    rdfs:domain hpc:Jobortask ;
    rdfs:range hpc:Jobid ;
    rdfs:comment "The job ID of the job or task." .

hpc:logfile a owl:ObjectProperty ;
    rdfs:domain hpc:Ssacct ;
    rdfs:range xsd:string ;
    rdfs:comment "The log file containing accounting statistics." .

hpc:Ssacct a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "The ssacct command for displaying accounting statistics." .

hpc:longformat a owl:ObjectProperty ;
    rdfs:domain hpc:Ssacct ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether to display extra accounting statistics." .

hpc:searchlogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Ssacct ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether to search for accounting statistics in a specified log file." .

hpc:ssacctAcctDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Ssacct ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where accounting files are defined." .

hpc:Jobid a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Represents a LSF Session Scheduler job ID." .

hpc:Taskid a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Represents a LSF Session Scheduler task ID." .
