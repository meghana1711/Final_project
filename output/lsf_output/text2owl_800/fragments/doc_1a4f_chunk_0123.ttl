hpc:hasusergroupmember a owl:ObjectProperty .
hpc:Isregularuser a owl:Class .
hpc:Isparttimeuser a owl:Class .
hpc:Usergroup rdfs:subClassOf hpc:Resourcegroup .
hpc:Hasusergroupmember rdfs:domain hpc:Usergroup ;
                               rdfs:range rdf:List .
hpc:Isregularuser rdfs:subClassOf hpc:Usergroup ;
                     rdfs:subClassOf hpc:Resource .
hpc:Isparttimeuser rdfs:subClassOf hpc:Usergroup ;
                     rdfs:subClassOf hpc:Resource .
hpc:usergroupmember a owl:DatatypeProperty ;
                      rdfs:domain hpc:Usergroup ;
                      rdfs:range xsd:string .
hpc:user1 a hpc:User ;
             hpc:isRegularUser true .
hpc:user2 a hpc:User ;
             hpc:isRegularUser true .
hpc:user3 a hpc:User ;
             hpc:isRegularUser true .
hpc:user4 a hpc:User ;
             hpc:isRegularUser true .
hpc:externalUserGroup a hpc:UserGroup ;
                        hpc:UserGroupMember "!" .
