hpc:Account a owl:Class .
hpc:flags a owl:ObjectProperty .
hpc:flags rdfs:domain hpc:Account .
hpc:flags rdfs:range xsd:string .
hpc:flags rdfs:subPropertyOf hpc:hasFlags .

hpc:hasFlags a owl:ObjectProperty .
hpc:hasFlags rdfs:domain hpc:Account .
hpc:hasFlags rdfs:range xsd:string .
hpc:hasFlags rdfs:subPropertyOf rdf:list .

hpc:Account_Flags a owl:Class .
hpc:Account_Flags rdfs:subClassOf hpc:flags .

hpc:start a owl:DatatypeProperty .
hpc:start rdfs:domain hpc:Account .
hpc:start rdfs:range xsd:string .

hpc:current_watts a owl:DatatypeProperty .
hpc:current_watts rdfs:domain hpc:Acct_Gather_Energy .
hpc:current_watts rdfs:range xsd:integer .

hpc:last_collected a owl:DatatypeProperty .
hpc:last_collected rdfs:domain hpc:Acct_Gather_Energy .
hpc:last_collected rdfs:range xsd:string .

hpc:Assoc a owl:Class .
hpc:Assoc_Flags a owl:ObjectProperty .
hpc:Assoc_Flags rdfs:domain hpc:Assoc .
hpc:Assoc_Flags rdfs:range xsd:string .
hpc:Assoc_Flags rdfs:subPropertyOf hpc:hasFlags .

hpc:id a owl:DatatypeProperty .
hpc:id rdfs:domain hpc:Assoc .
hpc:id rdfs:range xsd:string .
