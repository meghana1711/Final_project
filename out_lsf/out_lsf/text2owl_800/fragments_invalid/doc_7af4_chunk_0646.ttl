hpc:Bhostfield a owl:Class .
hpc:Bhostfielddisplay a owl:Class .

# Object Properties
hpc:hasfieldname a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostfielddisplay ;
    rdfs:range hpc:Bhostfield .
hpc:haswidth a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostfielddisplay .
hpc:hasalias a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostfield .
hpc:hasunits a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostfield .

# Datatype Properties
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:alias a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:units a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:width a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

# Subclass Relations
hpc:Bhostfielddisplay a rdfs:subClassOf hpc:Bhostfield .

# Customization
hpc:Outputcustomization a owl:Class .
hpc:delimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Outputcustomization .
    rdfs:range xsd:string .
hpc:appliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Outputcustomization .
    rdfs:range hpc:Bhostfielddisplay .

# Output Formats
hpc:Lsbbhostsformat a owl:Class ;
    rdfs:subClassOf hpc:Outputcustomization .
hpc:bhostso a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbbhostsformat .
    rdfs:range hpc:Bhostfielddisplay .

# Overrides
hpc:Environmentvariableoverride a owl:Class .
hpc:overrides a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariableoverride .
    rdfs:range hpc:Outputcustomization .
hpc:lsbBhostsFormat a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariableoverride .
    rdfs:range hpc:Lsbbhostsformat .
hpc:lsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariableoverride .
    rdfs:range hpc:Lsbbhostsformat .

# Bhost Fields
hpc:host_name a hpc:BhostField ;
    hpc:fieldName "host_name" ;
    hpc:alias "hname" ;
    hpc:width 20 .
hpc:status a hpc:BhostField ;
    hpc:fieldName "status" ;
    hpc:alias "stat" ;
    hpc:width 15 .
hpc:cpuf a hpc:BhostField ;
    hpc:fieldName "cpuf" ;
    hpc:width 10 .
hpc:jl_u a hpc:Bhost
