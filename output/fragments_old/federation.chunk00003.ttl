hpc:SiblingJob a owl:Class .
hpc:LocalJobID rdf:type xsd:string .
hpc:OriginCluster a owl:Class .
hpc:LocalCluster a owl:Class .
hpc:SiblingCluster a owl:Class .
hpc:OriginJob a owl:Class .
hpc:Revoked rdf:type owl:Class .
hpc:ViableSibling rdf:type owl:Class .
hpc:ActiveSibling rdf:type owl:Class .

hpc:hasSiblingJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SiblingJob ;
    rdfs:range hpc:Job .

hpc:isLocalJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Boolean .

hpc:belongsToCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .

hpc:isOriginCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .

hpc:isSiblingCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .

hpc:isOriginJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:isRevoked rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Boolean .

hpc:isViableSibling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Boolean .

hpc:isActiveSibling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Boolean .

hpc:hasLimitation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FederatedJob .

hpc:hasJobArray rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Boolean .

hpc:requiresModificationOnOrigin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobModification .
    rdfs:range hpc:Job .

hpc:affectsSview rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Modification .
    rdfs:range hpc:sview .

hpc:isFederatedView rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:View .
    rdfs:range hpc:Boolean .

hpc:hasDateLastModified rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Document ;
    rdfs:range xsd:date .
