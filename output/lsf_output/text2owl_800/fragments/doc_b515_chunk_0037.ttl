hpc:Computeunit a owl:Class .
hpc:Condensedhostgroup a owl:Class .
hpc:Noncondensedhostgroup a owl:Class .
hpc:Enclosure a owl:Class .
hpc:membership a owl:ObjectProperty .
hpc:iscondensed a owl:DatatypeProperty .
hpc:computeunitmembership a owl:ObjectProperty .
hpc:hasadvancereservation a owl:ObjectProperty .
hpc:processorallocation a owl:ObjectProperty .

hpc:Computeunit rdfs:subClassOf owl:Class .
hpc:Condensedhostgroup rdfs:subClassOf hpc:Computeunit .
hpc:Noncondensedhostgroup rdfs:subClassOf hpc:Computeunit .
hpc:Enclosure rdfs:subClassOf hpc:Computeunit .
hpc:Membership rdfs:domain hpc:Computeunit ;
                               rdfs:range rdf:List .
hpc:Iscondensed rdfs:domain hpc:Condensedhostgroup ;
                               rdfs:range xsd:boolean .
hpc:Computeunitmembership rdfs:domain hpc:Computeunit ;
                               rdfs:range rdf:List .
hpc:Hasadvancereservation rdfs:domain hpc:Computeunit .
hpc:Processorallocation rdfs:domain hpc:Computeunit .
