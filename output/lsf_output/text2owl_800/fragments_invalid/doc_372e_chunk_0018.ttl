hpc:Guaranteedresourcepool a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:decimal .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:License a owl:Class .
hpc:Hspice a owl:Class ;
    rdfs:subClassOf hpc:License .
hpc:Proj1Sc a owl:Class .
hpc:Proj2Sc a owl:Class .

hpc:GuaranteedResourcePool_hspice_guarantees a hpc:GuaranteedResourcePool ;
    hpc:NAME "hspice_guarantees" ;
    hpc:TYPE "resource[hspice]" ;
    hpc:DISTRIBUTION ( (hpc:proj1_sc, xd:50%) (hpc:proj2_sc, xd:50%) ) ;
    hpc:DESCRIPTION "A resource pool of hspice licenses controlled by License Scheduler and used by proj1_sc and proj2_sc." .
