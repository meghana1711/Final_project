hpc:Hosttype a owl:Class .
hpc:checkPassword an owl:ObjectProperty ;
    rdfs:domain hpc:Hosttype ;
    rdfs:range xsd:string .
hpc:removeUser an owl:ObjectProperty ;
    rdfs:domain hpc:Hosttype ;
    rdfs:range xsd:string .
hpc:specifyUserPassword an owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:PlainLiteral .
hpc:lsplace an owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Seq .
hpc:lsplacecommandusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range xsd:string .
hpc:lsplacereleaseversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range xsd:string .
hpc:Hostavailable a owl:Class .
hpc:lsplaceAvailable an owl:ObjectProperty ;
    rdfs:domain hpc:Hostavailable ;
    rdfs:range rdf:Resource .
hpc:lsplaceminimum a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsplacemaximum a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsplaceresreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range xsd:string .
hpc:lsplacelonglist a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplace ;
    rdfs:range rdf:List .
hpc:lsplacelistmember a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsplacelonglist ;
    rdfs:range xsd:string .
