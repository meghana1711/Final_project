hpc:Job a owl:Class .
hpc:JobStep a owl:Class .

hpc:ExitCode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:unsignedInt .

hpc:StepExitCode a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStep ;
    rdfs:range xsd:unsignedInt .

hpc:Signal a owl:DatatypeProperty ;
    rdfs:domain (hpc:Job | hpc:JobStep) ;
    rdfs:range xsd:unsignedInt .

hpc:JobFailure a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:NonZeroExitCode a owl:ObjectProperty ;
    rdfs:domain hpc:JobFailure ;
    rdfs:range hpc:ExitCode .

hpc:JobStepRecord a owl:Class .
hpc:JobRecord a owl:Class .

hpc:scontrolShowJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:XMLLiteral .

hpc:sview a owl:ObjectProperty ;
    rdfs:domain (hpc:Job | hpc:JobStep) ;
    rdfs:range rdf:XMLLiteral .

hpc:SignaledJob a owl:Class ;
    rdfs:subClassOf hpc:Job .
```
