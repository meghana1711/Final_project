hpc:defaultbwaittimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulingsession ;
    rdfs:range xsd:integer ;
    rdfs:minCardinality 1 ;
    rdfs:maxCardinality 525600 .

hpc:defaulthostspec a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:Plural ;
    rdfs:subPropertyOf hpc:HasDefaultHostSpec .

hpc:DefaultHostSpec rdf:first hpc:HostName ;
hpc:DefaultHostSpec rdf:rest hpc:HostModel .

hpc:defaultjobcwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string ;
    rdfs:minCardinality 1 .

hpc:DefaultJobCwd rdfs:subPropertyOf hpc:HasDefaultJobCwd .
