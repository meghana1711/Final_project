hpc:DisklessComputeNode a owl:Class .
hpc:SlurmState a owl:Class .
hpc:SlurmJob a owl:Class ,
    rdfs:subClassOf hpc:SlurmState ;
    rdfs:comment "A job managed by Slurm." .
hpc:SlurmJobStep a owl:Class ,
    rdfs:subClassOf hpc:SlurmState ;
    rdfs:comment "A step within a Slurm job." .
hpc:SlurmAdministrativeTool a owl:Class ,
    rdfs:subClassOf hpc:SlurmState ;
    rdfs:comment "Tools used to manage Slurm state." .
hpc:SlurmCancel a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Used to cancel a pending or running job or job step." .
hpc:SlurmSignal a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Used to send an arbitrary signal to all processes associated with a running job or job step." .
hpc:SlurmScontrol a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "The administrative tool used to view and/or modify Slurm state. Many commands can only be executed as user root." .
hpc:SlurmInfo a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Reports the state of partitions and nodes managed by Slurm." .
hpc:SlurmPriority a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Used to display a detailed view of the components affecting a job's priority." .
hpc:SlurmQueue a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Reports the state of jobs or job steps. Has a wide variety of filtering, sorting, and formatting options." .
hpc:SlurmRun a owl:Class ,
    rdfs:subClassOf hpc:SlurmAdministrativeTool ;
    rdfs:comment "Used to submit a job for execution or initiate job steps in real time." .
hpc:ResourceRequirement a owl:Class ,
    rdfs:subClassOf hpc:SlurmRun ;
    rdfs:comment "Options to specify resource requirements." .
hpc:MinNodeCount a owl:DatatypeProperty ,
    rdfs:domain ResourceRequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:MaxNodeCount a owl:DatatypeProperty ,
    rdfs:domain ResourceRequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SpecificNodes a owl:ObjectProperty ,
    rdfs:domain ResourceRequirement ;
    rdfs:range rdf:List .
hpc:NodeCharacteristics a owl:Class ,
    rdfs:subClassOf rdf:List ;
    rdfs:comment "Specific node characteristics (e.g., memory, disk space, certain required features, etc
