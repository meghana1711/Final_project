hpc:Lsfjob a owl:Class .
hpc:lsbEchkpntMethod a owl:ObjectProperty .
hpc:lsbEchkpntMethodDir a owl:ObjectProperty .
hpc:Methodname a owl:Class .
hpc:Customechkpntprogram a owl:Class .
hpc:Customrestartprogram a owl:Class .
hpc:Methodname rdfs:subClassOf hpc:Methodname .
hpc:Customechkpntprogram rdfs:subClassOf hpc:Methodname .
hpc:Customrestartprogram rdfs:subClassOf hpc:Methodname .
hpc:LsbEchkpntMethod rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Methodname .
hpc:LsbEchkpntMethodDir rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:echkpnt rdfs:subPropertyOf hpc:CustomEchkpntProgram ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:erestart rdfs:subPropertyOf hpc:CustomRestartProgram ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:LsfServerdir rdfs:subClassOf hpc:Directory .
