hpc:JobState a owl:Class .
hpc:JobState rdfs:subClassOf xsd:string .
hpc:JobState rdfs:domain hpc:Job .

hpc:Pending a hpc:JobState .
hpc:Running a hpc:JobState .
hpc:Suspended a hpc:JobState .
hpc:Completed a hpc:JobState .
hpc:Cancelled a hpc:JobState .
hpc:Failed a hpc:JobState .
hpc:TIMEOUT a hpc:JobState .
hpc:NODE_FAIL a hpc:JobState .
hpc:PREEMPTED a hpc:JobState .
hpc:BOOT_FAIL a hpc:JobState .
hpc:DEADLINE a hpc:JobState .
hpc:OUT_OF_MEMORY a hpc:JobState .
hpc:LAUNCH_FAILED a hpc:JobState .
hpc:REQUEUED a hpc:JobState .
hpc:REQUEUE_HOLD a hpc:JobState .
hpc:SPECIAL_EXIT a hpc:JobState .
hpc:RESIZING a hpc:JobState .
hpc:CONFIGURING a hpc:JobState .
hpc:COMPLETING a hpc:JobState .
hpc:STOPPED a hpc:JobState .
hpc:RECONFIG_FAIL a hpc:JobState .
hpc:POWER_UP_NODE a hpc:JobState .
hpc:REVOKED a hpc:JobState .
hpc:REQUEUE_FED a hpc:JobState .
hpc:RESV_DEL_HOLD a hpc:JobState .
hpc:SIGNALING a hpc:JobState .
hpc:STAGE_OUT a hpc:JobState .

hpc:KillJobsMsg a owl:Class .
hpc:KillJobsMsg rdfs:subClassOf rdf:List .
hpc:KillJobsMsg rdfs:domain hpc:Message .

hpc:flags a owl:ObjectProperty .
hpc:flags rdfs:domain hpc:KillJobsMsg .
hpc:flags rdfs:range rdf:List .

hpc:flag a owl:DatatypeProperty .
hpc:flag rdfs:domain hpc:KillJobsMsg .
hpc:flag rdfs:range xsd:string .

hpc:BATCH_JOB a hpc:flag .
hpc:ARRAY_TASK a hpc:flag .
hpc:FULL_STEPS_ONLY a hpc:flag .
hpc:FULL_JOB a hpc:flag .
