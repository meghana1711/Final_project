                   rdfs:range xsd:string .

hpc:JobCompType a owl:ObjectProperty .
hpc:JobCompType rdfs:domain hpc:SlurmConfigurationFile ;
                   rdfs:range xsd:string .

hpc:PluginDir a owl:ObjectProperty .
hpc:PluginDir rdfs:domain hpc:SlurmConfigurationFile ;
                   rdfs:range xsd:string .

hpc:Prolog a owl:ObjectProperty .
hpc:Prolog rdfs:domain hpc:SlurmConfigurationFile ;
                   rdfs:range xsd:string .

hpc:SchedulerType a owl:ObjectProperty .
hpc:SchedulerType rdfs:domain hpc:SlurmConfigurationFile ;
