hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf ( hpc:Simpleresourcerequirement | hpc:Alternativeresourcerequirement ) ;
    rdfs:domain hpc:Job ;

hpc:Simpleresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Job ;

hpc:Alternativeresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Job ;
    rdfs:subClassOf ( hpc:Compoundresourcerequirement | hpc:Simpleresourcerequirement ) ;

hpc:Compoundresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Job ;

hpc:hasresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirement ;

hpc:ismergedresult a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement ;

hpc:isqueuelevel a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement ;

hpc:isalternative a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Resourcerequirement ;

hpc:satisfies a owl:ObjectProperty ;
    rdfs:domain hpc:Alternativeresourcerequirement ;
    rdfs:range hpc:Resourcerequirement ;

hpc:hasorder a owl:ObjectProperty ;
    rdfs:domain hpc:Alternativeresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger ;

hpc:hasrusage a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string ;

hpc:hasspan a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string ;

hpc:hassame a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string ;

hpc:hascu a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string ;

hpc:isjoblevel a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:boolean ;

hpc:iscompound a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:boolean ;

hpc:hassubexpression a owl:ObjectProperty ;
    rdfs:domain hpc:Alternativeresourcerequirement ;
