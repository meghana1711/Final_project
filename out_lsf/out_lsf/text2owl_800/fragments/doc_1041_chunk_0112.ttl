hpc:Clusteraffinityinfo a owl:Class .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffinityinfo ;
    rdfs:range xsd:string .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffinityinfo ;
    rdfs:range xsd:string .
hpc:jsonfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffinityinfo ;
    rdfs:range xsd:string .
hpc:format a owl:EnumProperty ;
    rdfs:domain hpc:Clusteraffinityinfo ;
    rdfs:range xsd:string ;
    owl:someValuesFrom (xsd:string "wide" "long") .
hpc:commandlineoption a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinityinfo ;
    rdfs:range hpc:Commandlineoption .
hpc:Commandlineoption a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
hpc:optionname a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandlineoption ;
    rdfs:range xsd:string .
hpc:optionvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandlineoption ;
    rdfs:range xsd:string .
hpc:jobqueuemanipulation a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlineoption ;
    rdfs:range hpc:Jobqueuemanipulation .
hpc:Jobqueuemanipulation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
hpc:movetobottom a owl:ObjectProperty ;
    rdfs:domain hpc:Jobqueuemanipulation ;
    rdfs:range xsd:boolean .
