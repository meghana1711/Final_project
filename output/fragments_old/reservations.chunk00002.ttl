hpc:Reservation a owl:Class .
hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:Node a owl:Class .
hpc:Core a owl:Class .
hpc:Partition a owl:Class .
hpc:Feature a owl:Class .
hpc:Flag a owl:Class .
hpc:TRES a owl:Class .

hpc:hasUser rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .
hpc:hasAccount rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Account .
hpc:hasNode rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Node .
hpc:hasCore rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Core .
hpc:isInPartition rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Partition .
hpc:hasFeature rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Feature .
hpc:hasFlag rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Flag .
hpc:hasTRES rdfs:domain hpc:Reservation ;
    rdfs:range hpc:TRES .
hpc:startTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:endTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:duration .
hpc:nodeCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:coreCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:tres a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:TRES .
hpc:partitionName a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Resource .
hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List
