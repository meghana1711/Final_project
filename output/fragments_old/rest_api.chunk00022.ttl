    hpc:last_update rdf:type hpc:last_update .

hpc:warning rdf:type rdf:List ;
    rdfs:subClassOf hpc:warning ;
    rdfs:domain hpc:node .

hpc:error rdf:type rdf:List ;
    rdfs:subClassOf hpc:error ;
    rdfs:domain hpc:node .
