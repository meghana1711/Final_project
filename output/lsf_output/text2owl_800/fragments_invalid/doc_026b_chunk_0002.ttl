hpc:Computenode a owl:Class ;
    rdfs:subClassOf hpc:Node ;
    rdfs:comment "Any compute node in the cluster that does not directly mount the staging area." .

hpc:passwordlesssshaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range hpc:Fileserver ;
    rdfs:comment "Configure passwordless SSH access to the staging area file servers." .

hpc:Datamanager a owl:Class ;
    rdfs:subClassOf hpc:Computenode ;
    rdfs:comment "Each data manager must manage a single staging area." .

hpc:Datamanagerhost a owl:Class ;
    rdfs:subClassOf hpc:Computenode ;
    rdfs:comment "Select at least one LSF server host as the data manager host." .

hpc:lsfdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the host runs an LSF data manager." .

hpc:canwritetostagingarea a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the data manager host can write to the staging area file system as root." .

hpc:failoverconfigured a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of data manager candidate hosts." .

hpc:Datamanagercandidate a owl:Class ;
    rdfs:subClassOf hpc:Computenode ;
    rdfs:comment "A data manager candidate host." .

hpc:mountsstagingarea a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagercandidate ;
    rdfs:range xsd:string ;
    rdfs:comment "The local path where the staging area is mounted." .

hpc:Lsfserver a owl:Class ;
    rdfs:subClassOf hpc:Computenode ;
    rdfs:comment "An LSF server host." .

hpc:Datatransfernode a owl:Class ;
    rdfs:subClassOf hpc:Computenode ;
    rdfs:comment "Each node must have read/write access to the mounted staging area." .

hpc:canreaddatastagein a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the data transfer node can reach the data source location through the configured transfer tool for input data requirements." .

hpc:canreaddatastageout a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the data transfer node can reach the data destination location through the configured transfer tool for output data requirements." .

hpc:mountsstagingareasamelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfernode
