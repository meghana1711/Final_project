hpc:Highavailabilityenvironment a owl:Class .
hpc:Lsfwebserviceinstance a owl:Class .
hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfseverhost a owl:Class .
hpc:Hasaccesstolsfenvironment rdfs:domain hpc:Highavailabilityenvironment ;
                                 rdfs:range hpc:Lsfenvironment .
hpc:Haslsfwebserviceinstance rdfs:domain hpc:Highavailabilityenvironment ;
                                 rdfs:range hpc:Lsfwebserviceinstance .
hpc:Ismanagementhost rdfs:domain hpc:Lsfwebserviceinstance ;
                      rdfs:range hpc:Lsfmanagementhost .
hpc:Isserverhost rdfs:domain hpc:Lsfwebserviceinstance ;
                  rdfs:range hpc:Lsfseverhost .
hpc:Hasapachehttpserverloadbalancer rdfs:domain hpc:Highavailabilityenvironment ;
                                      rdfs:range hpc:Apachehttpserver .
hpc:Hashaproxyloadbalancer rdfs:domain hpc:Highavailabilityenvironment ;
                               rdfs:range hpc:Haproxy .
hpc:Hasnginxloadbalancer rdfs:domain hpc:Highavailabilityenvironment ;
                             rdfs:range hpc:Nginx .
hpc:Requireshighavailabilityinstallation rdfs:domain hpc:Lsfwebserviceinstance ;
                                          rdfs:range xsd:boolean .
hpc:Requiresreinstallationforhighavailability rdfs:domain hpc:Lsfwebserviceinstance ;
                                               rdfs:range xsd:boolean .
hpc:Requirestwoormorehosts rdfs:domain hpc:Highavailabilityenvironment ;
                                 rdfs:range xsd:integer .
hpc:Requireshighavailabilityduringinstallation rdfs:domain hpc:Lsfwebserviceinstance ;
                                               rdfs:range xsd:boolean .
