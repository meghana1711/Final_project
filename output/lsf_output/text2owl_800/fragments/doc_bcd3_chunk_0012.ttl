hpc:Job a owl:Class .
hpc:schedulerefficiency a owl:DatatypeProperty .
hpc:Schedulerefficiency rdfs:domain hpc:Job .
hpc:Schedulerefficiency rdfs:range xsd:decimal .
hpc:Snapshotfile a owl:Class .
hpc:Snapshotfile rdfs:subClassOf hpc:File .
hpc:diagnoselogdir a owl:DatatypeProperty .
hpc:Diagnoselogdir rdfs:domain hpc:Snapshotfile .
hpc:Diagnoselogdir rdfs:range xsd:string .
hpc:bacct a owl:ObjectProperty .
hpc:Bacct rdfs:domain hpc:Lsf .
hpc:Bacct rdfs:range hpc:Perfmonview .
hpc:badminperfmon a owl:ObjectProperty .
hpc:Badminperfmon rdfs:domain hpc:Lsf .
hpc:Badminperfmon rdfs:range hpc:Perfmonview .
hpc:schedulerefficiencymetric a owl:DatatypeProperty .
hpc:Schedulerefficiencymetric rdfs:domain hpc:Perfmonview .
hpc:Schedulerefficiencymetric rdfs:range xsd:decimal .
hpc:bjobs a owl:ObjectProperty .
hpc:Bjobs rdfs:domain hpc:Lsf .
hpc:Bjobs rdfs:range hpc:Jobstatus .
hpc:bhist a owl:ObjectProperty .
hpc:Bhist rdfs:domain hpc:Lsf .
hpc:Bhist rdfs:range hpc:Jobhistory .
