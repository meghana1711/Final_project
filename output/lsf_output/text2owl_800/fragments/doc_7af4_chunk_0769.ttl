hpc:Lsfserver a owl:Class .
hpc:HelperHost rdf:type owl:Class ;
    rdfs:subClassOf hpc:Lsfserver ;
    rdfs:comment "Helper hosts must be LSF servers in the LSF cluster." .

hpc:hasHelperHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range rdf:List ;
    rdfs:comment "Lists the Terminal Services job helper hosts." .

hpc:maxhelperhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Hashelperhost ;
    rdfs:range xsd:integer ;
    rdfs:comment "Configure a maximum of 256 hosts in the list." .

hpc:stabilityfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Hashelperhost ;
    rdfs:range xsd:integer ;
    rdfs:comment "For stability, you should configure one helper host for every 40 execution hosts." .

hpc:tsjobhelperport a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specify the service port to use for communication with TSJobHelper." .

hpc:tsjobhelpercommunicationport a owl:ObjectProperty ;
    rdfs:domain hpc:Tsjobhelper ;
    rdfs:range hpc:Tsjobhelperport ;
    rdfs:comment "TSJobHelper uses this port to communicate with the helper hosts." .

hpc:tsjobhelpertimeout a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specify the maximum time out that the local TSJobHelper service waits for a helper host to reply." .
