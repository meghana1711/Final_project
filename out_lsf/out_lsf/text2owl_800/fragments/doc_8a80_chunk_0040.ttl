hpc:MaximumAllocation
    a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:allocation ;
                        owl:hasValue xsd:positiveInteger ;
                        owl:maxValueFrom xsd:positiveInteger ] .

hpc:ClusterDistribution
    a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:clusterDistribution ;
                        owl:hasValue owl:String ;
                        owl:pattern ( rdf:value "^[A-Za-z0-9]+\\(([A-Za-z0-9]+ \\d+)+\\)$" ) ] .

hpc:ServiceDomain
    a owl:Class .

hpc:Cluster
    a owl:Class .

hpc:allocation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:positiveInteger .

hpc:clusterDistribution
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Clusterdistribution .
