hpc:Clustermode a owl:Class ;
    rdfs:subClassOf hpc:Mode .

hpc:Projectmode a owl:Class ;
    rdfs:subClassOf hpc:Mode .

hpc:Undeﬁned a owl:Class ;
    rdfs:subClassOf hpc:Mode .

hpc:demandLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Mode ;
    rdfs:range xsd:integer .

hpc:hasdemandlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Mode ;
    rdfs:range hpc:DemandLimit .

hpc:Demandlimitvalue a owl:Class ;
    rdfs:subClassOf xsd:integer .

hpc:DemandLimitEnabled a owl:Class ;
    rdf:type hpc:DemandLimitValue ;
    rdfs:subClassOf hpc:DemandLimit .

hpc:DemandLimitDisabled a owl:Class ;
    rdf:type hpc:DemandLimitValue ;
    rdfs:subClassOf hpc:DemandLimit .
