hpc:priorityweightage           a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:priorityweightfairshare     a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:priorityweightjobsize      a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:priorityweightpartition    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:Priorityweight            a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:PriorityWeightAge ;
                        owl:allValuesFrom [ xsd:decimal "1000" ] ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:PriorityWeightFairshare ;
                        owl:allValuesFrom [ xsd:decimal "10000" ] ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:PriorityWeightJobSize ;
                        owl:allValuesFrom [ xsd:decimal "1000" ] ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:PriorityWeightPartition ;
                        owl:allValuesFrom [ xsd:decimal "1000" ] ] .
