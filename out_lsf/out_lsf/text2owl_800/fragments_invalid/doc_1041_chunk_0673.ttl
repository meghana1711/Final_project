hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the HPC system." .

# Job ID Property
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for a job." .

# Job Group Property
hpc:jobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The group to which the job belongs (if specified)." .

# Index Property
hpc:index a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The index of the job within a job group (default is 0)." .

# Execution Job ID Property
hpc:executionjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for an execution of a job." .

# Execution Index Property
hpc:executionindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The index of an execution within a job." .

# Project Name Property
hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The project to which the job belongs." .

# User Name Property
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who submitted the job." .

# User Group Property
hpc:usergroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The user group for the job output directory." .

# Output Directory Creation Method Property
hpc:outputdirectorycreationmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "The method used to create the output directory (RES or rsh)." .

# Dependency on RES Property
hpc:dependsonres a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates whether RES is required to create the output directory." .

# Project Creation Property
hpc:projectcreationallowed a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Indicates whether the project can be created before submitting the job." .

# Project Name Length Property
hpc:projectnamelength a owl:DatatypeProperty
