hpc:JobWriteLock a owl:Class .
hpc:acquisition a owl:ObjectProperty .

hpc:SchedulerParameters a owl:Class .
hpc:batch_sched_delay a owl:DatatypeProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:duration .

hpc:effects a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range hpc:Job .

hpc:affectsJobType a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:string .

hpc:defer a owl:ObjectProperty .

hpc:deferOption a owl:Class ;
    rdfs:subClassOf hpc:SchedulerParameters .

hpc:defer_batch a owl:DatatypeProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:duration .

hpc:initiationTimeDelay a owl:DatatypeProperty ;
    rdfs:domain hpc:deferOption ;
    rdfs:range xsd:duration .

hpc:allowInteractiveStart a owl:ObjectProperty ;
    rdfs:domain hpc:defer_batch ;
    rdfs:range hpc:Job .

hpc:sched_min_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:duration .

hpc:triggeringEvent a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:string .

hpc:immediateStart a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range xsd:boolean .
