hpc:Heterogeneousjob a owl:Class .
hpc:Heterogeneousstep a owl:Class .
hpc:Uniquenode a owl:Class .
hpc:runon a owl:ObjectProperty ;
    rdfs:domain hpc:Heterogeneousstep ;
    rdfs:range hpc:Uniquenode .
hpc:incompatiblewithinjob a owl:ObjectProperty ;
    rdfs:domain hpc:Heterogeneousstep ;
    rdfs:range hpc:Heterogeneousjob .
hpc:Jobsubmitplugin a owl:Class .
hpc:Spankinitpostopt a owl:Class .
hpc:Sitedefinedoption a owl:Class .
hpc:Jobcomponent a owl:Class ;
    rdfs:subClassOf hpc:Heterogeneousstep .
hpc:Scheduling a owl:Class .
hpc:Schedbackfill a owl:Class .
hpc:Pendingreason a owl:Class .
hpc:Backfillscheduler a owl:Class .
hpc:Alternatingmode a owl:Class .
hpc:Immediateinitiation a owl:Class .
hpc:expectedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Heterogeneousjobcomponent .
hpc:ComponentStartTime a xsd:dateTime .
