hpc:Configurationtemplate a owl:Class .
hpc:DefaultConfigurationTemplate a hpc:ConfigurationTemplate ;
  rdfs:subClassOf [ rdf:type owl:Class ] ;
  rdfs:comment "Default configuration template used for LSF Standard Edition on Windows." .

hpc:ParallelConfigurationTemplate a hpc:ConfigurationTemplate ;
  rdfs:subClassOf [ rdf:type owl:Class ] ;
  rdfs:comment "Configuration template for enabling LSF HPC features." .

# Configuration file parameters
hpc:Initialconfigurationfileparameter a owl:Class .
hpc:hasparametervalue a owl:ObjectProperty ;
  rdfs:domain hpc:Initialconfigurationfileparameter ;
  rdfs:range xsd:string .

hpc:lsfConf a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The lsf.conf file." .

hpc:DAEMON_SHUTDOWN_DELAY a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsf.conf parameter DAEMON_SHUTDOWN_DELAY." .

hpc:LSF_LINUX_CGROUP_ACCT a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsf.conf parameter LSF_LINUX_CGROUP_ACCT." .

hpc:LSF_PROCESS_TRACKING a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsf.conf parameter LSF_PROCESS_TRACKING." .

hpc:lsbParams a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The lsb.params file." .

hpc:JOB_DEP_LAST_SUB a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.params parameter JOB_DEP_LAST_SUB." .

hpc:JOB_SCHEDULING_INTERVAL a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.params parameter JOB_SCHEDULING_INTERVAL." .

hpc:MAX_JOB_NUM a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.params parameter MAX_JOB_NUM." .

hpc:NEWJOB_REFRESH a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.params parameter NEWJOB_REFRESH." .

hpc:SBD_SLEEP_TIME a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.params parameter SBD_SLEEP_TIME." .

hpc:PARALLEL_LSB_SHORT_HOSTLIST a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsb.conf parameter LSB_SHORT_HOSTLIST in the PARALLEL configuration template." .

hpc:PARALLEL_LSF_LINUX_CGROUP_ACCT a hpc:InitialConfigurationFileParameter ;
  rdfs:comment "The value for lsf.conf parameter LSF_LINUX_CGROUP_ACCT in the PARALLEL configuration template." .

hpc:PARALLEL_LSF
