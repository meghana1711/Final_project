hpc:Change a owl:Class;
    rdfs:subClassOf owl:Change.

hpc:Automatedchange a owl:Class;
    rdfs:subClassOf hpc:Change.

hpc:functionname a owl:ObjectProperty;
    rdfs:domain hpc:Automatedchange;
    rdfs:range xsd:string.

hpc:spellingmistake a owl:ObjectProperty;
    rdfs:domain hpc:Change;
    rdfs:range xsd:string.

hpc:pervasive a owl:DatatypeProperty;
    rdfs:domain hpc:Spellingmistake;
    rdfs:range xsd:boolean.

hpc:gitformatpatch a owl:ObjectProperty;
    rdfs:domain hpc:Automatedchange;
    rdfs:range xsd:string.

hpc:documentationimprovement a owl:ObjectProperty;
    rdfs:domain hpc:Change;
    rdfs:range xsd:string.

hpc:location a owl:DatatypeProperty;
    rdfs:domain hpc:Documentationimprovement;
    rdfs:range xsd:string.
