hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourcereservationqueue .

hpc:Resourcereservationqueue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Queue for resource reservation and backfill." ;
    rdfs:label "ResourceReservationQueue" ;
    rdfs:subClassOf ( hpc:Queue
                         rdfs:subClassOf ( hpc:Resourcereservationqueue
                                              rdfs:subClassOf owl:Class ) ) ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue ;
    rdfs:subProperty rdfs:domain hpc:Queue ;
    rdfs:subProperty rdfs:range hpc:Queue ;

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:resourceReserve a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcereserve .

hpc:Resourcereserve a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Resource reservation time." ;
    rdfs:label "ResourceReserve" ;
    rdfs:subClassOf ( xsd:duration rdf:type owl:Datatype ) .

hpc:backfill a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:resourceReservePerTask a owl:ObjectProperty ;
    rdfs:domain hpc:Params ;
    rdfs:range xsd:boolean .


This ontology fragment defines classes for Queue and ResourceReserve, as well as properties for describing a queue's description, priority, resource reservation, backfill, and per-task memory reservation. The ResourceReserve property is modeled as an instance of the xsd:duration datatype, and the RESOURCE_RESERVE_PER_TASK property is modeled as an object property with a domain of hpc:Params.
