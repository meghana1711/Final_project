hpc:Host a owl:Class .
hpc:Cpu a owl:Class .
hpc:cpuutilization a owl:DatatypeProperty .
hpc:Cpuutilization rdfs:domain hpc:Host .
hpc:Cpuutilization rdfs:range xsd:decimal .
hpc:cpuutilizationthreshold a owl:DatatypeProperty .
hpc:Cpuutilizationthreshold rdfs:domain hpc:Host .
hpc:Cpuutilizationthreshold rdfs:range xsd:decimal .
hpc:resourcerequirement a owl:ObjectProperty .
hpc:Resourcerequirement rdfs:domain hpc:Job .
hpc:Resourcerequirement rdfs:range xsd:decimal .
hpc:Schedulingcondition a owl:Class .
hpc:Schedulingcondition rdfs:subClassOf hpc:Resourcerequirement .
hpc:stopcondition a owl:ObjectProperty .
hpc:Stopcondition rdfs:domain hpc:Queue .
hpc:Stopcondition rdfs:range xsd:string .
hpc:resumecondition a owl:ObjectProperty .
hpc:Resumecondition rdfs:domain hpc:Queue .
hpc:Resumecondition rdfs:range xsd:string .
hpc:Executionhistory a owl:Class .
hpc:Executionhistory rdfs:subClassOf hpc:Job .
hpc:pendingreason a owl:ObjectProperty .
hpc:Pendingreason rdfs:domain hpc:Job .
hpc:Pendingreason rdfs:range xsd:string .
hpc:suspendreason a owl:ObjectProperty .
hpc:Suspendreason rdfs:domain hpc:Job .
hpc:Suspendreason rdfs:range xsd:string .
hpc:Batchjobmessaging a owl:Class .
hpc:Batchjobmessaging rdfs:subClassOf hpc:Job .
hpc:Multiclusterenvironment a owl:Class .
hpc:Multiclusterenvironment rdfs:subClassOf hpc:Environment .
hpc:interactivebatchjobmessaging a owl:ObjectProperty .
hpc:Interactivebatchjobmessaging rdfs:domain hpc:Interactivebatchjob .
hpc:Interactivebatchjobmessaging rdfs:range xsd:string .
