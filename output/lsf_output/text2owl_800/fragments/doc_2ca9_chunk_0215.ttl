hpc:Bjobsoption a owl:Class .
hpc:jsonoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobsoption ;
    rdfs:range xsd:boolean .

hpc:hmsoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobsoption ;
    rdfs:range xsd:string .

hpc:ignorebadjobidoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobsoption ;
    rdfs:range xsd:boolean .

hpc:rsvid a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjob ;
    rdfs:range xsd:string .

hpc:uoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobsoption ;
    rdfs:range xsd:string .

hpc:Pendingreasonmessage a owl:Class ;
    rdfs:subClassOf hpc:Message .

hpc:PendingReasonMessage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bjob ;
    rdfs:range hpc:Pendingreasonmessage .

hpc:ProjectName rdf:type rdfs:Property ;
    rdfs:domain hpc:Pendingreasonmessage ;
    rdfs:range xsd:string .

hpc:ClusterName rdf:type rdfs:Property ;
    rdfs:domain hpc:Pendingreasonmessage ;
    rdfs:range xsd:string .

hpc:failurereason a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjob ;
    rdfs:range xsd:string .

hpc:gpuoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobsoption ;
    rdfs:range xsd:boolean .

hpc:GpuOption rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:ResourceOption .
