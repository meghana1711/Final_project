hpc:Documentation
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Includes man pages." .

hpc:SampleConfigurationFiles
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Sample configuration files." .

hpc:Slurm
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Header files for API use." .

hpc:SlurmHeaderFiles
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "These files must be installed." .

hpc:CodePortability
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Placing these header files in this location makes for better code portability." .

hpc:SourceCode
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Contains all source code and header files not in the 'slurm' subdirectory described above." .

hpc:Testsuite
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Check, Expect and Pytest tests are here." .

hpc:ManPages
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "All of the documentation is in the subdirectory doc. Two directories are of particular interest:" .

hpc:ManPagesForAPIs
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "contains the man pages for the APIs." .

hpc:WebPages
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "contains the web pages." .

hpc:APIs
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Functions are divided into several categories, each in its own subdirectory." .

hpc:ApplicationProgramInterfaces
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "into the Slurm code. Used to send and get Slurm information from the central manager. These are the functions user applications might utilize." .

hpc:SlurmInformation
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Slurm information." .
