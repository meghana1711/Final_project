hpc:LsfUdpPortRange a owl:Class .
hpc:hasminport a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfUdpPortRange ;
    rdfs:range xsd:integer .
hpc:hasmaxport a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfUdpPortRange ;
    rdfs:range xsd:integer .
hpc:LSF_UDP_PORT_RANGE_Range a owl:Restriction ;
    rdfs:subClassOf hpc:LsfUdpPortRange ;
    owl:onProperty hpc:hasMinPort ;
    xsd:minInclusive "1024" .
hpc:LSF_UDP_PORT_RANGE_Range2 a owl:Restriction ;
    rdfs:subClassOf hpc:LsfUdpPortRange ;
    owl:onProperty hpc:hasMaxPort ;
    xsd:maxInclusive "65535" .

# LSF 10.1 Fix Pack 5
hpc:Lsf101FixPack5 a owl:Class .
hpc:appliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf101FixPack5 ;
    rdfs:range hpc:IbmPower9Platform .
hpc:IbmPower9Platform a owl:Class .
hpc:releasedate a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf101FixPack5 ;
    rdfs:range xsd:date .
hpc:releasedatevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Releasedate ;
    rdfs:range xsd:date .
