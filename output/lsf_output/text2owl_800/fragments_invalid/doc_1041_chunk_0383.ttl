hpc:Token
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a license token." .

hpc:TokenName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the token." .

hpc:TotalTokens
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The total number of tokens for a project." .

hpc:UsedTokens
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The number of used and reserved tokens for a project." .

hpc:ReservedTokens
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The number of reserved tokens for a project." .

hpc:LicenseTokenDispatchOrder
    a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Project ;
    rdfs:comment "The order in which license tokens are dispatched to projects based on the scaled accumulate value." .

hpc:SpecifiedTokenNames
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "The specified license tokens for the command." .

hpc:ProjectGroup
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a group of projects." .

hpc:AccumulatedLicenses
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The accumulated value of licenses for a project group." .

hpc:ScaledAccumulateValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The scaled accumulate value of each project, used for sorting the license token dispatch order." .

hpc:CrossClusterInformation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "Cross cluster information for tokens." .

hpc:Cluster
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a cluster." .

