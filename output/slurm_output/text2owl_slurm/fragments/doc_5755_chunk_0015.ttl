hpc:Slurmjoballocation a owl:Class .
hpc:Slurminteractivejob a owl:Class .
hpc:Slurmbatchjob a owl:Class .

hpc:hasoutputfile a owl:ObjectProperty .
hpc:Hasoutputfile rdfs:domain hpc:Slurmbatchjob ;
                   rdfs:range xsd:string .

hpc:hasinteractiveoutput a owl:ObjectProperty .
hpc:Hasinteractiveoutput rdfs:domain hpc:Slurminteractivejob ;
                          rdfs:range xsd:string .

hpc:supportsjobarrays a owl:ObjectProperty .
hpc:Supportsjobarrays rdfs:domain hpc:Slurmjoballocation ;
                       rdfs:range xsd:boolean .

hpc:faulttolerance a owl:ObjectProperty .
hpc:Faulttolerance rdfs:domain hpc:Slurmjoballocation ;
                   rdfs:range xsd:string .
