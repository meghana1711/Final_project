hpc:GPU a owl:Class .
hpc:Shard a owl:Class .
hpc:GRES a owl:Class .

hpc:hasType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GRES ;
    rdfs:range xsd:string .

hpc:hasCores rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:hasShardCount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Shard .

hpc:isMorePowerful rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range hpc:GPU .

hpc:isPreventedFromSharding rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range xsd:boolean .

hpc:isAllocatedAsGPU rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GRES ;
    rdfs:range hpc:GPU .

hpc:isAllocatedAsShard rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GRES ;
    rdfs:range hpc:Shard .

hpc:canBeAllocatedToMultipleJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Shard ;
    rdfs:range xsd:integer .

hpc:requiresFittingOnSingleGPU rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Shard ;
    rdfs:range xsd:boolean .

hpc:hasOptMultipleSharingGRESPJ rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Shard .
```
