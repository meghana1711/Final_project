hpc:Dynamicownership rdfs:domain hpc:License ;
    rdfs:range hpc:Ownedlicense .

hpc:Exclusiveuse rdfs:domain hpc:Nonsharedlicense ;
    rdfs:range xsd:boolean .

hpc:Alwaysavailable rdfs:domain hpc:Nonsharedlicense ;
    rdfs:range xsd:boolean .

hpc:Maximizeuse rdfs:domain hpc:Nonsharedlicense ;
    rdfs:range xsd:boolean .

hpc:Projectmode rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Preemption rdfs:domain hpc:Job ;
    rdfs:range hpc:Preemption .

hpc:Nofreelicenses rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Releaseborrowedlicense rdfs:domain hpc:Job ;
    rdfs:range hpc:Project .

hpc:Ownslicense rdfs:domain hpc:Project ;
    rdfs:range hpc:License .

