hpc:Host a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Hostgroup a owl:Class .

hpc:releasecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Releasecommand .

hpc:Releasecommand a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:comment "Command for releasing resources." .

hpc:compoundresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range hpc:Compoundresourcerequirement .

hpc:Compoundresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Requirement for multiple resources in a specific order." .

hpc:lastterm a owl:DatatypeProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:integer .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:taskallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Taskallocation .

hpc:initialtaskallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Alternativeresourcerequirement ;
    rdfs:range hpc:Taskallocation .

hpc:Autoresizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Job that can automatically adjust its resource allocation." .

hpc:pendingdemand a owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range hpc:Pendingdemand .

hpc:requestcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Requestcommand .

hpc:Requestcommand a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:comment "Command for requesting additional resources." .

hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:Queueadministrator a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Clusteradministrator a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:jobowner a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:Usergroupadministrator a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:cancelrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Requestcommand ;
    rdfs:range hpc:Cancelrequest .

hpc:Cancelrequest a owl:Class ;
    rdfs:subClassOf hpc:Requestcommand ;
    rdfs:comment "Command for cancelling a resource request." .

h
