hpc:Job a owl:Class.
hpc:Component a owl:Class.
hpc:Heterogeneousjob a owl:Class.
hpc:job a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:integer.
hpc:heterogeneousjob a owl:DatatypeProperty;
    rdfs:domain hpc:Heterogeneousjob;
    rdfs:range xsd:integer.
hpc:partitionname a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:user a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:state a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.
hpc:time a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:dateTime.
