hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:resumeaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "The action taken when a job is resumed." .

hpc:resumecondition a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "The condition under which a job in a queue can be resumed." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a queue in the HPC system." .

hpc:Lsbqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "Represents an LSF queue in the HPC system." .

hpc:schedulingthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The threshold for scheduling jobs in a queue." .

hpc:loadlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The current load level of a host." .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a host in the HPC system." .
