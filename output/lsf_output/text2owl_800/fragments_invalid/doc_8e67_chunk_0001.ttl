@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:Craylinux a owl:Class .
hpc:Gpu a owl:Class .
hpc:craylinux a owl:ObjectProperty .
hpc:rusage a owl:DatatypeProperty .
hpc:JobCount a xsd:nonNegativeInteger .
hpc:JobSpan a xsd:nonNegativeInteger .
hpc:Ptile a xsd:nonNegativeInteger .

hpc:Craylinux rdfs:subClassOf owl:Class .
hpc:Gpu rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .

hpc:Craylinux rdfs:domain hpc:Job .
hpc:Craylinux rdfs:range hpc:Craylinux .
hpc:Rusage rdfs:domain hpc:Job .
hpc:Rusage rdfs:range xsd:nonNegativeInteger .

hpc:hasvnode a owl:ObjectProperty .
hpc:hasfrontnode a owl:ObjectProperty .

hpc:Hasvnode rdfs:domain hpc:Craylinux .
hpc:Hasfrontnode rdfs:domain hpc:Craylinux .
hpc:Hasvnode rdfs:range rdf:Boolean .
hpc:Hasfrontnode rdfs:range rdf:Boolean .

hpc:jobrequiresreservation a owl:ObjectProperty .
hpc:reservationtype a owl:DatatypeProperty .

hpc:Jobrequiresreservation rdfs:domain hpc:Job .
hpc:Jobrequiresreservation rdfs:range hpc:Reservationtype .
hpc:Reservationtype rdfs:range xsd:string .

hpc:ReservationType_CRAYLINUX a hpc:ReservationType .
hpc:ReservationType_CRAYLINUX rdfs:label "CRAYLINUX" .

hpc:reservationrequiresgpu a owl:ObjectProperty .
hpc:Reservationrequiresgpu rdfs:domain hpc:Reservationtype .
hpc:Reservationrequiresgpu rdfs:range hpc:Gpu .

hpc:jobpendingreason a owl:DatatypeProperty .
hpc:Jobpendingreason rdfs:domain hpc:Job .
hpc:Jobpendingreason rdfs:range xsd:string .

hpc:jobcannotrunonhostswithvnode a owl:ObjectProperty .
hpc:Jobcannotrunonhostswithvnode rdfs:domain hpc:Jobpendingreason .
hpc:Jobcannotrunonhostswithvnode rdfs:range hpc:Craylinux .
