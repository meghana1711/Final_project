hpc:Lsfjob a owl:Class .
hpc:hasjobid a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:jobidlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:maxjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer ;
    rdfs:minInclusive "999999" ;
    rdfs:maxInclusive "2147483646" .
hpc:increasemaxjobid a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Parameterchange .
hpc:Lsfparameterchange a owl:Class .
hpc:lsbJobidDispLength a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer .
hpc:increasejobiddisplaylength a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Parameterchange .
hpc:Energyawarescheduling a owl:Class .
hpc:Ibmspectrumlsf a owl:Class .
