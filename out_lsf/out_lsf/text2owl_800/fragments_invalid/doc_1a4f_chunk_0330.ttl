hpc:Globalresource a owl:Class .
hpc:resourcetype a owl:ObjectProperty .
hpc:interval a owl:DatatypeProperty .
hpc:increasing a owl:DatatypeProperty .
hpc:consumable a owl:DatatypeProperty .
hpc:release a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .

hpc:Globalresource a rdfs:subClassOf hpc:Resource .
hpc:Numeric a owl:Class .

hpc:Resourcetype rdfs:domain hpc:Globalresource ;
                  rdfs:range hpc:Numeric .

hpc:Interval rdfs:domain hpc:Globalresource ;
             rdfs:range xsd:integer .

hpc:Increasing rdfs:domain hpc:Globalresource ;
               rdfs:range xsd:boolean .

hpc:Consumable rdfs:domain hpc:Globalresource ;
               rdfs:range xsd:boolean .

hpc:Release rdfs:domain hpc:Globalresource ;
            rdfs:range xsd:boolean .

hpc:Description rdfs:domain hpc:Globalresource ;
                rdfs:range xsd:string .

hpc:Globalstaticresource a rdfs:subClassOf hpc:Globalresource ;
                           rdfs:subClassOf (hpc:Numeric
                                                rdfs:and
                                            (hpc:Increasing "N"^^xsd:string)
                                            (hpc:Consumable "Y"^^xsd:string)
                                            (hpc:Release "Y"^^xsd:string)
                                            (hpc:Description "Global static resources"^^xsd:string)
                                            .) .

hpc:Globaldynamicresource a rdfs:subClassOf hpc:Globalresource ;
                                 rdfs:subClassOf (hpc:Numeric
                                                      rdfs:and
                                                  (hpc:Increasing "N"^^xsd:string)
                                                  (hpc:Consumable "Y"^^xsd:string)
                                                  (hpc:Release "Y"^^xsd:string)
                                                  (hpc:Interval xsd:integer)
                                                  .) .
