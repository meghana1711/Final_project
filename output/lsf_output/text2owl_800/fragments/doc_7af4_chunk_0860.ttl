hpc:LsfNonPrivilegedPorts a owl:Class .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfNonPrivilegedPorts ;
    rdfs:range xsd:string .

hpc:LsfPasswdDir a owl:Class .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfPasswdDir ;
    rdfs:range xsd:string .

hpc:usesprivilegedports a owl:ObjectProperty ;
    rdfs:domain hpc:LsfNonPrivilegedPorts ;
    rdfs:range hpc:Lsfcluster .

hpc:requiresupgrade a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:integer .

hpc:supportscommunication a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Lsfcommunicationmethod .

hpc:Lsfcommunicationmethod a owl:Class .
hpc:nonPrivileged a hpc:LSFCommunicationMethod ;
    rdfs:subClassOf hpc:Lsfcommunicationmethod .
hpc:privileged a hpc:LSFCommunicationMethod ;
    rdfs:subClassOf hpc:Lsfcommunicationmethod .

hpc:Lsfcluster a owl:Class .
hpc:hasmaxjobdispatchpersession a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster .
