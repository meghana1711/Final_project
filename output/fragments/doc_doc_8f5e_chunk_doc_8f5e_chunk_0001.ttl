hpc:SlurmVersion a owl:Class .
hpc:majorRelease a xsd:integer .
hpc:maintenanceRelease a xsd:integer .
hpc:CompatiblePriorVersion a owl:Class .
hpc:ReleaseCycle a rdfs:Class .
hpc:EndOfSupport a xsd:date .
hpc:UpgradeProcedure a rdfs:Class .
hpc:Preparation a rdfs:Class .
hpc:CreateBackups a rdfs:Class .
hpc:slurmdbd a owl:Class .
hpc:slurmctld a owl:Class .
hpc:slurmd a owl:Class .
hpc:slurmCommands a rdfs:Class .
hpc:CustomizedSlurmPlugins a rdfs:Class .
hpc:SeamlessUpgrades a rdfs:Class .

hpc:SlurmVersion rdfs:subClassOf owl:Class .
hpc:majorRelease rdfs:domain hpc:SlurmVersion ;
    rdfs:range xsd:integer .
hpc:maintenanceRelease rdfs:domain hpc:SlurmVersion ;
    rdfs:range xsd:integer .
hpc:CompatiblePriorVersion rdfs:subClassOf owl:Class .
hpc:ReleaseCycle rdfs:subClassOf rdfs:Class .
hpc:EndOfSupport rdfs:domain hpc:CompatiblePriorVersion ;
    rdfs:range xsd:date .
hpc:UpgradeProcedure rdfs:subClassOf rdfs:Class .
hpc:Preparation rdfs:subClassOf hpc:UpgradeProcedure .
hpc:CreateBackups rdfs:subClassOf hpc:Preparation .
hpc:slurmdbd a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:slurmctld a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:slurmd a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:slurmCommands a rdfs:Class ;
    rdfs:subClassOf rdfs:Class .
hpc:CustomizedSlurmPlugins a rdfs:Class ;
    rdfs:subClassOf rdfs:Class .
hpc:SeamlessUpgrades a rdfs:Class ;
    rdfs:subClassOf rdfs:Class .

hpc:upgradeTo a owl:ObjectProperty .
hpc:isCompatibleWith a owl:ObjectProperty .
hpc:hasEndOfSupport a owl:ObjectProperty .
hpc:requiresBackup a owl:ObjectProperty .
hpc:usesSlurmdbd a owl:ObjectProperty .
hpc:usesSlurmctld a owl:ObjectProperty .
hpc:usesSlurmd a owl:ObjectProperty .
hpc:usesSlurmCommands a owl:ObjectProperty .
hpc:usesCustomizedSlurmPlugins a owl:ObjectProperty .
hpc:supportsSeamlessUpgrades a owl:ObjectProperty .

hpc:upgradeTo rdfs:domain hpc:SlurmVersion ;
    rdfs:range hpc:SlurmVersion .
