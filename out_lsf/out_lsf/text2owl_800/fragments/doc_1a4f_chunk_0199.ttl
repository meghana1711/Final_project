hpc:Resource a owl:Class .
hpc:location a owl:DatatypeProperty .
hpc:value a owl:DatatypeProperty .
hpc:Resourcevalue rdfs:domain hpc:Resource .
hpc:Location rdfs:domain hpc:Resource .
hpc:Value rdfs:domain hpc:Resource .
hpc:Resource rdfs:subClassOf rdf:Resource .

hpc:Os a owl:Class .
hpc:Cpu a owl:Class .
hpc:status a owl:ObjectProperty .

hpc:OsVersion rdfs:range xsd:string .
hpc:CpuType rdfs:range xsd:string .
hpc:Status rdfs:range xsd:string .

hpc:OsVersion rdfs:domain hpc:Os .
hpc:CpuType rdfs:domain hpc:Cpu .
hpc:Status rdfs:domain hpc:Resource .

hpc:OsVersion1 hpc:osVersion "4.2" .
hpc:OsVersion2 hpc:osVersion "4.0" .
hpc:OsVersion3 hpc:osVersion "4.1" .
hpc:CpuType1 hpc:cpuType "ia" .
hpc:CpuType2 hpc:cpuType "ia" .
hpc:CpuType3 hpc:cpuType "unknown" .
