hpc:Patchinstall a owl:Class .
hpc:Patchinstall rdfs:subClassOf owl:Class .

hpc:pversionsunix a owl:ObjectProperty .
hpc:Pversionsunix rdfs:domain hpc:Patchinstall ;
                   rdfs:range hpc:Unix .

hpc:pversionswindows a owl:ObjectProperty .
hpc:Pversionswindows rdfs:domain hpc:Patchinstall ;
                      rdfs:range hpc:Windows .

hpc:ssacct a owl:ObjectProperty .
hpc:Ssacct rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:ssched a owl:ObjectProperty .
hpc:Ssched rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:ssview a owl:ObjectProperty .
hpc:Ssview rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:taskman a owl:ObjectProperty .
hpc:Taskman rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:tspeek a owl:ObjectProperty .
hpc:Tspeek rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:tssub a owl:ObjectProperty .
hpc:Tssub rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:wgpasswd a owl:ObjectProperty .
hpc:Wgpasswd rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:wguser a owl:ObjectProperty .
hpc:Wguser rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:bacct a owl:ObjectProperty .
hpc:Bacct rdfs:domain rdf:Resource ;
             rdfs:range rdf:Resource .

hpc:Bacct a owl:Class .
hpc:Bacct rdfs:subClassOf owl:Class .
