hpc:Resourceusagelimit a owl:Class .
hpc:Resourceallocationlimit a owl:Class .
hpc:Queuebasedresourcereservationlimit a owl:Class .

hpc:corefilesizelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:cputimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:duration .
hpc:datasegmentsizelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:filesizelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:memorylimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:processlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:runtimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:duration .
hpc:stacksegmentsizelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:virtualmemorylimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .
hpc:threadlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range xsd:integer .

hpc:defaultlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range hpc:Resourceusagelimit .
hpc:maximumlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusagelimit ;
    rdfs:range hpc:Resourceusagelimit .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourceusagelimit .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Resourceusagelimit .

hpc:Incorrectresourceusagelimit a owl:Class .

hpc:warningmessage a owl:ObjectProperty ;
    rdfs:domain hpc:Incorrectresourceusagelimit ;
    rdfs:range rdfs:Literal .

hpc:mbatchdlogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Incorrectresourceusagelimit ;
    rdfs:range rdfs:Literal .
