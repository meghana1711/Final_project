hpc:Executioncluster a owl:Class .

hpc:ineligiblependtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:timeinseconds a owl:ObjectProperty ;
    rdfs:domain hpc:Ineligiblependtime ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangecnt a owl:DatatypeProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Indexrange a owl:Class ;
    rdfs:subClassOf hpc:Executioncluster .

hpc:indexrangestart1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangeend1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangestep1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangestartn a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangeendn a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .

hpc:indexrangestepn a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexrange ;
    rdfs:range xsd:nonNegativeInteger .
