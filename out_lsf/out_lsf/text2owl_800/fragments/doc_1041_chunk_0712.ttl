hpc:Job a owl:Class .

hpc:hasstate a owl:ObjectProperty .
hpc:Hasstate rdfs:domain hpc:Job .
hpc:Hasstate rdfs:range xsd:string .

hpc:Done a owl:Class .
hpc:Exit a owl:Class .
hpc:Psusp a owl:Class .
hpc:Pend a owl:Class .

hpc:numdone a owl:DatatypeProperty .
hpc:Numdone rdfs:domain hpc:Job .
hpc:Numdone rdfs:range xsd:nonNegativeInteger .

hpc:numended a owl:DatatypeProperty .
hpc:Numended rdfs:domain hpc:Job .
hpc:Numended rdfs:range xsd:nonNegativeInteger .

hpc:numexit a owl:DatatypeProperty .
hpc:Numexit rdfs:domain hpc:Job .
hpc:Numexit rdfs:range xsd:nonNegativeInteger .

hpc:numhold a owl:DatatypeProperty .
hpc:Numhold rdfs:domain hpc:Job .
hpc:Numhold rdfs:range xsd:nonNegativeInteger .

hpc:numpend a owl:DatatypeProperty .
hpc:Numpend rdfs:domain hpc:Job .
hpc:Numpend rdfs:range xsd:nonNegativeInteger .

hpc:numrun a owl:DatatypeProperty .
hpc:Numrun rdfs:domain hpc:Job .
hpc:Numrun rdfs:range xsd:nonNegativeInteger .

hpc:JobInDoneState a owl:Class .
hpc:JobInDoneState rdfs:subClassOf hpc:Job .
hpc:Job_in_DONE_State rdf:type hpc:Job_State .
hpc:JobInDoneState hpc:hasstate "DONE" .

hpc:JobInExitState a owl:Class .
hpc:JobInExitState rdfs:subClassOf hpc:Job .
hpc:Job_in_EXIT_State rdf:type hpc:Job_State .
hpc:JobInExitState hpc:hasstate "EXIT" .

hpc:JobInPsuspState a owl:Class .
hpc:JobInPsuspState rdfs:subClassOf hpc:Job .
hpc:Job_in_PSUSP_State rdf:type hpc:Job_State .
hpc:JobInPsuspState hpc:hasstate "PSUSP" .

hpc:JobInPendState a owl:Class .
hpc:JobInPendState rdfs:subClassOf hpc:Job .
hpc:Job_in_PEND_State rdf:type hpc:Job_State .
hpc:JobInPendState hpc:hasstate "PEND" .
