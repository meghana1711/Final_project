hpc:LsfServer a owl:Class .
hpc:Eslim a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:lsfServerdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfServer ;
    rdfs:range xsd:string .
hpc:eslimname a owl:DatatypeProperty ;
    rdfs:domain hpc:Eslim ;
    rdfs:range xsd:string .
hpc:operatingsystemname a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .
hpc:eslimexecutable a owl:ObjectProperty ;
    rdfs:domain hpc:LsfServer ;
    rdfs:range hpc:Eslim .
hpc:reservedname a owl:DatatypeProperty ;
    rdfs:domain hpc:Eslim ;
    rdfs:range xsd:string .
hpc:LsfSharedfile a owl:Class .
hpc:resourcedefinition a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfSharedfile ;
    rdfs:range xsd:string .
hpc:LSF_Server subClassOf owl:Class .
hpc:ESlim subClassOf hpc:LSF_Server .
hpc:OperatingSystem subClassOf owl:Class .
hpc:Eslimexecutable rdfs:domain hpc:LsfServer ;
    rdfs:range hpc:Eslim ;
    rdfs:subPropertyOf rdf:type .
hpc:Reservedname rdfs:domain hpc:Eslim ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdf:type .
hpc:LsfSharedfile rdfs:subClassOf owl:Class .
