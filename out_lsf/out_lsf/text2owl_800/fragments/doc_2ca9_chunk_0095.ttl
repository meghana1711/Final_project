hpc:Jobfinishevent a owl:Class ;
   rdfs:subClassOf hpc:Event .

hpc:Googleprovider a owl:Class ;
   rdfs:subClassOf hpc:Cloudprovider .

hpc:Hostprovider a owl:Class ;
   rdfs:subClassOf hpc:Resourceprovider .

hpc:Nvidiasiblinggpu a owl:Class ;
   rdfs:subClassOf hpc:Gpu .

hpc:Candidatehostgroup a owl:Class ;
   rdfs:subClassOf hpc:Hostgroup .

hpc:Resourceconnector a owl:Class ;
   rdfs:subClassOf hpc:Softwarecomponent .

hpc:Resourceconnectorhost a owl:Class ;
   rdfs:subClassOf hpc:Host .

# Object Properties
hpc:hasinstanceid a owl:ObjectProperty ;
   rdfs:domain hpc:Jobfinishevent ;
   rdfs:range xsd:string .

hpc:hasprovider a owl:ObjectProperty ;
   rdfs:domain hpc:Resourceconnectorhost ;
   rdfs:range hpc:Hostprovider .

hpc:hastimeout a owl:ObjectProperty ;
   rdfs:domain hpc:Hostprovider ;
   rdfs:range xsd:duration .

hpc:hassiblinggpu a owl:ObjectProperty ;
   rdfs:domain hpc:Gpu ;
   rdfs:range hpc:Gpu .

hpc:isnvidiasibling a owl:ObjectProperty ;
   rdfs:domain hpc:Nvidiasiblinggpu ;
   rdfs:range xsd:boolean .

hpc:joinedcluster a owl:ObjectProperty ;
   rdfs:domain hpc:Resourceconnectorhost ;
   rdfs:range xsd:boolean .

hpc:hastemplatepriority a owl:ObjectProperty ;
   rdfs:domain hpc:Candidatehostgroup ;
   rdfs:range xsd:integer .

hpc:hasresourceconnector a owl:ObjectProperty ;
   rdfs:domain hpc:Hostprovider ;
   rdfs:range hpc:Resourceconnector .

# Datatype Properties
hpc:hasproviderfile a owl:DatatypeProperty ;
   rdfs:domain hpc:Resourceconnector ;
   rdfs:range xsd:string .

hpc:hasamiid a owl:DatatypeProperty ;
   rdfs:domain hpc:Resourceconnector ;
   rdfs:range xsd:string .

hpc:hasproxysupport a owl:DatatypeProperty ;
   rdfs:domain hpc:Resourceconnector ;
   rdfs:range xsd:boolean .

hpc:hastemplateorder a owl:DatatypeProperty ;
   rdfs:domain hpc:Candidatehostgroup ;
   rdfs:range xsd:string .
