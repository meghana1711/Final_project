hpc:Cluster a owl:Class .
hpc:Host a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:Hosttype a owl:Class .
hpc:Resource a owl:Class .

hpc:hasCommonDefinitions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range [ hpc:Hosttype , hpc:Hostmodel , hpc:Resource ] .

hpc:belongsTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster .

hpc:hasCompatibleConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster .

hpc:resourceOwner rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:User .

hpc:resourceConsumer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Resource .

hpc:requiresValidUserAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Cluster .

hpc:hasSameUserNameInEachCluster rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:boolean .

hpc:configuresAccountMapping rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster .

hpc:transfersJobFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsf .

hpc:transfersDataFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hdfs:LSF .

hpc:supportsDynamicIPAddressing rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:requiresFixedIPAddress rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:Installationandconfigurationproceduresforlsfmulticluster a owl:Class .
hpc:procedure1 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Installationandconfigurationproceduresforlsfmulticluster ;
    rdfs:range xsd:string .

hpc:PlanTheCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Procedure1 ;
    rdfs:range xsd:string .
