hpc:eventtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:dateTime .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:idx a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:notifyid a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:integer .
hpc:JobResizeRelease a owl:Class ;
    rdfs:subClassOf hpc:Event .
hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:JobResizeRelease ;
    rdfs:range xsd:string .
