hpc:Restart a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "While the bctrld restart res subcommand waits for remote tasks to exit, another RES is restarted to serve the new queries.";

hpc:restarts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Restart ;
    rdfs:range hpc:Restart ;
    rdfs:comment "Disables interaction and does not ask for conﬁrmation for restarting RES.";

hpc:HostName a owl:Class ;
    rdfs:subClassOf xsd:string ;

hpc:Sbd a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Restarts the sbatchd daemon on the specified hosts, or on all server hosts if the reserved word all is specified.";

hpc:sbd_restart rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sbd ;
    rdfs:range hpc:Restart ;
    rdfs:comment "The sbatchd daemon reruns itself from the beginning. This rerun allows new sbatchd binary files to be used.";

hpc:logfileName a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbd ;
    rdfs:range xsd:string ;
    rdfs:comment "On UNIX, if the speciﬁed path is not valid, the log file is created in the /tmp directory. On Windows, if the speciﬁed path is not valid, no log file is created.";

hpc:logfileNameFormat a owl:DatatypeProperty ;
    rdfs:domain hpc:LogfileName ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the file has the following format: logfile_name.daemon_name.log.host_name";

hpc:All a owl:Class ;
    rdfs:subClassOf xsd:string ;

hpc:Lim a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Starts LIM on the local host if no arguments are specified.";

hpc:starts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range hdfs:LIM ;
    rdfs:comment "Starts LIM on the local host if no arguments are specified.";
