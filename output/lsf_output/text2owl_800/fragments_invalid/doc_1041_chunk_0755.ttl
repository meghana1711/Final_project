hpc:Host a owl:Class .
hpc:Cluster a owl:Class .
hpc:Daemon a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Nonmanagementhost a owl:Class .
hpc:Loadinformation a owl:Class .
hpc:loadindex a owl:DatatypeProperty .
hpc:starts a owl:ObjectProperty .
hpc:provides a owl:ObjectProperty .
hpc:monitors a owl:ObjectProperty .
hpc:systemconfigurationinformation a owl:DatatypeProperty .
hpc:Vemkd a owl:Class .
hpc:Pem a owl:Class .
hpc:managementhostlim a owl:ObjectProperty .
hpc:managementhostlist a owl:DatatypeProperty .
hpc:egoconfdir a owl:DatatypeProperty .
hpc:debuglevel a owl:DatatypeProperty .
hpc:Daemonstartoptions a owl:Class .
hpc:version a owl:DatatypeProperty .
hpc:debugmode a owl:DatatypeProperty .
hpc:configurationfilevalidation a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Cluster rdfs:subClassOf rdf:Resource .
hpc:Daemon rdfs:subClassOf rdf:Resource .
hpc:Managementhost rdfs:subClassOf hpc:Daemon ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:domain hpc:Cluster .
hpc:Nonmanagementhost rdfs:subClassOf hpc:Daemon ;
    rdfs:subClassOf rdf:Resource .
hpc:Loadinformation rdfs:subClassOf rdf:Resource .
hpc:Loadindex rdfs:domain hpc:Loadinformation ;
    rdfs:range xsd:decimal .
hpc:Starts rdfs:domain hpc:Host ;
    rdfs:range hpc:Daemon .
hpc:Provides rdfs:domain hpc:Host ;
    rdfs:range hpc:Vemkd .
hpc:Monitors rdfs:domain hpc:Host ;
    rdfs:range hpc:Loadinformation .
hpc:Systemconfigurationinformation rdfs:domain hpc:Host ;
    rdfs:range hpc:Vemkd .
hpc:Managementhostlim rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Host .
hpc:Managementhostlist rdfs:domain hpc:Cluster ;
    rdfs:range rdf:Seq .
hpc:Egoconfdir rdfs:domain hpc:Daemonstartoptions ;
    rdfs:range xsd:string .
hpc:Debuglevel rdfs:domain hpc:Daemonstartoptions ;
    rdfs:range xsd:string .
hpc:Version rdfs:domain hpc:Daemonstartoptions ;
    rdfs:range xsd:string .
hpc:Debugmode rdfs:domain hpc:Daemonstartoptions ;
    rdfs:range xsd:boolean .
hpc:ConfigurationFileValidation
