hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .

hpc:committedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:historicalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:dynamicpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:hasPriority .

hpc:haspriority a owl:ObjectProperty .

hpc:enablehistoricalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue, hpc:Cluster ;
    rdfs:range xsd:boolean .

hpc:cleanperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Mbatchd a owl:Class .
