hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Exitcode a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents an exit code for a job." .

hpc:exclude a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Indicates that a job is excluded from exclusive re-queue." .

hpc:requeueexclusive a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Relates a job to the job that is re-queued exclusively due to its exit code." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a parallel job that does not support exclusive job re-queue." .

hpc:requeueposition a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Indicates the position of a job in the re-queue, either at the head (0) or the bottom (greater than 0)." .

hpc:bmodq a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Relates a job to the job that is modified or canceled using bmod -Q." .

hpc:Remotecluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster ;
    rdfs:comment "Represents a remote cluster in the HPC system." .

hpc:multiclusterjobforwardingmodel a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobforwardingmodel ;
    rdfs:comment "Relates a job to its multicluster job forwarding model." .

hpc:multiclusterleasemodel a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobleasemodel ;
    rdfs:comment "Relates a job to its multicluster lease model." .

hpc:reverserequeuing a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobrequeuing ;
    rdfs:comment "Relates a job to its reverse re-queuing configuration." .
