hpc:Lsf101 a owl:Class .
hpc:Generalperformanceimprovements rdfs:subClassOf hpc:Performanceenhancements .
hpc:Schedulerefficiency rdfs:subClassOf hpc:Generalperformanceimprovements .
hpc:Daemoncommunication rdfs:subClassOf hpc:Generalperformanceimprovements .
hpc:Improvedschedulingforshortjobs rdfs:subClassOf hpc:Generalperformanceimprovements .

hpc:SchedulerEfficiency rdfs:comment "Binary-level and algorithm-level optimizations to help the scheduler make faster decisions." .
hpc:DaemonCommunication rdfs:comment "Optimizations to mbatchd/sbatchd communication protocols to ensure a dedicated channel to accelerate messages." .
hpc:ImprovedSchedulingForShortJobs rdfs:comment "Allows multiple jobs with common resource requirements to run consecutively on the same allocation." .

hpc:Schedulerefficiency rdfs:domain hpc:Lsf101 .
hpc:Daemoncommunication rdfs:domain hpc:Lsf101 .
hpc:Improvedschedulingforshortjobs rdfs:domain hpc:Lsf101 .

hpc:hasoptimization a owl:ObjectProperty .
hpc:hascommunicationoptimization a owl:DatatypeProperty .
hpc:hasschedulingoptimization a owl:DatatypeProperty .

hpc:Lsf101 hpc:hasoptimization hpc:SchedulerEfficiency .
hpc:Lsf101 hpc:hascommunicationoptimization "mbatchd/sbatchd communication protocols" .
hpc:Lsf101 hpc:hasschedulingoptimization "multiple jobs with common resource requirements" .

hpc:Pendingjobmanagement a owl:Class .
hpc:Jobschedulingandexecution a owl:Class .
hpc:Hostrelatedfeatures a owl:Class .
hpc:Otherchangestolsfbehavior a owl:Class .

hpc:hasfeature a owl:ObjectProperty .

hpc:Lsf101 hpc:hasfeature hpc:PendingJobManagement .
hpc:Lsf101 hpc:hasfeature hpc:JobSchedulingAndExecution .
