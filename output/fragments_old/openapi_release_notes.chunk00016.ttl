hpc:JobInfo a owl:Class .

hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .

hpc:jobState a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .

hpc:flags enum "GRES_BINDING_DISABLED" ;
   "JOB_WAS_RUNNING" ;
   "JOB_ACCRUE_TIME_RESET" ;
   "CRON_JOB" ;
   "EXACT_MEMORY_REQUESTED" ;
   "EXTERNAL_JOB" ;
   "USING_DEFAULT_ACCOUNT" ;
   "USING_DEFAULT_PARTITION" ;
   "USING_DEFAULT_QOS" ;
   "USING_DEFAULT_WCKEY" ;
   "DEPENDENT" ;
   "MAGNETIC" ;
   "PARTITION_ASSIGNED" ;
   "BACKFILL_ATTEMPTED" ;
   "SCHEDULING_ATTEMPTED" ;
   "STEPMGR_ENABLED" ;
   "PARTITION_ASSIGNED" ;
   "BACKFILL_ATTEMPTED" ;
   "SCHEDULING_ATTEMPTED" ;
   "STEPMGR_ENABLED" ;
   "ARRAY" .

hpc:jobState enum "PENDING" ;
   "RUNNING" ;
   "SUSPENDED" ;
   "COMPLETED" ;
   "CANCELLED" ;
   "FAILED" ;
   "TIMEOUT" ;
   "NODE_FAIL" ;
   "PREEMPTED" ;
   "BOOT_FAIL" ;
   "DEADLINE" ;
   "OUT_OF_MEMORY" ;
   "LAUNCH_FAILED" ;
   "REQUEUED" ;
   "REQUEUE_HOLD" ;
   "SPECIAL_EXIT" ;
   "RESIZING" ;
   "CONFIGURING" ;
   "COMPLETING" ;
   "STOPPED" ;
   "RECONFIG_FAIL" ;
   "POWER_UP_NODE" .
