hpc:Temporaryerror a owl:Class .
hpc:Automaticjobrequeuing a owl:Class .
hpc:Configurablequeue a owl:Class .
hpc:specifiedexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurablequeue ;
    rdfs:range xsd:integer .
hpc:requeuetohead a owl:ObjectProperty ;
    rdfs:domain hpc:Configurablequeue ;
    rdfs:range hpc:Job .
hpc:lsbRequeueToBottom a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurablequeue ;
    rdfs:range xsd:boolean .
hpc:outputsaving a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:reverserequeuing a owl:ObjectProperty ;
    rdfs:domain hpc:Configurablequeue ;
    rdfs:range hpc:Job .
hpc:exclusivejobrequeuing a owl:ObjectProperty ;
    rdfs:domain hpc:Configurablequeue ;
    rdfs:range hpc:Job .
hpc:Requeuedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:failedhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Requeuedjob ;
    rdfs:range xsd:string .
