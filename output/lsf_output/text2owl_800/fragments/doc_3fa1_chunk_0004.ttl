hpc:Jobpack a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A group of jobs submitted together to LSF." .

hpc:jobpacksize a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum size of a job pack." .

hpc:jobpackenabled a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether job packs are enabled." .

hpc:jobpacksubmissionrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpack ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The rate at which jobs are submitted when using job packs." .

hpc:Jobpacksupportedoptions a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The options that are not supported in a job pack submission file." .

hpc:Unsupportedoption a owl:Class ;
    rdfs:subClassOf hpc:Jobpacksupportedoptions ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An individual option that is not supported in a job pack submission file." .

hpc:Jobpackrejectionreason a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The reason a job pack was rejected by LSF." .

hpc:JobpackrejectionreasonJobpacksizeexceeded a owl:Class ;
    rdfs:subClassOf hpc:Jobpackrejectionreason ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The reason a job pack was rejected because it exceeded the job pack size defined in lsf.conf." .

hpc:Jobpackjob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An individual job within a job pack." .
