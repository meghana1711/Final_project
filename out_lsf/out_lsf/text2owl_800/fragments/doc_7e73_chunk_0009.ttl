hpc:Procedure a owl:Class .
hpc:install a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Install .
hpc:setup a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure .
hpc:login a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Login .
hpc:installplugin a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Installplugin .
hpc:target a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Target .
hpc:region a owl:DatatypeProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range xsd:string .
