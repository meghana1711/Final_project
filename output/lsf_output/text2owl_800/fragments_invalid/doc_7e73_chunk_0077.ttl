    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:nonNegativeInteger .

hpc:azurehost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:boolean .

hpc:zone rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:storageAccountType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:resourceGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:virtualNetwork rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:subnet rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:securityGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:sshPubKeyFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:instanceTags rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templatea ;
    rdfs:range xsd:string .

hpc:LSF_TOP rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Userdatascript .
    rdfs:range xsd:string .

