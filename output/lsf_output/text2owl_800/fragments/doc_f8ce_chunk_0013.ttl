hpc:Cache a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A single cache is created for incoming files, and files are shareable by all users." .

hpc:cacheaccessiblefiles a owl:DatatypeProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specifies whether LSF data manager initiates a transfer job or creates a symbolic link from the cache to the requested data file." .

hpc:stagingin a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "Allows a user to stage in files that are associated with another user's tags." .

hpc:staginginuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The user name associated with the job for staging in files." .

hpc:Tag a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A tag associated with data files." .

hpc:Tagdirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The directory associated with a tag." .

hpc:cacheaccesscontrol a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Configures whether the -u option can be used for staging in files associated with another user's tags." .

hpc:Group a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A user group." .

hpc:usergroupname a owl:DatatypeProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the user group." .

hpc:Datatransfernode a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A data transfer node." .

hpc:Datatransferqueue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The queue that serves data transfer nodes." .

hpc:Datatransferjob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A data transfer job." .

hpc:transferqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferjob ;
    rdfs:range hpc:Datatransferqueue ;
    rdfs:comment "The queue that a data transfer job goes to." .

hpc:transferjobrequestedby a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range hpc:Datamanager ;
    rdfs:comment "The data manager that requested a data transfer job." .
