hpc:Job a owl:Class .
hpc:ArrayJob a owl:Class, rdfs:subClassOf hpc:Job .
hpc:Task a owl:Class, rdfs:subClassOf hpc:Job .

hpc:JobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:ArrayJobId a owl:DatatypeProperty ;
    rdfs:domain hpc:ArrayJob ;
    rdfs:range xsd:integer .

hpc:ArrayTaskId a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:integer .

hpc:User a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:NodeList a owl:Class .

hpc:StartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:State a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:DependsOn a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:After a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:DependsOn .

hpc:AfterAny a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:After .

hpc:AfterCorr a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:After .

hpc:AfterOk a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:After .

hpc:AfterNotOk a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:After .
```
