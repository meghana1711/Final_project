@base <http://example.org/hpc/>

hpc:CoresPerSocket
    a owl:Class ;
    rdfs:subClassOf owl:Real ;
    rdfs:comment "Number of cores in a single physical processor socket." .

hpc:ThreadsPerCore
    a owl:ObjectProperty ;
    rdfs:domain hpc:Physicalcore ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of logical threads in a single physical core." .

hpc:RealMemory
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeDecimal ;
    rdfs:comment "Amount of real memory. This parameter is required when specifying Memory as a consumable resource with the select/cons_tres plug-in." .

hpc:SlurmUser
    a owl:Class ;
    rdfs:comment "The Slurm controller (slurmctld) can run without elevated privileges, so it is recommended that a user 'slurm' be created for it." .

hpc:SlurmdStateSaveDirectory
    a owl:ObjectProperty ;
    rdfs:domain h
