hpc:Dataspecificationfile a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:Resource ] .

hpc:Hostname a owl:Class ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range xsd:string .

hpc:Filepath a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf xsd:string ] .

hpc:Allowedchar a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Allowedspecialchar a owl:Class ;
    rdfs:subClassOf AllowedChar ;
    owl:disjointWith [ a owl:Class ;
                          rdfs:subClassOf xsd:string ;
                          owl:complementOf AllowedChar ] ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf xsd:string ;
                        owl:oneOf ( "_" "_" "-" "." ) ] .

hpc:Wildcard a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:directorytransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range hpc:Dataspecificationfile .

hpc:filetransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range hpc:Dataspecificationfile ;
    rdfs:subPropertyOf hpc:DirectoryTransfer .

hpc:recursivetransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range hpc:Dataspecificationfile ;
    rdfs:subPropertyOf hpc:FileTransfer ;
    rdfs:range [ a owl:Class ;
                   rdfs:subClassOf hpc:Dataspecificationfile ;
                   rdfs:subClassOf xsd:string ;
                   owl:oneOf ( "/" "*" ) ] .

hpc:nonrecursivetransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range hpc:Dataspecificationfile ;
    rdfs:subPropertyOf hpc:FileTransfer ;
    rdfs:range [ a owl:Class ;
                   rdfs:subClassOf hpc:Dataspecificationfile ;
                   rdfs:subClassOf xsd:string ;
                   owl:oneOf ( "/*" ) ] .

hpc:symboliclinknotallowed a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range xsd:boolean .
