hpc:Reservation a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A reserved set of resources for a specific period of time." .

hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Partition a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Node a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .

hpc:hasReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Reservation .

hpc:hasNode a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:hasNodes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range owl:Integer .

hpc:hasCoreCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:integer .

hpc:hasNodeCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:integer .

hpc:hasDuration a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:hasStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:hasEndTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:hasState a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .

hpc:hasAccounts a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:hasLicenses a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:hasFlags a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:hasPartitionName a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:hasFeatures a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
