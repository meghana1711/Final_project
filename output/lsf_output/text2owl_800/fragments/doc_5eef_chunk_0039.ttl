hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the tag associated with a job." .

hpc:Username a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a user in the HPC system." .

hpc:stagein a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Tagname ;
    rdfs:comment "Allows a job to stage in files associated with another user's tag." .

hpc:cacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the -u option can be used for a job." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for a job." .

hpc:arrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The array index for a job." .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the cluster a job is running on." .

hpc:bstageout a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:comment "Stages out data files for jobs with data requirements." .

hpc:src a owl:DatatypeProperty ;
    rdfs:domain hpc:Bstageout ;
    rdfs:range xsd:string ;
    rdfs:comment "The source file path or folder path for bstage out." .

hpc:dst a owl:DatatypeProperty ;
    rdfs:domain hpc:Bstageout ;
    rdfs:range xsd:string ;
    rdfs:comment "The destination host and path for the staged out file or folder." .

hpc:link a owl:DatatypeProperty ;
    rdfs:domain hpc:Bstageout ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether symbolic links should be created for the staged out files." .
