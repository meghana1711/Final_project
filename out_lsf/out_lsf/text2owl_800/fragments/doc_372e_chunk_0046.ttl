hpc:AppZ
    a owl:Class ;
    rdfs:subClassOf hpc:Licensefeature .

hpc:distribution
    a owl:ObjectProperty ;
    rdfs:domain hpc:Licensefeature ;
    rdfs:range hpc:Distribution .

hpc:allocation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Licensefeature ;
    rdfs:range hpc:Allocation .

hpc:FeatureGroup
    a owl:Class ;
    rdfs:subClassOf hpc:Group .

hpc:featureList
    a owl:ObjectProperty ;
    rdfs:domain hpc:Featuregroup ;
    rdfs:range hpc:Licensefeature .
