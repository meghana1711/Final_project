hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the mbatchd daemon." .

hpc:Mbatchdup a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd ;
    rdfs:comment "Represents the state when mbatchd is up and ready to schedule jobs." .

hpc:Mbatchddown a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd ;
    rdfs:comment "Represents the state when mbatchd is down." .

hpc:Mbatchdreconfiguring a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd ;
    rdfs:comment "Represents the state when mbatchd is being reconﬁgured." .

hpc:LsbSharedirfull a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the state when LSB_SHAREDIR is full." .

hpc:Administrator a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the administrator of the system." .

hpc:AdministratorOpensHost an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Host ;
    rdfs:comment "The action performed by the administrator to open a host." .

hpc:AdministratorClosesHost an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Host ;
    rdfs:comment "The action performed by the administrator to close a host." .

hpc:AdministratorOpensQueue an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hp:Queue ;
    rdfs:comment "The action performed by the administrator to open a queue." .

hpc:AdministratorClosesQueue an owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Queue ;
    rdfs:comment "The action performed by the administrator to close a queue." .

hpc:Mbschd a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the mbschd daemon." .

hpc:Mbschddown a owl:Class ;
    rdfs:subClassOf hpc:Mbschd ;
    rdfs:comment "Represents the state when mbschd is down." .

hpc:lsfEventReceiver a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:comment "The event receiver for LSF." .
