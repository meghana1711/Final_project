hpc:TaskAffinity a owl:Class .

hpc:SlurmJob rdfs:subClassOf owl:Thing .
hpc:SlurmConf rdfs:subClassOf owl:Thing .
hpc:TaskPlugin rdfs:domain hpc:SlurmJob ;
                                rdfs:range rdf:List .
hpc:CgroupConf rdfs:subClassOf hpc:SlurmConf .
hpc:ConstrainCores rdfs:domain hpc:CgroupConf ;
                             rdfs:range xsd:boolean .
hpc:SelectType rdfs:domain hpc:SlurmConf ;
                          rdfs:range hpc:TaskType .
hpc:SelectTypeParameters rdfs:domain hpc:SelectType ;
                            rdfs:range rdf:List .
hpc:CR_Core rdfs:subClassOf hpc:TaskType .
hpc:TaskType rdfs:subClassOf owl:Thing .
hpc:BlockMethod rdfs:subClassOf hpc:TaskType .
hpc:Task rdfs:subClassOf owl:Thing .
hpc:TaskID rdfs:domain hpc:Task ;
                          rdfs:range xsd:string .
hpc:NodeName rdfs:domain hpc:Task ;
                          rdfs:range xsd:string .
hpc:SocketID rdfs:domain hpc:Task ;
                          rdfs:range xsd:string .
hpc:AllocatedCPUs rdfs:domain hpc:CgroupConf ;
                          rdfs:range xsd:integer .
hpc:AllocatedCPUIDs rdfs:domain hpc:CgroupConf ;
                            rdfs:range xsd:string .
hpc:BindingOfTasksToCPUs rdfs:domain hpc:Task ;
                            rdfs:range rdf:List .
hpc:TaskDistribution rdfs:subClassOf hpc:Task .
hpc:TaskAffinity rdfs:subClassOf hpc:Task .
