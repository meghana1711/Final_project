hpc:ComputeNode a owl:Class .
hpc:Job a owl:Class .
hpc:CoreSpecification a owl:Class .
hpc:CoreSpecCount xsd:nonNegativeInteger .
hpc:JobCoreSpecification a owl:Class, rdfs:subClassOf [ hpc:CoreSpecification ;
                                                         rdfs:subClassOf ( hpc:Job ;
                                                                           rdf:type owl:Class ) ] .
hpc:AllocatedComputeNode hpc:JobCoreSpecification .
hpc:SystemOverheadCore hpc:CoreSpecification .
hpc:CoreSpecificationCountOfAllocatedComputeNode rdfs:domain hpc:AllocatedComputeNode ;
                                                 rdfs:range xsd:nonNegativeInteger .
hpc:HasSystemOverheadCore hpc:AllocatedComputeNode .
hpc:HasSystemOverheadCoreCount hpc:AllocatedComputeNode .
hpc:HasJobCoreSpecification hpc:Job .
hpc:HasJobCoreSpecificationCount hpc:Job .
hpc:CoreSpecificationCountOfJob rdfs:domain hpc:Job ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:UseCoreSpecificationCommand a owl:ObjectProperty .
hpc:UseCoreSpecificationCommand rdfs:domain hpc:Job ;
                                   rdfs:range xsd:string .
hpc:IgnoreCoreSpecificationCommand a owl:ObjectProperty .
hpc:IgnoreCoreSpecificationCommand rdfs:domain hpc:srun ;
                                      rdfs:range xsd:boolean .
hpc:ImplicitlyExclusive a owl:ObjectProperty .
hpc:ImplicitlyExclusive rdfs:domain hpc:JobCoreSpecification ;
                            rdfs:range xsd:boolean .
hpc:AccessAllNonSpecializedCores a owl:ObjectProperty .
hpc:AccessAllNonSpecializedCores rdfs:domain hpc:JobCoreSpecification ;
                                    rdfs:range xsd:boolean .
hpc:ReportedInDefaultOutputFormat a owl:ObjectProperty .
hpc:ReportedInDefaultOutputFormat rdfs:domain hpc:squeue ;
                                      rdfs:range xsd:boolean .
hpc:ModifyCoreSpecificationCount a owl:ObjectProperty .
hpc:ModifyCoreSpecificationCount rdfs:domain ( hpc:scontrol ;
                                                  hpc:sview ) ;
                                      rdfs:range xsd:nonNegativeInteger .
hpc:ChargedForAllNonSpecializedCPUs a owl:ObjectProperty .
hpc:ChargedForAllNonSpecializedCPUs rdfs:domain hpc:Job ;
                                         rdfs:range xsd:boolean .
hpc:AccountingReportedAs a owl:ObjectProperty .
hpc:AccountingReportedAs rdfs:domain hpc:Job ;
                             rdfs:range xsd:string .
```
