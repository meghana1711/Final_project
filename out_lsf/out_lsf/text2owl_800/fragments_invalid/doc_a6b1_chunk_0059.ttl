hpc:Windowshost a owl:Class .
hpc:Lsf a owl:Class .
hpc:Usercredential a owl:Class .
hpc:Hostcredential a owl:Class .
hpc:Daemoncredential a owl:Class .
hpc:Eauthexecutable a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Floatingclient a owl:Class .
hpc:Dynamichost a owl:Class .
hpc:Lsfmulticluster a owl:Class .
hpc:Submissionhost a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Mbatchd a owl:Class .
hpc:Sbatchd a owl:Class .

hpc:authenticates rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Usercredential .

hpc:checks rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Hostcredential .

hpc:rejects rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Request .

hpc:verifies rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Eauthexecutable ;
    rdfs:range hpc:Credentials .

hpc:mediates rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hdf:DaemonAuthentication .

hpc:appliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemoncommunication ;
    rdfs:range hpc:Daemonauthentication .

hpc:Lsfdaemoncommunication a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:appliesTo ;
                        rdfs:allValuesFrom hpc:DaemonAuthentication ] .

hpc:Daemonauthentication a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:mediates ;
                        rdfs:allValuesFrom hpc:eauthExecutable ] .

hpc:Unix a owl:Class .
hpc:Accountmapping a owl:Class .
hpc:Accountpermission a owl:Class .
hpc:Account a owl:Class .
hpc:Permission a owl:Class .
hpc:Job a owl:Class .
hpc:Owner a owl:Class .
hpc:Lsfsudoers a owl:Class .

hpc:requires rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Extrahostauthentication .

hpc:enables rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Accountmapping ;
    rdfs:range hpc:Account .

hpc:isRequiredFor rdf:type owl:Object
