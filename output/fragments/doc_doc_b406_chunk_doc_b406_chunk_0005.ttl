hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:ConsumableResource a owl:Class, rdfs:subClassOf hpc:Resource .
hpc:MemoryAllocation a owl:Class .
hpc:JobMemoryRequirement a owl:Class .
hpc:PerNodeMemoryRequirement a owl:Class, rdfs:subClassOf hpc:JobMemoryRequirement .
hpc:PerCPUMemoryRequirement a owl:Class, rdfs:subClassOf hpc:JobMemoryRequirement .
hpc:MemoryType a owl:Class .
hpc:CoreMemory a owl:Class, rdfs:subClassOf hpc:MemoryType .
hpc:CPUMemory a owl:Class, rdfs:subClassOf hpc:MemoryType .
hpc:SocketMemory a owl:Class, rdfs:subClassOf hpc:MemoryType .
hpc:AllocatedJob a owl:Class .
hpc:HasMemoryAllocation a owl:ObjectProperty .
hpc:HasMemoryRequirement a owl:ObjectProperty .
hpc:HasMemoryType a owl:ObjectProperty .
hpc:HasPerNodeMemoryRequirement a owl:ObjectProperty, rdfs:domain hpc:Job;
                                    rdfs:range hpc:PerNodeMemoryRequirement .
hpc:HasPerCPUMemoryRequirement a owl:ObjectProperty, rdfs:domain hpc:Job;
                                    rdfs:range hpc:PerCPUMemoryRequirement .
hpc:HasMemoryType rdfs:domain hpc:MemoryAllocation;
                   rdfs:range hpc:MemoryType .
hpc:NodeMemory a xsd:nonNegativeInteger .
hpc:CPUMemory a xsd:nonNegativeInteger .
hpc:slurmConfOption a owl:Class .
hpc:DefMemPerCPU a slurmConfOption, rdfs:subClassOf hpc:slurmConfOption .
hpc:DefMemPerNode a slurmConfOption, rdfs:subClassOf hpc:slurmConfOption .
hpc:MaxMemPerCPU a slurmConfOption, rdfs:subClassOf hpc:slurmConfOption .
hpc:MaxMemPerNode a slurmConfOption, rdfs:subClassOf hpc:slurmConfOption .
hpc:JobSubmissionOption a owl:Class .
hpc:MemOption a JobSubmissionOption, rdfs:subClassOf hpc:JobSubmissionOption .
hpc:MemPerCPUOption a JobSubmissionOption, rdfs:subClassOf hpc:MemOption .
hpc:MemPerNodeOption a JobSubmissionOption, rdfs:subClassOf hpc:MemOption .
hpc:CanExceedMaxValue a owl:ObjectProperty .
hpc:CannotExceedMaxValue a owl:ObjectProperty .
hpc:SystemLimit a owl:Class .
hpc:MaxDataSegmentSize a SystemLimit .
hpc:MaxVirtualMemorySize a SystemLimit .
hpc:AccountingPlugin a owl:Class .
hpc:JobAcctGather a owl:ObjectProperty .
hpc:JobAcctFrequency a owl:ObjectProperty .
hpc:OversubscribeOption a JobSubmissionOption .
hpc:ExclusiveOption a JobSubmissionOption .
