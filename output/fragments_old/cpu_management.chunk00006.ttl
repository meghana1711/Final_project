hpc:Job_14 a hpc:Job ;
    hpc:hasCPUCount 18 ;
    hpc:hasTaskCount "18"^^xsd:int ;
    hpc:hasPartition "default" ;
    hpc:allocationMethod "block" ;
    hpc:distributionMethod "cyclic:block" ;
    hpc:taskAffinity true .

