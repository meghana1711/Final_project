hpc:Servicedomain a owl:Class .
hpc:Reservedtoken a owl:Class .
hpc:Freetoken a owl:Class .
hpc:Project a owl:Class .
hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .
hpc:projectshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectown a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectinuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectreserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectfree a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectdemand a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:projectlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:Featuregroup a owl:Class .
hpc:Licensefeature a owl:Class .
hpc:currentjobslotsused a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:peakjobslotsused a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:sortbyalpha a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Sorttype .
hpc:sortbytotal a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Sorttype .
hpc:SortType a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:unionOf (hpc:AlphaSort hpc:TotalSort) .
hpc:AlphaSort a owl:NamedIndividual ;
    rdf:value "alpha" .
hpc:TotalSort a owl:NamedIndividual ;
    rdf:value "total" .
