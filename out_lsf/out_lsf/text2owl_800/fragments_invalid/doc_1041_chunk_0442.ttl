hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Batch queue in LSF." .

hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the queue." .

hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Priority of the queue." .

hpc:queuestatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "Status of the queue." .

hpc:taskstatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queuestatistics ;
    rdfs:comment "Statistics about tasks in the queue." .

hpc:jobstatestatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobstatestatistics ;
    rdfs:comment "Statistics about job states in the queue." .

hpc:jobslotstatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobslotstatistics ;
    rdfs:comment "Statistics about job slots in the queue." .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Resizable job in LSF." .

hpc:resizeallocationrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Allocationrequest ;
    rdfs:comment "Pending resize allocation request for a resizable job." .

hpc:addedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Resources added to a running resizable job." .

hpc:removedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Resources removed from a running resizable job." .

hpc:Lsfmulticluster a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF multicluster capability." .

hpc:localcluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmulticluster ;
    rdfs:range xsd:string ;
    rdfs:comment "Information about all queues in the local cluster." .

hpc:normalizedcputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:double ;
    rdfs:comment "Normalized CPU time for the queue." .

