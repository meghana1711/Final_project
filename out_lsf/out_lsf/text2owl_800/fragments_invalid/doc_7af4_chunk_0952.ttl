hpc:Distribution a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Licenses a owl:Class .
hpc:Project a owl:Class .
hpc:Lp1, hpc:Lp2 rdf:type hpc:Project .

hpc:uses a owl:ObjectProperty .
hpc:entitled a owl:ObjectProperty .
hpc:preempts a owl:ObjectProperty .

hpc:hasLicenses rdf:type hpc:DatatypeProperty .
hpc:dynamic rdf:type hpc:DatatypeProperty .
hpc:duration rdf:type hpc:DatatypeProperty .
hpc:enableDynamicRusage rdf:type hpc:DatatypeProperty .

hpc:Servicedomain hpc:uses hpc:Project .
hpc:Project hpc:haslicenses xsd:integer .
hpc:Servicedomain hpc:entitled hpc:Project .
hpc:Servicedomain hpc:preempts hpc:Project .
hpc:Servicedomain hpc:hasdynamic rdf:value "Y" .
hpc:Servicedomain hpc:hasduration rdf:value xsd:duration .
hpc:Project hpc:hasdynamicrusage rdf:value "Y" .
