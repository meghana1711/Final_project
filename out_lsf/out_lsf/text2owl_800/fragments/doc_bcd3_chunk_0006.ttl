hpc:Schedulingsession a owl:Class .
hpc:schedulinginterval a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingsession ;
    rdfs:range xsd:integer .
hpc:sampleperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingsession ;
    rdfs:range xsd:integer .
hpc:Performancemetric a owl:Class .
hpc:total a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetric ;
    rdfs:range xsd:integer .
hpc:lastperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetric ;
    rdfs:range xsd:integer .
hpc:Metrictype a owl:Class .
hpc:ProcessedRequests a hpc:MetricType .
hpc:JobsInformationQueries a hpc:MetricType .
hpc:HostsInformationQueries a hpc:MetricType .
hpc:QueueInformationQueries a hpc:MetricType .
hpc:JobSubmissionRequests a hpc:MetricType .
hpc:JobsSubmitted a hpc:MetricType .
hpc:JobsDispatched a hpc:MetricType .
hpc:JobsReordered a hpc:MetricType .
hpc:JobsCompleted a hpc:MetricType .
hpc:JobsSentToRemoteCluster a hpc:MetricType .
hpc:JobsAcceptedFromRemoteCluster a hpc:MetricType .
hpc:FileDescriptorUsage a hpc:MetricType .
hpc:SchedulingIntervalSeconds a hpc:MetricType .
hpc:HostMatchingCriteria a hpc:MetricType .
hpc:JobBuckets a hpc:MetricType .
hpc:SchedulingIntervalInSeconds a hpc:SchedulingInterval ;
    rdfs:range hpc:Schedulingintervalseconds .
hpc:HostMatchingCriteriaCount a hpc:HostMatchingCriteria ;
    rdfs:range xsd:integer .
hpc:JobBucketsCount a hpc:JobBuckets ;
    rdfs:range xsd:integer .
hpc:Scheduler a owl:Class .
hpc:MBDFileDescriptorUsage a hpc:Scheduler ;
    rdfs:subClassOf hpc:Filedescriptorusage .
hpc:Performancemonitor a owl:Class .
hpc:PerformanceMonitorStartTime a hpc:PerformanceMonitor ;
    rdfs:range xsd:dateTime .
hpc:EndTimeOfLastSamplePeriod a hpc:PerformanceMonitor ;
    rdfs:range xsd:dateTime .
hpc:SamplePeriodSeconds a hpc:PerformanceMonitor ;
    rdfs:range xsd:integer .
hpc:noperformancemetricdataavailable a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemonitor .
