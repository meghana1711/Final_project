hpc:Interactivebatchjob a owl:Class .
hpc:Lsfpolicy a owl:Class .
hpc:Interactiveserver a owl:Class .
hpc:Batchserver a owl:Class .
hpc:Interactivequeue a owl:Class .
hpc:Batchqueue a owl:Class .
hpc:haspolicy a owl:ObjectProperty .
hpc:Usesservers rdfs:domain hpc:Interactivequeue ;
                 rdfs:range rdf:List .
hpc:Runson rdfs:domain hpc:Interactivebatchjob ;
              rdfs:range hpc:Server .
hpc:isinteractiveonly a owl:ObjectProperty ;
                        rdfs:domain hpc:Queue .
hpc:isbatchonly a owl:ObjectProperty ;
                   rdfs:domain hpc:Queue .
hpc:supportsinteractiveandbatch a owl:ObjectProperty ;
                                 rdfs:domain hpc:Queue .
hpc:isnonbatchutility a owl:DatatypeProperty ;
                         rdfs:range xsd:string .
hpc:Useslimsimpleplacementadvice rdfs:domain hpc:Interactivejob ;
                                      rdfs:range xsd:string .
hpc:submitbatchinteractivejob a owl:ObjectProperty ;
                                 rdfs:domain hpc:User ;
                                 rdfs:range rdf:Statement .
hpc:submitBatchInteractiveJobInPseudoTerminal rdfs:subPropertyOf hpc:submitBatchInteractiveJob ;
                                                     rdfs:domain hpc:User ;
                                                     rdfs:range rdf:Statement .
hpc:requiresconnectedsubmissionandexecutionhost a owl:ObjectProperty .
