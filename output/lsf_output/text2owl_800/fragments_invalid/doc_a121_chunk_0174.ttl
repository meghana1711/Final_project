hpc:Esubjob a owl:Class .
hpc:Esubexecutable a owl:Class .
hpc:Environmentvariable a owl:Class .

# Object Properties
hpc:hasexecutable a owl:ObjectProperty .
hpc:usesenvironmentvariable a owl:ObjectProperty .

# Datatype Properties
hpc:name a owl:DatatypeProperty .
hpc:value a owl:DatatypeProperty .
hpc:datatype a owl:DatatypeProperty .

# Domain and Range
hpc:Hasexecutable rdfs:domain hpc:Esubjob ;
    rdfs:range hpc:Esubexecutable .
hpc:Usesenvironmentvariable rdfs:domain hpc:Esubjob ;
    rdfs:range hpc:Environmentvariable .

# Environment Variables
hpc:LSB_SUB_PARM_FILE a hpc:EnvironmentVariable ;
    hpc:name "LSB_SUB_PARM_FILE" ;
    hpc:dataType xsd:string .
hpc:LSB_SUB_MODIFY_FILE a hpc:EnvironmentVariable ;
    hpc:name "LSB_SUB_MODIFY_FILE" ;
    hpc:dataType xsd:string .
hpc:LSB_SUB_ADDICTIONAL a hpc:EnvironmentVariable ;
    hpc:name "LSB_SUB_ADDICTIONAL" ;
    hpc:dataType xsd:string .
hpc:LSB_SUB_BEGIN_TIME a hpc:EnvironmentVariable ;
    hpc:name "LSB_SUB_BEGIN_TIME" ;
    hpc:dataType xsd:decimal .
hpc:LSB_SUB_CHKPT_DIR a hpc:EnvironmentVariable ;
    hpc:name "LSB_SUB_CHKPT_DIR" ;
    hpc:dataType xsd:string .

# Subclasses
hpc:ESubJobSubmission a hpc:ESubJob ;
    rdfs:subClassOf hpc:Esubjob .
hpc:ESubExecutablePackage a hpc:ESubExecutable ;
    rdfs:subClassOf hpc:Esubexecutable .

# Instances
hpc:esub_afs a hpc:ESubExecutablePackage ;
    hpc:name "esub.afs" .
hpc:esub_dce a hpc:ESubExecutablePackage ;
    hpc:name "esub.dce" .
hpc:esub_bproc a hpc:ESubExecutablePackage ;
    hpc:name "esub.bproc" .
hpc:esub_checkcmd a hpc:ESubExecutablePackage ;
    hpc:name "esub.checkcmd" .
hpc:esub_dprov a hpc:ESubExecutablePackage ;
    hpc:name "esub.dprov" .
hpc:esub_fluent a hpc:ESubExecutablePackage ;
    hpc:name "esub.fluent" .
hpc:esub_intelmpi a hpc:ESubExecutablePackage ;
    hpc:name "esub.intelmpi" .
hpc:esub_lammpi a hpc:ESubExecutablePackage ;
    hpc
