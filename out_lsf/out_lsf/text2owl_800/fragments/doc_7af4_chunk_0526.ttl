hpc:Lsflimit a owl:Class .
hpc:licprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range xsd:string .
hpc:haslicproject a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range rdfs:Resource .
hpc:alllicprojects a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range rdfs:List .
hpc:excludelicproject a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range rdfs:Resource .
hpc:horizontalformat a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range xsd:boolean .
hpc:verticalformat a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range xsd:boolean .
hpc:maxprojectnamelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsflimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Limitsection a owl:Class ;
    rdfs:subClassOf hpc:Lsflimit .
hpc:Projectlist a owl:Class ;
    rdfs:subClassOf rdfs:List .
hpc:Singleproject a owl:Class ;
    rdfs:subClassOf rdfs:Resource .
