hpc:Gpolicyddaemon a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the gpolicyd daemon." .

hpc:Managementhost a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a host where the gpolicyd daemon does not run with the -C option." .

hpc:Envdir a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the directory where the lsf.conf file is read by the gpolicyd daemon." .

hpc:Debugmodelevel a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the debug mode level for the gpolicyd daemon." .

hpc:Daemonerrorreporting a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the error reporting behavior of the gpolicyd daemon." .

hpc:Lsflogdir a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the directory where LSF error logs are written." .

hpc:Lsfconffile a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the lsf.conf file." .

hpc:Lsbglobalpolicies a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the lsb.globalpolicies file." .

# Object Properties
hpc:runson a owl:ObjectProperty ;
    rdfs:domain hpc:Gpolicyddaemon ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Indicates the management host on which the gpolicyd daemon runs." .

hpc:readsfrom a owl:ObjectProperty ;
    rdfs:domain hpc:Gpolicyddaemon ;
    rdfs:range hpc:Envdir ;
    rdfs:comment "Indicates the directory from which the gpolicyd daemon reads the lsf.conf file." .

hpc:setsdebuglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Gpolicyddaemon ;
    rdfs:range hpc:Debugmodelevel ;
    rdfs:comment "Indicates the debug mode level set for the gpolicyd daemon." .

hpc:writesto a owl:ObjectProperty ;
    rdfs:domain hpc:Daemonerrorreporting ;
    rdfs:range hpc:Lsflogdir ;
    rdfs:comment "Indicates the directory where error logs are written by the gpolicyd daemon." .

hpc:writesfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflogdir ;
    rdfs:range hpc:Lsfconffile ;
    rdfs:comment "Indicates the lsf.conf file written by the LSF daemons." .

hpc:monitors a owl
