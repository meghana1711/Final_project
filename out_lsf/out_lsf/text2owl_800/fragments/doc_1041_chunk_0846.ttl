hpc:Command a owl:Class .
hpc:Usageerror a owl:Class .
hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:Exclusiveresource a owl:Class .
hpc:lowerbound a owl:DatatypeProperty .
hpc:upperbound a owl:DatatypeProperty .
hpc:hostname a owl:ObjectProperty .
hpc:resourcerequirement a owl:ObjectProperty .
hpc:Commandusage rdfs:subClassOf hpc:Usageerror .
hpc:Lsfversion rdfs:subClassOf hpc:Usageerror .
hpc:Hostname rdfs:domain hpc:Command .
hpc:Resourcerequirement rdfs:domain hpc:Command .
hpc:Lowerbound rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Upperbound rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger .
