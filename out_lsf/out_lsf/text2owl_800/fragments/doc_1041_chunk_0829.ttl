hpc:Location a owl:Class .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Location ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .

hpc:hasswapspace a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:hasrunqueuelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:hastype a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:haspagingrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:hascluster a owl:ObjectProperty ;
    rdfs:domain hpc:Location ;
    rdfs:range hpc:Cluster .

hpc:Cluster a owl:Class .

hpc:adjustloadindices a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Adjustloadindices .

hpc:Adjustloadindices a owl:Class .

hpc:getload a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Load .

hpc:Load a owl:Class .

hpc:getloaddetails a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Loaddetails .

hpc:Loaddetails a owl:Class .

hpc:getloadordered a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Loadordered .

hpc:Loadordered a owl:Class .

hpc:haseffectiverunqueuelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadordered ;
    rdfs:range xsd:decimal .

hpc:hascpuutilization a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadordered ;
    rdfs:range xsd:decimal .

hpc:hasdiskio a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadordered ;
    rdfs:range xsd:decimal .

hpc:haspagingrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadordered ;
    rdfs:range xsd:decimal .
