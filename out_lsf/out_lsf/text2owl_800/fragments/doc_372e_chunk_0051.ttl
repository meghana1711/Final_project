hpc:Project a owl:Class .
hpc:Lsflicensescheduler a owl:Class .
hpc:demandlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:integer .
hpc:Feature a owl:Class ;
    rdfs:subClassOf hpc:Lsflicensescheduler .
hpc:setdemandlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Demandlimit .
hpc:preemptionaction a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler .
hpc:Lmremove a owl:Class ;
    rdfs:subClassOf hpc:Preemptionaction .
hpc:Rlmremove a owl:Class ;
    rdfs:subClassOf hpc:Preemptionaction .
hpc:isenabled a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptionaction ;
    rdfs:range xsd:boolean .
