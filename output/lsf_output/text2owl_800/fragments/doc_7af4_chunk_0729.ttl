hpc:Jobpacks a owl:Class .
hpc:lsbMaxProbeSbd a owl:DatatypeProperty .
hpc:mbdSleepTime a owl:DatatypeProperty .
hpc:jobpacksize a owl:ObjectProperty .

hpc:JobPacks
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf owl:NamedIndividual ] .

hpc:LSB_MAX_PROBE_SBD
    rdfs:domain hpc:Jobpacks ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the maximum number of sbatchd instances that can be polled by mbatchd in the interval MBD_SLEEP_TIME/10." .

hpc:MBD_SLEEP_TIME
    rdfs:domain hpc:Jobpacks ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Interval between mbatchd probes for sbatchd instances." .

hpc:JobPackSize
    rdfs:domain hpc:Jobpacks ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Set this parameter to control the job pack size for job submissions." .
