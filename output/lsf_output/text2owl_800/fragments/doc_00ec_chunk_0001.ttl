hpc:Host a owl:Class .
hpc:Queue a owl:Class .
hpc:openhost a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Openevent .
hpc:OpenEvent rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Openhost ;
    rdfs:range xsd:boolean .
hpc:queueaction a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queueactionevent .
hpc:QueueActionEvent rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queueaction ;
    rdfs:range xsd:string .
hpc:Fixlevel a owl:Class .
hpc:rollback a owl:ObjectProperty ;
    rdfs:domain hpc:Fixlevel ;
    rdfs:range hpc:Rollbackevent .
hpc:RollbackEvent rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Rollback ;
    rdfs:range xsd:string .
hpc:Resourceconnector a owl:Class .
hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Statusevent .
hpc:StatusEvent rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:boolean .
hpc:Jobevent a owl:Class .
hpc:jobfinish2 a owl:ObjectProperty ;
    rdfs:domain hpc:Jobevent ;
    rdfs:range hpc:Jobfinish2event .
hpc:JobFinish2Event rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobfinish2 ;
    rdfs:range xsd:string .
hpc:Logfile a owl:Class .
hpc:logdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .
