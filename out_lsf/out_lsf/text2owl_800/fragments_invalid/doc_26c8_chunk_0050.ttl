hpc:Resourcegroup a owl:Class .
hpc:skuname a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcegroup ;
    rdfs:range xsd:string .

hpc:Vmtype a owl:Class .
hpc:hasRestrictionsOnSkuName owl:ObjectProperty ;
    rdfs:domain hpc:Vmtype ;
    rdfs:range rdf:Resource .

hpc:Virtualnetwork a owl:Class .
hpc:belongsToResourceGroup owl:ObjectProperty ;
    rdfs:domain hpc:Virtualnetwork ;
    rdfs:range hpc:Resourcegroup .

hpc:Subnet a owl:Class .
hpc:belongsToVirtualNetwork owl:ObjectProperty ;
    rdfs:domain hpc:Subnet ;
    rdfs:range hpc:Virtualnetwork .

hpc:sshpubkeyfile a owl:DatatypeProperty .
hpc:hasSSHPubKeyFile rdf:Property .
hpc:customscripturi a owl:DatatypeProperty .
hpc:hasCustomScriptUri rdf:Property .
