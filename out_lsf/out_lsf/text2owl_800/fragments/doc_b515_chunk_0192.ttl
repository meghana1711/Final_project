    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:hasmaxslotsinpool a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:usespriorityinpool a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:hashostjobslotlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Jobslotlimit .

hpc:Jobslotlimit a owl:Class .

hpc:hasqueuebasedfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queuebasedfairshare .

hpc:Queuebasedfairshare a owl:Class .

hpc:hasslotshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuebasedfairshare ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hashosts a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
