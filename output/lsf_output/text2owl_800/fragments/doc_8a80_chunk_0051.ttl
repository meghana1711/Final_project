hpc:Distribution a owl:Class ;
  rdfs:subClassOf owl:Class .

hpc:GroupDistribution a owl:Class ;
  rdfs:subClassOf hpc:Distribution ;
  rdfs:subClassOf owl:Class .

hpc:Projectmode a owl:Class ;
  rdfs:subClassOf owl:Class .

hpc:hasdistribution a owl:ObjectProperty ;
  rdfs:domain hpc:Projectmode ;
  rdfs:range hpc:Distribution ;
  rdfs:subPropertyOf rdf:Property .

hpc:hasgroupdistribution a owl:ObjectProperty ;
  rdfs:domain hpc:Projectmode ;
  rdfs:range hpc:GroupDistribution ;
  rdfs:subPropertyOf rdf:Property .

hpc:mutuallyexclusivedistributions a owl:ObjectProperty ;
  rdfs:domain hpc:Distribution ;
  rdfs:range hpc:Distribution ;
  rdfs:subPropertyOf rdf:Property .

hpc:inuseFromRusage a owl:DatatypeProperty ;
  rdfs:domain hpc:Projectmode ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf rdf:Property .
