hpc:Lsf a owl:Class .
hpc:Fairsharecalculation a owl:Class .
hpc:Jobforwardingmode a owl:Class .
hpc:forwardedjobslotsfactor a owl:ObjectProperty .
hpc:lsfMcForwardfairsharechargeduration a owl:DatatypeProperty .

hpc:Lsf rdfs:subClassOf owl:Class .
hpc:Fairsharecalculation rdfs:subClassOf owl:Class .
hpc:Jobforwardingmode rdfs:subClassOf hpc:Fairsharecalculation .

hpc:ForwardedJobSlotsFactor rdf:type owl:ObjectProperty .
hpc:LSF_MC_ForwardFairshareChargeDuration rdf:type owl:DatatypeProperty .

hpc:Forwardedjobslotsfactor rdfs:domain hpc:Jobforwardingmode ;
                               rdfs:range xsd:decimal .
hpc:LsfMcForwardfairsharechargeduration rdfs:domain hpc:Lsf ;
                                               rdfs:range xsd:nonNegativeInteger .
