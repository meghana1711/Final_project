hpc:Bhostsformat a owl:Class .
hpc:Field a owl:Class .
hpc:Unitprefix a owl:Class .
hpc:Delimiter a owl:Class .

# Object Properties
hpc:hasUnitPrefix rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range hpc:Unitprefix .
hpc:isJustified rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string .
hpc:hasDelimiter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range xsd:string .

# Datatype Properties
hpc:name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Field .
hpc:appliesTo rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range xsd:string .

# Class and property restrictions
hpc:Fieldwithunitprefix a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    owl:onProperty hpc:hasUnitPrefix .

hpc:Leftjustifiedfield a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    owl:onProperty hpc:isJustified ;
    rdfs:value xsd:string "left" .

hpc:Rightjustifiedfield a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    owl:onProperty hpc:isJustified ;
    rdfs:value xsd:string "right" .

hpc:Fixedunitfield a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    owl:onProperty hpc:hasUnitPrefix ;
    rdfs:value xsd:string "" .

hpc:Autoadjustingunitfield a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    owl:onProperty hpc:hasUnitPrefix ;
    rdfs:value xsd:string "S" .

hpc:Bhostsformatwithdelimiter a owl:Class ;
    rdfs:subClassOf hpc:Bhostsformat ;
    owl:onProperty hpc:hasDelimiter .

hpc:Bhostsformatwithdelimiterandunitfields a owl:Class ;
    rdfs:subClassOf hpc:Bhostsformatwithdelimiter ;
    rdfs:subClassOf hpc:Bhostsformat ;
    rdfs:subClassOf hpc:Bhostsformatwithunitfields .

hpc:Bhostsformatwithunitfields a owl:Class ;
    rdfs:subClassOf hpc:Bhostsformat ;
    rdfs:subClassOf hpc:Bhostsformatwithfields ;
    rdfs:subClassOf hpc:Bhostsformatwithunitprefixes .

hpc:Bhostsformatwithfields a owl:Class ;
    rdfs:subClassOf hpc:Bhostsformat ;
    rdfs:subClass
