hpc:MailTypeEnum "TIME=80%" .
hpc:MailTypeEnum "TIME=50%" .
hpc:MailTypeEnum "STAGE_OUT" .
hpc:MailTypeEnum "ARRAY_TASKS" .
hpc:MailTypeEnum "INVALID_DEPENDENCY" .

