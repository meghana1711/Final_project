hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:suspendreason a owl:ObjectProperty .
hpc:Suspendreason rdfs:domain hpc:Suspendedjob ;
                   rdfs:range rdf:List .
hpc:Suspendreasonmember a owl:Class ;
                         rdfs:subClassOf xsd:string .
hpc:pendingsuspendreason a owl:DatatypeProperty ;
                          rdfs:domain hpc:Suspendedjob ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Host a owl:Class .
hpc:loadthreshold a owl:DatatypeProperty ;
                    rdfs:domain hpc:Suspendedjob .
hpc:Schedulingparameter a owl:Class .
hpc:Postdonestate a owl:Class .
hpc:Posterrstate a owl:Class .
hpc:bjobscommand a owl:ObjectProperty .
hpc:bhistcommand a owl:ObjectProperty .
