    rdfs:range xsd:decimal .
hpc:TRun-W rdfs:domain hpc:LsbSubRlimi ;
    rdfs:range xsd:nonNegativeInteger .
hpc:TStack-S rdfs:domain hpc:LsbSubRlimi ;
    rdfs:range xsd:decimal .
hpc:TSwap-v rdfs:domain hpc:LsbSubRlimi ;
    rdfs:range xsd:decimal .
hpc:TThread-T rdfs:domain hpc:LsbSubRlimi ;
    rdfs:range xsd:nonNegativeInteger .

