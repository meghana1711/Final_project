@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Cachetimeoutvalue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The Cache Timeout Value for the WINS Lookup of the DNS." .

hpc:hascachetimeoutvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Cachetimeoutvalue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The actual cache timeout value." .

hpc:recommendedcachetimeoutvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Cachetimeoutvalue ;
    rdfs:range xsd:nonNegativeInteger ;
