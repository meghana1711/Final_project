hpc:LsbDjobPeNetwork a owl:Class .
hpc:hasNetworkResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsbDjobPeNetwork ;
    rdfs:range xsd:string .

hpc:LsbDjobNumproc a owl:Class .
hpc:numProcessors rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbDjobNumproc ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LsbDjobRankfile a owl:Class .
hpc:rankFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsbDjobRankfile ;
    rdfs:range xsd:string .

hpc:LsbDjobTaskBind a owl:Class .
hpc:taskBind rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbDjobTaskBind ;
    rdfs:range xsd:string .
