hpc:Stagedfile rdfs:range xsd:string .

hpc:Hassourcedirectory rdfs:domain hpc:Stagedfile .
hpc:Hassourcedirectory rdfs:range hpc:Directory .

hpc:datarequirementpath a owl:DatatypeProperty .
