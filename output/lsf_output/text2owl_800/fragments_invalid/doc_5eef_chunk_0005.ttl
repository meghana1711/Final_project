hpc:File a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:unionOf (hpc:DataFile hpc:DataSpecificationFile hpc:Folder)
    ] ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:onProperty hpc:hasPath
    ] ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of files must contain absolute paths to the required source files." .

hpc:Dataspecificationfile a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:onProperty hpc:isSpecification
    ] ;
    rdfs:subClassOf hpc:File ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The first line of a data specification file must be #@dataspec." .

hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                        owl:onProperty hpc:isDataRequirement
    ] ;
    rdfs:subClassOf hpc:Requirement ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The data requirement that is a folder must contain an absolute path to the folder." .

hpc:haspath a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string ;
    rdfs:comment "The path to the required source file." .

hpc:isspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the file is a data specification file." .

hpc:isdatarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the requirement is a data requirement." .

hpc:isfolder a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the data requirement is a folder." .

hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "The host that LSF attempts to stage the required data file from." .

hpc:supportscolon a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the colon character (:) is supported in the path of a job requirement." .

