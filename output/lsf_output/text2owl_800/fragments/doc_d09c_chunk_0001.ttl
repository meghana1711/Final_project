hpc:Lsfqueue a owl:Class.
hpc:Lsfqueue rdfs:subClassOf hpc:Lsfjob.

hpc:nicevalue a owl:DatatypeProperty;
    rdfs:domain hpc:Lsfqueue;
    rdfs:range xsd:integer.

hpc:ignoreniceload a owl:ObjectProperty;
    rdfs:domain hpc:Lsfqueue;
    rdfs:range xsd:integer.

hpc:Optimizedlsfjob a owl:Class;
    rdfs:subClassOf hpc:Lsfjob.

hpc:hasnicevalue a owl:ObjectProperty;
    rdfs:domain hpc:Lsfqueue;
    rdfs:range hpc:Nicevalue.

hpc:hasignoreniceload a owl:ObjectProperty;
    rdfs:domain hpc:Lsfqueue;
    rdfs:range hpc:Ignoreniceload.
