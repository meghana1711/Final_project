# Job Info
hpc:JobInfo a owl:Class .
hpc:lastBackfill rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .
hpc:lastUpdate rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .

# Job
hpc:Job a owl:Class .
hpc:exitCode rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:derivedExitCode rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:memory rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

# OpenAPI Job Info Response
hpc:OpenAPIJobInfoResp a owl:Class .
hpc:lastBackfill rdfs:domain hpc:OpenAPIJobInfoResp ;
    rdfs:range xsd:string .
hpc:lastUpdate rdfs:domain hpc:OpenAPIJobInfoResp ;
    rdfs:range xsd:string .

# Associations
hpc:Assoc a owl:Class .
hpc:accounting rdfs:domain hpc:Assoc ;
    rdfs:range xsd:string .
hpc:id rdfs:domain hpc:Assoc ;
    rdfs:range xsd:string .
hpc:comment rdfs:domain hpc:Assoc ;
    rdfs:range xsd:string .

# OpenAPI Accounts Association
hpc:OpenAPIAccountsAddCondRespStr a owl:Class .
hpc:OpenAPIAccountsAddCondResp a owl:Class .
hpc:paths rdfs:domain hpc:OpenAPIAccountsAddCondRespStr ;
    rdfs:range xsd:string .
.paths rdfs:domain hpc:OpenAPIAccountsAddCondResp ;
    rdfs:range xsd:string .

# OpenAPI Users Association
hpc:OpenAPIUsersAddCondRespStr a owl:Class .
hpc:OpenAPIUsersAddCondResp a owl:Class .
hpc:paths rdfs:domain hpc:OpenAPIUsersAddCondRespStr ;
    rdfs:range xsd:string .
.paths rdfs:domain hpc:OpenAPIUsersAddCondResp ;
    rdfs:range xsd:string .

# Step
hpc:Step a owl:Class .
hpc:step rdfs:domain hpc:Step ;
    rdfs:range xsd:string .

# Associations (Removed usage field)
hpc:Assoc a owl:Class .
hpc:
