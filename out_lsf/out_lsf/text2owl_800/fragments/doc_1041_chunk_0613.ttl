hpc:MandatoryExtsched a owl:Class .
hpc:Limit a owl:Class .
hpc:Io a owl:Class .
hpc:fileLimit a owl:DatatypeProperty .
hpc:localFile a owl:ObjectProperty .
hpc:remoteFile a owl:ObjectProperty .
hpc:operator a owl:ObjectProperty .
hpc:MandatoryExtsched rdfs:subClassOf hpc:Queue .
hpc:Limit rdfs:subClassOf hpc:Job .
hpc:Io rdfs:subClassOf hpc:Job .
rdfs:domain(hpc:FileLimit) hpc:Job .
rdfs:range(hpc:FileLimit) xsd:integer .
rdfs:domain(hpc:LocalFile) hpc:Job .
rdfs:domain(hpc:RemoteFile) hpc:Job .
rdfs:domain(hpc:Operator) hpc:Job .
