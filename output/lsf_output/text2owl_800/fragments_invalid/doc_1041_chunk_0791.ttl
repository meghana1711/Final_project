hpc:Lsfdaemon a owl:Class .
hpc:lsfrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemon ;
    rdfs:range xsd:string .
hpc:lsfshutdown a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemon ;
    rdfs:range xsd:string .
hpc:lsfstartup a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemon ;
    rdfs:range xsd:string .
hpc:setuidbit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:enablesetuidbit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:boolean .
hpc:forcemode a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:boolean .
hpc:pdsh a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:boolean .
hpc:delay a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfdaemon a rdfs:subClassOf hpc:Lsfmanagementhost .
hpc:Lsfcandidate a rdfs:subClassOf hpc:Lsfmanagementhost .
hpc:Lsfcommand a owl:Class .
