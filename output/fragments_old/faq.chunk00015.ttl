hpc:CoreFile a owl:Class .
hpc:CoreFileLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:CoreFile ;
    rdfs:range xsd:integer .

hpc:SoftLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:CoreFile ;
    rdfs:range xsd:integer .

hpc:HardLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:CoreFile ;
    rdfs:range xsd:integer .

hpc:PropagateResourceLimits a owl:ObjectProperty .
    rdfs:domain hpc:System ;
    rdfs:range hpc:CoreFile .

hpc:SlurmUser a owl:Class .

# Backtrace
hpc:Backtrace a owl:Class .

hpc:Binary a owl:Class .
hpc:CoreFile a rdfs:subClassOf hpc:Backtrace .

hpc:Gdb a owl:Class .
hpc:GdbBacktrace a owl:ObjectProperty ;
    rdfs:domain hpc:Gdb ;
    rdfs:range hpc:Backtrace .

hpc:SlurmBinary a owl:Class ;
    rdfs:subClassOf hpc:Binary .

hpc:RunningDaemon a owl:Class .

# Error Messages
hpc:CredentialReplayed a owl:Class .
hpc:DiskProblem a owl:Class .
hpc:NISProblem a owl:Class .
hpc:PrologScriptProblem a owl:Class .
hpc:InvalidJobCredential a owl:Class .
hpc:TaskLaunchFailed a owl:Class .
hpc:TooManyOpenFiles a owl:Class .
hpc:SlurmdDebugFailure a owl:Class .
hpc:BatchJobMissing a owl:Class .
hpc:MultiInstanceGPUProblem a owl:Class .
```
