hpc:UncompressedCommunication a owl:Class .
hpc:NoProtectionAgainstMitmAttacks a owl:Class .
hpc:NoProtectionAgainstReplayAttacks a owl:Class .
hpc:TlsV13Communication a owl:Class .
hpc:Monitoring a owl:Class .
