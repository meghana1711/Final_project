hpc:Dataprovenancescript a owl:Class .
hpc:dataprovenancescriptlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataprovenancescript ;
    rdfs:range xsd:string .

hpc:Dataprovenancescriptfile a owl:Class ;
    rdfs:subClassOf hpc:Dataprovenancescript .

# Job Spooling
hpc:Jobspooling a owl:Class .
hpc:jobspoolingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobspooling ;
    rdfs:range xsd:string .

hpc:Jobcommandfilespooling a owl:Class ;
    rdfs:subClassOf hpc:Jobspooling .

# Job Submission Option Files
hpc:Jobsubmissionoptionfile a owl:Class .

# Remote File Access
hpc:Remotefileaccess a owl:Class .
hpc:remotefileaccesswithnonsharedfilespace a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotefileaccess ;
    rdfs:range xsd:boolean .

# Job Command File (bsub -Zs)
hpc:Jobcommandfile a owl:Class ;
    rdfs:subClassOf hpc:Remotefileaccess .
