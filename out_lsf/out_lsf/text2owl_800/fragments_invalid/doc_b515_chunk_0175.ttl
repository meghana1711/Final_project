hpc:Job a owl:Class .
hpc:Historicalruntime a owl:Class .
hpc:Decayedruntime a owl:Class .
hpc:elapsedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:histhours a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runtimedecay a owl:ObjectProperty ;
    rdfs:domain (hpc:Queue | hpc:Cluster) ;
    rdfs:range xsd:boolean .
hpc:CPU_TIME_FACTOR a xsd:float .
hpc:RUN_TIME_FACTOR a xsd:float .
hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:number_CPUs a xsd:nonNegativeInteger .
hpc:RUN_JOB_FACTOR a xsd:float .
