hpc:Logfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a log file in the LSF system." .

hpc:daemonname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the daemon associated with the log file." .

hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The host name associated with the log file." .

hpc:logfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The location of the log file." .

hpc:DefaultLogFile a owl:NamedIndividual ;
    hpc:LogFileLocation rdf:nil ;
    rdfs:comment "The default LSF system log file in the LSF system log file directory." .

hpc:createlogfileoninvalidpath a owl:ObjectProperty ;
    rdfs:domain hpc:Logfilelocation ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where the log file is created if the specified path is not valid." .

hpc:CreateLogFileOnUnix a owl:NamedIndividual ;
    hpc:CreateLogFileOnInvalidPath rdf:uri("http://example.org/hpc#/tmp") .

hpc:CreateNoLogFileOnWindows a owl:NamedIndividual ;
    rdf:type owl:Thing ;
    rdfs:comment "No log file is created if the specified path is not valid on Windows." .

hpc:turnofftemporarydebugsettings a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:comment "Turns off temporary debug settings and resets them to the daemon starting state." .

hpc:resetmessageloglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "Resets the message log level back to the value of LS_LOG_MASK." .

hpc:resetclasses a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Resets classes to the value of LSB_DEBUG_BLD." .

hpc:resetdefaultlogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:comment "Resets the log file to the default log file." .

hpc:blcdebug a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range hpc:Debugcommand ;
    rdfs:comment "Sets the message log level for the blcollect command." .

hpc:debuglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Debugcommand ;
    rdfs:range xsd:integer ;
