hpc:Job a owl:Class .
hpc:jobstate a owl:ObjectProperty .
hpc:Node a owl:Class .
hpc:nodestate a owl:ObjectProperty .
hpc:reason a owl:DatatypeProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:requeuecommand a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Jobstate rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Node rdfs:subClassOf owl:Class .
hpc:Nodestate rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:Reason rdfs:domain hpc:Jobstate ;
    rdfs:range xsd:string .
hpc:Jobid rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Requeuecommand rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
