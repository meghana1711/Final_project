hpc:Total a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:License a owl:Class ;
    rdfs:subClassOf hpc:Total .

hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range rdf:List ;
        rdf:first hpc:project_name rdf:Datatype ;
        rdf:rest rdf:List .

hpc:percentage a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:decimal .

hpc:numberlicensesowned a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:nonNegativeInteger .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:localto a owl:ObjectProperty .

hpc:lmLicenseName a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Clusterlocality a owl:Class ;
    rdfs:subClassOf hpc:License .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterlocality .

hpc:Cluster a owl:Class .

hpc:Feature a owl:Class ;
    rdfs:subClassOf hpc:License .

hpc:tokenname a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature .
