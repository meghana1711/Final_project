hpc:Multiclusterjobforwardingmode a owl:Class .
hpc:jobpendingtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Multiclusterjobforwardingmode ;
    rdfs:range xsd:string .
hpc:Hourminute a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:hourminutevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Hourminute ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Joblevelpendingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Multiclusterjobforwardingmode .
hpc:Applicationlevelpendingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Multiclusterjobforwardingmode .
hpc:Queuelevelpendingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Multiclusterjobforwardingmode .
hpc:Pjoblimit a owl:Class ;
    rdfs:subClassOf owl:Real .
hpc:plan a owl:ObjectProperty ;
    rdfs:domain hpc:Multiclusterjobforwardingmode ;
    rdfs:range xsd:boolean .
