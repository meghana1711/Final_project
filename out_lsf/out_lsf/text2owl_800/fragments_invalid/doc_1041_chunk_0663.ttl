hpc:Jobforwardingmodel a owl:Class .
hpc:LSFMulticluster a subClassOf hpc:JobForwardingModel .
hpc:Remotehost a owl:Class .
hpc:Remotehost rdfs:subClassOf hpc:Host .
hpc:Remotehost rdfs:range xsd:string .
hpc:hasremotehost a owl:ObjectProperty .
hpc:Hasremotehost rdfs:domain hpc:Jobforwardingmodel .
hpc:Hasremotehost rdfs:range hpc:Remotehost .
hpc:Firstexecutionhostcandidates a owl:Class .
hpc:Firstexecutionhostcandidates rdfs:subClassOf hpc:Host .
hpc:Firstexecutionhostcandidates rdfs:range xsd:string .
hpc:hasfirstexecutionhostcandidates a owl:ObjectProperty .
hpc:Hasfirstexecutionhostcandidates rdfs:domain hpc:Jobforwardingmodel .
hpc:Hasfirstexecutionhostcandidates rdfs:range hpc:Firstexecutionhostcandidates .
hpc:preferenceorder a owl:ObjectProperty .
hpc:Preferenceorder rdfs:domain hpc:Remotehost .
hpc:Preferenceorder rdfs:range hpc:Remotehost .
hpc:ParallelJob a subClassOf hpc:Job .
hpc:Paralleljob rdfs:subClassOf hpc:Job .
hpc:Firstexecutionhost a owl:Class .
hpc:Firstexecutionhost rdfs:subClassOf hpc:Host .
hpc:Firstexecutionhost rdfs:range xsd:string .
hpc:hasfirstexecutionhost a owl:ObjectProperty .
hpc:Hasfirstexecutionhost rdfs:domain hpc:Paralleljob .
hpc:Hasfirstexecutionhost rdfs:range hpc:Firstexecutionhost .
hpc:Queuelevelcandidates a owl:Class .
hpc:Queuelevelcandidates rdfs:subClassOf hpc:Host .
hpc:Queuelevelcandidates rdfs:range xsd:string .
hpc:queuelevelcandidatesoverriddenby a owl:ObjectProperty .
hpc:Queuelevelcandidatesoverriddenby rdfs:domain hpc:Job .
hpc:Queuelevelcandidatesoverriddenby rdfs:range hpc:Queuelevelcandidates .
