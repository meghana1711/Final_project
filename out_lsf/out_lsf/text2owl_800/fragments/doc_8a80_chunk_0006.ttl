hpc:Project a owl:Class .
hpc:Job a owl:Class .
hpc:Cluster a owl:Class .
hpc:Demand a owl:Class .
hpc:rusagevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:pendingreason a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:demandlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Distributionpolicyviolationaction a owl:Class .
hpc:reportingperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Distributionpolicyviolationaction ;
    rdfs:range xsd:nonNegativeInteger .
hpc:reportingcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Distributionpolicyviolationaction ;
    rdfs:range xsd:string .
hpc:potentialdemand a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Demand .
hpc:actualdemand a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Demand .
hpc:projectmode a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Project .
hpc:Lsflicensescheduler a owl:Class .
hpc:slotavailable a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:boolean .
hpc:limit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:decimal .
hpc:schedulingconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:string .
hpc:Distributionpolicyviolation a owl:Class ;
    rdfs:subClassOf hpc:Nonlsfworkload .
hpc:Nonlsfworkload a owl:Class .
