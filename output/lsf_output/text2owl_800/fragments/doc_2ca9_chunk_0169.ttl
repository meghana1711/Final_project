hpc:Jobtimelimit a owl:Class .
hpc:Jobleveltimelimit a owl:Class .

hpc:overrides a owl:ObjectProperty .
hpc:Jobleveltimelimit rdfs:subClassOf hpc:Jobtimelimit .
hpc:Applicationleveltimelimit rdfs:subClassOf hpc:Jobtimelimit .
hpc:Queueleveltimelimit rdfs:subClassOf hpc:Jobtimelimit .
hpc:Overrides rdfs:domain hpc:Jobtimelimit ;
                          rdfs:range hpc:Jobtimelimit .

# Job Time Tracking
hpc:pendingtimelimit a owl:DatatypeProperty .
hpc:eligiblependingtimelimit a owl:DatatypeProperty .
hpc:plimitremain a owl:DatatypeProperty .
hpc:eplimitremain a owl:DatatypeProperty .

hpc:effectiveplimit a owl:DatatypeProperty .
hpc:effectiveeplimit a owl:DatatypeProperty .

hpc:Pendingtimelimit rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Eligiblependingtimelimit rdfs:domain hpc:Job ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:Plimitremain rdfs:domain hpc:Job ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Eplimitremain rdfs:domain hpc:Job ;
                    rdfs:range xsd:nonNegativeInteger .

hpc:Effectiveplimit rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Effectiveeplimit rdfs:domain hpc:Job ;
                        rdfs:range xsd:nonNegativeInteger .

# Job Scheduling and Execution
hpc:Strictoutputrules a owl:Class .
hpc:Newfeatures a owl:Class .

hpc:Strictoutputrules rdfs:subClassOf hpc:Newfeatures .
