hpc:Paralleljob a owl:Class .
hpc:perjobhostlimit a owl:ObjectProperty .
hpc:minimumrequestedslots a owl:DatatypeProperty .
hpc:Jobpending a owl:Class .
hpc:Falseschedulingfailure a owl:Class .
hpc:Resourceallocation a owl:Class .
hpc:Validallocation a owl:Class .
hpc:ptilespecification a owl:ObjectProperty .
hpc:orderslots a owl:ObjectProperty .
hpc:Processorreservation a owl:Class .
hpc:Competingsequentialjobs a owl:Class .
hpc:immediateslottakeover a owl:ObjectProperty .
hpc:availableslots a owl:DatatypeProperty .

hpc:Paralleljob rdfs:subClassOf owl:Class .
hpc:Perjobhostlimit rdfs:domain hpc:Paralleljob ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Minimumrequestedslots rdfs:domain hpc:Paralleljob ;
                           rdfs:range xsd:nonNegativeInteger .
hpc:Jobpending rdfs:subClassOf hpc:Paralleljob .
hpc:Falseschedulingfailure rdfs:subClassOf hpc:Jobpending .
hpc:Resourceallocation rdfs:subClassOf owl:Class .
hpc:Validallocation rdfs:subClassOf hpc:Resourceallocation .
hpc:Ptilespecification rdfs:domain hpc:Paralleljob ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:Orderslots rdfs:domain hpc:Paralleljob .
hpc:Processorreservation rdfs:subClassOf owl:Class .
hpc:Competingsequentialjobs rdfs:subClassOf owl:Class .
hpc:Immediateslottakeover rdfs:domain hpc:Competingsequentialjobs ;
                           rdfs:range hpc:Slot .
hpc:Availableslots rdfs:domain hpc:Host ;
                     rdfs:range xsd:nonNegativeInteger .
