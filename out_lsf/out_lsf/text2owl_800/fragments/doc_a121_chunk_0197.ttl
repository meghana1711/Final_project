hpc:Resumeaction a owl:Class .
hpc:resumecond a owl:ObjectProperty .
hpc:Loadindex a owl:Class .
hpc:pagingrate a owl:DatatypeProperty .
hpc:interactiveidletime a owl:DatatypeProperty .
hpc:PagingRateThreshold a rdfs:Datatype .
hpc:PG_SUSP_IT a rdfs:Datatype .

hpc:Resumeaction rdfs:subClassOf owl:Thing .
hpc:Resumecond rdfs:domain hpc:Resumeaction ;
                 rdfs:range xsd:boolean .
hpc:Loadindex rdfs:subClassOf owl:Thing .
hpc:Pagingrate rdfs:domain hpc:Loadindex ;
                rdfs:range xsd:nonNegativeInteger .
hpc:Interactiveidletime rdfs:domain hpc:Loadindex ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:PagingRateThreshold rdf:type xsd:nonNegativeInteger .
hpc:PG_SUSP_IT rdf:type xsd:nonNegativeInteger .
