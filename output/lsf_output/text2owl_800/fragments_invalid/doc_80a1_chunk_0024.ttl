hpc:samplerate a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:decimal .

hpc:Trainingsettings a owl:Class .

hpc:regressionalgorithms a owl:ObjectProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first hpc:Regressionalgorithm ;
    rdfs:range rdf:rest hpc:Regressionalgorithm .

hpc:Regressionalgorithm a owl:Class .

hpc:classificationalgorithms a owl:ObjectProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first hpc:Classificationalgorithm ;
    rdfs:range rdf:rest hpc:Classificationalgorithm .

hpc:Classificationalgorithm a owl:Class .

hpc:rankingMetricRegression a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:string .

hpc:rankingMetricClassification a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:string .

hpc:transformers a owl:ObjectProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first xsd:string ;
    rdfs:range rdf:rest xsd:string .

hpc:holdOutThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:decimal .

hpc:tShirtSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:string .

hpc:trainingpodresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Trainingsettings ;
    rdfs:range xsd:string .

hpc:Trainingsettings a owl:Class .

hpc:Transformer a owl:Enum ;
    rdfs:subClassOf owl:Thing ;
    rdfs:member "sum" ;
    rdfs:member "max" .
