hpc:Preemptablejob a owl:Class .

hpc:nopreemptinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:nopreemptfinishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range ( xsd:nonNegativeInteger | xsd:decimal ) ;
    rdfs:subPropertyOf hpc:NoPreemptInterval .

hpc:nopreemptruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range ( xsd:nonNegativeInteger | xsd:decimal ) .

hpc:Preemptablejobpreemptionoverrides a owl:Class ;
    rdfs:subClassOf hpc:Preemptablejob .

hpc:haslsbapplicationsoverrides a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptablejobpreemptionoverrides ;
    rdfs:range hpc:Lsbapplications .
