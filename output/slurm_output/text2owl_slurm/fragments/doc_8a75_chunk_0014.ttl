hpc:Tasknode a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:ComputeNode rdfs:subClass hpc:TaskNode ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Tasknode ] .

hpc:environmentvariable a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasknode ;
    rdfs:range xsd:string .

hpc:pluginfunction a owl:ObjectProperty ;
    rdfs:domain hpc:Tasknode .

hpc:spank a owl:ObjectProperty ;
    rdfs:domain hpc:Tasknode .

hpc:workby a owl:ObjectProperty ;
    rdfs:domain hpc:Tasknode ;
    rdfs:range [ rdf:type owl:Class ;
                   rdfs:subClassOf owl:NamedIndividual ] .
