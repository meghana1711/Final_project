hpc:SlurmNode a owl:Class .
hpc:SlurmPartition a owl:Class .
hpc:SlurmDaemon a owl:Class .
hpc:SlurmCTLD a owl:Class, rdfs:subClassOf hpc:SlurmDaemon .
hpc:Slurmd a owl:Class, rdfs:subClassOf hpc:SlurmDaemon .
hpc:SlurmStepD a owl:Class, rdfs:subClassOf hpc:SlurmDaemon .

hpc:hasPartition a owl:ObjectProperty .
hpc:isConfigured a owl:ObjectProperty .
hpc:hasSlurmdTimeout a owl:DatatypeProperty, rdfs:domain hpc:Slurmd; rdfs:range xsd:nonNegativeInteger .

hpc:DrainedState a owl:Class .
hpc:DrainReason a owl:DatatypeProperty, rdfs:domain hpc:DrainedState; rdfs:range xsd:string .

hpc:HealthCheckTool a owl:Class .
hpc:hasIntegration a owl:ObjectProperty, rdfs:domain hpc:HealthCheckTool .

hpc:CommunicationHierarchy a owl:Class .
hpc:hasMessageRouting a owl:ObjectProperty, rdfs:domain hpc:CommunicationHierarchy .

hpc:MemoryExhaustedState a owl:Class .
```
