### Taxonomy (rdfs:subClassOf)
hpc:node rdfs:subClassOf hpc:slurm .
hpc:account rdfs:subClassOf hpc:wckey .
hpc:task rdfs:subClassOf hpc:network .
hpc:account rdfs:subClassOf hpc:adminlevel .
hpc:compute_node rdfs:subClassOf hpc:kernel .
hpc:pmix rdfs:subClassOf hpc:openmpi .
hpc:plugin rdfs:subClassOf hpc:server .
hpc:core rdfs:subClassOf hpc:processor .
hpc:gres rdfs:subClassOf hpc:gpu .
hpc:queue rdfs:subClassOf hpc:heterogeneousjob .
hpc:schedul rdfs:subClassOf hpc:job .
hpc:select_cons_tres_plugin rdfs:subClassOf hpc:generic_resourc .
hpc:resourc rdfs:subClassOf hpc:consumableresource .
hpc:slurm_daemon rdfs:subClassOf hpc:slurm_librari .
hpc:src rdfs:subClassOf hpc:testsuite .
hpc:user rdfs:subClassOf hpc:multiplejob .
hpc:slurmd rdfs:subClassOf hpc:rout_queue .
hpc:connection rdfs:subClassOf hpc:multiinstancegpu .
hpc:backfill rdfs:subClassOf hpc:builtin .
hpc:heterogeneousjob rdfs:subClassOf hpc:burst_buffer .

### Properties (axioms)
hpc:configures a owl:ObjectProperty ;
  rdfs:label "configures"
  ; rdfs:domain hpc:task
  ; rdfs:range hpc:rout_queue
 .

hpc:part_of a owl:ObjectProperty ;
  rdfs:label "part_of"
  ; rdfs:domain hpc:runn_jobs
  ; rdfs:range hpc:slurm_plugin_api
 .

hpc:uses_resource a owl:ObjectProperty ;
  rdfs:label "uses_resource"
  ; rdfs:domain hpc:docker
  ; rdfs:range hpc:job
 .
