hpc:Benchmarkingapplication a owl:Class .
hpc:Powerusageprediction a owl:Class .
hpc:Cpufrequencymanagement a owl:Class .
hpc:cpufrequency a owl:ObjectProperty ;
    rdfs:domain hpc:Cpufrequencymanagement ;
    rdfs:range xsd:integer .
hpc:lsfManageFrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Systemconfiguration .
hpc:Powerstatemanagement a owl:Class .
hpc:Hostpowerstatemanagement a owl:Class ;
    rdfs:subClassOf hpc:Powerstatemanagement .
hpc:Workloaddrivenpowermanagement a owl:Class ;
    rdfs:subClassOf hpc:Hostpowerstatemanagement .
hpc:LsfEnergyawarescheduling a owl:Class ;
    rdfs:subClassOf hpc:Hostpowerstatemanagement .
hpc:Powermanagementpolicy a owl:Class .
hpc:powermanagementfeatures a owl:ObjectProperty ;
    rdfs:domain hpc:Powermanagementpolicy ;
    rdfs:range xsd:string .
hpc:Powerstate a owl:Class .
hpc:poweron a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpowerstatemanagement ;
    rdfs:range hpc:Powerstate .
hpc:poweroff a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpowerstatemanagement ;
    rdfs:range hpc:Powerstate .
hpc:Powermanagementaction a owl:Class .
hpc:Pstates a owl:Class .
hpc:Cstates a owl:Class .
hpc:Systemrequirement a owl:Class .
hpc:Computenode a owl:Class .
hpc:pstatesandcstatesenabled a owl:ObjectProperty ;
    rdfs:domain hpc:Systemrequirement ;
    rdfs:range hpc:Computenode .
