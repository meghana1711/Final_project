@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Cluster a owl:Class.
hpc:Account a owl:Class.
hpc:User a owl:Class.
hpc:addaccount a owl:ObjectProperty.
hpc:adduser a owl:ObjectProperty.
hpc:Accountoptions a owl:Class.
hpc:Clusteroptions a owl:Class.
hpc:Useroptions a owl:Class.
hpc:name a owl:DatatypeProperty.
hpc:description a owl:DatatypeProperty.
hpc:organization a owl:DatatypeProperty.
hpc:parent a owl:ObjectProperty.
hpc:Cluster a rdfs:subClassOf hpc:Clusteroptions.
hpc:Account a rdfs:subClass
