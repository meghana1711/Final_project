hpc:Queuename a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Quit a owl:Class .

hpc:Rcerror a owl:Class ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:comment "An error operation with optional time and provider." ;
    rdfs:domain hpc:Rcerror ;
    rdfs:range [ rdf:Seq ;
        rdfs:first hpc:Time ;
        rdfs:rest [ rdf:Seq ;
            rdfs:first hpc:TimeUnit ;
            rdfs:rest hpc:Provider ]
    ] .

hpc:Timeunit a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:range xsd:string .

hpc:Provider a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Rcview a owl:Class ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:comment "A view operation with optional JSON, instances, policies, templates, and provider." ;
    rdfs:domain hpc:Rcview ;
    rdfs:range [ rdf:Seq ;
        rdfs:first ( hpc:JSON | hpc:Instances | hpc:Policies | hpc:Templates ) ;
        rdf:rest ( hpc:Provider | rdf:nil )
    ] .

hpc:Json a owl:Class ;
    rdfs:subClassOf xsd:boolean .

hpc:Reconfigure a owl:Class ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:comment "A reconfiguration operation with optional verbose and force flags." .

hpc:Reconfigureverbose a owl:Class ;
    rdfs:subClassOf xsd:boolean .

hpc:Reconfigureforce a owl:Class ;
    rdfs:subClassOf xsd:boolean .

hpc:Sbddebug a owl:Class ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:comment "A debug operation with optional class name, debug level, log file name, output flag, and host name." ;
    rdfs:domain hpc:Sbddebug ;
    rdfs:range [ rdf:Seq ;
        rdfs:first hpc:ClassName ;
        rdf:rest [ rdf:Seq ;
            rdfs:first hpc:DebugLevel ;
            rdf:rest [ rdf:Seq ;
                rdfs:first hpc:LogFileName ;
                rdf:rest [ rdf:Seq ;
                    rdfs:first hpc:Output ;
                    rdf:rest hpc:HostName
                ]
            ]
        ]
    ] .

hpc:Debuglevel a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Logfilename a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Output a
