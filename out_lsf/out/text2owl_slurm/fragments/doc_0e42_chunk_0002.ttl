hpc:Slurmrestdaccount a owl:Class .
hpc:Slurmrestdgroup a owl:Class .
hpc:Slurmrestdservice a owl:Class .
hpc:useraccountnotroot a owl:ObjectProperty .
hpc:useraccountnotslurmuser a owl:ObjectProperty .
hpc:useraccountnotusedbyrealusers a owl:ObjectProperty .
hpc:useraccountnospecialpermissions a owl:ObjectProperty .
hpc:Slurmrestduser rdfs:domain hpc:Slurmrestdaccount ;
    rdfs:range xsd:string ;
    rdfs:subClassOf hpc:Useraccountnotroot ;
    rdfs:subClassOf hpc:Useraccountnotslurmuser ;
    rdfs:subClassOf hpc:Useraccountnotusedbyrealusers ;
    rdfs:subClassOf hpc:Useraccountnospecialpermissions .

hpc:slurmrestdgroupmember a owl:ObjectProperty .
hpc:Slurmrestdserviceuser rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range hpc:Slurmrestdaccount .

hpc:slurmrestdsocket a owl:DatatypeProperty .
hpc:Slurmrestdsocket rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .

hpc:slurmrestdservicesocketpath a owl:DatatypeProperty .
hpc:Slurmrestdservicesocketpath rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .

hpc:slurmrestdservicelistenport a owl:DatatypeProperty .
hpc:Slurmrestdservicelistenport rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:integer .

hpc:slurmrestdserviceexecstart a owl:ObjectProperty .
hpc:Slurmrestdserviceexecstart rdfs:domain hpc:Slurmrestdservice .
