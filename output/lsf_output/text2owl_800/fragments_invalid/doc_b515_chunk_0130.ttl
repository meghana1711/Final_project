hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hasstarttime ;
    rdfs:subClassOf hpc:Hasendtime ;
    rdfs:subClassOf hpc:Hasuserorgroup ;
    rdfs:subClassOf (hpc:Hasname rdf:type owl:DatatypeProperty) ;
    rdfs:subClassOf (hpc:Hasdescription rdf:type owl:DatatypeProperty) ;
    rdfs:domain hpc:Reservation hpc:Hasstarttime .
    rdfs:domain hpc:Reservation hpc:Hasendtime .
    rdfs:domain hpc:Reservation hpc:Hasuserorgroup .
    rdfs:domain hpc:Reservation hpc:Hasname .
    rdfs:domain hpc:Reservation hpc:Hasdescription .
    rdfs:range xsd:time hpc:Hasstarttime .
    rdfs:range xsd:time hpc:Hasendtime .
    rdfs:range xsd:string hpc:Hasuserorgroup .
    rdfs:range xsd:string hpc:Hasname .
