    rdfs:domain hpc:SchedulingLogic ;
    rdfs:range xsd:nonNegativeInteger .

hpc:job a owl:Class .

hpc:sched_min_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:SchedulingLogic ;
    rdfs:range xsd:nonNegativeInteger .

hpc:SlurmCluster a owl:Class .

hpc:bf_max_job_test a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bf_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bf_min_age_reserve a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bf_resolution a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bf_yield_interval a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:partition a owl:Class .
hpc:partition_job_depth a owl:DatatypeProperty ;
    rdfs:domain hpc:partition ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bf_max_job_user a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:batch_sched_delay a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Slurmctld a owl:Class .
hpc:conmgr_threads a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range xsd:nonNegativeInteger .
