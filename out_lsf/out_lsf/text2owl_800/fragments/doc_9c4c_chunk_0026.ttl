hpc:Lsfservice a owl:Class .
hpc:portnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range xsd:integer .
hpc:lsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range hpc:File .
hpc:reconfigurelsf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range xsd:string .
hpc:restartmbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range xsd:string .
hpc:restartalldaemons a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range xsd:string .
hpc:checkservicedatabase a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfservice ;
    rdfs:range hpc:File .
hpc:LSF_RES_PORT a hpc:portNumber ;
    hpc:lsfConf "LSF_RES_PORT=3878" .
hpc:LSB_MBD_PORT a hpc:portNumber ;
    hpc:lsfConf "LSB_MBD_PORT=3881" .
hpc:LSB_SBD_PORT a hpc:portNumber ;
    hpc:lsfConf "LSB_SBD_PORT=3882" .
