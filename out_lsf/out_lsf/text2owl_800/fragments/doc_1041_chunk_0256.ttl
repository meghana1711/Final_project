hpc:Joboutput a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Customized output in JSON format." .

hpc:longformat a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range hpc:Joboutput .

hpc:project a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range hpc:Lsfproject .

hpc:host a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:string .

hpc:donejob a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range hpc:Job .

hpc:exitedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range hpc:Job .

hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:removeheadings a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:boolean .

hpc:specifiedproject a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput .

hpc:pendingjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range hpc:Pendingjobs .

hpc:pendingreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range xsd:string .

hpc:eligiblejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjobs ;
    rdfs:range hpc:Eligiblejobs .

hpc:ineligiblejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjobs ;
    rdfs:range hpc:Ineligiblejobs .

hpc:Lsfproject a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Eligiblejobs a owl:Class ;
    rdfs:subClassOf hpc:Pendingjobs .

hpc:Ineligiblejobs a owl:Class ;
    rdfs:subClassOf hpc:Pendingjobs .

hpc:Pendingjobs a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class .
