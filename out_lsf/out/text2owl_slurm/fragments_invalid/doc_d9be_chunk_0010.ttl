@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:Task a owl:Class.
hpc:Node a owl:Class.

hpc:cpuallocation a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range rdf:List.

hpc:taskallocation a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range rdf:List.

hpc:CPU rdf:type xsd:nonNegativeInteger.
hpc:TaskID rdf:type xsd:integer.

hpc:Hascpuallocation hpc:job a owl
