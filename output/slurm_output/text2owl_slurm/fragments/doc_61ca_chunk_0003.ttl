hpc:Jobenvironment a owl:Class .
hpc:Slurmcredential a owl:Class .
hpc:Jobrecord a owl:Class .
hpc:preppprolog a owl:ObjectProperty ;
    rdfs:domain hpc:Jobenvironment ;
    rdfs:range xsd:int .
hpc:preppepilog a owl:ObjectProperty ;
    rdfs:domain hpc:Jobenvironment ;
    rdfs:range xsd:int .
hpc:preppprologslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrecord ;
    rdfs:range xsd:boolean .
hpc:preppepilogslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrecord ;
    rdfs:range xsd:boolean .
hpc:callbacks a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobenvironment ;
    rdfs:range xsd:anyURI .
hpc:async a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrecord ;
    rdfs:range xsd:boolean .
hpc:Jobfailure a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:Jobsuccess a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:Joblaunchrequest a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:Jobtermination a owl:Class ;
    rdfs:subClassOf owl:Thing .
hpc:Slurmerror a owl:Class ;
    rdfs:subClassOf xsd:integer .
hpc:Slurmsuccess a owl:Class ;
    rdfs:subClassOf xsd:integer .
