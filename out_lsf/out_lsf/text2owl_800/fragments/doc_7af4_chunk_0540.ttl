hpc:Jobslotlimit a owl:Class .
hpc:Host a owl:Class .
hpc:Cpu a owl:Class .
hpc:Jobslot a owl:Class .
hpc:slotsPerProcessor a owl:DatatypeProperty .
hpc:slots a owl:ObjectProperty .

hpc:Jobslotlimit rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf hpc:Jobslotlimit .
hpc:Cpu rdfs:subClassOf hpc:Host .
hpc:Jobslot rdfs:subClassOf hpc:Jobslotlimit .

hpc:SlotsPerProcessor rdfs:domain hpc:Jobslotlimit ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Slots rdfs:domain hpc:Jobslotlimit ;
             rdfs:range xsd:nonNegativeInteger .
