hpc:Computeunit a owl:Class .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:belongsto a owl:ObjectProperty .
hpc:preferencelevel a owl:DatatypeProperty .
hpc:compoundresourcerequirement a owl:ObjectProperty .
hpc:simpleresourcerequirement a owl:DatatypeProperty .
hpc:firstexecutionlist a owl:DatatypeProperty .
hpc:list a owl:DatatypeProperty .
hpc:queue a owl:DatatypeProperty .

hpc:Computeunit rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Hostgroup rdfs:subClassOf owl:Class .

hpc:Belongsto rdfs:domain hpc:Computeunit .
hpc:Belongsto rdfs:range hpc:Host .
hpc:Preferencelevel rdfs:domain hpc:Host .
hpc:Preferencelevel rdfs:range xsd:integer .
hpc:Compoundresourcerequirement rdfs:domain hpc:Host .
hpc:Compoundresourcerequirement rdfs:range hpc:Compoundresourcerequirement .
hpc:Simpleresourcerequirement rdfs:domain hpc:Compoundresourcerequirement .
hpc:Simpleresourcerequirement rdfs:range hpc:Simpleresourcerequirement .
hpc:Firstexecutionlist rdfs:domain hpc:Compoundresourcerequirement .
hpc:Firstexecutionlist rdfs:range hpc:Host .
hpc:List rdfs:domain hpc:Compoundresourcerequirement .
hpc:List rdfs:range xsd:string .
hpc:Queue rdfs:domain hpc:Host .
hpc:Queue rdfs:range xsd:string .

hpc:Compoundresourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .

hpc:Compoundresourcerequirement rdfs:subClassOf owl:Class .
hpc:Simpleresourcerequirement rdfs:subClassOf owl:Class .

hpc:prefers a owl:ObjectProperty .
hpc:Prefers rdfs:domain hpc:Host .
hpc:Prefers rdfs:range hpc:Host .
hpc:prefers rdfs:subPropertyOf hpc:belongsTo .

hpc:all a hpc:HostGroup .
hpc:others a hpc:Host .
