hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf owl:Class .

# JobStart Event Class
hpc:Jobstartevent a owl:Class .
hpc:Jobstartevent rdfs:subClassOf owl:Class .

# JobStartEvent properties
hpc:job a owl:ObjectProperty .
hpc:Job rdfs:domain hpc:Jobstartevent .
hpc:Job rdfs:range hpc:Job .

hpc:time a owl:DatatypeProperty .
hpc:Time rdfs:domain hpc:Jobstartevent .
hpc:Time rdfs:range xsd:dateTime .

hpc:numexhosts a owl:DatatypeProperty .
hpc:Numexhosts rdfs:domain hpc:Jobstartevent .
hpc:Numexhosts rdfs:range xsd:integer .

hpc:exechosts a owl:DatatypeProperty .
hpc:Exechosts rdfs:domain hpc:Jobstartevent .
hpc:Exechosts rdfs:range xsd:string .

hpc:jobstatus a owl:DatatypeProperty .
hpc:Jobstatus rdfs:domain hpc:Jobstartevent .
hpc:Jobstatus rdfs:range xsd:string .

hpc:jobtype a owl:DatatypeProperty .
hpc:Jobtype rdfs:domain hpc:Jobstartevent .
hpc:Jobtype rdfs:range xsd:string .

hpc:command a owl:DatatypeProperty .
hpc:Command rdfs:domain hpc:Jobstartevent .
hpc:Command rdfs:range xsd:string .

hpc:cputime a owl:DatatypeProperty .
hpc:Cputime rdfs:domain hpc:Jobstartevent .
hpc:Cputime rdfs:range xsd:decimal .

hpc:memoryusage a owl:DatatypeProperty .
hpc:Memoryusage rdfs:domain hpc:Jobstartevent .
hpc:Memoryusage rdfs:range xsd:integer .

hpc:numtasks a owl:DatatypeProperty .
hpc:Numtasks rdfs:domain hpc:Jobstartevent .
hpc:Numtasks rdfs:range xsd:integer .

hpc:queue a owl:DatatypeProperty .
hpc:Queue rdfs:domain hpc:Jobstartevent .
hpc:Queue rdfs:range xsd:string .

hpc:host a owl:DatatypeProperty .
hpc:Host rdfs:domain hpc:Jobstartevent .
hpc:Host rdfs:range xsd:string .

# JobFinish Event Class
hpc:Jobfinishevent a owl:Class .
hpc:Jobfinishevent rdfs:subClassOf owl:Class .

# JobFinishEvent properties
hpc:job a owl:ObjectProperty .
hpc:Job rdfs:domain hpc:Jobfinishevent .
hpc:Job rdfs:range hpc:Job .

hpc:time a owl:DatatypeProperty .
hpc:Time rdfs:domain hpc:Jobfinishevent .
hpc
