hpc:Reservation a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:hasDuration a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasFlag a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:PlainLiteral .

hpc:TimeFloat a rdf:PlainLiteral .

hpc:DrainingState a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf hpc:NodeState ] .

hpc:Node a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf hpc:Resource ] .

hpc:hasReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Reservation .

hpc:ReplacedDown a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Resource .

hpc:Replace a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Resource .
```
