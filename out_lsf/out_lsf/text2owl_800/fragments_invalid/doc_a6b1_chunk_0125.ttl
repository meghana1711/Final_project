hpc:Ego a owl:Class .
hpc:BusinessObjective rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range rdfs:Class .
hpc:ReduceTimeCost rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:MaximizeRevenue rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:ConfigureEnforceAudit rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:HighAvailability rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:BusinessContinuity rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:SimplifyManagement rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:ResourceConsolidation rdf:type rdfs:Class ;
    rdfs:subClassOf hpc:Businessobjective .
hpc:Cluster hpc:hasbusinessobjective some hpc:BusinessObjective .
hpc:ResourceDemand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range hpc:Businessservice .
hpc:ResourceAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range hpc:Resource .
hpc:ResourceEntitlement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range xsd:integer .
hpc:ConsumerPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range xsd:integer .
hpc:ResourcePlan rdf:type rdfs:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:Resource rdf:type owl:Class .
hpc:BusinessService rdf:type owl:Class .
hpc:LSFCluster a hpc:BusinessService .
hpc:SDK a hpc:EGOInterface .
hpc:CLI a hpc:EGOInterface .
hpc:EGOInterface rdf:type owl:Class .
