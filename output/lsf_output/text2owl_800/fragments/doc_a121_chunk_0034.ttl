hpc:Job a owl:Class .
hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Resumedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:USUSP rdf:type xsd:string ;
    rdfs:range hpc:Suspendedjob .
hpc:PSUSP rdf:type xsd:string ;
    rdfs:range hpc:Suspendedjob .
hpc:RUN rdf:type xsd:string ;
    rdfs:range hpc:Resumedjob .

hpc:SIGTSTP rdf:type xsd:string .
hpc:SIGSTOP rdf:type xsd:string .
hpc:LSB_SIGSTOP rdf:type xsd:string .
