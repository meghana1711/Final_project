hpc:Totalresource a owl:Class .
hpc:hasResourceName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Totalresource ;
    rdfs:range xsd:string .

hpc:ReportsTotalStorageSpace an owl:ObjectProperty ;
    rdfs:domain hpc:Totalresource ;
    rdfs:range hpc:Totalstoragespace .

hpc:ReportsAvailableStorageSpace an owl:ObjectProperty ;
    rdfs:domain hpc:Totalresource ;
    rdfs:range hpc:Availablestoragespace ;
    rdfs:subPropertyOf hpc:ReportsTotalStorageSpace .

hpc:ReservedSpace an owl:DatatypeProperty ;
    rdfs:domain hpc:Totalstoragespace ;
    rdfs:range xsd:nonNegativeInteger .

hpc:UsedSpace an owl:DatatypeProperty ;
    rdfs:domain hpc:Totalstoragespace ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Totalstoragespace a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:unionOf (hpc:AvailableStorageSpace owl:ObjectSomeValuesFrom (hpc:ReportsAvailableStorageSpace)
                     hpc:ReservedSpace
                     hpc:UsedSpace)
    ].

hpc:LsbStageStorage a owl:Class .
hpc:hasResourceName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:LsbStageStorage .

hpc:LsbStageStorageMax a owl:Class .

hpc:LsbStageTransferRate a owl:Class .
hpc:hasDataTransferRate an owl:DatatypeProperty ;
    rdfs:domain hpc:LsbStageTransferRate ;
    rdfs:range xsd:nonNegativeInteger .
