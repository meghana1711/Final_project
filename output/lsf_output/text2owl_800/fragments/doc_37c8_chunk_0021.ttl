hpc:Shifterjobrunoptions a owl:Class .
hpc:haspreexecutionscript a owl:ObjectProperty ;
    rdfs:domain hpc:Shifterjobrunoptions ;
    rdfs:range xsd:string .
hpc:Lsfrunoptions a owl:Class ;
    rdfs:subClassOf hpc:Shifterjobrunoptions .
hpc:haslsfrunoption a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfrunoptions ;
    rdfs:range xsd:string .
hpc:Shifterapp a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Shifterapp ;
    rdfs:range xsd:string .
hpc:hascontainer a owl:ObjectProperty ;
    rdfs:domain hpc:Shifterapp ;
    rdfs:range hpc:Container .
hpc:hasdescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Shifterapp ;
    rdfs:range xsd:string .
hpc:Container a owl:Class .
hpc:hasimage a owl:ObjectProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:hasoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range hpc:Shifterjobrunoptions .
