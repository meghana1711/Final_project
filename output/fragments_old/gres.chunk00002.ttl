hpc:GPU a owl:Class .

# System-detected GPU class
hpc:SystemDetectedGPU a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# GPU configuration class
hpc:GPUConfiguration a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# AutoDetect property
hpc:autoDetect a owl:ObjectProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:string .

# Type property
hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:string .

# File property
hpc:file a owl:ObjectProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:string .

# Cores property
hpc:cores a owl:ObjectProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:integer .

# Links property
hpc:links a owl:ObjectProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:integer .

# Count property
hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:GPUConfiguration ;
    rdfs:range xsd:integer .

# Name property
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hdr:GPU ;
    rdfs:range xsd:string .

# MPS class
hpc:MPS a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# Lustre class
hpc:Lustre a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# Bandwidth class
hpc:Bandwidth a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# AccountingStorageTRES property
hpc:accountingStorageTRES a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

# gres/gpumem property
hpc:gresGpumem a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

# gres/gpuutil property
hpc:gresGpuutil a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

# Slurmd-detected GPU class
hpc:SlurmdDetectedGPU a owl:Class ;
    rdfs:subClassOf hpc:GPU .

# Matching substring property
hpc:matchesSubstring a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmdDetectedGPU ;
    rdfs:range xsd:string .
```
