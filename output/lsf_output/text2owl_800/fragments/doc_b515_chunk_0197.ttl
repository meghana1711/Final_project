hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Fairsharepolicy a owl:Class .
hpc:dynamicsharepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range xsd:decimal .
hpc:belongsto a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Usergroup .
hpc:controls a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:Fairsharepolicy .
hpc:hashighestdynamicsharepriority a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:User .
hpc:submitjobwithgroup a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
