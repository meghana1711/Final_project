hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:relaxjobdispatchorder a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:Jobinfocache a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:jobinfomemorycachesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinfocache ;
    rdfs:range xsd:nonNegativeInteger .

hpc:jobinfoeventsfile a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinfocache ;
    rdfs:range xsd:string .

hpc:lsbjobinfodir a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .

hpc:Lsfconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:jobinfoeventfilerewriteinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinfoeventsfile ;
    rdfs:range xsd:nonNegativeInteger .

hpc:jobgrouplimitssupport a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .
