hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job that can be executed on an HPC system." .

hpc:Checkpointdirectory a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the directory where checkpoint files are created." .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The period, in minutes, between checkpoint file creations during job execution." .

hpc:checkpointmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointmethod ;
    rdfs:comment "The method used for automatic checkpointing of the job." .

hpc:checkpointdirectoryrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Checkpointdirectory ;
    rdfs:comment "Indicates whether an application profile requires a checkpoint directory for automatic checkpointing." .

hpc:checkpointperiodrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Checkpointperiod ;
    rdfs:comment "Indicates whether an application profile requires a checkpoint period for automatic checkpointing." .

hpc:checkpointmethodrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Checkpointmethod ;
    rdfs:comment "Indicates whether an application profile requires a checkpoint method for automatic checkpointing." .

hpc:checkpointdirectorypath a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:string ;
    rdfs:comment "The path of the checkpoint directory, either absolute or relative to the job's current working directory." .

hpc:Automaticjobmigration a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the configuration for automatic job migration." .

hpc:migrationthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The migration threshold for a queue, used to determine when to migrate a job to a less loaded host." .

hpc:jobmigratable a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates whether a job is migratable." .
