hpc:Dockerjob a owl:Class .

# Docker Image Class
hpc:Dockerimage a owl:Class .

# LSB Container Image Object Property
hpc:hasLSBContainerImage an owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:string .

# LSB Docker Place Holder Object Property
hpc:usesLSBDockerPlaceHolder an owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob .

# Docker App Object Property
hpc:isDockerApp an owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:string .

# Docker Input Object Property
hpc:hasDockerInput an owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:string .

# Docker Output Object Property
hpc:hasDockerOutput an owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:string .

# Docker Affinity Datatype Property
hpc:hasDockerImageAffinity an owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerjob ;
    rdfs:range xsd:string .

# Docker Affinity Values
hpc:Yes a xsd:string .
hpc:No a xsd:string .


This ontology represents the classes and properties related to Docker job submission, including the LSB Container Image, LSB Docker Place Holder, Docker App, Docker Input, Docker Output, and Docker Affinity. The values for Docker Affinity are defined as Yes and No.
