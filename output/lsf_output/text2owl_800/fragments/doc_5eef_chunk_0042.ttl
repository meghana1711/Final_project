hpc:Submissionhost a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Directory a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:root a owl:ObjectProperty ;
    rdfs:domain hpc:Submissionhost ;
    rdfs:range hpc:Directory .

hpc:path a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Submissionhost ;
    rdfs:range xsd:string .

hpc:lsbOutdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Submissionhost ;
    rdfs:range xsd:string .

hpc:lsboutdir a owl:ObjectProperty ;
    rdfs:domain hpc:Submissionhost ;
    rdfs:range hpc:Directory .

hpc:src a owl:ObjectProperty ;
    rdfs:domain hpc:Directory ;
    rdfs:range xsd:string .

hpc:defaulthostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Submissionhost ;
    rdfs:range xsd:string .
