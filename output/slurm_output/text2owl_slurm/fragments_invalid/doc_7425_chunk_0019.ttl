@base <http://example.org/hpc/>

hpc:v0_0_40_openapi_clusters_resp
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Apiresponse. .

hpc:v0_0_40_openapi_clusters_removed_resp
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Apiresponse. .

hpc:job_description_msg
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Apiresponse ;
    rdfs:subClassOf hpc:Jobdescription ;
    rdfs:subClassOf hpc:Apiresponse ;
    rdfs:domain hpc:Apiresponse ;
    rdfs:range hpc:Jobdescriptionmsg. .

hpc:segment_size
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdescriptionmsg ;
    rdfs:range xsd:integer. .

hpc:resv_mp
