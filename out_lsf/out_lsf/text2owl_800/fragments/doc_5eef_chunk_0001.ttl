hpc:Useraccount a owl:Class .
hpc:Localcluster a owl:Class .
hpc:Remotecluster a owl:Class .
hpc:crossclustermapping a owl:ObjectProperty .
hpc:sshkey a owl:DatatypeProperty .

hpc:Useraccount rdfs:subClassOf owl:Class .
hpc:Localcluster rdfs:subClassOf owl:Class .
hpc:Remotecluster rdfs:subClassOf owl:Class .

hpc:CrossClusterMapping rdf:type owl:ObjectProperty .
hpc:SSHKey rdf:type owl:DatatypeProperty .

hpc:Crossclustermapping rdfs:domain hpc:Useraccount .
hpc:Crossclustermapping rdfs:range rdf:List .
hpc:Crossclustermapping rdfs:range rdf:List; rdf:first hpc:Localcluster ; rdf:rest hpc:Remotecluster .

hpc:Sshkey rdfs:domain hpc:Useraccount .
hpc:Sshkey rdfs:range xsd:string .

hpc:Usermap a owl:Class .
hpc:UserMap rdf:type owl:Class .

hpc:Local rdfs:domain hpc:Usermap .
hpc:Local rdfs:range hpc:Useraccount .
hpc:Remote rdfs:domain hpc:Usermap .
hpc:Remote rdfs:range hpc:Useraccount .
hpc:Direction rdfs:domain hpc:Usermap .
hpc:Direction rdfs:range xsd:string .

hpc:export a owl:ObjectProperty .
hpc:import a owl:ObjectProperty .

hpc:Export rdf:type hpc:Direction .
hpc:Import rdf:type hpc:Direction .

hpc:Export rdfs:subPropertyOf hpc:CrossClusterMapping .
hpc:Import rdfs:subPropertyOf hpc:CrossClusterMapping .
