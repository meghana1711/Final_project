hpc:Advancereservation a owl:Class.
hpc:Advancereservation a owl:Class; rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty hpc:hasReservation;
    owl:hasValue hpc:Advancereservation;
    owl:cardinality 1
].
hpc:Normalqueue a owl:Class.
hpc:Nosuspendqueue a owl:Class.

hpc:hasreservation a owl:ObjectProperty;
    rdfs:domain hpc:Host;
    rdfs:range hpc:Advancereservation.
hpc:isinqueue a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Queue.
hpc:useshost a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:Host.
hpc:hastimewindow a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range xsd:string.
hpc:hasuser a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
