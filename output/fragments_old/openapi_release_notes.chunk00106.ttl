hpc:TotalItemCount a owl:DatatypeProperty ;
    rdfs:domain hpc:TotalItems ;
    rdfs:range xsd:int64 .

hpc:QOSLimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .

hpc:QOSLimitTres a owl:Class ;
    rdfs:subClassOf hpc:QOSLimit ;
    rdfs:subClassOf hpc:LimitWithMinutes .

hpc:QOSLimitTresTotal a owl:Class ;
    rdfs:subClassOf hpc:QOSLimitTres ;
    rdfs:subClassOf hpc:LimitWithTotal .

hpc:QOSLimitTresTotalItem a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotal ;
    rdfs:range xsd:integer .

hpc:QOSLimitTresTotalItemId a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotalItem ;
    rdfs:range xsd:integer .

hpc:QOSLimitTresTotalItemName a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotalItem ;
    rdfs:range xsd:string .

hpc:QOSLimitTresTotalItemType a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotalItem ;
    rdfs:range xsd:string .

hpc:QOSLimitTresTotalRequired a owl:ObjectProperty ;
    rdfs:domain hpc:QOSLimitTresTotal ;
    rdfs:range rdfs:Resource ;

hpc:QOSLimitTresTotalType a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotal ;
    rdfs:range xsd:string .

hpc:QOSLimitTresTotalRequiredType a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotalRequired ;
    rdfs:range xsd:string .

hpc:QOSLimitTresTotalRequiredRequired a owl:DatatypeProperty ;
    rdfs:domain hpc:QOSLimitTresTotalRequired ;
    rdfs:range xsd:string .

hpc:QOSLimitTresTotal a owl:Class ;
    rdfs:subClassOf hpc:QOSLimitTres ;
    rdfs:subClassOf hpc:LimitWithTotal ;
    rdfs:subClassOf hpc:Array .

hpc:QOSLimitTresTotalItem a owl:Class ;
    rdfs:subClassOf hpc:QOSLimitTresTotal ;
    rdfs:subClassOf hpc:LimitWithTotalItem .

hpc:QOSLimitTresTotal a owl:ObjectProperty ;
    rdfs:domain hpc:QOSLimitTres ;
    rdfs:range hpc:QOSLimitTresTotal .

hpc:QOS a owl:Class
