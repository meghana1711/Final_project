hpc:Usergroup a owl:Class .
hpc:Project a owl:Class .
hpc:Arraysession a owl:Class .
hpc:Job a owl:Class .
hpc:Serviceclass a owl:Class .

hpc:Hasusergroup rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .
hpc:Hasproject rdfs:domain hpc:Arraysession ;
    rdfs:range hpc:Project .
hpc:Hasserviceclass rdfs:domain hpc:Job ;
    rdfs:range hpc:Serviceclass .

hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:User .
hpc:Submitjob rdfs:range hpc:Job .

hpc:assignprojecttosession a owl:ObjectProperty ;
    rdfs:domain hpc:Arraysession .
hpc:Assignprojecttosession rdfs:range hpc:Project .

hpc:associatewithgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Associatewithgroup rdfs:range hpc:Usergroup .

hpc:setjobname a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Setjobname rdfs:range xsd:string .

hpc:submittoserviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Submittoserviceclass rdfs:range hpc:Serviceclass .
