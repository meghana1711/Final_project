hpc:Queue a owl:Class .
hpc:queueName a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:lostAndFound a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
hpc:prio a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:queueacceptsjobs a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Queue .
hpc:Usergroup a owl:Class .
hpc:belongstoqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Usergroup .
