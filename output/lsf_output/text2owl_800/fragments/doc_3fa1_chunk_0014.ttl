hpc:Jobarray a owl:Class .
hpc:Inputfile a owl:Class .
hpc:jobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobarray .
hpc:dependencyCondition a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Dependencycondition .
hpc:done a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:positiveInteger .
hpc:numrun a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numpend a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numdone a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
