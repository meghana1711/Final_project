hpc:Containerimage a owl:Class .
hpc:Host a owl:Class .
hpc:Jobtask a owl:Class .
hpc:Jobarray a owl:Class .
hpc:Customizedoutput a owl:Class .

# Object Properties
hpc:hascontainerimagename a owl:ObjectProperty ;
    rdfs:domain hpc:Jobtask ;
    rdfs:range xsd:string .
hpc:hasimagesize a owl:ObjectProperty ;
    rdfs:domain hpc:Jobtask ;
    rdfs:range xsd:decimal .
hpc:usescontainerimage a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Containerimage .
hpc:haspendingjobtasks a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasrunningjobtasks a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hascontainerinstances a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:iscustomizedoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Containerimage ;
    rdfs:range hpc:Customizedoutput .

# Datatype Properties
hpc:hasfieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutput ;
    rdfs:range xsd:string .

# Subclass relations
hpc:Jobarray a rdfs:subClassOf hpc:Jobtask .

# Domain and Range restrictions
hpc:Hascontainerimagename rdfs:domain hpc:Jobtask ;
    rdfs:range rdf:PlainLiteral .
hpc:Hasimagesize rdfs:domain hpc:Jobtask ;
    rdfs:range xsd:decimal .
hpc:Usescontainerimage rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource .
hpc:Haspendingjobtasks rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasrunningjobtasks rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hascontainerinstances rdfs:domain hpc:Containerimage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Iscustomizedoutput rdfs:domain hpc:Containerimage ;
    rdfs:range rdf:Resource .
hpc:Hasfieldname rdfs:domain hpc:Customizedoutput ;
    rdfs:range xsd:string .
