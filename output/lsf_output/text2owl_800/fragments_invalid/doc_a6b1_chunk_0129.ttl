hpc:Lsfparameter a owl:Class .
hpc:Egoparameter a owl:Class .

hpc:Lsfparameter rdfs:subClassOf hpc:Parameter .
hpc:Egoparameter rdfs:subClassOf hpc:Parameter .

hpc:hasLSFName owl:DatatypeProperty .
hpc:hasEGOName owl:DatatypeProperty .

hpc:isSetInLSFConf rdf:domain hpc:LSFParameter ;
    rdfs:range xsd:boolean .

hpc:isSetInEGOConf rdf:domain hpc:EGOParameter ;
    rdfs:range xsd:boolean .

hpc:hasCorrespondingEGOParameter owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter ;
    rdfs:range hpc:Egoparameter .

hpc:cannotBeSetInEGOSConf owl:ObjectProperty ;
    rdfs:domain hpc:Egoparameter .

hpc:applicableForLIMPIMELIM owl:ObjectProperty ;
    rdfs:domain hpc:Egoparameter .

hpc:LSFParameter a hpc:Parameter ;
    hpc:hasLSFName "LSB_"^^xsd:string ;
    hpc:isSetInLSFConf true ;
    hpc:applicableForLIMPIMELIM true .

hpc:EGOParameter a hpc:Parameter ;
    hpc:hasEGOName "EGO_"^^xsd:string ;
    hpc:cannotBeSetInEGOSConf false ;
    hpc:applicableForLIMPIMELIM true ;
    hpc:Hascorrespondingegoparameter hpc:lsfparameter .

hpc:EGO_DAEMONS_CPUS a hpc:EGOParameter ;
    hpc:hasEGOName "EGO_DAEMONS_CPUS"^^xsd:string .

hpc:EGO_DEFINE_NCPUS a hpc:EGOParameter ;
    hpc:hasEGOName "EGO_DEFINE_NCPUS"^^xsd:string .

hpc:EGO_SLAVE_CTRL_REMOTE_HOST a hpc:EGOParameter ;
    hpc:hasEGOName "EGO_SLAVE_CTRL_REMOTE_HOST"^^xsd:string .

hpc:EGO_WORKDIR a hpc:EGOParameter ;
    hpc:hasEGOName "EGO_WORKDIR"^^xsd:string .

hpc:EGO_PIM_SWAP_REPORT a hpc:EGOParameter ;
    hpc:hasEGOName "EGO_PIM_SWAP_REPORT"^^xsd:string .
