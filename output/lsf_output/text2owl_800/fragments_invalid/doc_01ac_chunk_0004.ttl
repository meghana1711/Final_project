hpc:Lsfdatamanagerconfiguration a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Configuration file for an LSF data manager in a cluster." .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanagerconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the cluster defined in the LSF shared file." .

hpc:lsfdatamanager submits hpc:transferjob a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanagerconfiguration ;
    rdfs:range hpc:Transferjob ;
    rdfs:comment "The action of submitting a transfer job by the LSF data manager." .

hpc:Transferjob a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A job submitted by the LSF data manager for data transfer." .

hpc:transferjob runsOn hpc:datatransfernode a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range hpc:Datatransfernode ;
    rdfs:comment "The data transfer node on which the transfer job runs." .

hpc:Datatransfernode a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "An LSF server host in the cluster that is mounted with direct read/write access to the cluster staging area." .

hpc:Datatransferqueue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A queue configured to accept transfer jobs only." .

hpc:transferjob uses hpc:datatransfertoolcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The transfer tool command used by the transfer job." .

hpc:Stagingarea a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A managed file system on an LSF server host or mounted directory that is accessible to the cluster compute nodes." .

hpc:Datastaging a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The transfer of data to the location where it is used." .

hpc:stagingarea hasOne hpc:lsfdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea ;
    rdfs:range hpc:Lsfdatamanager ;
    rdfs:comment "Each staging area must have one LSF data manager instance." .

hpc:Datatransfernode isMountedWith rdfs:range xsd:string ;
    hpc:DataTransferNode rdfs:subPropertyOf rdfs:hasPart ;
    rdfs:comment "The mount point of the data transfer node with direct read/write access to the cluster staging area." .

hpc:stagingarea stores hpc:file a owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea ;
