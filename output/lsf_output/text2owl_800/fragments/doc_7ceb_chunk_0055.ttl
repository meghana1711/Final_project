hpc:Automountmanagement a owl:Class .
hpc:Nismanagement a owl:Class .
hpc:Lsbatchdaemon a owl:Class .
hpc:Sbatchd a owl:Class ;
    rdfs:subClassOf hpc:Lsbatchdaemon ;
    rdfs:comment "LSBatch daemon sbatchd." .
hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf hpc:Lsbatchdaemon ;
    rdfs:comment "LSBatch daemon mbatchd." .
hpc:Daemonerror a owl:Class .
hpc:Daemonconfigurationerror a owl:Class ;
    rdfs:subClassOf hpc:Daemonerror .
hpc:Limcommunicationerror a owl:Class ;
    rdfs:subClassOf hpc:Daemonerror .
hpc:Limproblem a owl:Class ;
    rdfs:subClassOf hpc:Daemonerror .
hpc:limrunning a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatchdaemon ;
    rdfs:range xsd:boolean .
hpc:checkerrorlog a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatchdaemon ;
    rdfs:range xsd:string .
hpc:runcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatchdaemon ;
    rdfs:range xsd:string .
hpc:checkconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatchdaemon ;
    rdfs:range xsd:string .
hpc:checkemail a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatchdaemon ;
    rdfs:range xsd:string .
hpc:limunknown a owl:ObjectProperty ;
    rdfs:domain hpc:Sbatchd ;
    rdfs:range hpc:Limrunning .
