hpc:Lsf-HPC a owl:Class .
hpc:Installationparameters a owl:Class .
hpc:LSF_TOP rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Installationparameters ;
    rdfs:range xsd:string .
hpc:LSF_CLUSTER_NAME rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Installationparameters ;
    rdfs:range xsd:string .
hpc:LSF_MASTER_LIST rdf:type hpc:objectProperty ;
    rdfs:domain hpc:Installationparameters ;
    rdfs:range hpc:Listofnodes .
hpc:Listofnodes a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:LSF_MASTER_LIST ;
                        owl:allValuesFrom rdf:List . ] .
hpc:LSF_ADD_SERVERS rdf:type hpc:objectProperty ;
    rdfs:domain hpc:Installationparameters ;
    rdfs:range hpc:Listofnodes .
hpc:service_cmd_info rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Lsf-HPC ;
    rdfs:range xsd:string .
hpc:service_num rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:ServiceCmdInfo ;
    rdfs:range xsd:integer .
hpc:heartbeat rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:ServiceCmdInfo ;
    rdfs:range xsd:string .
hpc:start_cmd rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Lsf-HPC ;
    rdfs:range xsd:string .
hpc:stop_cmd rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Lsf-HPC ;
    rdfs:range xsd:string .
hpc:restart_cmd rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Lsf-HPC ;
    rdfs:range xsd:string .
hpc:fail_cmd rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:Lsf-HPC ;
    rdfs:range xsd:string .
hpc:ServCmd a owl:Class .
hpc:serv_cmd_file rdf:type hpc:datatypeProperty ;
    rdfs:domain hpc:ServCmd ;
    rdfs:range xsd:string .
hpc:LSF-HPC_service rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:ServCmd ;
    rdfs:range hpc:Lsf-HPC .
hpc:xtservcmd2db rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:ServCmd ;
    rdfs:range xsd:string .
hpc:xtservconﬁg rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:ServCmd ;
