hpc:Jobarray a owl:Class .
hpc:Job a owl:Class .
hpc:jobdependencyinfo a owl:ObjectProperty .
hpc:Jobid rdfs:domain hpc:Jobarray ;
                        rdfs:range xsd:integer .
hpc:Child rdfs:domain hpc:Jobdependencyinfo ;
                     rdfs:range hpc:Job .
hpc:Childstatus rdfs:domain hpc:Jobdependencyinfo ;
                 rdfs:range xsd:string .
hpc:Childname rdfs:domain hpc:Jobdependencyinfo ;
                 rdfs:range xsd:string .
hpc:Level rdfs:domain hpc:Jobdependencyinfo ;
               rdfs:range xsd:integer .

hpc:jobstatus a owl:ObjectProperty .
hpc:Jobid rdfs:domain hpc:Job ;
               rdfs:range xsd:integer .
hpc:User rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:State rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:Queue rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:FromHost rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:JobName rdfs:domain hpc:Job ;
               rdfs:range xsd:string .
hpc:SubmitTime rdfs:domain hpc:Job ;
               rdfs:range xsd:dateTime .

hpc:pastjobstatus a owl:ObjectProperty .
hpc:Jobid rdfs:domain hpc:Jobarray ;
               rdfs:range xsd:integer .
hpc:Total rdfs:domain hpc:Pastjobstatus ;
               rdfs:range xsd:integer .
hpc:Pend rdfs:domain hpc:Pastjobstatus ;
              rdfs:range xsd:integer .
hpc:Psusp rdfs:domain hpc:Pastjobstatus ;
            rdfs:range xsd:integer .
hpc:Run rdfs:domain hpc:Pastjobstatus ;
              rdfs:range xsd:integer .
hpc:Ususp rdfs:domain hpc:Pastjobstatus ;
            rdfs:range xsd:integer .
hpc:Ssusp rdfs:domain hpc:Pastjobstatus ;
            rdfs:range xsd:integer .
hpc:Unkwn rdfs:domain hpc:Pastjobstatus ;
              rdfs:range xsd:integer .
hpc:JobName rdfs:domain hpc:Pastjobstatus ;
               rdfs:range xsd:string .
hpc:User rdfs:domain hpc:Pastjobstatus ;
               rdfs:range xsd:string .
