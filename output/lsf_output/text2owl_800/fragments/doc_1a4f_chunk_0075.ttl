hpc:Procedure a owl:Class .
hpc:openqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Queue .
hpc:deactivatequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Queue .
hpc:activatequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Queue .
hpc:logcommentonqueuecontrolcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Comment .
hpc:Queue a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Comment a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Administrator a owl:Class .
hpc:QueueControlAction a owl:Enum ;
    rdfs:member hpc:open ;
    rdfs:member hpc:close ;
    rdfs:member hpc:act ;
    rdfs:member hpc:inact .
