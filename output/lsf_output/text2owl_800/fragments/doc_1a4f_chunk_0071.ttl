hpc:Host a owl:Class .
hpc:Unavailablestatus a owl:Class .
hpc:timeoutvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsfDynamicHostTimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Expiredhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:expirehostcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
hpc:Managementhost a owl:Class .
hpc:Cluster a owl:Class .
hpc:Verylargecluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster .
hpc:postconfigurationstepsforadministrators a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
hpc:hostremovalprocedure a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string .
hpc:hostcachefile a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
hpc:Fixpack15 a owl:Class .
hpc:Systemperformance a owl:Class .
hpc:disableparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string .
