hpc:User a owl:Class .
hpc:WCKeyID a xsd:string .
hpc:AccountName a xsd:string .

hpc:hasName a owl:ObjectProperty .
hpc:hasWCKeyID a owl:ObjectProperty .
hpc:hasAccountName a owl:ObjectProperty .

hpc:Result a owl:Class .
hpc:Response a owl:Class .
hpc:DeleteUser a owl:Class, rdfs:subClassOf[hpc:Response] .
hpc:DeleteWckey a owl:Class, rdfs:subClassOf[hpc:Response] .
hpc:GetAccountInfo a owl:Class, rdfs:subClassOf[hpc:Response] .
hpc:OpenapiResp a owl:Class .
hpc:WckeyRemovedResp a owl:Class, rdfs:subClassOf[hpc:OpenapiResp] .

hpc:DeleteUser rdfs:subClassOf[hpc:Result] .
hpc:DeleteWckey rdfs:subClassOf[hpc:Result] .
hpc:GetAccountInfo rdfs:subClassOf[hpc:Result] .

hpc:DeleteUser rdfs:domain[hpc:DeleteUser] .
hpc:DeleteWckey rdfs:domain[hpc:DeleteWckey] .
hpc:GetAccountInfo rdfs:domain[hpc:GetAccountInfo] .

hpc:DeleteUser rdfs:range[hpc:DeleteUserResponse] .
hpc:DeleteWckey rdfs:range[hpc:WckeyRemovedResponse] .
hpc:GetAccountInfo rdfs:range[hpc:AccountResponse] .
