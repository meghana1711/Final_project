hpc:Liveconfiguration a owl:Class .
hpc:lsfconfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Liveconfiguration ;
    rdfs:range xsd:anyURI .

hpc:Livereconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Liveconfiguration .

hpc:Livereconfigprocedure a owl:Class .

hpc:definelsfliveconfdir a owl:ObjectProperty ;
    rdfs:domain hpc:Livereconfiguration ;
    rdfs:range hpc:Liveconfiguration .

hpc:reapplynewparametersetting a owl:ObjectProperty ;
    rdfs:domain hpc:Definelsfliveconfdir ;
    rdfs:range hpc:Livereconfigprocedure ;
    rdfs:range hpc:Lsfreconfigcommand .

hpc:Lsfreconfigcommand a owl:Class .

hpc:BadminMbdrestart a owl:NamedIndividual ;
    rdf:type hpc:LsfReconfigCommand .

hpc:lsfliveconfdirdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Liveconfiguration ;
    rdfs:range xsd:anyURI .

hpc:fileinliveconfdirreadpreferred a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfrestartcommand ;
    rdfs:range hpc:File .

hpc:Addusersharetofairsharequeue a owl:Class ;
    rdfs:subClassOf hpc:Livereconfiguration .

hpc:bconfaddmember a owl:ObjectProperty ;
    rdfs:domain hpc:Addusersharetofairsharequeue ;
    rdfs:range hpc:Lsfreconfigcommand .

hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Bconfaddmember ;
    rdfs:range xsd:string .

hpc:fairshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Bconfaddmember ;
    rdfs:range xsd:string .

hpc:Usershares a owl:Class .
hpc:Usershare a owl:Class ;
    rdfs:subClassOf hpc:Usershares .

hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Usershare ;
    rdfs:range xsd:string .

hpc:share a owl:DatatypeProperty ;
    rdfs:domain hpc:Usershare ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Lsbqueues a owl:Class .
