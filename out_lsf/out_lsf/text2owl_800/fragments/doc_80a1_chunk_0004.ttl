hpc:Fixcentral a owl:Class .
hpc:FixPack14 rdf:value "Fix Pack 14" ;
    rdfs:subClassOf hpc:Fixcentral ;
    rdfs:comment "Download any IBM Spectrum LSF Predictor 10.1 fix pack from IBM Fix Central." .

hpc:Operatingsystemversion a owl:Class .
hpc:RHEL8x rdf:value "RHEL 8.x" ;
    rdfs:subClassOf hpc:Operatingsystemversion ;
    rdfs:comment "Operating system versions." .
hpc:RHEL9x rdf:value "RHEL 9.x" ;
    rdfs:subClassOf hpc:Operatingsystemversion ;
    rdfs:comment "Operating system versions." .

hpc:Issue a owl:Class .
hpc:UpgradeFailure rdf:value "Upgrade fails when there are existing stopped containers." ;
    rdfs:subClassOf hpc:Issue ;
    rdfs:comment "Issues resolved by Fix Pack 14." .
hpc:SymbolicLinkingSupport rdf:value "Symbolic linking support required for files under the lsf/conf directory." ;
    rdfs:subClassOf hpc:Issue ;
    rdfs:comment "Issues resolved by Fix Pack 14." .
hpc:ImportConfigurationFailure rdf:value "Importing LSF configuration fails when the root user does not have writer permission to the conf directory." ;
    rdfs:subClassOf hpc:Issue ;
    rdfs:comment "Issues resolved by Fix Pack 14." .
hpc:SpecialDirectoriesExclusion rdf:value "Special directories are excluded when importing LSF configuration." ;
    rdfs:subClassOf hpc:Issue ;
    rdfs:comment "Issues resolved by Fix Pack 13." .

hpc:passwordchange a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string ;
    rdfs:comment "For added security, the first time you log on to the LSF Predictor web console, you will now be prompted to change your password, rather than use the preset default password (Admin)." .

hpc:Graphtab a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "To show a graphical representation of your experiments, use the new Graphs tab view in the IBM Spectrum LSF Predictor web console." .
