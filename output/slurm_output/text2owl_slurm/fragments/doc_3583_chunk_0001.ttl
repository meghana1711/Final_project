hpc:Slurmcommand a owl:Class .
hpc:Apis a owl:Class .
hpc:slurmH a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmcommand ;
    rdfs:range hpc:Apis .
hpc:slurmdbH a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmcommand ;
    rdfs:range hpc:Apis .
hpc:RestApi a owl:Class ;
    rdfs:subClassOf hpc:Apis .
hpc:MajorRelease a owl:Class .
hpc:crossVersionCompatibility a owl:ObjectProperty ;
    rdfs:domain hpc:RestApi ;
    rdfs:range xsd:boolean .
