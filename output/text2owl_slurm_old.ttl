hpc:AdministrativeAccessConfiguration hpc:hasAdminGroup "wheel" .
hpc:PamAccess hpc:allowsAccess "wheel" .
hpc:PamAccess hpc:deniesAccess "*" .
hpc:PamModule hpc:isSufficient true .
hpc:PamModule hpc:isRequired false .
hpc:PamModule hpc:hasOrder 1 .
hpc:PamSlurmAdoptOption hpc:hasAction "ignore" .
hpc:PamSlurmAdoptOption hpc:hasAction "deny" .
hpc:PamSlurmAdoptOption hpc:hasAction "newest" .
