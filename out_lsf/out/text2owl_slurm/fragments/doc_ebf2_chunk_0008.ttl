hpc:Linuxdistribution a owl:Class .
hpc:configparameter a owl:ObjectProperty .
hpc:Kernelconfig a owl:Class .
hpc:Config_MEMCG_SWAP rdf:value "CONFIG_MEMCG_SWAP" ;
                        rdfs:domain hpc:Kernelconfig ;
                        rdfs:range xsd:string .
hpc:systemdparameter a owl:ObjectProperty .
hpc:JoinControllers rdf:value "JoinControllers" ;
                      rdfs:domain hpc:Linuxdistribution ;
                      rdfs:range xsd:string .
hpc:DeprecatedClass rdf:value "deprecated" ;
                     rdfs:domain hpc:Systemdparameter .
hpc:slurmcompatibility a owl:ObjectProperty .
hpc:DoesNotWorkCorrectly rdf:value "does not work correctly" ;
                          rdfs:domain hpc:Slurmcompatibility .
hpc:Cgrouplegacymode a owl:Class .
hpc:CgroupControllersUnderSeparateDirectories rdf:value "all your cgroup controllers are under separate directories" ;
                                                 rdfs:domain hpc:Cgrouplegacymode .
