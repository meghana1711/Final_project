hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:Consumableresource a owl:Class .
hpc:Queue a owl:Class .
hpc:Reservableresource a owl:Class .
hpc:reservationlimit a owl:ObjectProperty .
hpc:Reservation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Reservableresource .
hpc:reservedamount a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:currentvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal .
hpc:reservedbyjob a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Job .
hpc:queuelevelresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdfs:Literal .
hpc:joblevelresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Literal .
hpc:mergedresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirement .
hpc:hardlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirement .
hpc:defaultvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hdfs:Literal .
