hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Job a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hascommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .

hpc:submittedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:dispatchedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:completedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:executioncwd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .

hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .

hpc:cpuT a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:wait a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:turnaround a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:hogfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:Accountinginformation a owl:Class .
