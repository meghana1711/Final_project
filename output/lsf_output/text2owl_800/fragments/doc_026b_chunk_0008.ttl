hpc:Host a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Datatransferqueue a owl:Class .
hpc:queuename a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:string .
hpc:datatransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:boolean .
hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:string .
hpc:Exportedfilesystem a owl:Class .
hpc:subdirectoryof a owl:ObjectProperty ;
    rdfs:domain hpc:Exportedfilesystem ;
    rdfs:range hpc:Exportedfilesystem .
hpc:Datamanagerhost a owl:Class .
hpc:mountpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:string .
hpc:Lim a owl:Class .
hpc:mbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range hpc:Lim .
hpc:bctrld a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:string .
hpc:badmin a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:string .
hpc:xfernodeA rdf:type hpc:Host .
hpc:xfernodeB rdf:type hpc:Host .
hpc:xfernodeC rdf:type hpc:Host .
