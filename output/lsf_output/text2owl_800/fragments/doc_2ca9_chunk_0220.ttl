hpc:Lsfversion a owl:Class .
hpc:Fixpack a owl:Class .
hpc:blimits a owl:ObjectProperty .
hpc:gl a owl:DatatypeProperty .
hpc:c a owl:DatatypeProperty .
hpc:o a owl:DatatypeProperty .
hpc:hosts a owl:DatatypeProperty .
hpc:allremote a owl:DatatypeProperty .
hpc:Bmgroup a owl:Class .
hpc:cname a owl:DatatypeProperty .
hpc:Bmod a owl:Class .
hpc:mem a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:lsbSubMemUsage a owl:DatatypeProperty .
hpc:lsbSubSwpUsage a owl:DatatypeProperty .
hpc:zb a owl:DatatypeProperty .
hpc:datachk a owl:DatatypeProperty .
hpc:BmgroupLeasingModel a owl:Class .
hpc:multiclusterCapability a owl:ObjectProperty .
hpc:resourceLeasingModel a owl:ObjectProperty .
hpc:leasedinhosts a owl:DatatypeProperty .
hpc:allremoteexpand a owl:DatatypeProperty .
hpc:lsbBmgroupAllremoteExpand a owl:DatatypeProperty .
hpc:BmodCommand a owl:Class .
hpc:Esub a owl:Class .
hpc:rusage a owl:DatatypeProperty .
hpc:Version101 a owl:Class .
hpc:Fixpack10 rdfs:subClassOf hpc:Version101 .
hpc:Fixpack13 rdfs:subClassOf hpc:Version101 .
hpc:Fixpack1 rdfs:subClassOf hpc:Version101 .
hpc:Fixpack2 rdfs:subClassOf hpc:Version101 .
hpc:Fixpack9 rdfs:subClassOf hpc:Version101 .
hpc:BmgroupLeasingModel rdfs:subClassOf hpc:Lsfversion .
hpc:BmodCommand rdfs:subClassOf hpc:Lsfversion .

hpc:Blimits rdfs:domain hpc:Lsfversion ;
    rdfs:range hpc:Lsfversion ;
    rdfs:domain hpc:BlimitsOption ;
    rdfs:range hpc:Commandoption .

hpc:Gl rdfs:domain hpc:Blimits ;
    rdfs:range hpc:Resourcelimit .

hpc:C rdfs:domain hpc:Blimits ;
    rdfs:range hpc:Globalpolicy .

hpc:O rdfs:domain hpc:Blimits ;
    rdfs:range hpc:Resourceconfiguration .

hpc:Hosts rdfs:domain hpc:BmgroupLeasingModel ;
    rdfs:range xsd:string .

hpc:Allremote rdfs:domain hpc:BmgroupLeasingModel ;
    rdfs:range xsd:string .
