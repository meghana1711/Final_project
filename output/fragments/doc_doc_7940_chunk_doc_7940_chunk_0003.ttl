hpc:FederatedJobID a owl:Class .
hpc:localJobID a owl:DatatypeProperty ;
    rdfs:domain hpc:FederatedJobID ;
    rdfs:range xsd:unsignedInt .
hpc:clusterOriginID a owl:DatatypeProperty ;
    rdfs:domain hpc:FederatedJobID ;
    rdfs:range xsd:unsignedInt .

hpc:JobSubmission a owl:Class .
hpc:siblingJobs a owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmission .

hpc:Cluster a owl:Class .
hpc:eligibleCluster a owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmission ;
    rdfs:range hpc:Cluster .

hpc:ClusterFeature a owl:Class .
hpc:hasFeature a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:List .

hpc:SubmissionCommand a owl:Class .
hpc:pickedCluster a owl:ObjectProperty ;
    rdfs:domain hpc:SubmissionCommand .
hpc:viableClusters a owl:ObjectProperty ;
    rdfs:domain hpc:SubmissionCommand .

hpc:ClusterConstraint a owl:Class .
hpc:constraintList a owl:DatatypeProperty ;
    rdfs:domain hpc:ClusterConstraint ;
    rdfs:range rdf:List .
hpc:clusterFeatureList a owl:DatatypeProperty ;
    rdfs:domain hpc:ClusterConstraint ;
    rdfs:range rdf:List .
```
