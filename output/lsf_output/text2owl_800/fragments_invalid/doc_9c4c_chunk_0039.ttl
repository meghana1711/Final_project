hpc:LsfTardir a owl:Class ;
    rdfs:comment "Full path to the directory that contains the LSF distribution TAR files." ;
    rdfs:subClassOf owl:Class ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string ;
    rdfs:label "LSF_TARDIR" ;
    owl:hasValue hpc:DefaultValue ;
    owl:hasValue hpc:DefaultTarDir .

hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:comment "Default value of the LSF_TARDIR parameter." ;
    rdfs:domain hpc:LsfTardir ;
    rdfs:range xsd:string ;
    rdfs:label "Default" ;
    owl:hasValue "" .

hpc:DefaultTarDir a owl:NamedIndividual ;
    rdfs:label "Default value of the LSF_TARDIR parameter." ;
    hpc:hasDefaultValue "." ;
    hpc:hasExample "/usr/share/lsf_distrib" .

hpc:LsfTop a owl:Class ;
    rdfs:comment "Required. Full path to the top level LSF installation directory." ;
    rdfs:subClassOf owl:Class ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string ;
    rdfs:label "LSF_TOP" ;
    owl:hasValue hpc:Required ;
    owl:hasValue hpc:FullPath ;
    owl:hasValue hpc:SharedAccess ;
    owl:hasValue hpc:SufficientDiskSpace ;
    owl:hasValue hpc:NotRootDirectory ;
    owl:hasValue hpc:NoDefaultValue .

hpc:required a owl:DatatypeProperty ;
    rdfs:comment "This is a required variable." ;
    rdfs:domain hpc:LsfTop ;
    rdfs:range xsd:string ;
    rdfs:label "Required" ;
    owl:hasValue "true" .

hpc:fullpath a owl:DatatypeProperty ;
    rdfs:comment "The path to the LSF_TOP directory must be shared and accessible to all hosts in the cluster." ;
    rdfs:domain hpc:LsfTop ;
    rdfs:range xsd:string ;
    rdfs:label "FullPath" ;
    owl:hasValue "true" .

hpc:sharedaccess a owl:DatatypeProperty ;
    rdfs:comment "The path to the LSF_TOP directory must be shared and accessible to all hosts in the cluster." ;
    rdfs:domain hpc:LsfTop ;
    rdfs:range xsd:string ;
    rdfs:label "SharedAccess" ;
    owl:hasValue "true" .

hpc:sufficientdiskspace a owl:DatatypeProperty ;
    rdfs:comment "The ﬁle system that contains the LSF_TOP directory must have enough disk space for all host types (approximately 300 MB per host type)." ;
    rdfs:domain hpc:LsfTop ;
    rdfs:range x
