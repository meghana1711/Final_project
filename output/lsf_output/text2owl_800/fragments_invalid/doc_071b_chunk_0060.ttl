hpc:Jobcwd a owl:Class ;
    rdfs:subClassOf hpc:Directory .

hpc:Submittedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Hascwd hpc:objectproperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range hpc:Jobcwd .

hpc:Defaultjobcwd hpc:datatypeproperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:Jobcwdparameter hpc:datatypeproperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:Lsbjobcwd hpc:datatypeproperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .

hpc:Jobcwdttl hpc:datatypeproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Dynamicpattern hpc:objectproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range hpc:Dynamicpatternstring .

hpc:Sharedcwd hpc:objectproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range hpc:Jobcwd .

hpc:Uniquecwd hpc:objectproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range hpc:Jobcwd .

hpc:Creationfailedcwd hpc:objectproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range hpc:Jobcwd .

hpc:Homedirectory hpc:datatypeproperty ;
    rdfs:domain hpc:User .

hpc:Executionhost hpc:objectproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range hpc:Host .

hpc:Sharedfilesystem hpc:objectproperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Filesystem .

hpc:Bsubcwd hpc:objectproperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .

hpc:Breqqueuecommand hpc:objectproperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .

hpc:Bmigcommand hpc:objectproperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string .

hpc:Paralleljob hpc:class ;
    rdfs:subClassOf hpc:Submittedjob .

hpc:Blauunchcommand hpc:objectproperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:string .

hpc:Sharedcwdenabledttl hpc:datatypeproperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:boolean .
