hpc:PoolSpecification a owl:Class .
hpc:PoolSpecification rdfs:subClassOf xsd:string .

hpc:CapacitySpecification a owl:Class .
hpc:CapacitySpecification rdfs:subClassOf xsd:decimal .

hpc:hasPoolSpecification hpc:Job a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:PoolSpecification .

hpc:hasCapacitySpecification hpc:Job a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:CapacitySpecification .

hpc:Unit a owl:Class .
hpc:Unit rdfs:subClassOf xsd:string .

hpc:supportsUnit hpc:CapacitySpecification a owl:ObjectProperty ;
    rdfs:domain hpc:CapacitySpecification ;
    rdfs:range hpc:Unit .

hpc:KB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "1E3"^^xsd:double .
hpc:MB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "1E6"^^xsd:double .
hpc:GB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "1E9"^^xsd:double .
hpc:TB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "1E12"^^xsd:double .
hpc:PB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "1E15"^^xsd:double .
hpc:KiB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "2E3"^^xsd:double .
hpc:MiB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "2E6"^^xsd:double .
hpc:GiB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "2E9"^^xsd:double .
hpc:TiB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "2E12"^^xsd:double .
hpc:PiB a hpc:Unit ;
    hpc:equivalentTo xsd:decimal "2E15"^^xsd:double .
```
