hpc:Checkpointablejob a owl:Class .
hpc:Checkpointcommand a owl:Class .
hpc:Restartcommand a owl:Class .
hpc:Migratecommand a owl:Class .
hpc:Bqueuecommand a owl:Class .

hpc:bchkpnt a owl:ObjectProperty .
hpc:brestart a owl:ObjectProperty .
hpc:bmig a owl:ObjectProperty .
hpc:bqueues a owl:ObjectProperty .

hpc:JobId rdfs:domain hpc:Checkpointcommand ;
          rdfs:domain hpc:Restartcommand ;
          rdfs:domain hpc:Migratecommand .

hpc:CheckpointPeriod rdfs:range xsd:nonNegativeInteger ;
                       rdfs:domain hpc:Checkpointcommand .

hpc:periodicCheckpointing rdf:type owl:ObjectProperty ;
                            rdfs:domain hpc:Checkpointcommand ;
                            rdfs:range hpc:Checkpointablejob .

hpc:kill rdf:type owl:ObjectProperty ;
        rdfs:domain hpc:Checkpointcommand .

hpc:disablePeriodicCheckpointing rdf:type owl:ObjectProperty ;
                                   rdfs:domain hpc:Checkpointcommand .

hpc:Firstavailablehost rdfs:range xsd:string ;
                      rdfs:domain hpc:Restartcommand .

hpc:Specifiedhostorhostgroup rdfs:range xsd:string ;
                             rdfs:domain hpc:Restartcommand .

hpc:Checkpointableorrerunnable rdfs:range hpc:Checkpointablejob ;
                              rdfs:domain hpc:Migratecommand .

hpc:Checkpointdirectory rdfs:range xsd:string ;
                       rdfs:domain hpc:Bqueuecommand .

hpc:Checkpointperiod rdfs:range xsd:nonNegativeInteger ;
                    rdfs:domain hpc:Bqueuecommand .
