hpc:Slurmsystem a owl:Class.
hpc:Systemconf a owl:Class.
hpc:Joincontroller a owl:Class.
hpc:Cgroupcontroller a owl:Class.
hpc:Usesjoincontrollerdomain rdfs:domain hpc:Slurmsystem ;
    rdfs:range hpc:Joincontroller.
hpc:Doesnotusejoincontroller a owl:Class ;
    rdfs:subClassOf hpc:Slurmsystem ;
    rdfs:subClassOf ( rdf:type owl:Class ;
                        rdfs:subClassOf hpc:Systemconf ) .
h
