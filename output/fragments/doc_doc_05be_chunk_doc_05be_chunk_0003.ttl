hpc:SLURMCommandLineInterface a owl:Class .
hpc:SLURMOptionDataStructure rdf:type owl:Class .
hpc:CLIHook a owl:Class .
hpc:EarlyPass a owl:Class .
hpc:MainPass a owl:Class .

hpc:processesCLIOptions a owl:ObjectProperty ;
    rdfs:domain hpc:SLURMCommandLineInterface ;
    rdfs:range hpc:CLIHook .

hpc:isEarlyPass a owl:DatatypeProperty ;
    rdfs:domain hpc:CLIHook ;
    rdfs:range xsd:boolean .

hpc:SLURM_SUCCESS a xsd:integer ;
hpc:SLURM_ERROR a xsd:integer .

hpc:CLI_Filter_P_Setup_Defaults a hpc:CLIHook ;
    rdfs:subClassOf hpc:CLIHook .
hpc:CLI_Filter_P_Pre_Submit a hpc:CLIHook ;
    rdfs:subClassOf hpc:CLIHook .

hpc:slurm_opt_t a hpc:SLURMOptionDataStructure .
hpc:slurm_opt_t rdfs:subClassOf hpc:CLIHook .
