hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A queue for managing jobs in a high performance computing system." .

hpc:Highpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue with higher suspension thresholds than a low priority queue." .

hpc:Lowpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue with lower suspension thresholds than a high priority queue." .

hpc:suspensionthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A unit of work to be executed in a high performance computing system." .

hpc:suspensioncondition a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirementstring ;
    rdfs:comment "The condition for suspending a job." .

hpc:Resourcerequirementstring a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "A string used to define the condition for suspending a job." .

hpc:Select a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementstring ;
    rdfs:comment "A section of the resource requirement string used for stopping a job." .

hpc:Cs a owl:Class ;
    rdfs:subClassOf xsd:boolean ;
    rdfs:comment "A Boolean resource indicating that a host is a compute server." .

hpc:idletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The idle time for a desktop machine." .

hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of memory available on a compute server." .

hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of swap space available on a compute server." .

hpc:loadstop a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Loadthresholds ;
    rdfs:comment "The load thresholds for loadStop." .

hpc:Loadthresholds a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Thresholds for loadStop." .
