hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a reservation in the HPC system." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Advancereservationjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents an advance reservation job in the HPC system." .

