hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Cluster a owl:Class .
hpc:Queue a owl:Class .
hpc:Exechost a owl:Class .
hpc:Jobname a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:state a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:exechostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Exechost ;
    rdfs:range xsd:string .
hpc:jobnamename a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobname ;
    rdfs:range xsd:string .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:forwardtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:submissionclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
hpc:executionclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
hpc:leaseclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:forwarded a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:forwardedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Forwarded ;
    rdfs:range xsd:dateTime .
hpc:forwardedtocluster a owl:ObjectProperty ;
    rdfs:domain hpc:Forwarded ;
    rdfs:range hpc:Cluster .
hpc:Jobexception a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:exceptionconfiguredinlsbqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Jobexception ;
    rdfs:range hpc:Queue .
hpc:Cannotbeusedwithoptions a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:cannotbeusedwithoptiona a owl:DatatypeProperty ;
    rdfs:domain hpc:Cannotbeusedwithoptions ;
    rdfs:range xsd:string .
