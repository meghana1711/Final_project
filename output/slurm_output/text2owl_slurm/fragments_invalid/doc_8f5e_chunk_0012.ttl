@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Upgrade a owl:Class.
hpc:Properoperation hpc:Upgrade rdfs:subClassOf owl:ObjectProperty.
hpc:Properoperation rdfs:domain hpc:Upgrade;
    rdfs:range rdf:List;
    rdfs:comment "Validate proper operation, such as communication with the controller and a job's ability to successfully start and finish." .

hpc:Communicationwithcontroller hpc:properoperation rdf:first.
hpc:Jobstartsuccess hpc:properoperation rdf:first.

hpc:Slurmdtimeout hpc:Configurablevalue a owl:Class.
hpc
