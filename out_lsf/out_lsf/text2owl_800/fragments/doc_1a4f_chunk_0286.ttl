hpc:Job a owl:Class .
hpc:runtimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runtimeestimate a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:defaulthostspec a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Cluster a owl:Class .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Cluster .
hpc:Host a owl:Class .
hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:normalizationhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:cpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hostspecification a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:string .
hpc:executionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:normalizedcputimedisplay a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:bacct a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:bhist a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:bqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:defaulthostspecinqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:defaulthostspecinparams a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:priority a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
