hpc:Datamanagerhost a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Datamanager a owl:Class .
hpc:lsfdataport a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanagerhost ;
    rdfs:range xsd:integer .
hpc:lsfdatahosts a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range rdf:List .
hpc:local a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatahosts ;
    rdfs:range xsd:string .
hpc:lsfdataportvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Local ;
    rdfs:range xsd:string .
hpc:Datamanagercluster a owl:Class .
hpc:clustermasterstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanagercluster ;
    rdfs:range xsd:string .
hpc:HostDM a hpc:DataManagerHost .
hpc:hostM a hpc:ManagementHost .
hpc:cluster1 a hpc:DataManagerCluster ;
    hpc:ClusterMasterStatus "ok" .
hpc:hostA a hpc:DataManagerHost .
