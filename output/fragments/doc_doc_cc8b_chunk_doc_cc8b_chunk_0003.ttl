hpc:TRES a owl:Class .
hpc:AccountingTRES a owl:Class .
hpc:BillingTRES a owl:Class .
hpc:PriorityWeightTRES a owl:Class .
hpc:Applicable a owl:ObjectProperty .
hpc:Applicable rdfs:domain hpc:TRES ;
                      rdfs:range hpc:PriorityType .
hpc:PriorityType a owl:Class .
hpc:Configured a owl:ObjectProperty .
hpc:Configured rdfs:domain hpc:TRES ;
                      rdfs:range hpc:AccountingStorageTRES .
hpc:TRESBillingWeights a owl:DatatypeProperty .
hpc:TRESBillingWeights rdfs:domain hpc:Partition .
hpc:TRESBillingWeights rdfs:range xsd:string .
hpc:BillingWeight a owl:DatatypeProperty .
hpc:BillingWeight rdfs:domain hpc:TRES ;
                      rdfs:range xsd:decimal .
hpc:BillingWeightSuffix a owl:DatatypeProperty .
hpc:BillingWeightSuffix rdfs:domain hpc:BillingWeight ;
                          rdfs:range xsd:string .
hpc:CPU a hpc:TRES ;
           hpc:BillingWeight "1.0" ;
           hpc:BillingWeightSuffix "" .
hpc:Mem a hpc:TRES ;
           hpc:BillingWeight "0.25G" ;
           hpc:BillingWeightSuffix "G" .
hpc:GRES_gpu a hpc:TRES ;
           hpc:BillingWeight "2.0" ;
           hpc:BillingWeightSuffix "" .
```
