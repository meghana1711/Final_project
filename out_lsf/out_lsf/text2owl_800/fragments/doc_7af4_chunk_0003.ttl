hpc:lsbglobalpolicies a owl:ObjectProperty ;
    rdfs:domain hpc:Globalpolicies ;
    rdfs:range xsd:string .

hpc:Hostconfiguration a owl:Class .
hpc:lsbhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Hostconfiguration ;
    rdfs:range xsd:string .

hpc:Hostgroup a owl:Class ;
    rdfs:subClassOf hpc:Hostconfiguration .

hpc:Hostpartition a owl:Class ;
    rdfs:subClassOf hpc:Hostconfiguration .

hpc:Computeunit a owl:Class ;
    rdfs:subClassOf hpc:Hostconfiguration .

hpc:Moduleconfiguration a owl:Class .
hpc:lsbmodules a owl:ObjectProperty ;
    rdfs:domain hpc:Moduleconfiguration ;
    rdfs:range xsd:string .

hpc:Pluginmodule a owl:Class ;
    rdfs:subClassOf hpc:Moduleconfiguration .

hpc:Generalparameters a owl:Class .
hpc:lsbparams a owl:ObjectProperty ;
    rdfs:domain hpc:Generalparameters ;
    rdfs:range xsd:string .

hpc:Batchqueues a owl:Class .
