hpc:Slurmrestd a owl:Class .
hpc:Slurmconf a owl:Class .
hpc:runtimeargs a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range rdf:List .

hpc:slurmconffile a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmconf .

hpc:Oas a owl:Class ;
    rdfs:subClassOf owl:Documentation .

hpc:slurmrestdfunctionality a owl:ObjectProperty ;
    rdfs:domain hpc:Oas ;
    rdfs:range rdf:List .

hpc:invalidprerequisite a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestdfunctionality ;
    rdfs:range hpc:Slurmrestdfunctionality .

hpc:Slurmrestdplugin a owl:Class .
hpc:slurmrestdpluginloading a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range rdf:List .

hpc:slurmrestdpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmrestd ;
    rdfs:range xsd:string .

hpc:slurmrestdversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmrestdpath ;
    rdfs:range xsd:string .

hpc:slurmrestdquery a owl:ObjectProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range hpc:Slurmrestdpath .

hpc:slurmrestdqueryresponse a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestdquery ;
    rdfs:range rdf:List .

hpc:slurmrestdqueryerror a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmrestdqueryresponse ;
    rdfs:range xsd:integer .

hpc:slurmrestdversionmismatch a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestdqueryerror ;
    rdfs:range hpc:Slurmrestdversion .

hpc:slurmrestdbug a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmrestdqueryerror ;
    rdfs:range rdf:List .

hpc:slurmrestdbugreport a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmrestdbug ;
    rdfs:range xsd:string .

hpc:Client a owl:Class .
hpc:clientoas a owl:DatatypeProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range rdf:List .

hpc:clientquerypath a owl:DatatypeProperty ;
    rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
