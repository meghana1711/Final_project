hpc:Slurmrestdservice a owl:Class .
hpc:Slurmrestdenvironmentfile a owl:Class .
hpc:slurmrestdoption a owl:ObjectProperty .
hpc:Hasslurmrestdoption rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .
hpc:slurmrestdlisten a owl:ObjectProperty .
hpc:Hasslurmrestdlisten rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .
hpc:slurmrestdenvironmentfilevalue a owl:DatatypeProperty .
hpc:Hasslurmrestdenvironmentfilevalue rdfs:domain hpc:Slurmrestdenvironmentfile ;
    rdfs:range xsd:string .
hpc:systemdedit a owl:ObjectProperty .
hpc:Usessystemdedit rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .
hpc:slurmrestdenvironment a owl:DatatypeProperty .
hpc:Hasslurmrestdenvironment rdfs:domain hpc:Slurmrestdservice ;
    rdfs:range xsd:string .
hpc:Slurmrestdoverridefile a owl:Class .
hpc:Slurmrestdoverridefile rdfs:subClassOf hpc:Slurmrestdenvironmentfile .
hpc:serviceeditsection a owl:ObjectProperty .
hpc:Hasserviceeditsection rdfs:domain hpc:Slurmrestdoverridefile ;
    rdfs:range xsd:string .
hpc:environmentvariablesetting a owl:DatatypeProperty .
hpc:Hasenvironmentvariablesetting rdfs:domain hpc:Slurmrestdoverridefile ;
    rdfs:range xsd:string .
