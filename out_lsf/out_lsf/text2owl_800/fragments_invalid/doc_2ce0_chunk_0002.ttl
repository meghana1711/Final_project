hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in a High Performance Computing (HPC) system." .

# Slot
hpc:Slot a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a slot in an HPC system." .

# Task
hpc:Task a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a task within a job in an HPC system." .

# MemoryLimit
hpc:memorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum memory limit for a job in MB." .

# SwapLimit
hpc:swaplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum swap limit for a job in MB." .

# MemoryUsed
hpc:memoryused a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of memory used by a job in MB." .

# SwapUsed
hpc:swapused a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of swap used by a job in MB." .

# MaxMemory
hpc:maxmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum memory available for a job in MB." .

# Cgroup
hpc:Cgroup a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a cgroup in an HPC system." .

# MemoryCgroup
hds:MemoryCgroup a owl:Class ;
    rdfs:subClassOf hpc:Cgroup ;
    rdfs:comment "Represents a memory cgroup in an HPC system." .

# SwapCgroup
hpc:Swapcgroup a owl:Class ;
    rdfs:subClassOf hpc:Cgroup ;
    rdfs:comment "Represents a swap cgroup in an HPC system." .

# JobTerminationReason
hpc:Jobterminationreason a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the reason a job was terminated." .

# MemoryLimitExceeded
hpc:Memorylimitexceeded a owl:Class ;
    rdfs:subClassOf hpc:Jobterminationreason ;
    rdfs:comment "The job was terminated because it exceeded the memory limit." .

# JobStatus
hpc:Jobstatus a owl:Class ;
    rdfs:subClassOf owl:Class ;
