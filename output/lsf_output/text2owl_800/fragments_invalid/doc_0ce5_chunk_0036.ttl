hpc:Lsfmanagementhost a owl:Class .
hpc:Spectrumlsfresourceconnector a owl:Class .
hpc:Sbdconnection a owl:Class .
hpc:Host a owl:Class .
hpc:Losthost rdfs:subClassOf hpc:Host .
hpc:Foundhost rdfs:subClassOf hpc:Host .
hpc:maxsbdconns a owl:DatatypeProperty .
hpc:lsbmaxjobdispatchpersession a owl:DatatypeProperty .
hpc:schedulerthreads a owl:DatatypeProperty .
hpc:Largescalecluster a owl:Class .
hpc:multithreadedresourceevaluation a owl:ObjectProperty .
hpc:fastjobdispatch a owl:ObjectProperty .
hpc:continuousscheduling a owl:ObjectProperty .
hpc:resourcerequirementmatching a owl:ObjectProperty .
hpc:resourceevaluationforhostsconcurrently a owl:ObjectProperty .
hpc:jobdependencyevaluationlimit a owl:ObjectProperty .
hpc:updatelsfconfiguration a owl:ObjectProperty .
hpc:logintomanagementhost a owl:ObjectProperty .

hpc:Lsfmanagementhost rdfs:subClassOf rdf:Resource .
hpc:Spectrumlsfresourceconnector rdfs:subClassOf rdf:Resource .
hpc:Sbdconnection rdfs:subClassOf rdf:Resource .
hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Losthost rdfs:subClassOf hpc:Host .
hpc:Foundhost rdfs:subClassOf hpc:Host .

hpc:Maxsbdconns rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:integer .
hpc:Lsbmaxjobdispatchpersession rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:integer .
hpc:Schedulerthreads rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:integer .

hpc:Largescalecluster rdfs:subClassOf rdf:Resource .

hpc:Multithreadedresourceevaluation rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Fastjobdispatch rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Continuousscheduling rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Resourcerequirementmatching rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Resourceevaluationforhostsconcurrently rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Jobdependencyevaluationlimit rdfs:domain hpc:Largescalecluster ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:Updatelsfconfiguration rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Lsfmanagementhost .

hpc:LogIn
