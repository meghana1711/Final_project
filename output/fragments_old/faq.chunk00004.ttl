# Command
hpc:Command a owl:Class .

# Option
hpc:Option a owl:Class .

# Srun
hpc:Srun a owl:Class .
hpc:Srun rdfs:subClassOf hpc:Command .

# SrunOption
hpc:SrunOption a owl:Class .
hpc:SrunOption rdfs:subClassOf hpc:Option .

# SrunOptionOfSrun
hpc:SrunOptionOfSrun a owl:ObjectProperty .
hpc:SrunOptionOfSrun rdfs:domain hpc:Srun .
hpc:SrunOptionOfSrun rdfs:range hpc:SrunOption .

# SrunCommand
hpc:SrunCommand a owl:DatatypeProperty .
hpc:SrunCommand rdfs:domain hpc:Srun .
hpc:SrunCommand rdfs:range xsd:string .

# SrunOptions
hpc:SrunOptions a owl:DatatypeProperty .
hpc:SrunOptions rdfs:domain hpc:Srun .
hpc:SrunOptions rdfs:range xsd:string .

# --overcommit
hpc:Overcommit a hpc:SrunOption .

# --oversubscribe
hpc:Oversubscribe a hpc:SrunOption .

# --pty
hpc:Pty a hpc:SrunOption .

# --unbuffered
hpc:Unbuffered a hpc:SrunOption .

# --nodes
hpc:Nodes a hpc:SrunOption .

# --ntasks
hpc:Ntasks a hpc:SrunOption .

# sbatch
hpc:Sbatch a owl:Class .
hpc:Sbatch rdfs:subClassOf hpc:Command .

# JobArray
hpc:JobArray a owl:Class .

# FaultTolerance
hpc:FaultTolerance a owl:Class .

# InteractiveMode
hpc:InteractiveMode a owl:Class .

# RemoteTerminal
hpc:RemoteTerminal a owl:Class .

# X11Display
hpc:X11Display a owl:Class .
```
