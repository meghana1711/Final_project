hpc:Environment a owl:Class .
hpc:Job a owl:Class .
hpc:workingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string .
hpc:environmentvariables a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string .
hpc:systemsettings a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string .
hpc:shareduserdirectories a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string .
hpc:currentworkingdirectoryobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range hpc:Remotehost .
hpc:unchangedsearchpaths a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:string .
hpc:Mixedcluster a owl:Class .
hpc:userbinarydirectories a owl:DatatypeProperty ;
    rdfs:domain hpc:Mixedcluster ;
    rdfs:range xsd:string .
hpc:sharedconfigurationfiles a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Ego a owl:Class .
hpc:systeminfrastructure a owl:DatatypeProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range xsd:string .
hpc:Resource a owl:Class .
hpc:Applicationresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Physicalresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Logicalresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Cpuslot a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Egoresourcedistributionplan a owl:Class .
hpc:Resourcemanager a owl:Class .
hpc:Egoresourcemanager a owl:Class ;
    rdfs:subClassOf hpc:Resourcemanager .
hpc:lsfresourcesharing a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Egoresourcedistributionplan .
hpc:lsfresourcerequest a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Egoresourcemanager .
