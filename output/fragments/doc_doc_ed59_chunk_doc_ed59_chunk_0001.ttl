hpc:jobcompKafkaStartInfo a owl:ObjectProperty ;
                          rdfs:domain hpc:SlurmVersion25_05 ;
                          rdfs:range xsd:boolean .

hpc:switchHPE_SlingshotRanksPerNodeMoreThan252 a owl:DatatypeProperty ;
                                               rdfs:domain hpc:SlurmVersion25_05 ;
                                               rdfs:range xsd:integer .

hpc:switchHPE_SlingshotMTLSAuth a owl:ObjectProperty ;
