hpc:AssociationResponse a owl:Class .
hpc:OpenapiAssocsResp rdf:type hpc:AssociationResponse ;
    rdfs:subClassOf hpc:AssociationResponse .

hpc:OpenapiAssocsRemovedResp rdf:type hpc:OpenapiAssocsResp .

hpc:OpenapiAssocsAddedResp rdf:type hpc:OpenapiAssocsResp .

hpc:AssocsDeleteResponse a owl:Class ;
    rdfs:subClassOf hpc:AssociationResponse .

hpc:AssocsGetRequest a owl:Class ;
    rdfs:subClassOf hpc:AssocsDeleteResponse ;
    rdfs:subClassOf hpc:AssociationResponse .

hpc:AssocsPostRequest a owl:Class ;
    rdfs:subClassOf hpc:AssocsDeleteResponse ;
    rdfs:subClassOf hpc:AssociationResponse .

hpc:hasContent a owl:ObjectProperty ;
    rdfs:domain hpc:AssocsDeleteResponse ;
    rdfs:range xsd:anyURI .

hpc:hasSchema a owl:ObjectProperty ;
    rdfs:domain hpc:hasContent ;
    rdfs:range xsd:anyURI .

hpc:hasYAMLSchema a owl:ObjectProperty ;
    rdfs:domain hpc:hasContent ;
    rdfs:range xsd:anyURI .

hpc:hasJSONRequestSchema a owl:ObjectProperty ;
    rdfs:domain hpc:hasContent ;
    rdfs:range xsd:anyURI .

hpc:hasApplicationYAMLContent a owl:ObjectProperty ;
    rdfs:domain hpc:AssocsDeleteResponse ;
    rdfs:range xsd:anyURI .

hpc:hasApplicationJSONRequest a owl:ObjectProperty ;
    rdfs:domain hpc:AssocsGetRequest ;
    rdfs:range xsd:anyURI .

hpc:hasApplicationXYAMLContent a owl:ObjectProperty ;
    rdfs:domain hpc:AssocsGetRequest ;
    rdfs:range xsd:anyURI .

hpc:hasTextYAMLContent a owl:ObjectProperty ;
    rdfs:domain hpc:AssocsGetRequest ;
    rdfs:range xsd:anyURI .
```
