hpc:Dynamicuserpriority a owl:Class .
hpc:numbershares a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:jobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:DefaultCpuTimeFactor a xsd:decimal .
hpc:DefaultRunTimeFactor a xsd:decimal .
hpc:decayedruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range hpc:Job .
hpc:historicalruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range hpc:Finishedjob .
hpc:committedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:memoryusageadjustment a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:decimal .
hpc:Job a owl:Class .
hpc:Finishedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Queuelevelfairshare a owl:Class .
hpc:Hostpartitionfairshare a owl:Class .
hpc:Queuebasedfairshare a owl:Class .
hpc:Userbasedfairshare a owl:Class .
hpc:queuelevelresourceconsumption a owl:ObjectProperty ;
    rdfs:domain hpc:Queuelevelfairshare ;
    rdfs:range hpc:Job .
hpc:hostpartitionresourceconsumption a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartitionfairshare ;
    rdfs:range hpc:Job .
hpc:queuebasedresourceconsumption a owl:ObjectProperty ;
    rdfs:domain hpc:Queuebasedfairshare ;
    rdfs:range hpc:Job .
hpc:defaultdynamicpriorityformula a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicuserpriority ;
    rdfs:range xsd:string .
