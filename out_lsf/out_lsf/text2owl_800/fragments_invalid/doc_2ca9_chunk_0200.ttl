hpc:Aixjob a owl:Class .
hpc:Aixjob rdfs:subClassOf owl:Class .

hpc:Lsf a owl:Class .
hpc:Lsf rdfs:subClassOf owl:Class .

hpc:Lsf101 a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:comment "LSF version 10.1 with specific limitations." .

hpc:Tclparserissue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Issue with TCL parser on AIX." .

hpc:lsfStrictResreq a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Parameter in lsf.conf file that can cause jobs to pend on AIX." .

hpc:Aixhost a owl:Class .
hpc:Aixhost rdfs:subClassOf owl:Class .

hpc:Fixpack a owl:Class .
hpc:Fixpack rdfs:subClassOf owl:Class .

hpc:Hostcachefile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "File used by LSF to store host information." .

hpc:uuidcolumn a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostcachefile ;
    rdfs:range xsd:string ;
    rdfs:comment "Column in hostcache file that stores the UUID of a host." .

hpc:Dynamichost a owl:Class .
hpc:Dynamichost rdfs:subClassOf owl:Class .

hpc:Managementlim a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Limitation in LSF that manages resources." .

hpc:decaybehavior a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a resource's usage decays or not." .

hpc:Localresource a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Resource that is local to a cluster." .

hpc:Globalresource a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Resource that is global to all clusters." .

hpc:limit a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Limitvalue .

hpc:LimitValue a xsd:decimal .

hpc:afinityresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinityrequirement .

hpc:Affinityrequirement a owl:Class .

hpc:putype a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
