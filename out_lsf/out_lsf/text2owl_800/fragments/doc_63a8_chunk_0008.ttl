hpc:Datatransferjob a owl:Class .
hpc:Datastaging a owl:Class .
hpc:datastagein a owl:ObjectProperty ;
    rdfs:domain hpc:Datastaging ;
    rdfs:range hpc:Datatransferjob .
hpc:datastageout a owl:ObjectProperty ;
    rdfs:domain hpc:Datastaging ;
    rdfs:range rdf:Resource .
hpc:JobExecutionHost rdf:type owl:Class .
hpc:StagingArea rdf:type owl:Class .
hpc:DataSourceRepository rdf:type owl:Class .
hpc:DataSpec rdf:type owl:Class .
hpc:JobCache rdf:type owl:Class .
hpc:JobDataRequirement rdf:type owl:Class ;
    rdfs:subClassOf hpc:Dataspec .
hpc:Transferjob a owl:Class ;
    rdfs:subClassOf hpc:Datatransferjob ;
    rdfs:subClassOf hpc:Job .
hpc:DataStageInCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datastaging ;
    rdfs:range xsd:string .
hpc:DataStageOutCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datastaging ;
    rdfs:range xsd:string .
hpc:bstageincommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferjob ;
    rdfs:range xsd:string .
hpc:bstageoutcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datatransferjob ;
    rdfs:range xsd:string .
hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
