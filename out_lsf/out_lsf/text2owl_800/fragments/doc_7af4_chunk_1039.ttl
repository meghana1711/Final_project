hpc:Jobarray a owl:Class .
hpc:jobname a owl:ObjectProperty .
hpc:Jobname rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:string .
hpc:jobindexstep a owl:DatatypeProperty .
hpc:Jobindexstep rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:jobnamesetduringexecution a owl:ObjectProperty .
hpc:Jobnamesetduringexecution rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:boolean .
hpc:jobnamedefault a owl:ObjectProperty .
hpc:Jobnamedefault rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:string .
hpc:jobnamelengthlimit a owl:DatatypeProperty .
hpc:Jobnamelengthlimit rdfs:domain hpc:Jobname ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:jobnamespecifiedbyuser a owl:ObjectProperty .
hpc:Jobnamespecifiedbyuser rdfs:domain hpc:Job ;
                 rdfs:range xsd:boolean .
hpc:Job a owl:Class .
hpc:jobnamejob a owl:ObjectProperty .
hpc:Jobnamejob rdfs:domain hpc:Job ;
                 rdfs:range hpc:Jobname .
hpc:jobrequeued a owl:ObjectProperty .
hpc:Jobrequeued rdfs:domain hpc:Job ;
                 rdfs:range xsd:boolean .
hpc:jobpostexecsetby a owl:ObjectProperty .
hpc:Jobpostexecsetby rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:jobpgids a owl:ObjectProperty .
hpc:Jobpgids rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:jobpids a owl:ObjectProperty .
hpc:Jobpids rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
