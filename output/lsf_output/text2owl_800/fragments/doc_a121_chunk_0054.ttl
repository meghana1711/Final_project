hpc:jobinputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:joboutputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobcommandfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobspooling a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Spooledfile .

hpc:Spooledfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:filespoolingoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Filespoolingoption .

hpc:filespoolingoptionforinput a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:FileSpoolingOption ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobinputfile .

hpc:filespoolingoptionforoutput a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:FileSpoolingOption ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joboutputfile .

hpc:filespoolingoptionforcommand a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:FileSpoolingOption ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobcommandfile .

hpc:jobidparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:indexidparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobSpoolDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparameters ;
    rdfs:range xsd:string .

hpc:Lsbparameters a owl:Class .
