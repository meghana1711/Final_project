hpc:Usergroup a owl:Class .
hpc:Keyuser a owl:Class .

hpc:Hasusergroup rdfs:domain hpc:User .
hpc:Hasusergroup rdfs:range hpc:Usergroup .

hpc:Queue a owl:Class .
hpc:Queuename rdfs:domain hpc:Queue .
hpc:Queuename rdfs:range xsd:string .

hpc:Fairshare rdfs:domain hpc:Queue .
hpc:Fairshare rdfs:range rdf:List .
hpc:fairShare rdfs:subPropertyOf hpc:hasUserGroup .

hpc:Usershare a owl:Class .
hpc:Usershare rdfs:subClassOf rdf:List .
hpc:Usershare rdfs:range [ hpc:Usergroup , xsd:integer ] .

hpc:ProductionQueue a hpc:Queue .
hpc:production rdf:type hpc:queueName ;
    hpc:fairShare [ hpc:key_users@ , 2000 ] .
