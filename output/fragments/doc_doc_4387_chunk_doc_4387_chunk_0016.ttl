hpc:MySQLUser a owl:Class .
hpc:hasPassword rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:MySQLUser ;
    rdfs:range xsd:string .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:MySQLUser ;
    rdfs:range xsd:string .
hpc:GrantedPrivilege a owl:Class .
hpc:onDatabase rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GrantedPrivilege ;
    rdfs:range xsd:string .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GrantedPrivilege ;
    rdfs:range hpc:MySQLUser .
hpc:MySQLConnection a owl:Class ;
    rdfs:subClassOf hpc:MySQLUser .
