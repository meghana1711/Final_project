               rdfs:range xsd:boolean .
hpc:Cannothavesomejobsnotpartofserviceclass rdfs:domain hpc:Jobgroup ;
                 rdfs:range xsd:boolean .
hpc:Multiplejobgroupsallowed rdfs:domain hpc:Sla ;
               rdfs:range xsd:boolean .
hpc:Submitadditionaljobs rdfs:domain hpc:Jobgroup ;
               rdfs:range xsd:boolean .
hpc:Createifnotexists rdfs:domain hpc:Jobgroup ;
               rdfs:range xsd:boolean .
hpc:Specifyserviceclasswhencreate rdfs:domain hpc:Jobgroup ;
                 rdfs:range xsd:boolean .
hpc:Viewjobgroupsattachedtotimebasedsla rdfs:domain rdf:Resource ;
                 rdfs:range rdf:List .
hpc:bjgroup a owl:ObjectProperty .
hpc:GroupName rdfs:domain hpc:Bjgroup ;
               rdfs:range xsd:string .
hpc:Njobs rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Pend rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Run rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Ssusp rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Ususp rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Finish rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:dateTime .
hpc:Sla rdfs:domain hpc:Bjgroup ;
              rdfs:range hpc:Sla .
hpc:Jlimit rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Owner rdfs:domain hpc:Bjgroup ;
              rdfs:range xsd:string .
