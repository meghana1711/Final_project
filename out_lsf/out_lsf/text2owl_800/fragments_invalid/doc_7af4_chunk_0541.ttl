hpc:Jobslotlimit a owl:Class .
hpc:slotsPerProcessor a owl:DatatypeProperty .
hpc:perHost a owl:ObjectProperty .
hpc:hosts a owl:ObjectProperty .

rdfs:domain hpc:SlotsPerProcessor rdf:Resource .
rdfs:domain hpc:PerHost rdf:Resource .
rdfs:domain hpc:Hosts rdf:Resource .

rdfs:range hpc:SlotsPerProcessor xsd:nonNegativeFloat .
rdfs:range hpc:PerHost xsd:Boolean .
rdfs:range hpc:Hosts rdf:List .

hpc:SLOTS_PER_PROCESSOR rdfs:subPropertyOf hpc:ResourceConfiguration .
hpc:PER_HOST rdfs:subPropertyOf hpc:SLOTS_PER_PROCESSOR .
hpc:HOSTS rdfs:subPropertyOf hpc:SLOTS_PER_PROCESSOR .

hpc:Maxjobslotsperprocessor a owl:Class .
hpc:Maxjobslotsperprocessor rdfs:subClassOf hpc:Jobslotlimit .

hpc:MaxJobSlotsPerProcessor rdf:value "The maximum number of job slots that each resource consumer can use per processor." .
hpc:MaxJobSlotsPerProcessor rdf:comment "This job slot limit is configured per processor so that multiprocessor hosts will automatically run more jobs." .

hpc:Enforcedonhost a owl:Class .
hpc:Enforcedonhost rdfs:subClassOf hpc:Jobslotlimit .

hpc:EnforcedOnHost rdf:value "The hosts on which the limit is to be enforced." .
hpc:EnforcedOnHost rdf:comment "The Limit section is ignored if SLOTS_PER_PROCESSOR is specified without PER_HOST, or with HOSTS." .

hpc:Defaultvalue a owl:Class .
hpc:Defaultvalue rdfs:subClassOf hpc:Jobslotlimit .

hpc:DefaultValue rdf:value "Empty parentheses () or a dash (-) to indicate the default value (no limit)." .
hpc:DefaultValue rdf:comment "Fields cannot be left blank." .

hpc:Maximizethroughput a owl:Class .
hpc:Maximizethroughput rdfs:subClassOf hpc:Jobslotlimit .

hpc:MaximizeThroughput rdf:value "Use this parameter to prevent a host from being overloaded with too many jobs, and to maximize the throughput of a machine." .
hpc:MaximizeThroughput rdf:comment "This number can be a fraction such as 0.5, so that it can also serve as a per-CPU limit on multiprocessor machines." .

hpc:Roundup a owl:Class .
hpc:Roundup rdfs:subClassOf hpc:Jobslotlimit .

hpc:RoundUp rdf:value "The number is rounded up to the nearest integer equal to or greater than the total job slot limits for a host." .
hpc:RoundUp rdf:comment "For example, if SLOTS_PER_PROCESSOR is 0.5, on a 4-CPU multiprocessor host, users can
