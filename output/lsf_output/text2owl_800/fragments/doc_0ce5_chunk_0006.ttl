hpc:Loadindex a owl:Class .
hpc:R15s a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "15-second CPU run queue length" .
hpc:R1m a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "1-minute CPU run queue length" .
hpc:R15m a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "15-minute CPU run queue length" .
hpc:Pg a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "Paging rate in pages per second" .
hpc:Swp a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "Available swap space" .
hpc:It a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "Interactive idle time" .
hpc:Ls a hpc:LoadIndex ;
    rdfs:subClassOf hpc:Loadindex ;
    rdfs:comment "Number of users logged in" .

hpc:hasthreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Loadindex ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Isbusy a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "LIM reports a host as busy" .

hpc:Isinteractive a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "Interactive jobs" .

hpc:Ismultiprocessor a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "Multiprocessor systems" .

hpc:effectiverunqueuelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Multiprocessorsystem ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Host a owl:Class .
