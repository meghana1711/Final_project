hpc:Mbatchdmessage a owl:Class .
hpc:Sbatchdmessage a owl:Class .

hpc:renewjob a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdmessage ;
    rdfs:range xsd:string .
hpc:renewjobfailed a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdmessage ;
    rdfs:range xsd:string .
hpc:lsfadmincheck a owl:ObjectProperty ;
    rdfs:domain hpc:Renewjobfailed ;
    rdfs:range xsd:string .
hpc:afscheck a owl:ObjectProperty ;
    rdfs:domain hpc:Renewjobfailed ;
    rdfs:range xsd:string .

hpc:logjobinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdmessage ;
    rdfs:range hpc:Logjobinfo .
hpc:logjobinfofailed a owl:DatatypeProperty ;
    rdfs:domain hpc:Logjobinfo ;
    rdfs:range xsd:string .
hpc:logdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Logjobinfo ;
    rdfs:range xsd:string .
