hpc:LSF_DATA_SKIP_GROUP_CHECK
    a owl:Class ;
    rdfs:comment "Ignored if the LSF data manager is not configured." ;
    rdfs:subClassOf owl:Boolean .

hpc:LSF_DATA_SSH_CMD
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the default SSH command.".

hpc:LSF_DATA_SCP_CMD
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the default SCP command.".

hpc:LSFConfiguration
    a owl:Class ;
    rdfs:comment "Configuration for LSF.".
