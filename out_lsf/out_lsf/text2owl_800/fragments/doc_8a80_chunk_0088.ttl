hpc:Project a owl:Class .
hpc:Feature a owl:Class .
hpc:Mode a owl:EnumClass .
hpc:Cluster a hpc:Mode .
hpc:project a owl:ObjectProperty .
hpc:Hasfeature rdfs:domain hpc:Project ;
    rdfs:range hpc:Feature .
hpc:Hasmode rdfs:domain hpc:Project ;
    rdfs:range hpc:Mode .
hpc:Servicedomain a owl:Class .
hpc:totallicenses a owl:DatatypeProperty .
hpc:Servicedomain rdfs:domain hpc:Project ;
    rdfs:range hpc:Servicedomain .
hpc:Totallicenses rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
