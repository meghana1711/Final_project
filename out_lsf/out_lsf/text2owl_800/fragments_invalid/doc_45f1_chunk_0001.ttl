hpc:Lsfcluster a owl:Class .
hpc:Lsfwebservice a owl:Class .
hpc:Lsfhost a owl:Class .
hpc:Lsfjob a owl:Class .
hpc:submitJob an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Lsfjob .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:dateTime .
hpc:Lsfuser a owl:Class .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:password a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:url a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .
hpc:cacert a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .
hpc:lwsstop a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
