hpc:Host a owl:Class .
hpc:hasstatus a owl:ObjectProperty .
hpc:isavailable a owl:DatatypeProperty .
hpc:isunavailable a owl:DatatypeProperty .
hpc:isclosedRc a owl:DatatypeProperty .
hpc:isopenstack a owl:DatatypeProperty .
hpc:hasjlU a owl:DatatypeProperty .
hpc:hasmaxNjobs a owl:DatatypeProperty .
hpc:hasrun a owl:DatatypeProperty .
hpc:hasssusp a owl:DatatypeProperty .
hpc:hasususp a owl:DatatypeProperty .
hpc:hasrsv a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Hasstatus rdfs:domain hpc:Host ;
                        rdfs:range xsd:string .
hpc:Isavailable rdfs:domain hpc:Host ;
                        rdfs:range xsd:boolean .
hpc:Isunavailable rdfs:domain hpc:Host ;
                        rdfs:range xsd:boolean .
hpc:IsclosedRc rdfs:domain hpc:Host ;
                        rdfs:range xsd:string .
hpc:Isopenstack rdfs:domain hpc:Host ;
                        rdfs:range xsd:string .
hpc:HasjlU rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:HasmaxNjobs rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:Hasrun rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:Hasssusp rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:Hasususp rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:Hasrsv rdfs:domain hpc:Host ;
                        rdfs:range xsd:nonNegativeInteger .
