hpc:Cluster1 a hpc:ExecutionCluster ;
    rdfs:label "cluster1" .
hpc:Cluster2 a hpc:ExecutionCluster ;
    rdfs:label "cluster2" .
hpc:Cluster3 a hpc:ExecutionCluster ;
    rdfs:label "cluster3" .

hpc:OrgA a hpc:Organization ;
    rdfs:label "OrgA" .
hpc:OrgB a hpc:Organization ;
    rdfs:label "OrgB" .

hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Project a owl:Class .
hpc:Organization a owl:Class .
hpc:Executioncluster a owl:Class .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Organization ;
    rdfs:range hpc:User .
hpc:hasgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Organization ;
    rdfs:range hpc:Group .
hpc:hasproject a owl:ObjectProperty ;
    rdfs:domain hpc:Organization ;
    rdfs:range hpc:Project .
hpc:isincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Organization .

hpc:usershares a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:decimal .
hpc:fspolicy a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:hasUser ;
                      owl:allValuesFrom hpc:User ] .
hpc:Projectgroup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:hasProject ;
                      owl:allValuesFrom hpc:Project ] .
hpc:Organizationgroup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:hasGroup ;
                      owl:allValuesFrom hpc:Organization ] .

hpc:beginusergroup a owl:ObjectProperty .
hpc:beginqueue a owl:ObjectProperty .

hpc:Group_Name a xsd:string .
hpc:Group_Member a xsd:string .
hpc:User_Shares a xsd:decimal .
hpc:Fs_Policy a xsd:string .

hpc:UserGroupInstance a hpc:UserGroup ;
    hpc:groupName "project_a" ;
    hpc:groupMember "user1" ;
    hpc:groupMember "user2" ;
    hpc:userShares "100" ;
    hpc:fsPolicy "" .
hpc:UserGroupInstance a hpc:UserGroup ;
    hpc:groupName "
