hpc:Cshrcfile a owl:Class .
hpc:Profilefile a owl:Class .
hpc:LsfConfdir a owl:Class .
hpc:EgoBindir a owl:Class .
hpc:EgoConfdir a owl:Class .
hpc:EgoEsrvdir a owl:Class .
hpc:EgoLibdir a owl:Class .
hpc:EgoLocalConfdir a owl:Class .
hpc:EgoServerdir a owl:Class .
hpc:EgoTop a owl:Class .

hpc:haslocation a owl:ObjectProperty ;
    rdfs:domain hpc:File .
    rdfs:range hpc:Location .

hpc:location a owl:DatatypeProperty .

hpc:CshrcfileHaslocation hpc:lsfConfdir .
hpc:ProfilefileHaslocation hpc:lsfConfdir .
hpc:LsfConfdir rdfs:subClassOf hpc:Directory .

hpc:setlsfenvironment a owl:ObjectProperty .
hpc:Setlsfenvironment rdfs:domain hpc:User .
hpc:Setlsfenvironment rdfs:range hpc:Action .

hpc:Action a owl:Class .

hpc:usecshrcfile a owl:ObjectProperty .
hpc:useprofilefile a owl:ObjectProperty .
hpc:makeclusteravailable a owl:ObjectProperty .

hpc:User a owl:Class .

hpc:CshrcfileIsusedby hpc:user .
hpc:ProfilefileIsusedby hpc:user .
hpc:MakeclusteravailableBy hpc:user .

hpc:cshrcFile_contents rdfs:subPropertyOf hpc:hasContent .
hpc:profileFile_contents rdfs:subPropertyOf hpc:hasContent .

hpc:hascontent a owl:ObjectProperty .
hpc:Hascontent rdfs:domain hpc:File .
hpc:Hascontent rdfs:range xsd:string .

hpc:setenvironmentvariables a owl:ObjectProperty .
hpc:Setenvironmentvariables rdfs:domain hpc:Action .
hpc:Setenvironmentvariables rdfs:range hpc:Environmentvariable .

hpc:Environmentvariable a owl:Class .

hpc:PATH rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:MANPATH rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:LSF_BINDIR rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:LSF_SERVERDIR rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:LSF_LIBDIR rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:LD_LIBRARY_PATH rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:XLSF_UIDDIR rdfs:subPropertyOf hpc:setEnvironmentVariables .
hpc:LSF_ENVDIR rdfs:subPropertyOf hpc:setEnvironmentVariables .
