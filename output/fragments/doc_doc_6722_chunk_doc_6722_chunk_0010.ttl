hpc:BurstBufferPlugin a owl:Class .
hpc:DataWarpPlugin a hpc:BurstBufferPlugin ;
    rdfs:comment "Used for burst buffer directives when using the burst_buffer/datawarp plugin." .

hpc:CrayDataWarp a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Cray specific DataWarp plugin." .

hpc:SlurmDataWarp a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "DataWarp plugin interpreted by Slurm." .

hpc:PersistentBurstBuffer a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "For creating or deleting persistent burst buffer storage." .

hpc:JobSpecificBurstBuffer a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Requires burst buffer capacity to be specified." .

hpc:DefaultPool a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Default pool for job-specific burst buffers." .

hpc:BurstBufferCapacity a xsd:nonNegativeInteger ;
    rdfs:domain hpc:JobSpecificBurstBuffer ;
    rdfs:range xsd:nonNegativeInteger .

hpc:BurstBufferPool a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Pool from which burst buffer resources are requested." .

hpc:BurstBufferPFS a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Specifies the PFS for burst buffer resources." .

hpc:BurstBufferAccessMode a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Access mode for burst buffer resources." .

hpc:BurstBufferType a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferPlugin ;
    rdfs:comment "Type of burst buffer resources." .

hpc:StageIn a owl:ObjectProperty ;
    rdfs:domain hpc:JobScript ;
    rdfs:range hpc:FileStageOperation .

hpc:StageOut a owl:ObjectProperty ;
    rdfs:domain hpc:JobScript ;
    rdfs:range hpc:FileStageOperation .

hpc:FileStageOperation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Operation for staging files in or out." .

hpc:FileStageOperationType a owl:Class ;
    rdfs:subClassOf hpc:FileStageOperation ;
    rdfs:comment "Type of file stage operation." .

hpc:FileSource a owl:DatatypeProperty ;
    rdfs:domain hpc:FileStageOperationType ;
    rdfs:range xsd:string .

hpc:FileDestination a owl:DatatypeProperty ;
    rdfs:
