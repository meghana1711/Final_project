hpc:Jobgroup a owl:Class;
    rdfs:subClassOf [ a owl:Class;
                        rdfs:subClassOf [ a owl:Class;
                                            rdfs:subClassOf [ a owl:Class;
                                                                  rdfs:subClassOf owl:Thing ] ] ] .

hpc:jobgrouplimit a owl:DatatypeProperty;
    rdfs:domain hpc:Jobgrouplimitchange;
    rdfs:range xsd:integer .

hpc:jobgrouplimitremoval a owl:ObjectProperty;
    rdfs:domain hpc:Jobgroup;
    rdfs:range hpc:Jobgroup;
    rdfs:subPropertyOf hpc:modifyJobGroupProperty .

hpc:modifyjobgroupproperty a owl:ObjectProperty .

hpc:jobgroupcleanup a owl:ObjectProperty;
    rdfs:domain hpc:Jobgroup;
    rdfs:range xsd:boolean .

hpc:jobgroupinheritance a owl:ObjectProperty;
    rdfs:domain hpc:Jobgroup;
    rdfs:range hpc:Jobgroup;
    rdfs:subPropertyOf hpc:modifyJobGroupProperty .

hpc:Jobgrouplimitexceeded a owl:Class;
    rdfs:subClassOf [ a owl:Class;
                        rdfs:subClassOf [ a owl:Class;
                                            rdfs:subClassOf [ a owl:Class;
                                                                  rdfs:subClassOf owl:Thing ];
                                            rdfs:subPropertyChain [ rdf:type owl:ObjectProperty;
                                                                        rdfs:domain hpc:Jobgroup;
                                                                        rdfs:range xsd:integer ] ] ] .

hpc:Jobgrouplimitviolation a owl:Class;
    rdfs:subClassOf [ a owl:Class;
                        rdfs:subClassOf [ a owl:Class;
                                            rdfs:subClassOf [ a owl:Class;
                                                                  rdfs:subClassOf owl:Thing ];
                                            rdfs:subPropertyChain [ rdf:type owl:ObjectProperty;
                                                                        rdfs:domain hpc:Jobgroup;
                                                                        rdfs:range xsd:integer ] ];
                        rdfs:subPropertyChain [ rdf:type owl:ObjectProperty;
                                                 rdfs:domain hpc:Jobgrouplimitchange;
                                                 rdfs:range hpc:Jobgroup ] ] ] .

hpc:Jobgroupcreator a owl:Class;
    rdfs:subClassOf [ a owl:Class;
                        rdfs:subClassOf [ a owl:Class;
                                            rdfs:subClassOf [ a owl:Class;
                                                                  rdfs:subClassOf owl:Thing ];
