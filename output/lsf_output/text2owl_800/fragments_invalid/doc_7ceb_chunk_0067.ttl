    rdfs:domain hpc:Logjobinfo ;
    rdfs:range xsd:string .
hpc:pos a owl:DatatypeProperty ;
    rdfs:domain hpc:Logjobinfo ;
    rdfs:range xsd:int .
hpc:logfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Logjobinfo ;
    rdfs:range xsd:string .

hpc:rmlogjobinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdmessage ;
    rdfs:range xsd:string .
hpc:rmlogjobinfofailed a owl:DatatypeProperty ;
    rdfs:domain hpc:Rmlogjobinfo ;
