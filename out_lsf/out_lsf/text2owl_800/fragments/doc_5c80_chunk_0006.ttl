hpc:Serviceclassonforwardedcluster a owl:Class .
hpc:hasappropriateaccess a owl:ObjectProperty .
hpc:Job a owl:Class .
hpc:Serviceclassdefinedbyjob rdfs:domain hpc:Job ;
                                 rdfs:range hpc:Serviceclassonforwardedcluster .
hpc:requiresfixpack15 a owl:ObjectProperty .
hpc:Submissioncluster rdfs:domain hpc:Job ;
                          rdfs:range xsd:string .
hpc:Executioncluster rdfs:domain hpc:Job ;
                          rdfs:range xsd:string .
hpc:Jobgroup a owl:Class .
hpc:submittedtojobgroup a owl:ObjectProperty .
hpc:Defaultqueue rdfs:range xsd:string .
hpc:Jobsubmissiongroup rdfs:domain hpc:Jobgroup ;
                             rdfs:range xsd:string .
hpc:Jobsubmissionoptionfile a owl:Class .
hpc:submittedwithjsonfile a owl:ObjectProperty .
hpc:Jobsubmissionoptionsfile rdfs:range xsd:string .
