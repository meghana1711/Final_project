hpc:Lsfserverhost a owl:Class .
hpc:lsfproxydhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:string .
hpc:lsfproxydport a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:positiveInteger .
hpc:lsfproxydheartbeatinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:positiveInteger .
hpc:lsfproxydbypass a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverhost ;
    rdfs:range xsd:anyURI .
