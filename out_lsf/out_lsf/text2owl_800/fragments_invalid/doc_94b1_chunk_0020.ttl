hpc:Job a owl:Class .
hpc:User rdf:type owl:Class .
hpc:Project rdf:type owl:Class .
hpc:Application rdf:type owl:Class .
hpc:Status rdf:type owl:Class .
hpc:Queue rdf:type owl:Class .
hpc:CPUFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:SpecifiedCPUFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:CombinedCPUFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Affinity rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Core .
hpc:FrequencyUnit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cpufrequency ;
    rdfs:range xsd:string .
hpc:FrequencyManagement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Frequencymanagementtype .
hpc:Frequencymanagementtype a owl:Class .
hpc:HostManaged a hpc:FrequencyManagementType .
hpc:CoreManaged a hmod:FrequencyManagementType .
hpc:JobLevelFrequencyManagement a hpc:FrequencyManagementType .
hpc:ApplicationLevelFrequencyManagement a hpc:FrequencyManagementType .
hpc:QueueLevelFrequencyManagement a hpc:FrequencyManagementType .
hpc:elimfrequency a owl:ObjectProperty ;
    rdfs:domain hpc:Logicalcpu ;
    rdfs:range xsd:integer .
hpc:Logicalcpu a owl:Class .
hpc:availcpufreqs a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:currcpufreqs a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Cluster a owl:Class .
