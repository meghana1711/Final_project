hpc:Job a owl:Class .
hpc:Resourceusage a owl:Class .
hpc:Usagestring a owl:Class .
hpc:loadindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Usagestring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:value a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadindex ;
    rdfs:range xsd:nonNegativeInteger .
hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Usagestring ;
    rdfs:range xsd:duration .
hpc:Minutes a xsd:duration ;
    rdfs:subClassOf xsd:duration .
hpc:Hours a xsd:duration ;
    rdfs:subClassOf xsd:duration .
hpc:Seconds a xsd:duration ;
    rdfs:subClassOf xsd:duration .
hpc:Decay a xsd:nonNegativeInteger ;
    rdfs:domain hpc:Usagestring .
hpc:threshold a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourceusage .
hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourceusage .
hpc:Queueconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Cluster a owl:Class .
hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Cluster .
