hpc:Node a owl:Class .

hpc:State a owl:Class .
hpc:PowerDownState rdf:type hpc:State ;
    rdfs:subClassOf hpc:State .
hpc:PowerUpState rdf:type hpc:State ;
    rdfs:subClassOf hpc:State .

hpc:PowerDown a owl:ObjectProperty .
hpc:PowerUp a owl:ObjectProperty .
hpc:Drain a owl:ObjectProperty .
hpc:CancelJobs a owl:ObjectProperty .
hpc:UseResumeProgram a owl:ObjectProperty .
hpc:UseSuspendProgram a owl:ObjectProperty .

hpc:PowerDownState rdfs:domain hpc:Node ;
    rdfs:range hpc:PowerDownState .
hpc:PowerUpState rdfs:domain hpc:Node ;
    rdfs:range hpc:PowerUpState .
hpc:Drain rdfs:domain hpc:Node ;
    rdfs:range xsd:boolean .
hpc:CancelJobs rdfs:domain hpc:Node ;
    rdfs:range xsd:boolean .
hpc:UseResumeProgram rdfs:domain hpc:Node ;
    rdfs:range rdf:Resource .
hpc:UseSuspendProgram rdfs:domain hpc:Node ;
    rdfs:range rdf:Resource .

hpc:PowerDown_Down a hpc:PowerDownState .
hpc:PowerDown_Asap a hpc:PowerDownState .
hpc:PowerDown_Force a hpc:PowerDownState .
hpc:PowerUp a hpc:PowerUpState .
hpc:Resume a hpc:PowerUpState .
hpc:NoResp a hpc:PowerUpState .
hpc:Idle a hpc:PowerUpState .
hpc:Drain a hpc:DrainState .
hpc:DRAINING a hpc:DrainState .
hpc:DOWN a hpc:PowerDownState .
hpc:REBOOT a hpc:PowerDownState .
```
