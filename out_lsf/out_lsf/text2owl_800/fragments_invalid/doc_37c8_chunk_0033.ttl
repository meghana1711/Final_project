hpc:Centosimage a owl:Class .
hpc:Sequentialjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Job a owl:Class .

hpc:hascontainer a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Container .
hpc:Container a owl:Class .
hpc:hasoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Container .
hpc:hasimage a owl:ObjectProperty ;
    rdfs:domain hpc:Container .

hpc:Podmancontainer a owl:Class ;
    rdfs:subClassOf hpc:Container .

hpc:isremoved a owl:DatatypeProperty ;
    rdfs:domain hpc:Container .
    rdfs:range xsd:boolean .

hpc:hasnet a owl:DatatypeProperty ;
    rdfs:domain hpc:Container .
    rdfs:range xsd:string .

hpc:hasipc a owl:DatatypeProperty ;
    rdfs:domain hpc:Container .
    rdfs:range xsd:string .

hpc:hasvolumes a owl:DatatypeProperty ;
    rdfs:domain hpc:Container .
    rdfs:range xsd:string .

hpc:haspasswdfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Container .
    rdfs:range xsd:string .

hpc:Hostnetwork a owl:Class .
hpc:Useridandname a owl:Class .

hpc:execDriver a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Context .

hpc:Context a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Context .
    rdfs:range hpc:User .
