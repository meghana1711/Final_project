hpc:User a owl:Class .
hpc:Usergroupmember a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:strictugcontrol a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:boolean .

