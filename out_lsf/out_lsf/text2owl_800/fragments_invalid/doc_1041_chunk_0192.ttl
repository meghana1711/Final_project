hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Eventlog a owl:Class .
hpc:Usergroup a owl:Class .
hpc:logfile a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:timeintervalformat a owl:ObjectProperty .
hpc:unixpathlength a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:windowspathlength a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:bypasslsfexplorer a owl:ObjectProperty .
hpc:jobassociation a owl:ObjectProperty .

# Object Properties
hpc:displaysjobsduring a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:searcheseventlog a owl:ObjectProperty ;
    rdfs:domain hpc:Command .
hpc:isassociatedwith a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Usergroup .

# Datatype Properties
hpc:commandargument a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasstarttime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
hpc:hasendtime a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
hpc:haslogfile a owl:DatatypeProperty ;
hpc:haspathlength a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:hasLogFile .
hpc:isbypassedbylsfexplorer a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .
hpc:issubmittedby a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Usergroup .

# Subclass relations
hpc:Command a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:Job a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:Usergroup a owl:Class ;
    rdfs:subClassOf rdf:Resource .

# Domain and Range restrictions
hpc:Displaysjobsduring rdfs:domain hpc:Command ;
    rdfs:subPropertyOf hpc:searchesEventLog .
hpc:Searcheseventlog rdfs:domain hpc:Command ;
    rdfs:range hpc:Eventlog .
hpc:Isassociatedwith rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .
hpc:Hasstarttime rdfs:domain hpc:Job .
hpc:Hasendtime rdfs:domain hpc:Job .
hpc:Haslogfile rdfs:domain hpc:Command .
hpc:Haspathlength rdfs:domain hpc:Logfile .
hpc:isBypass
