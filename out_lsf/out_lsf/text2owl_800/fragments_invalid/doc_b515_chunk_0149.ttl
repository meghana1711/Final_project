@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:User a owl:Class.
hpc:Group a owl:Class.
hpc:System a owl:Class.
hpc:Host a owl:Class.

hpc:rsv a owl:ObjectProperty.
hpc:Rsvhosts rdfs:domain hpc:Rsv ;
             rdfs:range rdf:List.
hpc:Timewindow rdfs:domain hpc:Rsv ;
             rdfs:range xsd:string.

hpc:max a owl:DatatypeProperty ;
       rdfs:domain hpc:Host.

hpc:Week a owl:Class ;
        rdfs:subClassOf [ a owl:Restriction ;
                          o
