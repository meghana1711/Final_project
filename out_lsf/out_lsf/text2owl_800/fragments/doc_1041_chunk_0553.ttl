hpc:Backfillwindow a owl:Class .
hpc:Haswidth rdfs:domain hpc:Backfillwindow ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Meetsrequirementsatthistime rdfs:domain hpc:Backfillwindow ;
                                rdfs:range xsd:string .
hpc:selectshosts a owl:ObjectProperty ;
                 rdfs:domain hpc:Backfillwindow ;
                 rdfs:range hpc:Host .
hpc:Conformsto rdfs:domain hpc:Selectshosts ;
                 rdfs:range xsd:string .
hpc:Hasresourcerequirement rdfs:domain hpc:Backfillwindow ;
                               rdfs:range hpc:Resourcerequirement .
hpc:Hasstrictresourcerequirement rdfs:domain hpc:Backfillwindow ;
                                     rdfs:range hpc:Strictresourcerequirement .
hpc:Selectresourcerequirement rdfs:subClassOf hpc:Hasstrictresourcerequirement .
hpc:Hasselectresourcerequirement rdfs:domain hpc:Backfillwindow ;
                                      rdfs:range hpc:Selectresourcerequirement .
hpc:Hasruntimelimit rdfs:domain hpc:Backfillwindow ;
                             rdfs:range xsd:duration .
hpc:stagesdatafiles a owl:ObjectProperty ;
                     rdfs:domain hpc:Backfillwindow ;
                     rdfs:range hpc:Datafile .
hpc:Hasdatarequirement rdfs:domain hpc:Stagesdatafiles ;
                              rdfs:range hpc:Datarequirement .
hpc:Stagesdatafilesbycopying rdfs:subClassOf hpc:Stagesdatafiles .
hpc:Stagesdatafilesbysymboliclinking rdfs:subClassOf hpc:Stagesdatafiles .
hpc:Haslocalstagingcache rdfs:domain hpc:Stagesdatafiles ;
                             rdfs:range hpc:Localstagingcache .
hpc:Hasjobexecutionenvironment rdfs:domain hpc:Stagesdatafiles ;
                                   rdfs:range hpc:Jobexecutionenvironment .
hpc:Bstage rdfs:subClassOf hpc:Stagesdatafiles .
hpc:Printusage rdfs:domain rdf:nil ;
                   rdfs:range xsd:string .
hpc:Printlsfreleaseversion rdfs:domain rdf:nil ;
                             rdfs:range xsd:string .
hpc:Host a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:Strictresourcerequirement a owl:Class .
hpc:Selectresourcerequirement a owl:Class .
hpc:Datarequirement a owl:Class .
hpc:Localstagingcache a owl:Class .
hpc:Jobexecutionenvironment a owl:Class .
hpc:Datafile a owl:Class .
