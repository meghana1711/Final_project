hpc:SlurmAdminTool a owl:Class .
hpc:scontrol a hpc:SlurmAdminTool .

hpc:SlurmUserCommand a owl:Class .
hpc:sinfo a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmAdminTool .
hpc:squeue a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmUserCommand .
hpc:srun a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmUserCommand .
hpc:sprio a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmUserCommand .
hpc:sreport a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmUserCommand .
hpc:sstat a hpc:SlurmUserCommand ;
  rdfs:subClassOf hpc:SlurmUserCommand .
hpc:strigger a owl:Class .
hpc:sview a owl:Class .

hpc:SlurmDaemon a owl:Class .
hpc:slurmd a hpc:SlurmDaemon .
hpc:slurmdbd a hpc:SlurmDaemon .

hpc:SlurmDatabase a owl:Class .
hpc:slurmdbd a hpc:SlurmDatabase .

hpc:SlurmPlugin a owl:Class .

hpc:hasCommand a owl:ObjectProperty .
hpc:hasCommand rdfs:domain hpc:SlurmAdminTool ;
  rdfs:range hpc:SlurmUserCommand .

hpc:hasPlugin a owl:ObjectProperty .
hpc:hasPlugin rdfs:domain hpc:SlurmUserCommand ;
  rdfs:range hpc:SlurmPlugin .
