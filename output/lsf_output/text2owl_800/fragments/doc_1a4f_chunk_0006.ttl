hpc:Job a owl:Class .
hpc:Resourceusage a owl:Class .
hpc:totalcputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:totalresidentmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:totalvirtualmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:activeprocessgroupid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:activeprocesses a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Pim a owl:Class .
hpc:slots a owl:ObjectProperty .
hpc:Staticresource a owl:Class .
hpc:maxram a owl:DatatypeProperty ;
    rdfs:domain hpc:Staticresource ;
    rdfs:range xsd:decimal .
hpc:numberofprocessors a owl:DatatypeProperty ;
    rdfs:domain hpc:Staticresource ;
    rdfs:range xsd:integer .
hpc:Loadindex a owl:Class .
hpc:loadindexresource a owl:ObjectProperty ;
    rdfs:domain hpc:Loadindex ;
    rdfs:range hpc:Resource .
hpc:Configuredresource a owl:Class .
hpc:Schedulablejob a owl:Class .
hpc:Schedulablejob rdfs:subClassOf hpc:Job .
