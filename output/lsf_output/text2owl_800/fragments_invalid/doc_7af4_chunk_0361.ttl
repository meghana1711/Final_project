hpc:Preemptableresource a owl:Class .
hpc:Preemptableresource rdfs:subClassOf hpc:Resource .
hpc:Preemptableresource rdfs:subClassOf owl:Class .

hpc:preemptableresources a owl:ObjectProperty .
hpc:Preemptableresources rdfs:domain hpc:Queue .
hpc:Preemptableresources rdfs:range rdf:List .

hpc:Preemptableresourcetype a owl:Class .
hpc:Preemptableresourcetype rdfs:subClassOf hpc:Resourcetype .
hpc:Preemptableresourcetype rdfs:subClassOf owl:Class .

hpc:preemptableresourcetypemem a owl:ObjectProperty .
hpc:Preemptableresourcetypemem rdfs:domain hpc:Preemptableresource .
hpc:Preemptableresourcetypemem rdfs:range xsd:boolean .

hpc:preemptionaction a owl:ObjectProperty .
hpc:Preemptionaction rdfs:domain hpc:Preemptableresource .
hpc:Preemptionaction rdfs:range xsd:string .

hpc:preemptionwaittime a owl:DatatypeProperty .
hpc:Preemptionwaittime rdfs:domain hpc:Queue .
hpc:Preemptionwaittime rdfs:range xsd:integer .

hpc:PreemptionWaitTimeDefault a xsd:integer .
hpc:PreemptionWaitTimeDefault 300 .

hpc:PreemptableResourcesList a rdfs:Class .
hpc:Preemptableresourceslist rdfs:subClassOf rdf:List .

hpc:preemptableresourceslistmember a owl:ObjectProperty .
hpc:Preemptableresourceslistmember rdfs:domain hpc:Preemptableresourceslist .
hpc:Preemptableresourceslistmember rdfs:range hpc:Resource .

hpc:PreemptableResourcesListDefault a rdf:List .
