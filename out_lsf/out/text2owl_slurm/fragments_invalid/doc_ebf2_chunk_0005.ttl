@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Jobacctgathertype a owl:Class.
hpc:Jobacctgathertype rdfs:subClassOf xsd:string.

hpc:Cgroup a owl:Class.
hpc:Cgroup rdfs:subClassOf xsd:string.

hpc:Cgroupcontroller a owl:Class.
hpc:Cgroupcontroller rdfs:subClassOf hpc:Cgroupcontroller.

hpc:Cgroupcontroller rdfs:subClassOf hpc:Cgroupcontroller ;
    rdfs:comment "Controller for CPU accounting in cgroup." .

hpc:Memorycontroller a owl:Class.
hpc
