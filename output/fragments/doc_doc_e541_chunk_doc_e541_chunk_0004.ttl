hpc:IPMI a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#Energy> .

hpc:EnergySample a owl:DatatypeProperty ;
    rdfs:domain hpc:IPMI ;
    rdfs:range xsd:decimal .

hpc:IPMIRate a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#Energy> .

hpc:ProfileEra a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#Time> .

hpc:ProfileEra_2013 a owl:NamedIndividual ;
    rdfs:label "2013" ;
    hpc:ProfileEra rdf:type .

hpc:ProfileOption a owl:Class .

hpc:ProfileOption_all a owl:NamedIndividual ;
    rdfs:label "all" .

hpc:ProfileOption_none a owl:NamedIndividual ;
    rdfs:label "none" .

hpc:ProfileOption_energy a owl:NamedIndividual ;
    rdfs:label "energy" .

hpc:ProfileOption_task a owl:NamedIndividual ;
    rdfs:label "task" .

hpc:ProfileOption_filesystem a owl:NamedIndividual ;
    rdfs:label "filesystem" .

hpc:ProfileOption_network a owl:NamedIndividual ;
    rdfs:label "network" .

hpc:Profile a owl:Class .

hpc:DataCollection a owl:ObjectProperty ;
    rdfs:domain hpc:Profile ;
    rdfs:range hpc:DataCollectionType .

hpc:DataCollection_none a owl:NamedIndividual ;
    rdfs:label "no data types are collected" .

hpc:DataCollection_energy a owl:NamedIndividual ;
    rdfs:label "energy data is collected" .

hpc:DataCollection_filesystem a owl:NamedIndividual ;
    rdfs:label "filesystem data is collected" .

hpc:DataCollection_network a owl:NamedIndividual ;
    rdfs:label "network (InfiniBand) data is collected" .

hpc:LustreFilesystem a owl:Class ;
    rdfs:subClassOf hpc:Filesystem .
```
