hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:fromHost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JobName a owl:Class .
hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobName ;
    rdfs:range xsd:dateTime .
hpc:jobId a owl:DatatypeProperty ;
    rdfs:domain hpc:JobName ;
    rdfs:range xsd:integer .
hpc:bswitch a owl:ObjectProperty .
hpc:bmod a owl:ObjectProperty .

