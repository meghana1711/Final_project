    rdfs:range xsd:string .

hpc:FairshareValue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:subClassOf rdf:Bag ;
    rdfs:subClassOf rdf:Alt ;
