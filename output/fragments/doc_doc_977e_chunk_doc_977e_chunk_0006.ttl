hpc:Reservation a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasReservation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Reservation .

hpc:isRunning a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .

hpc:hasNode a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:Resource .

hpc:startTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:endTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .

hpc:hasMaintenanceFlag a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .

hpc:OverlappingReservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .

hpc:maint a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Reservation .

hpc:blockedByMaintenance a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Reservation .
```
