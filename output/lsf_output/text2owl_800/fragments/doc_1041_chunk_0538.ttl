hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hasreservationdetails .

hpc:Hasreservationdetails a owl:Class .

hpc:reservationduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:reservationtype a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Reservationtype .

hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Queue .

hpc:hostsrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .

hpc:reservationwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:duration .

hpc:advancereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Reservation .

hpc:openadvancereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .

hpc:Hostgroup a owl:Class .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hostgroupmembers a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Host .

hpc:hostNameOrHostGroup a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Hostgroup .
