hpc:Spotrequest a owl:Class .
hpc:Job a owl:Class .
hpc:Lsf a owl:Class .
hpc:Cyclecloud a owl:Class .
hpc:Spotvm a owl:Class .
hpc:price a owl:DatatypeProperty ;
    rdfs:domain hpc:Spotvm ;
    rdfs:range xsd:decimal .
hpc:maxprice a owl:DatatypeProperty ;
    rdfs:domain hpc:Spotrequest ;
    rdfs:range xsd:decimal .
hpc:currentprice a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:decimal .
hpc:evictiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Spotvm ;
    rdfs:range xsd:integer .
hpc:notificationtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Spotvm ;
    rdfs:range xsd:integer .
hpc:requeuetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:integer .
hpc:Template a owl:Class .
hpc:ncores a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:nonNegativeInteger .
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cyclecloudhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:boolean .
hpc:zone a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
hpc:templateid a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
hpc:Templatename a owl:Class ;
    rdfs:subClassOf hpc:Template .
hpc:LSF sorts hpc:TemplateName .
hpc:LSF sorts hpc:Priority .
