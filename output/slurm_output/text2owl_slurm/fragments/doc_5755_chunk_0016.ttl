hpc:Srun a owl:Class ;
    rdfs:comment "Command for interactive use, with someone monitoring the output." .

hpc:Sbatch a owl:Class ;
    rdfs:comment "Command for submitting a script for later execution." .

hpc:hasjobarraysupport a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingcommand ;
    rdfs:range xsd:boolean .

hpc:hasfaulttolerance a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingcommand ;
    rdfs:range xsd:string .
