hpc:JobDescription a owl:Class .
hpc:OpenapiJobPostResponse a owl:Class .
hpc:OpenapiResp a owl:Class .
hpc:OpenapiJobInfoResp a owl:Class .

hpc:job_id rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:string .

hpc:post rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range hpc:OpenapiJobPostResponse .

hpc:delete rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range hpc:OpenapiResp .

hpc:get rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range hpc:OpenapiJobInfoResp .
```
