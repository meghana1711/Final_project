@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Jobcomponentone a owl:Class ;
    rdfs:subClassOf hpc:Jobcomponent.

hpc:Jobcomponentfour a owl:Class ;
    rdfs:subClassOf hpc:Jobcomponent.

hpc:hasCPUAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:integer.

hpc:isOnNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string.

hpc:taskDistribution rdf:type owl:ObjectProperty
