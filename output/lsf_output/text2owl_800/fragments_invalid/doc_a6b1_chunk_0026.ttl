hpc:Job a owl:Class .
hpc:Totaldonejobs rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Totalexitedjobs rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Totalcputime rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Averagecputime rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Maximumcputime rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Minimumcputime rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Totalwaittimeinqueues rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Averagewaittimeinqueue rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Maximumwaittimeinqueue rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Minimumwaittimeinqueue rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Averageturnaroundtime rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Cputimeused rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:Completiontime rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Terminationreason rdfs:domain hpc:Job ;
    rdfs:range hpc:Terminationreason .

hpc:Terminationreason a owl:Class .
hpc:TermAdmin rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermBucketKill rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermChkpnt rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermCpulimit rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermCsmAlloc rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermCwdNotexist rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermData rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermDeadline rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TermExternalSig rdfs:subClassOf hpc:Terminationreason ;
    rdfs:range xsd:integer .
hpc:TERM_FORCE_ADMIN r
