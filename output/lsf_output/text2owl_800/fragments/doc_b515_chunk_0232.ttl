hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Configuration for re-sizable jobs." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Submit and manage re-sizable jobs." .

hpc:submitjobprocedure a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "Procedure for submitting a re-sizable job." .

hpc:releaseresources a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "Procedure for releasing resources." .

hpc:Hostspecification a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specification of resources to be released." .

hpc:hostspecificationrange a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostspecification ;
    rdfs:range xsd:string ;
    rdfs:comment "Range of hosts and number of tasks." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Releaseresources ;
    rdfs:range xsd:integer ;
    rdfs:comment "Job identifier." .
