hpc:Configuration a owl:Class .
hpc:Podmanconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Configuration .

hpc:container a owl:ObjectProperty ;
    rdfs:domain hpc:Podmanconfiguration ;
    rdfs:range xsd:string .

hpc:apptainer a owl:ObjectProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .

hpc:Lsbglobalpolicies a owl:Class .

hpc:lsbglobalpoliciesfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbglobalpolicies ;
    rdfs:range xsd:string .

hpc:Globalfairshare a owl:Class ;
    rdfs:subClassOf hpc:Lsbglobalpolicies .

hpc:gpdrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Globalfairshare ;
    rdfs:range xsd:string .

hpc:Limits a owl:Class ;
    rdfs:subClassOf hpc:Lsbglobalpolicies .

hpc:apps a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:eligiblePendJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:ineligible a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:jobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:jobsPerSchedCycle a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:licProjects a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:projects a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:queues a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:resource a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:string .

hpc:SWP a owl
