hpc:Lsfexitcode a owl:Class .
hpc:applicationexitvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfexitcode ;
    rdfs:range xsd:integer .
hpc:systemsignalexitvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfexitcode ;
    rdfs:range xsd:integer .
hpc:applicationspecificexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfexitcode ;
    rdfs:range xsd:string .
hpc:operatingsystemdependentsignal a owl:DatatypeProperty ;
    rdfs:domain hpc:Systemsignalexitvalue ;
    rdfs:range xsd:string .
hpc:executionhosttype a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfexitcode ;
    rdfs:range xsd:string .
hpc:Applicationsystemexitvalue a owl:Class ;
    rdf:subClassOf hpc:applicationExitValue .
hpc:Explicitapplicationexitvalue a owl:Class ;
    rdf:subClassOf hpc:applicationSystemExitValue .
hpc:Systemsignal a owl:Class ;
    rdf:subClassOf hpc:systemSignalExitValue .
