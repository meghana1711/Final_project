hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "A job to be executed on an HPC system." .

hpc:Remotetasklist a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "A list of remote tasks available for execution." .

hpc:Submissionhost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host from which a job is submitted." .

hpc:Hosttype a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The type of host on which a job can be executed." .

hpc:jobrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Hosttype ;
    rdfs:comment "The host type required for a job to be executed." .

hpc:singleprocessor a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates that only one processor is requested for a job." .

hpc:noinput a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The input file for the job is /dev/null (no input)." .

hpc:executionenvironment a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The execution environment from which the job was submitted." .

hpc:joboutput a owl:DatatypeProperty ;
    rdfs:domain hps:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The output of the job (if any)." .

hpc:errormessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The error message (if any)." .

hpc:maildestination a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The destination for mail notifications." .

hpc:Defaultproject a owl:Class ;
    rdfs:subClassOf hpc:Project ;
    rdfs:comment "The default project for a job." .

hpc:lsbDefaultproject a owl:DatatypeProperty ;
    rdfs:domain hpc:Defaultproject ;
    rdfs:range xsd:string ;
    rdfs:comment "The environment variable defining the default project." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The ID of the job if it is successfully submitted." .

hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job
