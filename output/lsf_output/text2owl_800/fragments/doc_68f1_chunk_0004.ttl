hpc:Project a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Distributionpolicy a owl:Class .
hpc:Projectgroup a owl:Class .
hpc:Groupofprojects a owl:Class .
hpc:Projectgrouphierarchy a owl:Class .

hpc:Hasservicedomain rdfs:domain hpc:Project .
hpc:Hasservicedomain rdfs:domain hpc:Projectgroup .
hpc:Hasservicedomain rdfs:domain hpc:Groupofprojects .
hpc:Hasdistributionpolicy rdfs:domain hpc:Project .
hpc:Hasdistributionpolicy rdfs:domain hpc:Projectgroup .
hpc:Hasdistributionpolicy rdfs:domain hpc:Groupofprojects .
hpc:Hasprojectgrouphierarchy rdfs:domain hpc:Projectgroup .

hpc:Project rdfs:subClassOf hpc:Projectgroup .
hpc:Groupofprojects rdfs:subClassOf hpc:Projectgroup .

hpc:Hasshares rdfs:domain hpc:Projectgroup .
hpc:Hasshares rdfs:range xsd:decimal .
hpc:Haslimits rdfs:domain hpc:Projectgroup .
hpc:Haslimits rdfs:range xsd:nonNegativeInteger .
hpc:Hasownership rdfs:domain hpc:Projectgroup .
hpc:Hasownership rdfs:range xsd:nonNegativeInteger .
hpc:Hasparentgroup rdfs:domain hpc:Projectgroup .
hpc:Hasparentgroup rdfs:range hpc:Projectgroup .
hpc:Haschildrengroups rdfs:domain hpc:Projectgroup .
hpc:Haschildrengroups rdfs:range rdf:List .

hpc:Hasfeature rdfs:domain hpc:Projectgroup .
hpc:Hasfeature rdfs:range hpc:Feature .
hpc:Sharessamehierarchy rdfs:domain hpc:Feature .
hpc:Sharessamehierarchy rdfs:range hpc:Feature .
