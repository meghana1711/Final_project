hpc:Bhostsformat a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Field a owl:Class ;
    rdfs:subClassOf owl:Class .

# Object Properties
hpc:hasfield a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range rdf:List .

hpc:fieldorder a owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fieldwidth a owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fieldjustification a owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string .

hpc:fielddelimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range xsd:string .

# Datatype Properties
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string .

hpc:allfields a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range xsd:string .

hpc:customoutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhostsformat ;
    rdfs:range xsd:string .

hpc:recommendedwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maxwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .
