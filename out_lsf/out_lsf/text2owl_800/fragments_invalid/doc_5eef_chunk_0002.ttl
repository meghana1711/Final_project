hpc:Usermap a owl:Class .
hpc:local a owl:DatatypeProperty ;
    rdfs:domain hpc:Usermap ;
    rdfs:range xsd:string .
hpc:remote a owl:DatatypeProperty ;
    rdfs:domain hpc:Usermap ;
    rdfs:range xsd:string .
hpc:Direction a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:enumValue "export" ;
    owl:enumValue "import" .
hpc:User a owl:Class .
hpc:hasusermap a owl:ObjectProperty ;
    rdfs:domain hpc:Usermap ;
    rdfs:range hpc:User .
hpc:Haslocal hpc:hasusermap ;
    rdfs:domain hpc:Usermap ;
    rdfs:range xsd:string .
hpc:Hasremote hpc:hasusermap ;
    rdfs:domain hpc:Usermap ;
    rdfs:range xsd:string .
