@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Mqttbroker a owl:Class .
hpc:mqttbrokerport a owl:DatatypeProperty .
hps:MQTTBrokerPort rdfs:domain hpc:Mqttbroker .
hps:MQTTBrokerPort rdfs:range xsd:integer .

hpc:Lsfresourceconnector a owl:Class .
hpc:lsfresourceconnectorstatus a owl:DatatypeProperty .
hpc:Lsfresourceconnectorstatus rdfs:domain hpc:Lsfresourceconnector .
hpc:Lsfresourceconnectorstatus rdfs:range xsd:string .

hpc:Preprovisionstarted a owl:Class .
hpc:Preprovisionfailed a owl:Class .

hpc:Mosquitto a owl:Class .
hpc:mosquittodaemon a owl:ObjectProperty .
hps:MosquittoDaemon rdfs:domain hpc:Mosquitto .
hps:MosquittoDaemon rdfs:range rdf:Resource .

hpc:lsfmqbrokerhosts a owl:DatatypeProperty .
hps:LsfMqBrokerHosts rdfs:domain hpc:Lsf .
hps:LsfMqBrokerHosts rdfs:range xsd:string .

hpc:mqttbrokerhost a owl:DatatypeProperty .
hps:MqttBrokerHost rdfs:domain hpc:Lsf .
hps:MqttBrokerHost rdfs:range xsd:string .

hpc:lsbrcexternalhostflag a owl:DatatypeProperty .
hps:LsbRcExternalHostFlag rdfs:domain hpc:Lsf .
hps:LsbRcExternalHostFlag rdfs:range xsd:string .

hpc:ebrokerdhostcleandelay a owl:DatatypeProperty .
hps:EbrokerdHostCleanDelay rdfs:domain hpc:Lsf .
hps:EbrokerdHostCleanDelay rdfs:range xsd:integer .
