hpc:Job a owl:Class .

hpc:softrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:resourceavailability a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:softrunlimitextensiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:graceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:requeueaction a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:RequeueActionRequeue a owl:NamedIndividual ;
    hpc:RequeueAction "Y" .
hpc:RequeueActionTerminate a owl:NamedIndividual ;
    hpc:RequeueAction "N" .

hpc:Job hpc:requiresresource hpc:ResourceRequirement .
hpc:Job hpc:hasresource hpc:ResourceAvailability .
