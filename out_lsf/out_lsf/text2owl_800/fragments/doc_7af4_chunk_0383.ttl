hpc:LsbSharedir rdfs:range xsd:string .

hpc:lsbLocaldir a owl:DatatypeProperty .
hpc:LsbLocaldir rdfs:domain hpc:Lsb .
hpc:LsbLocaldir rdfs:range xsd:string .

hpc:lsbBindir a owl:DatatypeProperty .
hpc:LsbBindir rdfs:domain hpc:Lsb .
hpc:LsbBindir rdfs:range xsd:string .

hpc:Mbatchd a owl:Class .

hpc:Mbatchd rdfs:range xsd:string .

hpc:setuid a owl:DatatypeProperty .
