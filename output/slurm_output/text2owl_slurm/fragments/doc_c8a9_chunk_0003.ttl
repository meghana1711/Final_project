hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job with configured memory limits." .

hpc:maximumdatasegmentsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum data segment size for a job." .

hpc:maximumvirtualmemorysize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum virtual memory size for a job." .

hpc:Jobaccounting a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents job accounting configuration." .

hpc:jobacctgathertype a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaccounting ;
    rdfs:range hpc:Jobacctgathertype ;
    rdfs:comment "Type of job accounting gathering." .

hpc:jobacctgatherfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobaccounting ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Frequency of job accounting gathering." .

hpc:Jobpreemption a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents job preemption configuration." .

hpc:preemptmode a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreemption ;
    rdfs:range hpc:Preemptmode ;
    rdfs:comment "Mechanism used to preempt jobs or enable gang scheduling." .

hpc:preempttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobpreemption ;
    rdfs:range hpc:Preempttype ;
    rdfs:comment "Type of preemption for the cluster or partition." .

hpc:Preemptablejob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a preemptable job." .

hpc:PreemptModeOff a owl:NamedIndividual ;
    a hpc:PreemptMode ;
    rdfs:label "OFF"@en ;
    rdfs:comment "Disables job preemption and gang scheduling." .

hpc:PreemptModeStrict a owl:NamedIndividual ;
    a hpc:PreemptMode ;
    rdfs:label "STRICT"@en ;
    rdfs:comment "Enforces strict memory limits and cancels jobs that exceed them." .
