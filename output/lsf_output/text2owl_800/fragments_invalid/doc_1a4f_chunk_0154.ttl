hpc:Jobgroup a owl:Class .
hpc:hasParentJobGroup rdf:Property ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .
hpc:hasLimit rdf:Property ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:joblimit a owl:DatatypeProperty .

hpc:bgadd a owl:ObjectProperty .
hpc:bgadd rdfs:subPropertyOf hpc:hasParentJobGroup .

hpc:submitjob a owl:ObjectProperty .
hpc:Submitjob rdfs:domain hpc:Job .
hpc:Submitjob rdfs:range hpc:Jobgroup .

hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf rdf:Resource .
hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasParentJobGroup ;
                        owl:hasValue hpc:JobGroup ] .
