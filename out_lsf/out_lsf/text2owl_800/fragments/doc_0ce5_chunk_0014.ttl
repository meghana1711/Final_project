hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Represents a batch system's mbatchd process." .

hpc:Childmbatchd a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd ;
    rdfs:comment "Represents a child mbatchd process." .

hpc:querydedicatedport a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer ;
    rdfs:comment "The port number dedicated for query operations." .

hpc:querythreadsupport a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Mbatchd ;
    rdfs:comment "Indicates whether the mbatchd supports multithread batch queries." .

hpc:Querycommand a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Represents a command that triggers the exit of mbatchd or child mbatchd." .

hpc:Command_bconf a hpc:QueryCommand ;
    rdfs:comment "The 'bconf' command." .

hpc:Command_badmin_reconﬁg a hpc:QueryCommand ;
    rdfs:comment "The 'badmin reconﬁg' command." .

hpc:Command_badmin_qopen a hpc:QueryCommand ;
    rdfs:comment "The 'badmin qopen' command." .

hpc:Command_badmin_qclose a hpc:QueryCommand ;
    rdfs:comment "The 'badmin qclose' command." .

hpc:Command_badmin_qact a hpc:QueryCommand ;
    rdfs:comment "The 'badmin qact' command." .

hpc:Command_badmin_qinact a hpc:QueryCommand ;
    rdfs:comment "The 'badmin qinact' command." .

hpc:Command_badmin_hopen a hpc:QueryCommand ;
    rdfs:comment "The 'badmin hopen' command." .

hpc:Command_badmin_hclose a hpc:QueryCommand ;
    rdfs:comment "The 'badmin hclose' command." .

hpc:Command_badmin_perfmon_start a hpc:QueryCommand ;
    rdfs:comment "The 'badmin perfmon start' command." .

hpc:refreshtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The time interval for refreshing job information." .

hpc:newjobrefresh a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Mbatchd ;
    rdfs:comment "Indicates whether a child mbatchd gets up-to-date new job information from the parent mbatchd." .
