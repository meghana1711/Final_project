hpc:Applicationfile a owl:Class .
hpc:Job a owl:Class .
hpc:MyJob a hpc:Job .
hpc:submittedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:Defaultqueue a owl:Class .
hpc:HasQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Defaultqueue .
hpc:Resizablejob a owl:Class .
hpc:HasSwapSpace rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:decimal .
hpc:HasMemory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:decimal .
hpc:bresizerelease a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range rdf:List .
hpc:Host a owl:Class .
hpc:HasSwapSpaceReduction rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Bresizerelease ;
    rdfs:range xsd:decimal .
hpc:HasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bresizerelease ;
    rdfs:range hpc:Host .
hpc:Autoresizablejob a owl:Class .
hpc:HasAppVersion rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Autoresizablejob ;
    rdfs:range rdf:List .
hpc:Appversion a owl:Class .
hpc:HasMemoryRequirement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Appversion ;
    rdfs:range xsd:decimal .
hpc:HasSwapSpaceRequirement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Appversion ;
    rdfs:range xsd:decimal .
hpc:Spanstring a owl:Class .
hpc:HasHosts rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Spanstring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:HasBlock rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Spanstring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:HasPtile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Spanstring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Defaultptile a owl:Class .
hpc:Predefinedptile a owl:Class .
