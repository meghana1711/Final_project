hpc:Jobmonitoring a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Displays the standard output and standard error output that is produced by one of your unfinished jobs." .

hpc:hasoutputmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmonitoring ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "Displays the output of the job by using the command." .

hpc:outputMethodCat a owl:NamedIndividual ;
    hpc:Hasoutputmethod hpc:hasoutputmethod ;
    rdfs:comment "Displays the output of the job by using the command cat." .

hpc:outputMethodTail a owl:NamedIndividual ;
    hpc:Hasoutputmethod hpc:hasoutputmethod ;
    rdfs:comment "Displays the output of the job by using the command tail -f." .

hpc:exitonjobcompletion a owl:ObjectProperty ;
    rdfs:domain hpc:Outputmethod ;
    rdfs:range xsd:boolean ;
    rdfs:comment "When the job is completed, the bpeek -f command exits." .

hpc:abortonjobchange a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmonitoring ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Aborts any previous bpeek -f command and reruns the bpeek -f command if the peeked job is requeued or migrated." .

hpc:mostrecentjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmonitoring ;
    rdfs:range hpc:Job ;
    rdfs:comment "Operates on your most recently submitted job in the specified queue." .

hpc:onhost a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmonitoring ;
    rdfs:range hpc:Host ;
    rdfs:comment "Operates on your most recently submitted job that was dispatched to the specified host." .

hpc:byname a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmonitoring ;
    rdfs:range hpc:Job ;
    rdfs:comment "Operates on your most recently submitted job that has the specified job name." .

hpc:jobnamelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The job name can be up to 4094 characters long." .

hpc:jobnamenonunique a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Job names are not unique." .

hpc:wildcardcharacter a owl:DatatypeProperty ;
    rdfs:domain hpc:Pattern ;
    rdfs:range xsd:string ;
    rdfs:comment "The wildcard character (*) can be used anywhere within a job name, but it cannot appear within an array index." .

hpc:patternmatch a owl:ObjectProperty ;
    rdfs:domain
