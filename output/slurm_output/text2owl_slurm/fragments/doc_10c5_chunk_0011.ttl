hpc:Nodeconfiguration a owl:Class .
hpc:nodename a owl:ObjectProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:string .
hpc:corespersocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:integer .
hpc:threadspercore a owl:DatatypeProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:integer .
hpc:defaulttaskprolog a owl:ObjectProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:string .
hpc:defaulttaskepilog a owl:ObjectProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:string .
hpc:defaulttaskplugin a owl:ObjectProperty ;
    rdfs:domain hpc:Nodeconfiguration ;
    rdfs:range xsd:string .
hpc:Dualcore a hpc:NodeConfiguration ;
    hpc:CoresPerSocket 32 ;
    hpc:ThreadsPerCore 1 .
