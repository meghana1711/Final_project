hpc:Cluster a owl:Class .
hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Statichost rdfs:subClassOf hpc:Host .
hpc:Primaryadmin rdfs:subClassOf hpc:User .
hpc:Betweenhostuseraccountmapping rdfs:subClassOf hpc:Group .
hpc:Localuseraccountmapping rdfs:subClassOf hpc:Betweenhostuseraccountmapping .
hpc:Windowsworkgroupaccountmapping rdfs:subClassOf hpc:Betweenhostuseraccountmapping .
hpc:hasMember rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:User .
hpc:isHostOf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster .
hpc:hasMapping rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Betweenhostuseraccountmapping ;
    rdfs:range hpc:User .
hpc:isMappedTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User .
hpc:isLocal rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Localuseraccountmapping ;
    rdfs:range xsd:boolean .
hpc:isWindowsWorkgroup rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Windowsworkgroupaccountmapping ;
    rdfs:range xsd:boolean .
