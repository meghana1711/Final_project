hpc:Host a owl:Class .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:socket a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Socket .
hpc:Core rdfs:subPropertyOf hpc:Socket .
hpc:core a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:Socket .
hpc:pu a owl:DatatypeProperty ;
    rdfs:domain hpc:Core .
hpc:Pu rdfs:range xsd:nonNegativeInteger .
