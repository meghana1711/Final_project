hpc:eligiblependingtimelimit a owl:DatatypeProperty .
hpc:Eligiblependingtimelimit rdfs:domain hpc:Applicationprofile ;
                                 rdfs:range xsd:nonNegativeInteger .

hpc:priority a owl:DatatypeProperty .
hpc:Priority rdfs:domain hpc:Applicationprofile ;
               rdfs:range xsd:nonNegativeInteger .

hpc:Apspriorityfactor a owl:Class .
hpc:Apspriorityfactor rdfs:subClassOf hpc:Applicationprofile .

hpc:jobattach a owl:ObjectProperty .
hpc:Jobattach rdfs:domain hpc:Apspriorityfactor ;
              rdfs:range xsd:string .

hpc:jobid a owl:DatatypeProperty .
hpc:Jobid rdfs:domain hpc:Jobattach ;
          rdfs:range xsd:nonNegativeInteger .

hpc:hostname a owl:DatatypeProperty .
hpc:Hostname rdfs:domain hpc:Jobattach ;
             rdfs:range xsd:string .

hpc:shellpath a owl:DatatypeProperty .
hpc:Shellpath rdfs:domain hpc:Jobattach ;
              rdfs:range xsd:string .

hpc:indexlist a owl:DatatypeProperty .
hpc:Indexlist rdfs:domain hpc:Jobid ;
              rdfs:range xsd:nonNegativeInteger .

hpc:Jobexecutionhost a owl:Class .
