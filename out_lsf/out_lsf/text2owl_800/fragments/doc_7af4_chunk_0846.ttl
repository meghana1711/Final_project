hpc:LsfLsloadFormat a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Customized output format for the lsload command." .

hpc:Field a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A field in the LSF LSLOAD output." .

hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The width of the field in the output." .

hpc:unit a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string ;
    rdfs:comment "The unit of the field in the output." .

hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLsloadFormat ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the field in the LSF LSLOAD output." .

hpc:delimiter a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLsloadFormat ;
    rdfs:range xsd:string ;
    rdfs:comment "The delimiter character for the LSF LSLOAD output." .

hpc:justification a owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string ;
    rdfs:comment "The justification of the field in the output (left or right)." .

hpc:Wildcard a owl:Class ;
    rdfs:subClassOf hpc:Field ;
    rdfs:comment "A wildcard character (*) in the field name." .
