@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:ServiceDomain a owl:Class .
hpc:licServers a owl:ObjectProperty .
hpc:Lm a owl:Class .

hpc:LicServers rdfs:domain hpc:ServiceDomain .
hpc:LicServers rdfs:range xsd:string .

hpc:Lm rdfs:subClassOf hpc:ServiceDomain .

hpc:lsfLogMask a owl:DatatypeProperty .
hpc:LOG_WARNING xsd:string .
hpc:LOG_DEBUG xsd:string .
hpc:LOG_DEBUG1 xsd:string .
hpc:LOG_DEBUG2 xsd:string .
hpc:LOG_DEBUG3 xsd:string .

hpc:LsfLogMask rdfs:domain hpc:Lm .
hpc:LsfLogMask rdfs:range xsd:string .

hpc:lsfLicSchedHosts a owl:DatatypeProperty .
hpc:lsfLicSchedPreemptRequeue a owl:DatatypeProperty .
hpc:lsfLicSchedPreemptSlotRelease a owl:DatatypeProperty .
hpc:lsfLicSchedPreemptStop a owl:DatatypeProperty .

hpc:LsfLicSchedHosts rdfs:domain hpc:Lm .
hpc:LsfLicSchedPreemptRequeue rdfs:domain hpc:Lm .
hpc:LsfLicSchedPreemptSlotRelease rdfs:domain hpc:Lm .
hpc:LsfLicSchedPreemptStop rdfs:domain hpc:Lm .
hpc:LsfLicSchedHosts rdfs:range xsd:string .
hpc:LsfLicSchedPreemptRequeue rdfs:range xsd:string .
hpc:LsfLicSchedPreemptSlotRelease rdfs:range xsd:string .
hpc:LsfLicSchedPreemptStop rdfs:range xsd:string .

hpc:Feature a owl:Class .
hpc:strict a owl:ObjectProperty .

hpc:Strict rdfs:domain hpc:Feature .
hpc:Strict rdfs:range xsd:string .
