hpc:Command a owl:Class .
hpc:hasCommandLine an owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Jobcontrols a owl:Class .
hpc:suspendaction a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrols ;
    rdfs:range hpc:Action .
hpc:terminateaction a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrols ;
    rdfs:range hpc:Action .
hpc:chkpntaction a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrols ;
    rdfs:range hpc:Action .

hpc:Action a owl:Class .
hpc:Suspend a Action ;
    rdfs:subClassOf hpc:Action .
hpc:Terminate a Action ;
    rdfs:subClassOf hpc:Action .
hpc:Chkpnt a Action ;
    rdfs:subClassOf hpc:Action .

hpc:haschkpnt a owl:ObjectProperty ;
    rdfs:domain hpc:Chkpnt ;
    rdfs:range xsd:boolean .

hpc:Job a owl:Class .
hpc:hasJobControls an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobcontrols .
hpc:isCheckpointed an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isStopped an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isKilled an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Shellcommand a owl:Class ;
    rdfs:subClassOf hpc:Command .
