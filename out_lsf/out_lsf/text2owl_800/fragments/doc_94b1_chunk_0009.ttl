hpc:Timewindow a owl:Class .
hpc:idletime a owl:ObjectProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:minutes .
hpc:hostidletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:Hoststate a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Okstate a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:ClosedCuExcl a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:OkPowered a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:Activesystemadvancereservation a owl:Class .
hpc:cycletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:minutes .
hpc:Hostnotrunningjob a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:hostrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Host .
hpc:powerstatechangecounter a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:Powerstatechangecounterresetreason a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Notrunningjob a owl:Class ;
    rdfs:subClassOf hpc:Powerstatechangecounterresetreason .
hpc:InokClosedCuExclOrOkPoweredstate a owl:Class ;
    rdfs:subClassOf hpc:Powerstatechangecounterresetreason .
hpc:Notactivesystemadvancereservation a owl:Class ;
    rdfs:subClassOf hpc:Powerstatechangecounterresetreason .
hpc:minimumtimebetweenpowerstatechanges a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:minutes .
hpc:Poweraction a owl:Class .
hpc:poweractionissuedregardlessofrecenthoststatuschanges a owl:ObjectProperty ;
    rdfs:domain hpc:Poweraction .
hpc:powersuspendtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Poweraction ;
    rdfs:range xsd:duration .
hpc:PowerSuspendTimeoutDefault a owl:NamedIndividual ;
    hpc:PowerSuspendTimeout "PT10M" .
hpc:powersuspendtimeoutlsbparams a owl:ObjectProperty ;
    rdfs:domain hpc:Poweraction ;
    rdfs:range hpc:Lsbparams .
hpc:powerresumetimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Poweraction ;
    rdfs:range xsd:duration .
hpc:PowerResumeTimeoutDefault a owl:NamedIndividual ;
    hpc:PowerResumeTimeout "PT600S" .
hpc:Controlandmonitorhostpowerstatemanagement a owl:Class .
