hpc:Instance a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents an instance launched using Azure's instance tagging feature." .

hpc:instancetag a owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string ;
    rdfs:comment "The key-value pairs used to tag the instance." .

hpc:keypairlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string ;
    rdfs:comment "The SSH public key file location from the CycleCloud server for the user account to access the virtual instances." .

hpc:interruptible a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Optional. If set to true, the virtual instances are spot VMs that the Azure infrastructure can evict." .

hpc:maxprice a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Optional. For spot VMs, specifies the maximum allowed price of the instance, in USD per hour per instance." .

hpc:instanceid a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string ;
    rdfs:comment "The ID of the instance created if not specified." .
