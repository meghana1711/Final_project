hpc:returnswhichofthesenameshasbeenassignedtotheresource a owl:ObjectProperty ;
                                                          rdfs:domain hpc:Bhosts .
hpc:displaysindividualnamesofallthehostsinthecluster a owl:ObjectProperty ;
