hpc:PAM a owl:Class .
hpc:PAM_Slurm a owl:Class ;
    rdfs:subClassOf hpc:PAM .
hpc:PAM_Listfile a owl:Class .
hpc:SSSD a owl:Class .
hpc:Slurm a owl:Class .

# System configurations
hpc:PAM_Configuration a owl:Class ;
    rdfs:subClassOf hpc:PAM .
hpc:Slurm_Configuration a owl:Class ;
    rdfs:subClassOf hpc:Slurm .

# User management
hpc:UserManagement a owl:Class ;
    rdfs:subClassOf hpc:Slurm_Configuration .
hpc:Exclude_User a owl:Class ;
    rdfs:subClassOf hpc:UserManagement .
    rdfs:subClassOf hpc:PAM_Configuration .
    rdfs:subClassOf hpc:PAM_Slurm .
    rdfs:subClassOf hpc:PAM_Listfile .
    rdfs:domain hpc:User .

hpc:Allowed_Users a owl:Class .
hpc:Allowed_Users_File a owl:Class ;
    rdfs:subClassOf hpc:Allowed_Users .
    rdfs:domain hpc:File .

hpc:Exclude_User_From_Pam_Slurm a owl:ObjectProperty ;
    rdfs:domain hpc:Exclude_User ;
    rdfs:range hpc:User .

hpc:Allowed_Users_File_Location a owl:DatatypeProperty ;
    rdfs:domain hpc:Allowed_Users_File .
    rdfs:range xsd:string .

# Job management
hpc:Job_Management a owl:Class ;
    rdfs:subClassOf hpc:Slurm_Configuration .
hpc:Job_Suspension a owl:Class ;
    rdfs:subClassOf hpc:Job_Management .
    rdfs:subClassOf hpc:PAM_Slurm .

hpc:Job_Suspension_Script a owl:Class ;
    rdfs:subClassOf hpc:Job_Suspension .
    rdfs:domain hpc:File .

hpc:Job_Suspension_Command a owl:ObjectProperty ;
    rdfs:domain hpc:Job_Suspension_Script .
    rdfs:range xsd:string .

# Database management
hpc:Database_Management a owl:Class ;
    rdfs:subClassOf hpc:Slurm_Configuration .
hpc:User_Account_Association a owl:Class ;
    rdfs:subClassOf hpc:Database_Management .
    rdfs:domain hpc:Association .
    rdfs:range hpc:User .

hpc:User_Account a owl:DatatypeProperty ;
    rdfs:domain hpc:User_Account_Association .
    rdfs:range xsd:string .

# UID management
hpc:UID_Management a owl:Class ;
    rdfs:subClassOf hpc:Slurm
