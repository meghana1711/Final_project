hpc:Node a owl:Class .
hpc:hasName a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:hasWeight a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:decimal .

hpc:isPoweredUp a owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:isOnDemand a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:boolean .

hpc:hasState a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:NodeState .
hpc:CLOUD a hpc:NodeState .

hpc:Partition a owl:Class .
hpc:hasParameter a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:PartitionParameter .

hpc:PowerDownOnIdle a hpc:PartitionParameter ;
    rdfs:range xsd:boolean .

hpc:PowerSaving a hpc:PartitionParameter .

hpc:PowerDownTransition a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:PowerDownTransitionType .
hpc:CompletingAllJobs a hpc:PowerDownTransitionType .
hpc:ExclusiveUserTransition a hpc:PowerDownTransitionType .

hpc:ExclusiveUser a hpc:PartitionParameter ;
    rdfs:range xsd:boolean .
```
