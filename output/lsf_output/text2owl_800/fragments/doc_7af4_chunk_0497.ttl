hpc:normalizedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:absoluteruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:cpufactor a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hostmodelname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Defaulthostspec a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Queueleveldefaulthostspec a owl:Class ;
    rdfs:subClassOf hpc:Defaulthostspec .

hpc:Clusterleveldefaulthostspec a owl:Class ;
    rdfs:subClassOf hpc:Defaulthostspec .

hpc:Jobwithrunlimitgreaterthanthirtyminutes a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Interruptiblebackfillqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
