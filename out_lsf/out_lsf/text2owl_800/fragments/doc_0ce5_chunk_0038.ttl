hpc:Managementhost a owl:Class .
hpc:Scheduler a owl:Class .
hpc:jobschedulinginterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:nonNegativeInteger .
hpc:schedulerthreads a owl:DatatypeProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsfstrictresreq a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:boolean .
hpc:Largescalecluster a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .
hpc:schedulerthreadevaluation a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:Schedulerthread .
hpc:Schedulerthread a owl:Class .
