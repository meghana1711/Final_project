hpc:GPU a owl:Class .
hpc:MPS a owl:Class .
hpc:GRES a owl:Class .
hpc:AllocatedGRES a owl:Class .
hpc:allocatedAs a owl:ObjectProperty .
hpc:totalCount a owl:DatatypeProperty .
hpc:configuredCount a xsd:nonNegativeInteger .
hpc:node a owl:Class .
hpc:Job a owl:Class .
hpc:requestedGRES a owl:ObjectProperty .
hpc:requestedMPS a owl:ObjectProperty .
hpc:requestedGPU a owl:ObjectProperty .
hpc:cannotRequestWithinJob a owl:ObjectProperty .
hpc:cannotSpecifyGPUFrequency a owl:ObjectProperty .
hpc:Prolog a owl:Class .
hpc:startMPSServer a owl:ObjectProperty .
hpc:CUDA_VISIBLE_DEVICES rdf:type xsd:string .
hpc:CUDA_MPS_ACTIVE_THREAD_PERCENTAGE rdf:type xsd:nonNegativeInteger .
hpc:SLURM_JOB_UID rdf:type xsd:string .
hpc:GRES rdfs:subClassOf hpc:Resource .
hpc:GPU rdfs:subClassOf hpc:GRES .
hpc:MPS rdfs:subClassOf hpc:GRES .
hpc:AllocatedGRES rdfs:subClassOf hpc:GRES .
hpc:allocatedAs rdfs:domain hpc:GRES ;
                        rdfs:range hpc:AllocatedGRES .
hpc:totalCount rdfs:domain hpc:AllocatedGRES ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:configuredCount rdfs:domain hpc:GRES ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:node rdfs:subClassOf hpc:Resource .
hpc:Job rdfs:subClassOf hpc:Resource .
hpc:requestedGRES rdfs:domain hpc:Job ;
                     rdfs:range hpc:GRES .
hpc:requestedMPS rdfs:domain hpc:Job ;
                   rdfs:range hpc:MPS .
hpc:requestedGPU rdfs:domain hpc:Job ;
                   rdfs:range hpc:GPU .
hpc:cannotRequestWithinJob rdfs:domain hpc:Job ;
                           rdfs:range hpc:Job .
hpc:cannotSpecifyGPUFrequency rdfs:domain hpc:Job ;
                              rdfs:range hpc:Job .
hpc:Prolog rdfs:subClassOf hpc:Resource .
hpc:startMPSServer rdfs:domain hpc:Prolog ;
                      rdfs:range hpc:MPS .
```
