hpc:Slurm a owl:Class .
hpc:Elasticsearch a owl:Class .
hpc:hasurl a owl:ObjectProperty .
hpc:hasdebugflags a owl:DatatypeProperty .
hpc:hasindexdata a owl:ObjectProperty .
hpc:hasvisualization a owl:ObjectProperty .
hpc:haskibana a owl:DatatypeProperty .
hpc:hasindexname a owl:DatatypeProperty .
hpc:hascurlcommand a owl:DatatypeProperty .

hpc:Slurm rdfs:subClassOf rdf:Resource .
hpc:Elasticsearch rdfs:subClassOf rdf:Resource .
hpc:Hasurl rdfs:domain hpc:Slurm ;
                          rdfs:range xsd:string .
hpc:Hasdebugflags rdfs:domain hpc:Elasticsearch ;
                   rdfs:range xsd:string .
hpc:Hasindexdata rdfs:domain hpc:Elasticsearch .
hpc:Hasvisualization rdfs:domain hpc:Slurm .
hpc:Haskibana rdfs:range xsd:string .
hpc:Hasindexname rdfs:domain hpc:Kibana ;
                   rdfs:range xsd:string .
hpc:Hascurlcommand rdfs:domain hpc:Debuggingtool ;
                     rdfs:range xsd:string .
