    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int .

hpc:delayBoot rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int .

hpc:derivedExitCode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int .

