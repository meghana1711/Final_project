hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Resource a owl:Class .
hpc:Cluster a owl:Class .
hpc:Queue a owl:Class .
hpc:Hostpartition a owl:Class .
hpc:Fairsharepolicy a owl:Class .
hpc:share a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:decimal .
hpc:priority a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:decimal .
hpc:fairshareassignment a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharepolicy ;
    rdfs:range hpc:Resource .
hpc:QueueLevelFairShare a hpc:FairSharePolicy ;
    rdfs:subClassOf hpc:Fairsharepolicy .
hpc:HostPartitionFairShare a hpc:FairSharePolicy ;
    rdfs:subClassOf hpc:Fairsharepolicy .
hpc:CrossQueueFairShare a hpc:FairSharePolicy ;
    rdfs:subClassOf hpc:Fairsharepolicy .
hpc:HostLevelFairShare a hpc:FairSharePolicy ;
    rdfs:subClassOf hpc:Fairsharepolicy .
hpc:Queuelevel rdfs:domain hpc:Queue .
hpc:Hostpartition rdfs:domain hpc:Hostpartition .
