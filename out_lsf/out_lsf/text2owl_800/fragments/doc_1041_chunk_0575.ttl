hpc:Script a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A script that can be submitted to a high-performance computing system." .

hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "The act of submitting a job to a high-performance computing system." .

hpc:standardinput a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "The standard input of a job submission." .

hpc:spooledscript a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Script ;
    rdfs:comment "Whether the script is spooled or not." .

hpc:embeddedoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range hpc:Jobsubmissionoption ;
    rdfs:comment "The embedded job submission options in a script." .

hpc:Jobsubmissionoption a owl:Class ;
    rdfs:subClassOf hpc:Namedvalue ;
    rdfs:comment "A job submission option embedded in a script." .

hpc:commandlineoptions a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobsubmissionoption ;
    rdfs:comment "The command-line options provided by the user." .

hpc:scriptmodification a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether the script can be modified after job submission." .

hpc:Jobqueue a owl:Class ;
    rdfs:subClassOf hpc:Namedvalue ;
    rdfs:comment "A queue for job submission." .

hpc:outputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoption ;
    rdfs:range xsd:string ;
    rdfs:comment "The output file for the job." .

hpc:memoryrequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoption ;
    rdfs:range xsd:string ;
    rdfs:comment "The memory requirement for the job." .

hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoption ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the job." .
