hpc:Apachehttpserver a owl:Class .
hpc:systemctlstop a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserver ;
    rdfs:range xsd:string .

hpc:systemctlstart a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserver ;
    rdfs:range xsd:string .

hpc:Httpproxy a owl:Class .
hpc:logontohttpproxy a owl:ObjectProperty ;
    rdfs:domain hpc:Httpproxy ;
    rdfs:range xsd:string .

hpc:listloggedinclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Httpproxy ;
    rdfs:range hpc:Clusterlist .

hpc:Clusterlist a owl:Class .
hpc:defaultname a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterlist ;
    rdfs:range xsd:string .
hpc:version a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterlist ;
    rdfs:range xsd:string .
hpc:url a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterlist ;
    rdfs:range xsd:string .

hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Httpproxy ;
    rdfs:range xsd:string .

hpc:stoplsfwebservice a owl:ObjectProperty ;
    rdfs:domain hp:WebServicesHost ;
    rdfs:range xsd:string .

hpc:submitanotherjob a owl:ObjectProperty ;
    rdfs:domain hpc:Webserviceshost ;
    rdfs:range xsd:string .

hpc:Webserviceshost a owl:Class .
