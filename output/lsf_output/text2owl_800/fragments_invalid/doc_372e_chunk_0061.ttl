hpc:Licenseschedulerdaemon a owl:Class .
hpc:LsfLicSchedHosts a owl:Class .
hpc:Candidatehost a owl:Class .
hpc:Failoverhost a owl:Class .
hpc:CommunicationLink an owl:ObjectProperty .
hpc:Runs rdfs:domain hpc:Licenseschedulerdaemon ;
                        rdfs:range hpc:Candidatehost .
hpc:Iscandidatefor rdfs:domain hpc:Candidatehost ;
                     rdfs:range hpc:LsfLicSchedHosts .
hpc:Isfailover rdfs:domain hpc:Candidatehost ;
                 rdfs:range hpc:Failoverhost .
hpc:Hascommunicationlink rdfs:domain hpc:Failoverhost ;
                        rdfs:range hpc:Communicationlink .
hpc:LicenseScheduler a hpc:LicenseSchedulerDaemon .
hpc:Hosta hpc:designcenterACom a hpc:LicenseScheduler .
hpc:Hosta hpc:iscandidatefor hpc:LSF_LIC_SCHED_HOSTS .
hpc:hostB a hpc:CandidateHost .
hpc:Hostb hpc:iscandidatefor hpc:LSF_LIC_SCHED_HOSTS .
hpc:Hostb hpc:isfailover hpc:hostA .
hpc:Hostb hpc:hascommunicationlink hpc:hostA .
