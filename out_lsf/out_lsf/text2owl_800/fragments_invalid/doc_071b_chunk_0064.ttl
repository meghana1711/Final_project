hpc:Submission a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job submission." .

hpc:submittinguser a owl:ObjectProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who submitted the job." .

hpc:host a owl:ObjectProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:string ;
    rdfs:comment "The host from which the job was submitted." .

hpc:executionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:string ;
    rdfs:comment "The host where the job was executed." .

hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The total CPU time (user plus system time) used by the job." .

hpc:exitstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The exit status of the job." .

hpc:outputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:string ;
    rdfs:comment "The file where the standard output and standard error are stored." .

hpc:standardinputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file from which the job reads input if it needs to read from stdin." .

hpc:maxfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the file path, including the directory, file name, and expanded values for %J and %I." .

hpc:unixmaxfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the file path for UNIX and Linux." .

hpc:windowsmaxfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the file path for Windows." .

hpc:outputonexecutionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range hpc:Executionhost ;
    rdfs:comment "The host where the output file is created." .

hpc:disablejobemail a owl:ObjectProperty ;
    rdfs:domain hpc:Submission ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether job email is disabled." .

hpc:jobemailsize a owl:DatatypeProperty ;
