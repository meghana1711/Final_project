hpc:LsfDaemon a owl:Class .
hpc:LsfConf a owl:Class .

hpc:LsbTimeCmd rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .
hpc:LsbTimeMbd rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .
hpc:LsbTimeSbd rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .
hpc:LsbTimeSch rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .
hpc:LsfTimeLim rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .
hpc:LsfTimeRes rdfs:domain hpc:LsfConf ;
    rdfs:range xsd:string .

hpc:LsfJobTerminationReasonLogging rdfs:subClassOf hpc:LsfLogging .
hpc:LsfJobExitCodes rdfs:subClassOf hpc:LsfLogging .

hpc:LsfSystemDirectoriesLogFiles a owl:Class .

hpc:LsfLogFiles a owl:Class .
hpc:LsfDaemonErrorLogs rdfs:subClassOf hpc:LsfLogFiles .

hpc:LsfLogFile a owl:Class .
hpc:HasLogDirectory rdfs:domain hpc:LsfLogFile ;
    rdfs:range hpc:Directory .
hpc:IsReopened rdfs:domain hpc:LsfLogFile ;
    rdfs:range xsd:boolean .
hpc:LogsDaemonErrors rdfs:domain hpc:LsfLogFile .

hpc:LsfLogLevel a owl:Class .
hpc:IsControlledByLsfLogMask rdfs:domain hpc:LsfLogLevel ;
    rdfs:range hpc:LsfConf .
hpc:HasLogPriority rdfs:domain hpc:LsfLogLevel ;
    rdfs:range xsd:string .

hpc:LsfLogDirectory a owl:Class .
hpc:IsDirectorLogDirectory rdfs:domain hpc:LsfLogDirectory ;
    rdfs:range hpc:Directory .

hpc:lsfLogMask a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:HasValue rdfs:domain hpc:LsfLogMask ;
    rdfs:range xsd:string .

hpc:lsfLogDir a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:HasValue rdfs:domain hpc:LsfLogDir ;
    rdfs:range xsd:string .

hpc:Directory a owl:Class .
