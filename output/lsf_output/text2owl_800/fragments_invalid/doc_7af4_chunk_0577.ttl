@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Serviceclass a owl:Class .
hpc:hasgoal a owl:ObjectProperty .
hpc:haspriority a owl:DatatypeProperty .
hpc:hasdescription a owl:DatatypeProperty .
hpc:hasusergroup a owl:ObjectProperty .

hpc:Serviceclass rdfs:subClassOf owl:Class .
hpc:Hasgoal rdfs:domain hpc:Serviceclass ;
                 rdfs:range rdf:List .
hpc:Haspriority rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:integer .
hpc:Hasdescription rdfs:domain hpc:Serviceclass ;
                   rdfs:range xsd:string .
hpc:Hasusergroup rdfs:domain hpc:Serviceclass ;
                  rdfs:range rdf:List .

hpc:Sooke a hpc:ServiceClass ;
         hpc:NAME "Sooke" ;
         hpc:PRIORITY 20 ;
         hpc:GOALS (hpc:GOAL (hpc:GOAL_TYPE "DEADLINE" ;
                                 hpc:timeWindow "xsd:dateTime('08:30-16:00')") ) ;
         hpc:DESCRIPTION "working hours" .

hpc:Nanaimo a hpc:ServiceClass ;
          hpc:NAME "Nanaimo" ;
          hpc:PRIORITY 20 ;
          hpc:GOALS (hpc:GOAL (hpc:GOAL_TYPE "DEADLINE" ;
                                 hpc:timeWindow "xsd:dateTime('17:18:00-01:08:30 20:00-08:30')") ) ;
          hpc:DESCRIPTION "weekend nighttime regression tests" .

hpc:Sidney a hpc:ServiceClass ;
         hpc:NAME "Sidney" ;
         hpc:PRIORITY 20 ;
         hpc:GOALS (hpc:GOAL (hpc:GOAL_TYPE "THROUGHPUT" ;
                                 hpc:timeWindow "" ;
                                 hpc:value 6) ) ;
         hpc:DESCRIPTION "constant throughput" .

hpc:Tofino a hpc:ServiceClass ;
         hpc:NAME "Tofino" ;
         hpc:PRIORITY 20 ;
         hpc:GOALS (hpc:GOAL (hpc:GOAL_TYPE "VELOCITY" ;
                                 hpc:timeWindow "xsd:dateTime('09:00-17:00')" ;
                                 hpc:value 10) ;
