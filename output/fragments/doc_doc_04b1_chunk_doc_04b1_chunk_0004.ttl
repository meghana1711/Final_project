hpc:SlurmctldDaemon a owl:Class .

hpc:MaxJobCount a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldDaemon ;
    rdfs:range xsd:integer .

hpc:MessageTimeout a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldDaemon ;
    rdfs:range xsd:integer .

hpc:MinJobAge a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldDaemon ;
    rdfs:range xsd:integer .

hpc:PriorityScheduler a owl:Class ;
    rdfs:subClassOf hpc:SlurmctldDaemon .

hpc:PrologSlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldDaemon ;
    rdfs:range xsd:boolean .

hpc:EpilogSlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldDaemon ;
    rdfs:range xsd:boolean .
