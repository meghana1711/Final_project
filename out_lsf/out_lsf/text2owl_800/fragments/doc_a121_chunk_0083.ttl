hpc:Job a owl:Class .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Userpriority a owl:Class ;
    rdfs:subClassOf hpc:Priority .
hpc:maxuserpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Userpriority ;
    rdfs:range xsd:integer .
hpc:jobownedpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:defaultpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:automaticescalation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Escalation .
hpc:Escalation a owl:Class .
hpc:Eligiblependingjob a owl:Class ;
    rdfs:subClassOf hpc:Pendingjob .
hpc:Ineligiblependingjob a owl:Class ;
    rdfs:subClassOf hpc:Pendingjob .
hpc:Pendingjobresizableallocationrequest a owl:Class ;
    rdfs:subClassOf hpc:Pendingjob .
hpc:Originaljob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Adjustedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:trackeligiblependinginfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams .
