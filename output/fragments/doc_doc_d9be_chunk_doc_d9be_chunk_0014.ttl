hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Node a owl:Class .
hpc:Socket a owl:Class .
hpc:CPU a owl:Class .

hpc:hasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:isBoundTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:CPU .

hpc:isOnNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:CPU ;
    rdfs:range hpc:Node .

hpc:isOnSocket rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:CPU ;
    rdfs:range hpc:Socket .

hpc:hasSocket rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Socket .

hpc:hasCPU rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:CPU .

hpc:hasCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer .

hpc:hasTaskId rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Task .

hpc:JobWithTaskAffinity a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:JobWithCpuAffinity a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:JobWithSocketAffinity a owl:Class ;
    rdfs:subClassOf hpc:Job .
```
