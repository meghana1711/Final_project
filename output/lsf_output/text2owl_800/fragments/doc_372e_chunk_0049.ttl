hpc:Projectgroup a owl:Class .
hpc:Project a owl:Class .
hpc:projectgroupownership a owl:ObjectProperty .
hpc:groupshares a owl:DatatypeProperty .
hpc:groupdistribution a owl:DatatypeProperty .
hpc:servicedomains a owl:DatatypeProperty .

hpc:Projectgroupownership rdfs:domain hpc:Projectgroup .
hpc:Projectgroupownership rdfs:range rdf:List .
hpc:Groupshares rdfs:domain hpc:Projectgroup .
hpc:Groupshares rdfs:range xsd:nonNegativeInteger .
hpc:Groupdistribution rdfs:domain hpc:Feature .
hpc:Groupdistribution rdfs:range hpc:Projectgroup .
hpc:Servicedomains rdfs:domain hpc:Feature .
hpc:Servicedomains rdfs:range rdf:List .

hpc:ProjectGroup_topgrp a hpc:ProjectGroup .
hpc:ProjectgroupTopgrp hpc:groupshares "1" .
hpc:ProjectgroupTopgrp hpc:projectgroupownership (hpc:ProjectGroup_g1 hpc:ProjectGroup_g2) .

hpc:ProjectGroup_g1 a hpc:ProjectGroup .
hpc:ProjectgroupG1 hpc:groupshares "1 1 1" .
hpc:ProjectgroupG1 hpc:projectgroupownership (hpc:ProjectGroup_g3 hpc:ProjectGroup_g4 hpc:ProjectGroup_others) .

hpc:ProjectGroup_g3 a hpc:ProjectGroup .
hpc:ProjectgroupG3 hpc:groupshares "2 2 1" .
hpc:ProjectgroupG3 hpc:projectgroupownership (hpc:Project_p1 hpc:Project_p2 hpc:ProjectGroup_others) .

hpc:Project_p1 a hpc:Project .
hpc:ProjectP1 hpc:projectgroup hpc:ProjectGroup_g3 .
hpc:ProjectP1 hpc:projectgroup hpc:ProjectGroup_g5 .

hpc:ProjectGroup_g5 a hpc:ProjectGroup .
hpc:ProjectgroupG5 hpc:groupshares "1 3" .
hpc:ProjectgroupG5 hpc:projectgroupownership (hpc:Project_p1) .

hpc:ProjectGroup_others a hpc:ProjectGroup .
hpc:ProjectgroupOthers hpc:groupshares "0" .
