hpc:Apachehttpserverhost a owl:Class .
hpc:Lsfwebserviceshost a owl:Class .
hpc:lwsd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost ;
    rdfs:range hpc:Apachehttpserverhost .
hpc:modsslapachemodule a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserverhost .
hpc:startlwsd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost .
hpc:stoplwsd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost .
hpc:enablehttps a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost ;
    rdfs:range xsd:string .
hpc:disablehttps a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost .
hpc:generatecertificateandkey a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceshost ;
    rdfs:range xsd:string .
hpc:validhosts a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:certificatename a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:password a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:installmodsslapachemodule a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserverhost .
