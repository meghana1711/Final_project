hpc:EauthClient a owl:Class .
hpc:EauthServer a owl:Class .
hpc:auxDataFile a owl:DatatypeProperty ;
    rdfs:domain hpc:EauthClient ;
    rdfs:range xsd:string .
hpc:auxDataStatus a owl:DatatypeProperty ;
    rdfs:domain hpc:EauthServer ;
    rdfs:range xsd:string .
hpc:userAuthData a owl:DatatypeProperty ;
    rdfs:domain hpc:EauthClient ;
    rdfs:range xsd:string .
hpc:userCredentials a owl:ObjectProperty ;
    rdfs:domain hpc:EauthServer ;
    rdfs:range hpc:UserAuthData .
