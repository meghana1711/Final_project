hpc:Serviceclass a owl:Class .
hpc:hasgoal a owl:ObjectProperty .
hpc:Hasgoal rdfs:domain hpc:Serviceclass ;
                 rdfs:range rdfs:Resource .
hpc:distribution a owl:ObjectProperty .
hpc:Distribution rdfs:domain hpc:Serviceclass ;
                 rdfs:range rdfs:List .
hpc:Distributionlist a owl:Class .
hpc:Distributionlist rdfs:subClassOf rdfs:List ;
                     rdfs:subClassOf rdf:List .
hpc:distributionelement a owl:ObjectProperty .
hpc:Distributionelement rdfs:domain hpc:Distributionlist ;
                        rdfs:range hpc:Serviceclass .
hpc:slotcount a owl:DatatypeProperty .
hpc:Slotcount rdfs:domain hpc:Serviceclass ;
                 rdfs:range xsd:integer .
