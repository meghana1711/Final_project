hpc:Resourceuse a owl:Class .
hpc:SuspendedJob a subClassOf hpc:ResourceUse .
hpc:RunningJob a subClassOf hpc:ResourceUse .

hpc:Usedguaranteehosts a owl:Class .
hpc:SLA a subClassOf hpc:UsedGuaranteeHosts .

hpc:Guaranteepool a owl:Class .
hpc:allocatedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usedguaranteehosts ;
    rdfs:range hpc:Guaranteepool .

hpc:Egoenabledsla a owl:Class ;
    rdfs:subClassOf hpc:Sla .

hpc:egoconsumer a owl:DatatypeProperty ;
    rdfs:domain hpc:Egoenabledsla .

hpc:egoresreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Egoenabledsla .

hpc:maxhostidletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla .

hpc:numrecalledhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla .

hpc:recalledhoststimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla .

hpc:Examples a owl:Class .

hpc:Timebasedserviceclass a owl:Class ;
    rdfs:subClassOf hpc:Egoenabledsla .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:consumer a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:usergroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:goals a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedserviceclass .

hpc:activewindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Sla .

hpc:Egoresreq rdfs:range xsd:string .
hpc:Maxhostidletime rdfs:range xsd:nonNegativeInteger .
hpc:Numrecalledhosts rdfs:range xsd:nonNegativeInteger .
hpc:Recalledhoststimeout rdfs:range xsd:nonNegativeInteger .
