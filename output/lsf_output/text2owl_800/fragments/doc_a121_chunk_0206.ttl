hpc:Simulation a owl:Class .
hpc:Optionsfile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:UNIXOptionsFile a hpc:OptionsFile ;
    rdfs:subClassOf hpc:Optionsfile ;
    rdfs:domain xsd:string ;
    rdfs:range hpc:Bourneshellcommand .

hpc:WindowsOptionsFile a hpc:OptionsFile ;
    rdfs:subClassOf hpc:Optionsfile ;
    rdfs:domain xsd:string ;
    rdfs:range hpc:Windowsbatchfilecommand .

hpc:bourneshellcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixoptionsfile .

hpc:windowsbatchfilecommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Windowsoptionsfile .

hpc:spooledjobcommandfile a owl:ObjectProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range hpc:File .

hpc:modifyorremovecommandfile a owl:ObjectProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range hpc:Command .

hpc:scripttostandardinput a owl:ObjectProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:string .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Simulation .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:Queue a owl:Class .
