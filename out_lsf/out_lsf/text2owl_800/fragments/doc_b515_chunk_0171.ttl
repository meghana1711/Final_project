hpc:Jobslot a owl:Class .
hpc:Host a owl:Class .
hpc:Memory a owl:Class .
hpc:usedmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeInteger .
hpc:usedslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeInteger .
hpc:slotmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:fairshareadjustment a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeReal .
hpc:threshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairshareadjustment ;
    rdfs:range xsd:nonNegativeReal .
hpc:Cluster a owl:Class .
hpc:dynamicpriorityadjustment a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeReal .
hpc:runtimedecay a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicpriorityadjustment .
hpc:historicalruntimedecay a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicpriorityadjustment .
hpc:committedruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicpriorityadjustment .
hpc:historicalruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicpriorityadjustment .
