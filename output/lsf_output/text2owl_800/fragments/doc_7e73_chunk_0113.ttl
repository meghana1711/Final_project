hpc:Openstackinstance a owl:Class .
hpc:downloadimage a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
hpc:uploadimage a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
hpc:launchinstance a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance .
hpc:enableroot a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance .
hpc:userdatascript a owl:DatatypeProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
hpc:logininstance a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance .
hpc:setupfirewall a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackinstance .
hpc:Clouduser a owl:Class .
hpc:Rootuser a owl:Class ;
    rdfs:subClassOf hpc:Clouduser .
hpc:sudoersfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
hpc:sudoersfileexists a owl:DatatypeProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
hpc:sudoersfilelog a owl:DatatypeProperty ;
    rdfs:domain hpc:Openstackinstance ;
    rdfs:range xsd:string .
