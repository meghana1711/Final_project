hpc:Gpujob a owl:Class .
hpc:Numberpertask rdfs:domain hpc:Gpujob ;
                   rdfs:range xsd:nonNegativeInteger ;
                   rdfs:subPropertyOf hpc:hasResourceRequirement .
hpc:Resourceconfiguration rdfs:domain hpc:Gpujob ;
                          rdfs:range xsd:string .
hpc:Resourcereservepertask rdfs:domain hpc:Gpujob ;
                             rdfs:range xsd:boolean .
hpc:Gpumode rdfs:domain hpc:Gpujob ;
                   rdfs:range xsd:string .
hpc:Usesmps rdfs:domain hpc:Gpujob ;
                   rdfs:range xsd:boolean .
hpc:Mpsmode rdfs:domain hpc:Gpujob ;
                   rdfs:range xsd:string .
hpc:Gvendor rdfs:domain hpc:Gpujob ;
                   rdfs:range xsd:string .

hpc:hasresourcerequirement a owl:ObjectProperty .
hpc:usesmps a owl:ObjectProperty .
hpc:mpsmode a owl:DatatypeProperty .
hpc:gvendor a owl:DatatypeProperty .
