hpc:LibraryFunction a owl:Class .
hpc:SymbolResolution a owl:ObjectProperty .
hpc:ApplicationFailure a owl:Class .
hpc:RegcompFunction a hpc:ProgramFunction .
hpc:POSIXRegexFunction a hpc:LibraryFunction .
hpc:RenamedFunction a owl:Class .
hpc:RenamedFunction rdfs:subClassOf hpc:ProgramFunction .
hpc:RenamedFunction rdfs:subClassOf hpc:RenamedFunction .
hpc:RenamedFunction rdfs:domain hpc:DAKOTAProgram .
hpc:RenamedFunction rdfs:range xsd:string .

# Resource Limits
hpc:ResourceLimitPropagation a owl:Class .
hpc:ResourceLimitPropagationFailure a owl:Class .
