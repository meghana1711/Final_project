hpc:SlurmService a owl:Class .
hpc:SlurmVersion a owl:Class .
hpc:ExecStartOverrides owl:ObjectProperty .
hpc:EnvironmentFile owl:ObjectProperty .
hpc:SlurmRestdOptions owl:DatatypeProperty .
hpc:SlurmRestdListen owl:DatatypeProperty .
hpc:ServiceEdit a owl:Class .
hpc:SystemdEdit a owl:Class .
hpc:OverrideFile a owl:Class .
hpc:SectionDeclaration a owl:Class .
hpc:EnvironmentVariable a owl:Class .

hpc:SlurmVersion "24.05" rdf:type hpc:SlurmVersion .
hpc:SlurmService rdfs:subClassOf owl:Thing .
hpc:ExecStartOverrides rdfs:domain hpc:SlurmService ;
    rdfs:range xsd:string .
hpc:EnvironmentFile rdfs:domain hpc:SlurmService ;
    rdfs:range rdf:Resource .
hpc:SlurmRestdOptions rdfs:domain hpc:SlurmService ;
    rdfs:range xsd:string .
hpc:SlurmRestdListen rdfs:domain hpc:SlurmService ;
    rdfs:range xsd:string .
hpc:ServiceEdit rdfs:subClassOf owl:Thing .
hpc:SystemdEdit rdfs:subClassOf hpc:ServiceEdit .
hpc:OverrideFile rdfs:subClassOf hpc:SystemdEdit .
hpc:SectionDeclaration rdfs:subClassOf hpc:OverrideFile .
hpc:EnvironmentVariable rdfs:subClassOf owl:Thing .

hpc:SlurmService rdf:type rdfs:Resource ;
    hpc:ExecStartOverrides hpc:ExecStartOverrides1 ;
    hpc:EnvironmentFile hpc:EnvironmentFile1 ;
    hpc:SlurmRestdOptions hpc:SlurmRestdOptions1 ;
    hpc:SlurmRestdListen hpc:SlurmRestdListen1 .

hpc:EnvironmentFile1 rdf:type rdf:Resource ;
    rdfs:seeAlso "/etc/default/slurmrestd" ;
    rdfs:seeAlso "/etc/sysconfig/slurmrestd" .

hpc:SlurmRestdOptions1 rdf:type rdf:Literal ;
    xsd:datatype xsd:string .

hpc:SlurmRestdListen1 rdf:type rdf:Literal ;
    xsd:datatype xsd:string .
