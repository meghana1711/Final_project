hpc:Jobid a owl:Class ;
    rdfs:domain hpc:Job .

hpc:User a owl:Class ;
    rdfs:domain hpc:Job .

hpc:Host a owl:Class ;
    rdfs:domain hpc:Job .

hpc:Licenseproject a owl:Class ;
    rdfs:domain hpc:Job .

hpc:Cluster a owl:Class ;
    rdfs:domain hpc:Job .

hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:rusage a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Servicedomain a owl:Class ;
    rdfs:domain hpc:License .

hpc:checkoutlicense a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:License .

hpc:associatedwithjob a owl:ObjectProperty ;
    rdfs:domain hpc:License .
    rdfs:range hpc:Job .
