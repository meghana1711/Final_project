hpc:Command a owl:Class .
hpc:hasoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Option .
hpc:Option a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:unionOf (hpc:LocalOption hpc:GlobalOption) ] .
hpc:Localoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:intersectionOf (hpc:LocalFwdOption hpc:LocalGlOption hpc:LocalProjectOption hpc:LocalQueueOption) ] .
hpc:Localfwdoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Nofwd ] .
hpc:Localgloption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Nogl ] .
hpc:Localprojectoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Projectoption ] .
hpc:Projectoption a owl:Class ;
    rdfs:domain hpc:Localprojectoption ;
    rdfs:range hpc:Projectname .
hpc:Localqueueoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Queueoption ] .
hpc:Queueoption a owl:Class ;
    rdfs:domain hpc:Localqueueoption ;
    rdfs:range hpc:Queue .
hpc:Globaloption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:intersectionOf (hpc:GlobalBmgroupOption hpc:GlobalLimitOption) ] .
hpc:Globalbmgroupoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Nobmgroup ] .
hpc:Globallimitoption a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subPropertyOf hpc:HasOption ;
        rdfs:range hpc:Limitsection ] .
hpc:Limitsection a owl:Class ;
    rdfs:domain hpc:Globallimitoption ;
    rdfs:range xsd:string .
hpc:Bmgroupcommand a owl:Class .
hpc:Resourceallocationlimitcommand a owl:Class .
hpc:Bqueuescommand a owl:Class .
hpc:nofwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Localfwdoption ;
    rdfs:range xsd:boolean .
hpc:nogl a owl:DatatypeProperty ;
    rdfs:domain hpc:Localgloption ;
