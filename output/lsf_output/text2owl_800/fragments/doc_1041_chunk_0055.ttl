hpc:Lsfmanagementhost a owl:Class .
hpc:Managementcandidatehost a owl:Class .
hpc:Globalpolicydaemoncluster a owl:Class .
hpc:Gpdclustermember a owl:Class .
hpc:Logfile a owl:Class .
hpc:Gpolicyddaemon a owl:Class .
hpc:Gpdrestartcommand a owl:Class .
hpc:Globalpolicyconfigurationfile a owl:Class .
hpc:Lsbglobalpolicies a owl:Class .
hpc:Error a owl:Class .
hpc:Warningerror rdfs:subClassOf hpc:Error .
hpc:Unrecoverableerror rdfs:subClassOf hpc:Error .
hpc:gpdrestart a owl:ObjectProperty .
hpc:Haserror rdfs:domain hpc:Gpdrestartcommand ;
                      rdfs:range hpc:Error .
hpc:Hasglobalpolicyconfigurationfile rdfs:domain hpc:Gpdrestartcommand ;
                      rdfs:range hpc:Globalpolicyconfigurationfile .
hpc:Haslsfmanagementhost rdfs:domain hpc:Gpdclustermember ;
                      rdfs:range hpc:Lsfmanagementhost .
hpc:Hasmanagementcandidatehost rdfs:domain hpc:Gpdclustermember ;
                      rdfs:range hpc:Managementcandidatehost .
hpc:Haslogfile rdfs:domain hpc:Gpolicyddaemon ;
                      rdfs:range hpc:Logfile .
hpc:Hastiminglevel rdfs:domain hpc:Gpolicyddaemon ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:isverbosemode a owl:ObjectProperty .
hpc:isstrictmode a owl:ObjectProperty .
hpc:istiminglevelset a owl:ObjectProperty .
hpc:islogfileset a owl:ObjectProperty .
hpc:isoutputoptionset a owl:ObjectProperty .
hpc:isrestarted a owl:ObjectProperty .
hpc:Haswarningerror rdfs:domain hpc:Gpdrestartcommand ;
                      rdfs:range hpc:Warningerror .
hpc:Hasunrecoverableerror rdfs:domain hpc:Gpdrestartcommand ;
                      rdfs:range hpc:Unrecoverableerror .
