hpc:Usergroup a owl:Class .
hpc:Queue a owl:Class .
hpc:Limit a owl:Class .
hpc:Host a owl:Class .
hpc:deleteaction a owl:ObjectProperty .
hpc:updateaction a owl:ObjectProperty .
hpc:addmemberaction a owl:ObjectProperty .
hpc:addhostaction a owl:ObjectProperty .
hpc:updatehostaction a owl:ObjectProperty .

hpc:Hasusergroup rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:Resource .
hpc:Hasqueue rdfs:domain hpc:Queue ;
    rdfs:range rdf:Resource .
hpc:Haslimit rdfs:domain hpc:Limit ;
    rdfs:range rdf:Resource .
hpc:Hashost rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource .

hpc:UsergroupDeleted hpc:deleteaction .
hpc:QueueUpdated hpc:updateaction .
hpc:LimitUpdated hpc:updateaction .
hpc:LimitAddmember hpc:addmemberaction .
hpc:HostAdded hpc:addhostaction .
hpc:HostUpdated hpc:updatehostaction .

hpc:ug1 a hpc:Usergroup ;
    hpc:Hasusergroup hpc:ug2 .
hpc:aaa a hpc:Limit ;
    hpc:USERS "ug2"^^xsd:string .
hpc:owners a hpc:Queue ;
    hpc:USERS "ug2"^^xsd:string, "ug3"^^xsd:string .
hpc:q1 a hpc:Queue ;
    hpc:QJOB_LIMIT "10"^^xsd:integer .
hpc:aaa a hpc:Limit ;
    hpc:USERS "ellen"^^xsd:string, "user4"^^xsd:string, "julie"^^xsd:string .
hpc:host78 a hpc:Host ;
    hpc:hostname "host78"^^xsd:string ;
    hpc:HOST_NAME "host78"^^xsd:string ;
    hpc:MXJ "!"^^xsd:string ;
    hpc:mem "500/100"^^xsd:string .
hpc:lsf_cluster_x123 a rdf:Resource ;
    hpc:Hashost hpc:host78 .
hpc:lsb_hosts a rdf:Resource ;
    hpc:Hashost hpc:host78 .
hpc:lsb_resources a rdf:Resource ;
    hpc:hasLimit
