hpc:Lsf a owl:Class .
hpc:hasFixedCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .
hpc:hasRangeCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .
hpc:Cappedcpu a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
hpc:hasCappedCPUs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cappedcpu ;
    rdfs:range xsd:decimal .
hpc:totalPhysicalCPUs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cappedcpu ;
    rdfs:range xsd:nonNegativeInteger .
hpc:containerCPUUtilization rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cappedcpu ;
    rdfs:range xsd:percent .
hpc:hostLevelCPUUtilization rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Cappedcpu ;
    rdfs:range xsd:percent .
hpc:jobSlot rdf:type owl:Class .
hpc:hasJobSlot rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Cappedcpu ;
    rdfs:range hpc:Jobslot .
