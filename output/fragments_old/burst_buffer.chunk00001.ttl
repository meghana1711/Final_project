# Slurm Workload Manager
hpc:SlurmWorkloadManager a owl:Class .

# Documentation
hpc:Documentation a owl:Class .

# Job Submission Commands
hpc:JobSubmissionCommands a owl:Class .

# Datawarp
hpc:Datawarp a owl:Class .
hpc:DatawarpPlugin a owl:Class, rdfs:subClassOf [ hpc:SlurmPlugin ] .
hpc:DatawarpPluginCallsScript a owl:ObjectProperty .
hpc:DatawarpPluginCallsScript rdfs:domain hpc:DatawarpPlugin ;
                                   rdfs:range xsd:string .

# Lua
hpc:Lua a owl:Class .
hpc:LuaPlugin a owl:Class, rdfs:subClassOf [ hpc:SlurmPlugin ] .
hpc:LuaPluginCallsScript a owl:ObjectProperty .
hpc:LuaPluginCallsScript rdfs:domain hpc:LuaPlugin ;
                                   rdfs:range xsd:string .

# Slurm Plugin
hpc:SlurmPlugin a owl:Class .
hpc:BurstBufferType a owl:DatatypeProperty .
hpc:BurstBufferType rdfs:domain hpc:SlurmPlugin ;
                      rdfs:range xsd:string .

# Burst Buffer
hpc:BurstBuffer a owl:Class .
hpc:BurstBufferTypeForBurstBuffer a owl:ObjectProperty .
hpc:BurstBufferTypeForBurstBuffer rdfs:domain hpc:BurstBuffer ;
                                     rdfs:range xsd:string .

# Burst Buffer Plugin Configuration
hpc:BurstBufferConfiguration a owl:Class .
hpc:BurstBufferConfigurationFile a owl:DatatypeProperty .
hpc:BurstBufferConfigurationFile rdfs:domain hpc:BurstBufferConfiguration ;
                                      rdfs:range xsd:string .

# SlurmCTLD Node
hpc:SlurmCTLDNode a owl:Class .

# Job States
hpc:JobSubmitted a owl:Class .
hpc:JobPending a owl:Class .
hpc:JobScheduled a owl:Class .
hpc:JobRunning a owl:Class .
hpc:JobCompleted a owl:Class .
hpc:JobCancelled a owl:Class .

# Job Lifecycle Scripts
hpc:JobLifecycleScript a owl:Class .
hpc:JobLifecycleScriptRunsAtJobState a owl:ObjectProperty .
hpc:JobLifecycleScriptRunsAtJobState rdfs:domain hpc:JobLif
