hpc:Containerjob a owl:Class .
hpc:options a owl:ObjectProperty .
hpc:preexecutionscript a owl:DatatypeProperty .
hpc:outputfiles a owl:DatatypeProperty .
hpc:containerio a owl:ObjectProperty .
hpc:jobprepost a owl:ObjectProperty .
hpc:enrootjobrunoptions a owl:DatatypeProperty .
hpc:Dockerjob a owl:Class .
hpc:Nvidiadocker a owl:Class .
hpc:Shifter a owl:Class .

hpc:Containerjob rdfs:subClassOf owl:Class .
hpc:Dockerjob rdfs:subClassOf hpc:Containerjob .
hpc:Nvidiadocker rdfs:subClassOf hpc:Dockerjob .
hpc:Shifter rdfs:subClassOf hpc:Containerjob .

hpc:Options rdfs:domain hpc:Containerjob ;
    rdfs:range rdf:List .

hpc:Preexecutionscript rdfs:domain hpc:Containerjob ;
    rdfs:range xsd:string .

hpc:Outputfiles rdfs:domain hpc:Dockerjob ;
    rdfs:range rdf:List .

hpc:Containerio rdfs:domain hpc:Dockerjob ;
    rdfs:range rdf:List .

hpc:Jobprepost rdfs:domain hpc:Dockerjob ;
    rdfs:range rdf:List .

hpc:Enrootjobrunoptions rdfs:domain hpc:Enrootjob ;
    rdfs:range xsd:string .

hpc:ContainerJob fails if options contains --user .
hpc:ContainerJob fails if preExecutionScript output contains -u .
hpc:DockerJob -w and --ulimit options are automatically set by LSF; do not use in options .
hpc:DockerJob -v option is automatically used by LSF; do not use in options .
hpc:DockerJob --rm option can be used in options to automatically remove containers after job is done .
hpc:DockerJob -d option should not be used because it incorrectly gets the status of Docker jobs as DONE .
hpc:EnrootJob enroot start command options are specified by EnrootJobRunOptions .
hpc:DockerJob job_pre_post() and container_io() should be used together if set .
