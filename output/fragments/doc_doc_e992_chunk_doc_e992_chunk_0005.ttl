hpc:spankJobEnv a owl:ObjectProperty ;
    rdfs:domain hpc:SpankJobEnv ;
    rdfs:range rdf:List .

hpc:NodeInfo a owl:Class .
hpc:features a owl:DatatypeProperty .
hpc:featuresAct a owl:DatatypeProperty .
