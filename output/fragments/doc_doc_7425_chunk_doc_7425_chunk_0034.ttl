hpc:OpenAPIPlugin a owl:Class .
hpc:Version a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenAPIPlugin .

hpc:Location rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OpenAPIPlugin ;
    rdfs:range xsd:string .

hpc:DeprecatedVersion a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenAPIPlugin .

hpc:JobResponseProperties a owl:Class .
hpc:UpdateTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobResponseProperties .

hpc:ReservationInfoAPI a owl:Class .

hpc:Reservation a owl:Class .
hpc:ReservationName a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:JobResponseProperties ;
    rdfs:subClassOf hpc:RequiredProperty .

hpc:JobProperties a owl:Class .
hpc:Required a owl:ObjectProperty ;
    rdfs:domain hpc:JobProperties .

hpc:PreemptionMode a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:UNIXTimestamp a xsd:datatype xsd:string ;
    xsd:base xsd:gYearTime .

hpc:Int64 a xsd:datatype xsd:long .

hpc:ReservationProperties a owl:Class .
hpc:TresUsed a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationProperties .
hpc:TresWeighted a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationProperties .
hpc:AllocCpus a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationProperties .
hpc:IdleCpus a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationProperties .

hpc:NodeProperties a owl:Class .
hpc:AllocCpus a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeProperties .
hpc:IdleCpus a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeProperties .
