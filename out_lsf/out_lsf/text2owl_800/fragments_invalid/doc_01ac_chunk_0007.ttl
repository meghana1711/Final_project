hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Datafile a owl:Class .
hpc:Datasourcehost a owl:Class .
hpc:filepath a owl:DatatypeProperty .
hpc:filesize a owl:DatatypeProperty .
hpc:lastmodifiedtime a owl:DatatypeProperty .
hpc:Lsfmanagementhost a owl:Class .
hpc:Mbatchddaemon a owl:Class .
hpc:Mainuserjob a owl:Class .
hpc:inputstagingrequirement a owl:ObjectProperty .
hpc:Pend a owl:Class .
hpc:Transferjob a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Sourcerepository a owl:Class .
hpc:Transferedstatus a owl:Class .
hpc:transferjobstatus a owl:DatatypeProperty .
hpc:Success a owl:Class .
hpc:Failure a owl:Class .
hpc:killsjob a owl:ObjectProperty .
hpc:notifieslsf a owl:ObjectProperty .
hpc:Datamanager a owl:Class .
hpc:Datastagingstep a owl:Class .

hpc:Datafile rdfs:subClassOf owl:Class .
hpc:Datasourcehost rdfs:subClassOf owl:Class .
hpc:Lsfmanagementhost rdfs:subClassOf owl:Class .
hpc:Mbatchddaemon rdfs:subClassOf owl:Class .
hpc:Mainuserjob rdfs:subClassOf hpc:Job .
hpc:Transferjob rdfs:subClassOf hpc:Job .
hpc:Stagingarea rdfs:subClassOf owl:Class .
hpc:Sourcerepository rdfs:subClassOf owl:Class .
hpc:Transferedstatus rdfs:subClassOf owl:Class .

hpc:Filesize rdfs:domain hpc:Datafile ;
    rdfs:range xsd:decimal .
hpc:Lastmodifiedtime rdfs:domain hpc:Datafile ;
    rdfs:range xsd:dateTime .
hpc:Filepath rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .
hpc:Transferjobstatus rdfs:domain hpc:Transferjob ;
    rdfs:range xsd:string .

hpc:Inputstagingrequirement rdfs:domain hpc:Job ;
    rdfs:range hpc:Mainuserjob .
hpc:Pend rdfs:subClassOf hpc:Job ;
    rdfs:subClassOf hpc:Mainuserjob .

hpc:mbatchdDaemon rdfs:subPropertyOf hpc:LSFManagementHost .
hpc:MainUserJob rdfs:subPropertyOf hpc:Job .
hpc:TransferJob rdfs:subPropertyOf hpc:Job .
hpc:StagingArea rdfs:subPropertyOf hpc:SourceRepository .
hpc:SourceRepository rdfs:subPropertyOf hpc:TransferedStatus .

hpc:Transferjob rdfs:subClassOf hpc:Job .
hpc:transferjob a owl:ObjectProperty .
