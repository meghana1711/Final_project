hpc:Scheduler a owl:Class .
hpc:Job a owl:Class .
hpc:State rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Reason rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Backfillscheduler a owl:Class ;
    rdfs:subClassOf hpc:Scheduler .
hpc:TimeLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:MaxTimeLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:InactiveLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PurgingMechanism rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Job .
hpc:JobKilled rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:ForceTerminatedJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:SrunCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:InactiveJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:ActiveJobStep rdf:type owl:Class .
hpc:NonRespondingJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:BatchJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:BackfillSchedulingParameter rdf:type owl:Class .
hpc:MaxNumberOfJobsTestedPerUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Backfillschedulingparameter ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SlurmConfig rdf:type owl:Class .
