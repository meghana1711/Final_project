hpc:Computeunittype a owl:Class .
hpc:Admin a owl:Class .

hpc:hastype a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range hpc:Computeunittype .

hpc:isadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range hpc:Computeunittype .

hpc:hascomment a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range xsd:string .
