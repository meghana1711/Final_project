hpc:Apsqueue a owl:Class .
hpc:FairshareQueues rdfs:subClassOf hpc:Apsqueue .
hpc:FAIRSHARE_QUEUES rdfs:obsolete rdf:resource("http://example.org/hpc#LSF_7.0") .

hpc:QueueGroup a owl:Class .
