hpc:AccountSchema a owl:Class .

# OpenAPI account response schema
hpc:OpenAPIAccountResp a owl:Class .

# OpenAPI account creation request body schema (YAML)
hpc:V0_0_41_OpenAPIAccounts_Resp a owl:Class ;
    rdfs:subClassOf hpc:OpenAPIAccountResp .

# OpenAPI accounts association request body schema (YAML)
hpc:V0_0_41_OpenAPIAccountsAddCond_Resp a owl:Class ;
    rdfs:subClassOf hpc:OpenAPIAccountResp .

# POST request for accounts
hpc:PostAccountRequest a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:V0_0_41_OpenAPIAccounts_Resp .

# POST request for accounts association
hpc:PostAccountsAssociationRequest a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:V0_0_41_OpenAPIAccountsAddCond_Resp .
```
