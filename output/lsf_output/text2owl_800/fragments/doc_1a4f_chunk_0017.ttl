hpc:Linux a owl:Class ;
   rdfs:subClassOf hpc:Operatingsystem .

hpc:Windows a owl:Class ;
   rdfs:subClassOf hpc:Operatingsystem .

hpc:Definencpusresource a owl:Class ;
   rdfs:subClassOf hpc:Resourcedefinition .

hpc:definencpusprocs a owl:ObjectProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range hpc:Definencpusresource .

hpc:definencpuscores a owl:ObjectProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range hpc:Definencpusresource .

hpc:definencpusthreads a owl:ObjectProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range hpc:Definencpusresource .

hpc:Host a owl:Class ;
   rdfs:subClassOf hpc:Computingresource .

hpc:hostname a owl:DatatypeProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range xsd:string .

hpc:type a owl:DatatypeProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range xsd:string .

hpc:mem a owl:DatatypeProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range xsd:decimal .

hpc:swp a owl:DatatypeProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range xsd:decimal .

hpc:resources a owl:DatatypeProperty ;
   rdfs:domain hpc:Host ;
   rdfs:range xsd:string .

hpc:Loadindex a owl:Class ;
   rdfs:subClassOf hpc:Resource .

hpc:Builtinloadindex a owl:Class ;
   rdfs:subClassOf hpc:Loadindex .

hpc:Externalloadindex a owl:Class ;
   rdfs:subClassOf hpc:Loadindex .

hpc:updateinterval a owl:DatatypeProperty ;
   rdfs:domain hpc:Loadindex ;
   rdfs:range xsd:duration .
