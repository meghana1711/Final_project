hpc:Xeonphicoprocessor a owl:Class .
hpc:supportsLinuxX64 rdf:type owl:ObjectProperty .
hpc:Supportslinuxx64 rdfs:domain hpc:Xeonphicoprocessor ;
                      rdfs:range xsd:boolean .

hpc:haselim a owl:ObjectProperty .
hpc:Haselim rdfs:domain hpc:Xeonphicoprocessor ;
            rdfs:range hpc:Elim .

hpc:Elim a owl:Class .
hpc:ELIM detects hpc:numberOfXeonPhiCoProcessors rdf:type owl:ObjectProperty ;
       rdfs:domain hpc:Elim ;
       rdfs:range xsd:nonNegativeInteger .

hpc:Numberofxeonphicoprocessors rdfs:subClassOf hpc:Resourcecount .

hpc:Mic a owl:Class ;
      rdfs:subClassOf hpc:Elim .

hpc:mic detects hpc:mic_ncores rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:nonNegativeInteger .
hpc:mic detects hpc:mic_temp rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:float .
hpc:mic detects hpc:mic_freq rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:float .
hpc:mic detects hpc:mic_freemem rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:nonNegativeInteger .
hpc:mic detects hpc:mic_util rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:float .
hpc:mic detects hpc:mic_power rdf:type owl:ObjectProperty ;
      rdfs:domain hpc:Mic ;
      rdfs:range xsd:float .

hpc:mic_ncores rdf:type hpc:IndexedResource .
hpc:MicNcores rdfs:subClassOf hpc:MicResource .

hpc:mic_temp rdf:type hpc:Temperature .
hpc:mic_freq rdf:type hpc:Frequency .
hpc:mic_freemem rdf:type hpc:Memory .
hpc:mic_util rdf:type hpc:Utilization .
hpc:mic_power rdf:type hpc:Power .

hpc:checkpointAndRestartNotSupported rdf:type owl:ObjectProperty .
hpc:Checkpointandrestartnotsupported rdfs:domain hpc:Xeonphicoprocessor ;
                                      rdfs:range xsd:boolean .
