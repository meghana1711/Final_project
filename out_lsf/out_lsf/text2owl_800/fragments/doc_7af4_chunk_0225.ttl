hpc:HostName a owl:Class .
hpc:compatibility a owl:ObjectProperty .
hpc:DispatchWindow a owl:Class .
hpc:default a owl:DatatypeProperty .
hpc:ExitRate a owl:Class .
hpc:jobExitRateDuration a owl:DatatypeProperty .
hpc:JlU a owl:Class .
hpc:mig a owl:DatatypeProperty .

hpc:HostName rdfs:subClassOf owl:Class .
hpc:Compatibility rdfs:domain hpc:HostName ;
    rdfs:range xsd:string .
hpc:DispatchWindow rdfs:subClassOf owl:Class .
hpc:Default rdfs:domain hpc:DispatchWindow ;
    rdfs:range xsd:string .
hpc:ExitRate rdfs:subClassOf owl:Class .
hpc:JobExitRateDuration rdfs:domain hpc:ExitRate ;
    rdfs:range xsd:nonNegativeInteger .
hpc:JlU rdfs:subClassOf owl:Class .
hpc:Mig rdfs:domain hpc:HostName ;
    rdfs:range xsd:nonNegativeInteger .
