hpc:License a owl:Class .
hpc:Resource a owl:Class .
hpc:Cluster a owl:Class .
hpc:Job a owl:Class .

hpc:hasLicense rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:License .

hpc:isClusterFor rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range hpc:Cluster .

hpc:hasTotal rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasUsed rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasFree rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasReserved rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasRemote rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:boolean .

hpc:hasLastConsumed rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasLastDeficit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:hasLastUpdate rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:dateTime .

hpc:allocatesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Job .

hpc:hasAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .

hpc:hasCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Cluster .
```
