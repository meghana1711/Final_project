    rdfs:domain hpc:SlurmdDaemon ;
    rdfs:range hpc:Slurmctld .

hpc:Job a owl:Class .
hpc:Completes a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:LargeJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:MessageTraffic a owl:Class .
hpc:SpreadsOverTime a owl:ObjectProperty ;
    rdfs:domain hpc:MessageTraffic ;
    rdfs:range xsd:boolean .

hpc:EpilogMsgTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:integer .

hpc:PMI_Time a owl:DatatypeProperty ;
    rdfs:domain hpc:Task .
    rdfs:range xsd:integer .

hpc:TreeWidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:integer .

hpc:OpenFileLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:integer .

hpc:HardLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:integer .

hpc:SrunCommand a owl:Class .
hpc:ManagesKeyPairs a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand .

hpc:ProcessorSpeed a owl:Class .
hpc:Architecture a owl:Class .

hpc:EnvironmentVariable a owl:Class .
hpc:PMI_TIME a owl:DatatypeProperty ;
    rdfs:domain hpc:EnvironmentVariable .
    rdfs:range xsd:integer .

hpc:Task a owl:Class .
hpc:Executes a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range hpc:Task .
