hpc:Hostname a owl:Class .

hpc:haspreferredlevel a owl:ObjectProperty .
hpc:Haspreferredlevel rdfs:domain hpc:Hostname ;
                        rdfs:range xsd:nonNegativeInteger .

hpc:ispartofhostgroup a owl:ObjectProperty .
hpc:Ispartofhostgroup rdfs:domain hpc:Hostname ;
                        rdfs:range hpc:Hostgroup .

hpc:Externallydefinedhostgroup rdfs:subClassOf hpc:Hostgroup .
hpc:externallyDefinedHostGroup rdf:type owl:Class .
hpc:externallyDefinedHostGroup rdfs:comment "Indicated by an exclamation mark (!)." .

hpc:Excludedhostorhostgroup rdfs:subClassOf hpc:Hostname .
hpc:excludedHostOrHostGroup rdf:type owl:Class .
hpc:excludedHostOrHostGroup rdfs:comment "Indicated by a tilde (~)." .

hpc:Hostgroup a owl:Class .

hpc:hassubgroup a owl:ObjectProperty .
hpc:Hassubgroup rdfs:domain hpc:Hostgroup ;
                        rdfs:range hpc:Hostgroup .

hpc:Multilevelhostgroup rdfs:subClassOf hpc:Hostgroup .
hpc:multiLevelHostGroup rdf:type owl:Class .
hpc:multiLevelHostGroup rdfs:comment "LSF does not support multi-level host group preferences." .

hpc:Preferredhost rdfs:subClassOf hpc:Hostname .
hpc:preferredHost rdf:type owl:Class .

hpc:preferencelevel a owl:DatatypeProperty .
hpc:Preferencelevel rdfs:domain hpc:Preferredhost ;
                        rdfs:range xsd:nonNegativeInteger .

hpc:Preferredhostgroup rdfs:subClassOf hpc:Hostname .
hpc:preferredHostGroup rdf:type owl:Class .

hpc:preferenceforhostgroup a owl:DatatypeProperty .
hpc:Preferenceforhostgroup rdfs:domain hpc:Preferredhostgroup ;
                               rdfs:range xsd:nonNegativeInteger .

hpc:Hostnamepattern a owl:Class .

hpc:Singleintegerpattern rdfs:subClassOf hpc:Hostnamepattern .
hpc:singleIntegerPattern rdf:type owl:Class .
hpc:singleIntegerPattern rdfs:comment "Defined by a single non-negative integer." .

hpc:Rangeofintegerspattern rdfs:subClassOf hpc:Hostnamepattern .
hpc:rangeOfIntegersPattern rdf:type owl:Class .
hpc:rangeOfIntegersPattern rdfs:comment "Defined by a range of non-negative integers." .

hpc:Multipleintegerspattern rdfs:subClassOf hpc:Hostnamepattern .
hpc:multipleIntegersPattern rdf:type owl:Class .
hpc:multipleIntegersPattern rdfs:comment "Defined by multiple non-negative integers." .

hpc:wildcardAndSpecialCharacters rdfs
