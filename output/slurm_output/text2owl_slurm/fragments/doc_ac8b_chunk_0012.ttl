hpc:Multifactorjobpriorityplugin a owl:Class .
hpc:prioritytype a owl:ObjectProperty .
hpc:PriorityDecayHalfLife a xsd:nonNegativeInteger .
hpc:PriorityFavorSmall a xsd:boolean .
hpc:PriorityMaxAge a xsd:nonNegativeInteger .
hpc:PriorityWeightAge a xsd:nonNegativeInteger .
hpc:PriorityWeightFairshare a xsd:nonNegativeInteger .
hpc:PriorityWeightJobSize a xsd:nonNegativeInteger .
hpc:PriorityWeightPartition a xsd:nonNegativeInteger .
hpc:PriorityWeightQOS a xsd:nonNegativeInteger .

hpc:Multifactorjobpriorityplugin rdfs:subClassOf owl:NamedIndividual .
hpc:Prioritytype rdfs:domain hpc:Multifactorjobpriorityplugin ;
                  rdfs:range xsd:string .
hpc:Prioritydecayhalflife rdfs:domain hpc:Multifactorjobpriorityplugin ;
                         rdfs:range xsd:nonNegativeInteger .
hpc:Priorityfavorsmall rdfs:domain hpc:Multifactorjobpriorityplugin ;
                      rdfs:range xsd:boolean .
hpc:Prioritymaxage rdfs:domain hpc:Multifactorjobpriorityplugin ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightage rdfs:domain hpc:Multifactorjobpriorityplugin ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightfairshare rdfs:domain hpc:Multifactorjobpriorityplugin ;
                            rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightjobsize rdfs:domain hpc:Multifactorjobpriorityplugin ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightpartition rdfs:domain hpc:Multifactorjobpriorityplugin ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:Priorityweightqos rdfs:domain hpc:Multifactorjobpriorityplugin ;
                      rdfs:range xsd:nonNegativeInteger .
