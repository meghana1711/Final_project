hpc:Jobreport a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A report generated by a job submission system." .

hpc:Joboutput a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The output generated by a job." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A unit of work submitted for processing." .

# Object Properties
hpc:hasjobreport a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobreport ;
    rdfs:comment "The report associated with a job." .

hpc:hasjoboutput a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joboutput ;
    rdfs:comment "The output generated by a job." .

hpc:overwritesoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joboutput ;
    rdfs:comment "The output file to which the standard output of the job is overwritten." .

# Datatype Properties
hpc:outputfiletype a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of the output file (e.g., text, binary)." .

hpc:outputfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:string ;
    rdfs:comment "The location of the output file." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:string ;
    rdfs:comment "The ID of the job associated with the output." .

hpc:jobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutput ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of the job in an array, if the job is a member of an array." .
