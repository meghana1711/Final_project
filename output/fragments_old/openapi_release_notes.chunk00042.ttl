hpc:AdminLevel a owl:Class .
hpc:AdminLevel rdfs:subClassOf xsd:string .
hpc:AdminLevel rdfs:subClassOf rdf:List .
hpc:AdminLevel rdfs:comment "Enumeration of user admin levels." .
hpc:AdminLevel "None" rdf:first .
hpc:AdminLevel "Operator" rdf:first hpc:AdminLevel ;
                                 rdf:rest hpc:AdminLevel "Administrator" .

