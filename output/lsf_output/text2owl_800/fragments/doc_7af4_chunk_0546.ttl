hpc:Usergroup a owl:Class .
hpc:Subgroup a owl:Class .
hpc:User a owl:Class .
hpc:Limit a owl:Class .
hpc:Hassubgroup rdfs:domain hpc:Usergroup ;
                   rdfs:range hpc:Subgroup .
hpc:Hasuser rdfs:domain hpc:Usergroup ;
              rdfs:range hpc:User .
hpc:Haslimit rdfs:domain hpc:Usergroup ;
              rdfs:range hpc:Limit .
hpc:Issubgroupof rdfs:subClassOf hpc:Usergroup .
hpc:Isuserof rdfs:subClassOf hpc:User .
hpc:Peruser rdfs:subClassOf hpc:Limit .
hpc:Allusers rdfs:subClassOf hpc:Limit .
hpc:Excludedusers rdfs:subClassOf hpc:Limit .
hpc:Hasperuserlimit rdfs:domain hpc:Limit ;
               rdfs:range hpc:User .
hpc:Hasalluserslimit rdfs:domain hpc:Limit ;
               rdfs:range hpc:Usergroup .
hpc:Hasexcludeduserslimit rdfs:domain hpc:Limit ;
               rdfs:range hpc:Usergroup .
hpc:Verticalformat rdfs:subClassOf hpc:Limit .
hpc:Horizontalformat rdfs:subClassOf hpc:Limit .
hpc:Validloginname rdfs:domain hpc:User ;
                rdfs:range xsd:string .
hpc:Configuredinlsb rdfs:domain hpc:Unixusergroup ;
               rdfs:range xsd:string .
hpc:Hasrecursivelimit rdfs:domain hpc:Subgroup ;
               rdfs:range hpc:Limit .
hpc:Notspecified rdfs:subClassOf hpc:Usergroup .
