hpc:Lsf a owl:Class .
hpc:runs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Task .

hpc:Task a owl:Class .
hpc:hostName a owl:ObjectProperty ;
    rdfs:range xsd:string .
hpc:clusterName a owl:ObjectProperty ;
    rdfs:range xsd:string .
hpc:resReq a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:command a owl:ObjectProperty ;
    rdfs:range xsd:string .
hpc:argument a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:version a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:multicluster a owl:ObjectProperty ;
    rdfs:range xsd:boolean .
hpc:jobforwardingmodel a owl:ObjectProperty ;
    rdfs:range xsd:string .
hpc:localcluster a owl:ObjectProperty ;
    rdfs:range xsd:boolean .
hpc:remotetasklist a owl:ObjectProperty ;
    rdfs:range hpc:Tasklist .
hpc:samearchitecture a owl:ObjectProperty ;
    rdfs:range xsd:boolean .
hpc:lowestload a owl:ObjectProperty ;
    rdfs:range hpc:Host .
hpc:executionfail a owl:ObjectProperty ;
    rdfs:range xsd:boolean .
hpc:localhost a owl:ObjectProperty ;
    rdfs:range hpc:Host .
hpc:Host a owl:Class .
