hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:JobSchedulingInterval a xsd:nonNegativeInteger ;
    rdfs:comment "Parameter in the configuration file lsb.params" .

hpc:jobpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Schedulingpolicy a owl:Class .

hpc:Availableresource a owl:Class .

hpc:jobscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Schedulingdecision .

hpc:Schedulingdecision a owl:Class .

hpc:hostselection a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingdecision ;
    rdfs:range hpc:Host .

hpc:Resourceinformation a owl:Class .

hpc:resourceinformationcollection a owl:ObjectProperty ;
    rdfs:domain hpc:Parentlim ;
    rdfs:range hpc:Resourceinformation .

hpc:Lim a owl:Class .

hpc:Serverbatchdaemon a owl:Class .

hpc:Childsbatchdaemon a owl:Class ;
    rdfs:subClassOf hpc:Serverbatchdaemon .

hpc:Executionenvironment a owl:Class .

hpc:jobdispatch a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Job .

hpc:Mbatchd a owl:Class .

hpc:Mbschd a owl:Class .

hpc:Parentlim a owl:Class .

hpc:limcommunication a owl:ObjectProperty ;
    rdfs:domain hpc:Parentlim ;
    rdfs:range hpc:Mbatchd .

hpc:Serverbatchdaemonfunction a owl:Class .

hpc:requestreceipt a owl:ObjectProperty ;
    rdfs:domain hpc:Serverbatchdaemonfunction ;
    rdfs:range hpc:Job .

hpc:executionenvironmentcreation a owl:ObjectProperty ;
    rdfs:domain hpc:Serverbatchdaemonfunction .
