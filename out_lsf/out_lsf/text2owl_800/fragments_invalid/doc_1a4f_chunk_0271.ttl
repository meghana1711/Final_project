hpc:defaultrunlimit a owl:DatatypeProperty .
hpc:maximumrunlimit a owl:DatatypeProperty .
hpc:jobspecificrunlimit a owl:ObjectProperty .
hpc:Queue a owl:Class .
hpc:Resourceusagelimit a owl:Class .

hpc:Queue rdfs:subClassOf owl:Class .
hpc:Resourceusagelimit rdfs:subClassOf owl:Class .

hpc:Defaultrunlimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:JobSpecificRunLimit .

hpc:Maximumrunlimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:JobSpecificRunLimit .

hpc:Jobspecificrunlimit rdfs:domain hpc:Queue ;
    rdfs:range (hpc:Defaultrunlimit, hpc:Maximumrunlimit) ;
    rdfs:subPropertyOf rdf:Property .

hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:datalimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:processlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:threadlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:hostspecificlimit a owl:ObjectProperty .

hpc:Hostspecificlimit rdfs:domain hpc:Queue ;
    rdfs:range (xsd:integer, xsd:string) ;
    rdfs:subPropertyOf rdf:Property .

hpc:backfillschedulingrunlimit a owl:DatatypeProperty .

hpc:Backfillschedulingrunlimit rdfs:domain hpc:Queue ;
    rdfs:range (hpc:Defaultrunlimit, hpc:Maximumrunlimit) .
