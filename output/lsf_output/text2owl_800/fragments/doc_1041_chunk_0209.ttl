hpc:Exclusivejob a owl:Class .
hpc:Nonexclusivejob a owl:Class .
hpc:Job a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                      rdfs:subClassOf hpc:Job ] .

# Slot allocation
hpc:hasslotallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Slotallocation .

hpc:Exclusivejob rdfs:subClassOf hpc:Job .
hpc:Nonexclusivejob rdfs:subClassOf hpc:Job .

# Attributes
hpc:hasattribute a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Attribute .

# GPU information
hpc:hasgpu a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Gpu .
hpc:hasdetailedgpuinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:boolean .

# JSON output
hpc:hascustomizedoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:boolean .

# Long host information
hpc:haslonghostinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

# CPU factor, current load, load thresholds, and slots
hpc:hascpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:hascurrentload a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:hasloadthresholds a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:hasslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
