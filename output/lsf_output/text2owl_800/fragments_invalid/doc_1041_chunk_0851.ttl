hpc:Lsfcommand a owl:Class .
hpc:RcpCommand a subClassOf hpc:LsfCommand .
hpc:LsrcpCommand a subClassOf hpc:LsfCommand .
hpc:ShellCommand a subClassOf hpc:LsfCommand .

hpc:usesrsh a owl:ObjectProperty .
hpc:preservesfilepermissionmodes a owl:ObjectProperty .
hpc:usessourcefilemodes a owl:ObjectProperty .
hpc:copiesfile a owl:ObjectProperty .

hpc:Lsfcommand rdfs:subClassOf owl:Class .
hpc:Rcpcommand rdfs:subClassOf hpc:Lsfcommand .
hpc:Lsrcpcommand rdfs:subClassOf hpc:Lsfcommand .
hpc:Shellcommand rdfs:subClassOf hpc:Lsfcommand .

hpc:Usesrsh rdfs:domain hpc:Lsfcommand ;
    rdfs:range hpc:Rshcommand .
hpc:Preservesfilepermissionmodes rdfs:domain hpc:Lsrcpcommand ;
    rdfs:range xsd:Boolean .
hpc:Usessourcefilemodes rdfs:domain hpc:Lsrcpcommand ;
    rdfs:range xsd:Boolean .
hpc:Copiesfile rdfs:domain hpc:Lsrcpcommand ;
    rdfs:range hpc:File .

hpc:RshCommand rdf:type xsd:string .
hpc:Lsfbindir a owl:Class .
hpc:Lsfconf a owl:Class .
hpc:Lsfserver a owl:Class .
hpc:File a owl:Class .
hpc:Hostregsetup a owl:Class .
hpc:synopsis a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:options a owl:DatatypeProperty .
hpc:sendsregistermessage a owl:ObjectProperty .
