hpc:Slurminstallation a owl:Class .
hpc:Elasticsearchinstance a owl:Class .
hpc:Jobcompletionplugin a owl:Class .
hpc:jobcomptype a owl:ObjectProperty .
hpc:jobcomploc a owl:DatatypeProperty .

hpc:Slurminstallation rdfs:subClassOf owl:Class .
hpc:Elasticsearchinstance rdfs:subClassOf hpc:Slurminstallation .
hpc:Jobcompletionplugin rdfs:subClassOf owl:Class .

hpc:Jobcomptype rdfs:domain hpc:Slurminstallation ;
    rdfs:range hpc:Jobcomptypevalue .

hpc:Jobcomptypevalue a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Jobcomploc rdfs:domain hpc:Slurminstallation ;
    rdfs:range xsd:anyURI .
