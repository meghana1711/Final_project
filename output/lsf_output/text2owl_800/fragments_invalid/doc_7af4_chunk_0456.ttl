hpc:jobcontrolaction a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasAction .

hpc:Jobcontrol a owl:Class .

hpc:suspend a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:JobControlAction .

hpc:resume a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:JobControlAction .

hpc:terminate a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:JobControlAction .
    rdfs:range rdf:List .
    rdf:first hpc:Terminate/Signal1 a xsd:string ;
    rdfs:range rdf:List .
    rdf:first hpc:Terminate/Signal2 a xsd:string ;
    rdfs:range rdf:List .
    rdf:first hpc:Terminate/Signal3 a xsd:string .

hpc:jobidle a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
    rdfs:subPropertyOf rdf:type .

hpc:joboverrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
    rdfs:subPropertyOf rdf:type .

hpc:Job a owl:Class .

hpc:jobidlethreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
    rdfs:subPropertyOf rdf:type .

hpc:joboverrunthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
    rdfs:subPropertyOf rdf:type .
