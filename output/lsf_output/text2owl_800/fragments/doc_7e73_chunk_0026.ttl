hpc:Securitygroup a owl:Class .
hpc:hasDefaultPort rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:defaultSecurityGroup rdf:type owl:Class ;
    rdfs:subClassOf hpc:Securitygroup .
hpc:hasCustomizedRule rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Securitygroup .
hpc:hasLSFLimPort rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:hasLSFResPort rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:hasLSBSbdPort rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:hasManagementHostIP rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:string .
hpc:hasAdditionalFirewallPort rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:hasLSFNIOSPortRange rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Securitygroup ;
    rdfs:range xsd:integer .
hpc:Vpc a owl:Class .
hpc:Subnet a owl:Class ;
    rdfs:subClassOf hpc:Vpc .
hpc:publicSubnet rdf:type owl:Class ;
    rdfs:subClassOf hpc:Subnet .
hpc:privateSubnet rdf:type owl:Class ;
    rdfs:subClassOf hpc:Subnet .
