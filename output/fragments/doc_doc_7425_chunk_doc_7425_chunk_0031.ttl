hpc:User a owl:Class .
hpc:hasDeletedFlag a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:boolean .

hpc:QOS a owl:Class .
hpc:QOSGet a owl:ObjectProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range hpc:QOSGet .
hpc:QOSGet with_deleted a owl:DatatypeProperty ;
    rdfs:domain (hpc:QOSGet | hpc:QOSGet hpc:QOS/{qos_name}) ;
    rdfs:range xsd:boolean .

hpc:Account a owl:Class .
hpc:AccountGet a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:AccountGet .
hpc:AccountGet with_deleted a owl:DatatypeProperty ;
    rdfs:domain (hpc:AccountGet | hpc:AccountGet hpc:Account/{account_name}) ;
    rdfs:domain hpc:AccountsGet ;
    rdfs:range xsd:boolean .

hpc:Job a owl:Class .
hpc:JobDescription a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobDescription .
hpc:JobDescription container a owl:DatatypeProperty .

hpc:Association a owl:Class .
hpc:AssociationGet a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range hpc:AssociationGet .
hpc:AssociationGet parameters rdf:List ;
    rdfs:domain hpc:AssociationGet ;
    rdfs:range rdf:List .
hpc:AssociationDelete a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range hpc:AssociationDelete .
hpc:AssociationDelete parameters rdf:List ;
    rdfs:domain hpc:AssociationDelete ;
    rdfs:range rdf:List .

hpc:AssociationGet parameters required rdf:List ;
    rdfs:domain hpc:AssociationGet ;
    rdfs:range rdf:List ;
    owl:hasValue xsd:false .

hpc:AssociationsGet parameters with_deleted rdf:List ;
    rdfs:domain hpc:AssociationsGet ;
    rdfs:range rdf:List ;
    rdfs:first hpc:with_deleted ;
    rdfs:rest rdf:nil .

hpc:JobId a xsd:string .

hpc:License a owl:Class .
hpc:License a rdfs:subClassOf hpc:JobId .
```
