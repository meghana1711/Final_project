hpc:Job requires 6 hpc:CPUs ; rdf:type owl:CardinalityRestriction ;
    owl:onProperty hpc:requiresCPU ;
    owl:cardinality 6 .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Task .

hpc:Task a owl:Class .

hpc:requiresCPU a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:SingleNodeJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:DefaultPartitionJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:slurmConf a owl:Class .

hpc:SelectType a owl:ObjectProperty ;
    rdfs:domain hpc:slurmConf .

hpc:SelectTypeParameters a owl:ObjectProperty ;
    rdfs:domain hpc:slurmConf .

hpc:TaskPlugin a owl:ObjectProperty ;
    rdfs:domain hpc:slurmConf .

hpc:cgroupConf a owl:Class .

hpc:ConstrainCores a owl:ObjectProperty ;
    rdfs:domain hpc:cgroupConf .

hpc:CommandLine a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:srunCommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:srunCommand .

hpc:ntasks a owl:DatatypeProperty ;
    rdfs:domain hpc:srunCommand .

hpc:TaskAffinity a owl:Class .

hpc:TaskAffinityPlugin a owl:ObjectProperty ;
    rdfs:domain hpc:TaskPlugin ;
    rdfs:range xsd:string .
```
