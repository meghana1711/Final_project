hpc:Fod a owl:Class .
hpc:hasfodfiles a owl:ObjectProperty .

hpc:Foddirectory a owl:Class .
                                               rdfs:subClassOf hpc:Directory ] .
hpc:Foddirectory hasSubDirectories rdfs:range xsd:string .
hpc:Foddirectory hasUserCommandFiles rdfs:range xsd:string .
hpc:Foddirectory hasFODShell rdfs:range xsd:string .
hpc:Foddirectory hasFODConf rdfs:range xsd:string .
hpc:Foddirectory hasFOD rdfs:range xsd:string .
hpc:Foddirectory hasManPages rdfs:range xsd:string .

hpc:Fodfile a owl:Class .
                                            rdfs:subClassOf xsd:string ] .

hpc:installfod a owl:ObjectProperty .
hpc:Installfod rdfs:domain hpc:Systemadmin .
hpc:Installfod rdfs:range hpc:Fod .

hpc:Fod rdfs:subClassOf [ a owl:Class ;
                          rdfs:subClassOf hpc:Process ] .
hpc:Fod hasFODFiles rdfs:domain hpc:Fod .
hpc:Fod hasFODDirectory rdfs:range hpc:Foddirectory .
