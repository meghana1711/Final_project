hpc:Project a owl:Class .
hpc:Feature a owl:Class .
hpc:Projectgroup a owl:Class .
hpc:projectpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .
hpc:blinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range rdf:Statement .
hpc:blstat a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range rdf:Statement .
hpc:projectgroupsection a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:Statement .
hpc:projectgroupsectionGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroupsection ;
    rdfs:range xsd:string .
hpc:projectgroupsectionShares a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroupsection ;
    rdfs:range xsd:integer .
hpc:projectgroupsectionOwnershipLimits a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroupsection ;
    rdfs:range xsd:integer .
hpc:projectgroupsectionNonShared a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroupsection ;
    rdfs:range xsd:integer .
hpc:lsfLicensescheduler a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range rdf:Resource .
