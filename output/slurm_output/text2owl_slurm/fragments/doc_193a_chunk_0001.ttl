hpc:Configlessslurm a owl:Class .
hpc:Slurmcontroller a owl:Class ;
    rdfs:subClassOf hpc:Computerhost .

hpc:Slurmd a owl:Class ;
    rdfs:subClassOf hpc:Computenode .

hpc:Slurmloginnode a owl:Class ;
    rdfs:subClassOf hpc:Loginnode .

hpc:Slurmctld a owl:Class ;
    rdfs:subClassOf hpc:Computerhost .

hpc:pullconfigfromslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range hpc:Slurmctld .

hpc:getconfiginfofromdns a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmloginnode ;
    rdfs:range xsd:URI .

hpc:configlessmode a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range xsd:boolean .

hpc:slurmconf a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range xsd:string .

hpc:sackd a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmloginnode ;
    rdfs:range hpc:Slurmloginnode .
