hpc:Growablejob a owl:Class .
hpc:Shrinkablejob a owl:Class .
hpc:Resizableevent a owl:Class .
hpc:GrowEvent a hpc:ResizableEvent ;
    rdfs:label "grow" ;
    rdfs:comment "Indicates a job is growing." .
hpc:ShrinkEvent a hpc:ResizableEvent ;
    rdfs:label "shrink" ;
    rdfs:comment "Indicates a job is shrinking." .
hpc:hasresizableevent a owl:ObjectProperty ;
    rdfs:domain hpc:Growablejob ;
    rdfs:range hpc:Resizableevent .
hpc:canuseadditionalresources a owl:ObjectProperty ;
    rdfs:domain hpc:Growablejob ;
    rdfs:range xsd:boolean .
hpc:canreleaseresources a owl:ObjectProperty ;
    rdfs:domain hpc:Shrinkablejob ;
    rdfs:range xsd:boolean .
hpc:violatesresourcelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Resizableevent ;
    rdfs:range xsd:boolean .
hpc:jobacceptinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Growablejob ;
    rdfs:range xsd:integer .
