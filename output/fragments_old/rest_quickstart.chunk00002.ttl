hpc:Environment a owl:Class .
hpc:Environment rdfs:subClassOf owl:Class .

# API Version
hpc:ApiVersion a owl:DatatypeProperty .
hpc:ApiVersion rdfs:domain hpc:Environment .
hpc:ApiVersion rdfs:range xsd:string .

# Authentication Token
hpc:AuthenticationToken a owl:Class .
hpc:AuthenticationToken rdfs:subClassOf owl:Class .

hpc:JWTToken a owl:DatatypeProperty .
hpc:JWTToken rdfs:domain hpc:AuthenticationToken .
hpc:JWTToken rdfs:range xsd:string .

# Server and Port
hpc:Server a owl:Class .
hpc:Server rdfs:subClassOf owl:Class .

hpc:Port a owl:DatatypeProperty .
hpc:Port rdfs:domain hpc:Server .
hpc:Port rdfs:range xsd:integer .

# API Endpoint
hpc:APIEndpoint a owl:Class .
hpc:APIEndpoint rdfs:subClassOf owl:Class .

hpc:APIEndpointURI a owl:DatatypeProperty .
hpc:APIEndpointURI rdfs:domain hpc:APIEndpoint .
hpc:APIEndpointURI rdfs:range xsd:string .

# API Method
hpc:APIMethod a owl:EnumClass .
hpc:APIMethod rdfs:subClassOf owl:Class .

hpc:get a hpc:APIMethod .
hpc:post a hpc:APIMethod .
hpc:put a hpc:APIMethod .
hpc:delete a hpc:APIMethod .

# Token Management
hpc:TokenManagement a owl:Class .
hpc:TokenManagement rdfs:subClassOf owl:Class .

hpc:TokenObtainingMethod a owl:ObjectProperty .
hpc:TokenObtainingMethod rdfs:domain hpc:TokenManagement .
hpc:TokenObtainingMethod rdfs:range hpc:APIEndpoint .

hpc:TokenExpiration a owl:DatatypeProperty .
hpc:TokenExpiration rdfs:domain hpc:TokenManagement .
hpc:TokenExpiration rdfs:range xsd:integer .

# Common Issues
hpc:CommonIssue a owl:Class .
hpc:CommonIssue rdfs:subClassOf owl:Class .

hpc:InvalidToken a hpc:CommonIssue .
hpc:InvalidHostname a hpc:CommonIssue .
hpc:InvalidPortNumber a hpc:CommonIssue .
hpc:InvalidAPIVersion a hpc:CommonIssue .
hpc:InvalidEndpoint a hpc:CommonIssue .
hpc:LogOutputIssue a hpc:CommonIssue .
hpc:UnableToBindSocket a hpc:CommonIssue .
hpc:AddressAlreadyInUse a hpc:CommonIssue .
hpc:ConnectionRefused a hpc:CommonIssue .
hpc:ProtocolAuthenticationError a hpc:CommonIssue .
hpc:UnableToFindRequestedURL a hpc:CommonIssue .
hpc:RejectingThreadConfigToken a hpc:CommonIssue .
hpc:
