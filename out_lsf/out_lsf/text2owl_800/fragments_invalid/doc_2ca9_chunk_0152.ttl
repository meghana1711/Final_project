hpc:Jsonoutputformat a owl:Class ;
    rdfs:subClassOf hpc:Outputformat .

hpc:jsoncommandoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Jsonoutputformat .

hpc:hmstimeformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .
    rdfs:range xsd:string .

hpc:hmstimeformatcommandoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Hmstimeformat .

# Security
hpc:Eauthexecutablefile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:sitespecificinternalkey a owl:ObjectProperty ;
    rdfs:domain hpc:Eauthexecutablefile ;
    rdfs:range xsd:boolean .

hpc:aes128bitencryption a owl:ObjectProperty ;
    rdfs:domain hpc:Eauthexecutablefile ;
    rdfs:range xsd:string .

# LSF 10.1 Fix Pack 1
hpc:lsbhmstimeformatparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationfile ;
    rdfs:range xsd:string .

hpc:lsbhmstimeformatenvironmentvariable a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .

hpc:Simplifiedaffinityrequirementsyntax a owl:Class .

hpc:esubp8affscript a owl:ObjectProperty ;
    rdfs:domain hpc:Simplifiedaffinityrequirementsyntax ;
    rdfs:range hpc:Script .

hpc:openmpthreadaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Distributedapplicationframework ;
    rdfs:range hpc:Openmp .

hpc:mpidistributionintegration a owl:ObjectProperty ;
    rdfs:domain hpc:Openmp ;
    rdfs:range hpc:Mpidistribution .
