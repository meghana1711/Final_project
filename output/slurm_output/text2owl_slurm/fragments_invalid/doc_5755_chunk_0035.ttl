                                 rdfs:range xsd:boolean .

hpc:slurmtranslatespbsoptions a owl:ObjectProperty .
hpc:Slurmtranslatespbsoptions rdfs:domain hpc:Slurmcommandwrapper ;
                                 rdfs:range xsd:boolean .

hpc:slurmsupportsoptions a owl:ObjectProperty .
hpc:Slurmsupportsoptions rdfs:domain hpc:Slurmcommandwrapper ;
                                 rdfs:range xsd:boolean .

hpc:Slurmspankplugin a owl:Class .
hpc:Slurmspankplugin rdfs:subClassOf owl:NamedIndividual .

hpc:slurmspankplugininstallationdirectory a owl:DatatypeProperty .
hpc:Slurmspankplugininstallationdirectory rdfs:domain hpc:
