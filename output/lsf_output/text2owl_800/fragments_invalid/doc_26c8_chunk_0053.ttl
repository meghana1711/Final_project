@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Userscript a owl:Class .
hpc:Packagelist a owl:Class .
hpc:Logfile a owl:Class .
hpc:CyclecloudprovConfig a owl:Class .
hpc:CyclecloudprovTemplates a owl:Class .

hpc:runsUserScript rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Userscript ;
    rdfs:range hpc:Packagelist .

hpc:manages rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range hpc:Remoteadministrativefunction .

hpc:LogLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:Azure_CC_SERVER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:AZURE_CC_CLUSTER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:AZURE_CC_USER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:AZURE_CC_PASSWORD rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:AZURE_CC_REGION rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:CyclecloudprovConfig ;
    rdfs:range xsd:string .

hpc:LogLevelRange a rdfs:Class ;
    rdfs:subClassOf xsd:string .

hpc:LogLevelRange#INFO rdf:type hpc:LogLevelRange ;
    rdfs:subClassOf xsd:string .

hpc:LogLevelRange#DEBUG rdf:type hpc:LogLevelRange ;
    rdfs:subClassOf xsd:string .

hpc:LogLevelRange#WARN rdf:type hpc:LogLevelRange ;
    rdfs:subClassOf xsd:string .

hpc:LogLevelRange#ERROR rdf:type hpc:LogLevelRange ;
    rdfs:subClassOf xsd:string .

hpc:LogLevelRange#FATAL rdf:type hpc:Log
