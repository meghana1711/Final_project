# API Call
hpc:APICall a owl:Class .

# Query Parameter
hpc:QueryParameter a owl:Class .
hpc:hasFormat a owl:ObjectProperty .
hpc:isIgnored a owl:DatatypeProperty .
hpc:hasName a owl:ObjectProperty .
hpc:hasPreemptMode a owl:ObjectProperty .
hpc:hasCSVQOSIdList a owl:DatatypeProperty .
hpc:hasCSVQOSNameList a owl:DatatypeProperty .

# Response
hpc:Response a owl:Class .
hpc:hasReturnType a owl:ObjectProperty .

# v0.0.43_openapi_resp
hpc:v0.0.43_openapi_resp a owl:Class .

# slurmdb/v0.0.43/tres/Add TRES
hpc:AddTRES a owl:Class ;
    rdfs:subClassOf hpc:APICall .
hpc:AddTRESRequestBody a owl:Class ;
    rdfs:subClassOf hpc:v0.0.43_openapi_tres_resp .

# slurmdb/v0.0.43/users/Update users
hpc:UpdateUsers a owl:Class ;
    rdfs:subClassOf hpc:APICall .
hpc:UpdateUsersRequestBody a owl:Class ;
    rdfs:subClassOf hpc:v0.0.43_openapi_users_resp .

# slurmdb/v0.0.43/users_association/Add users with conditional association
hpc:AddUsersAssociation a owl:Class ;
    rdfs:subClassOf hpc:APICall .
hpc:AddUsersAssociationRequestBody a owl:Class ;
    rdfs:subClassOf hpc:v0.0.43_openapi_users_add_cond_resp .

# Common Properties
hpc:hasMediaType a owl:ObjectProperty .
hpc:hasExampleData a owl:ObjectProperty .
hpc:produces a owl:ObjectProperty .
hpc:consumes a owl:ObjectProperty .
hpc:hasResponse a owl:ObjectProperty .
```
