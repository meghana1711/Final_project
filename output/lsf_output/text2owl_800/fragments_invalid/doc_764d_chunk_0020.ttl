hpc:Cluster a owl:Class .

# RemoteClusters object property
hpc:hasremoteclusters a owl:ObjectProperty .
rdfs:domain hpc:Cluster .
rdfs:range rdf:List .

# ClusterName datatype property
hpc:clustername a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:string .

# CACHE_INTERVAL datatype property
hpc:cacheinterval a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:nonNegativeInteger .

# RECV_FROM datatype property
hpc:recvfrom a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:boolean .

# AUTH datatype property
hpc:auth a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:string .

# Cluster1 instance
hpc:Cluster1 a hpc:Cluster ;
    hpc:hasRemoteClusters (hpc:Cluster2 hpc:clusterName "cluster2" ;
                                     hpc:cacheInterval "60" ;
                                     hpc:recvFrom "Y" ;
                                     hpc:auth "KRB" ) ;
    hpc:lsfServerDir "http://example.org/hpc#eauth.KRB" .

# Cluster2 instance
hpc:Cluster2 a hpc:Cluster ;
    hpc:hasRemoteClusters (hpc:Cluster1 hpc:clusterName "cluster1" ;
                                     hpc:cacheInterval "60" ;
                                     hpc:recvFrom "Y" ;
                                     hpc:auth "KRB" ) ;
    hpc:lsfServerDir "http://example.org/hpc#eauth.KRB" .

# MC_RUSAGE_UPDATE_INTERVAL datatype property
hpc:mcrusageupdateinterval a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:nonNegativeInteger .

# LSF_SERVERDIR datatype property
hpc:lsfserverdir a owl:DatatypeProperty .
rdfs:domain hpc:Cluster .
rdfs:range xsd:string .
