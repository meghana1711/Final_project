hpc:Adjustmentnumber a owl:Class .
hpc:abs a owl:DatatypeProperty ;
    rdfs:domain hpc:Adjustmentnumber ;
    rdfs:range xsd:integer .
hpc:mult a owl:DatatypeProperty ;
    rdfs:domain hpc:Adjustmentnumber ;
    rdfs:range xsd:decimal .
hpc:step a owl:ObjectProperty ;
    rdfs:domain hpc:Adjustmentnumber ;
    rdfs:range hpc:Adjustmentamount .
hpc:dynstep a owl:ObjectProperty ;
    rdfs:domain hpc:Adjustmentnumber ;
    rdfs:range hpc:Dynamicadjustment .
hpc:histTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicadjustment ;
    rdfs:range xsd:integer .
hpc:factor a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicadjustment ;
    rdfs:range xsd:decimal .
hpc:target a owl:DatatypeProperty ;
    rdfs:domain hpc:Dynamicadjustment ;
    rdfs:range xsd:decimal .
hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Adjustmentnumber ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Servicedomain a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain .
hpc:licServers a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range rdf:List .
hpc:Service a owl:Class .
hpc:Feature a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range rdf:List .
hpc:p1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:nonNegativeInteger .
hpc:p2 a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:nonNegativeInteger .
hpc:p3 a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:nonNegativeInteger .
