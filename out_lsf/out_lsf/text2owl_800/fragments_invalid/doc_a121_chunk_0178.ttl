hpc:LsbSubPre a owl:Class .
hpc:Executioncommand rdfs:domain hpc:LsbSubPre ;
 rdfs:range xsd:string .

hpc:LsbSubProj a owl:Class .

hpc:LsbSubPty a owl:Class .
hpc:Isinteractivejob rdfs:domain hpc:LsbSubPty ;
 rdfs:range xsd:boolean .

hpc:LsbSubPtyShell a owl:Class .
hpc:Hasptyshell rdfs:domain hpc:LsbSubPty ;
 rdfs:range xsd:boolean .

hpc:LsbSubQueue a owl:Class .

hpc:LsbSubRerunnable a owl:Class .
hpc:Isrerunnable rdfs:domain hpc:LsbSubRerunnable ;
 rdfs:range xsd:boolean .
hpc:Isnonrerunnable rdfs:domain hpc:LsbSubRerunnable ;
 rdfs:range xsd:string .

hpc:LsbSubResReq a owl:Class .

hpc:Option rdfs:domain hpc:LsbSubResReq ;
 rdfs:range xsd:string .

hpc:LsbSubRestart rdfs:subClassOf hpc:LsbSubResReq ;
 rdfs:comment "Indicates to esub that the job options are associated with a restarted job." .

hpc:LsbSubRestartForce rdfs:subClassOf hpc:LsbSubResReq ;
 rdfs:comment "Indicates to esub that the job options are associated with a forced restarted job." .

hpc:LsbSubRlimit rdfs:subClassOf hpc:LsbSubResReq .

hpc:LsbSubRlimitCore a owl:Class .
 rdfs:comment "Core file size limit" .

hpc:LsbSubRlimitCpu a owl:Class .
 rdfs:comment "CPU limit" .

hpc:LsbSubRlimitData a owl:Class .
 rdfs:comment "Data size limit" .

hpc:LsbSubRlimitFsize a owl:Class .
 rdfs:comment "File size limit" .

hpc:LsbSubRlimitProcess a owl:Class .
 rdfs:comment "Process limit" .

hpc:LsbSubRlimitRss a owl:Class .
 rdfs:comment "Resident size limit" .

hpc:LsbSubRlimitRun a owl:Class .
 rdfs:comment "Wall-clock run limit in seconds." .

