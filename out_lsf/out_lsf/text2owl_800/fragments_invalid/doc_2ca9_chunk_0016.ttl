hpc:Googlecomputecloudconfig a owl:Class .
hpc:hasassignserviceaccountfromlaunchtemplate a owl:ObjectProperty .
hpc:hasdefaultvalue a owl:DatatypeProperty .
hpc:Googlecomputecloudconfig rdfs:subClassOf owl:Class .
hpc:Hasassignserviceaccountfromlaunchtemplate rdfs:domain hpc:Googlecomputecloudconfig ;
                                                    rdfs:range xsd:boolean .
hpc:Googlecomputecloudconfig rdfs:subClassOf (hpc:Config .
                                                   rdfs:subClassOf owl:Class) .
hpc:Googlecomputecloudconfig rdfs:subClassOf (hpc:Resourceconnectorconfig .
                                                   rdfs:subClassOf owl:Class) .

