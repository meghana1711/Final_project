hpc:sharedir a owl:ObjectProperty.
hpc:Sharedir a rdf:Class.
hpc:Sharedir rdfs:domain hpc:Host .
hpc:Sharedir rdfs:range xsd:string .

hpc:entitlementfile a owl:DatatypeProperty.
hpc:Entitlementfile a rdf:Class.
hpc:Entitlementfile rdfs:domain hpc:Lsf .
hpc:Entitlementfile rdfs:range xsd:string .

hpc:ENTITLEMENTFILE_Standard_Edition rdf:value "lsf_std_entitlement.dat" .
hpc:ENTITLEMENTFILE_Advanced_Edition rdf:value "adv_entitlement.dat" .

hpc:hosttype a owl:ObjectProperty.
hpc:Hosttype a rdf:Class.
hpc:Hosttype rdfs:domain hpc:Installationoptions .
hpc:Hosttype rdfs:range xsd:string .
hpc:HOSTTYPE 'a' Master rdf:value "Master" .
hpc:HOSTTYPE 'a' Candidate rdf:value "Candidate" .
hpc:HOSTTYPE 'a' Server rdf:value "Server" .
