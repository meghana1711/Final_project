@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Queue a owl:Class .
hpc:Host a owl:Class .
hpc:Timewindow a owl:Class .
hpc:Powerpolicy a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range rdf:List .
hpc:timewindow a owl:ObjectProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:string .
hpc:minidletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cycletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Limit a owl:Class .
hpc:perqueuehostsslots a owl:ObjectProperty .
hpc:Queue rdfs:subClassOf hpc:Resource .
hpc:Host rdfs:subClassOf hpc:Resource .

hpc:Queue rdfs:subClassOf hpc:Limit ;
    rdfs:subClassOf hpc:Namedthing .
hpc:Host rdfs:subClassOf hpc:Namedthing .

hpc:Perqueuehostsslots rdfs:domain hpc:Limit ;
    rdfs:range rdf:List .
hpc:Resource rdfs:subClassOf hpc:Namedthing .

hpc:normal a hpc:Queue ;
    hpc:PerQueueHostsSlots ( ( hpc:Resource1 rdf:first 10 ) ( hpc:short rdf:first - ) ( hpc:short rdf:rest ( hpc:Resource1 rdf:first 100 ) ) ( hpc:Resource1 rdf:rest ( hpc:Resource1 rdf:first 30 ) ) ) .
hpc:short a hpc:Queue .
hpc:Resource1 a hpc:Host .
