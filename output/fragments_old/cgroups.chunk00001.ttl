hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a hpc:SlurmWorkloadManager .

hpc:ControlGroup a owl:Class .
hpc:cgroup a hpc:ControlGroup .

hpc:CgroupController a owl:Class .
hpc:memory a hpc:CgroupController .
hpc:cpu a hpc:CgroupController .
hpc:devices a hpc:CgroupController .
hpc:freezer a hpc:CgroupController .
hpc:cpuset a hpc:CgroupController .
hpc:cpuacct a hpc:CgroupController .

hpc:CgroupMode a owl:Class .
hpc:LegacyMode a hpc:CgroupMode .
hpc:UnifiedMode a hpc:CgroupMode .

hpc:CgroupPlugin a owl:Class .
hpc:proctrack_cgroup a hpc:CgroupPlugin .
hpc:task_cgroup a hpc:CgroupPlugin .
hpc:jobacct_gather_cgroup a hpc:CgroupPlugin .

hpc:ProctrackType a owl:ObjectProperty .
hpc:ProctrackType rdfs:domain hpc:SlurmWorkloadManager ;
                   rdfs:range hpc:CgroupPlugin .

hpc:TaskPlugin a owl:ObjectProperty .
hpc:TaskPlugin rdfs:domain hpc:SlurmWorkloadManager ;
                 rdfs:range xsd:string .

hpc:JobacctGatherType a owl:ObjectProperty .
hpc:JobacctGatherType rdfs:domain hpc:SlurmWorkloadManager ;
                       rdfs:range hpc:CgroupPlugin .

hpc:cgroup_v1_deprecated a owl:Class .
hpc:cgroup_v2 a owl:Class .
hpc:HybridMode a owl:Class .
```
