hpc:LsfSudoers a owl:Class .
hpc:LsfConf a owl:Class .
hpc:Operation a owl:Class .

# Object Properties
hpc:hasoperation a owl:ObjectProperty .
hpc:hasvalue a owl:ObjectProperty .

# Datatype Properties
hpc:hasname a owl:DatatypeProperty .
hpc:hasformat a owl:DatatypeProperty .

# Subclass relations
hpc:LsfSudoers rdfs:subClassOf hpc:Operation .

# Domain and Range
hpc:Hasoperation rdfs:domain hpc:Operation .
hpc:Hasvalue rdfs:range xsd:string .

# Format
hpc:Name rdfs:range xsd:string .
hpc:Value rdfs:range xsd:string .

# Windows permissions
hpc:Local_Admins a hpc:Group .
hpc:Everyone a hpc:Group .
hpc:Domain_Admins a hpc:Group .
hpc:WorkgroupEnvironment a owl:Class .
hpc:DomainEnvironment a owl:Class .
hpc:haspermission a owl:ObjectProperty .

hpc:LocalAdmins hpc:haspermission hpc:LSF_sudoers .
hpc:Everyone hpc:haspermission hpc:LSF_sudoers .
hpc:DomainAdmins hpc:haspermission hpc:LSF_sudoers .
hpc:WorkgroupEnvironment rdfs:subClassOf hpc:Environment .
hpc:DomainEnvironment rdfs:subClassOf hpc:Environment .

# File format
hpc:NAME a hpc:Operation .
hpc:VALUE a hpc:Operation .
hpc:String a owl:Class .
hpc:hasstring a owl:ObjectProperty .

hpc:Name rdfs:domain hpc:Operation .
hpc:Value rdfs:domain hpc:Operation .
hpc:Hasstring rdfs:range hpc:String .

# Comments and Reserved syntax
hpc:Comment a owl:Class .
hpc:hascomment a owl:ObjectProperty .
hpc:Comment rdfs:subClassOf rdf:Statement .
hpc:if rdf:Type rdf:Property .
hpc:If rdfs:domain rdf:Statement .
