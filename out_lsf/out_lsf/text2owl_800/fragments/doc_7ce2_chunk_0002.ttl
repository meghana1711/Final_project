hpc:Performancemonitoring a owl:Class .
hpc:hasendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range xsd:dateTime .
hpc:hassampleperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasmetrics a owl:Class ;
    rdfs:subClassOf hpc:Performancemonitoring .
hpc:Metric a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Metric .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Metric .
hpc:ProcessedRequests a hpc:Metric .
hpc:JobInformationQueries a hpc:Metric .
hpc:HostInformationQueries a hpc:Metric .
hpc:QueueInformationQueries a hpc:Metric .
hpc:JobSubmissionRequests a hpc:Metric .
hpc:enableperformancemetriccollection a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range hpc:Boolean .
hpc:defaultsampleperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range xsd:nonNegativeInteger .
hpc:enablequerydiagnosis a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range hpc:Boolean .
hpc:diagnoselogdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemonitoring .
hpc:enablequerydiagnosisbydefault a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemonitoring ;
    rdfs:range hpc:Boolean .
hpc:diagnoseduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Diagnosecommand .
hpc:Diagnosecommand a owl:Class .
