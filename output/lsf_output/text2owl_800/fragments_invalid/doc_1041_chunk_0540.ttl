hpc:Reservationrequest a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Hasunit ;
    rdfs:subClassOf hpc:Hasqueue ;
    rdfs:subClassOf hpc:Hasresourcerequirements ;
    rdfs:subClassOf hpc:Hasuserpermissions ;
    rdfs:subClassOf hpc:Hasslotorhostspecification ;
    rdfs:domain hpc:Hasunit rdf:Resource ;
    rdfs:domain hpc:Hasqueue rdf:Resource ;
    rdfs:domain hpc:Hasresourcerequirements rdf:Resource ;
    rdfs:domain hpc:Hasuserpermissions rdf:Resource ;
    rdfs:domain hpc:Hasslotorhostspecification rdf:Resource ;
    rdfs:range hpc:Resourcerequirements rdf:Resource ;
    rdfs:range hpc:Userpermissions rdf:List ;
    rdfs:range hpc:Slotorhostspecification xsd:string ;

hpc:hasunit a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationrequest ;
    rdfs:range hpc:Unit ;

hpc:Unit a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger ;

hpc:hasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationrequest ;
    rdfs:range hpc:Queue ;

hpc:Queue a owl:Class ;

hpc:hasresourcerequirements a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationrequest ;
    rdfs:range hpc:Resourcerequirements ;

hpc:Resourcerequirements a owl:Class ;

hpc:hasuserpermissions a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationrequest ;
    rdfs:range hpc:Userpermissions ;

hpc:Userpermissions a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf hpc:User ;

hpc:hasslotorhostspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationrequest ;
    rdfs:range xsd:string ;

hpc:Slotorhostspecification a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:subClassOf owl:Literal ;
    owl:differentFrom hpc:Unit ;
