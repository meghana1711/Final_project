hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "The hosts specified by the job in the submission options." .

hpc:allocSlot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "List of execution hosts, and the number of slots allocated to the job on each host." .

hpc:nallocSlot a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of slots allocated to the job." .

hpc:hostFile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "A user-specified host file while the job was submitted." .

hpc:exclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether or not the job is exclusive." .

hpc:nreqSlot a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of slots requested by the job" .

hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when the job was submitted." .

hpc:startTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when the job was started to run." .

hpc:estimatedStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The job's estimated start time." .

hpc:speciﬁed_start_time a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The specified start time of the job while submitted." .

hpc:speciﬁed_terminate_time a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Specifies the job termination deadline." .

hpc:timeLeft a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Amount of time left running based on the run limit of the job." .

