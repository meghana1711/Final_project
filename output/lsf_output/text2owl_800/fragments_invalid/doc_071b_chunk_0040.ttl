hpc:Field a owl:Class;
    rdfs:subClassOf owl:Class.

hpc:Width rdfs:domain hpc:Field;
    rdfs:range xsd:nonNegativeInteger.

hpc:Justification rdfs:domain hpc:Field;
    rdfs:range xsd:string.

hpc:Unit rdfs:domain hpc:Field;
    rdfs:range xsd:string.

hpc:Unitconversion rdfs:domain hpc:Unit;
    rdfs:range owl:ObjectProperty.

hpc:Builtinconversion rdfs:domain hpc:Unitconversion;
    rdfs:range xsd:string.

hpc:SpaceConversion a hpc:BuiltInConversion;
    rdfs:subPropertyOf hpc:UnitConversion.

hpc:TimeConversion a hpc:BuiltInConversion;
    rdfs:subPropertyOf hpc:UnitConversion.

hpc:Spaceconversionunit rdfs:domain hpc:Spaceconversion;
    rdfs:range xsd:string.

hpc:Timeconversionunit rdfs:domain hpc:Timeconversion;
    rdfs:range xsd:string.

hpc:Spaceconversionscale rdfs:domain hpc:Spaceconversionunit;
    rdfs:range xsd:string.

hpc:Timeconversionscale rdfs:domain hpc:Timeconversionunit;
    rdfs:range xsd:string.

hpc:Fieldvalue rdfs:domain hpc:Field;
    rdfs:range xsd:string.

hpc:Fieldwidth rdfs:domain hpc:Fieldvalue;
    rdfs:range xsd:nonNegativeInteger.

hpc:Scaledvalue rdfs:domain hpc:Fieldvalue;
    rdfs:range xsd:decimal.

hpc:Scaledvaluerounding rdfs:domain hpc:Scaledvalue;
    rdfs:range xsd:nonNegativeInteger.

hpc:JustificationRight a hpc:Justification;
    rdfs:label "right justification"@en.

hpc:JustificationLeft a hpc:Justification;
    rdfs:label "left justification"@en.

hpc:UnitColon a hpc:Unit;
    rdfs:label "unit colon"@en.

hpc:SpaceUnit S;
    rdfs:label "space or capacity"@en.
    hpc:SpaceConversion rdfs:subPropertyOf hpc:UnitColon.
    hpc:Spaceconversionscale rdfs:range xsd:string;
        owl:inDomain hpc:SpaceUnit;
        owl:hasValue "M"^;
        owl:hasValue "G"^;
        owl:hasValue "T"^.

hpc:TimeUnit D;
    rdfs:label "duration or time"@en.
    hpc:TimeConversion rdfs:subPropertyOf hpc:UnitColon.
    hpc:Timeconversionscale rdfs:range xsd:string;
        owl:inDomain hpc:TimeUnit;
        owl:hasValue "s"^
