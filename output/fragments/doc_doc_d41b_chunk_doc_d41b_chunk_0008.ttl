hpc:MinPrioThreshold a owl:Class .
hpc:hasMinPrioThreshold rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ResourceAssociation ;
    rdfs:range xsd:decimal .

hpc:QOS a owl:Class .
hpc:hasQOS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ResourceAssociation ;
    rdfs:range rdfs:Resource .

hpc:TRES a owl:Class .

hpc:modifyTRES rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Action ;
    rdfs:range hpc:TRES .

hpc:hasQOSLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:decimal .

hpc:OverPartQOS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:boolean .

hpc:DenyOnLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:boolean .

hpc:PreemptionGraceTime a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:time .

hpc:PreemptMode a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:string .

hpc:GrpJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:nonNegativeInteger .

hpc:GrpJobsAccrue a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:nonNegativeInteger .
