hpc:Userdata a owl:Class .
hpc:Hasenvironmentvariable hpc:Userdata rdfs:domain hpc:Userdata ;
                                rdfs:range xsd:string .

hpc:Environmentvariable a owl:Class .
hpc:Haskey hpc:Environmentvariable rdfs:domain hpc:Environmentvariable ;
                                rdfs:range xsd:string .
hpc:Hasvalue hpc:Environmentvariable rdfs:domain hpc:Environmentvariable ;
                                rdfs:range xsd:string .

hpc:Ec2fleetconfig a owl:Class .
hpc:Hasec2fleetconfigfile hpc:Ec2fleetconfig rdfs:domain hpc:Ec2fleetconfig ;
                             rdfs:range xsd:string .

hpc:ondemandtargetcapacityratio a owl:DatatypeProperty .
hpc:Ondemandtargetcapacityratio rdfs:domain hpc:Ec2fleetconfig ;
                                 rdfs:range xsd:float .

hpc:Awsec2fleetinstance a owl:Class .
hpc:Hasondemandtargetcapacityratio hpc:Awsec2fleetinstance rdfs:domain hpc:Awsec2fleetinstance ;
                                 rdfs:range xsd:float .
