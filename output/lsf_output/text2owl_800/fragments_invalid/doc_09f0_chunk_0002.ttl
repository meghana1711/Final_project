hpc:Job a owl:Class .
hpc:Defaultqueue a owl:Class .
hpc:Interactivequeue a rdfs:subClassOf hpc:Defaultqueue .
hpc:submitted a owl:ObjectProperty .
hpc:Submitted rdfs:domain hpc:Job .
hpc:Submitted rdfs:range rdf:Literal .
hpc:Queue rdfs:domain hpc:Submitted .
hpc:Queue rdfs:range hpc:Defaultqueue .
hpc:cwd a owl:DatatypeProperty .
hpc:Cwd rdfs:domain hpc:Job .
hpc:Cwd rdfs:range xsd:string .
hpc:Dynamicjobcwd a owl:Class .
hpc:Dynamicjobcwd rdfs:subClassOf hpc:Job .
hpc:hasdynamicjobcwd a owl:ObjectProperty .
hpc:Hasdynamicjobcwd rdfs:domain hpc:Dynamicjobcwd .
hpc:Hasdynamicjobcwd rdfs:range xsd:string .
hpc:jobcwdttl a owl:DatatypeProperty .
hpc:Jobcwdttl rdfs:domain hpc:Applicationprofile .
hpc:Jobcwdttl rdfs:range xsd:nonNegativeInteger .
hpc:Dynamicpattern a owl:Class .
hpc:Dynamicpattern rdfs:subClassOf xsd:string .
hpc:Submissiondirectory a owl:Class .
hpc:Submissiondirectory rdfs:subClassOf xsd:string .
hpc:Applicationprofile a owl:Class .
hpc:currentworkingdirectory a owl:DatatypeProperty .
hpc:Currentworkingdirectory rdfs:domain hpc:Applicationprofile .
hpc:Currentworkingdirectory rdfs:range (hpc:Absolutepath | hpc:Relativepath) .
hpc:Absolutepath a owl:Class .
hpc:Relativepath a owl:Class .
hpc:Relativepath rdfs:subClassOf xsd:string .
hpc:Absolutepath rdfs:subClassOf xsd:string .
