hpc:HostnameAndPortNumber a rdfs:subClassOf hpc:CommonIssue .
hpc:APIVersionAndEndpoint a rdfs:subClassOf hpc:CommonIssue .
hpc:LogOutput a rdfs:subClassOf hpc:CommonIssue .
