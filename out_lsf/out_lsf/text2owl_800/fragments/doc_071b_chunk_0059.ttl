hpc:Jobcwd a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the Current Working Directory (CWD) for a job." .

hpc:jobCwdTtl a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the time-to-live for the CWD of a job." .

hpc:jobCwd a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the CWD for the job in the application profile. The path can be absolute or relative to the submission directory." .

hpc:clusterWideCwd a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the cluster wide CWD for the job." .

hpc:executionHostCwd a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the directory on the execution host from where the job starts." .

hpc:lsbJobCwd a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcwd ;
    rdfs:range xsd:string ;
    rdfs:comment "If the job is submitted with the -app option but without the -cwd option, and the LSB_JOB_CWD parameter is not defined, then the application profile defined in the JOB_CWD parameter will be used." .
