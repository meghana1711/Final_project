hpc:printMessage rdfs:domain hpc:TaskPrologScript .
hpc:printMessage rdfs:range rdf:PlainLiteral .
hpc:exportEnvironmentVariable a owl:ObjectProperty .
hpc:exportEnvironmentVariable rdfs:domain hpc:TaskPrologScript .
hpc:exportEnvironmentVariable rdfs:range rdf:Literal .
