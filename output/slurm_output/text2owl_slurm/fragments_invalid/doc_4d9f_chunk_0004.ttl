@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Slurmjob a owl:Class .
hpc:Slurmarrayjob a owl:Class .
hpc:Slurmtask a owl:Class .

hpc:hasslurmid a owl:ObjectProperty .
hpc:haspartition a owl:ObjectProperty .
hpc:hasuser a owl:ObjectProperty .
hpc:hasstate a owl:ObjectProperty .
hpc:hastime a owl:DatatypeProperty ; rdfs:range xsd:time .
hpc:hasnodes a owl:DatatypeProperty ; rdfs:range xsd:nonNegativeInteger .
hpc:hasnodelist a owl:
