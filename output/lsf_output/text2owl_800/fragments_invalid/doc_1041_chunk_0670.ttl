hpc:Job
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A job executed on an HPC system." .

hpc:OutputFile
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A file where the standard output of a job is stored." .

hpc:StandardOutput
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputfile ;
    rdfs:comment "The standard output of a job." .

hpc:TemporaryOutputFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputfile ;
    rdfs:comment "The temporary file where the standard output of a job is written if LSB_STDOUT_DIRECT is not set." .

hpc:JobID
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The ID of a job." .

hpc:ArrayIndex
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of a job within an array." .

hpc:UnixLinuxPathLength
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the file path for UNIX and Linux systems." .

hpc:WindowsPathLength
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum length of the file path for Windows systems." .

hpc:LSBSTDOUTDIRECT
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether the standard output of a job is written directly to the specified file." .

hpc:JobOutputFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputfile ;
    rdfs:comment "The output file for a job." .

hpc:JobErrorFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputfile ;
    rdfs:comment "The error file for a job." .

hpc:JobStandardErrorInOutputFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the standard error of a job is stored in the output file." .

hpc:JobNullErrorFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs
