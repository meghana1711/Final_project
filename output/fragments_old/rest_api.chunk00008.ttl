hpc:Job a owl:Class .

hpc:IRI a rdf:Property .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:federation_origin a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:container_id a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:shared a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:tasks_per_board a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:user_name a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:stderr_expanded a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:standard_input a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:admin_comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:cores_per_socket a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:job_state a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:status a owl:Class .
hpc:signal a owl:DatatypeProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .

hpc:id a owl:DatatypeProperty ;
    rdfs:domain hpc:Signal ;
    rdfs:range xsd:nonNegativeInteger .

hpc:sockets_per_board a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:nice a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:job_resources a owl:Class .
hpc:nodes a owl:Class ;
    rdfs:subClassOf hpc:JobResources .

hpc:allocation a owl:Class ;
    rdfs:subClassOf hpc:Nodes .

