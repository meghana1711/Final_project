hpc:LSB_JOB_INCLUDE_POSTPROC
    a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:domain hpc:Userenvironment ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Overrides the value of JOB_INCLUDE_POSTPROC in an application profile in lsb.applications." .

hpc:JOB_INCLUDE_POSTPROC
    a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Overrides the value of JOB_INCLUDE_POSTPROC in lsb.params." .

hpc:JOB_INFO_EVENT_DUMP_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Controls how frequently the job info events file (jobinfo cache) is rewritten." .

hpc:JOB_INFO_MEMORY_CACHE_SIZE
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Configures how much memory to use for the jobinfo cache." .
