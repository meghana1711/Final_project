hpc:Logfile a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] .

hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:daemonname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfilename ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfilename ;
    rdfs:range xsd:string .

hpc:logfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:Unixsystem a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf hpc:Logfilelocation ] .

hpc:tmpdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Unixsystem ;
    rdfs:range xsd:string .

hpc:Windowssystem a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf hpc:Logfilelocation ] .

hpc:nologfilecreated a owl:ObjectProperty ;
    rdfs:domain hpc:Windowssystem ;
    rdfs:range xsd:boolean .

hpc:defaultlogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Logfilelocation ;
    rdfs:range hpc:Logfile .

hpc:loglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:lslogmask a owl:DatatypeProperty ;
    rdfs:domain hpc:Loglevel ;
    rdfs:range xsd:string .

hpc:lsbdebugbld a owl:DatatypeProperty ;
    rdfs:domain hpc:Loglevel ;
    rdfs:range xdfs:string .

hpc:resetlogsettings a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range hpc:Logfile .

hpc:collectorname a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:allcollectors a owl:ObjectProperty ;
    rdfs:domain hpc:Collectorname ;
    rdfs:range xsd:string .
