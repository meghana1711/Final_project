hpc:Checkpointdir a owl:Class ;
    rdfs:comment "The directory you specified through the -k option of bsub when submitting the checkpointable job." .

hpc:Jobid a owl:Class ;
    rdfs:comment "The job ID of the checkpointable job." .

hpc:lsbcontainerimageupdate a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "If defined, LSF updates the Docker image that is specified in the job related application file before execution." .

hpc:lsbdatacachetop a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:string ;
    rdfs:comment "Contains a string defining the location of the data management staging area relative to the compute node." .

hpc:lsbdatametafile a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequiringjob ;
    rdfs:range xsd:string ;
    rdfs:comment "For jobs submitted with data requirements, this variable contains a string defining the location of the job's metadata file relative to the compute node." .

hpc:lsbdataprovenance a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables data provenance for LSF jobs, which allows you to trace files that are generated by LSF jobs." .

hpc:Dataprovenancerequiringjob a owl:Class ;
    rdfs:subClassOf hpc:Checkpointablejob ;
    rdfs:comment "A subclass of CheckpointableJob that requires data provenance." .
