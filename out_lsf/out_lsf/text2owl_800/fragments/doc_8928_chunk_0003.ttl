hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:exechost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:spanningexecutionhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .

hpc:JobWithSpanningexecutionhosts a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:intersectionOf (hpc:Job hpc:hasSpanningExecutionHosts) ] .

hpc:hasspanningexecutionhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Spanningexecutionhosts .
