hpc:Host a owl:Class .
hpc:Configuredhosts rdfs:domain hpc:Host .

hpc:Ownedhosts rdfs:subClassOf hpc:Host .
hpc:Owneruse rdfs:domain hpc:Ownedhosts .
hpc:Totaluse rdfs:range xsd:decimal .
hpc:OtherUse rdfs:subPropertyOf hpc:OwnerUse .

hpc:Loanhosts rdfs:subClassOf hpc:Host .
hpc:Loanuse rdfs:domain hpc:Loanhosts .

hpc:Sharedhosts rdfs:subClassOf hpc:Host .
hpc:OtherUseOnShared rdfs:subPropertyOf hpc:OtherUse .

hpc:Pool rdfs:subClassOf hpc:Host .
hpc:Usedmemory rdfs:domain hpc:Pool .
hpc:Usedslots rdfs:domain hpc:Pool .

hpc:Longoutput rdfs:subClassOf hpc:Host .
hpc:Listedhosts rdfs:domain hpc:Longoutput .

hpc:Guaranteesharedpool rdfs:subClassOf hpc:Sharedhosts .
hpc:OtherUseOnGuaranteeShared rdfs:subPropertyOf hpc:OtherUseOnShared .
