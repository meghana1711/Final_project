hpc:State a owl:Enum;
  rdfs:subClassOf owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:string ;
  rdfs:enum "UP" "DOWN" .

hpc:MaxJobTimeLimit a owl:DatatypeProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:nonNegativeInteger .

hpc:MaxNodeCountPerJob a owl:DatatypeProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:nonNegativeInteger .

hpc:GroupAccessList a owl:Class ;
  rdfs:subClassOf owl:Class .

hpc:Priority a owl:DatatypeProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:nonNegativeInteger .

hpc:SharedNodeAccessPolicy a owl:Enum;
  rdfs:subClassOf owl:DatatypeProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:string ;
  rdfs:enum "YES" "NO" "FORCE:2" .

hpc:Node a owl:Class .
hpc:Partition a owl:Class .

hpc:NodeName a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:string .

hpc:CPUs a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:nonNegativeInteger .

hpc:TmpDisk a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:nonNegativeInteger .

hpc:RealMemory a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:nonNegativeInteger .

hpc:Weight a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:nonNegativeInteger .

hpc:Feature a owl:DatatypeProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:string .

hpc:State a hpc:State ;
hpc:MaxTime a hpc:MaxJobTimeLimit ;
hpc:MaxNodes a hpc:MaxNodeCountPerJob ;
hpc:AllowGroups a owl:ObjectProperty ;
hpc:Default a owl:DatatypeProperty .

hpc:Nodes a owl:ObjectProperty ;
  rdfs:domain
