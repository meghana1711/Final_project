hpc:Job a owl:Class .
hpc:Requirescpus rdfs:domain hpc:Job ;
                  rdfs:range xsd:integer .
hpc:Runinsinglenode rdfs:domain hpc:Job ;
                     rdfs:range xsd:integer .
hpc:Slurmconf rdfs:subClassOf hpc:Configuration .
hpc:Selecttype rdfs:domain hpc:Slurmconf ;
              rdfs:range hpc:Selecttypeparameters .
hpc:Selecttypeparameters rdfs:subClassOf hpc:Parameter .
hpc:Taskplugin rdfs:domain hpc:Slurmconf ;
               rdfs:range hpc:Plugin .
hpc:Cgroupconf rdfs:subClassOf hpc:Configuration .
hpc:Constraincores rdfs:domain hpc:Cgroupconf ;
               rdfs:range xsd:boolean .
hpc:Commandline rdfs:subClassOf hpc:Configuration .
hpc:srun a owl:ObjectProperty ;
        rdfs:domain hpc:Commandline ;
        rdfs:range hpc:Srunparameters .
hpc:Srunparameters rdfs:subClassOf hpc:Parameter .
hpc:SrunparametersNodes rdfs:domain hpc:Srunparameters ;
               rdfs:range xsd:integer .
hpc:SrunparametersNtasks rdfs:domain hpc:Srunparameters ;
               rdfs:range xsd:integer .
hpc:Taskdistributionmethod rdfs:domain hpc:Taskplugin ;
               rdfs:range hpc:Distributionmethod .
hpc:Blockmethod rdfs:subClassOf hpc:Taskdistributionmethod .
hpc:Taskbinding rdfs:domain hpc:Taskplugin ;
               rdfs:range xsd:boolean .
hpc:Taskaffinity rdfs:subClassOf hpc:Taskplugin .
