hpc:Datarequirementtype:Directory a owl:Class .

hpc:Hasstagedfile rdfs:domain hpc:Jobexecutionenvironment .
hpc:Hasstagedfile rdfs:range hpc:Datafile .

hpc:stagein a owl:ObjectProperty .
