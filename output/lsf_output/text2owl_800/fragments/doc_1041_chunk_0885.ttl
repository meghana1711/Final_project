hpc:Outputfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Specifies a file path." .

hpc:hasoutputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Outputfile ;
    rdfs:comment "Specifies the output file for the task." .

hpc:outputfilepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The file path for the output." .

hpc:Currentworkingdirectory a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The current working directory." .

hpc:Tempdirectory a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The temporary directory." .

hpc:LsbStdoutDirect a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A parameter in the lsf.conf file." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "The job ID." .

hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "The job array index." .

hpc:taskid a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "The task ID." .

hpc:taskarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "The task array index." .

hpc:maxfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputfile ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum length of the file path, including the directory, file name, and expanded values for %J, %I, %T, and %X." .
