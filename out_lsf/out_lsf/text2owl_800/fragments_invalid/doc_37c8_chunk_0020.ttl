hpc:Containerjob a owl:Class .
hpc:premounthookscript a owl:ObjectProperty .
hpc:datapreparationdirectory a owl:ObjectProperty .
hpc:customizedcontainer a owl:ObjectProperty .
hpc:Containerimage a owl:Class .
hpc:Containeroptions a owl:Class .
hpc:Container a owl:Class .
hpc:Containerjob a rdfs:subClassOf hpc:Job .
hpc:Premounthookscript rdfs:domain hpc:Containerjob ;
    rdfs:range rdf:Resource .
hpc:Datapreparationdirectory rdfs:domain hpc:Containerjob ;
    rdfs:range rdf:Resource .
hpc:Customizedcontainer rdfs:domain hpc:Containerjob ;
    rdfs:range rdf:Resource .
hpc:Containerimage rdfs:subClassOf rdf:Resource .
hpc:Containeroptions rdfs:subClassOf rdf:Resource .
hpc:Container rdfs:subClassOf rdf:Resource .
hpc:Containerimage rdfs:range xsd:string .
hpc:Containeroptions rdfs:range xsd:string .
hpc:Container rdfs:subClassOf hpc:Containerimage ;
    rdfs:subClassOf hpc:Containeroptions .
