hpc:Lsf a owl:Class .
hpc:hassmtmode a owl:ObjectProperty .
hpc:Hassmtmode rdfs:domain hpc:Lsf ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:hasnumthreadspertask a owl:ObjectProperty .
hpc:Hasnumthreadspertask rdfs:domain hpc:Lsf ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:hassmt a owl:ObjectProperty .
hpc:Hassmt rdfs:domain hpc:Lsf ;
            rdfs:range xsd:nonNegativeInteger .
hpc:hascpuspercore a owl:ObjectProperty .
hpc:Hascpuspercore rdfs:domain hpc:Lsf ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:hasdistributionpolicy a owl:ObjectProperty .
hpc:Hasdistributionpolicy rdfs:domain hpc:Lsf ;
                           rdfs:range xsd:string .
hpc:hasmaxsmt a owl:DatatypeProperty .
hpc:Hasmaxsmt rdfs:domain hpc:Ppc64leexecutionhost ;
               rdfs:range xsd:nonNegativeInteger .
hpc:hasppc64Cpucommand a owl:DatatypeProperty .
hpc:Hasppc64Cpucommand rdfs:domain hpc:Ppc64leexecutionhost ;
                         rdfs:range xsd:string .
hpc:haslinuxcgroupfeature a owl:DatatypeProperty .
hpc:Haslinuxcgroupfeature rdfs:domain hpc:Lsf ;
                           rdfs:range xsd:string .
hpc:Ppc64leexecutionhost a owl:Class .
hpc:smtmode a owl:DatatypeProperty .
hpc:Smtmode rdfs:domain hpc:Lsf ;
               rdfs:range xsd:string .
hpc:Maxsmt a owl:Class ;
             rdfs:subClassOf hpc:Ppc64leexecutionhost .
hpc:hasenabledlinuxcgroupfeature a owl:ObjectProperty .
hpc:Hasenabledlinuxcgroupfeature rdfs:domain hpc:Maxsmt ;
                                 rdfs:range hpc:Linuxcgroupfeature .
hpc:Linuxcgroupfeature a owl:Class .
