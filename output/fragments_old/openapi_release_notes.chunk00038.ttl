  rdfs:domain hpc:SharesUint64Tres ;
  rdfs:range xsd:integer .

hpc:SlurmdbdPing a owl:Class .
hpc:primary rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:SlurmdbdPing ;
  rdfs:range xsd:boolean .

