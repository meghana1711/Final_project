hpc:LsbSub3Run a owl:Class .
hpc:runtimeestimationonacc-WePlus a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:integer .
hpc:runtimeestimationonpercent-WeP a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:integer .
hpc:lsbSub3UserShellLimit a owl:ObjectProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:boolean .
hpc:lsbSub3XjobSsh a owl:ObjectProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:boolean .
hpc:lsbSimCpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:float .
hpc:lsbSimCputime a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:integer .
hpc:lsbSimExitstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:integer .
hpc:lsbSimJobid a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/hpc#> ;
    rdfs:comment "This value cannot be modified." .
hpc:lsbSimJobidx a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbSub3Run ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/hpc#> ;
    rdfs:comment "This value cannot be modified." .
