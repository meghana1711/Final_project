hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:stat a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JobNamePending a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:bhist a owl:ObjectProperty .
hpc:bhistData a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:string .
hpc:bjobs a owl:ObjectProperty .
hpc:bjobsData a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .
hpc:bsub a owl:ObjectProperty .
hpc:bsubData a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string .
hpc:File a owl:Class .
hpc:fileSize a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:decimal .
hpc:fileModified a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:dateTime .
hpc:bhistTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:decimal .
