hpc:Jobstate a owl:Class .
hpc:Basestate a owl:Class .
hpc:Stateflag a owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Jobstate .

hpc:Hasbasestate rdfs:domain hpc:Job ;
    rdfs:range hpc:Basestate .

hpc:Hasstateflag rdfs:domain hpc:Job ;
    rdfs:range hpc:Stateflag .

hpc:Restapirepresentation a owl:Class ;
    rdfs:subClassOf hpc:Jobstate .

hpc:Squeuerepresentation a owl:Class ;
    rdfs:subClassOf hpc:Jobstate .

hpc:Sacctrepresentation a owl:Class ;
    rdfs:subClassOf hpc:Jobstate .

hpc:code a owl:DatatypeProperty .
hpc:userfacingname a owl:DatatypeProperty .
