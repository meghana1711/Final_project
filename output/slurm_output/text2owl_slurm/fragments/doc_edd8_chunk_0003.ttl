hpc:Task a owl:Class .
hpc:taskpluginparam a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Taskpluginparamvalue .
hpc:Taskpluginparamvalue a owl:Class .
hpc:scontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:Slurmconf a owl:Class .
hpc:configuration a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmconf ;
    rdfs:range xsd:string .
