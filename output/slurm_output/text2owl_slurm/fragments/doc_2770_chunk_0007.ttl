hpc:lockreleasetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lock ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "This specifies the length of time for which the locks are relinquished in microseconds." .

hpc:LockReleaseTime rdfs:subPropertyOf hpc:TimeDuration .

hpc:Lockreleasetime a rdfs:Class ;
    rdfs:subClassOf owl:Class .

hpc:DefaultLockReleaseTime a owl:NamedIndividual ;
    hpc:LockReleaseTime "500000"^^xsd:unsignedLong .
