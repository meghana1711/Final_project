    rdfs:domain hpc:Lsfversion101Fixpack8 ;
    rdfs:range hpc:Gpuaffinitybinding .
hpc:mpspergpu a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion101Fixpack8 ;
    rdfs:range hpc:Gpuaffinitybinding .

