hpc:Lsfjob a owl:Class .
hpc:relaxjobdispatchorder a owl:ObjectProperty .
hpc:allocreuseduration a owl:DatatypeProperty .
hpc:share a owl:ObjectProperty .
hpc:User rdf:type xsd:string .
hpc:Group rdf:type xsd:string .
hpc:Project rdf:type xsd:string .

hpc:Lsfjob rdfs:subClassOf owl:Class .
hpc:Relaxjobdispatchorder rdfs:domain hpc:Lsfjob ;
                            rdfs:range xsd:string .
hpc:Allocreuseduration rdfs:domain hpc:Lsfjob ;
                          rdfs:range xsd:duration .
hpc:Share rdfs:domain hpc:Lsfjob ;
              rdfs:range rdf:List .
hpc:Share rdfs:range rdf:first hpc:User ;
              rdfs:range rdf:rest (rdf:List | hpc:Group | hpc:Project) .
