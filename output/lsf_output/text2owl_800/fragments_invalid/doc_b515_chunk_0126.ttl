hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation ;
    rdfs:comment "Reservations made in advance by LSF." .

hpc:brsvadd a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Advancereservation ;
    rdfs:comment "Add a reservation." .

hpc:brsvdel a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Advancereservation ;
    rdfs:comment "Delete a reservation." .

hpc:brsvmod a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Advancereservation ;
    rdfs:comment "Modify a reservation." .

hpc:brsvs a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Advancereservationlist ;
    rdfs:comment "View reservations."
