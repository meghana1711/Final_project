hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Hpcentity ;
    rdfs:comment "A job in the HPC system." .

hpc:jobexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Requeueexitvalues a owl:Class ;
    rdfs:subClassOf hpc:Jobexitvalue ;
    rdfs:comment "Exit values that trigger job re-queuing." .

hpc:maxjobrequeue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of times a job can be re-queued." .

hpc:jobrequeuecount a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of times a job has been re-queued." .

hpc:jobsuspended a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Psusp ;
    rdfs:comment "Indicates whether a job is suspended." .

hpc:Psusp a owl:Class ;
    rdfs:comment "A job status indicating suspension." .
