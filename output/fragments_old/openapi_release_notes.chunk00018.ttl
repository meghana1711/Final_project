hpc:JobInfo a owl:Class .

hpc:preemptTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Time job received preemption signal (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .

hpc:preemptableTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Time job becomes eligible for preemption (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int32 ;
    rdfs:comment "Request specific job priority (32 bit integer number with flags)" .

hpc:profile a owl:ObjectProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range rdf:List ;
    rdfs:comment "Array of job profile strings" .

hpc:profile hpc:items a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string ;
    rdfs:enum "NOT_SET" , "NONE" , "ENERGY" , "LUSTRE" , "NETWORK" , "TASK" .

hpc:requiredNodes a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Comma-separated list of required nodes" .

hpc:resizeTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Time of last size change (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .

hpc:segmentSize a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:int ;
    rdfs:comment "
