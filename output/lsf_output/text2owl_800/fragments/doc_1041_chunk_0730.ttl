hpc:Xwindowjob a owl:Class .
hpc:sshx11forwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Xwindowjob ;
    rdfs:range hpc:Sshx11forwardingtype .
hpc:Sshx11forwardingtype a owl:Class .
hpc:encryptsxserver a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype .

hpc:requiressshdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Boolean .
hpc:requiressshclient a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Unixhost .
hpc:requiresopenssh a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range xsd:nonNegativeInteger .
hpc:requiresopenssl a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range xsd:nonNegativeInteger .
hpc:requirescorrectsshinstallation a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Cluster .
hpc:requiresclientx11forwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Boolean .
hpc:requiresunixhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Unixhost .
hpc:requiresdisplayhostlogin a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Sshlogin .
hpc:requiresxserverprogram a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwardingtype ;
    rdfs:range hpc:Xserverprogram .
hpc:cannotrunwithk a owl:ObjectProperty ;
    rdfs:domain hpc:Xwindowjob ;
    rdfs:range hpc:Boolean .
hpc:cannotbmodjob a owl:ObjectProperty ;
    rdfs:domain hpc:Xwindowjob ;
    rdfs:range hpc:Boolean .
