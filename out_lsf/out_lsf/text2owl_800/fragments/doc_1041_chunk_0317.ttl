hpc:Job a owl:Class .
hpc:ExecutionCluster rdf:type owl:Class .
hpc:SubmissionCluster rdf:type owl:Class .
hpc:ZombieJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hasexecutioncluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executioncluster .

hpc:notifiessubmissioncluster a owl:ObjectProperty ;
    rdfs:domain hpc:Executioncluster ;
    rdfs:range hpc:Submissioncluster .

hpc:hasestimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:hastimeleft a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:hassymbol a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasfinishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:Estate a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Lstate a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Xstate a owl:Class ;
    rdfs:subClassOf hpc:Job .
