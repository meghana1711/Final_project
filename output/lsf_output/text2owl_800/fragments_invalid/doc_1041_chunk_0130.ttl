hpc:fairshareValueValue a owl:DatatypeProperty ;
    rdfs:domain hpc:FairshareValue ;
    rdfs:range xsd:integer .

hpc:accessControl a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .

