@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:subClassOf hpc:Reservation .

hpc:numberofjobslotsorhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:nonNegativeInteger ;

hpc:unit a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range (hpc:Slot hpc:Host) ;

hpc:owners a owl:ObjectProperty ;
    rdfs:domain h
