hpc:Cluster a owl:Class .
hpc:hasclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:shareassignment a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
hpc:allocatedlicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:currentallocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:idealallocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:inuselicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:reservedlicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:overlicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:peaklicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
