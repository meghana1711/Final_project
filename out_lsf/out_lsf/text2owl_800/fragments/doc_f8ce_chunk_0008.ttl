hpc:Lsfdatamanager a owl:Class .
hpc:stagingarea a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
hpc:cacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
hpc:StagingArea a owl:Class ;
    rdfs:subClassOf hpc:Stagingarea .
hpc:Stgin a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Stgout a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Work a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Tags a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Stgindirectory a owl:Class ;
    rdfs:subClassOf hpc:StagingArea ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "This folder contains all incoming data requirement files." .
hpc:Stgoutdirectory a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Workdirectory a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:Tagdirectory a owl:Class ;
    rdfs:subClassOf hpc:StagingArea .
hpc:CachePermissions a owl:Class ;
    rdfs:subClassOf hpc:Stgindirectory .
hpc:hasstagingarea a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .
hpc:hasstgindirectory a owl:ObjectProperty ;
    rdfs:domain hpc:StagingArea ;
    rdfs:range hpc:Stgindirectory .
hpc:hasstgoutdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:StagingArea ;
    rdfs:range hpc:Stgoutdirectory .
hpc:hasworkdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:StagingArea ;
    rdfs:range hpc:Workdirectory .
hpc:hastagdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:StagingArea ;
    rdfs:range hpc:Tagdirectory .
hpc:stgindirectoryownership a owl:DatatypeProperty ;
    rdfs:domain hpc:Stgindirectory ;
    rdfs:range xsd:string .
hpc:stgindirectorypermissions a owl:DatatypeProperty ;
    rdfs:domain hpc:Stgindirectory ;
    rdfs:range xsd:integer .
