hpc:Lsfconfiguration a owl:Class .
hpc:Lsfreconfiguration a owl:Class .
hpc:Lshutdown a owl:Class .
hpc:Bldebug a owl:Class .
hpc:Blcdebug a owl:Class .

# Object Properties
hpc:hasconfigurationfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .

hpc:checksconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration .

hpc:reconfigures a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfreconfiguration ;
    rdfs:range hpc:Host .

hpc:shutsdown a owl:ObjectProperty ;
    rdfs:domain hpc:Lshutdown ;
    rdfs:range hpc:Host .

hpc:buildsdebug a owl:ObjectProperty ;
    rdfs:domain hpc:Bldebug .

hpc:buildscollectordebug a owl:ObjectProperty ;
    rdfs:domain hpc:Blcdebug ;
    rdfs:range rdf:List .

# Datatype Properties
hpc:debuglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Bldebug ;
    rdfs:range xsd:nonNegativeInteger .

hpc:logfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Bldebug ;
    rdfs:range xsd:string .

hpc:outputoption a owl:DatatypeProperty ;
    rdfs:domain hpc:Bldebug ;
    rdfs:range xsd:boolean .

hpc:classnames a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcdebug .

hpc:collectornames a owl:DatatypeProperty ;
    rdfs:domain hpc:Blcdebug ;
    rdfs:range rdf:List .

# Subclass Relations
hpc:Lsfreconfiguration a rdfs:subClassOf hpc:Lsfconfiguration .
hpc:Lshutdown a rdfs:subClassOf hpc:Lsfreconfiguration .
hpc:Bldebug a rdfs:subClassOf hpc:Lshutdown .
hpc:Blcdebug a rdfs:subClassOf hpc:Bldebug .
