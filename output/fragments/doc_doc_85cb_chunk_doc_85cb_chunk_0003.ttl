hpc:Count rdf:type owl:DatatypeProperty .
hpc:Allowed rdf:type owl:DatatypeProperty .
hpc:Cluster rdf:type owl:ObjectProperty .

hpc:License a owl:Class .
hpc:Total rdf:type owl:DatatypeProperty .
hpc:Used rdf:type owl:DatatypeProperty .
hpc:Free rdf:type owl:DatatypeProperty .
hpc:Reserved rdf:type owl:DatatypeProperty .
hpc:Remote rdf:type owl:DatatypeProperty .
hpc:LastConsumed rdf:type owl:DatatypeProperty .
hpc:LastDeficit rdf:type owl:DatatypeProperty .
hpc:LastUpdate rdf:type xsd:dateTime .
hpc:Server rdf:type owl:ObjectProperty .

hpc:Nastran a hpc:Resource .
hpc:Matlab a hpc:Resource .

hpc:fluid a hpc:Cluster ;
    hpc:ControlHost "143.11.1.3" .

