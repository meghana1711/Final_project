hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Resource a owl:Class .
hpc:hasmemorylimit a owl:ObjectProperty .
hpc:belongstocomputeunit a owl:ObjectProperty .
hpc:haspreferencelevel a owl:DatatypeProperty .
hpc:hashostgroup a owl:ObjectProperty .
hpc:hascomputeunit a owl:ObjectProperty .

hpc:Resource rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf hpc:Resource .
hpc:Computeunit rdfs:subClassOf hpc:Resource .

hpc:Hasmemorylimit rdfs:domain hpc:Job .
hpc:Hasmemorylimit rdfs:range xsd:boolean .

hpc:Belongstocomputeunit rdfs:domain hpc:Host .
hpc:Belongstocomputeunit rdfs:range hpc:Computeunit .

hpc:Haspreferencelevel rdfs:domain hpc:Host .
hpc:Haspreferencelevel rdfs:range xsd:nonNegativeInteger .

hpc:Hashostgroup rdfs:domain hpc:Job .
hpc:Hashostgroup rdfs:range rdf:List .

hpc:Hascomputeunit rdfs:domain hpc:Job .
hpc:Hascomputeunit rdfs:range rdf:List .
