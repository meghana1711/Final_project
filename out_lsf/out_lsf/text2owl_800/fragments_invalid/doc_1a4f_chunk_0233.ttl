hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Paralleljob ;
    rdfs:comment "Represents a job that runs on multiple hosts." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that runs on the same type of host for performance reasons." .

hpc:blockconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Indicates that all processes of a parallel job must run on hosts with the same resource." .

hpc:queuehostlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of allocated hosts for a job cannot be obtained during scheduling." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "Represents a queue in the job scheduling system." .

hpc:jobforwardingmodel a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates the job forwarding model used by the queue." .

hpc:leasingmodel a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates the leasing model used by the queue." .

hpc:resourcerequirementstring a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource requirement string for a job." .

hpc:joblevelresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirementstring ;
    rdfs:comment "The resource requirement string at the job level." .

hpc:queuelevelresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirementstring ;
    rdfs:comment "The resource requirement string at the queue level." .

hpc:Resource a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "Represents a static resource." .

hpc:resourcerequirementstringsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementstring ;
    rdfs:range xsd:string ;
    rdfs:comment "The syntax of the resource requirement string." .

hpc:blockspanconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementstring ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether 'span[block=value]' and 'span[ptile=value]' can be specified at the same time." .

hpc:hostspanconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementstring ;
    rdfs:range xsd:boolean ;
