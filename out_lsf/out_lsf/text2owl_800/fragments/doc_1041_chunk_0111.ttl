hpc:Clustercommand a owl:Class .
hpc:Hasattributenames rdfs:domain hpc:Clustercommand ;
    rdfs:range rdf:List .
hpc:Hasuser rdfs:domain hpc:Clustercommand ;
    rdfs:range hpc:User .
hpc:Showclusterattributes rdfs:subClassOf hpc:Clustercommand .
hpc:Showclusteraffinity rdfs:subClassOf hpc:Clustercommand .

# Attribute
hpc:Attribute a owl:Class .

# User
hpc:User a owl:Class .

# Host
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .

# Property for showing attributes
hpc:showclusterattributenames a owl:ObjectProperty .
hpc:Showclusterattributenames rdfs:domain hpc:Clustercommand ;
    rdfs:range hpc:Attribute .

# Property for specifying user
hpc:hasuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Clustercommand ;
    rdfs:range hpc:User .

# Property for specifying hosts or host groups
hpc:Showforhosts rdfs:domain hpc:Clustercommand ;
    rdfs:range rdf:List .
hpc:showForHosts rdfs:subPropertyOf hpc:showForHost .
hpc:Showforhost rdfs:domain hpc:Clustercommand ;
    rdfs:range hpc:Host ;
    rdfs:subPropertyOf hpc:showForHostGroup .
hpc:Showforhostgroup rdfs:domain hpc:Clustercommand ;
    rdfs:range hpc:Hostgroup .

# Affinity
hpc:Affinityinformation a owl:Class .
hpc:Showclusteraffinity rdfs:subClassOf hpc:Clustercommand .
