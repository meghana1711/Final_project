hpc:ParentChildQueue
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Queue .

hpc:CrossQueueFairShare
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf hpc:Parentchildqueue ;
    rdfs:subClassOf hpc:Haspriority .

hpc:HasPriority
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:DefaultPriorityRange
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Crossqueuefairshare ;
    rdfs:subClassOf hpc:Haspriority ;
    rdfs:subClassOf hpc:Hasminpriority ;
    rdfs:subClassOf hpc:Hasmaxpriority .

hpc:HasMinPriority
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Defaultpriorityrange ;
    rdfs:range xsd:decimal .

hpc:HasMaxPriority
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Defaultpriorityrange ;
    rdfs:range xsd:decimal .

hpc:OutOfRangePriority
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf hdfs:Not hpc:Crossqueuefairshare ;
    rdfs:subClassOf hdfs:And (
        hdfs:Not ( hdfs:greaterThan ( hpc:HasPriority hpc:CrossQueueFairShare ) xsd:30 ) ;
        hdfs:Not ( hdfs:lessThan ( hpc:HasPriority hpc:CrossQueueFairShare ) xsd:50 )
    ) .

hpc:DispatchOrder
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:FAIRSHARE
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue .

hpc:FAIRSHARE_QUEUES
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdfs:Class .

hpc:RestrictedFAIRSHARE_QUEUES
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf hdfs:Not hpc:Crossqueuefairshare ;
    rdfs:subClassOf hdfs:
