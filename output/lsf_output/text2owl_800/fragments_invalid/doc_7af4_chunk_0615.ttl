hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:Hasresource hpc:objectproperty .
hpc:Hasname hpc:datatypeproperty .
hpc:Hastype hpc:datatypeproperty .
hpc:Hasserver hpc:objectproperty .
hpc:Hasowner hpc:datatypeproperty .
hpc:Hasrexpri hpc:datatypeproperty .
hpc:Exclusiveresource a owl:Class .

hpc:Host rdfs:subClassOf hpc:Resource .
hpc:Exclusiveresource rdfs:subClassOf hpc:Resource .

hpc:Hasresource rdfs:domain hpc:Host .
hpc:Hasname rdfs:domain hpc:Host .
hpc:Hastype rdfs:domain hpc:Host .
hpc:Hasserver rdfs:domain hpc:Host .
hpc:Hasowner rdfs:domain hpc:Host .
hpc:Hasrexpri rdfs:domain hpc:Host .

hpc:Resource rdfs:range xsd:string .
hpc:Exclusiveresource rdfs:range xsd:string .

hpc:Host hpc:hasresource "model" .
hpc:Host hpc:hastype "server" .
hpc:Host hpc:hasname ? .
hpc:Host hpc:hasserver ? .
hpc:Host hpc:hasowner ? .
hpc:Host hpc:hasrexpri ? .

hpc:Exclusiveresource hpc:hasresource "!" .

hostA a hpc:Host ;
    hpc:hasResource "!" ;
    hpc:hasType "" ;
    hpc:hasName "hostA" ;
    hpc:hasServer "" ;
    hpc:hasOwner "user1" ;
    hpc:hasREXPRI "" .

