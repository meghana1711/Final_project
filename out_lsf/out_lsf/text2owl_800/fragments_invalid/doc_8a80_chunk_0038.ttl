hpc:License a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:string .

hpc:allocation a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Allocationdetails .

hpc:Allocationdetails a owl:Class .
hpc:Allocationdetails:cluster1 a owl:Class ;
    rdfs:subClassOf hpc:Allocationdetails .
hpc:Allocationdetails:interactive a owl:Class ;
    rdfs:subClassOf hpc:Allocationdetails .

hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Distributiondetails .

hpc:Distributiondetails a owl:Class .
hpc:Distributiondetails:LicenseServer1 a owl:Class ;
    rdfs:subClassOf hpc:Distributiondetails .

hpc:enableInteractive a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
    rdfs:range xsd:boolean .

hpc:Feature a owl:Class .
hpc:feature:NAME a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature .
    rdfs:range xsd:string .
hpc:feature:DISTRIBUTION a owl:ObjectProperty ;
    rdfs:domain hpc:Feature .
    rdfs:range hpc:Distributiondetails .
hpc:feature:ALLOCATION a owl:ObjectProperty ;
    rdfs:domain hpc:Feature .
    rdfs:range hpc:Allocationdetails .

hpc:Parameters a owl:Class .
hpc:checkoutFromFirstHostOnly a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameters .
    rdfs:range xsd:boolean .

hpc:ApplicationY a hpc:License ;
    hpc:hasName "ApplicationY" ;
    hpc:Allocation (hpc:AllocationDetails:cluster1 6 ;
                     hpc:AllocationDetails:interactive 6) .
hpc:ApplicationZ a hpc:License ;
    hpc:hasName "ApplicationZ" ;
    hpc:Distribution (hpc:DistributionDetails:LicenseServer1 1) ;
    hpc:ALLOCATION (hpc:AllocationDetails:cluster1 0 hpc:AllocationDetails:cluster2 4 ;
                      hpc:AllocationDetails:interactive 8) .
