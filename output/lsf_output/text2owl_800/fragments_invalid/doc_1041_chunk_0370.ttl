hpc:Lsfworkload a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:License a owl:Class .
hpc:Feature a owl:Class .
hpc:Configurationparameter a owl:Class .
hpc:Project a owl:Class .
hpc:Projectgroup a owl:Class .
hpc:TokenName a xsd:string .
hpc:Licensetoken a owl:Class .
hpc:Licenseownership a owl:Class .
hpc:priority a owl:ObjectProperty .
hpc:Hastokenname rdfs:domain hpc:Licensetoken ;
                  rdfs:range xsd:string .
hpc:Hasconfigurationparameter rdfs:domain hpc:Configurationparameter ;
                             rdfs:range hpc:Configurationparameter .
hpc:Hasservicedomain rdfs:domain hpc:Feature ;
                     rdfs:range hpc:Servicedomain .
hpc:Haslsfworkload rdfs:domain hpc:Feature ;
                   rdfs:range hpc:Lsfworkload .
hpc:Haslicense rdfs:domain hpc:Feature ;
                 rdfs:range hpc:License .
hpc:Isconfiguredforlicensing rdfs:subClassOf hpc:Servicedomain ;
                               rdfs:subClassOf hpc:Class .
hpc:Borrowslicensesfrom rdfs:subClassOf hpc:Lsfworkload ;
                               rdfs:subClassOf hpc:Class .
hpc:Islicensedfeature rdfs:subClassOf hpc:Feature ;
                               rdfs:subClassOf hpc:Class .
hpc:Hasproject rdfs:domain hpc:Project ;
                 rdfs:range hpc:Project .
hpc:ismanagedbylsf a owl:ObjectProperty .
hpc:Isassociatedwithconfiguredfeature rdfs:subClassOf hpc:Project ;
                                         rdfs:subClassOf hpc:Project .
hpc:Haspriority rdfs:domain hpc:Projectgroup ;
                 rdfs:range xsd:decimal .
hpc:Haslicensesinpercentage rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Isprojectmodeonly rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Hashierarchicalconfiguration rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Showslicensesownership rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Showsactiveprojects rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Showsprojectpriorities rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
hpc:Showsprojectswithconfiguredfeatures rdfs:subClassOf hpc:Projectgroup ;
                                      rdfs:subClassOf hpc:Projectgroup .
``
