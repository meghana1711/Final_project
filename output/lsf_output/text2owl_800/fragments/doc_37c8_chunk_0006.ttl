hpc:Dockerjob a owl:Class .
hpc:Lsf a owl:Class .
hpc:Dockerhost a owl:Class .
hpc:Dockerservice a owl:Class .
hpc:Dockerresource a owl:Class .
hpc:Dockerenvironment a owl:Class .
hpc:Executioncontext a owl:Class .
hpc:Paralleljob a owl:Class .
hpc:Taskcontainer a owl:Class .
hpc:Jobcontainer a owl:Class .
hpc:Mpienvironment a owl:Class .
hpc:Cgroupdriver a owl:Class .
hpc:Cgroupfs a owl:Class .
hpc:Systemd a owl:Class .
hpc:Gpuresource a owl:Class .
hpc:gpuscheduling a owl:ObjectProperty .
hpc:executiondriver a owl:ObjectProperty .
hpc:Hascgroupdriver rdfs:domain hpc:Dockerhost;
    rdfs:range hpc:Cgroupdriver .
hpc:Hasdockerservice rdfs:domain hpc:Dockerhost;
    rdfs:range hpc:Dockerservice .
hpc:Hasdockerresource rdfs:domain hpc:Dockerhost;
    rdfs:range hpc:Dockerresource .
hpc:Usesdocker rdfs:subClassOf owl:FunctionalProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Dockerhost .
hpc:Setsdockerenvironment rdfs:subClassOf owl:FunctionalProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Dockerenvironment .
hpc:Launchescontainers rdfs:subClassOf owl:FunctionalProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Container .
hpc:Hasexecutioncontext rdfs:domain hpc:Container;
    rdfs:range hpc:Executioncontext .
hpc:Hasmpienvironment rdfs:domain hpc:Image;
    rdfs:range hpc:Mpienvironment .
