hpc:Limit a owl:Class .
hpc:haslimitunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:enforcedbyos a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Operatingsystem .
hpc:hascpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:duration .
hpc:enforcedbyjobmanager a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Jobmanager .
hpc:hassigxcpu a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:integer .
hpc:hassigint a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:integer .
hpc:hassigterm a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:integer .
hpc:hassigkill a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:integer .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Operatingsystem a owl:Class .
hpc:Jobmanager a owl:Class .
