hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Cluster a owl:Class .
hpc:Token a owl:Class .
hpc:hasrusage a owl:ObjectProperty .
hpc:hasinuse a owl:ObjectProperty .
hpc:belongsto a owl:ObjectProperty .
hpc:usestoken a owl:ObjectProperty .
hpc:requestedby a owl:ObjectProperty .
hpc:runningon a owl:ObjectProperty .
hpc:longformat a owl:ObjectProperty .
hpc:checksoutlicensesexcessively a owl:ObjectProperty .
hpc:detailedlicenseresourcerequestinformation a owl:ObjectProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:username a owl:DatatypeProperty .
hpc:hostname a owl:DatatypeProperty .
hpc:clustername a owl:DatatypeProperty .
hpc:tokenname a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Token rdfs:subClassOf owl:Class .

hpc:Hasrusage rdfs:domain hpc:Job ;
                      rdfs:range xsd:string .
hpc:Hasinuse rdfs:domain hpc:Token ;
                      rdfs:range xsd:boolean .
hpc:Belongsto rdfs:domain hpc:Job ;
                      rdfs:range hpc:User .
hpc:Usestoken rdfs:domain hpc:Token ;
                      rdfs:range hpc:Job .
hpc:Requestedby rdfs:domain hpc:Job ;
                      rdfs:range hpc:User .
hpc:Runningon rdfs:domain hpc:Job ;
                      rdfs:range hpc:Host .
hpc:Longformat rdfs:domain hpc:Job .
hpc:Checksoutlicensesexcessively rdfs:domain hpc:Job .
hpc:Detailedlicenseresourcerequestinformation rdfs:domain hpc:Job .

hpc:Jobid rdfs:range xsd:string .
hpc:Username rdfs:range xsd:string .
hpc:Hostname rdfs:range xsd:string .
hpc:Clustername rdfs:range xsd:string .
hpc:Tokenname rdfs:range xsd:string .
