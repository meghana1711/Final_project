hpc:EBROKERD_HOST_CLEAN_DELAY
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "After configuring this parameter, run badmin mbdrestart on the management host to restart ebrokerd. After configuring this parameter, run bctrld restart lim on the management host and, if any of the specified host names is not the management host name, lsadmin limrestart host_name." .

hpc:LSB_RC_DEFAULT_HOST_TYPE
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the default host type to use for a template if the type attribute is not defined on a template in the template configuration files." .

hpc:LSB_RC_EXTERNAL_HOST_ABNORMAL_TIME
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:string ;
    rdfs:comment "Allows the LSF resource connector to control the number of minutes that LSF waits before timing out resource connector hosts that are in an abnormal status (that is, closed_LIM, unavail, or unreach status)." .

hpc:LSB_RC_EXTERNAL_HOST_FLAG
    a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Setting the LSB_RC_EXTERNAL_HOST_FLAG parameter enables the LSF resource connector feature." .
