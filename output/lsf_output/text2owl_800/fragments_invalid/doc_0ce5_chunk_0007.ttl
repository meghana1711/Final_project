hpc:Host a owl:Class .
hpc:isOk an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:isBusy an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:pagingRate an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:cpuUtilization an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:runqueuelengths a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:status an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Hosttype a owl:Class .
hpc:Hpux a rdfs:subClassOf hpc:Hosttype .
hpc:Linux a rdfs:subClassOf hpc:Hosttype .
hpc:Aix a rdfs:subClassOf hpc:Hosttype .
hpc:Solaris a rdfs:subClassOf hpc:Hosttype .
