hpc:Estimator a owl:Class .
hpc:estimatorSimStartInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:integer .
hpc:ESTIMATOR_SIM_START_INTERVAL a hpc:Estimator_SIM_Start_Interval ;
    rdf:value "10080"^^xsd:integer .
hpc:lsbEnableEstimation a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:boolean .
hpc:ESTIMATOR_MAX_JOBS_PREDICTION a xsd:integer .
hpc:ESTIMATOR_MAX_RUNTIME_PREDICTION a xsd:integer .
hpc:ESTIMATOR_MAX_TIME_PREDICTION a xsd:integer .
