hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Reservation a owl:Class .
hpc:User a owl:Class .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Host .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .
hpc:hasTimeWindow rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:Islocal hpc:Host a owl:Class .
hpc:Isremote hpc:Host a owl:Class .
hpc:isCreatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .
hpc:canDelete rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Reservation .
hpc:Administrator rdf:type owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:hasSubgroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Hostgroup .
hpc:isExcluded rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Host .
