@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Servicedomain a owl:Class.
hpc:haslicenseservername a owl:DatatypeProperty;
    rdfs:domain hpc:Servicedomain;
    rdfs:range xsd:string.
hpc:haslicenseserverport a owl:DatatypeProperty;
    rdfs:domain hpc:Servicedomain;
    rdfs:range xsd:integer.

hpc:Job a owl:Class.
hpc:ismanagedbylicensescheduler a owl:ObjectProperty;
    rdfs:domain hpc:Job.

hpc:Licensetoken a owl:Class.
hpc:
