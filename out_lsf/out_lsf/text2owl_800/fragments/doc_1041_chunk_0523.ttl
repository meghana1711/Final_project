                   rdfs:domain hpc:Reservation .
hpc:nosuspn       a owl:ObjectProperty ;
                   rdfs:domain hpc:Reservation .
hpc:open          a owl:ObjectProperty ;
                   rdfs:domain hpc:Reservation .
hpc:closed        a owl:ObjectProperty ;
                   rdfs:domain hpc:Reservation .
hpc:on            a owl:ObjectProperty ;
                   rdfs:domain hpc:Reservation .
