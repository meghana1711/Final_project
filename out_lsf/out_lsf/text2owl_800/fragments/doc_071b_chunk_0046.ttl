hpc:Hostcontroladmin a owl:Class .
hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostcontroladmin ;
    rdfs:range xsd:string .

hpc:Lockid a owl:Class .
hpc:removelock a owl:ObjectProperty ;
    rdfs:domain hpc:Hostcontroladmin ;
    rdfs:range hpc:Lockid .

hpc:Host a owl:Class .
hpc:closedhost a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:Osconfiglock a owl:Class ;
    rdfs:subClassOf hpc:Lockid .
hpc:Appupdatelock a owl:Class ;
    rdfs:subClassOf hpc:Lockid .

hpc:localclustereventsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostcontroladmin ;
    rdfs:range xsd:string .

hpc:battach a owl:ObjectProperty .
