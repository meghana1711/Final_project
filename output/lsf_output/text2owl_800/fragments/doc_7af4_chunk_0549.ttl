hpc:Guaranteedresourcepool a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range rdfs:Class .
hpc:hosts a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool .
hpc:resSelect a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool .
hpc:loanPolicies a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:administrators a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool .
hpc:Package a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:slotsPerPackage a owl:DatatypeProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:nonNegativeInteger .
hpc:memPerPackage a owl:DatatypeProperty ;
    rdfs:domain hpc:Package ;
    rdfs:range xsd:nonNegativeInteger .
