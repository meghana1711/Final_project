    hpc:hasTask 1-18 ;
    hpc:allocationMethod hpc:CyclicDistribution ;
    hpc:distributionMethod "cyclic:block" ;
    hpc:cpuBind "cores" ;
    hpc:ntasks 18 ;
    hpc:ntasksPerNode 6 ;
