hpc:Hostpartition a owl:Class .
hpc:Host a owl:Class .
hpc:Fcfsschedulingpolicy a owl:Class .
hpc:Fairshareschedulingpolicy a owl:Class .
hpc:hasHostPartition an owl:ObjectProperty .
hpc:hasSchedulingPolicy an owl:ObjectProperty .
hpc:Hostpartition rdfs:subClassOf hpc:Partition .
hpc:Fcfsschedulingpolicy rdfs:subClassOf hpc:Schedulingpolicy .
hpc:Fairshareschedulingpolicy rdfs:subClassOf hpc:Schedulingpolicy .
hpc:Hashostpartition rdfs:domain hpc:Host .
hpc:Hasschedulingpolicy rdfs:domain hpc:Hostpartition .
hpc:all rdf:type hpc:HostPartition .
hpc:all rdfs:comment "Applies to all hosts in a cluster." .
hpc:Hasschedulingpolicy hpc:all rdf:value hpc:FCFSSchedulingPolicy .

hpc:notoperator a owl:ObjectProperty .
hpc:Notoperator rdfs:domain hpc:Hostpartition .
hpc:Notoperator rdfs:range rdf:Resource .

hpc:Hostgroup a owl:Class .
hpc:hasHostGroup an owl:ObjectProperty .
hpc:Hashostgroup rdfs:domain hpc:Hostpartition .
hpc:Hashostgroup rdfs:range hpc:Hostgroup .

hpc:Usershares a owl:Class .
hpc:Usershareassignment a owl:Class .
hpc:userShareAssignment rdf:type owl:DatatypeProperty .
hpc:Usershareassignment rdfs:domain hpc:Usershares .
hpc:Usershareassignment rdfs:range xsd:integer .
hpc:Usershares rdfs:subClassOf rdf:List .
hpc:UserShares rdfs:comment "Specifies user share assignments." .

hpc:User a owl:Class .
hpc:Windowsuseraccount a owl:Class .
hpc:Group a owl:Class .
hpc:hasuser a owl:ObjectProperty .
hpc:hasWindowsUserAccount an owl:ObjectProperty .
hpc:hasGroup an owl:ObjectProperty .
hpc:Hasuser rdfs:domain hpc:Usershareassignment .
hpc:Haswindowsuseraccount rdfs:domain hpc:Usershareassignment .
hpc:Hasgroup rdfs:domain hpc:Usershareassignment .
hpc:Hasuser rdfs:range hpc:User .
hpc:Haswindowsuseraccount rdfs:range hpc:Windowsuseraccount .
hpc:Hasgroup rdfs:range hpc:Group .
