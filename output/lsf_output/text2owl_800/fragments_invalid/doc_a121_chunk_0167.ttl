hpc:Esub a owl:Class .
hpc:Eexec a owl:Class .
hpc:Epsub a owl:Class .

hpc:hasjobsubmissioncontrols a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Jobsubmissioncontrols .

hpc:Jobsubmissioncontrols a owl:Class .

hpc:hasesub a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissioncontrols .
    rdfs:range hpc:Esub .

hpc:hasepsub a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissioncontrols .
    rdfs:range hpc:Epsub .

hpc:haseexec a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissioncontrols .
    rdfs:range hpc:Eexec .

hpc:Esubarguments a owl:Class .
hpc:Epsubarguments a owl:Class .

hpc:esubargument a owl:DatatypeProperty ;
    rdfs:domain hpc:Esub .
    rdfs:range xsd:string .

hpc:epsubargument a owl:DatatypeProperty ;
    rdfs:domain hpc:Epsub .
    rdfs:range xsd:string .

hpc:Joboptions a owl:Class .

hpc:joboption a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:jobrequiresresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:jobqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:string .
