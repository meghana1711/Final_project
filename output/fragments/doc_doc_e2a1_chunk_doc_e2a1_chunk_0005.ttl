hpc:SlurmDaemon a owl:Class .
hpc:Slurmctld a hpc:SlurmDaemon .
hpc:Slurmdbd a hpc:SlurmDaemon .
hpc:Slurmd a hpc:SlurmDaemon .

hpc:CommunicationParameters a owl:ObjectProperty .

hpc:IPv4Address a xsd:string .
hpc:IPv6Address a xsd:string .

hpc:SlurmDaemon hasIPv4Address rdfs:domain hpc:SlurmDaemon ;
 hpc:SlurmDaemon hasIPv6Address rdfs:domain hpc:SlurmDaemon ;
 hpc:CommunicationParameters hasEnableIPv6 rdfs:range xsd:boolean ;
 hpc:CommunicationParameters hasDisableIPv4 rdfs:range xsd:boolean .

hpc:SlurmDaemon communicatesWith rdf:Type owl:ObjectProperty ;
 hpc:SlurmDaemon communicatesWith rdfs:domain hpc:SlurmDaemon ;
 hpc:SlurmDaemon communicatesWith rdfs:range hpc:SlurmDaemon .

hpc:SlurmDaemon hasValidIPAddress rdfs:domain hpc:SlurmDaemon ;
 hpc:SlurmDaemon hasValidIPAddress rdfs:range (hpc:IPv4Address or hpc:IPv6Address) .

hpc:Slurmctld expectsSingleIPAddress rdfs:subClassOf hpc:SlurmDaemon ;
 hpc:Slurmctld expectsSingleIPAddress rdfs:domain hpc:Slurmctld .

hpc:Node mapsToIPAddress rdfs:subClassOf hpc:SlurmDaemon ;
 hpc:Node mapsToIPAddress rdfs:domain hpc:Node .

hpc:Node hasIPAddress rdfs:domain hpc:Node ;
 hpc:Node hasIPAddress rdfs:range (hpc:IPv4Address or hpc:IPv6Address) .

hpc:getaddrinfo returnsIPAddress rdfs:subClassOf hpc:Node .

hpc:gaiConf hasPrecedence rdfs:domain xsd:string ;
 hpc:gaiConf hasPrecedence rdfs:range xsd:integer .

hpc:scontrolSetDebugFlags enablesNetworkDebugLogging rdfs:subClassOf hpc:Slurmctld .

hpc:loopbackInterface resolvesTo rdfs:domain xsd:string ;
 hpc:loopbackInterface resolvesTo rdfs:range "127.0.0.1" .
```
