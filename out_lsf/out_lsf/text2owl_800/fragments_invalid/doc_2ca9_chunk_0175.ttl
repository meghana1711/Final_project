hpc:Job a owl:Class .
hpc:Jobrejectionreason a owl:Class .
hpc:CompoundRequirement a hpc:JobRejectionReason .
hpc:AlternativeRequirement a hpc:JobRejectionReason .
hpc:CuExcl a hpc:JobRejectionReason .
hpc:CuBalance a hpc:JobRejectionReason .

hpc:Jobsubmission a owl:Class .
hpc:Epsub a hpc:JobSubmission .
hpc:Esub a hpc:JobSubmission .

hpc:Jobinformation a owl:Class .
hpc:postjobinformation a owl:ObjectProperty .
hpc:Postjobinformation rdfs:domain hpc:Jobsubmission ;
                          rdfs:range hpc:Jobinformation .

hpc:Locallogfile a owl:Class .
hpc:performgenerallogic a owl:ObjectProperty .
hpc:Performgenerallogic rdfs:domain hpc:Jobsubmission ;
                          rdfs:range hpc:Locallogfile .

hpc:Submissionhost a owl:Class .
hpc:runafterjobsubmission a owl:ObjectProperty .
hpc:Runafterjobsubmission rdfs:domain hpc:Submissionhost ;
                            rdfs:range hpc:Jobsubmission .

hpc:Interactivejob a owl:Class .
hpc:resumeinteractivejobbehavior a owl:ObjectProperty .
hpc:Resumeinteractivejobbehavior rdfs:domain hpc:Interactivejob ;
                                   rdfs:range hpc:Jobsubmission .

hpc:Temporaryfile a owl:Class .
hpc:containsjobsubmissionoptions a owl:DatatypeProperty .
hpc:Containsjobsubmissionoptions rdfs:domain hpc:Temporaryfile ;
                                    rdfs:range xsd:string .

hpc:lsbSubParmFile a owl:DatatypeProperty .
hpc:LsbSubParmFile rdfs:domain hpc:Submissionhost ;
                        rdfs:range xsd:string .

hpc:lsbSubJobId a owl:DatatypeProperty .
hpc:LsbSubJobId rdfs:domain hpc:Submissionhost ;
                   rdfs:range xsd:string .

hpc:jobarrayindex a owl:DatatypeProperty .
hpc:Jobarrayindex rdfs:domain hpc:LsbSubJobId ;
                   rdfs:range xsd:nonNegativeInteger .

hpc:finalqueue a owl:DatatypeProperty .
hpc:Finalqueue rdfs:domain hpc:LsbSubJobId ;
                 rdfs:range xsd:string .

hpc:lsbSubJobQueue a owl:DatatypeProperty .
hpc:LsbSubJobQueue rdfs:domain hpc:Submissionhost ;
                       rdfs:range xsd:string .

hpc:lsbSubJobErr a owl:DatatypeProperty .
hpc:LsbSubJobErr rdfs:domain hpc:Lsb
