hpc:Serviceclass a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:integer .
hpc:goals a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range rdf:List .
hpc:Goals rdfs:subPropertyOf hpc:Property .
hpc:violationperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Controlaction ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Controlaction ;
    rdfs:range xsd:string .
hpc:usergroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .
hpc:Controlaction a owl:Class .
hpc:Controlaction rdfs:subClassOf hpc:Property .
