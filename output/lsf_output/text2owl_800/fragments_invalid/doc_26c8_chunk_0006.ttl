hpc:Lsfresourceconnector a owl:Class .
hpc:hasrchosts a owl:ObjectProperty .
hpc:rchosts a owl:DatatypeProperty .
hpc:Rchosts rdfs:domain hpc:Lsfresourceconnector ;
                        rdfs:range xsd:string .
hpc:LsbRcExternalHostFlag a owl:Class .
hpc:Hostresource a owl:Class .
hpc:isborrowedhost a owl:ObjectProperty .
hpc:Isborrowedhost rdfs:domain hpc:Lsfresourceconnector ;
                        rdfs:range hpc:Hostresource .
hpc:RC_HOSTS_Default a owl:NamedIndividual ;
                      hpc:hasRCHosts none ;
                      rdf:type hpc:LSFResourceConnector .
hpc:none_Default a owl:NamedIndividual ;
                 rdf:type hpc:RC_HOSTS_Default .
