hpc:Preexecutionscript a owl:Class .
hpc:Lsfjob a owl:Class .
hpc:Preexecfailedreason a owl:Class .
hpc:PreExecFailedReason_NFSBusy a hpc:PreExecFailedReason ;
    rdfs:subClassOf hpc:Preexecfailedreason .
hpc:preexecexcludehostexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutionscript ;
    rdfs:range xsd:integer .
hpc:maxpreexecretry a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:preexecexcludehostexitvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first hpc:Preexecexcludehostexitvalue ;
    rdfs:range rdf:rest rdf:nil .
hpc:preexecretry a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionscript ;
    rdfs:range hpc:Preexecretrystep .
hpc:Preexecretrystep a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
hpc:PreExecRetryStep_Retry a hpc:PreExecRetryStep ;
    rdfs:subPropertyOf hpc:PreExecRetry .
hpc:PreExecRetryStep_Decrement a hpc:PreExecRetryStep ;
    rdfs:subPropertyOf hpc:PreExecRetry .
hpc:PreExecRetryStep_ExitCheck a hpc:PreExecRetryStep ;
    rdfs:subPropertyOf hpc:PreExecRetry .
hpc:preexecretrystepExitcheckExitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:PreexecretrystepExitcheck ;
    rdfs:range xsd:integer .
hpc:preexecretrystepExitcheckRetryremaining a owl:DatatypeProperty ;
    rdfs:domain hpc:PreexecretrystepExitcheck ;
    rdfs:range xsd:nonNegativeInteger .
