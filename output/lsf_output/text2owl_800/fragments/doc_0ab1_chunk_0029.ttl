hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf owl:Thing .

hpc:hasgpuresourcerequirement a owl:ObjectProperty .
hpc:Hasgpuresourcerequirement rdfs:domain hpc:Job .

hpc:Gpuresourcerequirement a owl:Class .
hpc:Gpuresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .

hpc:span a owl:ObjectProperty .
hpc:Span rdfs:domain hpc:Gpuresourcerequirement .
hpc:Span rdfs:range hpc:Span .

hpc:gtile a owl:DatatypeProperty .
hpc:Gtile rdfs:domain hpc:Span .
hpc:Gtile rdfs:range xsd:nonNegativeInteger .

hpc:rusage a owl:ObjectProperty .
hpc:Rusage rdfs:domain hpc:Gpuresourcerequirement .
hpc:Rusage rdfs:range hpc:Rusage .

hpc:ngpusPhysical a owl:DatatypeProperty .
hpc:NgpusPhysical rdfs:domain hpc:Rusage .
hpc:NgpusPhysical rdfs:range xsd:nonNegativeInteger .

hpc:gmodel a owl:DatatypeProperty .
hpc:Gmodel rdfs:domain hpc:Rusage .
hpc:Gmodel rdfs:range xsd:string .

hpc:memSize a owl:DatatypeProperty .
hpc:MemSize rdfs:domain hpc:Gmodel .
hpc:MemSize rdfs:range xsd:nonNegativeInteger .

hpc:gmem a owl:DatatypeProperty .
hpc:Gmem rdfs:domain hpc:Rusage .
hpc:Gmem rdfs:range xsd:nonNegativeInteger .

hpc:glink a owl:DatatypeProperty .
hpc:Glink rdfs:domain hpc:Rusage .
hpc:Glink rdfs:range xsd:boolean .

hpc:SpanGtile a owl:Class .
hpc:SpanGtile rdfs:subClassOf hpc:Span .

hpc:ptile a owl:DatatypeProperty .
hpc:Ptile rdfs:domain hpc:SpanGtile .
hpc:Ptile rdfs:range xsd:nonNegativeInteger .

hpc:gtileNot a owl:DatatypeProperty .
hpc:GtileNot rdfs:domain hpc:SpanGtile .
hpc:GtileNot rdfs:range xsd:boolean .
