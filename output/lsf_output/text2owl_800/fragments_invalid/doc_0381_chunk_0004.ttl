hpc:Lsfhost a owl:Class .
hpc:hasType rdf:Property ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:hasModel rdf:Property ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:hasResource rdf:Property ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:string .
hpc:hasCpuFactor rdf:Property ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:float .
hpc:isInCluster rdf:Property ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Lsfcluster .
hpc:Lsfcluster a owl:Class .
hpc:lshosts rdf:Property ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Lsfhost .
hpc:lsload rdf:Property ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Lsfhost .
hpc:lshosts a owl:ObjectProperty .
hpc:lsload a owl:ObjectProperty .
hpc:lsrun a owl:ObjectProperty .
hpc:lsgrun a owl:ObjectProperty .
hpc:requiresPassword rdf:Property ;
    rdfs:domain hpc:Command .
hpc:Command a owl:Class .
hpc:hasHosts rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List .
hpc:hasCommand rdf:Property ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:CommandList rdf:Class .
hpc:Commandlist a owl:Class .
hpc:hasCommand rdf:Property ;
    rdfs:domain hpc:Commandlist ;
    rdfs:range hpc:Command .
