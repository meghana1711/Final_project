hpc:Host a owl:Class .
hpc:Powerpolicy a owl:Class .
hpc:onstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:suspendedstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:intermediatestate a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:powerpolicyhashost a owl:ObjectProperty ;
    rdfs:domain hpc:Powerpolicy ;
    rdfs:range hpc:Host .
hpc:hasonstate a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Onstate .
hpc:hassuspendedstate a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Suspendedstate .
hpc:hasintermediatestate a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Intermediatestate .
hpc:powerpolicyenabled a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Powerpolicy .
hpc:powerstatedisplayedbybhosts a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:Powerpolicy .
hpc:Powerstateunknownsubclassof hpc:Host a owl:Class .
hpc:Powerstateonsubclassof hpc:Host a owl:Class .
hpc:Powerstatesuspendedsubclassof hpc:Host a owl:Class .
hpc:Powerstateintermediatesubclassof hpc:Host a owl:Class .
