hpc:LsbGetallocfunction a owl:Class .
hpc:blaunchcommand a owl:ObjectProperty .
hpc:jobenvironment a owl:ObjectProperty .
hpc:Jobresagent a owl:Class .
hpc:jobid a owl:DatatypeProperty .
hpc:jobindex a owl:DatatypeProperty .
hpc:jobmcpuhosts a owl:DatatypeProperty .
hpc:jobresregistration a owl:ObjectProperty .
hpc:jobsubmissionscript a owl:DatatypeProperty .
hpc:sanitycheck a owl:ObjectProperty .
hpc:tasklaunch a owl:ObjectProperty .
hpc:validationrequest a owl:ObjectProperty .

hpc:LsbGetallocfunction rdfs:subClassOf owl:TopObject .
hpc:Blaunchcommand rdfs:domain hpc:LsbGetallocfunction ;
    rdfs:range rdf:String .
hpc:Jobenvironment rdfs:domain hpc:LsbGetallocfunction ;
    rdfs:range rdf:List .
hpc:Jobresagent rdfs:subClassOf owl:TopObject .
hpc:Jobid rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobindex rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Jobmcpuhosts rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Jobresregistration rdfs:domain hpc:Jobresagent ;
    rdfs:range rdf:Resource .
hpc:Jobsubmissionscript rdfs:domain hpc:Jobsubmissionscript ;
    rdfs:range rdf:String .
hpc:Sanitycheck rdfs:domain hpc:Blaunchcommand ;
    rdfs:range rdf:Boolean .
hpc:Tasklaunch rdfs:domain hpc:Blaunchcommand ;
    rdfs:range rdf:Resource .
hpc:Validationrequest rdfs:domain hpc:Blaunchcommand ;
    rdfs:range rdf:Resource .
