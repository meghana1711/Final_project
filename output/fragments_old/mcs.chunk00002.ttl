hpc:MCS a owl:Class .
hpc:MCSPlugin a owl:ObjectProperty .
hpc:MCSParameters a owl:ObjectProperty .
hpc:mcsLabel a owl:Class .
hpc:hasMCSParameters rdfs:domain hpc:MCS ;
                      rdfs:range rdf:List .
hpc:hasMCSPlugin rdfs:domain hpc:MCS .
hpc:hasMCSLabel rdfs:domain hpc:Job .

hpc:Job a owl:Class .
hpc:hasExclusive rdfs:domain hpc:Job ;
                 rdfs:range xsd:boolean .

hpc:Account a owl:Class .
hpc:hasAccount rdfs:domain hpc:Job .

hpc:Group a owl:Class .
hpc:hasGroup rdfs:domain hpc:Job .

hpc:Label a owl:Class .

hpc:Command a owl:Class .
hpc:runs rdfs:domain hpc:Command ;
          rdfs:range hpc:Job .
```
