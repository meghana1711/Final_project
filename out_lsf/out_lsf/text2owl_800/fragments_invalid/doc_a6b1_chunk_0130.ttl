hpc:Lsf a owl:Class .
hpc:Ego a owl:Class .

hpc:LSF_conf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:File .

hpc:EGO_conf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range hpc:File .

hpc:LSF_parameter rdf:type owl:Class .
hpc:EGO_parameter rdf:type owl:Class .

hpc:hasChangedInLSF_10 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfParameter ;
    rdfs:range xsd:boolean .

hpc:defaultPortChanged rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfParameter ;
    rdfs:range xsd:integer .

hpc:specialResourceGroup rdf:type owl:Class .
hpc:manageDaemonsThroughEGO rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Boolean .

hpc:setCommandLineEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Action .

hpc:LSF_API_CONNTIMEOUT rdf:type hpc:LSF_parameter ;
    hpc:egoConfParameter rdf:resource hpc:EGO_LIM_CONNTIMEOUT .

hpc:LSF_API_RECVTIMEOUT rdf:type hpc:LSF_parameter ;
    hpc:egoConfParameter rdf:resource hpc:EGO_LIM_RECVTIMEOUT .

hpc:LSF_CLUSTER_ID rdf:type hpc:LSF_parameter ;
    rdf:type rdf:Property ;
    rdfs:subPropertyOf hpc:hasWindowsID ;
    hpc:egoConfParameter rdf:resource hpc:EGO_CLUSTER_ID .

hpc:EGO_LIM_CONNTIMEOUT rdf:type hpc:EGO_parameter .
hpc:EGO_LIM_RECVTIMEOUT rdf:type hpc:EGO_parameter .
hpc:EGO_CLUSTER_ID rdf:type hpc:EGO_parameter .

hpc:defaultPorts rdf:type owl:Class .
hpc:limDefaultPort rdf:type hpc:defaultPorts ;
    hpc:basePort rdf:resource hpc:7869 .
hpc:pemDefaultPort rdf:type hpc:defaultPorts ;
    rdfs:subClassOf hpc:Limdefaultport .
hpc:vemkdDefaultPort rdf:type hpc:defaultPorts ;
    rdfs:subClassOf hpc:Limdefaultport .
hpc:egoscDefaultPort rdf:type hpc:defaultPorts ;
    rdfs:subClassOf hpc:Limdefaultport .

hpc:resDefaultPort rdf:type hpc:defaultPorts ;
    rdfs:subClassOf hpc:Defaultports ;
