hpc:Job
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:JobID
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for a job." .

hpc:JobScriptFile
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file path of the job script." .

hpc:CanSpecifyEnvOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates whether the job can specify the -env option." .

hpc:CanSpecifyScriptOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates whether the job can specify the -script option." .

hpc:CannotSpecifyOtherOptionsWithEnvOrScript
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates that the job cannot specify any other bjobs options with the -env or -script options." .

hpc:CannotSpecifyMultipleJobIDs
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates that the -env and -script command options only support a single job ID or job array element." .
