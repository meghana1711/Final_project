hpc:Forcemode a owl:Class ;
    rdfs:comment "Continues to shut down daemons even if an error is encountered. -pdsh" .

hpc:Parallelremoteexecution a owl:Class ;
    rdfs:comment "Enable parallel remote command execution with the PDSH tool. The PDSH tool is required on management hosts and management candidates." .

hpc:pdshtool a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelremoteexecution ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The PDSH tool is required on management hosts and management candidates." .

hpc:chunksize a owl:DatatypeProperty ;
    rdfs:domain hpc:Parallelremoteexecution ;
    rdfs:range xsd:integer ;
    rdfs:comment "The chunk size is 400 hosts." .

hpc:commandusage a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelremoteexecution ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Prints command usage to stderr and exits." .

hpc:lsfreleaseversion a owl:ObjectProperty ;
    rdfs:domain hpc:Parallelremoteexecution ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Prints LSF release version to stderr and exits." .

hpc:pdshrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Forcemode ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The PDSH tool is required on management hosts and management candidates." .

hpc:startupcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Forcemode ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Starts the LIM, RES, and sbatchd daemons on all hosts in the cluster." .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Startupcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Synopsis" .

hpc:delay a owl:DatatypeProperty ;
    rdfs:domain hpc:Startupcommand ;
    rdfs:range xsd:integer ;
    rdfs:comment "The delay between starting daemons in seconds" .

hpc:numhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Startupcommand ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of hosts to start daemons on" .

hpc:confirmationprompt a owl:DatatypeProperty ;
    rdfs:domain hpc:Startupcommand ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Prompts for confirmation of the next operation if an error is encountered" .

hpc:liveconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Startupcommand ;
    rdfs:range rdf:Resource ;
    rdfs:comment "When live configuration with the bconf command is enabled (the LSF_LIVE_CONFDIR parameter is defined in the lsf.conf file), the lsfstartup command uses configuration files that are
