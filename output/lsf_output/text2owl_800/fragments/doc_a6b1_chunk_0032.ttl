hpc:Eventreceiver a owl:Class .
hpc:LSF_EVENT_PROGRAM rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Eventreceiver ;
    rdfs:range xsd:string .

hpc:Event a owl:Class .
hpc:eventNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Event .

hpc:Eventtype a owl:Class ;
    rdfs:subClassOf hpc:Event .
hpc:LIM_Goes_Down rdf:type hpc:EventType .
hpc:RS_Goes_Down rdf:type hpc:EventType .
hpc:sbatchd_Goes_Down rdf:type hpc:EventType .
hpc:Host_Becomes_New_Management_Host rdf:type hpc:EventType .
hpc:Management_Host_Stops_Being_Management_Host rdf:type hpc:EventType .
hpc:mbatchd_Comes_Up_Ready rdf:type hpc:EventType .

hpc:Host a owl:Class .
