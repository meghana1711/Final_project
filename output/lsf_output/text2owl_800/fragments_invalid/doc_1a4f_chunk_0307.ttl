hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Queuedispatchwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .

hpc:Hostdispatchwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .

hpc:hasTimeWindow an owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Queuedispatchwindow, hpc:Hostdispatchwindow .

hpc:isOpen an owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:boolean .

hpc:isConsistentTimeZone an owl:ObjectProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:boolean .

hpc:Queue can have (rdfs:subPropertyOf hpc:hasTimeWindow) hpc:hasQueueDispatchWindow .
hpc:Host can have (rdfs:subPropertyOf hpc:hasTimeWindow) hpc:hasHostDispatchWindow .

hpc:QueueDispatchWindow can accept (rdfs:subPropertyOf hpc:isOpen) hpc:canDispatchJobs .
hpc:HostDispatchWindow can start (rdfs:subPropertyOf hpc:isOpen) hpc:canAcceptJobs .

hpc:Queue can submit (rdfs:subPropertyOf hpc:hasTimeWindow) hpc:canSubmitJobs .
