hpc:Job a owl:Class .
hpc:Job rdfs:subClassOf rdf:Resource .

hpc:Genericresource a owl:Class .
hpc:GPU a hpc:GenericResource .

hpc:gresoption a owl:ObjectProperty .
hpc:Hasgresoption rdfs:domain hpc:Job .
hpc:Hasgresoption rdfs:range hpc:Gresoption .

hpc:gresrequirement a owl:DatatypeProperty .
hpc:Requiresgres rdfs:domain hpc:Gresoption .
hpc:Requiresgres rdfs:range xsd:string .

hpc:Grestype a owl:Class .
hpc:Grestype rdfs:subClassOf rdf:Resource .

hpc:typedgresrequirement a owl:ObjectProperty .
hpc:Requirestypedgres rdfs:domain hpc:Gresoption .
hpc:Requirestypedgres rdfs:range hpc:Typedgresrequirement .

hpc:typedgresrequirementtype a owl:DatatypeProperty .
hpc:Requirestypedgrestype rdfs:domain hpc:Typedgresrequirement .
hpc:Requirestypedgrestype rdfs:range xsd:string .

hpc:grescount a owl:DatatypeProperty .
hpc:Count rdfs:domain hpc:Gresrequirement .
hpc:Count rdfs:range xsd:nonNegativeInteger .

hpc:typedgrescount a owl:DatatypeProperty .
hpc:Typedcount rdfs:domain hpc:Typedgresrequirement .
hpc:Typedcount rdfs:range xsd:nonNegativeInteger .

hpc:consistentgresrequirement a owl:ObjectProperty .
hpc:Hasconsistentgresrequirement rdfs:domain hpc:Job .
hpc:Hasconsistentgresrequirement rdfs:range hpc:Gresrequirement .

hpc:consistenttypedgresrequirement a owl:ObjectProperty .
hpc:Hasconsistenttypedgresrequirement rdfs:domain hpc:Job .
hpc:Hasconsistenttypedgresrequirement rdfs:range hpc:Typedgresrequirement .
