hpc:Computeunittype a owl:Class .
hpc:Enclosure a hpc:ComputeUnitType .
hpc:Resizablejob a owl:Class .
hpc:balancedallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Computeunit .
hpc:usablecuslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:integer .
hpc:maxcus a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:integer .
hpc:groupedallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Computeunit .
hpc:Slotgroup a owl:Class ;
    rdfs:subClassOf hpc:Computeunit .
hpc:Affinity a owl:Class .
hpc:putype a owl:DatatypeProperty ;
    rdfs:domain hpc:Affinity ;
    rdfs:range xsd:string .
hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:Affinity ;
    rdfs:range xsd:integer .
hpc:cpubind a owl:DatatypeProperty ;
    rdfs:domain hpc:Affinity ;
    rdfs:range xsd:string .
