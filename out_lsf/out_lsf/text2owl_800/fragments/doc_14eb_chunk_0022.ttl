hpc:Managementhost a owl:Class .
hpc:Computehost a owl:Class .
hpc:workloadmanagementservice a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Workloadmanagementservice .
hpc:clustermanagementservice a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Clustermanagementservice .
hpc:Dataloader a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .
hpc:Datapurger a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .
hpc:Sessionmanagerhost a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .
hpc:Managementcandidatehost a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .
hpc:operatingsystem a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:string .
hpc:resourcedistributionplan a owl:ObjectProperty .
hpc:Slot a owl:Class .
hpc:Host a owl:Class .
hpc:Lsf a owl:Class .
hpc:Ego a owl:Class .
hpc:resourcemanager a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range rdf:List .
hpc:Resource a owl:Class .
hpc:slotnumber a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
