hpc:Makecommand a owl:Class .
hpc:hasretries a owl:DatatypeProperty ;
    rdfs:domain hpc:Makecommand ;
    rdfs:range xsd:nonNegativeInteger .
hpc:retryinterval a owl:ObjectProperty ;
    rdfs:domain hpc:Makecommand ;
    rdfs:range xsd:nonNegativeDuration .
hpc:DefaultRetryInterval a xsd:duration ;
    hpc:DefaultRetryInterval "P1S"^^xsd:duration .
hpc:BufferTime a xsd:duration ;
    rdfs:range xsd:duration .
hpc:Makeoption a owl:Class .
hpc:ignoredforcompatibility a owl:ObjectProperty ;
    rdfs:domain hpc:Makeoption .
hpc:unconditionalmake a owl:ObjectProperty ;
    rdfs:domain hpc:Makeoption ;
    rdfs:range hpc:Makecommand .
hpc:changedirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Makeoption ;
    rdfs:range xsd:string .
