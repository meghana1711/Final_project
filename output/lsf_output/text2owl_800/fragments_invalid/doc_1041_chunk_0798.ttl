hpc:Host a owl:Class .
hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:cpufactor a owl:DatatypeProperty .
hpc:numcpus a owl:DatatypeProperty .
hpc:totalmemory a owl:DatatypeProperty .
hpc:totalswapspace a owl:DatatypeProperty .
hpc:Serverhost a owl:Class .
hpc:Staticresource a owl:Class .
hpc:Exclusiveresource a owl:Class .

# Properties
hpc:hasHostName an owl:ObjectProperty .
hpc:hashosttype a owl:ObjectProperty .
hpc:hashostmodel a owl:ObjectProperty .
hpc:Hascpufactor rdfs:domain hpc:Host ;
                  rdfs:range xsd:decimal .
hpc:Hasnumcpus rdfs:domain hpc:Host ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Hastotalmemory rdfs:domain hpc:Host ;
                    rdfs:range xsd:decimal .
hpc:Hastotalswapspace rdfs:domain hpc:Host ;
                       rdfs:range xsd:decimal .
hpc:Isserverhost rdfs:domain hpc:Host ;
                   rdfs:range xsd:boolean .
hpc:hasStaticResource an owl:ObjectProperty .
hpc:hasExclusiveResource an owl:ObjectProperty .

# Cluster and related concepts
hpc:Cluster a owl:Class .
hpc:clustername a owl:DatatypeProperty .

# Commands and related concepts
hpc:lshosts a owl:ObjectProperty .
hpc:LshostsOptions a owl:Class .
hpc:LshostsOption a owl:Class .
hpc:lshostsOptionArg a owl:DatatypeProperty .
hpc:lshostsOptionValue a owl:DatatypeProperty .
hpc:lshostsOptionDelimiter a owl:DatatypeProperty .
hpc:LshostsOutputField a owl:Class .
hpc:lshostsOutputFieldName a owl:DatatypeProperty .
hpc:lshostsOutputFieldWidth a owl:DatatypeProperty .
hpc:lshostsOutputFieldUnit a owl:DatatypeProperty .
hpc:lshostsOutputFieldDelimiter a owl:DatatypeProperty .
hpc:lshostsOutputFormat a owl:DatatypeProperty .
hpc:lshostsResourceRequirement a owl:DatatypeProperty .
hpc:lshostsStaticResource a owl:DatatypeProperty .
hpc:lshostsGpu a owl:DatatypeProperty .
hpc:lshostsGpuFlag a owl:DatatypeProperty .
hpc:lshostsHelp a owl:DatatypeProperty .
hpc:lshostsVersion a owl:DatatypeProperty .

# Subclass relations
hpc:Cluster a rdfs:subClassOf hpc:Host .
hpc:Exclusiveresource rdfs:subClassOf
