hpc:LsbSubExtschedParam a owl:Class ;
    rdfs:comment "Value of external scheduling options specified by bsub -extsched, or queue-level MANDATORY_EXTSCHED or DEFAULT_EXTSCHED.";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Jobsubmission .

hpc:LsbSubJobActionWarningTime a owl:Class ;
    rdfs:comment "Value of job warning time period specified by bsub -wt.";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Jobsubmission .

hpc:LsbSubJobErr a owl:Class ;
    rdfs:comment "The error number for an externally-submitted job defined by mbatchd if the job submission failed.";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The error number for an externally-submitted job defined by mbatchd if the job submission failed. This is available to the external post-submission scripts (epsub) to determine the reason for the job submission failure. If the job submission is successful, this value is LSB_NO_ERROR (or 0). Valid values Any non-negative integer." .

hpc:LSB_NO_ERROR a xsd:nonNegativeInteger ;
    rdfs:comment "A value of LSB_NO_ERROR (or 0) indicates that the job submission is successful." .

hpc:LsbSubJobId a owl:Class ;
    rdfs:comment "The job ID assigned by mbatchd. This is available to the external post-submission scripts (epsub).";
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The job ID assigned by mbatchd. This is available to the external post-submission scripts (epsub)." .

hpc:Jobsubmission a owl:Class .
