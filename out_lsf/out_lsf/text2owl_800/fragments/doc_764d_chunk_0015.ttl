hpc:LocalCluster
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf owl:Thing ] ;
    rdfs:comment "A local cluster in a MultiCluster environment." .

hpc:RecognizedCluster
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Cluster ] ;
    rdfs:comment "A cluster recognized by the local cluster." .

hpc:UnrecognizedCluster
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf owl:Thing ] ;
    rdfs:comment "A cluster not recognized by the local cluster." .

hpc:canViewInformationAbout
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster can view information about another cluster." .

hpc:canForwardJobs
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster can forward jobs to another cluster." .

hpc:canBorrowResources
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster can borrow resources from another cluster." .

hpc:canExportResources
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster can export resources to another cluster." .

hpc:canReceiveJobs
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster can receive jobs from another cluster." .

hpc:RemoteClusters
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Localcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "The list of recognized clusters for a local cluster." .
