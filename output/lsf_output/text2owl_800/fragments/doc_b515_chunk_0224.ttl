hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:migrationthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Host, hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:bhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range hpc:Host .
hpc:bqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range hpc:Queue .
hpc:showconf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range hpc:Configuration .
hpc:admin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range hpc:Configuration .
hpc:Resizablejob a owl:Class .
hpc:resizeablejobmanagement a owl:ObjectProperty ;
    rdfs:domain hpc:Lsb ;
    rdfs:range hpc:Resizablejob .
hpc:resizenotificationcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .
hpc:scriptforresizing a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .
hpc:Lsb a owl:Class .
hpc:Configuration a owl:Class .
