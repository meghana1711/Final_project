hpc:Gpurequirement a owl:Class .
hpc:aff a owl:ObjectProperty .
hpc:mps a owl:DatatypeProperty .
hpc:share a owl:ObjectProperty .
hpc:Host a owl:Class .
hpc:Socket a owl:Class .
hpc:Gpu a owl:Class .

hpc:Gpurequirement rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf hpc:Gpurequirement .
hpc:Socket rdfs:subClassOf hpc:Gpurequirement .
hpc:Gpu rdfs:subClassOf hpc:Gpurequirement .

hpc:Aff rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:Mps rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:Share rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .

hpc:host rdfs:subPropertyOf hpc:aff ;
    rdfs:range hpc:Host .

hpc:socket rdfs:subPropertyOf hpc:aff ;
    rdfs:range hpc:Socket .

hpc:GPU rdfs:subPropertyOf hpc:aff ;
    rdfs:range hpc:Gpu .

hpc:host rdfs:subPropertyOf hpc:mps ;
    rdfs:range hpc:Host .

hpc:socket rdfs:subPropertyOf hpc:mps ;
    rdfs:range hpc:Socket .

hpc:GPU rdfs:subPropertyOf hpc:mps ;
    rdfs:range hpc:Gpu .

hpc:host rdfs:subPropertyOf hpc:share ;
    rdfs:range hpc:Host .

hpc:socket rdfs:subPropertyOf hpc:share ;
    rdfs:range hpc:Socket .

hpc:GPU rdfs:subPropertyOf hpc:share ;
    rdfs:range hpc:Gpu .
