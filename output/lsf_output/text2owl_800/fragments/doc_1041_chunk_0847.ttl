hpc:Lsportcheck a owl:Class .
hpc:haslsportcheckoption a owl:ObjectProperty .
hpc:LsportcheckOption rdf:type owl:Class .
hpc:LsportcheckOption_PrintUsage rdf:type hpc:LsportcheckOption .
hpc:LsportcheckOption_PrintUsage rdfs:label "Prints command usage and exits" .
hpc:LsportcheckOption_Lsportcheck_L rdf:type hpc:LsportcheckOption .
hpc:LsportcheckOption_Lsportcheck_L_DisplaysTCPUDPPortsOnLSFManagementHost rdf:type rdfs:Label .
hpc:LsportcheckOption_Lsportcheck_L_DisplaysTCPUDPPortsOnLSFManagementHost rdfs:label "Displays TCP and UDP ports on the LSF management host" .
hpc:LsportcheckOption_Lsportcheck_S rdf:type hpc:LsportcheckOption .
hpc:LsportcheckOption_Lsportcheck_S_DisplaysTCPUDPPortsOnLSFServerHost rdf:type rdfs:Label .
hpc:LsportcheckOption_Lsportcheck_S_DisplaysTCPUDPPortsOnLSFServerHost rdfs:label "Displays TCP and UDP ports on the LSF server host" .
hpc:Lsportcheck_hasOption rdf:type owl:ObjectProperty .
hpc:LsportcheckHasoption rdfs:domain hpc:Lsportcheck .
hpc:LsportcheckHasoption rdfs:range hpc:Lsportcheckoption .

# Lsrcp Command
hpc:Lsrcp a owl:Class .
hpc:haslsrcpoption a owl:ObjectProperty .
hpc:LsrcpOption rdf:type owl:Class .
hpc:LsrcpOption_Lsrcp_a rdf:type hpc:LsrcpOption .
hpc:LsrcpOption_Lsrcp_a_SourceFileTargetFile rdf:type rdfs:Label .
hpc:LsrcpOption_Lsrcp_a_SourceFileTargetFile rdfs:label "source_file target_file" .
hpc:LsrcpOption_Lsrcp_h rdf:type hpc:LsrcpOption .
