hpc:bsubmit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionuser ;
    rdfs:range hpc:Jobexecutionuser ;
    rdfs:comment "Allows job submission users to submit jobs as another job execution user." .

hpc:Lsfusermapping a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "User mapping policies for the bsubmit command." .

# LSF Version 10.1 Fix Pack 4
hpc:bswitch a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Applicationspecificeswitchexecutablefile ;
    rdfs:comment "Specifies an application-specific eswitch executable file that LSF associates with the job switch request." .

# LSF Version 10.1 Fix Pack 5 and Fix Pack 6
hpc:bugroup a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "Displays the global fair share policy (FS_POLICY) configuration for the user group." .

hpc:bugroup rdfs:subPropertyOf hpc:bugroup ;
    rdfs:range hpc:Apsusergroupfactors ;
    rdfs:comment "Displays a new field, PRIORITY, which shows the absolute priority scheduling (APS) user group factors." .

# LSF Version 10.1 Fix Pack 9
hpc:busers a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:User ;
    rdfs:comment "Displays two new fields: PJOBS and MPJOBS." .

hpc:busers rdfs:subPropertyOf hpc:busers ;
    rdfs:range hpc:Apsfactors ;
    rdfs:comment "Displays a new field, PRIORITY, which shows the absolute priority scheduling (APS) factors for the specified users or user groups." .

hpc:busers rdfs:subPropertyOf hpc:busers ;
    rdfs:range hpc:Customizablefields ;
    rdfs:comment "Customizes specific fields that the busers command displays." .

# LSF Version 10.1 Fix Pack 2
hpc:bwait a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Jobcondition ;
    rdfs:comment "Pauses and waits for the specified job condition to occur before the command returns." .
