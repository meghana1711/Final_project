    rdfs:range xsd:string ;
    rdfs:range rdfs:Literal ;
    rdfs:range rdfs:Boolean .
hpc:iscustommailprogram a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:islsbprovidedmailprogram a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:requireslsbmailserver a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:iswindowsmailprogram a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:isunixmailprogram a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:supportssmtp a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .
hpc:supportsmicrosoftexchangeserver a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogram ;
    rdfs:range xsd:string .

hpc:Lsf a owl:Class .
hpc:LsbMailserver a owl:Class ;
