hpc:Bsub a owl:Class ;
    rdfs:comment "Submits a job for execution and assigns it a unique numerical job ID." .

hpc:Option a owl:Class ;
    rdfs:subClassOf hpc:Bsub ;
    rdfs:comment "A specific option for the bsub command." .

hpc:Category a owl:Class ;
    rdfs:subClassOf hpc:Option ;
    rdfs:comment "A group of related options for the bsub command." .

hpc:hasCategory rdf:Property ;
    rdfs:domain hpc:Option ;
    rdfs:range hpc:Category ;
    rdfs:comment "The category to which an option belongs." .

hpc:hasHelpText rdf:Property ;
    rdfs:domain hpc:Option ;
    rdfs:range xsd:string ;
    rdfs:comment "The help text for an option." .

hpc:conflictingOptions rdf:Property ;
    rdfs:domain hpc:Option ;
    rdfs:range xsd:string ;
    rdfs:comment "The options that cannot be used together with this option." .

hpc:synopsis rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string ;
    rdfs:comment "The synopsis of the bsub command." .

hpc:description rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string ;
    rdfs:comment "A detailed description of the bsub command." .

hpc:abbreviation rdf:Property ;
    rdfs:domain hpc:Option ;
    rdfs:range xsd:string ;
    rdfs:comment "The abbreviation for an option." .

hpc:io a hpc:Category ;
    rdfs:comment "The io category of the bsub command." .

hpc:app a hpc:Option ;
    rdfs:comment "The -app option of the bsub command." .

hpc:V a hpc:Option ;
    rdfs:comment "The -V option of the bsub command." .

hpc:runsOn rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host on which the job runs." .

hpc:satisfiesRequirement rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Requirement ;
    rdfs:comment "The requirements that must be satisfied for the job to run." .

hpc:jobID rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:integer ;
    rdfs:comment "The unique numerical job ID assigned to the job." .

hpc:executionEnvironment rdf:Property ;
    rdfs:domain hpc:Bsub ;
    rdfs:range hpc:Executionenvironment ;
    rdfs:comment "The environment variables and other settings for the job." .

hpc:commandLine rdf:Property ;
