hpc:Account a owl:Class .

hpc:accountName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .

hpc:accountResponse rdf:type owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:NamedIndividual ] .

hpc:accountResponse_200 rdf:type hpc:accountResponse ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf hpc:accountResponse ] .

hpc:accountResponse_default rdf:type hpc:accountResponse ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf hpc:accountResponse ] .

hpc:accountResponse_removed rdf:type hpc:accountResponse ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf hpc:accountResponse ] .

hpc:content rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:accountResponse ;
    rdfs:range rdf:Resource .

hpc:content_applicationJSONrequest rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:content ;
    rdfs:range xsd:anyURI .

hpc:content_applicationYAML rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:content ;
    rdfs:range xsd:anyURI .

hpc:content_applicationXYAML rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:content ;
    rdfs:range xsd:anyURI .

hpc:content_textYAML rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:content ;
    rdfs:range xsd:anyURI .

hpc:schema rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:content ;
    rdfs:range rdf:Resource .

hpc:schema_v0.0.41_openapi_accounts_resp rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:schema ;
    rdfs:range rdf:Resource .

hpc:schema_v0.0.41_openapi_accounts_removed_resp rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:schema ;
    rdfs:range rdf:Resource .
