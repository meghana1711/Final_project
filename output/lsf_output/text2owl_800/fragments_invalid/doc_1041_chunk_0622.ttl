hpc:Job a owl:Class .
hpc:Mps a owl:Class .
hpc:Mpsdaemon a owl:Class .
hpc:cudaVisibleDevices a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:mps a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range ( hpc:Persocket | hpc:Pergpu ) .
hpc:shared a owl:ObjectProperty ;
    rdfs:domain hpc:Mps ;
    rdfs:range hpc:Mps .
hpc:Persocket a owl:Class ;
    rdfs:subClassOf hpc:Mps .
hpc:Pergpu a owl:Class ;
    rdfs:subClassOf hpc:Mps .
hpc:jExclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:aff a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
