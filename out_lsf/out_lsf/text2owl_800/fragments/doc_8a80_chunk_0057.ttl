hpc:Servicedomain a owl:Class .
hpc:Project a owl:Class .
hpc:Nonshareddistribution a owl:Class .
hpc:Hasservicedomain rdfs:domain hpc:Nonshareddistribution ;
                        rdfs:range hpc:Servicedomain .
hpc:Hasproject rdfs:domain hpc:Nonshareddistribution ;
                 rdfs:range hpc:Project .
hpc:Numnonsharedlicenses rdfs:domain hpc:Nonshareddistribution ;
                        rdfs:range xsd:integer .
hpc:Nonsharedlicense a owl:Class .
hpc:Ownedby rdfs:domain hpc:Nonsharedlicense ;
                   rdfs:range hpc:Project .
hpc:Requiresownership rdfs:domain hpc:Nonshareddistribution ;
                     rdfs:range xsd:integer .
