hpc:Joblevelspecification a owl:Class .
hpc:cpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelspecification ;
    rdfs:range xsd:string .
hpc:HostName a xsd:string .
hpc:HostModel a xsd:string .

hpc:Runwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .
hpc:Hasrunwindow rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:range rdf:ListMember hpc:Runwindow .
hpc:Isopentimewindow rdfs:domain hpc:Runwindow ;
    rdfs:range xsd:boolean .

hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .
hpc:Hasdispatchwindow rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:range rdf:ListMember hpc:Dispatchwindow .
hpc:Isopendispatchwindow rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:boolean .

hpc:Timewindow a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
hpc:Hasbegintime rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:dateTime .
hpc:Hasendtime rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:dateTime .
