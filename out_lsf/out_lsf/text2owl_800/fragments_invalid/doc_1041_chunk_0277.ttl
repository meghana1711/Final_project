hpc:Resourceusage a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the resource usage of a job or system." .

hpc:Memoryusage a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage ;
    rdfs:comment "Represents the memory usage of a job or system." .

hpc:Swapusage a owl:Class ;
    rdfs:subClassOf hpc:Resourceusage ;
    rdfs:comment "Represents the swap usage of a job or system." .

# Object Properties
hpc:hasunitprefix a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:string ;
    rdfs:comment "The unit prefix for the resource usage." .

hpc:hasdisplayvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The displayed value of the resource usage." .

hpc:hasdisplaywidth a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The width of the displayed value." .

hpc:hasdelimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:string ;
    rdfs:comment "The delimiter character for displaying different headers and fields." .

# Datatype Properties
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of memory used." .

hpc:maxMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum amount of memory allowed." .

hpc:avgMem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The average amount of memory used." .

hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The limit for memory usage." .

hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Swapusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of swap used." .

hpc:swaplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Swapusage ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The limit for swap usage." .

hpc:corelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusage ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The limit for the number of cores."
