hpc:ActiveDirectorySetting
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Settings for Active Directory." .

hpc:SyncAllUsers
    a owl:ObjectProperty ;
    rdfs:domain hpc:Activedirectorysetting ;
    rdfs:range rdf:Seq ;
    rdfs:comment "Action to sync all users in Active Directory." .

hpc:SuccessMessage
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Message displayed after a successful operation." .

hpc:User
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A user in Active Directory." .

hpc:LDAPProvider
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The LDAP provider for users." .

hpc:LogOnToLSFWebServices
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string ;
    rdfs:comment "Action to log on to LSF Web Services using an Active Directory user." .

hpc:SubmitLSFJob
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string ;
    rdfs:comment "Action to submit an LSF job." .

hpc:DisplayLSFJobInformation
    a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range rdf:Seq ;
    rdfs:comment "Action to display LSF job information." .
