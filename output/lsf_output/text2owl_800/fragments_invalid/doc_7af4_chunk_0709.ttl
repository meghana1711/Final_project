hpc:LsbJobMemorylimit a owl:Class .
hpc:OsProcessMemorylimit a owl:Class .
hpc:LsfJobMemorylimit a owl:Class .

hpc:enforcedby a owl:ObjectProperty .
hpc:signal a owl:ObjectProperty .
hpc:timeinterval a owl:DatatypeProperty .
hpc:supportedby a owl:ObjectProperty .

hpc:LsbJobMemorylimit rdfs:subClassOf hpc:LsbJobMemorylimit .
hpc:OsProcessMemorylimit rdfs:subClassOf hpc:OsProcessMemorylimit .

hpc:LsbJobMemorylimit rdfs:domain hpc:LsbJobMemorylimit .
hpc:OsProcessMemorylimit rdfs:domain hpc:OsProcessMemorylimit .

hpc:Enforcedby rdfs:domain hpc:LsbJobMemorylimit ;
    rdfs:range hpc:OsProcessMemorylimit ;
    rdfs:range hpc:LsfJobMemorylimit .

hpc:Signal rdfs:domain hpc:LsfJobMemorylimit ;
    rdfs:range xsd:string .

hpc:Timeinterval rdfs:domain hpc:LsfJobMemorylimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Supportedby rdfs:domain hpc:OsProcessMemorylimit ;
    rdfs:range xsd:string .

hpc:LSB_JOB_MEMLIMIT_Enabled a hpc:LSB_Job_MemoryLimit ;
    hpc:Enforcedby hpc:lsfJobMemorylimit ;
    hpc:OS_Process_MemoryLimit owl:complementOf hpc:OS_Process_MemoryLimit .

hpc:LSB_JOB_MEMLIMIT_Disabled a hpc:LSB_Job_MemoryLimit ;
    hpc:Enforcedby hpc:osProcessMemorylimit ;
    hpc:OS_Process_MemoryLimit owl:complementOf hpc:OS_Process_MemoryLimit .
