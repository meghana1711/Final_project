hpc:Defaultqueue a owl:Class .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Defaultqueue ;
    rdfs:domain hpc:Defaultqueue .

hpc:interactive a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:Timewindow a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Defaultqueue .

hpc:jobslotcount a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:timeexpression a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:string .

hpc:ifelse a owl:ObjectProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range hpc:Ifelsestatement .

hpc:Ifelsestatement a owl:Class .

hpc:if a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelsestatement ;
    rdfs:range hpc:Ifstatement .

hpc:else a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelsestatement ;
    rdfs:range hpc:Statement .

hpc:elseif a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelsestatement ;
    rdfs:range hpc:Elseifstatement .

hpc:Ifstatement a owl:Class ;
    rdfs:subClassOf hpc:Statement .

hpc:Elseifstatement a owl:Class ;
    rdfs:subClassOf hpc:Ifstatement .

hpc:Statement a owl:Class .

hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .

hpc:Runwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Defaultqueue ;
    rdfs:domain hpc:Dispatchwindow .
