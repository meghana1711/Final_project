hpc:PendingExclusiveLSFLicenseSchedulerJob
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Job ] ;
    rdfs:comment "A job that is pending and exclusive on the LSF License Scheduler." .

hpc:SuspendedLSFLicenseSchedulerJob
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Job ] ;
    rdfs:comment "A job that is suspended on the LSF License Scheduler." .

hpc:BlockedJob
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Job ] ;
    rdfs:comment "A job that is blocked from starting." .

hpc:SharedLicenses
    a owl:Class ;
    rdfs:comment "Licenses that are shared between jobs." .

hpc:ExclusivePreemption
    a owl:Class ;
    rdfs:comment "The ability for a job to preempt other jobs." .

hpc:QueueBasedPreemption
    a owl:Class ;
    rdfs:subClassOf hpc:Exclusivepreemption ;
    rdfs:comment "Preemption based on queue settings." .

hpc:SLAGuarantiesIgnore
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuebasedpreemption ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether queue-based preemption is ignored." .

hpc:ServiceClass
    a owl:Class ;
    rdfs:comment "A service class for jobs." .

hpc:PreemptableResource
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf xsd:string ] ;
    rdfs:comment "A resource that can be preempted." .

hpc:JobSlot
    a hpc:PreemptableResource ;
    rdfs:comment "A job slot as a preemptable resource." .

hpc:MemoryResource
    a hpc:PreemptableResource ;
    rdfs:comment "Memory as a preemptable resource." .

hpc:AffinityResource
    a hpc:PreemptableResource ;
    rdfs:comment "Affinity as a preemptable resource." .

hpc:PreempttableResources
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicenseschedulerjob ;
    rdfs:range rdf:List ;
    rdfs:comment "The resources that can be preempted by a job." .

hpc:PreemptJobType
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicenseschedulerjob ;
    rdfs:range xsd:string ;
    rdfs:comment "The type of job that can preempt a job with a service class." .

hpc:LSFLicSchedPreemptSlotRelease
    a owl:ObjectProperty ;
    rdfs
