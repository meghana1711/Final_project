hpc:Jobgroup a owl:Class .
hpc:owner a owl:ObjectProperty .
hpc:groupName a rdf:Property .
hpc:jlimit a owl:DatatypeProperty .
hpc:idleTime a owl:DatatypeProperty .
hpc:nslots a owl:DatatypeProperty .

hpc:Jobslot a owl:Class .

hpc:Hasjobgroup rdfs:domain hpc:Jobgroup .
hpc:Hasjobgroup rdfs:range rdf:Resource .
hpc:Hasowner rdfs:domain hpc:Jobgroup .
hpc:Hasowner rdfs:range rdf:Resource .
hpc:Hasgroupname rdfs:domain hpc:Jobgroup .
hpc:Hasgroupname rdfs:range xsd:string .
hpc:Hasjlimit rdfs:domain hpc:Jobgroup .
hpc:Hasjlimit rdfs:range xsd:decimal .
hpc:HasidleTime rdfs:domain hpc:Jobgroup .
hpc:HasidleTime rdfs:range xsd:nonNegativeInteger .
hpc:Hasnslots rdfs:domain hpc:Jobgroup .
hpc:Hasnslots rdfs:range xsd:nonNegativeInteger .

hpc:Job a owl:Class .
hpc:Hasjobgroup rdfs:domain hpc:Job .
hpc:Hasjobgroup rdfs:range hpc:Jobgroup .
