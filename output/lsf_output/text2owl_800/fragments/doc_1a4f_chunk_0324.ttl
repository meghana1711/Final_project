hpc:Lsbparams a owl:Class .
hpc:Lsbqueues a owl:Class .
hpc:Lsbapplications a owl:Class .

hpc:maxTotalTimePreempt a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplications ;
    rdfs:range xsd:minutes .

hpc:MAX_TOTAL_TIME_PREEMPT_VALUE a owl:Datatype .

hpc:noPreemptRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplications ;
    rdfs:range xsd:nonNegativeInteger .

hpc:noPreemptInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbapplications ;
    rdfs:range xsd:nonNegativeInteger .

hpc:PREEMPT_JOBTYPE a owl:Enum ;
    rdfs:subClassOf hpc:Lsbparams ;
    rdfs:range xsd:string ;
    owl:value "BACKFILL" ;
    owl:value "EXCLUSIVE" ;
    owl:value "EXCLUSIVE_BACKFILL" .

hpc:preemption a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbqueues .
