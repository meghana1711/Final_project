hpc:Jobexceptionparameters a owl:Class .
hpc:overrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexceptionparameters ;
    rdfs:range xsd:minutes .
hpc:numofjobsoverrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexceptionparameters ;
    rdfs:range xsd:nonNegativeInteger .
hpc:underrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexceptionparameters ;
    rdfs:range xsd:minutes .
hpc:numofjobsunderrun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexceptionparameters ;
    rdfs:range xsd:nonNegativeInteger .
hpc:idle a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexceptionparameters ;
    rdfs:range xsd:decimal .
hpc:jobidlefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Idle ;
    rdfs:range xsd:decimal .
hpc:Schedulingpolicies a owl:Class .
hpc:apspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingpolicies .
hpc:fairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingpolicies .
hpc:backfill a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingpolicies .
