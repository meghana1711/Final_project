hpc:Sparkapplication a owl:Class .
hpc:submits rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sparkapplication ;
    rdfs:range hpc:Lsfjob .

hpc:Lsfjob a owl:Class .
hpc:hasBsubOptions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:runsOn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Host .
hpc:hasBsubOptions_lsfSparkSubmitSh rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:hasSparkSubmitOptions rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:hasClass rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:hasNumberOfTasks rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Host .
hpc:hasHost_firstExecution rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:hasPortNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .

hpc:Sparkshelljob a owl:Class .
hpc:submits_interactive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sparkshelljob ;
    rdfs:range hpc:Lsfjob .

hpc:Host a owl:Class .
