hpc:Azureinstance a owl:Class .
hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:string .
hpc:ipv4address a owl:DatatypeProperty ;
    rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:string .
hpc:Lsfresourceconnectorcreated a owl:Class .
hpc:hostnameformat a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfresourceconnectorcreated ;
    rdfs:range xsd:string .
hpc:hostnameresolution a owl:ObjectProperty ;
    rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:string .
hpc:Dnsnisserver a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Dynamichost a owl:Class ;
    rdfs:subClassOf hpc:Lsfcluster .
hpc:Vpn a owl:Class .
hpc:Firewall a owl:Class .
hpc:Securitygroup a owl:Class .
hpc:ping a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Instance .
hpc:privateipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:Hostnameresolutionproblem a owl:Class .
hpc:lsflocalresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .
hpc:deprovisionshutdown a owl:ObjectProperty ;
    rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:string .
hpc:captureimage a owl:ObjectProperty ;
    rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:string .
hpc:Azureresourcegroup a owl:Class .
hpc:imagename a owl:DatatypeProperty ;
    rdfs:domain hpc:Azureimage ;
    rdfs:range xsd:string .
hpc:imageid a owl:DatatypeProperty ;
    rdfs:domain hpc:AzureccprovTemplates.json ;
    rdfs:range xsd:string .
