hpc:File a owl:Class .
hpc:Tag a owl:Class .
hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Cluster a owl:Class .

# Object Properties
hpc:belongsto a owl:ObjectProperty .
hpc:ownedby a owl:ObjectProperty .
hpc:hasgroup a owl:ObjectProperty .
hpc:hastag a owl:ObjectProperty .
hpc:manages a owl:ObjectProperty .

# Datatype Properties
hpc:lastupload a owl:DatatypeProperty .
hpc:lastdownload a owl:DatatypeProperty .
hpc:lasterror a owl:DatatypeProperty .

# Domain and Range
hpc:File rdfs:subClassOf owl:Class .
hpc:Tag rdfs:subClassOf hpc:File .
hpc:User rdfs:subClassOf owl:Class .
hpc:Group rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .

hpc:Belongsto rdfs:domain hpc:File .
hpc:Ownedby rdfs:domain hpc:Tag .
hpc:Hasgroup rdfs:domain hpc:File .
hpc:Hastag rdfs:domain hpc:File .
hpc:Manages rdfs:domain hpc:Cluster .

hpc:Lastupload rdfs:range xsd:dateTime .
hpc:Lastdownload rdfs:range xsd:dateTime .
hpc:Lasterror rdfs:range xsd:string .

# Examples
hpc:File_1 a hpc:File ;
    hpc:Belongsto hpc:group1 ;
    hpc:Hastag hpc:tag1 .

hpc:Tag_1 a hpc:Tag ;
    hpc:Ownedby hpc:user1 ;
    hpc:lastUpload "06/12/2015T15:50:10"^^xsd:dateTime ;
    hpc:lastDownload "06/12/2015T15:50:10"^^xsd:dateTime ;
    hpc:lastError "<error>"^^xsd:string .

hpc:Tag_2 a hpc:Tag ;
    hpc:Ownedby hpc:user2 ;
    hpc:Hasgroup hpc:group2 ;
    hpc:lastUpload "03/12/2015T13:51:59"^^xsd:dateTime ;
    hpc:lastDownload "03/12/2015T13:51:59"^^xsd:dateTime ;
    hpc:lastError "<error>"^^xsd:string .

hpc:Tag_3 a hpc:Tag ;
    hpc:Ownedby hpc:user2 ;
    hpc:Hasgroup hpc:group2 ;
    hpc:lastUpload "03/12/2015T13:52:06"^^xsd:dateTime ;
    hpc:lastDownload "03/12/2015T13:52:06"^^xsd
