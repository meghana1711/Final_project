@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Servicedomain a owl:Class .
hpc:Project a owl:Class .

hpc:servicedomainname a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the service domain" .

hpc:servicedomainothers a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of 'others' tokens in the service domain" .

hpc:servicedomainlsftotal a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of tokens that LSF can use from the service domain" .

hpc:servicedomainalloc a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of allocated tokens from the service domain (cluster mode)" .

hpc:servicedomainuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of used tokens from the service domain" .

hpc:servicedomaininuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of tokens in use from the service domain (project mode)" .

hpc:servicedomainreserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of reserved tokens from the service domain" .

hpc:servicedomainfree a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Total number of free tokens from the service domain" .

hpc:projectname a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the project" .

hpc:projectshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of shares for the project" .

hpc:projectOwn a owl:Datatype
