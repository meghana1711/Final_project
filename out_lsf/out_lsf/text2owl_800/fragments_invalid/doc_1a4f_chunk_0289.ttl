hpc:Job a owl:Class .
hpc:memorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:swaplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:joblevelmemoryenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joblevelmemoryenforcementtype .
hpc:joblevelswapenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joblevelswapenforcementtype .
hpc:hostbasedmemoryenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Hostbasedmemoryenforcementtype .
hpc:lsbresourceenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Lsbresourceenforcementtype .
hpc:memoryandswaplimitenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Memoryandswaplimitenforcementtype .
hpc:Joblevelmemoryenforcementtype a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:UnionOf ;
            owl:member hpc:NoMemoryEnforcement ;
            owl:member hpc:MemoryEnforcement ] ] .
hpc:Joblevelswapenforcementtype a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:UnionOf ;
            owl:member hpc:NoSwapEnforcement ;
            owl:member hpc:SwapEnforcement ] ] .
hpc:Hostbasedmemoryenforcementtype a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:UnionOf ;
            owl:member hpc:NoHostBasedEnforcement ;
            owl:member hpc:HostBasedEnforcement ] ] .
hpc:Lsbresourceenforcementtype a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:UnionOf ;
            owl:member hpc:NoResourceEnforcement ;
            owl:member hpc:ResourceEnforcement ] ] .
hpc:Memoryandswaplimitenforcementtype a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:UnionOf ;
            owl:member hpc:NoMemoryAndSwapEnforcement ;
            owl:member hpc:MemoryAndSwapEnforcement ] ] .
hpc:Nomemoryenforcement a owl:Class .
hpc:Memoryenforcement a owl:Class .
hpc:Noswapenforcement a owl:Class .
hpc:Swap
