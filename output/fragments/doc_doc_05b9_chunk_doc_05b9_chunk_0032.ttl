  rdfs:subClassOf [ a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ] .

hpc:UserID a owl:DatatypeProperty ;
  rdfs:domain hpc:User ;
  rdfs:range xsd:string .

hpc:count a owl:DatatypeProperty ;
  rdfs:domain hpc:v0_0_43_stats_rpc_time ;
  rdfs:range xsd:int .

hpc:time a owl:DatatypeProperty ;
  rdfs:domain hpc:v0_0_43_stats_rpc_time ;
