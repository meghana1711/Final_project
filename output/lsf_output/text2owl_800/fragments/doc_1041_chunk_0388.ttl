hpc:Lsfworkload a owl:Class .
hpc:Projectmode a owl:Class .
hpc:Nonlsfworkload a owl:Class .

hpc:enabledynamicrusage a owl:ObjectProperty .

hpc:lsfuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfworkload ;
    rdfs:range xsd:integer .
hpc:lsfdeserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfworkload ;
    rdfs:range xsd:integer .
hpc:lsffree a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfworkload ;
    rdfs:range xsd:integer .
hpc:nonlsfuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonlsfworkload ;
    rdfs:range xsd:integer .
hpc:nonlsfdeserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonlsfworkload ;
    rdfs:range xsd:integer .
hpc:nonlsffree a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonlsfworkload ;
    rdfs:range xsd:integer .

hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Lsfworkload .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Project .

hpc:share a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal .

hpc:own a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
