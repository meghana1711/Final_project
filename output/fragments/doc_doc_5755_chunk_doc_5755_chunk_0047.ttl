hpc:User a owl:Class .
hpc:hasUID a owl:ObjectProperty .
hpc:KnownUser rdf:type hpc:User ;
    hpc:hasUID rdf:type xsd:string .

hpc:NewUser a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:System a owl:Class .
hpc:hasSSSD a owl:ObjectProperty .

hpc:SSSD a owl:Class .
hpc:enumerationEnabled a owl:DatatypeProperty ;
    rdfs:domain hpc:SSSD ;
    rdfs:range xsd:boolean .
hpc:caseSensitive a owl:DatatypeProperty ;
    rdfs:domain hpc:SSSD ;
    rdfs:range xsd:boolean .

hpc:Job a owl:Class .
hpc:isSuspendable a owl:ObjectProperty .
hpc:isResumable a owl:ObjectProperty .
hpc:isFullSystemJob a owl:ObjectProperty .

hpc:Queue a owl:Class .
hpc:isForFullSystemJob a owl:ObjectProperty .

hpc:Script a owl:Class .
hpc:controlsJobSuspensionResumption a owl:ObjectProperty .
hpc:stopsOtherPartitions a owl:ObjectProperty .
hpc:suspendsRunningJobs a owl:ObjectProperty .
hpc:startsFullSystemPartition a owl:ObjectProperty .
```
