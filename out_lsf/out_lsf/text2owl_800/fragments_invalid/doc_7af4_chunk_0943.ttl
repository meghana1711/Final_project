hpc:distribution rdf:resource "http://example.org/LicenseServer1#Lp1" .

hpc:ApplicationY
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "ApplicationY" ;
    hpc:distribution rdf:resource "http://example.org/LicenseServer1#Lp2" .

hpc:allocation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationy ;
    rdfs:range rdf:List ;
    rdfs:comment "ALLOCATION is configured for ApplicationY" .

hpc:cluster
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A cluster" .

hpc:interactiveTask
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "An interactive task" .

hpc:license
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A license" .

hpc:hasLicense
    a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationy ;
    rdfs:range hpc:License ;
    rdfs:comment "The license that an application has" .

hpc:hasCluster
    a owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range rdf:List ;
    rdfs:comment "The clusters that an allocation is distributed to" .

hpc:hasInteractiveTask
    a owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range rdf:List ;
    rdfs:comment "The interactive tasks that an allocation is distributed to" .

hpc:ENABL_INTERACTIVE
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether interactive tasks are enabled or not" .
