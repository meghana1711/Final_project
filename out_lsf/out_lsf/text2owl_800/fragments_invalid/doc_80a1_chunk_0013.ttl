hpc:WatsonStudioPage
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents the Watson Studio page." .

hpc:GetStartedButton
    a owl:ObjectProperty ;
    rdfs:domain hpc:Watsonstudiopage ;
    rdfs:range hpc:Serviceinstance ;
    rdfs:comment "Action to click the 'Get Started' button on the Watson Studio page." .

hpc:CreateProjectLink
    a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceinstance ;
    rdfs:range hpc:Project ;
    rdfs:comment "Action to click the 'Create a project' link on the service instance." .

hpc:CreateEmptyProject
    a owl:ObjectProperty ;
    rdfs:domain hpc:Projectlink ;
    rdfs:range hpc:Project ;
    rdfs:comment "Action to create an empty project." .

hpc:ProjectName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Createemptyproject ;
    rdfs:range xsd:string ;
    rdfs:comment "The name given to the new project." .

hpc:CloudObjectStorageInstance
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents an IBM Cloud Object Storage instance." .

hpc:AssociateCloudObjectStorageInstance
    a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Cloudobjectstorageinstance ;
    rdfs:comment "Action to associate a Cloud Object Storage instance with a project." .

hpc:AddCloudObjectStoreService
    a owl:ObjectProperty ;
    rdfs:domain hpc:Cloudobjectstorageinstance ;
    rdfs:range hpc:Cloudobjectstoreservice ;
    rdfs:comment "Action to add a Cloud Object Store service to the Cloud Object Storage instance." .

hpc:CloudObjectStoreService
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a Cloud Object Store service." .

hpc:LiteTier
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents the Lite tier of the Cloud Object Store service." .

hpc:CreateCloudObjectStoreService
    a owl:ObjectProperty ;
    rdfs:domain hpc:Addcloudobjectstoreservice ;
    rdfs:range hpc:Cloudobjectstoreservice ;
    rdfs:comment "Action to create a Cloud Object Store service." .

