hpc:Application a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:container a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Containerspec .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:Containerspec a owl:Class .
hpc:image a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerspec ;
    rdfs:range xsd:string .
hpc:options a owl:DatatypeProperty ;
    rdfs:domain hpc:Containerspec ;
    rdfs:range xsd:string .
hpc:rm a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:boolean .
hpc:network a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .
hpc:ipc a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .
hpc:path a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .

hpc:PodmanApp a hpc:Application ;
    hpc:Name "podmanapp" ;
    hpc:Container (hpc:Podman [hpc:Image "repository.example.com:5000/file/path/ubuntu:latest"]) .
hpc:DockerApp a hpc:Application ;
    hpc:Name "dockerapp" ;
    hpc:Container (hpc:Docker [hpc:Image "repository.example.com:5000/file/path/ubuntu:latest"
                               hpc:options (hpc:RM true)] ) .
hpc:NvidiaDockerApp a hpc:Application ;
    hpc:Name "ndockerapp" ;
    hpc:Container (hpc:NvidiaDocker [hpc:Image "repository.example.com:5000/file/path/ubuntu:latest"]) .
