    rdfs:range xsd:string .

hpc:crunRunTimeStart hpc:crun --rootless=true --root=/run/user/%U/ start %n.%u.%j.%s.%t a owl:ObjectProperty ;
    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

hpc:crunRunTimeKill hpc:crun --rootless=true --root=/run/user/%U/ kill -a %n.%u.%j.%s.%t a owl:ObjectProperty ;
    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

hpc:crunRunTimeDelete hpc:crun --rootless =true --root=/run/user/%U/ delete --force %n.%u.%j.%s.%t a owl:ObjectProperty ;
    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

hpc:crunRunTimeCreate hpc:crun --rootless=true --root=/run/user/%U/ create --bundle %b %n.%u.%j.%s.%t a owl:ObjectProperty ;
    rdfs:domain hpc:RunTime ;
    rdfs:range xsd:string .

