hpc:Memorylimit a owl:Class .
hpc:processlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range hpc:Process .
hpc:swaplimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:joblimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range hpc:Job .
hpc:tasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:threadlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Perprocessresourceusagelimit a owl:Class .
hpc:corelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Perprocessresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:datasegmentlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Perprocessresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:filesizelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Perprocessresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:corefilesizelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Perprocessresourceusagelimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Process a owl:Class .
hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Thread a owl:Class .
