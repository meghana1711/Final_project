hpc:Host a owl:Class .
hpc:status a owl:ObjectProperty .
hpc:jlU a owl:DatatypeProperty .
hpc:max a owl:DatatypeProperty .
hpc:njobs a owl:DatatypeProperty .
hpc:run a owl:DatatypeProperty .
hpc:ssusp a owl:DatatypeProperty .
hpc:ususp a owl:DatatypeProperty .
hpc:rsv a owl:DatatypeProperty .
hpc:HostName rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:JlU rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Max rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Njobs rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Run rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ssusp rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ususp rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Rsv rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cpuf a owl:ObjectProperty .
hpc:dispatchWindow a owl:DatatypeProperty .
hpc:currentLoad a owl:ObjectProperty .
hpc:usedForScheduling a owl:ObjectProperty .
hpc:loadThreshold a owl:ObjectProperty .
hpc:powerStatus a owl:DatatypeProperty .
hpc:idleTime a owl:DatatypeProperty .
hpc:cycleTimeRemaining a owl:DatatypeProperty .
hpc:Bjobs a owl:Class .
hpc:jobid a owl:DatatypeProperty .
hpc:user a owl:DatatypeProperty .
hpc:stat a owl:DatatypeProperty .
hpc:queue a owl:DatatypeProperty .
hpc:fromHost a owl:DatatypeProperty .
hpc:jobName a owl:DatatypeProperty .
hpc:submitTime a owl:DatatypeProperty .
hpc:prov a owl:ObjectProperty .
hpc:willStartOn a owl:ObjectProperty .

hpc:Host subClassOf owl:Class .
hpc:HostName rdfs:domain hpc:Host ;
    rdfs:range rdf:PlainLiteral .
hpc:Status rdfs:domain hpc:Host ;
    rdfs:range rdf:PlainLiteral .
hpc:JlU rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Max rdfs:domain hpc:Host ;
