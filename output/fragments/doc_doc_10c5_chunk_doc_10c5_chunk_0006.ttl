hpc:HighLevelSrunFlag a owl:Class .
hpc:CpuBindFlag a owl:Class .
hpc:AffinityMask a owl:Class .
hpc:CpuBind a owl:ObjectProperty ;
    rdfs:domain hpc:CpuBindFlag ;
    rdfs:range xsd:string .
hpc:DistributionMethod a owl:ObjectProperty ;
    rdfs:domain hpc:HighLevelSrunFlag .
hpc:Node a owl:Class ;
    rdfs:subClassOf hpc:ComputingResource .
hpc:Socket a owl:Class ;
    rdfs:subClassOf hpc:ComputingResource .
hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:ComputingResource .
hpc:Processor a owl:Class ;
    rdfs:subClassOf hpc:ComputingResource .
hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:ComputingTask .
hpc:TaskId a owl:DatatypeProperty ;
    rdfs:domain hpc:Task .
hpc:CpuAffinity a owl:ObjectProperty ;
    rdfs:domain hpc:ComputingTask .
hpc:BlockDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:HighLevelSrunFlag .
hpc:CyclicDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:HighLevelSrunFlag .
hpc:BlockCyclicDistribution a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:BlockDistribution , hpc:CyclicDistribution .
