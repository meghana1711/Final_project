hpc:Experiment
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "Experiment" ;
    rdfs:comment "A simulation of a cluster." .

