hpc:Datatransfer a owl:Class .
hpc:Datastagingarea rdfs:subClassOf hpc:Datatransfer .
hpc:Executionhost rdfs:subClassOf hpc:Datatransfer .
hpc:Datatransfernode rdfs:subClassOf hpc:Datatransfer .
hpc:Externaldatarepository rdfs:subClassOf hpc:Datatransfer .
hpc:Aspera a owl:Class .
hpc:AsperaClient rdf:type hpc:DataTransferNode ;
    rdfs:subClassOf hpc:Aspera .
hpc:AsperaServer rdf:type hpc:ExternalDataRepository ;
    rdfs:subClassOf hpc:Aspera .
hpc:sshkeybasedauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Aspera ;
    rdfs:range xsd:string .
hpc:filetransfercommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager .
hpc:transferscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:string .
hpc:transferscriptlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:string .
hpc:executabletransferscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:boolean .
hpc:Datamanager a owl:Class .
hpc:Lsfdatamanager a owl:Class ;
    rdfs:subClassOf hpc:Datamanager .
hpc:lsfdatamanagerfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
