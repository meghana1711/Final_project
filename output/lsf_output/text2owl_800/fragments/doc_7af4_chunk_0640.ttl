hpc:EgoParameter a owl:Class .
hpc:egoEslimTimeout a owl:DatatypeProperty .
hpc:egoLimPgSmoothFactor a owl:DatatypeProperty .
hpc:EgoLimPgSmoothFactor rdfs:domain hpc:EgoParameter ;
                                 rdfs:range xsd:integer .
hpc:EGO_LIM_PG_SMOOTH_FACTOR rdfs:subPropertyOf hpc:EGO_PARAMETER .
hpc:EGO_LIM_PG_SMOOTH_FACTOR rdfs:comment "Specifies the smoothing factor when lim reports the host page rate." .

hpc:egoPimSwapReport a owl:DatatypeProperty .
hpc:EgoPimSwapReport rdfs:domain hpc:EgoParameter ;
                                 rdfs:range xsd:string .
hpc:EGO_PIM_SWAP_REPORT rdfs:subPropertyOf hpc:EGO_PARAMETER .
hpc:EGO_PIM_SWAP_REPORT rdfs:comment "Enables PIM to report swap space usage for job processes." .

hpc:EgoPimSwapReportY a owl:Class ;
                             rdfs:subClassOf hpc:EgoPimSwapReport .
hpc:EGO_PIM_SWAP_REPORT_Y rdfs:comment "Value 'y' or 'Y' for EGO_PIM_SWAP_REPORT." .

hpc:EgoPimSwapReportN a owl:Class ;
                             rdfs:subClassOf hpc:EgoPimSwapReport .
hpc:EGO_PIM_SWAP_REPORT_N rdfs:comment "Value 'n' or 'N' for EGO_PIM_SWAP_REPORT." .

hpc:Linux a owl:Class .
hpc:Linux rdfs:subClassOf rdf:Resource .
hpc:Linux rdfs:comment "Represents a Linux operating system." .

hpc:EGO_LIM_PG_SMOOTH_FACTOR_Range a owl:Restriction ;
                                       rdfs:domain hpc:EgoLimPgSmoothFactor ;
                                       owl:onProperty hpc:EGO_LIM_PG_SMOOTH_FACTOR ;
                                       rdf:type xsd:integer ;
                                       xsd:minInclusive "0" ;
                                       xsd:maxInclusive "10" .
