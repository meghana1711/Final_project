hpc:Job a owl:Class .
hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:minimumtask a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maximumtask a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Jobslot a owl:Class .
hpc:minimumjobslot a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maximumjobslot a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeInteger .

hpc:parallelschedulingbyslot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:jobsizelist a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List .

hpc:allowedjobsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Allowedjobsizelist ;
    rdfs:range xsd:nonNegativeInteger .

hpc:defaultjobsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Allowedjobsizelist ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
