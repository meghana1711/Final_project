hpc:Hostbasedpreexecution a owl:Class .
hpc:Hostbasedpostexecution a owl:Class .

hpc:hasPreExecutionCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedpreexecution ;
    rdfs:range rdf:Resource .

hpc:hasPostExecutionCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedpostexecution ;
    rdfs:range rdf:Resource .

hpc:usesEnvironmentVariables an owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedpreexecution, hpc:Hostbasedpostexecution .

hpc:reQueuesJobOnFailure an owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedpreexecution .

hpc:runsOnAllHosts an owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedpreexecution .

hpc:hasExitCode an owl:DatatypeProperty ;
    rdfs:domain hpc:Hostbasedpostexecution ;
    rdfs:range xsd:nonNegativeInteger .

hpc:UserDefinedPostExecutionCommand an owl:Class ;
    rdfs:subClassOf hpc:Hostbasedpostexecution .

hpc:allowsUserDefinition an owl:ObjectProperty ;
    rdfs:domain hpc:Userdefinedpostexecutioncommand .
