hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Command a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Cluster a owl:Class .
hpc:Cluster2 rdfs:subClassOf hpc:Cluster .
hpc:run a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:forcedtorun a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:forwarded a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:forwardedto a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
hpc:remotejobcontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:dispatchedto a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:executionhome a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:executioncwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:executionpid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:requestedresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submitqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:sndjobsTo a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Localcluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster
