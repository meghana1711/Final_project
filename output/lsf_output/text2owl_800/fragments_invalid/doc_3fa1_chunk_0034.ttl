hpc:User a owl:Class .
hpc:Groupb a owl:Class .
hpc:importance a owl:ObjectProperty .
hpc:share a owl:DatatypeProperty .

hpc:User1 rdf:type hpc:User ;
    hpc:importance 10 ;
    hpc:share 10 .
hpc:User2 rdf:type hpc:User ;
    hpc:importance 6 .
hpc:others rdf:type hpc:User ;
    hpc:share 8 .

hpc:Importance rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .
hpc:Share rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:User1 rdfs:subClassOf hpc:User .
hpc:User2 rdfs:subClassOf hpc:User .
hpc:Others rdfs:subClassOf hpc:User .

hpc:Groupb rdfs:subClassOf hpc:User .

hpc:numUsers owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Numusers3 hpc:numusers ;
    rdf:type xsd:integer ;
    rdf:value "3" .
hpc:Numusers12 hpc:numusers ;
    rdf:type xsd:integer ;
    rdf:value "12" .

hpc:Share3 hpc:share ;
    rdf:type xsd:integer ;
    rdf:value "20" .
hpc:Share12 hpc:share ;
    rdf:type xsd:integer ;
    rdf:value "56" .

hpc:Share3User1 hpc:share3 ;
    rdf:type xsd:integer ;
    rdf:value "10" .
hpc:Share3User2 hpc:share3 ;
    rdf:type xsd:integer ;
    rdf:value "6" .
hpc:Share3Others hpc:share3 ;
    rdf:type xsd:integer ;
    rdf:value "4" .
hpc:Share12User1 hpc:share12 ;
    rdf:type xsd:integer ;
    rdf:value "10" .
hpc:Share12User2 hpc:share12 ;
    rdf:type xsd:integer ;
    rdf:value "6" .
hpc:Share12Others hpc:share12 ;
    rdf:type xsd:integer ;
    rdf:value "4" .

hpc:dynamicuserpriority a owl:ObjectProperty .
