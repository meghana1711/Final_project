hpc:Node a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .
hpc:TaskIDLayout a owl:Class .
hpc:ProcessorID a owl:ObjectProperty .
hpc:NodeList a owl:Class .
hpc:Partition a owl:Class .
hpc:State a owl:Class .
hpc:CPUS a owl:DatatypeProperty .
hpc:S:C:T a owl:DatatypeProperty .
hpc:Memory a owl:DatatypeProperty .
hpc:Tmp_Disk a owl:DatatypeProperty .
hpc:Weight a owl:DatatypeProperty .
hpc:Features a owl:DatatypeProperty .
hpc:Reason a owl:DatatypeProperty .
hpc:JobID a owl:DatatypeProperty .
hpc:Time a owl:DatatypeProperty .
hpc:Size a owl:DatatypeProperty .
hpc:Requested a owl:ObjectProperty .
hpc:SocketCount a owl:DatatypeProperty .
hpc:CoreCount a owl:DatatypeProperty .
hpc:ThreadCount a owl:DatatypeProperty .

hpc:Node rdfs:subClassOf owl:Class .
hpc:Socket rdfs:subClassOf hpc:Node .
hpc:Core rdfs:subClassOf hpc:Socket .
hpc:Thread rdfs:subClassOf hpc:Core .
hpc:TaskIDLayout rdfs:subClassOf owl:Class .
hpc:ProcessorID rdfs:domain hpc:TaskIDLayout ;
                 rdfs:range xsd:string .
hpc:NodeList rdfs:subClassOf owl:Class .
hpc:Partition rdfs:subClassOf owl:Class .
hpc:State rdfs:subClassOf owl:Class .
hpc:CPUS rdfs:domain hpc:Node ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:S:C:T rdfs:domain hpc:Node ;
                 rdfs:range xsd:string .
hpc:Memory rdfs:domain hpc:Node ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Tmp_Disk rdfs:domain hpc:Node ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Weight rdfs:domain hpc:Node ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Features rdfs:domain hpc:Node ;
                 rdfs:range xsd:string .
hpc:Reason r
