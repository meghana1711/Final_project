hpc:Proxydpolicy a owl:Class .
hpc:max a owl:DatatypeProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:nominal a owl:DatatypeProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:throttle a owl:DatatypeProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:duration .
hpc:Query a owl:Class ;
    rdfs:subClassOf hpc:Proxydpolicy .
hpc:Submission a owl:Class ;
    rdfs:subClassOf hpc:Proxydpolicy .
hpc:Other a owl:Class ;
    rdfs:subClassOf hpc:Proxydpolicy .
