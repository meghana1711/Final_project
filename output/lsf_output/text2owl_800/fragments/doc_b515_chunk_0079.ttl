hpc:Job a owl:Class .
hpc:numthreadspertask a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:smt a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:cpuspercore a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:distributionpolicy a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:affinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinityrequirement .

hpc:Affinityrequirement a owl:Class .
hpc:threadaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:integer .
hpc:coreexclusive a owl:ObjectProperty ;
    rdfs:domain hpc:Threadaffinity ;
    rdfs:range xsd:string .
hpc:intaskexclusive a owl:ObjectProperty ;
    rdfs:domain hpc:Threadaffinity ;
    rdfs:range xsd:string .
hpc:cpubind a owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:string .
hpc:distribute a owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:string .

hpc:P8aff a owl:Class ;
    rdfs:subClassOf hpc:Affinityrequirement .
hpc:P8Aff_10_10 a hpc:P8Aff ;
    hpc:ThreadAffinity 10 ;
    hpc:CpuBind "thread" ;
    hpc:Distribute "balance" .
hpc:P8Aff_10_8_2 a hpc:P8Aff ;
    hpc:ThreadAffinity 10 ;
    hpc:CPUsPerCore 8 ;
    hpc:DistributionPolicy "2" .
hpc:P8Aff_10_8_2_ a hpc:P8Aff ;
    hpc:ThreadAffinity 10 ;
    hpc:CPUsPerCore 8 ;
    hpc:DistributionPolicy "" .
hpc:P8Aff_10_8 a hpc:P8Aff ;
    hpc:ThreadAffinity 10 ;
    hpc:CPUsPerCore 8 ;
    hpc:DistributionPolicy "" .
hpc:P8Aff_10_8_ a hpc:P8Aff ;
    hpc:ThreadAffinity 10 ;
    hpc:CPUsPerCore 8 ;
    hpc:DistributionPolicy "" .
