hpc:Preemptableresource a owl:Class .
hpc:Preemptablejob a owl:Class .
hpc:Preemptionresourcerequirement a owl:Class .
hpc:Resourcereservation a owl:Class .
hpc:duration a owl:DatatypeProperty .
hpc:Preemptableresource rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Preemptionresourcerequirement .
hpc:Preemptionresourcerequirement rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Resourcereservation rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Preemptionresourcerequirement .
hpc:Duration rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:duration .
hpc:preemptableresources a owl:ObjectProperty .
hpc:Preemptableresources rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Preemptableresource .
hpc:preemptionwaittime a owl:DatatypeProperty .
hpc:Preemptionwaittime rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:duration .
hpc:PreemptableResourcesConfigured rdfs:subPropertyOf hpc:PreemptableResources ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Preemptableresource .
hpc:preemptionresourceconfigured a owl:ObjectProperty .
hpc:Preemptionresourceconfigured rdfs:domain hpc:Preemptableresource ;
    rdfs:range xsd:boolean .
hpc:preemptionresourcerequirementspecifiedat a owl:ObjectProperty .
hpc:Preemptionresourcerequirementspecifiedat rdfs:domain hpc:Preemptablejob ;
    rdfs:range rdf:Plural .
    rdfs:range hpc:Joblevel ;
    rdfs:range hpc:Queuelevel ;
    rdfs:range hpc:Applicationlevel .
hpc:Taskfile a owl:Class .
hpc:taskfile associatesSpecificResourceRequirementsWith a owl:ObjectProperty .
hpc:Taskfile associatesSpecificResourceRequirementsWith rdfs:domain hpc:Taskfile ;
    rdfs:range hpc:Application .
hpc:Dynamicresource a owl:Class .
hpc:Preemptablejobspreadoutamongqueues a owl:Class .
hpc:preemptiveschedulingconfigured a owl:ObjectProperty .
hpc:Preemptiveschedulingconfigured rdfs:domain hpc:Preemptablejobspreadoutamongqueues ;
    rdfs:range xsd:boolean .
