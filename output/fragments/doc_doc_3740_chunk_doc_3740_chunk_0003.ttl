hpc:CoreSelection a owl:Class .
hpc:LowestNumberedCore a owl:Class .
hpc:HigherNumberedSocket a owl:Class .
hpc:AdditionalCores a owl:Class .
hpc:NextLowestNumberedCore a owl:Class .

hpc:CoreSpecializationReservation rdf:type owl:Class .
hpc:SelectType rdf:type owl:ObjectProperty .
hpc:TaskPlugin rdf:type owl:ObjectProperty .
hpc:TaskPluginParam rdf:type owl:ObjectProperty .
hpc:SlurmdOffSpec rdf:type owl:ObjectProperty .

hpc:CoreSpecCount rdf:type owl:DatatypeProperty .
hpc:CPUSpecList rdf:type owl:DatatypeProperty .
hpc:MemSpecLimit rdf:type owl:DatatypeProperty .
hpc:LinuxCgroups rdf:type owl:ObjectProperty .
hpc:ComputeNodeDaemon rdf:type owl:ObjectProperty .

hpc:CoreSpecializationRequires rdf:type owl:FunctionalProperty .
hpc:SystemConfiguration rdf:type owl:Class .
hpc:JobAllocationRequestOptions rdf:type owl:Class .
hpc:CoresPerSocket rdf:type owl:Class .

hpc:CoreSpecialization a owl:Class ;
    rdfs:subClassOf hpc:CoreSelection ;
    rdfs:subClassOf hpc:JobAllocationRequestOptions ;
    rdfs:subClassOf hpc:SystemConfiguration .

hpc:LowestNumberedCore a owl:Class ;
    rdfs:subClassOf hpc:CoreSelection ;
    rdfs:subClassOf hpc:CoreSpecialization ;
    rdfs:domain hpc:CoreSelection ;
    rdfs:range hpc:Core .

hpc:HigherNumberedSocket a owl:Class ;
    rdfs:domain hpc:SubsequentCores ;
    rdfs:range hpc:Socket .

hpc:SubsequentCores a owl:Class ;
    rdfs:subClassOf hpc:CoreSelection ;
    rdfs:subClassOf hpc:CoreSpecialization ;
    rdfs:domain hpc:CoreSelection ;
    rdfs:range hpc:Core .

hpc:AdditionalCores a owl:Class ;
    rdfs:subClassOf hpc:CoreSelection ;
    rdfs:subClassOf hpc:CoreSpecialization ;
    rdfs:domain hpc:CoreSelection ;
    rdfs:range hpc:Core .

hpc:NextLowestNumberedCore a owl:Class ;
    rdfs:subClassOf hpc:AdditionalCores ;
    rdfs:domain hpc:AdditionalCores ;
    rdfs:range hpc:Core .

hpc:CoreSpecializationReservation a owl:Class ;
    rdfs:subClassOf hpc:SystemConfiguration .

hpc:SelectType a owl:ObjectProperty ;
    rdfs:domain hpc:CoreSpecializationReservation ;
    rdfs:range xsd:string .

