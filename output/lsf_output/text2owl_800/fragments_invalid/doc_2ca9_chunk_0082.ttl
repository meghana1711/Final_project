hpc:LsbGpuNewSyntax a owl:Class .
hpc:GpuReqMerge a owl:Class .
hpc:configuringGPUResourceRequirements a rdfs:SubClassOf hpc:Task .
hpc:submittingJobsThatRequireGPUResources a rdfs:SubClassOf hpc:Task .

hpc:GpuReqMerge rdfs:subClassOf hpc:Parameter .
hpc:LsbGpuReq rdfs:subClassOf hpc:Parameter .
hpc:GpuReq rdfs:subClassOf hpc:Parameter .

hpc:bsubGpu a owl:ObjectProperty ;
    rdfs:domain hpc:Submittingjobsthatrequiregpuresources ;
    rdfs:range hpc:Parameter .

hpc:LsbGpuReq rdfs:domain hpc:LsfConfiguration .
hpc:GpuReq rdfs:domain hpc:LsbQueue .
hpc:GpuReq rdfs:domain hpc:LsbApplication .

hpc:GpuReq rdfs:range xsd:integer .
hpc:GpuReqMerge rdfs:range xsd:boolean .

hpc:gpuReqMethod a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuReq .
    rdfs:range xsd:string .

hpc:GPU_REQ_METHOD_TASK a owl:NamedIndividual ;
    hpc:GPU_REQ_METHOD "task" .

hpc:GPU_REQ_METHOD_HOST a owl:NamedIndividual ;
    hpc:GPU_REQ_METHOD "host" .
