hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Job a owl:Class .
hpc:Subgroup a owl:Class .
hpc:hasuser a owl:ObjectProperty .
hpc:hasGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Group .
hpc:hasSubgroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Subgroup .
hpc:associatejobwithgroup a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Group .
hpc:fairsharepriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:dynamicsharepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:float .
hpc:slotsinuse a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .
hpc:pastresourceconsumption a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .
hpc:fairshareadjustment a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:float .
hpc:RUN_JOB_FACTOR a xsd:float .
hpc:FAIRSHARE_ADJUSTMENT_FACTOR a xsd:float .
hpc:resizejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Boolean .
hpc:Jobwithresize a owl:Class .
hpc:Jobwithresize rdfs:subClassOf hpc:Job .
hpc:hasresizefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobwithresize ;
    rdfs:range xsd:float .
