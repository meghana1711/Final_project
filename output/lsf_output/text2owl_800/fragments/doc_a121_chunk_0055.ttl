hpc:jobinputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobspoolingdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasDirectory .

hpc:Shareddirectory a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasremotecopyaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range xsd:boolean .

hpc:Managementhost a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:Submissionhost a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:Executionhost a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:Lsf a owl:Class .
hpc:Serverhost a owl:Class .
