hpc:Plugin a owl:Class .
hpc:performsoperationsoncomputenodes a owl:ObjectProperty .
hpc:UsesIntelsSyscfgProgram rdf:type hpc:PerformsOperationsOnComputeNodes ;
    rdfs:domain hpc:Plugin ;
    rdfs:range hpc:Program .
hpc:UsesLinuxRebootProgram rdf:type hpc:PerformsOperationsOnComputeNodes ;
    rdfs:domain hpc:Plugin ;
    rdfs:range hpc:Program .
hpc:GetsAndModifiesMCDRAMAndNUMAMode rdf:type hpc:UsesIntelsSyscfgProgram .
hpc:RebootsComputeNode rdf:type hpc:UsesLinuxRebootProgram .
hpc:ReportsMCDRAMAndNUMAMode rdf:type hpc:SyscfgProgramOutput ;
    rdfs:subClassOf hpc:Syscfgprogramoutput .
hpc:RequiresRebootProgramInSlurmConf rdf:type hpc:Requirement ;
    rdfs:subClassOf hpc:Requirement ;
    rdfs:domain hpc:Plugin .
hpc:DoesNotPermitSpecificationOfResumeProgramSuspendProgramSuspendTimeEtc rdf:type hpc:Restriction ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:domain hpc:Plugin .
hpc:syscfgpath a owl:DatatypeProperty .
hpc:defaultnuma a owl:DatatypeProperty .
hpc:allownuma a owl:DatatypeProperty .
hpc:defaultmcdram a owl:DatatypeProperty .
hpc:rebootprogram a owl:DatatypeProperty .
hpc:nodefeaturesplugins a owl:DatatypeProperty .
hpc:debugflags a owl:DatatypeProperty .
hpc:grestypes a owl:DatatypeProperty .
hpc:nodename a owl:DatatypeProperty .
hpc:sockets a owl:DatatypeProperty .
hpc:corespersocket a owl:DatatypeProperty .
hpc:threadspercore a owl:DatatypeProperty .
hpc:realmemory a owl:DatatypeProperty .
hpc:feature a owl:DatatypeProperty .
hpc:nodename a owl:DatatypeProperty .
hpc:state a owl:DatatypeProperty .
hpc:drainnodes a owl:ObjectProperty .
hpc:changemcdramandnumamode a owl:ObjectProperty .
hpc:rebootnodes a owl:ObjectProperty .
hpc:restoretoserviceinslurm a owl:ObjectProperty .
hpc:IncorrectStateInformation rdf:type hpc:Problem ;
    rdfs:subClassOf hpc:Problem ;
    rdfs:comment "Slurm will be making scheduling decisions based upon incorrect state information." .
hpc:ChangeNodeStateInformationOutsideOfSlurm rdf:type hpc:Procedure ;
    rdfs:subClassOf hpc:Procedure ;
    rdfs:comment "Drain the nodes of interest, Change their MCDRAM and/or NUMA mode, Reboot the nodes, then Restore them to service in Slurm." .
