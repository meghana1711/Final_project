hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Dispatch window for interactive tasks.";
    rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf hpc:hasDispatchWindow .

hpc:hasdispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List ;
    rdfs:comment "A dispatch window consists of one or more time windows.".

hpc:Timewindow a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A time window in the format begin_time-end_time." ;
    rdfs:domain hpc:Timewindowlist ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf hpc:hasTimeWindow .

hpc:hastimewindow a owl:ObjectProperty ;
    rdfs:domain hpc:Timewindowlist ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The time window within a dispatch window.".

hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:time ;
    rdfs:comment "Time specified in the form [day:]hour[:minute].".

hpc:Alwaysacceptremotejobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Indicates whether the host can receive jobs from other hosts." ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:hasAlwaysAcceptRemoteJobs .

hpc:hasalwaysacceptremotejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specify 1 if the host can receive jobs from other hosts; specify 0 otherwise.".
