hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Fairsharequeue .

hpc:Fairsharequeue rdfs:subClassOf hpc:Queue ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:Plural ;
    rdfs:subPropertyOf hpc:hasQueueType ;
    rdfs:comment "Queues that use fair share scheduling." .

hpc:Fcfsqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:Plural ;
    rdfs:subPropertyOf hpc:hasQueueType ;
    rdfs:comment "Queues that use FCFS scheduling." .

hpc:crossqueuefairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue ;
    rdfs:subPropertyOf hpc:belongsToSameSet ;
    rdfs:comment "Relates two queues that use cross-queue fair share." .

hpc:belongstosameset a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Plural ;
    rdfs:comment "Relates a set of queues that belong to the same set." .

hpc:Hostpartition a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf hpc:Partition ;
    rdfs:comment "A partition of a host that handles resource contention across multiple queues." .

hpc:hasqueuetype a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:List ;
    rdfs:comment "Relates a host partition to the types of queues it uses." .

hpc:userShares a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The share assignments for users in a host partition." .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A physical or virtual machine in a cluster." .
