hpc:Energy a owl:Class .
hpc:Job a owl:Class .
hpc:gpfsio a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:block a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:cpuPeak a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:CpuEfficiency a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:cpuPeakEfficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:CpuEfficiency ;
    rdfs:range xsd:decimal .
hpc:memEfficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:averageCpuEfficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:cpuPeakReachedDuration a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
hpc:planStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
