hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Project a owl:Class .
hpc:LicenseProject rdf:type owl:Class ;
    rdfs:subClassOf hpc:Project .
hpc:BelongsTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Project .
hpc:SubmittedJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:DefaultBucket rdf:type owl:Class .
hpc:Shares rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Refused rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range hpc:Defaultbucket .
hpc:HasLowShares rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range hpc:Defaultbucket .
