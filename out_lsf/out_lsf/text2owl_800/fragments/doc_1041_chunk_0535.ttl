hpc:allowsnonadvancereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:boolean .

hpc:hasprescript a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string .

hpc:haspostscript a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string .

hpc:prescripttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:duration .

hpc:postscripttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:duration .

hpc:hasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Queue .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation ;
