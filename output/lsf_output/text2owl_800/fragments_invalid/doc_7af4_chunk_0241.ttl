hpc:Computeunit a owl:Class .
hpc:hasName an owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:isMember an owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunit .
hpc:hasType an owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:isCondensed an owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:boolean .
hpc:isAdmin an owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:boolean .
hpc:Computeunittype a owl:Class .
hpc:hasMembershipRule an owl:ObjectProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasMaxMembers an owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:nonNegativeInteger .
hpc:isfinestgranularity a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:boolean .
hpc:Hassubcomputeunittype rdfs:subClassOf hpc:Computeunittype ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range hpc:Computeunittype .
hpc:Hostgroup rdfs:subClassOf hpc:Computeunit .
hpc:Hostpartition rdfs:subClassOf hpc:Computeunit .
hpc:Computegroup rdfs:subClassOf hpc:Computeunit .
hpc:Computeunitconstraint a owl:Class .
hpc:hasHostGroupConstraint rdfs:subPropertyOf hpc:ComputeUnitConstraint ;
    rdfs:domain hpc:Computeunitconstraint ;
    rdfs:range hpc:Hostgroup .
hpc:hasHostPartitionConstraint rdfs:subPropertyOf hpc:ComputeUnitConstraint ;
    rdfs:domain hpc:Computeunitconstraint ;
    rdfs:range hpc:Hostpartition .
hpc:hasComputeGroupConstraint rdfs:subPropertyOf hpc:ComputeUnitConstraint ;
    rdfs:domain hpc:Computeunitconstraint ;
    rdfs:range hpc:Computegroup .
hpc:hasMaxComputeUnits rdfs:subPropertyOf hpc:ComputeUnitConstraint ;
    rdfs:domain hpc:Computeunitconstraint ;
    rdfs:range xsd:nonNegativeInteger .
