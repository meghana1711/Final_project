hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:stat a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Task a owl:Class .
hpc:taskDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .
hpc:blockSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:span a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Host a owl:Class .
hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Span ;
    rdfs:range xsd:nonNegativeInteger .
hpc:firstExecutionHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Span ;
    rdfs:range hpc:Host .
hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
