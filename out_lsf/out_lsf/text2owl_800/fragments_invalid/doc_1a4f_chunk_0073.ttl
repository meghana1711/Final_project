hpc:Queue a owl:Class .
hpc:Job a owl:Class .
hpc:Serverhost a owl:Class .

hpc:dispatch a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:arrivalorder a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:queuecontrolcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Comment .

hpc:queuecontrolaction a owl:ObjectProperty ;
    rdfs:domain hpc:Queuecontrolcommand ;
    rdfs:range rdfs:Literal .

hpc:dispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Timeperiod .

hpc:Timeperiod a owl:Class .

hpc:queuestatus a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdfs:Literal .

hpc:queueState a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:unionOf (hpc:Closed ;
                 hpc:Open ;
                 hpc:Deactivated ;
                 hpc:Activated) .

hpc:Closed a owl:Class ;
    rdfs:subClassOf hpc:Queuestate .

hpc:Open a owl:Class ;
    rdfs:subClassOf hpc:Queuestate .

hpc:Deactivated a owl:Class ;
    rdfs:subClassOf hpc:Queuestate .

hpc:Activated a owl:Class ;
    rdfs:subClassOf hpc:Queuestate .

hpc:queuecontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range (hpc:Open ;
                 hpc:Close ;
                 hpc:Activate ;
                 hpc:Deactivate) .

hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuecontrolcommand ;
    rdfs:range xsd:string .

hpc:queueadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:User .

hpc:hostrestriction a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Host .

hpc:jobrestriction a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .
