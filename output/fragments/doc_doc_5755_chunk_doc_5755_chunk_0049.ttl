hpc:TaskPrologScript a owl:Class .
hpc:hasOutputType a owl:ObjectProperty .
hpc:StandardOutput hpc:hasOutputType owl:NamedIndividual(<http://example.org/hpc#StandardOutput>) .
hpc:EnvironmentVariableOutput hpc:hasOutputType owl:NamedIndividual(<http://example.org/hpc#EnvironmentVariableOutput>) .
hpc:TaskPrologScript rdfs:subClassOf owl:Class .
hpc:StandardOutput rdf:type owl:NamedIndividual .
hpc:EnvironmentVariableOutput rdf:type owl:NamedIndividual .
hpc:StandardOutput rdfs:domain hpc:TaskPrologScript .
hpc:EnvironmentVariableOutput rdfs:domain hpc:TaskPrologScript .
hpc:SLURM_STEP_ID rdf:type owl:DatatypeProperty .
hpc:SLURM_PROCID rdf:type owl:DatatypeProperty .
hpc:SLURM_JOB_ID rdf:type owl:DatatypeProperty .
hpc:SLURM_JOB_NODELIST rdf:type owl:DatatypeProperty .
