hpc:Job a owl:Class .
hpc:state a owl:DatatypeProperty .
hpc:ExitCode a xsd:nonNegativeInteger .
hpc:Partition a owl:Class .
hpc:User a owl:Class .
hpc:Node a owl:Class .
hpc:Nodelist a owl:Class .
hpc:reason a owl:DatatypeProperty .
hpc:requeuecommand a owl:ObjectProperty .
hpc:heldstate a owl:DatatypeProperty .
hpc:Resourcelimit a owl:Class .
hpc:propagated a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:State rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Exitcode rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Partition rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Node rdfs:subClassOf owl:Class .
hpc:Nodelist rdfs:subClassOf owl:Class .
hpc:Reason rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Requeuecommand rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Heldstate rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Resourcelimit rdfs:subClassOf owl:Class .
hpc:Propagated rdfs:domain hpc:Resourcelimit ;
    rdfs:range xsd:boolean .
