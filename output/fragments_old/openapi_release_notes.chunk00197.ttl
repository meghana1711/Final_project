hpc:SlurmNodeResponse a owl:Class .
hpc:SlurmPartitionResponse a owl:Class .

hpc:hasSlurmNodeResponse a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range hpc:SlurmNodeResponse .

hpc:hasSlurmPartitionResponse a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:SlurmPartitionResponse .

hpc:v0.0.40_openapi_nodes_resp a hpc:SlurmNodeResponse ;
    rdf:type owl:NamedIndividual .

hpc:v0.0.40_openapi_partition_resp a hpc:SlurmPartitionResponse ;
    rdf:type owl:NamedIndividual .

hpc:SlurmNode a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Partition a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .
```
