hpc:Clustername a owl:Class .
hpc:Cluster a owl:Class .
hpc:servers a owl:ObjectProperty .
hpc:Hasclustername rdfs:domain hpc:Clustername ;
                    rdfs:range xsd:string .
hpc:Hasservers rdfs:domain hpc:Cluster ;
                 rdfs:range rdf:List .
hpc:List a owl:Class ;
          rdfs:subClassOf owl:Collection .
hpc:listmember a owl:ObjectProperty ;
               rdfs:domain hpc:List ;
               rdfs:range xsd:string .
