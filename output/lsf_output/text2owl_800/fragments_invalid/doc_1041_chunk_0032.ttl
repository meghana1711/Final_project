hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Status a owl:Class .
hpc:Queue a owl:Class .
hpc:command a owl:DatatypeProperty .
hpc:jobdescription a owl:DatatypeProperty .
hpc:submittedfrom a owl:ObjectProperty .
hpc:dispatchedto a owl:ObjectProperty .
hpc:completed a owl:ObjectProperty .
hpc:exceptionstatus a owl:DatatypeProperty .
hpc:Accountinginformation a owl:Class .
hpc:cpuT a owl:DatatypeProperty .
hpc:wait a owl:DatatypeProperty .
hpc:turnaround a owl:DatatypeProperty .
hpc:hogFactor a owl:DatatypeProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swap a owl:DatatypeProperty .
hpc:cpuPeak a owl:DatatypeProperty .
hpc:cpuPeakDuration a owl:DatatypeProperty .
hpc:cpuPeakEfficiency a owl:DatatypeProperty .
hpc:cpuAvgEfficiency a owl:DatatypeProperty .
hpc:memEfficiency a owl:DatatypeProperty .
hpc:Job a rdfs:subClassOf [ rdf:type owl:Class ;
                             rdfs:subClassOf hpc:Resource ] .
hpc:User a rdfs:subClassOf owl:Class .
hpc:Project a rdfs:subClassOf owl:Class .
hpc:Status rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:Command rdfs:domain hpc:Job ;
                               rdfs:range xsd:string .
hpc:Jobdescription rdfs:domain hpc:Job ;
                               rdfs:range xsd:string .
hpc:Submittedfrom rdfs:domain hpc:Job ;
                     rdfs:range xsd:string .
hpc:Dispatchedto rdfs:domain hpc:Job ;
                   rdfs:range xsd:string .
hpc:Completed rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Exceptionstatus rdfs:domain hpc:Job ;
                      rdfs:range xsd:string .
hpc:Accountinginformation rdfs:subClassOf hpc:Job .
hpc:CpuT rdfs:domain hpc:Accountinginformation ;
               rdfs:range xsd:decimal .
hpc:Wait rdfs:domain hpc:Accountinginformation ;
              rdfs:range xsd:decimal .
hpc:Turnaround rdfs:domain hpc:Accountinginformation ;
               rdfs:range xsd:decimal .
hpc:HogFactor rdfs:domain hpc:Accountinginformation ;
               rdfs:range xsd:decimal .
hpc:Mem rdfs:domain hpc:Accountinginformation ;
              rdfs:range xsd:decimal
