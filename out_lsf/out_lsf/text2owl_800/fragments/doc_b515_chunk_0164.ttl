hpc:gpuRunTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:decimal .

hpc:numberCpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbNcpuEnforce a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:UserBasedFairShare a owl:Class ;
    rdfs:subClassOf hpc:FairShare .

hpc:QueueLevelUserBasedFairShare a owl:Class ;
    rdfs:subClassOf hpc:UserBasedFairShare .

hpc:HostPartitionUserBasedFairShare a owl:Class ;
    rdfs:subClassOf hpc:UserBasedFairShare .

hpc:UserShareAssignment a owl:Class .

hpc:user a owl:ObjectProperty ;
    rdfs:domain hpc:UserShareAssignment ;
    rdfs:range hpc:User .

hpc:numberShares a owl:DatatypeProperty ;
    rdfs:domain hpc:UserShareAssignment ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Queue a owl:Class .
hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Gpu a owl:Class .
hpc:FairShare a owl:Class .
