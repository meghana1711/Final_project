@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Queues a owl:Class .
hpc:Users a owl:Class .
hpc:Projects a owl:Class .
hpc:LicProjects a owl:Class .

hpc:hasuser a owl:ObjectProperty .
hpc:hasqueue a owl:ObjectProperty .
hpc:hasproject a owl:ObjectProperty .
hpc:haslicProject a owl:ObjectProperty .

hpc:slotlimit a owl:DatatypeProperty .
hpc:memorylimit a owl:DatatypeProperty .
hpc:jobcount a owl:DatatypeProperty .

hpc:Queue rdfs:subClassOf hpc:Queues .
hpc:User rdfs:subClassOf hpc:Users .
hpc:Project rdfs:subClassOf hpc:Projects .
hpc:LicProject rdfs:subClassOf hpc:LicProjects .

hpc:Hasuser rdfs:domain hpc:User ;
    rdfs:range hpc:Queues .

hpc:Hasqueue rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Hasproject rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:HaslicProject rdfs:domain hpc:LicProject ;
    rdfs:range xsd:string .

hpc:Slotlimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Memorylimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Jobcount rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
