hpc:dispatchwindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:default a owl:ObjectProperty ;
    rdfs:domain hpc:LsbHosts ;
    rdfs:range xsd:string .
hpc:jobcontrols a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbQueue ;
    rdfs:range xsd:string .
hpc:rerunnable a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbQueue ;
    rdfs:range xsd:string .
hpc:lsbJsmDefault a owl:DatatypeProperty ;
