hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:showsadvancereservations a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Advancereservation .

hpc:showsadvancereservationpolicies a owl:ObjectProperty ;
