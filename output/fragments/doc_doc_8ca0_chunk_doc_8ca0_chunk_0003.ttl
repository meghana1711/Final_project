hpc:Node a owl:Class .
hpc:Program a owl:Class .
hpc:SlurmHostlistExpressionFormat a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:ResumeTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Program ;
    rdfs:range xsd:nonNegativeInteger .
hpc:DownState a owl:Class .
hpc:BootTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:dateTime .
hpc:Job a owl:Class .
hpc:Extra a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:NodesAlloc a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:NodesResume a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Oversubscribe a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Partition a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Reservation a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:SLURM_RESUME_FILE a owl:DatatypeProperty ;
    rdfs:domain hpc:Program ;
    rdfs:range xsd:anyURI .
hpc:ResumeRate a owl:DatatypeProperty ;
    rdfs:domain hpc:Program ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ResumeProgram a owl:ObjectProperty .
hpc:scontrolShowNodename a owl:ObjectProperty .
hpc:AllNodesResume a hpc:Job ;
hpc:Jobs a owl:Class .
hpc:Cloud a owl:Class .
hpc:Cloud_exclusive a rdfs:subClassOf hpc:Cloud .
