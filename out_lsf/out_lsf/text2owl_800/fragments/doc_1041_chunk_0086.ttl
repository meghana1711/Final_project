hpc:LogLevel
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:LogFile
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:logFile_name
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:daemon_name
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:host_name
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:LSF_LOG_MASK
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfig ;
    rdfs:range hpc:Loglevel .

hpc:LOG_DEBUG
    a owl:Class ;
    rdfs:subClassOf hpc:Loglevel .

hpc:LOG_DEBUG1
    a owl:Class ;
    rdfs:subClassOf hpc:Loglevel ;
    rdfs:subClassOf hpc:LogDebug .

hpc:LOG_DEBUG2
    a owl:Class ;
    rdfs:subClassOf hpc:Loglevel ;
    rdfs:subClassOf hpc:LogDebug1 .

hpc:LOG_DEBUG3
    a owl:Class ;
    rdfs:subClassOf hpc:Loglevel ;
    rdfs:subClassOf hpc:LogDebug2 .
