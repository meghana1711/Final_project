hpc:RelativeQOS a owl:Class .
hpc:hasFlag a owl:ObjectProperty .
hpc:hasFlag rdfs:domain hpc:QOS ;
                        rdfs:range xsd:integer .

hpc:QOS a owl:Class .
hpc:hasPartitionQOS a owl:ObjectProperty .
hpc:hasPartitionQOS rdfs:domain hpc:QOS ;
                        rdfs:range hpc:QOS .

hpc:PartitionQOS a owl:Class ;
                 rdfs:subClassOf hpc:QOS .

hpc:canSubmitAsNormalJob a owl:ObjectProperty .
hpc:canSubmitAsNormalJob rdfs:domain hpc:QOS ;
                          rdfs:range xsd:boolean .

hpc:partitionRelativeLimit a owl:DatatypeProperty .
hpc:partitionRelativeLimit rdfs:domain hpc:PartitionQOS ;
                             rdfs:range xsd:decimal .

hpc:clusterRelativeLimit a owl:DatatypeProperty .
hpc:clusterRelativeLimit rdfs:domain hpc:RelativeQOS ;
                           rdfs:range xsd:decimal .

hpc:DenyOnLimit a owl:ObjectProperty .
hpc:DenyOnLimit rdfs:domain hpc:QOS ;
                 rdfs:range xsd:boolean .
