hpc:EpilogSlurmctld a owl:Class .
hpc:hasExitCode a owl:ObjectProperty ;
    rdfs:domain hpc:EpilogSlurmctld ;
    rdfs:range xsd:integer .

hpc:hasExitSignal a owl:ObjectProperty ;
    rdfs:domain hpc:EpilogSlurmctld ;
    rdfs:range xsd:integer .

hpc:requeueableJob a owl:Class ;
    rdfs:subClassOf hpc:EpilogSlurmctld .

hpc:hasRequeueExitCode a owl:DatatypeProperty ;
    rdfs:domain hpc:RequeueableJob ;
    rdfs:range xsd:integer .

hpc:hasState a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Job a owl:Class .
hpc:hasId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:SpecialExit a owl:NamedIndividual ;
    hpc:hasId "SpecialExit" .

hpc:COMPLETE a owl:NamedIndividual ;
    hdfs:hasId "COMPLETE" .

hpc:SLURM a owl:Class .
hpc:hasConfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:SLURM ;
    rdfs:range hpc:TaskPlugin .

hpc:TaskPlugin a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:subClassOf owl:Class ;
    owl:oneOf (affinity rdf:PlainLiteral "cgroup"^) .

hpc:hasProcessorConfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:SLURM ;
    rdfs:range hpc:ProcessorConfiguration .

hpc:ProcessorConfiguration a owl:Class .
hpc:hasScalingAvailableGovernors a owl:DatatypeProperty ;
    rdfs:domain hpc:ProcessorConfiguration ;
    rdfs:range xsd:string .

hpc:hasCPUFrequencyControl a owl:ObjectProperty ;
    rdfs:domain hpc:ProcessorConfiguration ;
    rdfs:range xsd:boolean .

hpc:hasIntelPstate a owl:ObjectProperty ;
    rdfs:domain hpc:ProcessorConfiguration ;
    rdfs:range xsd:boolean .

hpc:scontrolRequeue a owl:ObjectProperty ;
    rdfs:domain hpc:EpilogSlurmctld ;
    rdfs:range hpc:Job .

hpc:salloc a owl:ObjectProperty ;
    rdfs:domain hpc:SLURM ;
    rdfs:range hpc:ShellOnNode .

hpc:ShellOnNode a owl:Class .
hpc:hasShell a owl:DatatypeProperty ;
    rdfs:domain hpc:ShellOnNode ;
    rdfs:range xsd:string .

hpc:hasNode a owl:ObjectProperty ;
    rdfs:domain hpc:ShellOnNode ;
