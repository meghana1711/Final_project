hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an advance reservation in LSF." .

hpc:Postarscript a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a script that is run when an advance reservation expires." .

hpc:hasPostARScript rdf:Property ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Postarscript ;
    rdfs:comment "Relates an advance reservation to the script that is run when it expires." .

hpc:arname a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string ;
    rdfs:comment "Provides the name of the advance reservation." .

hpc:arqueuelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:string ;
    rdfs:comment "Provides the list of queues whose jobs can be run in this advance reservation." .
