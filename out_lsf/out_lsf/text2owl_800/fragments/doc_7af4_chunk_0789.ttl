hpc:LsfDataCluster a owl:Class .
hpc:lsfDataHosts a owl:ObjectProperty .

hpc:LsfDataCluster rdfs:subClassOf owl:Class .
hpc:LsfDataHosts rdfs:subClassOf owl:ObjectProperty .

hpc:Hasdatacluster rdfs:domain hpc:LsfDataCluster ;
    rdfs:range rdf:Resource .

hpc:Hasdatahosts rdfs:domain hpc:LsfDataCluster ;
    rdfs:range xsd:string .

hpc:Isdatamanagerhost rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:boolean .

hpc:Islsfserver rdfs:domain xsd:string ;
    rdfs:range xsd:boolean .

hpc:startdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .

hpc:stopdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .

hpc:shutdowndatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .

hpc:restartdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .

hpc:startlim a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .

hpc:startmanagementhosts a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range xsd:string .
