hpc:Totalreserve a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The number of licenses that are reserved for LSF License Scheduler projects." .

hpc:Totalfree a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The number of free licenses that are available to LSF License Scheduler projects." .

hpc:Totalreserve hpc:isreservedby rdf:Resource .
hpc:Totalfree hpc:isfreefor rdf:Resource .

# Other Licenses
hpc:Others a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The number of licenses that are checked out by users who are not submitting their jobs to LSF License Scheduler projects." .

hpc:Others hpc:ischeckedoutby rdf:Resource .

# LSF Workload Licenses
hpc:LsfUse a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of licenses in use by LSF License Scheduler projects in the LSF workload." .

hpc:LsfDeserve a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of licenses that are assigned to LSF License Scheduler projects in the LSF workload." .

hpc:LsfFree a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of free licenses available to LSF License Scheduler projects in the LSF workload." .

hpc:LsfUse rdfs:subClassOf hpc:Totaluse .
hpc:LsfDeserve rdfs:subClassOf hpc:Totaldeserve .
hpc:LsfFree rdfs:subClassOf hpc:Totalfree .

# Non-LSF Workload Licenses
hpc:NonLsfUse a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of licenses in use by projects in the non-LSF workload." .

hpc:NonLsfDeserve a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of licenses that are assigned to projects in the non-LSF workload." .

hpc:NonLsfFree a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The total number of free licenses available to projects in the non-LSF workload." .

hpc:NonLsfUse rdfs:subClassOf hpc:Totaluse .
hpc:NonLsfDeserve rdfs:subClassOf hpc:Totaldeserve .
hpc:NonLsfFree rdfs:subClassOf hpc:Totalfree .

# Properties
hpc:isreservedby a owl:ObjectProperty ;
    rdfs:domain hpc:Totalreserve ;
    rdfs:range rdf:Resource ;
    rdfs
