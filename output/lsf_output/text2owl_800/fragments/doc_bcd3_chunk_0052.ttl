hpc:Engineer a owl:Class .
hpc:User a owl:Class .
hpc:Groupadmin a owl:Class .
hpc:Usergroup a owl:Class .
hpc:hasEngineer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:Engineer .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:User .
hpc:hasGroupAdmin rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:Groupadmin .
hpc:GroupX a hpc:UserGroup ;
    hpc:Hasgroupadmin hpc:admina ;
    hpc:Hasuser hpc:user2 .
hpc:groupX a hpc:Group ;
    hpc:Hasadmin hpc:admina ;
    hpc:Hasmember hpc:user2 .
hpc:groupZ a hpc:Group ;
    hpc:Hasadmin hpc:admina ;
    hpc:hasMember (hpc:user2) .
hpc:drafting a hpc:UserGroup ;
    hpc:hasGroupAdmin (hpc:adminA hpc:adminB) ;
    hpc:hasUser (hpc:user1 hpc:user10 hpc:user12) .
hpc:Queue a owl:Class .
hpc:hasState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Open a hpc:QueueState .
hpc:Closed a hpc:QueueState .
hpc:Active a hpc:QueueState .
hpc:Inactive a hpc:QueueState .
hpc:AcceptsNewJobs a hpc:QueueStateProperty .
hpc:StartsJobs a hpc:QueueStateProperty .
hpc:Collecting a hpc:QueueState .
hpc:Draining a hpc:QueueState .
hpc:AllActivityStopped a hpc:QueueState .
hpc:NormalProcessing a hpc:QueueState .
