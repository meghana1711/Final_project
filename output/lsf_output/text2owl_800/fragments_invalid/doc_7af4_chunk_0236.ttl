@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Hostgroup a owl:Class .
hpc:GroupA a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "host*" ] ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:isDefinedBy <http://example.org/admin#> .
hpc:GroupB a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "*A" ] ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:isDefinedBy <http://example.org/admin#> .
hpc:GroupC a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "hostB*" ;
                      owl:allValuesFrom ( [ rdf:type hpc:Host ;
                                            xsd:minInclusive "51" ;
                                            xsd:maxInclusive "100" ]
                                      union
                                      [ rdf:type hpc:Host ;
                                        xsd:minInclusive "151" ;
                                        xsd:maxInclusive "200" ] ) ] ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:isDefinedBy <http://example.org/admin#> .
hpc:GroupD a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "usergroupJ" ] ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/admin#> .
hpc:GroupE a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "" ] ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:isDefinedBy <http://example.org/admin#> .
hpc:GroupF a hpc:HostGroup ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:GROUP_MEMBER ;
                      owl:hasValue "*" ] ;
