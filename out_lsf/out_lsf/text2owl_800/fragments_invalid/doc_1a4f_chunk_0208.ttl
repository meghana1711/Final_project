hpc:Status a owl:Class .
hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:run a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Status .
hpc:maxnjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:ssusp a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:ususp a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:rsv a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:defaultresreqorder a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:packjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Order .
hpc:Order a owl:Class .
hpc:fewestfreeslots a owl:ObjectProperty ;
    rdfs:domain hpc:Order .
hpc:smallestnumberofjobslots a owl:ObjectProperty ;
    rdfs:domain hpc:Order .
hpc:Lsf a owl:Class .

hpc:hostA a hpc:Host ;
    hpc:SLots 4 ;
    hpc:NJobs 0 ;
    hpc:SSUSP "ok" ;
    hpc:USUSP "ok" ;
    hpc:RSV 0 ;
    hpc:Run job1 .
hpc:hostA a hpc:Host ;
    hpc:SLots 4 ;
    hpc:NJobs 0 ;
    hpc:SSUSP "ok" ;
    hpc:USUSP "ok" ;
    hpc:RSV 0 ;
    hpc:Run job2 .
hpc:hostA a hpc:Host ;
    hpc:SLots 4 ;
    hpc:NJobs 0 ;
    hpc:SSUSP "ok" ;
    hpc:USUSP "ok" ;
    hpc:RSV 0 ;
    hpc:Run job3 .

hpc:job1 a hpc:Job .
hpc:job2 a hpc:Job .
hpc:job3 a hpc:Job .

hpc:parallelJob a hpc:Job ;
    hpc:Run hpc:nojob .
hpc:parallelJob a hpc:Job ;
    hpc:n 4 ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:nojob ;
    hpc:Run hpc:no
