hpc:Executionenvironment a owl:Class .
hpc:commandsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Executionenvironment ;
    rdfs:range hpc:Jobstarter .

hpc:Jobstarter a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:unionOf (hpc:PreserveStarter hpc:AugmentStarter) ] .

hpc:Preservestarter a owl:Class ;
    rdfs:subClassOf hpc:Jobstarter ;
    rdfs:comment "Preserves the default user environment of the execution host; does not include any submission host settings" .

hpc:Augmentstarter a owl:Class ;
    rdfs:subClassOf hpc:Jobstarter ;
    rdfs:comment "Augments the default user environment of the execution host by adding settings from the submission host that are not already defined on the execution host" .

hpc:Dynamicipaddressing a owl:Class .
hpc:dhcp a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicipaddressing ;
    rdfs:range hpc:Protocol .

hpc:Protocol a owl:Class .

hpc:Lsfhost a owl:Class .
hpc:dhcpclient a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:boolean .

hpc:Userconnection a owl:Class .
hpc:dynamicipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Userconnection ;
    rdfs:range xsd:string .

hpc:dns a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Ipaddressingmethod .

hpc:Ipaddressingmethod a owl:Class .
