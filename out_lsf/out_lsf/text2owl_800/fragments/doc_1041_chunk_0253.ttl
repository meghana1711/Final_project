hpc:Bjgroup a owl:Class .
hpc:groupName a owl:ObjectProperty .
hpc:nslots a owl:DatatypeProperty .
hpc:pend a owl:DatatypeProperty .
hpc:run a owl:DatatypeProperty .
hpc:ssusp a owl:DatatypeProperty .
hpc:ususp a owl:DatatypeProperty .
hpc:rsv a owl:DatatypeProperty .
hpc:sla a owl:DatatypeProperty .
hpc:owner a owl:ObjectProperty .

hpc:Job a owl:Class .
hpc:PUCCINI a hpc:Job .
hpc:USER1 rdf:value "user1"^^xsd:string ;
        hpc:Owner hpc:puccini .

hpc:jobid a owl:DatatypeProperty .
hpc:indexlist a owl:DatatypeProperty .

hpc:Bjobs a owl:Class .
hpc:display a owl:ObjectProperty ;
        rdfs:domain hpc:Bjobs ;
        rdfs:range hpc:Job .
hpc:filter a owl:ObjectProperty ;
        rdfs:domain hpc:Bjobs .

hpc:Option a owl:Class .
hpc:categoryName a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:all a owl:ObjectProperty ;
        rdfs:range hpc:Option .

hpc:Category a owl:Class .
hpc:filterType a owl:ObjectProperty ;
        rdfs:domain hpc:Category .
hpc:option a owl:ObjectProperty ;
        rdfs:range hpc:Option .
