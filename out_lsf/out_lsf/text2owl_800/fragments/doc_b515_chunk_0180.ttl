hpc:Hostpartition a owl:Class .
hpc:HpartName rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:string .
hpc:Hosts rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:string .
hpc:UserShares rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:List .
hpc:Usershare a owl:Class ;
    rdfs:subClassOf hpc:UserShares .
hpc:Group rdfs:domain hpc:Usershare ;
    rdfs:range xsd:string .
hpc:Share rdfs:domain hpc:Usershare ;
    rdfs:range xsd:decimal .
hpc:all a owl:NamedIndividual ;
    hpc:HPART_NAME "all" .
hpc:submitjobtofairsharequeue a owl:ObjectProperty .
hpc:Hasshareassignment rdfs:domain hpc:User ;
    rdfs:range xsd:boolean .
hpc:Hasqueue rdfs:domain hpc:User ;
    rdfs:range rdf:List .
hpc:Queue a owl:Class .
hpc:QueueName rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Users rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Fairshare rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .
