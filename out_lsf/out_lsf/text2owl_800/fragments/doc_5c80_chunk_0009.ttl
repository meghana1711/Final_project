hpc:Jobmodification a owl:Class .
hpc:Jobarraymodification a owl:Class .
hpc:Serviceclassmodification a owl:Class .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range hpc:Job .

hpc:hasjobarray a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarraymodification ;
    rdfs:range hpc:Jobarray .

hpc:hasserviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclassmodification ;
    rdfs:range hpc:Serviceclass .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty hpc:hasServiceClass ;
                                              owl:allValuesFrom hpc:ServiceClass ] ] .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty hpc:hasJobArrayElement ;
                                              owl:allValuesFrom hpc:Job ] ] .

hpc:Serviceclass a owl:Class .

hpc:replacecommandline a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:string .

hpc:changeparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:string .

hpc:resetparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:string .

hpc:attachserviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclassmodification ;
    rdfs:range hpc:Job .

hpc:cannotusesla a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclassmodification ;
    rdfs:range xsd:boolean .

hpc:cannotmovejobarrayelements a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclassmodification ;
    rdfs:range xsd:boolean .

hpc:cannotmodifyserviceclassofjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceclassmodification ;
    rdfs:range xsd:boolean .
