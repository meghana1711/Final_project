# Fragment: doc_2770_chunk_0005.ttl
hpc:bfMaxjobtest a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of jobs consider for backfill scheduling in each backfill cycle. Default value is 100 jobs." .

hpc:bfMaxjobuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of jobs to initiate per user in each backfill cycle. Default value is 0 (no limit)." .

hpc:bfMaxtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum time in seconds the backfill scheduler can spend (including time spent sleeping when locks are released) before discontinuing. The default value is the value of bf_interval, which defaults to 30 seconds." .

hpc:bfOneresvperjob a owl:ObjectProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Disallow adding more than one backfill reservation per job. This option makes it so that a job submitted to multiple partitions will stop reserving resources once the first job-partition pair has booked a backfill reservation." .

hpc:bfResolution a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Time resolution of backfill scheduling." .

# Fragment: doc_2770_chunk_0006.ttl
hpc:bfresolution a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "Time resolution of backfill scheduling. Default value is 60 seconds." .

hpc:bfwindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "How long, in minutes, into the future to look when determining when and where jobs can start. Higher values result in more overhead and less responsiveness." .

hpc:bfyieldinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "The backfill scheduler will periodically relinquish locks in order for other pending operations to take place. This specifies the times when the locks are relinquished in microseconds." .

hpc:bfyieldsleep a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "The backfill scheduler will periodically relinquish locks in order for other pending operations to take place. This specifies the length of time for which the locks are relinquished in microseconds." .

hpc:Backfillscheduler a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a backfill scheduler." .

# Fragment: doc_2770_chunk_0007.ttl
hpc:lockreleasetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lock ;
    rdfs:range xsd:unsignedLong ;
    rdfs:comment "This specifies the length of time for which the locks are relinquished in microseconds." .

hpc:LockReleaseTime rdfs:subPropertyOf hpc:TimeDuration .

hpc:Lockreleasetime a rdfs:Class ;
    rdfs:subClassOf owl:Class .

hpc:DefaultLockReleaseTime a owl:NamedIndividual ;
    hpc:LockReleaseTime "500000"^^xsd:unsignedLong .

# Fragment: doc_2770_chunk_0008.ttl
hpc:Defaultvalue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the default value, which is 500,000 microseconds (0.5 seconds)." .

hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Defaultvalue ;
    rdfs:range xsd:decimal .

