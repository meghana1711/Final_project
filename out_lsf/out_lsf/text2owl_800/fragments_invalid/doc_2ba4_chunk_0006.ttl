hpc:Job a owl:Class .
hpc:rusageduration a owl:DatatypeProperty .
hpc:License a owl:Class .
hpc:Licenseserver a owl:Class .
hpc:Licenseusage a owl:Class .
hpc:Licenseinuse a owl:Class .
hpc:Availablelicenses a owl:Class .
hpc:Totallicenses a owl:Class .
hpc:Lsflicensescheduler a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:CheckoutLicense an owl:ObjectProperty .
hpc:ReserveLicense an owl:ObjectProperty .
hpc:ReleaseLicense an owl:ObjectProperty .
hpc:DispatchJob an owl:ObjectProperty .
hpc:Hasrusageduration rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Manageslicenseresources rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:Licenseserver .
hpc:Trackslicenseuse rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:Job .
hpc:Getlicenseusage rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:Licenseusage .
hpc:Checkoutmatchesjob rdfs:domain hpc:Checkoutlicense ;
    rdfs:range hpc:Job .
hpc:Reserveslicenses rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:Job .
hpc:Releaseslicenses rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:License .
hpc:Dispatchesjob rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range hpc:Job .
hpc:Hasavailablelicenses rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Availablelicenses .
hpc:Hastotallicenses rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Totallicenses .
hpc:Hasinuselicenses rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Licenseinuse .
hpc:hasexternalloadindices a owl:ObjectProperty .
