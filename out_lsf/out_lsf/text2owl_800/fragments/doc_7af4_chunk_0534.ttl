hpc:Userlimit a owl:Class .
hpc:hasuser a owl:ObjectProperty .
hpc:Hasuser rdfs:domain hpc:Userlimit ;
                        rdfs:range rdf:List .
hpc:Userlist a owl:Class ;
               rdfs:subClassOf xsd:nonNegativeInteger .
hpc:User a owl:Class .
hpc:hasusername a owl:DatatypeProperty ;
                   rdfs:range xsd:string .
hpc:Usergroup a owl:Class .
hpc:hasusergroup a owl:DatatypeProperty ;
                     rdfs:range xsd:string .
hpc:excludequeues a owl:DatatypeProperty ;
                      rdfs:range rdf:List .
hpc:Queue a owl:Class .

hpc:Userlimit rdfs:subClassOf owl:Class .
hpc:Hasuser rdfs:domain hpc:Userlimit ;
                   rdfs:range hpc:Userlist .
hpc:Userlist rdfs:subClassOf xsd:nonNegativeInteger .
hpc:User rdfs:subClassOf hpc:Userlimit .
hpc:Hasusername rdfs:domain hpc:User .
hpc:Usergroup rdfs:subClassOf hpc:User .
hpc:Hasusergroup rdfs:domain hpc:Usergroup .
hpc:Excludequeues rdfs:domain hpc:Userlimit .
hpc:Excludequeues rdfs:range rdf:List .
hpc:Queue rdfs:subClassOf owl:Class .
