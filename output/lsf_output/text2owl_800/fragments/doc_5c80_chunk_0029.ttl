hpc:Jobsubmission a owl:Class .
hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Resourcereservation .

hpc:Resourcereservation a owl:Class .
hpc:tmpspace a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:decimal .
hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:decay a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:dateTime .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:dateTime .
