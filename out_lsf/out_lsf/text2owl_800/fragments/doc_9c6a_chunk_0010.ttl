hpc:Downloadfile a owl:Class ;
    rdfs:comment "A file downloaded to apply a fix." .

hpc:filename a owl:DatatypeProperty ;
    rdfs:domain hpc:Downloadfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the downloaded file." .

hpc:Readmefile a owl:Class ;
    rdfs:subClassOf hpc:Downloadfile ;
    rdfs:comment "A readme file downloaded with a fix." .

hpc:subscribenotification a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range hpc:Notification ;
    rdfs:comment "Subscribing to notifications about LSF fixes." .

hpc:Notification a owl:Class ;
    rdfs:comment "Information about product solution and patch updates." .

hpc:Productupdate a owl:Class ;
    rdfs:subClassOf hpc:Notification ;
    rdfs:comment "Information about product solution updates." .

hpc:Fix a owl:Class ;
    rdfs:subClassOf hpc:Notification ;
    rdfs:comment "Information about LSF fixes." .

hpc:Troubleshooting a owl:Class ;
    rdfs:subClassOf hpc:Notification ;
    rdfs:comment "Information about troubleshooting." .

hpc:Productenhancement a owl:Class ;
    rdfs:subClassOf hpc:Notification ;
    rdfs:comment "Information about product enhancements." .

hpc:Documentationchange a owl:Class ;
    rdfs:subClassOf hpc:Notification ;
    rdfs:comment "Information about documentation changes." .

hpc:Ibmspectrumlsf a owl:Class ;
    rdfs:comment "IBM Spectrum LSF." .

hpc:Fixpack a owl:Class ;
    rdfs:subClassOf hpc:Ibmspectrumlsf ;
    rdfs:comment "A fix pack for IBM Spectrum LSF." .

hpc:Upgrade a owl:Class ;
    rdfs:comment "Upgrading an LSF cluster to the latest version." .

hpc:Lsfclusterupgrade a owl:Class ;
    rdfs:subClassOf hpc:Upgrade ;
    rdfs:comment "Upgrading an existing LSF cluster." .

hpc:Windows a owl:Class ;
    rdfs:comment "The Windows operating system." .

hpc:Lsfclusteronwindows a owl:Class ;
    rdfs:subClassOf hpc:Lsfclusterupgrade ;
    rdfs:comment "Upgrading an LSF cluster on Windows." .
