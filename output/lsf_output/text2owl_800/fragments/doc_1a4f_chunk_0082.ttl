hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobQueue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:bjobs a owl:ObjectProperty .
hpc:bswitch a owl:ObjectProperty .
hpc:lsbConfdir a owl:DatatypeProperty .
hpc:clusterName a owl:DatatypeProperty .
hpc:conﬁgdir a owl:DatatypeProperty .
hpc:lsbQueues a owl:DatatypeProperty .
hpc:badminReconfig a owl:ObjectProperty .
hpc:jobSwitched a owl:ObjectProperty .

hpc:JobSwitched rdfs:domain hpc:Job .
hpc:JobSwitched rdfs:range hpc:Queue .
