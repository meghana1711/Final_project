@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LsfUserDomain a owl:Class .
hpc:LsfVplugin a owl:Class .
hpc:LsfWindowsHostTypes a owl:Class .

hpc:Haswindowsdomains rdfs:domain hpc:LsfUserDomain ;
  rdfs:range xsd:string .

hpc:Hasvpluginpath rdfs:domain hpc:LsfVplugin ;
  rdfs:range xsd:string .

hpc:Haswindowshosttypes rdfs:domain hpc:LsfWindowsHostTypes ;
  rdfs:range xsd:string .

hpc:LsfUserDomain rdfs:subClassOf owl:Class .
hpc:LsfVplugin rdfs:subClassOf owl:Class .
hpc:LsfWindowsHostTypes rdfs:subClassOf owl:Class .
