hpc:Interactivejob a owl:Class .
hpc:Batchjob a owl:Class .
hpc:Queue a owl:Class .
hpc:AcceptsInteractiveJobs an owl:ObjectProperty .
hpc:AcceptsBatchJobs an owl:ObjectProperty .
hpc:schedulingpolicies a owl:DatatypeProperty .

hpc:Interactivejob rdfs:subClassOf hpc:Job .
hpc:Batchjob rdfs:subClassOf hpc:Job .
hpc:Queue rdfs:subClassOf owl:Class .

hpc:Acceptsinteractivejobs rdfs:domain hpc:Queue .
hpc:Acceptsinteractivejobs rdfs:range hpc:Interactivejob .
hpc:Acceptsbatchjobs rdfs:domain hpc:Queue .
hpc:Acceptsbatchjobs rdfs:range hpc:Batchjob .

hpc:Schedulingpolicies rdfs:domain hpc:Queue .
hpc:Schedulingpolicies rdfs:range xsd:string .

hpc:NO_INTERACTIVE xsd:string "NO_INTERACTIVE" .
hpc:ONLY_INTERACTIVE xsd:string "ONLY_INTERACTIVE" .
