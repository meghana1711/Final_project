hpc:Lsfwebserviceinstallation a owl:Class .
hpc:installationlog a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfwebserviceinstallation ;
    rdfs:range xsd:string .
hpc:installationdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfwebserviceinstallation ;
    rdfs:range xsd:string .
hpc:licenseagreementacceptance a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceinstallation ;
    rdfs:range xsd:boolean .
hpc:httpssupport a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebserviceinstallation ;
    rdfs:range xsd:boolean .
hpc:Webservicefile a owl:Class ;
    rdfs:subClassOf hpc:Lsfwebserviceinstallation .
hpc:Highavailability a owl:Class .
hpc:Apachehttpserverproxy a owl:Class .
hpc:httpproxyconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserverproxy ;
    rdfs:range hpc:Httpproxyconfiguration .
hpc:httpspproxyconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Apachehttpserverproxy ;
    rdfs:range hpc:Httpspproxyconfiguration .
