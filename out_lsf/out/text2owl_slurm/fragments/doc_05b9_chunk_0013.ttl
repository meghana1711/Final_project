hpc:Instance a owl:Class .
hpc:Openapiinstancesresp a owl:Class .
hpc:Job a owl:Class .
hpc:Slurmdbdjobsresp a owl:Class .

hpc:instance_id rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:cluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:extra rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:format rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:instance_type rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:node_list rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .
hpc:time_start rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:xsd:int .
hpc:time_end rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:xsd:int .

hpc:Openapiinstancesresp rdfs:subClassOf rdf:Resource .
hpc:Slurmdbdjobsresp rdfs:subClassOf rdf:Resource .

hpc:job_id rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
