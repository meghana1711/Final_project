# Database Hierarchy
hpc:Database a owl:Class .
hpc:DatabaseHierarchy a owl:Class .
hpc:DatabaseError a owl:Class .
hpc:Slurmdbd a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:SlurmctldData a owl:Class .
hpc:SlurmctldLogFile a owl:Class .
hpc:SlurmdbdOption a owl:Class .
hpc:Cluster a owl:Class .
hpc:Node a owl:Class .
hpc:Assoc a owl:Class .

hpc:hasParentId rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Assoc ;
    rdfs:range xsd:integer .

hpc:operateOn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmdbdOption ;
    rdfs:range hpc:Cluster .

# High Availability
hpc:HighAvailability a owl:Class .
hpc:MySQLSetup a owl:Class .
hpc:ShortOutage a owl:Class .
hpc:SlurmdbdOutage a owl:Class .
hpc:SlurmctldDataInMemory a owl:Class .
hpc:SlurmctldCache a owl:Class .
hpc:NDB a owl:Class .
hpc:LinuxHA a owl:Class .
hpc:HeartbeatCorosync a owl:Class .
hpc:OneWayReplication a owl:Class .
hpc:PrimaryBackupRoles a owl:Class .
hpc:SharedStorage a owl:Class .
hpc:PrimaryBackupFailure a owl:Class .

# MySQL Queries
hpc:SQLMode a owl:Class .
hpc:ANSI_QUOTES a owl:Class .
hpc:SetSession a owl:ObjectProperty .

# Compute Nodes (slurmd)
hpc:ComputeNode a owl:Class .
hpc:StateDOWN a owl:Class .
hpc:ReturnToService a owl:Class .
hpc:SlurmdDaemon a owl:Class .
hpc:SlurmdTimeout a owl:Class .
hpc:NodeConfiguration a owl:Class .

# Node Crash
hpc:NodeCrash a owl:Class .
hpc:SlurmdTimeoutValue a owl:DatatypeProperty .
hpc:NodeConfigurationInconsistency a owl:Class .

# Job Execution
hpc:JobExecution a owl:Class .
hpc:SelectType a owl:Class .
hpc:SelectConsT
