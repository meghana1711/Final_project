hpc:LinuxDistribution a owl:Class .
hpc:KernelConfig a owl:Class .
hpc:ConfigMemcgSwap a owl:DatatypeProperty .
hpc:SystemdJoinControllers a owl:ObjectProperty .
hpc:CgroupController a owl:Class .
hpc:Deprecated a owl:ObjectProperty .
hpc:WorksWithSlurm a owl:ObjectProperty .
hpc:CgroupVersion1LegacyMode a owl:Class .
hpc:MountedInSingleHierarchy a owl:ObjectProperty .
hpc:CgroupUnifiedMode a owl:ObjectProperty .
hpc:SeparateDirectories a owl:ObjectProperty .

hpc:LinuxDistribution rdfs:subClassOf xsd:string .
hpc:KernelConfig rdfs:subClassOf hpc:LinuxDistribution .
hpc:ConfigMemcgSwap rdfs:domain hpc:KernelConfig ;
                      rdfs:range xsd:boolean .
hpc:SystemdJoinControllers rdfs:domain hpc:LinuxDistribution ;
                             rdfs:range xsd:boolean .
hpc:CgroupController rdfs:subClassOf xsd:string .
hpc:Deprecated rdfs:domain hpc:SystemdJoinControllers ;
                   rdfs:range xsd:boolean .
hpc:WorksWithSlurm rdfs:domain hpc:CgroupController ;
                     rdfs:range xsd:boolean .
hpc:CgroupVersion1LegacyMode a owl:Class .
hpc:MountedInSingleHierarchy rdfs:domain hpc:CgroupVersion1LegacyMode ;
                               rdfs:range xsd:boolean .
hpc:CgroupUnifiedMode rdfs:domain hpc:CgroupVersion1LegacyMode ;
                        rdfs:range xsd:boolean .
hpc:SeparateDirectories rdfs:domain hpc:CgroupVersion1LegacyMode ;
                          rdfs:range xsd:boolean .
