hpc:Gpurequirement a owl:Class .
hpc:hasgpuinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hascomputeinstancesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:supportsmig a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:boolean .
hpc:Migsize a owl:Class ;
    rdfs:subClassOf hpc:Gpuinstancesize .
hpc:MIGSize "1" a hpc:MIGSize ;
    hpc:hasComputeInstanceSize "1" .
hpc:MIGSize "2" a hpc:MIGSize ;
    hpc:hasComputeInstanceSize "2" .
hpc:MIGSize "3" a hpc:MIGSize ;
    hpc:hasComputeInstanceSize "3" .
hpc:MIGSize "4" a hpc:MIGSize ;
    hpc:hasComputeInstanceSize "4" ;
    rdfs:subPropertyOf hpc:MIGSize .
hpc:MIGSize "7" a hpc:MIGSize ;
    hpc:hasComputeInstanceSize "7" .
hpc:Migsizecombination a owl:Class ;
    rdfs:subClassOf hpc:Migsize .
hpc:MIGSizeCombination "4" "3" a hpc:MIGSizeCombination .
hpc:MIGSizeCombination "7" "5" a hpc:MIGSizeCombination .
hpc:MIGSizeCombination "7" "6" a hpc:MIGSizeCombination .
hpc:gpuReqMerge a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:boolean .
hpc:Gpurequirementmerged a owl:Class ;
    rdfs:subClassOf hpc:Gpurequirement .
hpc:GPURequirementMerged "Y" a hpc:GPURequirementMerged .
hpc:GPURequirementMerged "y" a hpc:GPURequirementMerged .
hpc:gpurequirementmergedoverrides a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range hpc:Gpurequirement .
hpc:gpurequirementlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .
hpc:GPURequirementLevel "job" a hpc:GPURequirementLevel .
hpc:GPURequirementLevel "applicationProfile" a hpc:GPURequirementLevel .
hpc:GPURequirementLevel "queue" a hpc:GPURequirementLevel .
hpc:GPURequirementLevel "defaultCluster" a hpc:GPURequirementLevel .
hpc:gpurequirementlevelorder a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirementlevel ;
    rdfs:range hpc:Gpurequirementlevel ;
    rdfs:subPropertyOf rdf:list
