hpc:Command a owl:Class .
hpc:hashelpoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Helpoption .
hpc:Helpoption a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:HasHelpOption ;
        owl:allValuesFrom rdf:nil ] .
hpc:hasversionoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Versionoption .
hpc:Versionoption a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:HasVersionOption ;
        owl:allValuesFrom rdf:nil ] .
hpc:changegroupcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Group .
hpc:Group a owl:Class .
hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .
hpc:groupName a owl:DatatypeProperty ;
    rdfs:domain hpc:Changegroupcommand .
hpc:Jobstatus a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:jobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:descriptiontext a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:setjobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:messagedescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:jobStatusChangeable a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstatus .
hpc:JobStatusNotchangeable a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:Job_Status_Changeable ;
        owl:value Some [ a owl:Class ;
            owl:unionOf (hpc:DoneJob ; hpc:ExitedJob) ] ] .
hpc:Ownjob a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:JobID ;
        owl:hasValue self ] .
hpc:Otheruserjob a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:JobID ;
        owl:value (! self) ] .
hpc:Rootoradmin a owl:Class .
