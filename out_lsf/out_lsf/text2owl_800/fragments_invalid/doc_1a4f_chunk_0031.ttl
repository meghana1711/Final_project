hpc:Host a owl:Class .
hpc:Resource a owl:Class .
hpc:Instance a owl:Class .
hpc:Sharedresource a owl:Class .
hpc:Nonsharedstaticresource a owl:Class .
hpc:Dynamicnumericresource a owl:Class .
hpc:Defaultresource a owl:Class .
hpc:hasHost owl:ObjectProperty .
hpc:hasQuantity owl:DatatypeProperty .
hpc:hasResource owl:ObjectProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:Instance rdfs:subClassOf owl:Class .
hpc:Sharedresource rdfs:subClassOf hpc:Resource .
hpc:Nonsharedstaticresource rdfs:subClassOf hpc:Resource .
hpc:Dynamicnumericresource rdfs:subClassOf hpc:Resource .
hpc:Defaultresource rdfs:subClassOf hpc:Dynamicnumericresource .

hpc:Hashost rdfs:domain hpc:Resource .
hpc:Hashost rdfs:range hpc:Host .
hpc:Hasquantity rdfs:domain hpc:Resource .
hpc:Hasquantity rdfs:range xsd:nonNegativeInteger .
hpc:Hasresource rdfs:domain hpc:Instance .
hpc:Hasresource rdfs:range hpc:Resource .

hpc:Instance hpc:hasresource hpc:verilog [ a hpc:SharedResource ;
                                            hpc:hasQuantity 5 ;
                                            hpc:locatedOn ~hpc:host1 ~hpc:host2 ] .
hpc:Instance hpc:hasresource hpc:synopsys [ a hpc:SharedResource ;
                                            hpc:hasQuantity 2 ;
                                            hpc:Hashost hpc:host1 hpc:host2 ] .
hpc:Instance hpc:hasresource hpc:synopsys [ a hpc:DynamicNumericResource ;
                                            hpc:hasQuantity 2 ;
                                            hpc:hasHost ~hpc:host1 ~hpc:host2 ] .
hpc:Instance hpc:hasresource hpc:console [ a hpc:SharedResource ;
                                            hpc:hasQuantity 1 ;
                                            hpc:Hashost hpc:host1 ] .
hpc:Instance hpc:hasresource hpc:console [ a hpc:SharedResource ;
                                            hpc:hasQuantity 1 ;
                                            hpc:Hashost hpc:host2 ] .
hpc:Instance hpc:hasresource hpc:console [ a hpc:SharedResource ;
                                            hpc:hasQuantity 1 ;
                                            hpc:Hashost hpc:host3 ] .
hpc:Instance hpc:hasresource hpc:xyz [ a hpc:DefaultResource ] .
