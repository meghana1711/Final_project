hpc:IPv4Interface a owl:Class .
hpc:IPv6Interface a owl:Class .
hpc:LoopbackInterface a owl:Class, rdfs:subClassOf [ a owl:Class ;
                                                     rdfs:subClassOf (hpc:IPv4Interface rdfs:and hpc:IPv6Interface) ] .
hpc:hasIPAddress a owl:ObjectProperty .
hpc:LoopbackInterface rdfs:domain hpc:LoopbackInterface ;
                      rdfs:range xsd:string .
hpc:LoopbackInterface hasIPAddress 127.0.0.1 .
hpc:NoProblemIndicator a owl:Class .
hpc:LoopbackInterface rdfs:subClassOf [ a owl:Class ;
                                         rdfs:subClassOf (hpc:LoopbackInterface rdf:value hpc:NoProblemIndicator) ] .
```
