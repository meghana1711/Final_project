hpc:RootlessDocker a owl:Class .
hpc:isOperational a owl:ObjectProperty .
hpc:isOperational rdfs:domain hpc:RootlessDocker ;
                   rdfs:range xsd:boolean .

hpc:DaemonConfig a owl:Class .
hpc:hasDaemonConfigFile a owl:ObjectProperty .
hpc:hasDaemonConfigFile rdfs:domain hpc:DaemonConfig ;
                        rdfs:range rdf:Resource .

hpc:DaemonConfigFile a owl:Class .
hpc:hasField a owl:ObjectProperty .
hpc:hasField rdfs:domain hpc:DaemonConfigFile ;
                 rdfs:range rdf:PlainLiteral .

hpc:FieldName a owl:Class .
hpc:hasValue a owl:DatatypeProperty .
hpc:hasValue rdfs:domain hpc:FieldName ;
             rdfs:range xsd:string .

hpc:FieldValue a owl:Class .
hpc:hasValue a owl:DatatypeProperty .
hpc:hasValue rdfs:domain hpc:FieldValue ;
             rdfs:range xsd:boolean .

hpc:FieldValue_experimental a hpc:FieldValue ;
hpc:hasValue "true" .

hpc:FieldValue_iptables a hpc:FieldValue ;
hpc:hasValue "false" .

hpc:FieldValue_noNewPrivileges a hpc:FieldValue ;
hpc:hasValue "true" .

hpc:FieldValue_rootless a hpc:FieldValue ;
hpc:hasValue "true" .

hpc:FieldValue_selinuxEnabled a hpc:FieldValue ;
hpc:hasValue "false" .

hpc:FieldValue_defaultRuntime a hpc:FieldValue ;
hpc:hasValue "slurm" .

hpc:FieldValue_slurmPath a hpc:FieldValue ;
hpc:hasValue "/usr/local/bin/scrun" .

hpc:FieldValue_dataRoot a hpc:FieldValue ;
hpc:hasValue "/run/user/${USER_ID}/docker/" .

hpc:FieldValue_execRoot a hpc:FieldValue ;
hpc:hasValue "/run/user/${USER_ID}/docker-exec/" .

hpc:DaemonConfig_slurm a hpc:DaemonConfig ;
hpc:hasRuntimes hpc:DaemonConfig_slurm ;
hpc:hasRuntimes rdf:List ;
hpc:hasRuntimes+ rdf:first hpc:SlurmRuntime ;

hpc:SlurmRuntime a owl:Class ;
hpc:hasPath a owl:ObjectProperty ;
hpc:hasPath rdfs:domain hpc:SlurmRuntime ;
                 rdfs:range rdf:PlainLiteral .

hpc:SlurmRuntime_scrun a hpc:SlurmRuntime ;
hpc:hasPath "/usr/local/bin/scrun" .
```
