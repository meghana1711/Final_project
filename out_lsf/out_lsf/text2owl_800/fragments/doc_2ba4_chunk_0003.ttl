hpc:License a owl:Class .
hpc:totallicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:integer .

hpc:availablelicenses a owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range hpc:License .

hpc:checkoutlicense a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:License .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workflow .

hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Rusageexpression .

hpc:Rusageexpression a owl:Class .
hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusageexpression ;
    rdfs:range xsd:duration .

hpc:licenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Rusageexpression ;
    rdfs:range xsd:integer .
