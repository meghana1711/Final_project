hpc:Job a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Task ] ;
    rdfs:comment "Accounting information about jobs that are submitted by all users, accounted on all projects, completed normally or exited, executed on all hosts, submitted to all queues, and accounted on all service classes." .

hpc:submittedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User ;
    rdfs:comment "The user who submitted the job." .

hpc:accountedon a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Project ;
    rdfs:comment "The project the job was accounted on." .

hpc:completedstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstatus ;
    rdfs:comment "The status of the job upon completion." .

hpc:executedon a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host(s) the job was executed on." .

hpc:submittedto a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue ;
    rdfs:comment "The queue the job was submitted to." .

hpc:accountedonserviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Serviceclass ;
    rdfs:comment "The service class the job was accounted on." .

# Job specific example
hpc:Job61 a hpc:Job ;
    hpc:Submittedby hpc:user1 ;
    hpc:Accountedon hpc:default ;
    hpc:Completedstatus hpc:done ;
    hpc:Submittedto hpc:normal ;
    hpc:Accountedonserviceclass hpc:default ;
    hpc:cmd "myjob" ;
    hpc:submittedTime "1999-02-14T14:13:46"^^xsd:dateTime ;
    hpc:Submittedfrom hpc:hosta ;
    hpc:cwd "$HOME" ;
    hpc:Dispatchedto hpc:hosta hpc:hostA hpc:hostA hpc:hostA hpc:hostA hpc:hostA ;
    hpc:completedTime "1999-02-14T14:16:47"^^xsd:dateTime ;

# Host ontology

hpc:Host a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf hpc:Resource ] ;
    rdfs:comment "A computing host." .

