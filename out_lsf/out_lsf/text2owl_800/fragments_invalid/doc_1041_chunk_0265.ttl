@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Jobgroup a owl:Class .
hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Queue a owl:Class .
hpc:Host a owl:Class .
hpc:jobgrouppath a owl:DatatypeProperty .
hpc:status a owl:ObjectProperty .
hpc:queuename a owl:DatatypeProperty .
hpc:jobname a owl:DatatypeProperty .
hpc:submittime a owl:DatatypeProperty .
hpc:fromhost a owl:DatatypeProperty .
hpc:command a owl:DatatypeProperty .
hpc:cwd a owl:DatatypeProperty .
hpc:starttime a owl:DatatypeProperty .
hpc:hostname a owl:DatatypeProperty .

hpc:Jobgrouppath rdfs:domain hpc:Job .
hpc:Status rdfs:domain hpc:Job .
hpc:Queuename rdfs:domain hpc:Job .
hpc:Jobname rdfs:domain hpc:Job .
hpc:Submittime rdfs:domain hpc:Job .
hpc:Fromhost rdfs:domain hpc:Job .
hpc:Command rdfs:domain hpc:Job .
hpc:Cwd rdfs:domain hpc:Job .
hpc:Starttime rdfs:domain hpc:Job .
hpc:Hostname rdfs:domain hpc:Host .

hpc:Jobgrouppath rdfs:range xsd:string .
hpc:Status rdfs:range xsd:string .
hpc:Queuename rdfs:range xsd:string .
hpc:Jobname rdfs:range xsd:string .
hpc:Submittime rdfs:range xsd:dateTime .
hpc:Fromhost rdfs:range xsd:string .
hpc:Command rdfs:range xsd:string .
hpc:Cwd rdfs:range xsd:string .
hpc:Starttime rdfs:range xsd:dateTime .
hpc:Hostname rdfs:range xsd:string .

hpc:Jobgroup a rdfs:subClassOf hpc:Job .
