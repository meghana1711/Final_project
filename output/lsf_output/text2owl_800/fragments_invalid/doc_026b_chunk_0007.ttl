hpc:LSFCluster
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:DataManagerHost
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:DataManager
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:LSFDataHosts
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first hpc:Datamanagerhost ;
    rdfs:range rdf:rest hpc:Datamanagerhost .

hpc:LSFDataPort
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:integer .

hpc:Admins
    a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range rdf:List ;
    rdfs:range rdf:first rdf:Literal ;
    rdfs:range rdf:rest rdf:Literal .

hpc:StagingArea
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:anyURI .
