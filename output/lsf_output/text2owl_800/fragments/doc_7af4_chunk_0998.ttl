hpc:Usermapping a owl:Class .
hpc:Submission a owl:Class .
hpc:Hassubmissionuser rdfs:domain hpc:Usermapping ;
    rdfs:range hpc:Submission .
hpc:Hasexecutionuser rdfs:domain hpc:Usermapping ;
    rdfs:range rdf:List .
hpc:List a owl:Class .
hpc:List rdfs:subClassOf xsd:string .
hpc:Haslistelement rdfs:domain rdf:List ;
    rdfs:range hpc:User .
hpc:User a owl:Class .

hpc:bsubmit a owl:ObjectProperty .
hpc:Bsubmit rdfs:domain hpc:User ;
    rdfs:range rdf:List .
hpc:setupconfig a owl:ObjectProperty .
hpc:Setupconfig rdfs:domain hpc:Usermapping ;
    rdfs:range hpc:Setupconfig .
hpc:Setupconfig a owl:Class .
