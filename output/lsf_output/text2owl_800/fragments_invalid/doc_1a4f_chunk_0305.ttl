hpc:Host a owl:Class .
hpc:Queue a owl:Class .
hpc:Window a owl:Class .
hpc:Dispatchwindow a owl:Class .
hpc:Runwindow a owl:Class .

hpc:Hasdispatchwindow rdfs:domain hpc:Host, hpc:Queue .
hpc:Hasrunwindow rdfs:domain hpc:Queue .

hpc:affectsJobStarting owl:ObjectProperty .
hpc:affectsJobStopping owl:ObjectProperty .

hpc:Definesactivity hpc:Dispatchwindow rdfs:domain hpc:Host, hpc:Queue ;
    rdfs:range rdf:Resource .

hpc:Definesrunperiod hpc:Runwindow rdfs:domain hpc:Queue ;
    rdfs:range xsd:duration .

hpc:controlsJobSubmission false rdfs:subPropertyOf hpc:definesActivity .
hpc:Allowsjobstarting hpc:dispatchwindow rdfs:subPropertyOf hpc:affectsJobStarting .
hpc:Allowsjobrunning hpc:runwindow rdfs:subPropertyOf hpc:affectsJobStarting .
hpc:Preventsjobrunning hpc:runwindow rdfs:subPropertyOf hpc:affectsJobStopping .
hpc:Suspendsrunningjobs hpc:runwindow rdfs:subPropertyOf hpc:affectsJobStopping .
