hpc:Lsfcluster a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Managementcandidate a owl:Class .
hpc:communicationpath a owl:ObjectProperty .
hpc:faulttolerance a owl:ObjectProperty .
hpc:eventlog a owl:ObjectProperty .
hpc:eventfile a owl:DatatypeProperty .
hpc:Primaryfileserver a owl:Class .
hpc:duplicateeventlog a owl:ObjectProperty .
hpc:Replica a owl:Class .

hpc:Lsfcluster rdfs:subClassOf owl:Class .
hpc:Lsfdaemon rdfs:subClassOf owl:Class .
hpc:Managementhost rdfs:subClassOf hpc:Lsfdaemon .
hpc:Managementcandidate rdfs:subClassOf hpc:Lsfdaemon .
hpc:CommunicationPath rdf:type owl:ObjectProperty .
hpc:FaultTolerance rdf:type owl:ObjectProperty .
hpc:EventLog rdf:type owl:ObjectProperty .
hpc:EventFile rdf:type owl:DatatypeProperty .
hpc:PrimaryFileServer rdf:type owl:Class .
hpc:DuplicateEventLog rdf:type owl:ObjectProperty .
hpc:Replica rdf:type owl:Class .

hpc:Communicationpath rdfs:domain hpc:Lsfcluster ;
                        rdfs:range hpc:Lsfdaemon .
hpc:Faulttolerance rdfs:domain hpc:Lsfcluster ;
                        rdfs:range hpc:Lsfdaemon .
hpc:Eventlog rdfs:domain hpc:Lsfcluster ;
                        rdfs:range hpc:Eventlog .
hpc:Eventfile rdfs:domain hpc:Eventlog ;
                 rdfs:range xsd:string .
hpc:Duplicateeventlog rdfs:domain hpc:Lsfcluster ;
                      rdfs:range hpc:Replica .
