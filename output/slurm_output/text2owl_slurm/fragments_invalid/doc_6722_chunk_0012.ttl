hpc:Persistentburstbuffer a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Persistentburstbuffer ;
    rdfs:range xsd:string .
hpc:hascapacity a owl:DatatypeProperty ;
    rdfs:domain hpc:Persistentburstbuffer ;
    rdfs:range xsd:decimal .
hpc:haspool a owl:ObjectProperty ;
    rdfs:domain hpc:Persistentburstbuffer ;
    rdfs:range hpc:Pool .
hpc:hasaccess a owl:DatatypeProperty ;
