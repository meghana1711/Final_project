hpc:lsfDataSkipGroupCheck a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Ignored if LSF data manager is not configured." .

hpc:Datamanager a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an LSF data manager." .

hpc:hasDataHost rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datahost ;
    rdfs:comment "Relates a data manager to its configured data hosts." .

hpc:lsfDataHosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:string ;
    rdfs:comment "The LSF data hosts configured for the data manager." .

hpc:lsfDataPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:integer ;
    rdfs:comment "The LSF data port configured for the data manager." .

hpc:badminMbdrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:string ;
    rdfs:comment "The command to restart all LSF management candidate hosts." .

hpc:Datajob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an LSF data job." .

hpc:hasDatagrp rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Datajob ;
    rdfs:range xsd:string ;
    rdfs:comment "Relates a data job to the group it specifies with the –datagrp option." .

hpc:lsfStageInExec a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the script for direct data staging during the stage in process." .

hpc:LsfStageInExecScript a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a script for LSF stage in process." .

hpc:isLocatedInServerDir rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStageInExecScript ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the script is located in the $LSF_SERVERDIR directory." .

hpc:lsbStageOutExec a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the script for direct data staging during the stage out process." .

hpc:LsbStageOutExecScript a owl:Class ;
    rdfs:subClassOf owl:Class ;
