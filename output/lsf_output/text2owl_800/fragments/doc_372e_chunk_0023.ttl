hpc:RLMManagerPath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Rlmmanager ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to the Reprise License Manager command" .

hpc:Cluster
    a owl:Class ;
    rdfs:comment "A cluster permitted to use License Scheduler" .

hpc:hasCluster
    a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range rdf:List ;
    rdfs:comment "Clusters that can use License Scheduler" .

hpc:LicenseScheduler
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Manages licenses for a cluster" .

hpc:Project
    a owl:Class ;
    rdfs:comment "A project defined in lsf.licensescheduler" .

hpc:hasProjectPriority
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer ;
    rdfs:comment "Priority of the project" .

hpc:ProjectDescription
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional project description of up to 64 characters" .
