@base <http://example.org/hpc/>

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job in the system." ;
    rdfs:label "Job" ;
    hpc:Memory rdfs:range xsd:string ;
    hpc:lastbackfill a owl:DatatypeProperty ;
    hpc:Lastbackfill rdfs:domain hpc:Job ;
    hpc:Lastbackfill rdfs:range xsd:string ;
    hpc:lastupdate a owl:DatatypeProperty ;
    hpc:Lastupdate rdfs:domain hpc:Job ;
    hpc:Lastupdate rdfs:range xsd:string ;
    hpc:exitcode a owl:DatatypeProperty ;
    hpc:Exitcode rdfs:domain hpc:Job ;
    hpc:Exitcode rdfs:range xsd:integer ;
    hpc:derivedexitcode a owl:DatatypeProperty ;
    hpc:Derivedexitcode rdfs:domain hpc:Job ;
    hpc:Derivedexitcode rdfs:range xsd:integer ;

hpc:Step a owl:Class
