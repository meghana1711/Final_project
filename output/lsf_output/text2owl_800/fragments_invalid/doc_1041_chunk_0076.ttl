hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Activatedqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf owl:Class .

hpc:Inactivatedqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf owl:Class .

hpc:Runwindow a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Hasrunwindow rdfs:domain hpc:Queue ;
    rdfs:range hpc:Runwindow .

hpc:Isactivatedby rdfs:domain hpc:Activatedqueue ;
    rdfs:range hpc:Runwindow .

hpc:Cannotbereactivatedby rdfs:domain hpc:Inactivatedqueue ;
    rdfs:range hpc:Runwindow .

hpc:Admincomment rdfs:domain hpc:Resource ;
    rdfs:range xsd:string ;
    rdfs:range xsd:maxLength 512 .

hpc:closequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range hpc:Queue .

hpc:closeAllQueues rdfs:subPropertyOf hpc:closeQueue ;
    rdfs:domain hpc:Admin .

hpc:Queuename rdfs:domain hpc:Closequeue ;
    rdfs:range xsd:string .

hpc:Systemdefaultqueue rdfs:domain hpc:Closequeue ;
    rdfs:range hpc:Queue .

hpc:Closedqueue rdfs:domain hpc:Queue ;
    rdfs:range hpc:Inactivatedqueue .

hpc:Logcomment rdfs:domain hpc:Closequeue ;
    rdfs:range hpc:Admincomment .

hpc:qhist a owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range hpc:Hist .

hpc:Time0 rdfs:domain hpc:Qhist ;
    rdfs:range xsd:dateTime .

hpc:Time1 rdfs:domain hpc:Qhist ;
    rdfs:range xsd:dateTime .

hpc:Logfile rdfs:domain hpc:Qhist ;
    rdfs:range xsd:string .

hpc:Histfile rdfs:domain hpc:Hist ;
    rdfs:range xsd:string .

hpc:Hist a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Hashistfile rdfs:domain hpc:Hist ;
    rdfs:range hpc:Histfile .

hpc:Lsbevent rdfs:domain hpc:Admincomment, hpc:Hist ;
    rdfs:range xsd:string .

hpc:Maxcommentlength rdfs:domain hpc:Admincomment, hpc:Hist ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasmaxcommentlength rdfs:domain hpc:Admincomment, hpc:Hist ;
