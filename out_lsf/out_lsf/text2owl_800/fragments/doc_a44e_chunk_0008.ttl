hpc:LsfDataHosts a owl:Class .
hpc:hashostlist a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:string .
hpc:isdatamanagerhost a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range hpc:LsfServer .
hpc:isdatamanagermanagementhost a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range xsd:integer .
hpc:isfailoverhost a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataHosts ;
    rdfs:range hpc:LsfDataHosts .
hpc:LsfServer a owl:Class .
