hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Host a owl:Class .
hpc:memorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:numberoftasks a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:memoryenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:memoryusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:hostmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:taskonhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .
hpc:taskonhostmemoryusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskonhost ;
    rdfs:range xsd:decimal .
hpc:span a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Spanvalue .
hpc:Spanvalue a owl:Class .
hpc:ptile a owl:DatatypeProperty ;
    rdfs:domain hpc:Spanvalue ;
    rdfs:range xsd:integer .
hpc:Jobkilled a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:jobkilledbymemoryenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Jobkilled ;
    rdfs:range hpc:Memoryenforcement .
hpc:memoryenforcementonhost a owl:ObjectProperty ;
    rdfs:domain hpc:Memoryenforcement ;
    rdfs:range hpc:Host .
hpc:memoryenforcementtotallimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryenforcement ;
    rdfs:range xsd:decimal .
hpc:memoryenforcementperhostlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryenforcement ;
    rdfs:range xsd:decimal .
hpc:Cgroupmemorysubsystem a owl:Class .
hpc:doesnotsupportpertaskmemoryenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroupmemorysubsystem ;
    rdfs:range hpc:Lsf .
hpc:swaplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cgroupmemorysubsystem ;
    rdfs:range xsd:decimal .
hpc:limitenforcementdiffersfrompreviouslsfbehavior a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroupmemorysubsystem ;
    rdfs:range xsd:boolean .
