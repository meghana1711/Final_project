hpc:LsfEnableSupportIpv6 a owl:Class ;
  rdfs:comment "Enables the use of IPv6 addresses in addition to IPv4." .

hpc:LSF_DUALSTACK_PREFER_IPV6 rdf:type owl:Class ;
  rdfs:comment "Not defined." .

hpc:LsfEnableTmpUnit a owl:Class ;
  rdfs:comment "The default value is LSF_ENABLE_TMP_UNIT=N|n." .

hpc:LsfUnitForLimits a owl:Class ;
  rdfs:comment "The units that are defined by this parameter also apply cluster-wide to the tmp resource." .

hpc:Resourcerequirement a owl:Class ;
  rdfs:subClassOf hpc:LsfEnableTmpUnit ;
  rdfs:comment "Resource requirements at the job-level (bsub), queue-level (lsb.queues), and application-level (lsb.applications)." .

hpc:Limitsection a owl:Class ;
  rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:comment "The TMP resource in the Limit section in the lsb.resources file." .

hpc:Guaranteedresourcepoolsection a owl:Class ;
  rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:comment "The RES_SELECT in the GuaranteedResourcePool section in the lsb.resources file." .

hpc:Loadindexthreshold a owl:Class ;
  rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:comment "The load_index threshold in the lsb.queues and lsb.hosts file." .

hpc:LsfEnvOverride a owl:Class ;
  rdfs:comment "Specifies whether environment variables can override the parameter settings in the lsf.conf file." .

# Object Properties
hpc:hasdefaultvalue a owl:ObjectProperty ;
  rdfs:domain hpc:LsfEnableSupportIpv6 ;
  rdfs:range xsd:string ;
  rdfs:comment "If set, enables the use of IPv6 addresses in addition to IPv4." .

hpc:hasdefaultvalue a owl:ObjectProperty ;
  rdfs:domain hpc:LsfDualstackPreferIpv6 ;
  rdfs:range xsd:string ;
  rdfs:comment "Not defined." .

hpc:affectslimits a owl:ObjectProperty ;
  rdfs:domain hpc:LsfEnableTmpUnit ;
  rdfs:range hpc:Resourcerequirement ;
  rdfs:comment "Applying limit units to the tmp resource affects the following limits and resource requirements." .

hpc:usesunit a owl:ObjectProperty ;
  rdfs:domain hpc:Resourcerequirement ;
  rdfs:range hpc:LsfUnitForLimits ;
  rdfs:comment "The unit for limits." .

hpc:overrideslsfconf a owl:ObjectProperty ;
  rdfs:domain hpc:Lsf
