hpc:FODHost
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:label "FOD Host" ;
    rdfs:comment "Represents a FOD host." .

hpc:FODID
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:label "FOD ID" ;
    rdfs:comment "Represents a FOD ID." .

hpc:FODFile
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:label "FOD File" ;
    rdfs:comment "Represents a FOD file." .

hpc:FODPort
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodconf ;
    rdfs:range xsd:integer ;
    rdfs:label "FOD Port" ;
    rdfs:comment "The TCP and UDP listening port for the failover daemon." .

hpc:FODWorkDir
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodconf ;
    rdfs:range xsd:string ;
    rdfs:label "Working Directory" ;
    rdfs:comment "The working directory for the FOD." .

hpc:FODLogDir
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodconf ;
    rdfs:range xsd:string ;
    rdfs:label "Log Directory" ;
    rdfs:comment "The log directory for the FOD." .

hpc:FODRoot
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fodshell ;
    rdfs:range hpc:Foddir ;
    rdfs:label "FOD Root" ;
    rdfs:comment "The name of the new directory for the FOD." .

hpc:FODEnvDir
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string ;
    rdfs:label "Environment Directory" ;
    rdfs:comment "The directory for the FOD configuration." .

hpc:FODPath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string ;
    rdfs:label "Path" ;
    rdfs:comment "The PATH environment variable." .

hpc:MANPath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Environment ;
    rdfs:range xsd:string ;
    rdfs:label "Man Path" ;
    rdfs:comment "The MANPATH environment variable." .

hpc:FODConf
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:label "FOD Configuration" ;
    r
