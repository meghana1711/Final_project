hpc:Reservationpolicy a owl:Class .
hpc:User a owl:Class .
hpc:hasSubgroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:Usergroup .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:User .
hpc:allUserGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservationpolicy ;
    rdfs:range hpc:Usergroup .
hpc:notUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservationpolicy ;
    rdfs:range hpc:User .
hpc:Reservationusage a owl:Class .
hpc:reserveResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservationusage ;
    rdfs:range rdfs:Literal .
hpc:resource rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Reserveresource .
hpc:method rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Reserveresource .
hpc:reserve rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Reserveresource .
hpc:Resource a owl:Class .
hpc:Method a owl:Class .
hpc:Reserve a owl:Class .
hpc:UserName a xsd:string .
hpc:UserGroupName a xsd:string .
hpc:Usergroup rdfs:subClassOf hpc:Usergrouporcluster .
hpc:UserGroupOrCluster rdf:type owl:Class .
hpc:Cluster rdfs:subClassOf hpc:Usergrouporcluster .
