hpc:Application a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:integer .
hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:nonNegativeInteger .
hpc:resReq a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Resourcerequirement .
hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Requirement .
hpc:script a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Script .
hpc:Script a owl:Class .
hpc:Commonfile a owl:Class .
hpc:Localfile a owl:Class .
hpc:Authentication a owl:Class .
hpc:authenticationmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Authentication ;
    rdfs:range xsd:string .
hpc:authorization a owl:ObjectProperty ;
    rdfs:domain hpc:Authentication ;
    rdfs:range hpc:Authorizationtype .
hpc:Authorizationtype a owl:Class .
hpc:Operatingsystemauthorization a owl:Class ;
    rdfs:subClassOf hpc:Authorizationtype .
hpc:Lsfauthorization a owl:Class ;
    rdfs:subClassOf hpc:Authorizationtype .
hpc:Authorizationfailure a owl:Class ;
    rdfs:subClassOf hpc:Authorizationtype .
hpc:Externalauthentication a owl:Class ;
    rdfs:subClassOf hpc:Authorizationtype .
