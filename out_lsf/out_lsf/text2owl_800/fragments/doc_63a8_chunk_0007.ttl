hpc:Jobarray a owl:Class .
hpc:Dataspecificationfile a owl:Class .
hpc:Datafilerequirement a owl:Class .
hpc:hasDataSpecificationFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Dataspecificationfile .
hpc:hasDataFileRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Datafilerequirement .
hpc:datafilerequirementname a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafilerequirement ;
    rdfs:range xsd:string .
hpc:dataspecificationfilecontent a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range xsd:string .
hpc:Dataspecificationfileline a owl:Class .
hpc:hasDataSpecificationFileLine rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range hpc:Dataspecificationfileline .
hpc:dataspecificationfilelinesource a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfileline ;
    rdfs:range xsd:string .
hpc:dataspecificationfilelinehost a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfileline ;
    rdfs:range xsd:string .
hpc:dataspecificationfilelinepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfileline ;
    rdfs:range xsd:string .
hpc:dataspecificationfilelinedatatype a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfileline ;
    rdfs:range xsd:string .
hpc:DataSpecificationFileLineIsFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfileline ;
    rdfs:range xsd:boolean .
