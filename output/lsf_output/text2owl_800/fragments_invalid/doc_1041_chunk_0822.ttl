@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Resource a owl:Class .
hpc:fieldname a owl:DatatypeProperty .
hpc:width a owl:DatatypeProperty .
hpc:unit a owl:DatatypeProperty .
hpc:delimiter a owl:ObjectProperty .

rdfs:domain hpc:Resource hpc:Fieldname .
rdfs:domain hpc:Resource hpc:Width .
rdfs:domain hpc:Resource hpc:Unit .
rdfs:domain hpc:Resource hpc:Delimiter .

rdfs:range hpc:Fieldname xsd:string .
rdfs:range hpc:Width xsd:nonNegativeInteger .
rdfs:range hpc:Unit xsd:string .
rdfs:range hpc:Delimiter xsd:string .

hpc:BuiltInResource a hpc:Resource .
hpc:ExternalResource a hpc:Resource .

hpc:HOST_NAME a hpc:FieldName .
hpc:status a hpc:FieldName .
hpc:r15s a hpc:FieldName .
hpc:r1m a hpc:FieldName .
hpc:r15m a hpc:FieldName .
hpc:ut a hpc:FieldName .
hpc:pg a hpc:FieldName .
hpc:ls a hpc:FieldName .
hpc:it a hpc:FieldName .
hpc:io a hpc:FieldName .
hpc:tmp a hpc:FieldName .
hpc:LSF_UNIT_FOR_LIMITS a hpc:FieldName .
hpc:swp a hpc:FieldName .
hpc:mem a hpc:FieldName .
hpc:gpu_status* a hpc:FieldName .
hpc:gpu_error* a hpc:FieldName .

hpc:Builtinresource rdfs:subClassOf hpc:Resource .

hpc:HOST_NAME rdfs:comment "20" .
hpc:status rdfs:comment "15" .
hpc:r15s rdfs:comment "6" .
hpc:r1m rdfs:comment "6" .
hpc:r15m rdfs:comment "6" .
hpc:ut rdfs:comment "6" .
hpc:pg rdfs:comment "6" .
hpc:ls rdfs:comment "6" .
hpc:it rdfs:comment "6" .
hpc:io rdfs:comment "6" .
hpc:tmp rdfs:comment "10" .
hpc:LSF_UNIT_FOR_LIMITS rdfs:comment "LSF_UNIT_FOR_LIMITS in lsf.conf (KB by default)" .
hpc
