hpc:SlurmAuth a owl:Class .
hpc:SlurmAuthType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmAuth ;
    rdfs:range xsd:string .

hpc:SlurmCredType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmAuth .

hpc:SlurmAuthType_slurm a hpc:SlurmAuthType .
hpc:SlurmCredType_slurm a hpc:SlurmCredType .

hpc:SlurmDaemon a owl:Class .
hpc:SlurmDaemon_startUpMethod rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon .

hpc:SlurmDaemon_runtimeDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range xsd:string .

hpc:SlurmDaemon_owner rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range xsd:string .

hpc:SlurmKeyFile a owl:Class .
hpc:SlurmKeyFile_keys rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmKeyFile .

hpc:SlurmKey rdf:type owl:Class ;
    rdfs:subClassOf hpc:SlurmKeyFile .

hpc:SlurmKey_kid rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmKey .
    rdfs:range xsd:string .

hpc:SlurmKey_k rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmKey .
    rdfs:range xsd:base64Binary .

hpc:SlurmKey_use rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmKey .
    rdfs:range xsd:string .
```
