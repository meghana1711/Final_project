hpc:Committedruntime a owl:Class .
hpc:fairshareadjustmentfactor a owl:DatatypeProperty .
hpc:Fairshareadjustmentfactor rdfs:domain hpc:Committedruntime ;
                                 rdfs:range xsd:decimal .
hpc:gpuruntimefactor a owl:DatatypeProperty .
hpc:Gpuruntimefactor rdfs:domain hpc:Committedruntime ;
                                 rdfs:range xsd:decimal .
hpc:historicalgpuruntime a owl:DatatypeProperty .
hpc:Historicalgpuruntime rdfs:domain hpc:Committedruntime ;
                                 rdfs:range xsd:decimal .
hpc:ngpusphysical a owl:DatatypeProperty .
hpc:Ngpusphysical rdfs:domain hpc:Committedruntime ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:Committedruntimeweightingfactor a owl:Class .
