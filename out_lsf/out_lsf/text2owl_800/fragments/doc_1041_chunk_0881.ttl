hpc:preexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command ;
    rdfs:comment "Runs the specified job-based pre-execution command on the execution host before running the task." .

hpc:PreExecutionCommand_RootRestriction rdf:type owl:Restriction ;
    rdfs:onProperty hpc:PreExecutionCommand ;
    owl:allValuesFrom xsd:boolean ;
    rdfs:comment "The task pre-execution command cannot run as root." .

hpc:PreExecutionCommand_StandardIO rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:PreExecutionCommand ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The standard input and output for the pre-execution command are directed to the same files as the job." .

hpc:PreExecutionCommand_SameUserID rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:PreExecutionCommand ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The pre-execution command runs under the same user ID, environment, home, and working directory as the job." .

hpc:PreExecutionCommand_PathRequirement rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:PreExecutionCommand ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "If the pre-execution command is not in the user's usual execution path (the $PATH variable), the full path name of the command must be specified." .

hpc:postexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command ;
    rdfs:comment "Runs the specified job-based post-execution command on the execution host after the task finishes." .

hpc:PostExecutionCommand_RootRestriction rdf:type owl:Restriction ;
    rdfs:onProperty hpc:PostExecutionCommand ;
    owl:allValuesFrom xsd:boolean ;
    rdfs:comment "The task post-execution command cannot run as root." .

hpc:PostExecutionCommand_PathRequirement rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:PostExecutionCommand ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string ;
    rdfs:comment "If the post-execution command is not in the user's usual execution path (the $PATH variable), the full path name of the command must be specified." .

hpc:errorfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Specify a file path. Appends the standard error output of the job to the specified file." .
