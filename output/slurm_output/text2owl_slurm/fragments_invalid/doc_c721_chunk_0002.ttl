hpc:Usage a owl:Class.
hpc:Historicalusage a owl:Class.
hpc:currentperiod a owl:DatatypeProperty.
hpc:lastperiod a owl:DatatypeProperty.
hpc:period2 a owl:DatatypeProperty.
hpc:decayfactor a owl:DatatypeProperty.

hpc:Decayfactor rdfs:domain hpc:Historicalusage ;
    rdfs:range xsd:decimal .

hpc:calculatehistoricalusage a owl:ObjectProperty ;
    rdfs:domain hpc:Usage ;
    rdfs:range hpc:Historicalusage .

hpc:calculateHistoricalUsage uses hpc:CurrentPeriod, hpc:LastPeriod, hpc:DecayFactor .

hpc:normalizedusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Historicalusage ;
    rdfs:range xsd:decimal .

hpc:calculatenormalizedusage a owl:ObjectProperty ;
    rdfs:domain hpc:Historicalusage ;
    rdfs:range xsd:decimal .

