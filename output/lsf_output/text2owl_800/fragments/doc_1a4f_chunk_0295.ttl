hpc:Job a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:suspendedbyforcedrun a owl:ObjectProperty .
hpc:onlyjobonhost a owl:ObjectProperty .
hpc:interactiveuseronhost a owl:ObjectProperty .
hpc:hostidle a owl:ObjectProperty .
hpc:highpagingrate a owl:ObjectProperty .
hpc:pgsuspIt a owl:DatatypeProperty .
hpc:Schedulingcondition a owl:Class .
hpc:Loadthreshold a owl:Class .
hpc:Queuelevelsuspendingcondition a owl:Class .
hpc:Hostlevelsuspendingcondition a owl:Class .
hpc:cpurunqueuelength a owl:DatatypeProperty .
hpc:pagingrate a owl:DatatypeProperty .
hpc:idletime a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf hpc:Suspendedjob .
hpc:Suspendedbyforcedrun rdfs:domain hpc:Job ;
                          rdfs:range hpc:Forcedrun .
hpc:Onlyjobonhost rdfs:domain hpc:Host ;
                   rdfs:range hpc:Job .
hpc:Interactiveuseronhost rdfs:domain hpc:Host ;
                          rdfs:range xsd:boolean .
hpc:Hostidle rdfs:domain hpc:Host ;
                 rdfs:range xsd:boolean .
hpc:Highpagingrate rdfs:domain hpc:Host ;
                    rdfs:range xsd:decimal .
hpc:PgsuspIt rdfs:domain hpc:Host ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Schedulingcondition rdfs:subClassOf hpc:Loadthreshold .
hpc:Loadthreshold rdfs:subClassOf hpc:Suspendedcondition .
hpc:Queuelevelsuspendingcondition rdfs:subClassOf hpc:Schedulingcondition .
hpc:Hostlevelsuspendingcondition rdfs:subClassOf hpc:Schedulingcondition .
hpc:Cpurunqueuelength rdfs:domain hpc:Suspendingcondition ;
                       rdfs:range xsd:nonNegativeInteger .
hpc:Pagingrate rdfs:domain hpc:Suspendingcondition ;
                 rdfs:range xsd:decimal .
hpc:Idletime rdfs:domain hpc:Suspendingcondition ;
                 rdfs:range xsd:duration .
