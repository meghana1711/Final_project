hpc:Runlimit a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Runtime .

hpc:runtimeratio a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf hpc:RunLimit .

hpc:userrunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:Runlimit ;
    rdfs:subPropertyOf hpc:RunLimit ;
    owl:inverseOf hpc:SetByUser ;

hpc:setbyuser a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:User ;

hpc:UnlimitedRunLimit a owl:NamedIndividual ;
    hpc:RunLimit "unlimited" .

hpc:Multiclusterjobforwardingmodel a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Jobforwardingmodel ;

hpc:jobrunlimitratio a owl:DatatypeProperty ;
    rdfs:domain hpc:Multiclusterjobforwardingmodel ;
    rdfs:range xsd:decimal ;

hpc:jobschedulinginterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf hpc:JobProperty ;

hpc:mintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobschedulinginterval ;
    rdfs:range xsd:decimal ;

hpc:maxtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobschedulinginterval ;
    rdfs:range xsd:decimal ;

hpc:jobschedulingcycletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;

hpc:jobschedulingintervalthresholdtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
