hpc:Manpage a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Files containing man pages." .

hpc:Manpagedirectory a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Directories containing man pages." ;
    rdfs:subClass [ a owl:Restriction ;
                     rdfs:onProperty hpc:isManPageDirectory ;
                     rdfs:allValuesFrom hpc:LSF_MANDIR ] .

hpc:Manpageinstallationdirectory a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Directories where man pages are installed." ;
    rdfs:subClass [ a owl:Restriction ;
                     rdfs:onProperty hpc:isManPageInstallationDirectory ;
                     rdfs:allValuesFrom hpc:LSF_INDEP ] .

hpc:manpath a owl:ObjectProperty ;
    rdfs:domain hpc:Manpage ;
    rdfs:range xsd:string ;
    rdfs:comment "The path where man pages are installed." .

hpc:lsfMandir a owl:DatatypeProperty ;
    rdfs:domain hpc:Manpageinstallationdirectory ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where LSF man pages are installed." .

hpc:Managementhost a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Hosts that can become the management host for the cluster." .

hpc:lsfMasterList a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Defines a list of hosts that are candidates to become the management host for the cluster." .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "A collection of hosts managed by LSF." .

hpc:Unixlinux a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "UNIX and Linux operating systems." .

hpc:Windows a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Windows operating system." .

hpc:lsfIndep a owl:DatatypeProperty ;
    rdfs:domain hpc:Manpageinstallationdirectory ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where LSF independent files are located." .

hpc:Ego a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "EGO (Enterprise Grid Operations) component." .

hpc:egoMasterList a owl:ObjectProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Defines a list of hosts that are candidates to become the management host for the EGO cluster." .

hpc:ego
