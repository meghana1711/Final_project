hpc:LsfStageInStatus a owl:Class .
hpc:LsfStageJobStatus a owl:Class .
hpc:LsfStageHostfile a owl:Class .
hpc:CsmAllocationId a owl:Class .

# Object Properties
hpc:hasLSF_STAGE_IN_STATUS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStageJobStatus ;
    rdfs:range xsd:integer .
hpc:hasLSF_STAGE_JOB_STATUS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStageInStatus ;
    rdfs:range xsd:integer .
hpc:hasLSF_STAGE_HOSTFILE rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStageJobStatus ;
    rdfs:range hpc:LsfStageHostfile .
hpc:hasCSM_ALLOCATION_ID rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStageJobStatus ;
    rdfs:range hpc:CsmAllocationId .

# Datatype Properties
hpc:hasDirectDataStagingDetails rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfStageJobStatus ;
    rdfs:range xsd:string .
