hpc:cputimeused a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Cputimeused rdfs:range xsd:float .
hpc:memoryusage a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Memoryusage rdfs:range hpc:Memoryusagedetails .
hpc:Memoryusagedetails a owl:Class ;
    rdfs:subClassOf hpc:Resourceusagedetails .
hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusagedetails .
hpc:Maxmem rdfs:range xsd:nonNegativeInteger .
hpc:avgmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryusagedetails .
hpc:Avgmem rdfs:range xsd:nonNegativeInteger .
hpc:Schedulingparameters a owl:Class .
hpc:Resourcerequirementdetails a owl:Class ;
    rdfs:subClassOf hpc:Schedulingparameters .
hpc:schedulingparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingparameters .
hpc:Schedulingparameter rdfs:range xsd:string .
hpc:combined a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementdetails .
hpc:Combined rdfs:range hpc:Resourcerequirement .
hpc:effective a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementdetails .
hpc:Effective rdfs:range hpc:Resourcerequirement .
hpc:defaultresreqorder a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulingparameters .
hpc:Defaultresreqorder rdfs:range xsd:string .
hpc:joblevel a owl:ObjectProperty ;
