    rdfs:range xsd:nonNegativeInteger .
hpc:allowedjobsize a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsizelist ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Compoundresourcerequirement a owl:Class .
hpc:fixedjobsize a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement .
hpc:matchesjobsizelist a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement .
hpc:Alternativeresourcerequirement a owl:Class .
