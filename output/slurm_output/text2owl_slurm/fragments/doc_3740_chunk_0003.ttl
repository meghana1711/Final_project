hpc:Coreselection a owl:Class .
hpc:Lowestnumberedcore a owl:Class .
hpc:Highernumberedsocket a owl:Class .
hpc:Corespecializationreservation a owl:Class .
hpc:selecttype a owl:ObjectProperty .
hpc:taskplugin a owl:ObjectProperty .
hpc:corespeccount a owl:DatatypeProperty .
hpc:cpuspeclist a owl:DatatypeProperty .
hpc:memspeclimit a owl:DatatypeProperty .
hpc:linuxcgroups a owl:ObjectProperty .
hpc:Slurmd a owl:Class .
hpc:slurmdoffspec a owl:ObjectProperty .
hpc:Slurmstepd a owl:Class .
hpc:taskpluginparam a owl:DatatypeProperty .
hpc:cgroupv1 a owl:ObjectProperty .
hpc:Joballocationrequestoption a owl:Class .
hpc:corespersocket a owl:DatatypeProperty .
hpc:corespec a owl:ObjectProperty .
hpc:Systemconfiguration a owl:Class .

hpc:Coreselection rdfs:subClassOf owl:Class .
hpc:Lowestnumberedcore rdfs:subClassOf hpc:Coreselection .
hpc:Highernumberedsocket rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Corespecializationreservation rdfs:subClassOf owl:Class .
hpc:Selecttype rdfs:domain hpc:Corespecializationreservation ;
                      rdfs:range xsd:string .
hpc:Taskplugin rdfs:domain hpc:Corespecializationreservation ;
                  rdfs:range hpc:Taskplugin .
hpc:Corespeccount rdfs:domain hpc:Corespecializationreservation ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:Cpuspeclist rdfs:domain hpc:Corespecializationreservation ;
                 rdfs:range xsd:string .
hpc:Memspeclimit rdfs:domain hpc:Corespecializationreservation ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Linuxcgroups rdfs:domain hpc:Corespecializationreservation .
hpc:Slurmd rdfs:subClassOf owl:Class .
hpc:Slurmdoffspec rdfs:domain hpc:Slurmd ;
                    rdfs:range hpc:Corespecializationreservation .
hpc:Slurmstepd rdfs:subClassOf owl:Class .
hpc:Taskpluginparam rdfs:domain hpc:Corespecializationreservation ;
                      rdfs:range xsd:string .
hpc:Cgroupv1 rdfs:domain hpc:Corespecializationreservation .
hpc:Joballocationrequestoption a owl:Class .
hpc:Corespersocket rdfs:domain hpc:Joballocationrequestoption ;
                       rdfs:range xsd:nonNegativeInteger .
hpc:Corespec rdfs:domain hpc:Coreselection ;
               rdfs:range hpc:Core .
hpc:Systemconfiguration a owl:Class .
