hpc:Job a owl:Class .
hpc:runtimeestimate a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hardrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Lsf a owl:Class .

hpc:LSF_rejects_job rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Lsf .

hpc:LSF_kills_job rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:LSF_remembers_run_limit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Lsf .

hpc:LSF_rejects_run_limit_modification rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Runlimitmodification ;
    rdfs:range hpc:Lsf .

hpc:Runlimitmodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .

hpc:Jobmodification a owl:Class .

hpc:runtime_ratio rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeReal .

hpc:MIN rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Runlimitmodification ;
    rdfs:range xsd:nonNegativeInteger .
