hpc:Template a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A template for creating virtual machines." .

hpc:templateid a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:maxnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:nonNegativeInteger .

hpc:attributes a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range hpc:Attributelist .

hpc:Attributelist a owl:Class ;
    rdfs:subClassOf hpc:Namedthing ;
    rdfs:comment "A list of attributes for a template." .

hpc:Attribute a owl:Class ;
    rdfs:subClassOf hpc:Namedthing ;
    rdfs:comment "An attribute for a template." .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:unionOf(xsd:string xsd:xsd:X86_64) .

hpc:ncores a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:nonNegativeInteger .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:nonNegativeInteger .

hpc:awshost1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:boolean .

hpc:subnetid a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:keyname a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:securitygroupids a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:instancetags a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:ebsoptimized a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:boolean .

hpc:userdata a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:rcMaxRequests a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbRcUpdateInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
