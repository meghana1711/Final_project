@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:Hostname rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Hostmodel a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Hosttype a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Default rdfs:subClassOf hpc:Host .

hpc:hascheckpointcopy a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
