hpc:jobrestartcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of times the job has been restarted. This is only set if the job has been restarted at least once." .

hpc:slurmrlimitas a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Resource limit on the job's address space." .

hpc:slurmrlimitcore a owl:ObjectProperty
