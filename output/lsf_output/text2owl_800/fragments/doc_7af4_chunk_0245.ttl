hpc:Computeunit a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:member a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range rdf:List .
hpc:Enclosure a owl:Class ;
    rdfs:subClassOf hpc:Computeunit .
hpc:Rack a owl:Class ;
    rdfs:subClassOf hpc:Computeunit .
hpc:Cabinet a owl:Class ;
    rdfs:subClassOf hpc:Computeunit .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:string .
hpc:hasmembers a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit .

hpc:Validvalue a owl:Class .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Validvalue .
hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Validvalue .
hpc:Externallist a owl:Class ;
    rdfs:subClassOf hpc:Usergroup .
hpc:Wildcard a owl:Class .
hpc:Specialcharacter a owl:Class .
