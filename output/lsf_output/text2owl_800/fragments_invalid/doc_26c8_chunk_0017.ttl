hpc:Awsresourceconnector a owl:Class .
hpc:scriptpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:string .
hpc:managementhostaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:string .
hpc:proxyhostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:string .
hpc:proxyserverport a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:integer .
hpc:scriptOptions a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .
hpc:preprovpath a owl:ObjectProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:string .
hpc:postprovpath a owl:ObjectProperty ;
    rdfs:domain hpc:Awsresourceconnector ;
    rdfs:range xsd:string .

# AWS instance configuration

hpc:Awsinstance a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:privateipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:rcaccount a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:providername a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:providertype a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:templatename a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .
hpc:machineid a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:string .

# Script execution result

hpc:Scriptexecutionresult a owl:Class .
hpc:result a owl:DatatypeProperty ;
    rdfs:domain hpc:Scriptexecutionresult ;
    rdfs:range xsd:string .
hpc:message a owl:DatatypeProperty ;
    rdfs:domain hpc:Scriptexecutionresult ;
    rdfs:range xsd:string .
hpc:delayonreturn a owl:DatatypeProperty ;
    rdfs:domain hpc:Scriptexecutionresult ;
    rdfs:range xsd:integer .

# Script execution timeout

hpc:scripttimeout a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
