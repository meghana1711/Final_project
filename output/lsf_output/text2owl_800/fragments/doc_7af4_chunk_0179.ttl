hpc:Hostlist a owl:Class .
hpc:desc a owl:DatatypeProperty .

hpc:Clusteraffattrupdate a owl:Class .
hpc:user a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:string .
hpc:clusteraffattrname a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:string .
hpc:clusterassociation a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:boolean .
hpc:battrreset a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:boolean .
hpc:ttlstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:dateTime .
hpc:ttlresettime a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusteraffattrupdate ;
    rdfs:range xsd:dateTime .

hpc:Clusteraffinfo a owl:Class .
hpc:Clusteraffinfoevent a owl:Class ;
    rdfs:subClassOf hpc:Clusteraffinfo .
hpc:attributeinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinfoevent ;
    rdfs:range hpc:Clusteraffattrupdate .
