hpc:Jobwarningaction a owl:Class .
hpc:JOB_WARNING_ACTION rdfs:label "JOB_WARNING_ACTION" ;
                        rdfs:comment "Specifies the job action to be taken before a job control action occurs." .
hpc:JobWarningAction rdfs:subClassOf owl:Class .

hpc:haswarningaction a owl:ObjectProperty ;
                        rdfs:domain hpc:Jobwarningaction ;
                        rdfs:range xsd:string .

hpc:jobactionwarningtime a owl:DatatypeProperty ;
                           rdfs:domain hpc:Jobwarningaction ;
                           rdfs:range xsd:nonNegativeInteger .

hpc:URG a owl:NamedIndividual ;
       hpc:hasWarningAction "signal" ;
       hpc:JobActionWarningTime xsd:2 .

hpc:LoadIndex a owl:Class .
hpc:loadindex a owl:ObjectProperty ;
              rdfs:domain hpc:LoadIndex ;
              rdfs:range hpc:Loadindex .

hpc:Loadindex a owl:Class .
hpc:loadSched rdfs:subPropertyOf hpc:loadIndex ;
             rdfs:domain hpc:Loadindex ;
             rdfs:range xsd:string .

hpc:LoadIndexType a owl:Enum ;
                 rdfs:subClassOf owl:Class ;
                 rdfs:comment "Specify io, it, ls, mem, pg, r15s, r1m, r15m, swp, tmp, ut, or a non-shared custom external load index." .
hpc:io rdf:type hpc:LoadIndexType .
hpc:it rdf:type hpc:LoadIndexType .
hpc:ls rdf:type hpc:LoadIndexType .
hpc:mem rdf:type hpc:LoadIndexType .
hpc:pg rdf:type hpc:LoadIndexType .
hpc:r15s rdf:type hpc:LoadIndexType .
hpc:r1m rdf:type hpc:LoadIndexType .
hpc:r15m rdf:type hpc:LoadIndexType .
hpc:swp rdf:type hpc:LoadIndexType .
hpc:tmp rdf:type hpc:LoadIndexType .
hpc:ut rdf:type hpc:LoadIndexType .
