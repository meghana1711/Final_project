hpc:LsbDebugGpd a owl:Class .
hpc:LsbDebugMbd a owl:Class .

hpc:haslogclass a owl:ObjectProperty ;
    rdfs:domain hpc:LsbDebugGpd ;
    rdfs:range xsd:string .

hpc:haslogclassformbd a owl:ObjectProperty ;
    rdfs:domain hpc:LsbDebugMbd ;
    rdfs:range xsd:string .

hpc:LcAuth a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LcComm a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LcSys a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LcTrace a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LcXdr a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LcXdrversion a owl:Class ;
    rdfs:subClassOf hpc:Logclass .

hpc:LSB_DEBUG_MBD_DEFAULT a hpc:LC_XDRVERSION .

hpc:Logclass a owl:Class .
