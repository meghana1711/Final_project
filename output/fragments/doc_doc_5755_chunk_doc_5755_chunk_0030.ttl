hpc:Commit a owl:Class .
hpc:hasURL a owl:ObjectProperty .
hpc:hasURL rdfs:domain hpc:Commit .
hpc:hasURL rdfs:range xsd:string .

hpc:PatchFile a owl:Class .
hpc:hasContent a owl:ObjectProperty .
hpc:hasContent rdfs:domain hpc:PatchFile .
hpc:hasContent rdfs:range xsd:string .

hpc:SourceTarball a owl:Class .
hpc:hasVersion a owl:DatatypeProperty .
hpc:hasVersion rdfs:domain hpc:SourceTarball .
hpc:hasVersion rdfs:range xsd:string .

hpc:AppliedPatch a owl:ObjectProperty .
hpc:AppliedPatch rdfs:domain hpc:SourceTarball .
hpc:AppliedPatch rdfs:range hpc:PatchFile .

hpc:BuildMethod a owl:ObjectProperty .
hpc:BuildMethod rdfs:domain hpc:SourceTarball .
hpc:BuildMethod rdfs:range xsd:string .

hpc:BuildTool a owl:Class .
hpc:is a rdfs:subClassOf owl:Class .
hpc:BuildTool rdfs:subClassOf hpc:Tool .

hpc:Tool a owl:Class .

hpc:SlurmCommit a hpc:Commit .
hpc:SlurmCommit hpc:hasURL "https://github.com/SchedMD/slurm/commit/{commitHash}.patch" .

hpc:SlurmPatchFile a hpc:PatchFile .
hpc:SlurmPatchFile hpc:hasContent "< example.patch >" .

hpc:SlurmSourceTarball a hpc:SourceTarball .
hpc:SlurmSourceTarball hpc:hasVersion "23.11.1" .
hpc:SlurmSourceTarball hpc:AppliedPatch hpc:SlurmPatchFile .
hpc:SlurmSourceTarball hpc:BuildMethod "patch -p1 -d slurm-23.11.1/ < example.patch" .
hpc:SlurmSourceTarball hpc:BuildTool "patch" .
```
