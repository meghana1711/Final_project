hpc:Assocmaxjobslimit a owl:Class .
hpc:Assocmaxlicenseminutesperjob a owl:Class .

hpc:Assocmaxcpuminutesperjoblimit rdfs:subClassOf hpc:Assocmaxenergyminutesperjob ;
                                     rdfs:subClassOf hpc:Assocmaxgresminutesperjob ;
                                     rdfs:subClassOf hpc:Assocmaxlicenseminutesperjob .

hpc:Assocmaxcpuperjob rdfs:subClassOf hpc:Assocmaxcpupernode .
hpc:Assocmaxenergyperjob rdfs:subClassOf hpc:Assocmaxenergypernode .
hpc:Assocmaxgresperjob rdfs:subClassOf hpc:Assocmaxgrespernode .

hpc:Assocmaxcpuminutesperjob rdfs:domain hpc:Job ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxcpuperjob rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxcpupernode rdfs:domain hpc:Joballocation ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxenergyminutesperjob rdfs:domain hpc:Job ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxenergyperjob rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxenergypernode rdfs:domain hpc:Joballocation ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxgresminutesperjob rdfs:domain hpc:Job ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxgresperjob rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxgrespernode rdfs:domain hpc:Joballocation ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxjobslimit rdfs:domain hpc:User ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:Assocmaxlicenseminutesperjob rdfs:domain hpc:Job ;
