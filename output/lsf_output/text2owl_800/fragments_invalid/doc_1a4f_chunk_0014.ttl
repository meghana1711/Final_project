hpc:Cluster a owl:Class .
hpc:Ego a owl:Class .
hpc:Lsf a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:Aix a hpc:OperatingSystem .

hpc:Egoconf a owl:Class .
hpc:Lsfconf a owl:Class .

hpc:definencpus a owl:ObjectProperty .
hpc:Definencpus rdfs:domain hpc:Egoconf ;
                  rdfs:range xsd:string .

hpc:egoenabled a owl:ObjectProperty .
hpc:Egoenabled rdfs:domain hpc:Lsf ;
              rdfs:range xsd:boolean .

hpc:ncpus a owl:DatatypeProperty .
hpc:Ncpus rdfs:domain hpc:Cluster ;
         rdfs:range xsd:nonNegativeInteger .

hpc:Procs a owl:Class .
hpc:Cores a owl:Class .
hpc:Threads a owl:Class .

hpc:procsdefinencpus a owl:ObjectProperty .
hpc:ProcsDefineNcpus rdfs:subPropertyOf hpc:DefineNcpus ;
                      rdfs:domain hpc:Procs ;
                      rdfs:range xsd:string .

hpc:coresdefinencpus a owl:ObjectProperty .
hpc:CoresDefineNcpus rdfs:subPropertyOf hpc:DefineNcpus ;
                      rdfs:domain hpc:Cores ;
                      rdfs:range xsd:string .

hpc:threadsdefinencpus a owl:ObjectProperty .
hpc:ThreadsDefineNcpus rdfs:subPropertyOf hpc:DefineNcpus ;
                        rdfs:domain hpc:Threads ;
                        rdfs:range xsd:string .

hpc:procscores a owl:ObjectProperty .
hpc:Procscores rdfs:domain hpc:Procs ;
             rdfs:range hpc:Cores .

hpc:coresthreads a owl:ObjectProperty .
hpc:Coresthreads rdfs:domain hpc:Cores ;
             rdfs:range hpc:Threads .

hpc:procscoresthreads a owl:ObjectProperty .
hpc:ProcsCoresThreads rdfs:subPropertyOf hpc:ProcsCores ;
                       rdfs:domain hpc:Procs ;
                       rdfs:range hpc:Threads .

hpc:ncpusprocs a owl:ObjectProperty .
hpc:NcpusProcs rdfs:subPropertyOf hpc:Ncpus ;
             rdfs:domain hpc:Procs ;
             rdfs:range xsd:nonNegativeInteger .

hpc:ncpuscores a owl:ObjectProperty .
hpc:NcpusCores rdfs:subPropertyOf hpc:Ncpus ;
             rdfs:domain hpc:Cores ;
             rdfs:range xsd:nonNegativeInteger .

hpc:Ncp
