hpc:Project a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:License a owl:Class .
hpc:demandlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:disablepreemption a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:boolean .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range rdf:List .
hpc:Servicedomainmember a owl:Class ;
    rdfs:subClassOf hpc:Project .
hpc:servicedomainmemberlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range rdf:List .
hpc:servicedomainmemberProject a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomainmemberlist ;
    rdfs:range hpc:Project .
hpc:servicedomainmemberShares a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomainmemberlist ;
    rdfs:range xsd:integer .
hpc:servicedomainmemberLicensesowned a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomainmemberlist ;
    rdfs:range xsd:integer .
