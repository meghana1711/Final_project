hpc:Usergroup a owl:Class .
hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:File a owl:Class .
hpc:Inputfile a owl:Class .
    rdfs:subClassOf hpc:File .
hpc:Outputfile a owl:Class .
    rdfs:subClassOf hpc:File .
hpc:Cachecleanup a owl:Class .
hpc:Filequery a owl:Class .
hpc:Filebasedquery a owl:Class .
hpc:Jobbasedquery a owl:Class .

# Cache-related object properties
hpc:belongsToGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Usergroup .
hpc:isStagedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Host .
hpc:isReferencedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .
hpc:hasCacheCleanup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File .
hpc:hasFileQuery rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File .

# Cache-related datatype properties
hpc:hash rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:status rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:new rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:File .

# Cache cleanup properties
hpc:Inputfilerecord rdfs:range hpc:Inputfile ;
hpc:Outputfilerecord rdfs:range hpc:Outputfile .
