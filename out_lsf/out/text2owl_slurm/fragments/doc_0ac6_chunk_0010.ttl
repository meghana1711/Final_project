hpc:Rootlessdocker a owl:Class .
hpc:Dockercommand a owl:Class .
hpc:dockerhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Rootlessdocker ;
    rdfs:range xsd:string .
hpc:Environmentvariable a owl:Class .
hpc:daemonjsonfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .
hpc:scrunpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonjsonfile ;
    rdfs:range xsd:string .
hpc:dataroot a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonjsonfile ;
    rdfs:range xsd:string .
hpc:execroot a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonjsonfile ;
    rdfs:range xsd:string .
hpc:defaultruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonjsonfile ;
    rdfs:range xsd:string .
hpc:runtimes a owl:ObjectProperty ;
    rdfs:domain hpc:Daemonjsonfile ;
    rdfs:range hpc:Runtime .
hpc:Runtime a owl:Class ;
    rdfs:subClassOf hpc:Dockercommand ;
    rdfs:subClassOf hpc:Executable .
hpc:SlurmRuntime a hpc:Runtime ;
    hpc:Path hpc:scrunpath .
hpc:Internodesharedfilesystem a owl:Class .
hpc:avoidpermissionerrors a owl:ObjectProperty ;
    rdfs:domain hpc:Rootlessdocker ;
    rdfs:range hpc:Internodesharedfilesystem .
hpc:Performancepenalty a owl:Class .
hpc:avoidmovingfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Internodesharedfilesystem ;
    rdfs:range hpc:Performancepenalty .
