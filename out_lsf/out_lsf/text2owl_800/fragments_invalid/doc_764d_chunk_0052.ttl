hpc:Execution a owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:ExecutionHome rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Execution;
    rdfs:range xsd:string.

hpc:ExecutionCWD rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Execution;
    rdfs:range xsd:string.

hpc:ExecutionPid rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Execution;
    rdfs:range xsd:integer.

hpc:Host rdf:type owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:ExecutionCluster rdf:type owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:Job a owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:JobId rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:integer.

hpc:User rdf:type owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:Project rdf:type owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:Command rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.

hpc:Queue rdf:type owl:Class;
    rdfs:subClassOf owl:Thing.

hpc:JobName rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.

hpc:SubmitTime rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:dateTime.

hpc:FromHost rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.

hpc:JobState rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.

hpc:RequestedResources rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string.

hpc:ForwardedJobTo rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Executioncluster.

hpc:ForcedToRunOrForwardBy rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:User.

hpc:RemoteJobControlInitiated rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Execution;
    rdfs:range hpc:Execution.

