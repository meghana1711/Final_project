hpc:Windowsaccount a owl:Class .
hpc:Unixaccount a owl:Class .
hpc:Commandlineauthentication a owl:Class .
hpc:Passwordauthentication a owl:Class .
hpc:Localaccount a owl:Class .
hpc:Domainaccount a owl:Class .
hpc:Unixlocalaccount a owl:Class .
hpc:Domainunixaccount a owl:Class .
hpc:bjobscommand a owl:ObjectProperty .
hpc:Domainname rdfs:domain hpc:Bjobscommand ;
  rdfs:range xsd:string .
hpc:Username rdfs:domain hpc:Bjobscommand ;
  rdfs:range xsd:string .
hpc:lspasswdcommand a owl:ObjectProperty .
hpc:Password rdfs:domain hpc:Lspasswdcommand ;
  rdfs:range xsd:string .
hpc:maxPasswordLength xsd:integer .
hpc:lsfmasterlist a owl:DatatypeProperty .
hpc:Sharedfilesystem rdfs:domain hpc:Lsfmasterlist ;
  rdfs:range xsd:boolean .
hpc:Jobpermissions rdfs:domain hpc:Lsfmasterlist ;
  rdfs:range xsd:string .
