hpc:Model a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment model_name[- mem_size] .

hpc:Tile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment tile_num|'!' .

hpc:Memory a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment mem_value .

hpc:link a owl:ObjectProperty ;
    rdfs:domain hpc:Model ;
    rdfs:range hpc:Link .

hpc:size a owl:DatatypeProperty ;
    rdfs:domain hpc:Link ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Inputfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment input_file .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment job_name | "%job_limit" | job_id .

hpc:jobdescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobaffinity .

hpc:Attributename a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment attribute_name .

hpc:clusteraffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Checkpointdir a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment checkpoint_dir .

hpc:initialcheckpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdir ;
    rdfs:range xsd:nonNegativeInteger .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdir ;
    rdfs:range xsd:nonNegativeInteger .
