hpc:Jobid a owl:Class .
hpc:SameJobAffinityParameter a owl:Class .
hpc:samehostkeyword a owl:ObjectProperty .
hpc:specialcharacter a owl:DatatypeProperty .
hpc:Preference a owl:Enum .
hpc:DefaultPreference a hpc:Preference .
hpc:NoSameHost a hpc:Preference .
hpc:MandatorySameHost a hpc:Preference .
hpc:MandatoryNotSameHost a hpc:Preference .
hpc:samecukeyword a owl:ObjectProperty .
hpc:preferenceforsamecu a owl:DatatypeProperty .
hpc:DefaultPreferenceForSameCu a hpc:PreferenceForSameCu .
hpc:NoSameCu a hpc:PreferenceForSameCu .
hpc:MandatorySameCu a hpc:PreferenceForSameCu .
hpc:Jobid rdfs:subClassOf hpc:Jobelement .
hpc:SameJobAffinityParameter rdfs:subClassOf hpc:Parameter .
hpc:Samehostkeyword rdfs:domain hpc:SameJobAffinityParameter ;
                        rdfs:range xsd:string .
hpc:Specialcharacter rdfs:domain hpc:Samehostkeyword ;
                        rdfs:range xsd:string .
hpc:Preference rdfs:domain hpc:Specialcharacter ;
                        rdfs:range xsd:string .
hpc:Defaultpreference rdfs:subClassOf hpc:Preference .
hpc:Nosamehost rdfs:subClassOf hpc:Preference .
hpc:Mandatorysamehost rdfs:subClassOf hpc:Preference .
hpc:Mandatorynotsamehost rdfs:subClassOf hpc:Preference .
hpc:Samecukeyword rdfs:domain hpc:SameJobAffinityParameter ;
                        rdfs:range xsd:string .
hpc:Preferenceforsamecu rdfs:domain hpc:Samecukeyword ;
                        rdfs:range xsd:string .
hpc:Defaultpreferenceforsamecu rdfs:subClassOf hpc:Preferenceforsamecu .
hpc:Nosamecu rdfs:subClassOf hpc:Preferenceforsamecu .
hpc:Mandatorysamecu rdfs:subClassOf hpc:Preferenceforsamecu .
