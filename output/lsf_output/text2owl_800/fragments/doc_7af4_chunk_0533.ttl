hpc:Project a owl:Class .
hpc:Queue a owl:Class .
hpc:Hasproject rdfs:domain hpc:Project ;
                 rdfs:range rdf:Resource .
hpc:Belongstoqueue rdfs:domain hpc:Project ;
                   rdfs:range hpc:Queue .
hpc:queuename a owl:DatatypeProperty .
hpc:projectlist a owl:ObjectProperty .
hpc:queueslist a owl:ObjectProperty .

hpc:Allprojects rdfs:subClassOf hpc:Projectlist .
hpc:Allqueues rdfs:subClassOf hpc:Queueslist .
hpc:Allprojects rdfs:domain hpc:Limit ;
             rdfs:range rdf:List .
hpc:Allqueues rdfs:domain hpc:Limit ;
             rdfs:range rdf:List .
hpc:Perproject rdfs:subClassOf hpc:Projectlist .
hpc:Perqueue rdfs:subClassOf hpc:Queueslist .
hpc:Perproject rdfs:domain hpc:Limit ;
            rdfs:range rdf:List .
hpc:Perqueue rdfs:domain hpc:Limit ;
            rdfs:range rdf:List .
hpc:Projectinqueue rdfs:subClassOf hpc:Perqueue .
hpc:Queueinqueues rdfs:subClassOf hpc:Allqueues .

hpc:Projectinqueue rdfs:domain hpc:Project ;
                 rdfs:range hpc:Queue .
hpc:Queueinqueues rdfs:domain hpc:Queue ;
               rdfs:range rdf:List .
hpc:Notprojectinqueue rdfs:subClassOf hpc:Perproject .
hpc:Notqueueinqueues rdfs:subClassOf hpc:Allqueues .

hpc:Limit a owl:Class .
hpc:Haslimit rdfs:domain hpc:Project ;
             rdfs:range hpc:Limit .
hpc:Haslimit rdfs:domain hpc:Queue ;
             rdfs:range hpc:Limit .
hpc:Hasprojectlist rdfs:domain hpc:Limit ;
               rdfs:range hpc:Allprojects .
hpc:Hasqueuelist rdfs:domain hpc:Limit ;
               rdfs:range hpc:Allqueues .

hpc:Limitonproject rdfs:subClassOf hpc:Limit .
hpc:Limitonqueue rdfs:subClassOf hpc:Limit .

hpc:Limitonproject rdfs:domain hpc:Project ;
               rdfs:range hpc:Limitonproject .
hpc:Limitonqueue rdfs:domain hpc:Queue ;
               rdfs:range hpc:Limitonqueue .

hpc:Nolimit rdfs:subClassOf hpc:Limitonproject .
hpc:Nolimit rdfs:subClassOf hpc:Limitonqueue .

hpc:Projectname rdfs:domain hpc:Project ;
              rdfs:range xsd:string .
hpc:Queuename rdfs:domain hpc:Queue ;
              rdfs:range xsd:string .
