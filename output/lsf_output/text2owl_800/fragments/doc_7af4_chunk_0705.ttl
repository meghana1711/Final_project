hpc:Hugepagememory a owl:Class .

hpc:hugepagestotal a owl:DatatypeProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hugepagesfree a owl:DatatypeProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hugepagesreserved a owl:DatatypeProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hugepagessurplus a owl:DatatypeProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hugepagesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:decimal .

hpc:configurehugepagememory a owl:ObjectProperty .

hpc:checksupportandconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range hpc:Checkcommand .

hpc:Checkcommand a owl:Class .

hpc:setnumberofhugepagesusingproc a owl:ObjectProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:setnumberofhugepagesusingsysctl a owl:ObjectProperty ;
    rdfs:domain hpc:Hugepagememory ;
    rdfs:range xsd:nonNegativeInteger .

hpc:makechangepermanent a owl:ObjectProperty ;
    rdfs:domain hpc:Hugepagememory .

hpc:reboot a owl:ObjectProperty ;
    rdfs:domain hpc:Hugepagememory .
