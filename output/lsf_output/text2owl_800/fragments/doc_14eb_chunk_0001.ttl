hpc:Product a owl:Class .
hpc:Vendorsoftware a owl:Class .
hpc:Accessibilityfeature a owl:Class .
hpc:Screenreader a owl:Class .
hpc:latestrelease a owl:DatatypeProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range xsd:string .
hpc:compatiblewith a owl:ObjectProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range hpc:Webbrowser .
hpc:accessibilitycompliance a owl:ObjectProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range hpc:Accessibilityfeature .
hpc:standardnavigation a owl:ObjectProperty .
hpc:Ttyservice a owl:Class .
hpc:ttytelephonenumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Ttyservice ;
    rdfs:range xsd:string .
hpc:northamerica a owl:DatatypeProperty ;
    rdfs:domain hpc:Ttytelephonenumber ;
    rdfs:range xsd:string .
hpc:ibmaccessibility a owl:ObjectProperty ;
    rdfs:domain hpc:Product ;
    rdfs:range hpc:Accessibilityfeature .
hpc:Ibmspectrumlsfvideo a owl:Class .
hpc:ibmspectrumlsfusergrouplibrary a owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsfvideo ;
    rdfs:range hpc:Class .
