hpc:datatransferrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Specify the estimated data transfer rate in kilobits per second (kbps). Default 1048576 (1 Gbps)." .

hpc:stepcgroupdefault a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Run the bsub -step_cgroup option at job submission time to override this default value. Default Not deﬁned." .

hpc:startebrokerd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables the mbatchd daemon to start the ebrokerd daemon whenever mbatchd starts up, is reconﬁgured, or when it detects that the old ebrokerd daemon exits." .

hpc:startmps a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "LSF starts CUDA MPS (Multi-Process Service) for the GPU jobs that require only GPUs with EXCLUSIVE_PROCESS or DEFAULT modes." .
