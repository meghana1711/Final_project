hpc:Lsfmanagementhost a owl:Class .
hpc:Gpgkey a owl:Class .
hpc:generatekey a owl:ObjectProperty .
hpc:editlsfsudoersfile a owl:ObjectProperty .
hpc:appendgpgkey a owl:ObjectProperty .
hpc:Lsfhost a owl:Class .
hpc:reconfigurecluster a owl:ObjectProperty .
hpc:restartcluster a owl:ObjectProperty .
hpc:enableexternalauthentication a owl:ObjectProperty .
hpc:setuidbit a owl:ObjectProperty .
hpc:Lsfadministrationcommand a owl:Class .

hpc:Lsfmanagementhost rdfs:subClassOf owl:Thing .
hpc:Gpgkey rdfs:subClassOf owl:Thing .
hpc:Lsfhost rdfs:subClassOf owl:Thing .
hpc:Lsfadministrationcommand rdfs:subClassOf owl:Thing .

hpc:Generatekey rdfs:domain hpc:Lsfmanagementhost ;
                 rdfs:range hpc:Gpgkey .
hpc:Editlsfsudoersfile rdfs:domain hpc:Lsfmanagementhost ;
                      rdfs:range hpc:Lsfmanagementhost .
hpc:Appendgpgkey rdfs:domain hpc:Lsfmanagementhost ;
                 rdfs:range hpc:Lsfmanagementhost .
hpc:Reconfigurecluster rdfs:domain hpc:Lsfmanagementhost ;
                      rdfs:range hpc:Lsfhost .
hpc:Restartcluster rdfs:domain hpc:Lsfhost .
hpc:Enableexternalauthentication rdfs:domain hpc:Lsfhost .
hpc:Setuidbit rdfs:domain hpc:Lsfmanagementhost ;
                 rdfs:range hpc:Lsfadministrationcommand .
