hpc:Cluster a owl:Class .
hpc:Partition a owl:Class, rdfs:subClassOf hpc:Cluster .

# Job
hpc:Job a owl:Class .
hpc:hasPartition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .
hpc:hasNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasNodeList rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

# PreemptMode
hpc:PreemptMode a owl:Class .
hpc:hasValue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PreemptMode ;
    rdfs:range xsd:string .

# SelectPlugin
hpc:SelectPlugin a owl:Class .
hpc:canPreempt rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:boolean .
hpc:usesPreemptParameters rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:string .
hpc:considersPreemptableJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:string .
hpc:sortsPreemptableJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:string .
hpc:determinesPreemption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:string .
hpc:simulatesPreemption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:boolean .
hpc:reordersPreemptionCandidates rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SelectPlugin ;
    rdfs:range xsd:boolean .

# PreemptableJob
hpc:PreemptableJob a owl:Class .
hpc:hasQOSPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PreemptableJob ;
    rdfs:range xsd:float .
hpc:hasPartitionPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PreemptableJob ;
    rdfs:range xsd:float .
hpc:hasJobSize rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PreemptableJob ;
    rdfs:range xsd:nonNegativeInteger .
