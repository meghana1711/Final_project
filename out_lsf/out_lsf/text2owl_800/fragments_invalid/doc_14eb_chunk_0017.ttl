hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a set of pending jobs, lined up in a defined order and waiting for their opportunity to use resources." .

hpc:haspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Priority of the queue." .

hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the queue." .

hpc:hasqueuelimits a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queuelimits ;
    rdfs:comment "Queue restrictions on hosts, number of jobs, users, groups, or processors." .

hpc:hasstandardunixlinuxlimits a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Standardunixlinuxlimits ;
    rdfs:comment "Standard UNIX and Linux limits (memory, swap, process, CPU)." .

hpc:hasschedulingpolicies a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Schedulingpolicies ;
    rdfs:comment "Scheduling policies implemented by the queue." .

hpc:hasadministrators a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:User ;
    rdfs:comment "Administrators of the queue." .

hpc:hasrunconditions a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Runconditions ;
    rdfs:comment "Conditions under which the queue can run jobs." .

hpc:hasloadsharingthresholdconditions a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Loadsharingthresholdconditions ;
    rdfs:comment "Load-sharing threshold conditions." .

hpc:hasunixnicevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "UNIX nice value (sets the UNIX and Linux scheduler priority)." .

hpc:hasqueuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Defines the order in which queues are searched to determine which job will be processed. Queues are assigned a priority by the LSF administrator, where a higher number has a higher priority." .

hpc:automaticqueueselection a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queueselection ;
    rdfs:comment "When you submit a job, LSF considers the requirements of the job and automatically chooses a suitable queue from a list of candidate default queues."
