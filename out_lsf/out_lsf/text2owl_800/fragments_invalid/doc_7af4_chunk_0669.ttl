hpc:Bqueuesformat a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Bqueuesoption a owl:Class ;
    rdfs:subClassOf owl:Class .

# Object Properties
hpc:hasfieldcustomization a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesoption ;
    rdfs:range hpc:Fieldcustomization .

# Datatype Properties
hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldcustomization ;
    rdfs:range xsd:string .

hpc:outputjustification a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldcustomization ;
    rdfs:range xsd:string .

hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldcustomization ;
    rdfs:range xsd:nonNegativeInteger .

hpc:delimiter a owl:DatatypeProperty ;
    rdfs:domain hpc:Bqueuesformat ;
    rdfs:range xsd:string .

# Range restrictions
hpc:Fieldcustomization rdfs:subClassOf (hpc:Customization and (hpc:Hasfieldcustomization someValueFrom (hpc:Bqueuesoption))) .

hpc:Customization rdfs:subClassOf owl:Class .

hpc:Bqueuesoption rdfs:subClassOf (owl:Class and (hpc:Appliesto someValueFrom (hpc:Bqueuesformat or hpc:Bqueuescommandoption))) .

hpc:Bqueuesformat rdfs:subClassOf owl:Class .

hpc:Bqueuescommandoption rdfs:subClassOf owl:Class .


This ontology defines classes for `BQueuesFormat`, `BQueuesOption`, and `FieldCustomization`. It also defines object and datatype properties to model the relationships between these classes, such as `hasFieldCustomization`, `fieldName`, `outputJustification`, `outputWidth`, and `delimiter`. Range restrictions are also defined for some properties to ensure the correct data types are used.
