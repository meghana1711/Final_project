hpc:OpenapiResponse a owl:Class ;
  rdfs:subClassOf [ owl:Thing ] ;
  rdfs:subClassOf [
    hpc:ResponseSchema
  ] ;
  rdfs:subClassOf [
    rdf:Property
  ] ;
  rdfs:domain hpc:APIOperation ;
  rdfs:range rdf:Resource ;

hpc:OpenapiResp a hpc:OpenapiResponse ;
  rdf:about "http://example.org/hpc#v0.0.40_openapi_resp" ;

