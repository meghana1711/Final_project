hpc:Applicationprofile a owl:Class .
hpc:suspendreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobgroup a owl:Class .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobgroupname a owl:ObjectProperty ;
    rdfs:domain hpc:Suspendoptions ;
    rdfs:range hpc:Jobgroup .
hpc:jobnamepattern a owl:ObjectProperty ;
    rdfs:domain hpc:Suspendoptions ;
    rdfs:range xsd:string .
hpc:retries a owl:ObjectProperty ;
    rdfs:domain hpc:Signalrequest ;
    rdfs:range xsd:integer .
hpc:Suspendoptions a owl:Class .
