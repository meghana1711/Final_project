hpc:Hasawstaginstanceid rdfs:domain hpc:Awsconfig ;
                                               rdfs:range xsd:boolean .
hpc:Awsconfig rdfs:subClassOf (hpc:Config .
                                               rdfs:subClassOf owl:Class) .
hpc:Awsconfig rdfs:subClassOf (hpc:Resourceconnectorconfig .
                                               rdfs:subClassOf owl:Class) .

hpc:computeunithost a owl:DatatypeProperty .
hpc:AwsprovTemplates a owl:Class .
hpc:Ibmcloudgen2Templates a owl:Class .
hpc:AwsprovTemplates rdfs:subClassOf owl:Class .
hpc:Ibmcloudgen2Templates rdfs:subClassOf owl:Class .

