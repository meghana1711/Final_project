hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a computing queue." .

hpc:prio a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Priority of the queue." .

hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queuestatus ;
    rdfs:comment "Current status of the queue." .

hpc:max a owl
