hpc:Span a owl:Class .
hpc:ptile a owl:DatatypeProperty .
hpc:hosts a owl:DatatypeProperty .
hpc:same a owl:ObjectProperty .
hpc:Type a owl:Class .
hpc:Model a owl:Class .

hpc:Span rdfs:subClassOf owl:Class .
hpc:Ptile rdfs:domain hpc:Span ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hosts rdfs:domain hpc:Span ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Same rdfs:domain hpc:Span ;
    rdfs:range hpc:Resource .
hpc:Type rdfs:subClassOf hpc:Resource .
hpc:Model rdfs:subClassOf hpc:Resource .

hpc:ptile '!' rdfs:comment "Predefined ptile value." .
hpc:Ptile '!' rdfs:domain hpc:Span ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:default (xsd:nonNegativeInteger "1") .
hpc:hosts -1 rdfs:comment "Disables span setting in the queue." .

hpc:same[type] rdfs:subPropertyOf hpc:same .
hpc:same[model] rdfs:subPropertyOf hpc:same .

hpc:Span[ptile='!'] rdfs:comment "Uses the predefined maximum job slot limit lsb.hosts (MXJ) as its value." .
hpc:Span[ptile='!', hpc:type same[type]] rdfs:comment "For host type, you must specify same[type] in the resource requirement." .
hpc:Span[ptile='!', hpc:model same[model]] rdfs:comment "For host model, you must specify same[model] in the resource requirement." .
hpc:Span[ptile='!', hpc:type same[type], hpc:type hpc:Type1] rdfs:comment "Specifies the ptile value for a specific host type." .
hpc:Span[ptile='!', hpc:model same[model], hpc:model hpc:Model1] rdfs:comment "Specifies the ptile value for a specific host model." .
hpc:Span[ptile='!', hpc:type same[type], hpc:model same[model]] rdfs:comment "Error: Cannot specify both type and model in the span section." .
