hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:User a owl:Class .
hpc:State a owl:EnumeredClass ;
    rdfs:subClassOf owl:Class ;
    owl:enum "PD" "R" .
hpc:Node a owl:Class .
hpc:NodeList a owl:Class .
hpc:hasJob a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Job .
hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .
hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:hasState a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:State .
hpc:hasNodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:NodeList .
hpc:usesCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:isIdle a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:boolean .

hpc:DefaultNodeAllocation a hpc:Partition ;
    rdfs:subClassOf hpc:Partition .
hpc:ProcessorConsumableResourceApproach a hpc:Partition ;
    rdfs:subClassOf hpc:Partition .

hpc:NonSharedMode a hpc:DefaultNodeAllocation .
hpc:ExclusiveMode a hpc:DefaultNodeAllocation .
```
