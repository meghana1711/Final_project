hpc:Badmin a owl:Class .
hpc:sbddebug a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range hpc:Sbddebugaction .
hpc:Sbddebugaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Log messages for sbatchd or mbatchd." .
hpc:sbddebugactionHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbddebugaction ;
    rdfs:range xsd:string ;
    rdfs:comment "Host to which log messages are sent." .
hpc:sbddebugactionFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbddebugaction ;
    rdfs:range xsd:string ;
    rdfs:comment "File name for log messages." .
hpc:sbddebugactionLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbddebugaction ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Log message level." .
hpc:schddebug a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range hpc:Schddebugaction .
hpc:Schddebugaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Log messages for mbatchd on the local host." .
hpc:schddebugactionLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Schddebugaction ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Log message level." .
hpc:schddebugactionQueuesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Schddebugaction ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of entries in the logging queue." .
hpc:schddebugactionClass a owl:DatatypeProperty ;
    rdfs:domain hpc:Schddebugaction ;
    rdfs:range xsd:string ;
    rdfs:comment "Classes to reset after turning off debug settings." .
hpc:schtime a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range hpc:Schtimeaction .
hpc:Schtimeaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Activate the LSF scheduling debug feature." .
hpc:resdebug a owl:ObjectProperty ;
    rdfs:domain hpc:Lsadmin ;
    rdfs:range hpc:Resdebugaction .
hpc:Resdebugaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Turn off temporary debug settings for RES." .
