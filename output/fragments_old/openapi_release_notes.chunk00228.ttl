hpc:OpenapiJobInfoResp a owl:Class .
hpc:OpenapiKillJobsResp a owl:Class .

hpc:JobInfoResp a owl:Class, rdfs:subClassOf [ a owl:Class; rdf:type owl:Restriction; owl:onProperty hpc:jobInfoProp ] .
hpc:JobKillResp a owl:Class, rdfs:subClassOf [ a owl:Class; rdf:type owl:Restriction; owl:onProperty hpc:jobKillProp ] .

hpc:jobInfoProp a owl:ObjectProperty .
hpc:jobKillProp a owl:ObjectProperty .

hpc:jobInfoProp rdfs:domain hpc:OpenapiJobInfoResp ;
                 rdfs:range xsd:anyURI .

hpc:jobKillProp rdfs:domain hpc:OpenapiKillJobsResp ;
                rdfs:range xsd:anyURI .
```
