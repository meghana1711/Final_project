hpc:Resource a owl:Class .
hpc:Nonconsumableresource rdfs:subClassOf hpc:Resource .
hpc:increasing a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:interval a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicresource ;
    rdfs:range xsd:integer .
hpc:Globalresource rdfs:subClassOf hpc:Resource ;
    owl:differentFrom hpc:SharedResource .
hpc:Releasable rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Globalresource .
hpc:Suspendedjob rdfs:subClassOf hpc:Job .
hpc:Resourceusage rdfs:subClassOf hpc:Resource .
hpc:Sampledresource rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Dynamicresource .
hpc:Externalloadindex rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:Sampledresource .
hpc:Sharedresource rdfs:subClassOf hpc:Resource .
hpc:suspendedjobholdsresource a owl:ObjectProperty ;
    rdfs:domain hpc:Suspendedjob ;
    rdfs:range hpc:Sharedresource ;
    rdfs:subPropertyOf hpc:JobHoldsResource .
hpc:suspendedjobreleasesresource a owl:ObjectProperty ;
    rdfs:domain hpc:Suspendedjob ;
    rdfs:range hpc:Releasable ;
    rdfs:subPropertyOf hpc:JobReleasesResource .
