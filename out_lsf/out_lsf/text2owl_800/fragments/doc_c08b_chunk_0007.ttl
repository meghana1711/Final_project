hpc:Kerberosuser a owl:Class .
hpc:Kerberosticket a owl:Class .
hpc:Kerberoscache a owl:Class .
hpc:Kerberosprincipal a owl:Class .
hpc:kerberosexpiration a owl:DatatypeProperty ;
    rdfs:domain hpc:Kerberosticket ;
    rdfs:range xsd:dateTime .
hpc:Kerberosservice a owl:Class ;
    rdfs:subClassOf hpc:Kerberosprincipal .
hpc:kinit a owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosuser ;
    rdfs:range hpc:Kerberosticket .
hpc:klist a owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosuser ;
    rdfs:range hpc:Kerberoscache .
hpc:Afsjob a owl:Class .
hpc:Afsvolume a owl:Class .
hpc:afsreadwrite a owl:ObjectProperty ;
    rdfs:domain hpc:Afsjob ;
    rdfs:range hpc:Afsvolume .
hpc:lsfhousekeeping a owl:ObjectProperty ;
    rdfs:domain hpc:Afsjob ;
    rdfs:range xsd:boolean .
