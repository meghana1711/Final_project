hpc:Cluster a owl:Class .
hpc:Queue a owl:Class .
hpc:Job a owl:Class .
hpc:Totalslots rdfs:domain hpc:Cluster .
hpc:Totalslots rdfs:range xsd:nonNegativeInteger .
hpc:Runningslots rdfs:domain hpc:Cluster .
hpc:Runningslots rdfs:range xsd:nonNegativeInteger .
hpc:Pendingslots rdfs:domain hpc:Cluster .
hpc:Pendingslots rdfs:range xsd:nonNegativeInteger .
hpc:Priority rdfs:domain hpc:Queue .
hpc:Priority rdfs:range xsd:nonNegativeInteger .
hpc:hasqueue a owl:ObjectProperty .
hpc:Hasqueue rdfs:domain hpc:Cluster .
hpc:Hasqueue rdfs:range hpc:Queue .
hpc:hasjob a owl:ObjectProperty .
hpc:Hasjob rdfs:domain hpc:Queue .
hpc:Hasjob rdfs:range hpc:Job .
hpc:mcPluginScheduleEnhance a owl:DatatypeProperty .
hpc:McPluginScheduleEnhance rdfs:range xsd:string .
hpc:mcPluginUpdateInterval a owl:DatatypeProperty .
hpc:McPluginUpdateInterval rdfs:range xsd:nonNegativeInteger .
hpc:Cluster1 a hpc:Cluster .
hpc:HighPriority@Cluster2 a hpc:Queue .
hpc:HighPriority@Cluster3 a hpc:Queue .
hpc:LowPriority a hpc:Queue .
hpc:Cluster2
    a hpc:Cluster ;
    hpc:hasQueue Cluster2:HighPriority ;
    hpc:hasQueue Cluster2:LowPriority .
hpc:Cluster3
    a hpc:Cluster ;
    hpc:hasQueue Cluster3:HighPriority ;
    hpc:hasQueue Cluster3:LowPriority .
Cluster2:HighPriority
    a hpc:Queue ;
    hpc:Priority 60 ;
    hpc:RunningSlots 20 ;
    hpc:PendingSlots 20 .
Cluster2:LowPriority
    a hpc:Queue ;
    hpc:Priority 20 ;
    hpc:RunningSlots 50 ;
    hpc:PendingSlots 0 .
Cluster3:HighPriority
    a hpc:Queue ;
    hpc:Priority 70 ;
    hpc:RunningSlots 30 ;
    hpc:PendingSlots 5 .
Cluster3:LowPriority
    a hpc:Queue ;
    hpc:Priority 20 ;
    hpc:RunningSlots 60 ;
    hpc:PendingSlots 0 .
