hpc:Job a owl:Class .
hpc:Dataspecificationfile a owl:Class .
hpc:Datafile a owl:Class .
hpc:dataspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range rdf:* .
hpc:hasdatafile a owl:ObjectProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range rdf:* .
hpc:Datagroup a owl:Class .
hpc:hasdatagroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range rdf:Literal .
hpc:Queue a owl:Class .
hpc:issubmittedto a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:hasdata a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:* .
hpc:Dataspecificationfilewithwildcard a owl:Class .
    rdfs:subClassOf hpc:Dataspecificationfile .
hpc:Datafolder a owl:Class .
hpc:Arrayjob a owl:Class .
hpc:Taggeddatafile a owl:Class .
