hpc:Command a owl:Class .
hpc:helpoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Command .

hpc:versionoption a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Bdatacommand a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Bjobscommand a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Datarequirement a owl:Class .
hpc:datafilerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .
hpc:datatagrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .

hpc:filterbydataoption a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Datarequirement .
