hpc:LsfConfiguration a owl:Class .
hpc:LsfRcExternalHostFlag rdfs:domain hpc:LsfConfiguration .
hpc:LsfMqBrokerHosts rdfs:domain hpc:LsfConfiguration .
hpc:MqttBrokerHost rdfs:domain hpc:LsfConfiguration .
hpc:MqttBrokerPort rdfs:domain hpc:LsfConfiguration .

# LSF Resource Connector
hpc:LsfResourceConnector a owl:Class .
hpc:HasLsfRcExternalHostFlag hpc:LsfResourceConnector rdfs:range xsd:string .

# LSF Message Broker
hpc:MqttMessageBroker a owl:Class .
hpc:RunsMosquitto hpc:mqttMessageBroker .
hpc:Mosquitto rdfs:range hpc:MqttMessageBroker .

# LSF Job Exceptions
hpc:JobExitRate a owl:Class .
hpc:HasExitRate hpc:JobExitRate rdfs:range xsd:nonNegativeInteger .
hpc:HasJobExitRateDuration hpc:JobExitRate rdfs:range xsd:nonNegativeInteger .

# LSF Host
hpc:Host a owl:Class .
hpc:HasJobExitRate hpc:Host rdfs:domain hpc:Host .
hpc:HasJobExitRateDuration hpc:Host rdfs:domain hpc:Host .

# LSF Command
hpc:Command a owl:Class .
hpc:IsPs hpc:command .
hpc:HasMosquitto hpc:Command rdfs:range hpc:MqttMessageBroker .

# LSF Host Exception
hpc:HostException a owl:Class .
hpc:HasHost hpc:HostException rdfs:range hpc:Host .
hpc:HasDetailedInformation hpc:HostException rdfs:range xsd:string .

# LSF Host Group and Compute Unit
hpc:HostGroupAndComputeUnit a owl:Class .
hpc:HasUncondensedOutput hpc:HostGroupAndComputeUnit rdfs:range xsd:string .
hpc:SatisfiesResourceRequirement hpc:HostGroupAndComputeUnit rdfs:range xsd:boolean .

# LSF Resource Requirement Expression
hpc:ResourceRequirementExpression a owl:Class .
hpc:IsIgnoredByLsf hpc:ResourceRequirementExpression rdfs:subClassOf hpc:ResourceRequirementExpression .
