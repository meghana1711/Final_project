hpc:Job a owl:Class .
hpc:JobID rdf:type xsd:integer .
hpc:Jobid rdfs:domain hpc:Job .
hpc:Jobid rdfs:range xsd:integer .

hpc:Command a owl:Class .
hpc:Command rdf:type owl:ObjectProperty .
hpc:Command rdfs:domain hpc:Job .

hpc:Host a owl:Class .
hpc:Host rdf:type owl:Class .

hpc:HostName rdf:type owl:DatatypeProperty .
hpc:Hostname rdfs:domain hpc:Host .
hpc:Hostname rdfs:range xsd:string .

hpc:Lsf a owl:Class .
hpc:LSF rdf:type owl:Class .

hpc:lsruncommand a owl:ObjectProperty .
hpc:Lsruncommand rdfs:domain hpc:Lsf .
hpc:Lsruncommand rdfs:range hpc:Command .

hpc:lsgruncommand a owl:ObjectProperty .
hpc:Lsgruncommand rdfs:domain hpc:Lsf .
hpc:Lsgruncommand rdfs:range hpc:Command .

hpc:Resource rdf:type owl:Class .
hpc:Resource rdfs:subClassOf hpc:Host .

hpc:SharedResource rdf:type owl:Class .
hpc:Sharedresource rdfs:subClassOf hpc:Resource .

hpc:SoftwareLicense rdf:type owl:Class .
hpc:Softwarelicense rdfs:subClassOf hpc:Sharedresource .

hpc:Wrapperscript a owl:Class .
hpc:WrapperScript rdf:type owl:ObjectProperty .
hpc:Wrapperscript rdfs:domain hpc:Application .
