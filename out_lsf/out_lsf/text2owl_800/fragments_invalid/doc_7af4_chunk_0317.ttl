hpc:Jobinfocache a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Reducing the load on the jobinfo cache means a reduction in mbatchd input and output operations to achieve better mbatchd performance." ;
    rdfs:label "JobInfoCache" ;
    rdfs:subPropertyChain [ rdfs:domain hpc:Jobinfocache ;
                                rdfs:range xsd:integer ] .

hpc:Validvalues a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Valid values for JobInfoCache" ;
    rdfs:label "ValidValues" ;
    rdfs:subPropertyChain [ rdfs:domain hpc:Jobinfocache ;
                                rdfs:range xsd:integer ] .

hpc:Jobpositioncontrolbyadmin a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Allows LSF administrators to control whether users can use btop and bbot to move jobs to the top and bottom of queues." ;
    rdfs:label "JobPositionControlByAdmin" ;
    rdfs:subPropertyChain [ rdfs:domain hpc:Jobpositioncontrolbyadmin ;
                                rdfs:range xsd:string ] .

hpc:jobPositionControlByAdmin a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpositioncontrolbyadmin ;
    rdfs:range xsd:string ;
    rdfs:comment "Syntax for JobPositionControlByAdmin" ;
    rdfs:label "JOB_POSITION_CONTROL_BY_ADMIN" .

hpc:bbot a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpositioncontrolbyadmin ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also bbot" ;
    rdfs:label "bbot" .

hpc:btop a owl:ObjectProperty ;
    rdfs:domain hpc:Jobpositioncontrolbyadmin ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also btop" ;
    rdfs:label "btop" .

hpc:Jobinfoeventdumpinterval a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "See also JOB_INFO_EVENT_DUMP_INTERVAL in lsb.params" ;
    rdfs:label "JobInfoEventDumpInterval" ;
    rdfs:subPropertyChain [ rdfs:domain hpc:Jobinfocache ;
                                rdfs:range rdf:Resource ] .

hpc:LsbJobinfoDir a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "See also LSB_JOBINFO_DIR in lsf.conf" ;
    rdfs:label "LSB_JOBINFO_DIR" ;
    rdfs:subPropertyChain [ rdfs:domain hpc:Jobinfocache ;
                                rdfs:range rdf:Resource ] .

hpc:JOB_POSITION_CONTROL_BY_ADMIN
