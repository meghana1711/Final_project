hpc:jobSchedulingInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Interval between job scheduling events." .

hpc:acctArchiveAge a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:day ;
    rdfs:comment "Age of accounts before archiving." .

hpc:acctArchiveSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Size limit for account archives in GB." .

hpc:acctArchiveTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:time ;
    rdfs:comment "Time for account archiving." .

hpc:defaultProject a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:string ;
    rdfs:comment "Default project name." .

hpc:defaultResreqOrder a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:string ;
    rdfs:comment "Default resource requirement order." .

hpc:enableDiagnose a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:string ;
    rdfs:comment "Enable diagnostic mode." .

hpc:enableHostIntersection a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enable host intersection." .

hpc:enforceUgTree a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enforce user group tree." .

hpc:extendJobExceptionNotify a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Extend job exception notification." .

hpc:jobDistributeOnHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:string ;
    rdfs:comment "Job distribution strategy on host." .

hpc:jobInfoEventDumpInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Interval for job information event dump." .

hpc:jobInfoMemoryCacheSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Settings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Memory cache size for job information." .

hpc:LOCAL
