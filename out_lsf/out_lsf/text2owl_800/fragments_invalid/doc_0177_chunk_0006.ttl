hpc:Resourceprovider a owl:Class .
hpc:IBMCloudGen2 a hpc:ResourceProvider .

hpc:Host a owl:Class .
hpc:ibmcloud01 a hpc:Host .

hpc:hasncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:isprovisionedby a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceprovider ;
    rdfs:range hpc:Host .

hpc:Resourceconnector a owl:Class .
hpc:isconfiguredtoconnectto a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Cluster .

hpc:Cluster a owl:Class .

hpc:Template a owl:Class ;
    rdfs:subClassOf hpc:Resourceprovider ;
    rdfs:subClassOf hpc:Object .
    rdfs:subClassOf hpc:Hasncpus .
    rdfs:subClassOf hpc:Status .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Object .
    rdfs:subClassOf hp:requiresASlot .

hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:joinscluster a owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:bhostsrc a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
    rdfs:range hpc:Providerhostinfo .

hpc:bhostsrconly a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
    rdfs:range hpc:Providerhostinfo .

hpc:Providerhostinfo a owl:Class .

hpc:lsbRcExternalHostFlag a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector .
    rdfs:range xsd:boolean .

hpc:mosquittobinary a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector .
    rdfs:range xsd:string .
