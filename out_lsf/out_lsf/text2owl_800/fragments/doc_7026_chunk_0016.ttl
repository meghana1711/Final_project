hpc:Userrights a owl:Class .
hpc:BasicRights a hpc:UserRights ;
    rdfs:subClassOf hpc:Userrights .
hpc:DetailRights a hpc:UserRights ;
    rdfs:subClassOf hpc:Userrights .

hpc:Jobinformationaccesscontrol a owl:Class .

hpc:secureJobInfoLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range xsd:integer .

hpc:enableJobInfoByAdminRole a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range xsd:boolean .

hpc:secureInfodirUserAccess a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range xsd:string .

hpc:jobcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class .

hpc:joblevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range xsd:integer .

hpc:JobLevel0 a hpc:JobLevel ;
    rdfs:subClassOf xsd:integer .
hpc:JobLevel1 a hpc:JobLevel ;
    rdfs:subClassOf xsd:integer .
hpc:JobLevel2 a hpc:JobLevel ;
    rdfs:subClassOf xsd:integer .
hpc:JobLevel3 a hpc:JobLevel ;
    rdfs:subClassOf xsd:integer .
hpc:JobLevel4 a hpc:JobLevel ;
    rdfs:subClassOf xsd:integer .

hpc:Jobinformation a owl:Class .
hpc:SummaryInformation a hpc:JobInformation ;
    rdfs:subClassOf hpc:Jobinformation .
hpc:DetailInformation a hpc:JobInformation ;
    rdfs:subClassOf hpc:Jobinformation .

hpc:Job a owl:Class .
