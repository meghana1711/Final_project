hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:DefaultAccount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:AccountName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:User .
hpc:Modify a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range xsd:string .
hpc:Remove a owl:ObjectProperty ;
    rdfs:domain xsd:string ;
    rdfs:range xsd:string .
hpc:ModifiedEntity a owl:Class ;
    rdfs:subClassOf hpc:Entity .
hpc:DeletedEntity a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:subClassOf hpc:ModifiedEntity .
hpc:RemovedEntity a owl:Class ;
    rdfs:subClassOf hpc:ModifiedEntity .
hpc:Entity a owl:Class .
```
