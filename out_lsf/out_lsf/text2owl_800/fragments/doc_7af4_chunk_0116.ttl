hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Action a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents an action that can be performed on a job." .

hpc:Suspendaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Represents a suspend action on a job." .

hpc:suspend a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Suspendaction ;
    rdfs:comment "The suspend action performed on a job." .

hpc:Checkpointaction a owl:Class ;
    rdfs:subClassOf hpc:Action ;
    rdfs:comment "Represents a checkpoint action on a job." .

hpc:checkpoint a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointaction ;
    rdfs:comment "The checkpoint action performed on a job." .

hpc:runcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Suspendaction ;
    rdfs:range xsd:string ;
    rdfs:comment "The command run when the suspend action is triggered." .

hpc:redirectio a owl:ObjectProperty ;
    rdfs:domain hpc:Runcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The device to which the standard input, output, and error of the command are redirected." .

hpc:runasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Runcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The user under which the command is run." .

hpc:inheritsenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Runcommand ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the command inherits the environment variables of the job." .
