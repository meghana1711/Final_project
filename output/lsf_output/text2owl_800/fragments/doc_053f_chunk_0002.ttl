hpc:Cluster a owl:Class .
hpc:Host a owl:Class .
hpc:Slot a owl:Class .

hpc:hasslot a owl:ObjectProperty .
hpc:Hasslot rdfs:domain hpc:Host ;
    rdfs:range rdfs:Resource .

hpc:numslots a owl:DatatypeProperty .
hpc:Numslots rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:numcpusingroup a owl:DatatypeProperty .
hpc:Numcpusingroup rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maxhostgroups a owl:DatatypeProperty .
hpc:Maxhostgroups rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Paralleljob a owl:Class .
