hpc:Firstexecutionhostcandidate a owl:Class .
hpc:Jobslotreservation a owl:Class .
hpc:slotreserve a owl:ObjectProperty ;
    rdfs:domain hpc:Firstexecutionhostcandidate ;
    rdfs:range xsd:integer .
hpc:maxreservetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslotreservation ;
    rdfs:range xsd:duration .
hpc:mbdsleeptime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslotreservation ;
    rdfs:range xsd:duration .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Firstexecutionhostcandidate ;
    rdfs:subClassOf hpc:Jobslotreservation .
hpc:Job a owl:Class .
hpc:Memoryreservation a owl:Class .
hpc:memoryreservationforpendingjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Memoryreservation ;
    rdfs:range hpc:Job .
hpc:pendingjobmemoryreservation a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryreservationforpendingjobs ;
    rdfs:range xsd:duration .
hpc:Resourcecompetingjobs a owl:Class .
hpc:Memoryintensivejob a owl:Class ;
    rdfs:subClassOf hpc:Resourcecompetingjobs .
hpc:memoryreservationforpendingparalleljobs a owl:ObjectProperty ;
    rdfs:domain hpc:Memoryreservation ;
    rdfs:range hpc:Paralleljob .
hpc:pertaskmemoryreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Memoryreservationforpendingparalleljobs .
