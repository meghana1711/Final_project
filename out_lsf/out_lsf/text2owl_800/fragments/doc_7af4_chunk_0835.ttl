hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:Localresource a owl:Class .
hpc:hasType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hosttype .
hpc:hasModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hostmodel .
hpc:isDefault rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Localresource .
hpc:isShared rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Localresource .
hpc:Resourcemap a owl:Class .
hpc:ResourceMap_hasResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemap ;
    rdfs:range hpc:Localresource .
hpc:ResourceMap_hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemap ;
    rdfs:range hpc:Host .
