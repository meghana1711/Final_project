hpc:Longhostinfo a owl:Class ;
    rdfs:subClassOf hpc:Hostinfo .

hpc:Detailedmiginfo a owl:Class ;
    rdfs:subClassOf hpc:Hostinfo .

hpc:Customizedoutputformat a owl:Class .

# Object Properties
hpc:haslonghostinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lshostscommand ;
    rdfs:range hpc:Longhostinfo .

hpc:hasdetailedmiginfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lshostscommand ;
    rdfs:range hpc:Detailedmiginfo .

hpc:hascustomizedoutputformat a owl:ObjectProperty ;
    rdfs:domain hpc:Lshostscommand ;
    rdfs:range hpc:Customizedoutputformat .

# Datatype Properties
hpc:fieldwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:nonNegativeInteger .

hpc:justification a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string .

hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:string .

hpc:hasmaxtmpspace a owl:DatatypeProperty ;
    rdfs:domain hpc:Longhostinfo ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasnumlocaldisks a owl:DatatypeProperty ;
    rdfs:domain hpc:Longhostinfo ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasexecpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Longhostinfo ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasloadthresholds a owl:DatatypeProperty ;
    rdfs:domain hpc:Longhostinfo ;
    rdfs:range xsd:string .

hpc:hasrunwindows a owl:DatatypeProperty ;
    rdfs:domain hpc:Longhostinfo ;
    rdfs:range xsd:string .

hpc:hasmiginstanceinfo a owl:DatatypeProperty ;
    rdfs:domain hpc:Detailedmiginfo ;
    rdfs:range xsd:string .
