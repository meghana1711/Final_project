hpc:Multicluster a owl:Class .
hpc:Multiclusterjobforwardingmodel rdfs:subClassOf hpc:Multicluster .
hpc:Multiclusterresourceleasingmodel rdfs:subClassOf hpc:Multicluster .

hpc:Lsf a owl:Class .
hpc:lsfLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:lsfResPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:lsbMbdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:lsbSbdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .

hpc:defaultlsfLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer ;
    rdfs:range rdf:PlainLiteral "7869" .
hpc:defaultpreversion70LsfLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
