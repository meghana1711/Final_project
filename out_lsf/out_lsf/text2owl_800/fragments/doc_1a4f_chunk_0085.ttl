hpc:impliesFixedJobSlots
    a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:integer ;
    rdfs:comment "Indicates the implied total number of job slots." .

hpc:jobSizeList
    a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range xsd:integer ;
    rdfs:comment "A list of job sizes that the compound resource requirement matches." .

hpc:AlternativeResourceRequirement
    a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Alternative resource requirement with a fixed number of slots." .

hpc:fixedJobSlots
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Alternativeresourcerequirement ;
    rdfs:range xsd:integer ;
    rdfs:comment "The fixed number of slots requested by an alternative resource requirement." .

hpc:Queue
    a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "A queue in an LSF cluster." .

hpc:queueName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the queue." .

hpc:jobSizeList
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer-list ;
    rdfs:comment "The list of job sizes associated with the queue." .
