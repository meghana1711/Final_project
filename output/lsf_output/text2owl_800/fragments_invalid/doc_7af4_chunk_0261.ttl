hpc:AdvrsvUserLimit a owl:Class .
hpc:AdvrsvUserLimit rdfs:subClassOf xsd:nonNegativeInteger .

hpc:AllocationPlanner a owl:Class .
hpc:AllocationPlanner rdfs:subClassOf xsd:string .

hpc:window a owl:ObjectProperty .
hpc:Window rdfs:domain hpc:AllocationPlanner ;
                          rdfs:range xsd:nonNegativeInteger .

hpc:maxTime a owl:ObjectProperty .
hpc:MaxTime rdfs:domain hpc:AllocationPlanner ;
                          rdfs:range xsd:nonNegativeInteger .

hpc:allowEventType a owl:ObjectProperty .
hpc:AllowEventType rdfs:domain hpc:Job .
hpc:AllowEventType rdfs:range rdf:List .
hpc:AllowEventType rdfs:range/rdfs:member xsd:string .
