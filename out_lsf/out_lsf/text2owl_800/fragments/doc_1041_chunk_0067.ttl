hpc:Lsfproxydhost a owl:Class .
hpc:hashostname a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range xsd:string .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range xsd:string .
hpc:Hoststatusdisconnected a owl:Class ;
    rdfs:subClassOf hpc:Lsfproxydhost .
hpc:haspid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range xsd:positiveInteger .
hpc:tokenlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Tokenlimit .
hpc:tokensinusetotal a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:tokensinuseprivileged a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:submission a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Submission .
hpc:other a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Other .
hpc:blockcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Blockcommand .
hpc:unblockcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Unblockcommand .
hpc:blocklistcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproxydhost ;
    rdfs:range hpc:Blocklist .
hpc:Blockeduser a owl:Class .
hpc:Blockedhost a owl:Class .
hpc:Blockedentity a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:BlockedUser hpc:BlockedHost) ] .
