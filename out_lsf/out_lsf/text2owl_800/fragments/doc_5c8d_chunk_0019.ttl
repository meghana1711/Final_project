hpc:Job a owl:Class .
hpc:Datastagingdetails a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:arrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:submissionuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:allocatedhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:ssdstorageminsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:ssdstoragemaxsize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:userstageinscript a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Userscript .
hpc:userstageoutscript a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Userscript .
hpc:stageinjobexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Stageinjob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Stageoutjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Stageinjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Userscript a owl:Class .
