hpc:Linuxcgroupcpusets a owl:Class .
hpc:Portablehardwarelocality a owl:Class .
hpc:integratedwithlsf a owl:ObjectProperty .
hpc:supportsplatform a owl:ObjectProperty .
hpc:Affinityresourcerequirements a owl:Class .
hpc:Afinitysection a owl:Class .
hpc:resourcerequirementstring a owl:DatatypeProperty .
hpc:Afinitystring a owl:Class .
hpc:jobslotallocation a owl:ObjectProperty .
hpc:processorunitallocation a owl:ObjectProperty .
hpc:taskdistribution a owl:ObjectProperty .
hpc:lsbcgroupcoreautocreate a owl:ObjectProperty .
hpc:lsbjobincludepostproc a owl:ObjectProperty .
hpc:Postexecutionprocessing a owl:Class .
hpc:Interactivejob a owl:Class .
hpc:afinityunit a owl:DatatypeProperty .

hpc:Linuxcgroupcpusets rdfs:subClassOf owl:Class .
hpc:Portablehardwarelocality rdfs:subClassOf owl:Class .
hpc:Integratedwithlsf rdfs:domain hpc:Portablehardwarelocality ;
                          rdfs:range hpc:Lsf .
hpc:Supportsplatform rdfs:domain hpc:Portablehardwarelocality ;
                      rdfs:range xsd:string .
hpc:Affinityresourcerequirements a owl:Class ;
                                 rdfs:subClassOf owl:Class .
hpc:Afinitysection a owl:Class ;
                    rdfs:subClassOf hpc:Affinityresourcerequirements .
hpc:Resourcerequirementstring rdfs:domain hpc:Afinitysection ;
                               rdfs:range xsd:string .
hpc:Afinitystring rdfs:subClassOf owl:Class .
hpc:Jobslotallocation rdfs:domain hpc:Linuxcgroupcpusets ;
                      rdfs:range xsd:integer .
hpc:Processorunitallocation rdfs:domain hpc:Linuxcgroupcpusets ;
                            rdfs:range xsd:integer .
hpc:Taskdistribution rdfs:domain hpc:Linuxcgroupcpusets ;
                      rdfs:range xsd:integer .
hpc:Lsbcgroupcoreautocreate rdfs:domain hpc:Lsf ;
                           rdfs:range xsd:boolean .
hpc:Lsbjobincludepostproc rdfs:domain hpc:Lsf ;
                           rdfs:range xsd:boolean .
hpc:Postexecutionprocessing rdfs:subClassOf owl:Class .
hpc:Interactivejob a owl:Class ;
                     rdfs:subClassOf hpc:Job .
hpc:Afinityunit rdfs:domain hpc:Afinitystring ;
                   rdfs:range xsd:string .
