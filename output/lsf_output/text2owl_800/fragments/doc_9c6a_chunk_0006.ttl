hpc:setOriginalLSFEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfenvironment ;
    rdfs:range hpc:Command .

hpc:setLSFEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfenvironment ;
    rdfs:range hpc:Command .

hpc:startLSFDaemons rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfenvironment ;
    rdfs:range hpc:Commandlist .

hpc:stopLSFDaemons rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfenvironment ;
    rdfs:range hpc:Commandlist .

hpc:reactivateQueues rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfenvironment ;
    rdfs:range xsd:string .

hpc:Command a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:shell ;
                      owl:hasValue xsd:string ] .

hpc:Commandlist a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:command ;
                      owl:allValuesFrom hpc:Command ] .

hpc:shell a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Commandlist .
