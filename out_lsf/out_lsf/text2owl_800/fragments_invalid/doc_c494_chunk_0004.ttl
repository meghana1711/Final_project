@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Beginsschedscript a owl:Class.
hpc:Endsschedscript a owl:Class.
hpc:Lsfsessionschedulerjob a owl:Class.
hpc:bsuboption a owl:ObjectProperty;
                 rdfs:domain hpc:Job;
                 rdfs:range xsd:string.
hpc:jid a owl:DatatypeProperty;
               rdfs:domain hpc:Job;
               rdfs:range xsd:string.
hpc:lsbtasklist a owl:DatatypeProperty;
               rdfs:domain hpc:Script;
               rdfs:range xsd:string.
