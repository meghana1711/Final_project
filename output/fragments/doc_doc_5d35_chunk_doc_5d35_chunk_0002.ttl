hpc:HeterogeneousJob a owl:Class .
hpc:JobComponent a owl:Class .
hpc:CPUAllocation a owl:ObjectProperty ;
    rdfs:domain hpc:JobComponent ;
    rdfs:range rdf:List .
hpc:TaskDistribution a owl:Enum ;
    rdfs:member rdf:PlainLiteral "cyclic" ;
    rdfs:member rdf:PlainLiteral "sequential" .
hpc:Node a owl:Class .
hpc:Rank a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:BatchJobOption a owl:Class .
hpc:BatchScript a owl:ObjectProperty ;
    rdfs:domain hpc:JobComponent ;
    rdfs:range rdf:XMLLiteral .
hpc:HeterogeneousJob a rdfs:subClassOf owl:NamedIndividual .
hpc:JobComponent rdfs:subClassOf owl:NamedIndividual .
hpc:CPUAllocation rdf:type owl:FunctionalProperty .
hpc:TaskDistribution rdf:type owl:FunctionalProperty .
hpc:Node rdf:type owl:Class .
hpc:Rank rdf:type owl:DatatypeProperty .
hpc:BatchJobOption rdf:type owl:Class .
hpc:BatchScript rdf:type owl:ObjectProperty .

