hpc:ReservationDescMsg a owl:Class .

hpc:flags a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:string .

hpc:FLEX, hpc:NO_FLEX, hpc:DURATION_PLUS, hpc:DURATION_MINUS, hpc:NO_HOLD_JOBS_AFTER_END, hpc:NO_PURGE_COMP, hpc:MAGNETIC, hpc:SKIP, hpc:HOURLY, hpc:NO_HOURLY, hpc:USER_DELETE, hpc:NO_USER_DELETE, hpc:REOCCURRING a hpc:flags .

hpc:groups a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range rdf:Resource .

hpc:licenses a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range rdf:Resource .

hpc:max_start_delay a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:unsignedInt .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:string .

hpc:node_count a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:unsignedInt .

hpc:node_list a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:string .

hpc:partition a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:string .

hpc:purge_completed a owl:ObjectProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range hpc:PurgeCompleted .

hpc:PurgeCompleted a owl:Class .
hpc:PurgeCompleted.time a owl:DatatypeProperty ;
    rdfs:domain hpc:PurgeCompleted ;
    rdfs:range xsd:unsignedInt .

hpc:start_time a owl:DatatypeProperty ;
    rdfs:domain hpc:ReservationDescMsg ;
    rdfs:range xsd:unsignedInt .
```
