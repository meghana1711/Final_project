hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfcloudimage a owl:Class .
hpc:Installationconfiguration a owl:Class .
hpc:lsftop a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lsfadmins a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lsfclustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lsfmasterlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lsfentitlementfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lstardir a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:enableDynamicHosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationconfiguration ;
    rdfs:range xsd:string .
hpc:lsfDynamicHostWaitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:integer .
hpc:lsfHostAddrRange a owl:DatatypeProperty ;
    rdfs:domain hps:LSF_ClusterName ;
    rdfs:range xsd:string .
hpc:LsfTop rdfs:subClassOf owl:Property .
hpc:LsfAdmins rdfs:subClassOf owl:Property .
hpc:LsfClusterName rdfs:subClassOf owl:Property .
hpc:LsfMasterList rdfs:subClassOf owl:Property .
hpc:LsfEntitlementFile rdfs:subClassOf owl:Property .
hpc:LsfTardir rdfs:subClassOf owl:Property .
hpc:EnableDynamicHosts rdfs:subClassOf owl:Property .
hpc:LsfDynamicHostWaitTime rdfs:subClassOf owl:ObjectProperty .
hpc:LsfHostAddrRange rdfs:subClassOf owl:ObjectProperty .
