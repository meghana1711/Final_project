hpc:Host a owl:Class .
hpc:officialname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:alias a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:ipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Hostnamerange a owl:Class .
hpc:Networkaddress a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:condensednotation a owl:ObjectProperty .
hpc:internetdomainnameservice a owl:ObjectProperty .
hpc:sunnetworkinformationservice a owl:ObjectProperty .
hpc:yellowpages a owl:ObjectProperty .
hpc:etchostsfile a owl:ObjectProperty .
