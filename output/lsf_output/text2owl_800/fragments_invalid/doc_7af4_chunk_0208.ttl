hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimit .

hpc:Resourcelimit a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:resource a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcelimit ;
    rdfs:range xsd:string .

hpc:Sharedresource a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:integer a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .

hpc:queues a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:List ;
    rdfs:range rdf:ListMember hpc:Queue .

hpc:Resourcelimitsection a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:limit a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimitsection ;
    rdfs:range hpc:Resourcelimit .

hpc:horizontalformat a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimitsection ;
    rdfs:range xsd:boolean .

hpc:verticaltabularformat a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimitsection ;
    rdfs:range xsd:boolean .

hpc:emptyfield a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimit ;
    rdfs:range xsd:string .

hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcelimit .

hpc:Host a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:resourceperhost a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimit ;
    rdfs:range rdf:List ;
    rdfs:range rdf:ListMember ( hpc:Resourceperhostresource hpc:Resource ) .

hpc:Resourceperhostresource a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:ResourcePerHostResource rdfs:subPropertyOf hpc:Resource .
