hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:Socket a owl:Class .
hpc:Cpu a owl:Class .
hpc:Task a owl:Class .

hpc:Hasnode hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Node .

hpc:Hassocket hpc:node owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Socket .

hpc:Hascpu hpc:socket owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:Cpu .

hpc:Requires hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Literal .

hpc:Allocatedon hpc:cpu owl:ObjectProperty ;
    rdfs:domain hpc:Cpu ;
    rdfs:range hpc:Node .

hpc:Hastask hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:Hascpupertask hpc:task owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hastaskpernode hpc:node owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasallocationmethod hpc:node owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .

hpc:Defaultblock a owl:Class .
hpc:Cyclicdistribution a owl:Class .
hpc:Planedistribution a owl:Class .

hpc:Hasallocationmethoddefaultblock hpc:node owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Defaultblock .

hpc:Hasallocationmethodcyclic hpc:node owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Cyclicdistribution .

hpc:Hasallocationmethodplane hpc:node owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Planedistribution .
