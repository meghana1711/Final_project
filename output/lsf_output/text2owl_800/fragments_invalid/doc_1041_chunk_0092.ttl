hpc:Lsfcluster a owl:Class .
hpc:Lsfconffile a owl:Class .
hpc:egomasterlistparameter a owl:DatatypeProperty .
hpc:lsfmasterlistparameter a owl:DatatypeProperty .
hpc:hasConfigurationFile rdf:Property .
hpc:loadsEgoConf rdf:Property .
hpc:displaysEgoMasterList rdf:Property .
hpc:displaysLsfMasterList rdf:Property .

hpc:LsfCluster
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an LSF cluster." .

hpc:LsfConfFile
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the lsf.conf file." .

hpc:EgoMasterListParameter
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the EGO_MASTER_LIST parameter in the lsf.conf file." .

hpc:LsfMasterListParameter
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the LSF_MASTER_LIST parameter in the lsf.conf file." .

hpc:LsfCluster
    rdfs:subPropertyChain rdf:Property [
        rdf:type owl:ObjectProperty ;
        rdfs:domain hpc:Lsfcluster ;
        rdfs:range hpc:Lsfconffile
    ] ;
    rdfs:comment "The LSF cluster reads the lsf.conf file." .

hpc:LsfCluster
    rdfs:subPropertyChain rdf:Property [
        rdf:type owl:ObjectProperty ;
        rdfs:domain hpc:Lsfcluster ;
        rdfs:range hpc:Lsfconffile ;
        rdfs:subProperty rdf:Property [
            rdf:type owl:ObjectProperty ;
            rdfs:domain hpc:Lsfconffile ;
            rdfs:range hpc:Egoconffile
        ]
    ] ;
    rdfs:comment "The LSF cluster reads the ego.conf file if EGO is enabled." .

hpc:LsfCluster
    rdfs:subPropertyChain rdf:Property [
        rdf:type owl:ObjectProperty ;
        rdfs:domain hpc:Lsfcluster ;
        rdfs:range hpc:Lsfconffile ;
        rdfs:subProperty rdf:Property [
            rdf:type owl:ObjectProperty ;
            rdfs:domain hpc:Lsfconffile ;
            rdfs:range hpc:Egomasterlistparameter
        ] ;
        rdfs:subProperty rdf:Property [
            rdf:type owl:ObjectProperty ;
            rdfs:domain hpc:Lsfconffile ;
            rdfs:range hpc:Lsfmasterlistparameter
        ]
    ] ;
    rdfs:comment "The LSF cluster reads the EGO_MASTER_LIST or LSF_MASTER_LIST parameter from the lsf.conf file."
