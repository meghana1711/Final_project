hpc:Usermap a owl:Class .
hpc:Localuser a owl:Class .
hpc:Remoteuser a owl:Class .
hpc:direction a owl:ObjectProperty .
hpc:Localuser rdfs:subClassOf hpc:User .
hpc:Remoteuser rdfs:subClassOf hpc:User .
hpc:Direction rdfs:domain hpc:Usermap ;
                          rdfs:range rdf:List .
hpc:Localuser rdfs:range xsd:string .
hpc:Remoteuser rdfs:range xsd:string .
hpc:Local rdfs:domain hpc:Localuser ;
              rdfs:range xsd:string .
hpc:Remote rdfs:domain hpc:Remoteuser ;
              rdfs:range xsd:string .
