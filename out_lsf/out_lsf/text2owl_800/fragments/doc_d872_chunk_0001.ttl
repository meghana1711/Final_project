hpc:Cluster a owl:Class .
hpc:Host a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Batchjob a owl:Class .
hpc:Task a owl:Class .
hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:User a owl:Class .
hpc:Administrator a owl:Class .
hpc:Resource a owl:Class .
hpc:Joblifecycle a owl:Class .
hpc:ClusterJobQueue a owl:Class .

hpc:lshosts a owl:ObjectProperty .
hpc:bhosts a owl:ObjectProperty .
hpc:lsid a owl:ObjectProperty .
hpc:lsclusters a owl:ObjectProperty .

hpc:Cluster rdfs:subClassOf hpc:Resource .
hpc:Host rdfs:subClassOf hpc:Resource .
hpc:Lsfdaemon rdfs:subClassOf hpc:Resource .

hpc:Cluster rdfs:domain hpc:Cluster .
hpc:Host rdfs:domain hpc:Cluster .
hpc:Lsfdaemon rdfs:domain hpc:Cluster .

hpc:Lshosts rdfs:range xsd:string .
hpc:Bhosts rdfs:range xsd:string .
hpc:Lsid rdfs:range xsd:string .
hpc:Lsclusters rdfs:range xsd:string .

hpc:definesHosts a owl:ObjectProperty .
hpc:DefinesHosts rdfs:domain hpc:Cluster .
hpc:DefinesHosts rdfs:range hpc:Host .

hpc:Job rdfs:subClassOf hpc:Resource .
