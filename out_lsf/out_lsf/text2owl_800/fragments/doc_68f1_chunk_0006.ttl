hpc:Servicedomain a owl:Class .
hpc:Licenseserver a owl:Class .
hpc:LicenseServerHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Licenseserver ;
    rdfs:range hpc:Licenseserverhost .

hpc:Servicedomainlocality a owl:Class .
hpc:SingleClusterLocality rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomainlocality ;
    rdfs:range hpc:Singleclusterlocality .

hpc:Projectmode a owl:Class .
hpc:localto a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range xsd:string .

hpc:Clustermode a owl:Class .
hpc:Wanservicedomain a owl:Class ;
    rdfs:subClassOf hpc:Servicedomain .
hpc:Lanservicedomain a owl:Class ;
    rdfs:subClassOf hpc:Servicedomain .
hpc:ApplicationCheckoutBehavior rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Clustermode ;
    rdfs:range xsd:string .

hpc:Licensetoken a owl:Class .
hpc:LicenseFeature rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Licensetoken ;
    rdfs:range hpc:Licensefeature .

hpc:Jobsubmission a owl:Class .
hpc:-Lp a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .

hpc:Project a owl:Class .
hpc:definedfor a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Licensefeature .
