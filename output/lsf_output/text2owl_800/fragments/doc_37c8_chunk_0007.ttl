hpc:Lsfserver a owl:Class .
hpc:Dockerjob a owl:Class .
hpc:Nvidiadockerjob a owl:Class .
hpc:Gpuacceleration a owl:Class .
hpc:prepareslsf a owl:ObjectProperty .
hpc:configureslsf a owl:ObjectProperty .
hpc:submitsdockerjob a owl:ObjectProperty .
hpc:requiresgpu a owl:DatatypeProperty .
hpc:hasgpu a owl:ObjectProperty .
hpc:hasdockerprofile a owl:ObjectProperty .
hpc:hasnvidiadockerprofile a owl:ObjectProperty .
hpc:Lsfserver rdfs:subClassOf owl:Thing .
hpc:Dockerjob rdfs:subClassOf owl:Thing .
hpc:Nvidiadockerjob rdfs:subClassOf hpc:Dockerjob .
hpc:Gpuacceleration rdfs:subClassOf owl:Thing .
hpc:Prepareslsf rdfs:domain hpc:Lsfserver ;
                   rdfs:range hpc:Dockerjob .
hpc:Configureslsf rdfs:domain hpc:Lsfserver ;
                   rdfs:range hpc:Dockerjob .
hpc:Submitsdockerjob rdfs:domain hpc:Dockerjob ;
                     rdfs:range hpc:Lsfserver .
hpc:Requiresgpu rdfs:domain hpc:Dockerjob ;
                 rdfs:range xsd:boolean .
hpc:Hasgpu rdfs:domain hpc:Dockerjob ;
              rdfs:range hpc:Gpuacceleration .
hpc:Hasdockerprofile rdfs:domain hpc:Dockerjob ;
                     rdfs:range hpc:Lsfserver .
hpc:Hasnvidiadockerprofile rdfs:domain hpc:Nvidiadockerjob ;
                           rdfs:range hpc:Lsfserver .
hpc:LSF_PROCESS_TRACKING a xsd:boolean .
hpc:LSF_LINUX_CGROUP_ACCT a xsd:boolean .
hpc:LSB_RESOURCE_ENFORCE a xsd:string .
