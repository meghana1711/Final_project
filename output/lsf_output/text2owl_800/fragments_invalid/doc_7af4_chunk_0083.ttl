hpc:Jobsize a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A space-separated list of positive integers between 1 and 2147483646." ;
    rdfs:domain hpc:Job .

hpc:Jobsizelist a owl:Class ;
    rdfs:subClassOf owl:Collection ;
    rdfs:comment "A list of JobSize." ;
    rdfs:domain hpc:Job .

hpc:hasjobsize a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobsizelist ;
    rdfs:comment "The job size request for a job."

hpc:jobstarter a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:comment "An executable that can be used to start the job."

hpc:jobstarterwithcommandlineargs a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "Additional strings that can be specified with the job starter."

hpc:jobstarteroverrides a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobstarter ;
    rdfs:comment "An application-level job starter overrides a queue-level job starter."

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A queue in the HPC system."

hpc:queuehasjobsizelist a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobsizelist ;
    rdfs:comment "The job size requirements for a queue."

hpc:queueoverridestasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job size requirements override any TASKLIMIT parameters defined at the same level."

hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:unsignedInt ;
    rdfs:comment "The task limit for a queue."
