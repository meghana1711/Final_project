hpc:Ipaddress a owl:Class .
hpc:hasipv4format a owl:DatatypeProperty .
hpc:hasipv6format a owl:DatatypeProperty .
hpc:hasalias a owl:ObjectProperty .
hpc:Officialhostname a owl:Class .
hpc:isgateway a owl:ObjectProperty .
hpc:istac a owl:ObjectProperty .
hpc:Ipaddress rdfs:subClassOf owl:NamedIndividual .
hpc:Officialhostname rdfs:subClassOf owl:NamedIndividual .
hpc:Hasipv4format rdfs:domain hpc:Ipaddress ;
    rdfs:range xsd:string .
hpc:Hasipv6format rdfs:domain hpc:Ipaddress ;
    rdfs:range xsd:string .
hpc:Hasalias rdfs:domain hpc:Ipaddress ;
    rdfs:range xsd:string .
hpc:Officialhostname rdfs:range xsd:string .
hpc:Isgateway rdfs:domain hpc:Officialhostname .
hpc:Istac rdfs:domain hpc:Officialhostname .
