hpc:Jobwarningaction a owl:Class .
hpc:jobactionwarningtime a owl:DatatypeProperty .
hpc:Jobactionwarningtime rdfs:domain hpc:Jobwarningaction ;
                          rdfs:range xsd:time .
hpc:Jobcontrolaction a owl:Class .
hpc:jobwarningtime a owl:ObjectProperty .
hpc:Jobwarningtime rdfs:domain hpc:Jobwarningaction ;
                    rdfs:range xsd:time .
hpc:Urg a owl:Class .
hpc:bsub a owl:ObjectProperty .
hpc:Bsub rdfs:domain hpc:Jobwarningaction ;
        rdfs:range xsd:string .
hpc:bsub -wa rdfs:subPropertyOf hpc:bsub ;
       rdfs:domain hpc:Jobwarningaction ;
       rdfs:range xsd:string .
hpc:bsub -wt rdfs:subPropertyOf hpc:bsub ;
       rdfs:domain hpc:Jobwarningaction ;
       rdfs:range xsd:time .
hpc:X11forwarding a owl:Class .
hpc:bsub -XF a owl:ObjectProperty .
hpc:Bsub -XF rdfs:domain hpc:X11forwarding ;
       rdfs:range xsd:string .
hpc:bsub -IX rdfs:subPropertyOf hpc:bsub ;
       rdfs:domain hpc:X11forwarding .
hpc:bsub -K rdfs:subPropertyOf hpc:bsub ;
       rdfs:domain hpc:X11forwarding .
hpc:bsub -r rdfs:subPropertyOf hpc:bsub ;
       rdfs:domain hpc:X11forwarding .
