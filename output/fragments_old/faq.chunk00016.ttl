# Compute Node
hpc:ComputeNode a owl:Class .

# Slurm Execution
hpc:SlurmExecution a owl:Class .
hpc:reportsToSlurmctld rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:SlurmExecution ;
 rdfs:range rdf:Resource .

hpc:jobCanceled rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:SlurmExecution ;
 rdfs:range rdf:Boolean .

# Memory Exhaustion
hpc:memoryExhaustion rdf:type owl:Class .
hpc:associatedWithSlurmExecution rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:MemoryExhaustion ;
 rdfs:range hpc:SlurmExecution .

# Multi-Instance GPU
hpc:MultiInstanceGPU a owl:Class .
hpc:notWorkingWithSlurmAndPMIx rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:MultiInstanceGPU ;
 rdfs:range rdf:Literal .

hpc:gpusInUseByAnotherClient rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:MultiInstanceGPU ;
 rdfs:range rdf:Literal .

# HWLOC_COMPONENTS
hpc:HWLOC_COMPONENTS rdf:type owl:Class .
hpc:isSetForSlurmd rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:HWLOC_COMPONENTS ;
 rdfs:range rdf:Literal .

# Connection Error
hpc:ConnectionError rdf:type owl:Class .
hpc:resourcesTemporarilyUnavailable rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:ConnectionError ;
 rdfs:range rdf:Literal .

# Resource Limits
hpc:ResourceLimits rdf:type owl:Class .
hpc:lockedMemory rdf:type owl:DatatypeProperty ;
 rdfs:domain hpc:ResourceLimits ;
 rdfs:range xsd:decimal .

hpc:stackSize rdf:type owl:DatatypeProperty ;
 rdfs:domain hpc:ResourceLimits ;
 rdfs:range xsd:decimal .

# Long Processing Time
hpc:LongProcessingTime rdf:type owl:Class .
hpc:isIndicatedBySlurmctldLogFile rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:LongProcessingTime ;
 rdfs:range rdf:Literal .

hpc:operationDelay rdf:type owl:DatatypeProperty ;
 rdfs:domain hpc
