hpc:Appz201 a owl:Class ;
    rdfs:subClassOf hpc:Feature .

hpc:appz201Rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Appz201 ;
    rdfs:range xsd:string .

hpc:clusterDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:workloadDistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:Mylanserver a owl:Class ;
    rdfs:subClassOf hpc:Server .

hpc:Mywanserver a owl:Class ;
    rdfs:subClassOf hpc:Server .

hpc:Lsf a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:NonLsf a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:serviceDomainName a owl:DatatypeProperty ;
    rdfs:domain hpc:WorkloadDistribution .

hpc:lsfDistribution a owl:DatatypeProperty ;
    rdfs:domain hpc:WorkloadDistribution .

hpc:TokyoCl a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:NewyorkCl a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:Interactive a owl:Class ;
    rdfs:subClassOf hpc:Job .
