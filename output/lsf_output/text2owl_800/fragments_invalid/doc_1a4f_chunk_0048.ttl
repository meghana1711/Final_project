hpc:Resource a owl:Class .
hpc:resource_name an owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:shared_resource_name an owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:Externalstaticloadindex a owl:Class .
hpc:Externalstaticloadindex rdfs:subClassOf hpc:Resource .

hpc:staticExternalResource a owl:ObjectProperty ;
    rdfs:domain hpc:Externalstaticloadindex ;
    rdfs:range xsd:string .

hpc:Eslim a owl:Class ;
    rdfs:subClassOf hpc:Externalstaticloadindex .

hpc:enableEslim a owl:ObjectProperty ;
    rdfs:domain hpc:Lsinfo ;
    rdfs:range xsd:boolean .

hpc:lsfShared a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsinfo ;
    rdfs:range xsd:string .

hpc:eslimExecutableFile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsinfo ;
    rdfs:range xsd:string .

hpc:staticExternalResources a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsinfo ;
    rdfs:range xsd:string .
