hpc:Jobmodification a owl:Class .
hpc:Resourcereservation a owl:Class .
hpc:cpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:nonNegativeInteger .
hpc:memorylimit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:nonNegativeInteger .
hpc:swapspace a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Joboptionmodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .
hpc:Rerunnablejobmodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .
hpc:Errorfilemodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .
hpc:Outputfilemodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .
hpc:Runlimitmodification a owl:Class ;
    rdfs:subClassOf hpc:Jobmodification .
hpc:Lsbjobconfiguration a owl:Class .
hpc:lsbmodalljobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbjobconfiguration ;
    rdfs:range hpc:Boolean .
hpc:Jobowner a owl:Class .
hpc:lsbjobcpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbjobconfiguration ;
    rdfs:range hpc:Boolean .
hpc:lsbjobmemlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbjobconfiguration ;
    rdfs:range hpc:Boolean .
hpc:Jobrunning a owl:Class .
hpc:Modificationrestriction a owl:Class .
hpc:combinationrestriction a owl:ObjectProperty ;
    rdfs:domain hpc:Modificationrestriction ;
    rdfs:range hpc:Jobmodification .
