hpc:Hostname a owl:Class .
hpc:Type a owl:Class .
hpc:Model a owl:Class .
hpc:Cpuf a owl:Class .
hpc:Ncpus a owl:Class .
hpc:maxmem a owl:DatatypeProperty .
hpc:maxswp a owl:DatatypeProperty .

hpc:Maxmem rdfs:domain hpc:Hostname .
hpc:Maxswp rdfs:domain hpc:Hostname .
hpc:Maxmem rdfs:range xsd:decimal .
hpc:Maxswp rdfs:range xsd:decimal .

hpc:HostName rdfs:subClassOf rdf:Property .
hpc:Type rdfs:subClassOf rdf:Property .
hpc:Model rdfs:subClassOf rdf:Property .
hpc:Cpuf rdfs:subClassOf rdf:Property .
hpc:Ncpus rdfs:subClassOf rdf:Property .
hpc:maxmem rdfs:subPropertyOf hpc:Field .
hpc:maxswp rdfs:subPropertyOf hpc:Field .

hpc:field a owl:ObjectProperty .
hpc:width a owl:DatatypeProperty .
hpc:alias a owl:DatatypeProperty .
hpc:unit a owl:DatatypeProperty .

hpc:Field rdfs:domain hpc:Outputfield .
hpc:Width rdfs:range xsd:integer .
hpc:Alias rdfs:range xsd:string .
hpc:Unit rdfs:range xsd:string .

hpc:Outputfield a owl:Class .
