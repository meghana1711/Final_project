hpc:Configurationfileparameter a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:localmaxpreexecretryaction a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationfileparameter ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:Behavior .

hpc:Suspend a owl:Class ;
    rdf:type xsd:string .

hpc:Exit a owl:Class ;
    rdf:type xsd:string .

hpc:Localqueue a owl:Class ;
    rdfs:subClassOf hpc:Configurationfileparameter .

hpc:Jobbasedpreexecutionscripthostexclusion a owl:Class ;
    rdfs:subClassOf hpc:Configurationfileparameter .

hpc:preexecutionscriptfailureexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobbasedpreexecutionscripthostexclusion ;
    rdfs:range xsd:integer .

hpc:Localapplication a owl:Class ;
    rdfs:subClassOf hpc:Configurationfileparameter .
