hpc:Allowedipv6host a owl:Class .
hpc:Allowedipv4host a owl:Class .

hpc:hasdomain a owl:ObjectProperty .
hpc:hasipv6address a owl:DatatypeProperty .

hpc:Allowedipv6host rdfs:subClassOf hpc:Iphost .
hpc:Allowedipv4host rdfs:subClassOf hpc:Iphost .

hpc:Iphost rdfs:subClassOf owl:Class .

hpc:Allowedipv6host rdfs:domain hpc:Iphost .
hpc:Allowedipv4host rdfs:domain hpc:Iphost .

hpc:Hasdomain rdfs:range xsd:string .
hpc:Hasipv6address rdfs:range xsd:hexBinary .

hpc:AllowedIPv6Host_Range_1 a hpc:AllowedIPv6Host .
hpc:AllowedIPv6Host_Range_2 a hpc:AllowedIPv6Host .
hpc:AllowedIPv4Host_Range a hpc:AllowedIPv4Host .

hpc:Allowedipv6hostRange1 hpc:hasdomain "3ffe:fffe::" .
hpc:Allowedipv6hostRange1 hpc:hasipv6address "ffff:88bb:*" .

hpc:Allowedipv6hostRange2 hpc:hasdomain "3ffe-4fff:fffe::88bb:aa-ff" .

hpc:Allowedipv4hostRange hpc:hasdomain "12.23.45.*" .
