hpc:Signalname a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Name of a signal in LSF." .

hpc:Number a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A number used in LSF." .

hpc:suspendaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signalname ;
    rdfs:comment "The signal or number sent by the SUSPEND action in LSF." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A parallel job in LSF." .

hpc:Interactivejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "An interactive job in LSF." .

hpc:defaultsuspendaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signalname ;
    rdfs:comment "The default SUSPEND action in LSF." .

hpc:lsbskipfullhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specifies whether LSF removes full hosts from consideration at the beginning of each scheduling session." .

hpc:Y a xsd:boolean ;
    rdfs:comment "True value." .

hpc:N a xsd:boolean ;
    rdfs:comment "False value." .
