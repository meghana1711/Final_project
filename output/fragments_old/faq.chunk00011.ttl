# Cluster Nodes
hpc:ComputeNode a owl:Class .

# Slurm Daemons
hpc:Slurmctld a owl:Class .
hpc:Slurmd a owl:Class .

# Slurm States
hpc:RunningCluster a owl:Class .
hpc:DrainingNode a owl:Class .

# Procedures for adding nodes to Slurm
hpc:AddNodesToSlurmProcedure a owl:Class .
hpc:addNodesToSlurmProcedure_24_05 rdf:type hpc:AddNodesToSlurmProcedure ;
    rdfs:subClassOf hpc:AddNodesToSlurmProcedure ;
    hpc:steps (
        hpc:stopSlurmctld ,
        hpc:updateSlurmConf ,
        hpc:restartSlurmd ,
        hpc:restartSlurmctld
    ) .
hpc:addNodesToSlurmProcedure_24_11 rdf:type hpc:AddNodesToSlurmProcedure ;
    rdfs:subClassOf hpc:AddNodesToSlurmProcedure ;
    hpc:steps (
        hpc:updateSlurmConf ,
        hpc:reconfigureSlurm
    ) .

# Procedures for removing nodes from Slurm
hpc:RemoveNodesFromSlurmProcedure a owl:Class .
hpc:removeNodesFromSlurmProcedure_24_05 rdf:type hpc:RemoveNodesFromSlurmProcedure ;
    rdfs:subClassOf hpc:RemoveNodesFromSlurmProcedure ;
    hpc:steps (
        hpc:drainNode ,
        hpc:stopSlurmctld ,
        hpc:updateSlurmConf ,
        hpc:restartSlurmd ,
        hpc:restartSlurmctld
    ) .
hpc:removeNodesFromSlurmProcedure_24_11 rdf:type hpc:RemoveNodesFromSlurmProcedure ;
    rdfs:subClassOf hpc:RemoveNodesFromSlurmProcedure ;
    hpc:steps (
        hpc:drainNode ,
        hpc:updateSlurmConf ,
        hpc:reconfigureSlurm
    ) .

# Node States
hpc:DownNode a owl:Class .
hpc:NodeRebooted a owl:Class .

# Properties
hpc:hasIPAddress a owl:ObjectProperty .
hpc:hasState a owl:ObjectProperty .
hpc:hasDaemon a owl:ObjectProperty .
hpc:hasConfFileChecksum a owl:DatatypeProperty .
hpc:hasReason a owl:DatatypeProperty .
hpc:isRunningCluster a owl
