hpc:Exitcode a owl:Class .
hpc:requeueExitValues a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf hpc:Run ] .

hpc:Run a owl:Class .

hpc:exclusiverequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Exitcode ;
    rdfs:range hpc:Job .

hpc:signalkill a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signal .

hpc:Signal a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .

hpc:exclude a owl:ObjectProperty ;
    rdfs:domain hpc:Exitcode ;
    rdfs:range xsd:integer .

hpc:multicluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:windows a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
