hpc:ReservationModResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty rdf:type owl:ObjectProperty ;
                        owl:hasValue "reservations" ;
                        owl:allValuesFrom xsd:string ] .

hpc:ReservationModResponse a owl:Object .

hpc:ReservationResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] .

hpc:ReservationResponse a owl:Object ;
    rdfs:subPropertyOf rdf:type ;
    rdfs:domain rdf:type ;
    rdfs:range rdf:Class ;
    hpc:lastUpdate rdfs:Property ;
        rdfs:domain hpc:ReservationResponse ;
        rdfs:range xsd:string .

hpc:SlurmdbdConfigResponse a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] .

hpc:SlurmdbdConfigResponse a owl:Object ;
    rdfs:subPropertyOf rdf:type ;
    rdfs:domain rdf:type ;
    rdfs:range rdf:Class ;
    rdfs:property hpc:instances rdfs:Property ;
        rdfs:domain hpc:SlurmdbdConfigResponse ;
        rdfs:range xsd:boolean .

hpc:PartitionInfo a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] .

hpc:PartitionInfo a owl:Object ;
    rdfs:subPropertyOf rdf:type ;
    rdfs:domain rdf:type ;
    rdfs:range rdf:Class ;
    hpc:partition rdfs:Property ;
        rdfs:domain hpc:PartitionInfo ;
        rdfs:range xsd:string .
    hpc:selectType rdfs:Property ;
        rdfs:domain hpc:PartitionInfo ;
        rdfs:range xsd:string ;
        rdfs:range rdf:List ;
            rdfs:member "CPU" ;
            rdfs:member "SOCKET" ;
            rdfs:member "CORE" ;
            rdfs:member "BOARD" ;
            rdfs:member "MEMORY" ;
            rdfs:member "ONE_TASK_PER_CORE" ;
            rdfs:member "PACK_NODES" ;
            rdfs:member "CORE_DEFAULT_DIST_BLOCK" ;
            rdfs:member "LLN" ;
            rdfs:member "LINEAR" .

hpc
