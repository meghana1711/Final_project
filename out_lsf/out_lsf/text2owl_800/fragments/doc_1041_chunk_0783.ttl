hpc:QuitCommand
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the quit command." .

hpc:LSAdminSession
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an LSAdmin session." .

hpc:LSClusters
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents LSF clusters information." .

hpc:Synopsis
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsclusters ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The synopsis of the LSClusters command." .

hpc:Description
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsclusters ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The description of the LSClusters command." .

hpc:Options
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsclusters ;
    rdfs:range rdf:List ;
    rdfs:comment "The options available for the LSClusters command." .

hpc:LongFormat
    a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The long format option." .

hpc:WideFormat
    a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The wide format option." .

hpc:ClusterName
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsclusters ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "The cluster name for which information is requested." .

hpc:Cluster
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an LSF cluster." .
