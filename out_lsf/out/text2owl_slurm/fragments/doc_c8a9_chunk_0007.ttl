hpc:Component a owl:Class .
hpc:Exclusiveuserjob a owl:Class .
hpc:Exclusivemcsjob a owl:Class .

hpc:Mcsparameters rdfs:subClassOf owl:Class .
hpc:Preemptmode rdfs:domain hpc:Job ;
                      rdfs:range xsd:string ;
                      rdfs:subPropertyOf hpc:PreemptMode .
hpc:Job rdfs:subClassOf owl:Class .
hpc:Gracetime rdfs:domain hpc:Job ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Userwarningsignal rdfs:domain hpc:Job ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Licenses rdfs:subClassOf owl:Class .
hpc:Preemptparameters rdfs:domain hpc:Job ;
                       rdfs:range xsd:string .
hpc:Selecttype rdfs:domain hpc:Job ;
                  rdfs:range hpc:Resource .
hpc:Heterogeneousjob rdfs:subClassOf hpc:Job .
hpc:Component rdfs:subClassOf hpc:Job .
