hpc:Logfile a owl:Class .
hpc:Queryinfologfile a owl:Class .
hpc:Daemonlogfile a owl:Class .

# Object Properties
hpc:hastimestamp a owl:ObjectProperty .
hpc:hastriggerquerycommand a owl:ObjectProperty .
hpc:hassource a owl:ObjectProperty .
hpc:hashostname a owl:ObjectProperty .
hpc:hasdatasize a owl:ObjectProperty .
hpc:hasstatus a owl:ObjectProperty .

# Datatype Properties
hpc:timestamp a owl:DatatypeProperty .
hpc:triggerquerycommand a owl:DatatypeProperty .
hpc:source a owl:DatatypeProperty .
hpc:hostname a owl:DatatypeProperty .
hpc:datasize a owl:DatatypeProperty .
hpc:status a owl:DatatypeProperty .

# Domain and Range
hpc:Hastimestamp rdfs:domain hpc:Logfile ;
    rdfs:range xsd:dateTime .
hpc:Hastriggerquerycommand rdfs:domain hpc:Queryinfologfile ;
    rdfs:range xsd:string .
hpc:Hassource rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .
hpc:Hashostname rdfs:domain hpc:Queryinfologfile ;
    rdfs:range xsd:string .
hpc:Hasdatasize rdfs:domain hpc:Queryinfologfile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasstatus rdfs:domain hpc:Queryinfologfile ;
    rdfs:range xsd:hexBinary .
