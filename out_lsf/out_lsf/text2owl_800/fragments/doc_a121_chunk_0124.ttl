hpc:Clusteraffinityassociation a owl:Class .
hpc:showclusteraffinityassociation a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinityassociation ;
    rdfs:range rdf:Bag .
hpc:longformat a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:showClusterAffinityAssociation .
hpc:jsonformat a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:showClusterAffinityAssociation .
hpc:listformat a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:showClusterAffinityAssociation .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Showclusteraffinityassociation ;
    rdfs:range xsd:string .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Showclusteraffinityassociation ;
    rdfs:range xsd:string .
hpc:attrname a owl:DatatypeProperty ;
    rdfs:domain hpc:Showclusteraffinityassociation ;
    rdfs:range xsd:string .
hpc:resetclusteraffinityassociation a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinityassociation ;
    rdfs:range rdf:Bag .
hpc:Administrator a owl:Class .
hpc:User a owl:Class .
hpc:canresetbyadministrator a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinityassociation ;
    rdfs:range hpc:Administrator .
hpc:canresetbyuser a owl:ObjectProperty ;
    rdfs:domain hpc:Clusteraffinityassociation ;
    rdfs:range hpc:User .
