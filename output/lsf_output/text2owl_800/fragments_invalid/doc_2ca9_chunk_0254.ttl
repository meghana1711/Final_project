hpc:allocreuseduration a owl:ObjectProperty .
hpc:eligiblependingtimelimit a owl:DatatypeProperty .
hpc:pendingtimelimit a owl:DatatypeProperty .
hpc:forwardedjobslotsfactor a owl:DatatypeProperty .
hpc:fileinsertion a owl:ObjectProperty .
hpc:userforwarding a owl:ObjectProperty .
hpc:jobcontinuation a owl:ObjectProperty .
hpc:estimatedruntime a owl:DatatypeProperty .
hpc:applicationlevelestimatedruntime a owl:DatatypeProperty .
hpc:clusterlevelestimatedruntime a owl:DatatypeProperty .
hpc:joblevelestimatedruntime a owl:DatatypeProperty .
hpc:planbasedschedulingcandidate a owl:ObjectProperty .
hpc:applicationlevelplanbasedschedulingcandidate a owl:DatatypeProperty .
hpc:clusterlevelplanbasedschedulingcandidate a owl:DatatypeProperty .
hpc:joblevelplanbasedschedulingcandidate a owl:DatatypeProperty .
hpc:csmreq a owl:ObjectProperty .

hpc:Lsfversion a owl:Class .
hpc:Fixpack a owl:Class .

hpc:Lsfversion rdfs:subClassOf owl:Class .
hpc:Fixpack rdfs:subClassOf hpc:Lsfversion .

hpc:Allocreuseduration rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:decimal .
hpc:Eligiblependingtimelimit rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:decimal .
hpc:Pendingtimelimit rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:decimal .
hpc:Forwardedjobslotsfactor rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:decimal .
hpc:Fileinsertion rdfs:domain hpc:Lsfversion ;
    rdfs:range hpc:File .
hpc:Userforwarding rdfs:domain hpc:Lsfversion ;
    rdfs:range hpc:User .
hpc:Jobcontinuation rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:boolean .
hpc:Estimatedruntime rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:decimal .
hpc:Applicationlevelestimatedruntime rdfs:domain hpc:Estimatedruntime ;
    rdfs:range hpc:Application .
hpc:Clusterlevelestimatedruntime rdfs:domain hpc:Estimatedruntime ;
    rdfs:range hpc:Cluster .
hpc:Joblevelestimatedruntime rdfs:domain hpc:Estimatedruntime ;
    rdfs:range hpc:Job .
hpc:Planbasedschedulingcandidate rdfs:domain hpc:Lsfversion ;
    rdfs:range xsd:boolean .
hpc:Applicationlevelplanbasedschedulingcandidate rdfs:domain hpc:Planbasedschedulingcandidate ;
    rdfs:range hpc:Application .
hpc:Clusterlevelplanbasedschedulingcandidate rdfs:domain hpc:Planbasedschedulingcandidate
