hpc:Remotejobcontrolsession a owl:Class .
hpc:numsuccjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotejobcontrolsession ;
    rdfs:range xsd:integer .
hpc:succjobidarray a owl:ObjectProperty ;
    rdfs:domain hpc:Remotejobcontrolsession ;
    rdfs:range rdf:List .
hpc:numfailjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotejobcontrolsession ;
    rdfs:range xsd:integer .
hpc:failjobidarray a owl:ObjectProperty ;
    rdfs:domain hpc:Remotejobcontrolsession ;
    rdfs:range rdf:List .
hpc:failreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotejobcontrolsession ;
    rdfs:range xsd:integer .
hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:JobMove ;
    rdfs:range xsd:string .
hpc:JobSwitch2 a owl:Class ;
    rdfs:subClassOf hpc:Remotejobcontrolsession .
hpc:JobMove a owl:Class ;
    rdfs:subClassOf hpc:Remotejobcontrolsession .
