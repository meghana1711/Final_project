hpc:jobacceptinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the amount of time to wait after dispatching a job to a host before dispatching a second job to the same host." .

hpc:jobAcceptInterval a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:hasJobAcceptInterval ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobacceptinterval ;
    rdfs:comment "JOB_ACCEPT_INTERVAL set at the queue level (lsb.queues) overrides JOB_ACCEPT_INTERVAL set at the cluster level (lsb.params)." .

hpc:hasjobacceptinterval a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Jobacceptinterval ;
    rdfs:comment "The parameter JOB_ACCEPT_INTERVAL only applies when there are running jobs on a host." .

hpc:Jobacceptintervalvalue a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .

hpc:JobAcceptIntervalSetToZero a hpc:JobAcceptIntervalValue ;
    rdfs:comment "If set to 0 (zero), a host may accept more than one job in each dispatch turn." .

hpc:JobAcceptIntervalDefault a hpc:JobAcceptIntervalValue ;
    rdfs:comment "Not deﬁned." .
