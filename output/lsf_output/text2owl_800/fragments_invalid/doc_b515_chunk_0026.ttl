hpc:Enclosure a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Rack a owl:Class .
hpc:Hasenclosure hpc:Computeunit rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Enclosure .
hpc:Hasrack hpc:Computeunit rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Rack .
hpc:Requiresexclusiveuse hpc:Computeunit rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:Boolean .
hpc:Hasusablecuslots hpc:Computeunit rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:integer .
hpc:Hasconfigurationorder hpc:Enclosure rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:integer .
hpc:Hasconfigurationorder hpc:Rack rdfs:domain hpc:Rack ;
    rdfs:range xsd:integer .
hpc:Enclosure7 a hpc:Enclosure ;
    hpc:hasConfigurationOrder 1 .
hpc:Enclosure8 a hpc:Enclosure ;
    hpc:hasConfigurationOrder 2 .
hpc:rack4 a hpc:Rack ;
    hpc:hasConfigurationOrder 3 .
