@base <http://example.org/hpc/>

hpc:Jobstatus a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:string .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:string .
hpc:pend a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:integer .
hpc:psusp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:integer .
hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:integer .
hpc:ususp a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range xsd:integer .
