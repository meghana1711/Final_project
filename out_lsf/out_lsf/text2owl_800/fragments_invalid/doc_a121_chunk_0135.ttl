hpc:Jobbasedpreexecutioncommand a owl:Class .
hpc:Jobbasedpostexecutioncommand a owl:Class .
hpc:Environmentvariable a owl:Class .
hpc:Hostbasedprepostexecutionprocessing a owl:Class .
hpc:Unixenvironment a rdfs:subClassOf hpc:Environmentvariable .
hpc:Windowsenvironment a rdfs:subClassOf hpc:Environmentvariable .
hpc:Preexecutionprocessingflow a owl:Class .
hpc:hostbasedqueuelevelpreprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionprocessingflow ;
    rdfs:range hpc:Hostbasedqueuelevelpreprocessing .
hpc:haspreexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobbasedpreexecutioncommand .
hpc:haspostexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobbasedpostexecutioncommand .
hpc:runsindirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .
hpc:runsunder a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .
hpc:usesshell a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:boolean .
hpc:hasuserdefinedpostexecutioncommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixenvironment ;
    rdfs:range xsd:string .
hpc:hostPostExec a owl:ObjectProperty ;
    rdfs:domain hpc:Hostbasedprepostexecutionprocessing ;
    rdfs:range hpc:Hostbasedprepostexecutionprocessing .
hpc:path a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .
hpc:stdin stdout stderr a owl:DatatypeProperty ;
    rdfs:domain hpc:Preexecutioncommand ;
    rdfs:range xsd:string .
