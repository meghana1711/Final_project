hpc:Elasticsearchconfiguration a owl:Class .
hpc:useSsl a owl:DatatypeProperty ;
    rdfs:domain hpc:Elasticsearchconfiguration ;
    rdfs:range xsd:boolean .
hpc:verifyCerts a owl:DatatypeProperty ;
    rdfs:domain hpc:Elasticsearchconfiguration ;
    rdfs:range xsd:boolean .
hpc:maxRetries a owl:DatatypeProperty ;
    rdfs:domain hpc:Elasticsearchconfiguration ;
    rdfs:range xsd:nonNegativeInteger .
hpc:retryOnTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Elasticsearchconfiguration ;
    rdfs:range xsd:boolean .
hpc:index a owl:DatatypeProperty ;
    rdfs:domain hpc:Elasticsearchconfiguration ;
    rdfs:range xsd:string .
hpc:Providertype a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Elasticsearchprovider a owl:Class ;
    rdfs:subClassOf hpc:Providertype .
