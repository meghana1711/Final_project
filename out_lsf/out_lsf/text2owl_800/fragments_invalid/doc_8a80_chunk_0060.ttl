hpc:License a owl:Class .
hpc:Licensee a owl:Class .
hpc:nonshareddistribution a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensee ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Lp1 a hpc:Licensee .
hpc:Lp2 a hpc:Licensee .
hpc:Lp3 a hpc:Licensee .

hpc:numberoflicensesforlp1 a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numberoflicensesforlp3 a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

hpc:peakinuseperiod a owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range rdf:List .
hpc:Peakinuseperiodmember a owl:Class ;
    rdfs:subClassOf hpc:Peakinuseperiod .
hpc:PeakinuseperiodmemberCluster a owl:Class ;
    rdfs:subClassOf hpc:Peakinuseperiodmember ;
    rdfs:subPropertyOf hpc:PeakInusePeriod ;
    rdfs:domain hpc:Peakinuseperiod ;
    rdfs:range hpc:Cluster .
hpc:PeakinuseperiodmemberSeconds a owl:Class ;
    rdfs:subClassOf hpc:Peakinuseperiodmember ;
    rdfs:subPropertyOf hpc:PeakInusePeriod ;
    rdfs:domain hpc:Peakinuseperiod ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Interactive a owl:Class ;
    rdf:type hpc:Cluster .

hpc:Default a owl:Class ;
    rdf:type hpc:Cluster .

hpc:preemptorder a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler .
    rdfs:range hpc:Preemptordervalue .

hpc:preemptreserve a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler .
    rdfs:range xsd:boolean .

hpc:PreemptOrderValue a owl:Enum ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:PreemptOrder ;
    rdfs:range xsd:string ;
    owl:oneOf ( "BY_OWNERSHIP" ) .

hpc:PreemptReserveValue a owl:Enum ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:PreemptReserve ;
    rdfs:range xsd:boolean ;
    owl:oneOf ( "Y" "N" ) .
