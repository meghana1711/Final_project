hpc:Slurmuser a owl:Class .
hpc:Quickstartguide a owl:Class .
hpc:Commandsummary a owl:Class .
hpc:Optionsummary a owl:Class .

hpc:hasSlurmUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmuser ;
    rdfs:range hpc:Slurmuser .

hpc:usesQuickStartGuide rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmuser ;
    rdfs:range hpc:Quickstartguide .

hpc:usesCommandSummary rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Quickstartguide ;
    rdfs:range hpc:Commandsummary .

hpc:usesOptionSummary rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Quickstartguide ;
    rdfs:range hpc:Optionsummary .
