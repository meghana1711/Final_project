hpc:Openstackhost a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "Represents a resource in OpenStack that triggers a launch demand." .

hpc:launchdemand a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackhost ;
    rdfs:range rdf:Statement ;
    rdfs:comment "The action that is triggered when the openstackhost resource is defined." .

hpc:clustermembership a owl:ObjectProperty ;
    rdfs:domain hpc:Openstackhost ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The relationship between an instance and the LSF cluster it joins as a dynamic host." .

hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Openstackhost ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of the instances when they join the LSF cluster." .

hpc:okStatus a xsd:string ;
    rdfs:comment "A string value representing the 'ok' status." .
