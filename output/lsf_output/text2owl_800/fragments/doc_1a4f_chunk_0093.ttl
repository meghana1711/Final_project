hpc:ESwitch
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an eswitch program that applies to all job switch requests." .

hpc:LSB_ESWITCH_METHOD
    a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range rdf:List ;
    rdfs:comment "Modifies the job switch controls behavior by defining mandatory eswitch programs that apply to all job switch requests." .

hpc:ApplicationProfile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a set of common execution requirements for a specific application." .

hpc:JobSwitchArgument
    a owl:ObjectProperty ;
    rdfs:domain hpc:Eswitch ;
    rdfs:range xsd:string ;
    rdfs:comment "Provides flexibility for filtering and modifying job switch requests by letting you specify options for eswitch programs." .

hpc:ApplicationProfileAssociation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Applicationprofile ;
    rdfs:comment "Represents the association between a job and an application profile." .
