hpc:Userpreparation a owl:Class .
hpc:Instance a owl:Class .
hpc:lsfusermapping a owl:ObjectProperty .
hpc:Azurecyclecloud a owl:Class .
hpc:Administratoraccount a owl:Class .
hpc:cyclecloudrestfulapiaccess a owl:ObjectProperty .
hpc:azurecyclecloudversion a owl:DatatypeProperty .
hpc:Lsfclustertemplate a owl:Class .
hpc:importlsfclustertemplate a owl:ObjectProperty .
hpc:Virtualnetwork a owl:Class .
hpc:Sshkeypair a owl:Class .
hpc:AzureCycleCloudAdministratorAccount a owl:FunctionalClass .
hpc:Hasuserpreparation rdfs:domain hpc:Instance ;
    rdfs:range hpc:Userpreparation .
hpc:Haslsfusermapping rdfs:domain hpc:Instance ;
    rdfs:range hpc:Lsfusermapping .
hpc:Hasazurecyclecloud rdfs:domain hpc:Instance ;
    rdfs:range hpc:Azurecyclecloud .
hpc:Hasadministratoraccount rdfs:domain hpc:Azurecyclecloud ;
    rdfs:range hpc:Administratoraccount .
hpc:Hascyclecloudrestfulapiaccess rdfs:domain hpc:Administratoraccount ;
    rdfs:range xsd:boolean .
hpc:Hasazurecyclecloudversion rdfs:domain hpc:Azurecyclecloud ;
    rdfs:range xsd:string .
hpc:Requiresuserpreparation rdfs:subClassOf hpc:Instance .
hpc:Requireslsfusermapping rdfs:subClassOf hpc:Instance .
hpc:Requiresazurecyclecloud rdfs:subClassOf hpc:Instance .
hpc:Requiresadministratoraccount rdfs:subClassOf hpc:Azurecyclecloud .
hpc:Requirescyclecloudrestfulapiaccess rdfs:subClassOf hpc:Administratoraccount .
hpc:Requiresazurecyclecloudversion rdfs:subClassOf hpc:Azurecyclecloud .
hpc:Importslsfclustertemplate rdfs:subClassOf hpc:Azurecyclecloud .
hpc:Hasvirtualnetwork rdfs:domain hpc:Lsfclustertemplate ;
    rdfs:range hpc:Virtualnetwork .
hpc:Hassshkeypair rdfs:domain hpc:Lsfclustertemplate ;
    rdfs:range hpc:Sshkeypair .
