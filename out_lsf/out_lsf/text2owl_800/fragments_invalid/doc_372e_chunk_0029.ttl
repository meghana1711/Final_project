hpc:Licenseserver a owl:Class .
hpc:Licensecollector a owl:Class .
hpc:Host a owl:Class .
hpc:Subnet a owl:Class .
hpc:License a owl:Class .
hpc:Licensefeature a owl:Class .
hpc:name a owl:DatatypeProperty .
hpc:lmLicenseName a owl:ObjectProperty .

hpc:Licenseserver rdfs:subClassOf hpc:Host .
hpc:Licensecollector rdfs:subClassOf hpc:Host .
hpc:Subnet rdfs:subClassOf hpc:Host .

hpc:Licenseserver rdfs:domain rdf:nil .
hpc:Licensecollector rdfs:domain rdf:nil .
hpc:Subnet rdfs:domain rdf:nil .

hpc:Name rdfs:domain hpc:Licenseserver ;
    rdfs:range xsd:string .

hpc:LmLicenseName rdfs:domain hpc:Licenseserver ;
    rdfs:range xsd:string .

hpc:LIC_SERVERS a owl:NamedIndividual ;
    hpc:Name "1700@hostA" ;
    hpc:Name "1700@hostB" ;
    hpc:Name "1700@hostC" ;
    hpc:Name "1700@hostD" ;
    hpc:Name "1700@hostE" .

hpc:REMOTE_LMSTAT_SERVERS a owl:NamedIndividual ;
    hpc:Name "hostB" ;
    hpc:Name "hostC" ;
    hpc:part hostD ;
    hpc:part hostE .
