hpc:Backfillslot a owl:Class ;
    rdfs:subClassOf hpc:Slot ;
    rdfs:comment "A slot with a backfill window." .

hpc:estimatedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillslot ;
    rdfs:range xsd:dateTime .

hpc:backfillwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Backfillslot ;
    rdfs:range hpc:Backfillwindow ;
    rdfs:comment "The available run times for a backfill slot." .

hpc:backfillwindowlength a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillwindow ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The length of the backfill window." .

hpc:Unlimited a xsd:string ;
    rdfs:comment "Indicates an unlimited backfill window length." .

hpc:NoBackfillWindowTime a xsd:string ;
    rdfs:comment "Indicates no backfill window exists at this time." .

hpc:options a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Option ;
    rdfs:comment "Additional options for a command." .

hpc:longformat a owl:ObjectProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range host:LongFormat ;
    rdfs:comment "Displays backfill windows in a long multi-line format." .

hpc:hostnames a owl:ObjectProperty ;
    rdfs:domain hpc:Longformat ;
    rdfs:range hpc:Hostnamelist ;
    rdfs:comment "Displays host names in a backfill window." .

hpc:slotcount a owl:ObjectProperty ;
    rdfs:domain hpc:Longformat ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Displays the number of slots on each host available for backfill." .

hpc:requiredslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies required slots (processors) for backfill." .

hpc:backfillwindowwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfillwindow ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The width of a backfill window." .
