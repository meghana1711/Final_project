hpc:Featuregroup a owl:Class .
hpc:Ignoredfeaturegroup rdfs:subClassOf hpc:Featuregroup .
hpc:Sortedbyalpha rdfs:subClassOf hpc:Featuregroup .
hpc:Sortedbytotal rdfs:subClassOf hpc:Featuregroup .

hpc:totaltokens a owl:ObjectProperty .
hpc:Alpha rdfs:domain hpc:Featuregroup ;
    rdfs:range hpc:Featuregroup .
hpc:Total rdfs:domain hpc:Featuregroup ;
    rdfs:range xsd:decimal .

hpc:Licenses a owl:Class .
hpc:allocatedlicenses a owl:ObjectProperty ;
    rdfs:domain hpc:Licenses ;
    rdfs:range hpc:Featuregroup .
hpc:borrowedlicenses a owl:ObjectProperty ;
    rdfs:domain hpc:Licenses ;
    rdfs:range hpc:Featuregroup .

hpc:Configurationparameter a owl:Class .
hpc:relatedtolsflicensescheduler a owl:ObjectProperty ;
    rdfs:domain hpc:Configurationparameter ;
    rdfs:range hpc:Configurationparameter .

hpc:tokenname a owl:DatatypeProperty .
hpc:Specifiedtokenname rdfs:domain hpc:Configurationparameter ;
    rdfs:range xsd:string .

hpc:Projectmodeonly a owl:Class .
hpc:hierarchicalconfigurationinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmodeonly ;
    rdfs:range hpc:Configurationparameter .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:decimal .

hpc:Strictoutput a owl:Class .
hpc:printsusage a owl:ObjectProperty ;
    rdfs:domain hpc:Strictoutput ;
    rdfs:range hpc:Strictoutput .
hpc:printsversion a owl:ObjectProperty ;
    rdfs:domain hpc:Strictoutput ;
    rdfs:range hpc:Strictoutput .

hpc:Projectgroup a owl:Class .
