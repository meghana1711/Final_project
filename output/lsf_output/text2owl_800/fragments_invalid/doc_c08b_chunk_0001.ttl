@base <http://example.org/hpc/>

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workflowelement ;
    rdfs:comment "Represents a job in an HPC system." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier of a job." .

hpc:jobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The group to which the job belongs." .

hpc:index a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The index of the job within a job group." .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the project associated with the job." .

hpc:username a owl:DatatypeProperty ;
