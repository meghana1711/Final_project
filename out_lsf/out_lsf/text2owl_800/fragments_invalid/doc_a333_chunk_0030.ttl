hpc:LsbSubRlimi a owl:Class .
hpc:tStack-S a owl:DatatypeProperty .
hpc:TStack-S rdfs:domain hpc:LsbSubRlimi ;
                 rdfs:range xsd:integer .
hpc:tThread-T a owl:DatatypeProperty .
hpc:TThread-T rdfs:domain hpc:LsbSubRlimi ;
                 rdfs:range xsd:integer .

hpc:LsbSubTerm a owl:Class .
hpc:time-t a owl:DatatypeProperty .
hpc:Time-t rdfs:domain hpc:LsbSubTerm ;
                 rdfs:range xsd:integer .

hpc:event-wt a owl:DatatypeProperty .
hpc:Event-wt rdfs:domain hpc:LsbSubTime .
hpc:Event-wt rdfs:range xsd:integer .

hpc:LsbSubUser a owl:Class .
hpc:group-G a owl:DatatypeProperty .
hpc:Group-G rdfs:domain hpc:LsbSubUser .
hpc:Group-G rdfs:range xsd:string .

hpc:LsbSub2Job a owl:Class .
hpc:group-g a owl:DatatypeProperty .
hpc:Group-g rdfs:domain hpc:LsbSub2Job .
hpc:Group-g rdfs:range xsd:string .

hpc:LsbSub2Lice a owl:Class .
hpc:nse a owl:DatatypeProperty .
hpc:Nse rdfs:domain hpc:LsbSub2Lice .
hpc:Nse rdfs:range xsd:string .

hpc:LsbSub2In a owl:Class .
hpc:fileSpool a owl:ObjectProperty .
hpc:FileSpool rdfs:domain hpc:LsbSub2In .
hpc:FileSpool rdfs:range hpc:Spooledinputfile .
hpc:FileSpool rdfs:range xsd:string ;
                 rdfs:subPropertyOf hpc:_FILE_SPOOL ;
                 rdfs:comment "(read-only)" .

hpc:LSB_SUB2_JOB
hpc:cmdSpool a owl:ObjectProperty .
hpc:CmdSpool rdfs:domain hpc:LsbSub2Job .
hpc:CmdSpool rdfs:range hpc:Spooledjobcommand .
hpc:CmdSpool rdfs:range xsd:string ;
                 rdfs:subPropertyOf hpc:_CMD_SPOOL ;
                 rdfs:comment "(read-only)" .

hpc:LSB_SUB2_JOB
hpc:priority-sp a owl:DatatypeProperty .
hpc:Priority-sp rdfs:domain hpc:LsbSub2Job .
hpc:_PRIORITY-sp rd
