hpc:Queryparameter a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "CSV name list default: null" ;
    rdfs:label "QueryParameter" .

hpc:onlyDefaults a owl:ObjectProperty ;
    rdfs:domain hpc:Queryparameter ;
    rdfs:range xsd:boolean ;
    rdfs:comment "optional" ;
    rdfs:label "only_defaults" .

hpc:queryparameterUsageend a owl:DatatypeProperty ;
    rdfs:domain hpc:Queryparameter ;
    rdfs:range xsd:xsd:int64 ;
    rdfs:comment "UNIX timestamp" ;
    rdfs:label "Usage end" .

hpc:queryparameterUsagestart a owl:DatatypeProperty ;
    rdfs:domain hpc:Queryparameter ;
    rdfs:range xsd:xsd:int64 ;
    rdfs:comment "UNIX timestamp" ;
    rdfs:label "Usage start" .

hpc:queryparameterUser a owl:ObjectProperty ;
    rdfs:domain hpc:Queryparameter ;
    rdfs:range
