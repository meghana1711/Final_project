hpc:Enforcedapplicationprofile a owl:Class .
hpc:enforceslimitson a owl:ObjectProperty ;
    rdfs:domain hpc:Enforcedapplicationprofile ;
    rdfs:range hpc:Enforcedapplicationprofile .

# LSF Version 10.1 Fix Pack 10
hpc:Idlebuffer a owl:Class ;
    rdfs:subClassOf xsd:string .

# HostExport section deprecation
hpc:Hostexportdeprecated a owl:Class ;
    rdfs:subClassOf xsd:boolean .

# SharedResourceExport section deprecation
hpc:Sharedresourceexportdeprecated a owl:Class ;
    rdfs:subClassOf xsd:boolean .

# UserGroup section - global fair share policy
hpc:Globalfairsharepolicy a owl:Class .
hpc:participatesin a owl:ObjectProperty ;
    rdfs:domain hpc:Globalfairsharepolicy ;
    rdfs:range hpc:Usergroup .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Group .

# User section - pending jobs and slots
hpc:pendingjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:User .
hpc:pendingslots a owl:DatatypeProperty ;
    rdfs:domain hpc:User .

# LSF Version 10.1 Fix Pack 5 and Fix Pack 6
hpc:Fileinsertdirective a owl:Class ;
    rdfs:subClassOf xsd:string .

# PRIORITY in the User and UserGroup sections
hpc:priority a owl:DatatypeProperty .
