hpc:Lsfadministrator a owl:Class .
hpc:Lsfparamsfile a owl:Class .
hpc:newjobrefresh a owl:ObjectProperty .
hpc:mbdrefreshtime a owl:DatatypeProperty .
hpc:managementhostcpus a owl:ObjectProperty .

hpc:Lsfadministrator rdfs:subClassOf rdf:Resource .
hpc:Lsfparamsfile rdfs:subClassOf rdf:Resource .
hpc:Newjobrefresh rdfs:domain hpc:Lsfadministrator ;
                    rdfs:range xsd:boolean .
hpc:Mbdrefreshtime rdfs:domain hpc:Lsfparamsfile ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:Managementhostcpus rdfs:domain hpc:Lsfadministrator ;
                      rdfs:range xsd:string .
