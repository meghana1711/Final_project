hpc:Project a owl:Class .
hpc:Projectname rdfs:domain hpc:Project ;
                 rdfs:range xsd:string .

hpc:Queue a owl:Class .
hpc:Queuename rdfs:domain hpc:Queue ;
              rdfs:range xsd:string .

hpc:User a owl:Class .
hpc:Username rdfs:domain hpc:User ;
             rdfs:range xsd:string .

hpc:Usergroup rdfs:subClassOf hpc:User .

hpc:Limitsection rdfs:subClassOf owl:Class .

hpc:PerProject rdfs:domain hpc:Limitsection ;
                rdfs:range rdf:List .
hpc:PER_PROJECT rdfs:subPropertyOf hpc:hasLimit .

hpc:PerQueue rdfs:domain hpc:Limitsection ;
              rdfs:range rdf:List .
hpc:PER_QUEUE rdfs:subPropertyOf hpc:hasLimit .

hpc:PerUser rdfs:domain hpc:Limitsection ;
             rdfs:range rdf:List .
hpc:PER_USER rdfs:subPropertyOf hpc:hasLimit .
