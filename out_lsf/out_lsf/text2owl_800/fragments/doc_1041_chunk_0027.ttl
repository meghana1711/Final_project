hpc:Overrun a owl:Class ;
    rdfs:subClassOf hpc:Jobexception .

hpc:Underrun a owl:Class ;
    rdfs:subClassOf hpc:Jobexception .

hpc:RuntimeEstExceeded a owl:Class ;
    rdfs:subClassOf hpc:Jobexception .

hpc:synchronousexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:jobDescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:dispatchedtasksonhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:allocatedslotsonhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:effectiveresReq a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
