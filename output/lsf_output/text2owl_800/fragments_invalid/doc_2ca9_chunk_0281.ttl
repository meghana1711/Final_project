hpc:LsfAddonHosts a owl:Class .
hpc:LsfAddonHosts rdfs:subClassOf hpc:Resourceparameter .
hpc:LSF_ADDON_HOSTS rdfs:comment "Required if running LSF Application Center, LSF Explorer, LSF Process Manager, or LSF RTM." .

hpc:defaultValue_LSF_ADDON_HOSTS a xsd:string .
hpc:DefaultvalueLsfAddonHosts rdfs:range xsd:string .
hpc:defaultValue_LSF_ADDON_HOSTS rdf:value "Y" .

hpc:isrequiredLsfAddonHosts a owl:ObjectProperty .
hpc:IsrequiredLsfAddonHosts rdfs:domain hpc:LsfAddonHosts .
hpc:IsrequiredLsfAddonHosts rdfs:range hpc:Boolean .

