hpc:HostName a owl:Class .
hpc:Status a owl:Class .

hpc:ok a owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:unavail a owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .

hpc:fodid a owl:ObjectProperty ;
    rdfs:domain hpc:HostName ;
    rdfs:range rdf:Resource .

hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodid .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodid .

hpc:options a owl:DatatypeProperty ;
    rdfs:domain hpc:Fodid .

hpc:taskman a owl:ObjectProperty ;
    rdfs:domain hpc:HostName ;
    rdfs:range rdf:Resource .

hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Taskman .
