hpc:LsfLsloadFormat a owl:Class .
hpc:hasmaxwidth a owl:ObjectProperty .
hpc:hasalignment a owl:ObjectProperty .
hpc:hasautomaticscaling a owl:ObjectProperty .
hpc:hasdelimiter a owl:DatatypeProperty .
hpc:Field a owl:Class .
hpc:Host a owl:Class .

hpc:LsfLsloadFormat rdfs:subClassOf hpc:Fielddefinition .
hpc:Field rdfs:subClassOf hpc:Namedentity .
hpc:Host rdfs:subClassOf hpc:Namedentity .

hpc:Hasmaxwidth rdfs:domain hpc:LsfLsloadFormat ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Hasalignment rdfs:domain hpc:LsfLsloadFormat ;
                 rdfs:range xsd:string .
hpc:Hasautomaticscaling rdfs:domain hpc:Field ;
                      rdfs:range xsd:boolean .
hpc:Hasdelimiter rdfs:domain hpc:LsfLsloadFormat ;
                  rdfs:range xsd:string .

hpc:status a hpc:Field ;
           hpc:hasMaxWidth "15" ;
           hpc:hasAlignment "left" .
hpc:r15s a hpc:Field ;
          hpc:hasMaxWidth "6" ;
          hpc:hasAlignment "right" .
hpc:r1m a hpc:Field ;
         hpc:hasMaxWidth "7" ;
         hpc:hasAlignment "left" .
hpc:r15m a hpc:Field ;
          hpc:hasMaxWidth "8" ;
          hpc:hasAlignment "right" .
hpc:tmp a hpc:Field ;
         hpc:hasMaxWidth "unlimited" ;
         hpc:hasAlignment "left" .
hpc:swp a hpc:Field ;
         hpc:hasMaxWidth "10" ;
         hpc:hasAlignment "left" .
hpc:mem a hpc:Field ;
         hpc:hasMaxWidth "9" ;
         hpc:hasAlignment "left" .
