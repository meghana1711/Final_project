hpc:Job a owl:Class .
hpc:hasSourcePath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hasDestinationPath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

# Data tag classes and properties
hpc:Datatag a owl:Class .
hpc:hasName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range xsd:string .
hpc:hasFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range rdf:Resource .

# LSF-specific classes and properties
hpc:Lsfjob a owl:Class .
    rdfs:subClassOf hpc:Job .
hpc:Lsfdatatag a owl:Class .
    rdfs:subClassOf hpc:Datatag .
hpc:lsfjob:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
hpc:lsfdatatag:bstageIn a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatag ;
    rdfs:range rdf:Bag .
hpc:lsfdatatag:bstageOut a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatag ;
    rdfs:range rdf:Bag .
hpc:lsfdatatag:bdataTagsList a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatatag ;
    rdfs:range rdf:Bag .
