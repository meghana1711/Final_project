hpc:Elimexecutablefile a owl:Class .
hpc:Cluster a owl:Class .
hpc:Lsfserverdir a owl:Class .
hpc:Jsdlfile a owl:Class .
hpc:Lsfjob a owl:Class .

# Object Properties
hpc:haselimexecutablefile a owl:ObjectProperty .
hpc:isstoredin a owl:ObjectProperty .
hpc:reconfigures a owl:ObjectProperty .
hpc:submitsjobto a owl:ObjectProperty .
hpc:usesjsdlfile a owl:ObjectProperty .

# Datatype Properties
hpc:Defaultlocation rdfs:domain hpc:Elimexecutablefile ;
                     rdfs:range xsd:string .
hpc:Requiresreconfiguration rdfs:domain hpc:Cluster ;
                              rdfs:range xsd:boolean .
hpc:Usesjsdlspecification rdfs:domain hpc:Jsdlfile ;
                             rdfs:range xsd:string .

# Subclass relations
hpc:Lsfjob a owl:Class .
           rdfs:subClassOf hpc:Job .

# Domain and Range restrictions
hpc:Haselimexecutablefile rdfs:domain hpc:Cluster ;
                            rdfs:range hpc:Elimexecutablefile .
hpc:Isstoredin rdfs:domain hpc:Elimexecutablefile ;
                 rdfs:range xsd:string .
hpc:Reconfigures rdfs:domain hpc:Cluster ;
                  rdfs:range xsd:boolean .
hpc:Submitsjobto rdfs:domain hpc:Lsfjob ;
                  rdfs:range hpc:Lsfserverdir .
hpc:Usesjsdlfile rdfs:domain hpc:Lsfjob ;
                  rdfs:range hpc:Jsdlfile .
