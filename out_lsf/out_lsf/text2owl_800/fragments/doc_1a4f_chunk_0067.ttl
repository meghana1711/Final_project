hpc:Lsf a owl:Class .
hpc:MBatchdDaemon rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsf .

hpc:LSFDynamicHostTimeout rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:duration .

hpc:LSFClusterName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Lsfclusternametype .

hpc:Lsfclusternametype a owl:Class .

hpc:LSFHostAddrRange rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:LSFHostAddrRangeRule rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfhostaddrrange ;
    rdfs:range hpc:Ipaddressrange .

hpc:Ipaddressrange a owl:Class .

hpc:LSFEnableSupportIPV6 rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:LSFHost rdf:type owl:Class .
hpc:Lsfhost rdfs:subClassOf hpc:Ipaddress .

hpc:LSF_HOST_ADDR_RANGE rdf:type hpc:LSFHostAddrRange .
hpc:LsfHostAddrRange hpc:lsfhostaddrrangerule "enables security by defining a list of hosts that can join the cluster." .
