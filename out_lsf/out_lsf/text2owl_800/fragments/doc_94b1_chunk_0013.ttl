hpc:Hoststate a owl:Class .
hpc:restarting a owl:ObjectProperty ;
    rdfs:domain hpc:Hoststate ;
    rdfs:range hpc:Hoststate .
hpc:resuming a owl:ObjectProperty ;
    rdfs:domain hpc:Hoststate ;
    rdfs:range hpc:Hoststate .
hpc:suspending a owl:ObjectProperty ;
    rdfs:domain hpc:Hoststate ;
    rdfs:range hpc:Hoststate .
hpc:ClosedPower a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:OkPower a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:Transitional a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
hpc:Unavail a owl:Class ;
    rdfs:subClassOf hpc:Hoststate .
