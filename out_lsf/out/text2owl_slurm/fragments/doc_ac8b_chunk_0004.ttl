hpc:priorityfactor a owl:DatatypeProperty .
hpc:Associationfactor rdfs:domain hpc:Priorityfactor ;
                        rdfs:range xsd:decimal .
hpc:Jobsizefactor rdfs:domain hpc:Job ;
                   rdfs:subClassOf hpc:Priorityfactor ;
                   rdfs:subPropertyOf hpc:AssociationFactor .
hpc:JobSizeFactor_FavorSmall rdf:datatype xsd:boolean .
hpc:JobSizeFactor_SMALL_RELATIVE_TO_TIME rdf:datatype xsd:boolean .
hpc:Nicefactor rdfs:domain hpc:Job ;
                 rdfs:range xsd:integer .
hpc:NicefactorRange rdfs:range xsd:int .
hpc:Partition rdfs:subClassOf hpc:Resource .
hpc:Partitionfactor rdfs:domain hpc:Partition ;
                    rdfs:range xsd:decimal .
hpc:Qos rdfs:subClassOf hpc:Resource .
hpc:Qosfactor rdfs:domain hpc:Qos ;
                 rdfs:range xsd:decimal .
