hpc:Resource a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#ValidResource> .

hpc:Hosttype a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#ValidResource> .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain ?Resource ;
    rdfs:range xsd:string ;
    owl:incompatibleWith hpc:BuiltInName ;
    owl:incompatibleWith hpc:PreviouslyDefinedName .

hpc:BuiltInName a owl:NamedIndividual ;
    rdf:type owl:Restriction ;
    rdfs:subPropertyOf hpc:Name ;
    owl:onClass <http://example.org/hpc#BuiltInResource> ;
    owl:hasValue "*" .

hpc:PreviouslyDefinedName a owl:NamedIndividual ;
    rdf:type owl:Restriction ;
    rdfs:subPropertyOf hpc:Name ;
    owl:onClass <http://example.org/hpc#Resource> .

hpc:indexname a owl:DatatypeProperty ;
    rdfs:domain ?Resource ;
    rdfs:range xsd:string ;
    owl:uniqueProperty .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain ?Cluster ;
    rdfs:range xsd:string ;
    owl:functionalProperty ;
    owl:inverseOf hpc:ClusterMember .

hpc:clustermember a owl:ObjectProperty ;
    rdfs:domain ?Cluster ;
    rdfs:range ?Resource ;
    owl:inverseOf hpc:ClusterName .

hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain ?HostModel ;
    rdfs:range xsd:decimal ;
    owl:minCardinality 1 .

hpc:maxhostmodels a owl:DatatypeProperty ;
    rdfs:domain ?File ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:hasMaxCardinality 127 .

hpc:resourcenamelength a owl:DatatypeProperty ;
    rdfs:domain ?Resource ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:hasMaxCardinality 39 .

hpc:ReservedResourceName a owl:NamedIndividual ;
    rdf:type owl:Restriction ;
    rdfs:subPropertyOf hpc:ResourceName ;
    owl:onClass <http://example.org/hpc#ReservedResource> .

hpc:IllegalCharacterInResourceName a owl:NamedIndividual ;
    rdf:type owl:Restriction ;
    rdfs:subPropertyOf hpc:ResourceName ;
    owl:onClass <http://example.org/hpc#Resource> ;
    owl:hasValue ":" .
