hpc:Queue a owl:Class .
hpc:User a owl:Class .
hpc:Hostpartition a owl:Class .

hpc:haspriority a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:queuelevelfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:User .

hpc:queuebasedfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:Highpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:Lowpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:preferencetolowerpriorityqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Highpriorityqueue ;
    rdfs:range hpc:Queue .

hpc:belongstomultipleusergroups a owl:ObjectProperty ;
    rdfs:domain hpc:User .

hpc:dynamicsharepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup .

hpc:Resizeablejob a owl:Class .

hpc:Fairsharequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:hostpartitionfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Hostpartition ;
    rdfs:range hpc:User .

hpc:Pendingresizeallocationrequest a owl:Class ;
    rdfs:subClassOf hpc:Job .
