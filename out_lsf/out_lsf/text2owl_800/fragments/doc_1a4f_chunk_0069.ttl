hpc:Hostremoval a owl:Class .
hpc:logon a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Host .
hpc:runcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range xsd:string .
hpc:closehost a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Host .
hpc:stopdaemons a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range xsd:string .
hpc:removefromhostsection a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Hostsection .
hpc:removefromshared a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Configurationfile .
hpc:removefromlsbhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Configurationfile .
hpc:removefromlsbqueues a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Configurationfile .
hpc:removefromlsbresources a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Configurationfile .
hpc:reconfigurelim a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Host .
hpc:restartmbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Host .
hpc:removefromsystemstartfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Hostremoval ;
    rdfs:range hpc:Systemstartfile .

hpc:Host a owl:Class .
hpc:Hostsection a owl:Class ;
    rdfs:subClassOf hpc:Configurationsection .
hpc:Configurationfile a owl:Class .
hpc:Systemstartfile a owl:Class ;
    rdfs:subClassOf hpc:Configurationfile .
