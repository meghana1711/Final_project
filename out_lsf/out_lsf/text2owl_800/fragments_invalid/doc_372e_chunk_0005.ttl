hpc:Licenseserver a owl:Class .
hpc:hasLicenseFile an owl:ObjectProperty .
hpc:Host a owl:Class .
hpc:isRemoteAgentHost an owl:ObjectProperty .
hpc:usesConnectionMethod an owl:ObjectProperty .
hpc:Connectionmethod a owl:Class .
hpc:hasportnumber a owl:DatatypeProperty .
hpc:hasdefaultportrange a owl:DatatypeProperty .

hpc:Licenseserver rdfs:subClassOf hpc:Host .
hpc:Licenseserver rdfs:subClassOf rdf:Plural .
hpc:Haslicensefile rdfs:domain hpc:Licenseserver .
hpc:Haslicensefile rdfs:range xsd:string .
hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Isremoteagenthost rdfs:domain hpc:Licenseserver .
hpc:Isremoteagenthost rdfs:range xsd:boolean .
hpc:Usesconnectionmethod rdfs:domain hpc:Licenseserver .
hpc:Usesconnectionmethod rdfs:range hpc:Connectionmethod .

hpc:SSH a hpc:ConnectionMethod .
hpc:RSH a hpc:ConnectionMethod .
hpc:LSRun a hpc:ConnectionMethod .
hpc:Hasportnumber rdfs:domain hpc:Connectionmethod .
hpc:Hasportnumber rdfs:range xsd:integer .
hpc:Hasdefaultportrange rdfs:domain hpc:Connectionmethod .
hpc:Hasdefaultportrange rdfs:range xsd:integer .
