hpc:MajorRelease a owl:Class .
hpc:MaintenanceRelease a owl:Class .
hpc:CompatibleVersion a owl:Class .
hpc:PreReleaseVersion a owl:Class .
hpc:Daemon a owl:Class .
hpc:AccountingDaemon a owl:Class .
hpc:ControllerDaemon a owl:Class .
hpc:ComputeNodeDaemon a owl:Class .
hpc:OtherSlurmCommand a owl:Class .
hpc:CustomizedSlurmPlugin a owl:Class .
hpc:SeamlessUpgrade a owl:Class .

# Object Properties
hpc:hasVersion a owl:ObjectProperty .
hpc:hasMajorRelease a owl:ObjectProperty .
hpc:hasMaintenanceVersion a owl:ObjectProperty .
hpc:isCompatibleWith a owl:ObjectProperty .
hpc:isPreReleaseOf a owl:ObjectProperty .
hpc:upgradesTo a owl:ObjectProperty .
hpc:requiresUpgradeFrom a owl:ObjectProperty .
hpc:isInstanceOf a owl:ObjectProperty .

# Datatype Properties
hpc:hasReleaseCycle a owl:DatatypeProperty .
hpc:hasCompatibilityWindow a owl:DatatypeProperty .
hpc:hasEndOfSupport a owl:DatatypeProperty .
hpc:hasRevisedEndOfSupport a owl:DatatypeProperty .
hpc:hasTotalLength a owl:DatatypeProperty .
