hpc:ReservationDescMsg a owl:Class .
hpc:PurgeCompleted a owl:ObjectProperty .
hpc:PurgeCompleted rdfs:domain hpc:ReservationDescMsg ;
 hpc:PurgeCompleted rdfs:range hpc:PurgeCompletedObject .
hpc:PurgeCompletedObject a owl:Class ;
 hpc:PurgeCompletedObject rdf:type xsd:int .
hpc:PurgeCompletedObject rdfs:comment "If PURGE_COMP flag is set, the number of seconds this reservation will sit idle until it is revoked (32 bit integer number with flags)" .

hpc:Time a owl:DatatypeProperty ;
 hpc:Time rdfs:domain hpc:PurgeCompletedObject ;
 hpc:Time rdfs:range xsd:int .
hpc:Time rdfs:comment "If PURGE_COMP flag is set, the number of seconds this reservation will sit idle until it is revoked (32 bit integer number with flags)" .

hpc:StartTime a owl:DatatypeProperty ;
 hpc:StartTime rdfs:domain hpc:ReservationDescMsg ;
 hpc:StartTime rdfs:range hpc:UnixTimestamp .
hpc:StartTime rdfs:comment "StartTime (UNIX timestamp) (UNIX timestamp or time string recognized by Slurm (e.g., '[MM/DD[/YY]-]HH:MM[:SS]'); may also be infinite or unset) (64 bit integer number with flags)" .

hpc:Tres a owl:ObjectProperty ;
 hpc:Tres rdfs:domain hpc:ReservationDescMsg ;
 hpc:Tres rdfs:range hpc:TresList .

hpc:Users a owl:DatatypeProperty ;
 hpc:Users rdfs:domain hpc:ReservationDescMsg ;
 hpc:Users rdfs:range xsd:string .
hpc:Users rdfs:comment "List of permitted users" .

hpc:ReservationDescMsgList a owl:Class .
hpc:ReservationDescMsgList rdf:type rdfs:List .
hpc:ReservationDescMsgList rdfs:member hpc:ReservationDescMsg .

hpc:ReservationInfo a owl:Class .
hpc:Accounts a owl:DatatypeProperty ;
 hpc:Accounts rdfs:domain hpc:ReservationInfo ;
 hpc:Accounts rdfs:range xsd:string .
hpc:Accounts rdfs:comment "Comma-separated list of permitted accounts" .

hpc:BurstBuffer a owl:DatatypeProperty ;
 hpc:BurstBuffer rdfs:domain hpc:
