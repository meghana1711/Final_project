    rdfs:range xsd:float .

hpc:RUN_JOB_FACTOR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .

hpc:RUN_TIME_FACTOR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .

hpc:FAIRSHARE_ADJUSTMENT_FACTOR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .

hpc:GPU_RUN_TIME_FACTOR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .

hpc:COMMITTED_RUN_TIME_FACTOR
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .

hpc:DynamicSharePriority
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobowner ;
    rdfs:range hpc:Job .

hpc:DispatchOrder
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:FairSharePolicy
    a owl:ObjectProperty ;
