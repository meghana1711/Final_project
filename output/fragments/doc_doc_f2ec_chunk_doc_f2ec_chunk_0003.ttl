hpc:Job a owl:Class .
hpc:NonKillableProcess rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Process .

hpc:FileSystemProblem a owl:Class .
hpc:Reboot a owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:DownState a owl:Class .
hpc:UpdateState a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmCommand ;
    rdfs:range hpc:Node .

hpc:UnkillableStepProgram rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfig .

hpc:UnkillableStepTimeout rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfig .

hpc:SlurmdDebugLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfig .

hpc:ConnectivityProblem a owl:Class .
hpc:NodesNotResponding rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LogEntry .

hpc:Node a owl:Class .
hpc:Name a owl:DatatypeProperty ;
    rdfs:domain hpc:Node .

hpc:Reason a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmCommand ;
    rdfs:range xsd:string .

hpc:SlurmCommand a owl:Class .

hpc:SlurmConfig a owl:Class .

hpc:LogEntry a owl:Class .

hpc:NodeState a owl:Class .
hpc:DownState rdfs:subClassOf hpc:NodeState .

hpc:JobState a owl:Class .
hpc:CompletingState rdfs:subClassOf hpc:JobState .
```
