hpc:Jobrequirement a owl:Class .
hpc:num a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:mode a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:string .
hpc:mps a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:jExclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:aff a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:block a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:gpack a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:glink a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:boolean .
hpc:gvendor a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:string .
hpc:gmodel a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:string .
hpc:gtile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:string .
hpc:gmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range xsd:string .

hpc:Jobrequirementwithoutgpu a owl:Class ;
    rdfs:subClassOf hpc:Jobrequirement .
hpc:Jobrequirementwithgpu a owl:Class .

hpc:Taskrequirement a owl:Class ;
    rdfs:subClassOf hpc:Jobrequirement .
hpc:Hostrequirement a owl:Class ;
    rdfs:subClassOf hpc:Jobrequirement .

hpc:requirementpertask a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequirement ;
    rdfs:range hpc:Jobrequirementwithgpu ;
    rdfs:subPropertyOf hpc:num .

hpc:defaultRequirement a owl:NamedIndividual ;
    hpc:num "1" ;
    hpc:mode "shared" ;
    hpc:mps "false" ;
    hpc:j_exclusive "false" .
