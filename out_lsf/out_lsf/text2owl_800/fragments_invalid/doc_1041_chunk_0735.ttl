hpc:Resourcelimits rdfs:range xsd:decimal .
hpc:Prioritization hpc:controls hpc:SwitchedJob .
hpc:Runwindow hpc:controls hpc:SwitchedJob .
hpc:Chunkjob a owl:Class .
hpc:Queue hpc:controls hpc:ChunkJob .
hpc:Jobstate rdfs:domain hpc:Chunkjob ;
    rdfs:range xsd:string .
hpc:Requeuestate rdfs:domain hpc:Chunkjob ;
    rdfs:range xsd:string .
hpc:Runningchunkjobmember hpc:atype hpc:ChunkJobMember .
hpc:Running hpc:Jobstate rdfs:subClassOf xsd:string .
hpc:Wait hpc:Jobstate rdfs:subClassOf xsd:string .
hpc:Pending hpc:Jobstate rdfs:subClassOf xsd:string .
