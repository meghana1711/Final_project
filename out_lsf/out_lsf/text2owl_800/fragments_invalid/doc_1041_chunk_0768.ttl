@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Command a owl:Class .
hpc:Subcommand a owl:Class .
hpc:Hostname a owl:Class .
hpc:instanceid a owl:DatatypeProperty .
hpc:logfilename a owl:DatatypeProperty .
hpc:timinglevel a owl:DatatypeProperty .

hpc:Runs rdfs:domain hpc:Command .
hpc:Runs rdfs:range hpc:Subcommand .
hpc:Requireslogfile rdfs:domain hpc:Subcommand .
hpc:Requireslogfile rdfs:range hpc:Logfilename .
hpc:Requireshostname rdfs:domain hpc:Subcommand .
hpc:Requireshostname rdfs:range hpc:Hostname .
hpc:Requirestiminglevel rdfs:domain hpc:Subcommand .
hpc:Requirestiminglevel rdfs:range hpc:Timinglevel .
hpc:Expire rdfs:domain hpc:Command .
hpc:Expire rdfs:range rdf:List .
hpc:expire rdf:first hpc:HostName .
hpc:expire rdf:rest hpc:HostName .
hpc:expire rdf:last hpc:InstanceID .
hpc:Showconf rdfs:domain hpc:Command .
hpc:Showconf rdfs:range rdf:Plural .
hpc:showConf rdf:first hpc:HostName .
hpc:Help rdfs:domain hpc:Command .
hpc:Help rdfs:range rdf:List .
hpc:help rdf:first xsd:string .
hpc:quit a owl:ObjectProperty .
