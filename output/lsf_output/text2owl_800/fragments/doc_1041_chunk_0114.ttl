hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the High Performance Computing system." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier of the job or job array." .

hpc:indexlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "A comma-separated list of indices for a job array." .

hpc:startindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexlist ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The starting index of the job array." .

hpc:endindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexlist ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The ending index of the job array (inclusive)." .

hpc:step a owl:DatatypeProperty ;
    rdfs:domain hpc:Indexlist ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The step between indices in the job array." .

hpc:position a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "The position where the job is to be placed in the queue." .

hpc:Apsscheduledjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is pending in an absolute priority scheduling queue." .

hpc:administratorjobmanipulation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Allows jobs to be moved relative to the normal user's own job list. This can only be used by the LSF administrator." .

hpc:normaluserjobmanipulation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "If used by a normal user, this option is ignored." .
