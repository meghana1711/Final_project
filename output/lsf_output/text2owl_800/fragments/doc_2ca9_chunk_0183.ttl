hpc:LsfCrayRurDir a owl:Class .
hpc:LsfCrayRurDir rdfs:subClassOf owl:Resource .
hpc:LSF_CRAY_RUR_DIR rdfs:comment "Location of the RUR data files." .

hpc:hasdefaultvalue a owl:ObjectProperty .
hpc:Hasdefaultvalue rdfs:domain hpc:LsfCrayRurDir .
hpc:Hasdefaultvalue rdfs:range xsd:string .

hpc:LSF_CRAY_RUR_DIR rdfs:subPropertyOf hpc:hasDefaultValue .
hpc:LSF_CRAY_RUR_DIR rdf:value "LSF_SHARED_DIR/<cluster_name>/craylinux/<cray_machine_name>/rur" .

hpc:LsfCrayRurPrologPath a owl:Class .
hpc:LsfCrayRurPrologPath rdfs:subClassOf owl:Resource .
hpc:LSF_CRAY_RUR_PROLOG_PATH rdfs:comment "File path to the RUR prolog script file." .

hpc:hasdefaultvalue a owl:ObjectProperty .
hpc:Hasdefaultvalue rdfs:domain hpc:LsfCrayRurPrologPath .
hpc:Hasdefaultvalue rdfs:range xsd:string .

hpc:LSF_CRAY_RUR_PROLOG_PATH rdfs:subPropertyOf hpc:hasDefaultValue .
hpc:LSF_CRAY_RUR_PROLOG_PATH rdf:value "/opt/cray/rur/default/bin/rur_prologue.py" .

hpc:LsfCrayRurEpilogPath a owl:Class .
hpc:LsfCrayRurEpilogPath rdfs:subClassOf owl:Resource .
hpc:LSF_CRAY_RUR_EPILOG_PATH rdfs:comment "File path to the RUR epilog script file." .

hpc:hasdefaultvalue a owl:ObjectProperty .
hpc:Hasdefaultvalue rdfs:domain hpc:LsfCrayRurEpilogPath .
hpc:Hasdefaultvalue rdfs:range xsd:string .

hpc:LSF_CRAY_RUR_EPILOG_PATH rdfs:subPropertyOf hpc:hasDefaultValue .
hpc:LSF_CRAY_RUR_EPILOG_PATH rdf:value "/opt/cray/rur/default/bin/rur_epilogue.py" .

hpc:doesnotsupport a owl:ObjectProperty .
hpc:Doesnotsupport rdfs:domain hpc:LsfCrayRurDir .
hpc:Doesnotsupport rdfs:range xsd:string .
hpc:doesNotSupport rdfs:comment "The LSF administrator must enable RUR plug-ins, including output plug-ins, to ensure that the LSF_CRAY_RUR_DIR directory contains per-job accounting files (rur.<job_id>) or a flat file (rur.output)." .
