hpc:Executionenvironment a owl:Class .
hpc:Remoteexecutionserver rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .

hpc:StartJob an owl:ObjectProperty ;
    rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .

hpc:copyenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Executionenvironment ;
    rdfs:range rdf:Resource .

# Job Status
hpc:Run a owl:Class .
hpc:Done a owl:Class .
hpc:Exit a owl:Class .

hpc:Completedjob rdfs:subClassOf hpc:Job .
hpc:Completedjob rdfs:subClassOf rdf:Resource .
hpc:Completedjob rdfs:subClassOf hpc:Jobstatus .

hpc:Completedwithoutproblems a owl:Class ;
    rdfs:subClass hpc:CompletedJob .
hpc:Completedwithproblems a owl:Class ;
    rdfs:subClass hpc:CompletedJob .

hpc:Jobstatus rdfs:domain hpc:Completedjob ;
    rdfs:range rdf:Resource .

# Job Information
hpc:cpuuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .
hpc:memoryuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .
hpc:accountname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .
hpc:joboutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .
hpc:errors a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinformation .

hpc:Jobinformation rdfs:subClassOf rdf:Resource .

# Job Submission
hpc:SubmitJob an owl:ObjectProperty ;
    rdfs:domain hdf:User ;
    rdfs:range hpc:Job .

# Environment Variables
hpc:Environmentvariables a owl:Class .
hpc:workingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariables .
hpc:othersystemdependentsettings a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariables .

# System-Dependent Settings
hpc:Unixandlinux rdfs:subClassOf hpc:Systemdependentsettings .
hpc:resourcelimits a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixandlinux .
hpc:umask a owl:DatatypeProperty ;
    rdfs:domain hpc:Unixandlinux .

hpc:Windows rdfs:subClassOf hpc:Systemdependentsettings .
hpc:desktopdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Windows .
hpc:windowsrootdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Windows .

hpc:Systemdependentsettings rdfs:subClassOf rdf:Resource .

