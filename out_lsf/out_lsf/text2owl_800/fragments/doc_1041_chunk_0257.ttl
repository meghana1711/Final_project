hpc:Pendingjobs a owl:Class .
hpc:plan a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjobs ;
    rdfs:range hpc:Allocationplan .

hpc:priorityschedulingfactorvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjobs .

hpc:Jobsummary a owl:Class .
hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsummary .

hpc:Runningjobs a owl:Class ;
    rdfs:subClassOf hpc:Jobsummary .

hpc:resourceusage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsummary .

hpc:Suspendedjobs a owl:Class ;
    rdfs:subClassOf hpc:Jobsummary .

hpc:suspendingreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspendedjobs .

hpc:jobscript a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsummary .

hpc:serviceclass a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsummary .

hpc:Sessionschedulertasksummary a owl:Class .
hpc:ss a owl:ObjectProperty ;
    rdfs:domain hpc:Sessionschedulertasksummary .

hpc:Unfinishedjobssummary a owl:Class .

hpc:apsschedulingfactorvalues a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendingjobs .

hpc:Summarizedpendingjobs a owl:Class ;
    rdfs:subClassOf hpc:Unfinishedjobssummary .

hpc:pendingjobsinqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Summarizedpendingjobs .

hpc:Runningjobssummary a owl:Class ;
    rdfs:subClassOf hpc:Unfinishedjobssummary .

hpc:Resourcespecificrequest a owl:Class ;
    rdfs:subClassOf hpc:Jobsummary .

hpc:Script a xsd:string .
