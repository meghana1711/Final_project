hpc:LsfDaemon a owl:Class .
hpc:hasminportnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer ;
    rdfs:minValue "1024"^^xsd:integer ;
    rdfs:maxValue "65526"^^xsd:integer .
hpc:hasmaxportnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer ;
    rdfs:minValue "1033"^^xsd:integer ;
    rdfs:maxValue "65535"^^xsd:integer .
hpc:numports a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer ;
    rdfs:minValue "10"^^xsd:integer .
hpc:lsfUseHostequiv a owl:ObjectProperty .
hpc:LsfUserDomain a owl:Class .
hpc:mapuseraccounts a owl:ObjectProperty ;
    rdfs:domain hpc:LsfUserDomain ;
    rdfs:range rdf:List ;
    rdfs:rangeEach xsd:string .
