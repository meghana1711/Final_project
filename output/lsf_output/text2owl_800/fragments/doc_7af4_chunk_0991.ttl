hpc:LsfEauthKey a owl:Class .
hpc:LsfEauthOldkey a owl:Class .
hpc:lsfEauthOldkeyExpiry a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEauthOldkey ;
    rdfs:range xsd:dateTime .

hpc:hasprintablecharacters a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range xsd:boolean .

hpc:hasminimumlength a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range xsd:integer .

hpc:requiresuse a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range hpc:Command .

hpc:Command a owl:Class .

hpc:battach a hpc:Command .
hpc:dmd a hpc:Command .
hpc:gpolicyd a hpc:Command .
hpc:jobForwardMode a hpc:Command .

hpc:usesmulticlustercapability a owl:ObjectProperty ;
    rdfs:domain hpc:Command .

hpc:requireseauth a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Requirement .

hpc:eauthRequiresCommand a hpc:Requirement .

hpc:requireskeyupdate a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Requirement .

hpc:keyUpdateRequiresRenamingOldKey a hpc:Requirement .
hpc:keyUpdateRequiresDefiningNewKey a hpc:Requirement .

hpc:usesoldkey a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range hpc:LsfEauthOldkey .

hpc:allowsoldkeyusage a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range xsd:boolean .

hpc:lsfEauthOldkeyExpiryDate a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEauthOldkey ;
    rdfs:range xsd:dateTime .

hpc:lsfEauthKeyUnixEdit a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range xsd:string .

hpc:lsfEauthKeyWindowsEdit a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEauthKey ;
    rdfs:range xsd:string .

hpc:Notdefined a owl:Class .
