hpc:Csmjob a owl:Class .
hpc:reschedUponCSMError an owl:ObjectProperty .
hpc:CSMErrorCode rdf:type xsd:int .
hpc:CSM_REQ an owl:ObjectProperty .
hpc:CSM_REQ_Option rdf:type owl:Class .
hpc:jsm rdf:type hpc:CSM_REQ_Option .
hpc:step_cgroup rdf:type hpc:CSM_REQ_Option .
hpc:core_isolation rdf:type hpc:CSM_REQ_Option .
hpc:cn_mem rdf:type hpc:CSM_REQ_Option .
hpc:alloc_flags rdf:type hpc:CSM_REQ_Option .
hpc:smt rdf:type hpc:CSM_REQ_Option .
hpc:LsfDaemon a owl:Class .
hpc:LSF_DaemonRestart an owl:ObjectProperty .
hpc:easyModeSubmission an owl:ObjectProperty .
hpc:CsmAccounting a owl:Class .
hpc:viewCSMAllocationAccounting an owl:ObjectProperty .
hpc:viewCSMJobDetails an owl:ObjectProperty .
hpc:Easymodesubmissionmethod a owl:Class .

hpc:Csmjob rdfs:subClassOf hpc:Job .
hpc:Rescheduponcsmerror rdfs:domain hpc:Csmjob ;
                             rdfs:range xsd:integer .
hpc:CsmReq rdfs:domain hpc:Csmjob ;
                             rdfs:range hpc:CsmReq .
hpc:CsmReqOption rdfs:subClassOf hpc:CsmReq .
hpc:Jsm rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:range xsd:string .
hpc:StepCgroup rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:range xsd:string .
hpc:CoreIsolation rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:range xsd:int .
hpc:CnMem rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:domain hpc:CsmReq ;
                             rdfs:range xsd:string .
hpc:AllocFlags rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:domain hpc:CsmReq ;
                             rdfs:range xsd:string .
hpc:Smt rdfs:subClassOf hpc:CsmReqOption ;
                             rdfs:range xsd:int .
hpc:LsfDaemon rdfs:subClassOf hpc:Daemon .
hpc:LsfDaemonrestart rdfs:domain hpc:LsfDaemon ;
                             rdfs:range xsd:string .
hpc:Easymodesubmission rdfs:domain hpc:Csmjob ;
                             rdfs:range hpc:Easymodesubmissionmethod .
hpc:CSM_
