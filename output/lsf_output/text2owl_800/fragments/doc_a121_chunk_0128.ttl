hpc:Hpcsite a owl:Class .
hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Preexecutionprocessing a owl:Class .
hpc:Postexecutionprocessing a owl:Class .
hpc:Systemhealthcheck a owl:Class .
hpc:Sshaccess a owl:Class .
hpc:Temporaryworkingdirectory a owl:Class .
hpc:Applicationlevelprocessing a owl:Class .
hpc:Queuelevelprocessing a owl:Class .
hpc:Failurehandling a owl:Class .

hpc:hassystemhealthcheck a owl:ObjectProperty .
hpc:hassshaccess a owl:ObjectProperty .
hpc:hastemporaryworkingdirectory a owl:ObjectProperty .
hpc:hasapplicationlevelprocessing a owl:ObjectProperty .
hpc:hasqueuelevelprocessing a owl:ObjectProperty .
hpc:hasfailurehandling a owl:ObjectProperty .

hpc:Systemhealthcheck rdfs:subClassOf hpc:Preexecutionprocessing .
hpc:Sshaccess rdfs:subClassOf hpc:Preexecutionprocessing .
hpc:Temporaryworkingdirectory rdfs:subClassOf hpc:Postexecutionprocessing .
hpc:Applicationlevelprocessing rdfs:subClassOf hpc:Preexecutionprocessing .
hpc:Queuelevelprocessing rdfs:subClassOf hpc:Preexecutionprocessing .
hpc:Failurehandling rdfs:subClassOf hpc:Postexecutionprocessing .

hpc:Hassystemhealthcheck rdfs:domain hpc:Hpcsite ;
    rdfs:range hpc:Systemhealthcheck .
hpc:Hassshaccess rdfs:domain hpc:Hpcsite ;
    rdfs:range hpc:Sshaccess .
hpc:Hastemporaryworkingdirectory rdfs:domain hpc:Host ;
    rdfs:range hpc:Temporaryworkingdirectory .
hpc:Hasapplicationlevelprocessing rdfs:domain hpc:Job ;
    rdfs:range hpc:Applicationlevelprocessing .
hpc:Hasqueuelevelprocessing rdfs:domain hpc:Job ;
    rdfs:range hpc:Queuelevelprocessing .
hpc:Hasfailurehandling rdfs:domain hpc:Job ;
    rdfs:range hpc:Failurehandling .
