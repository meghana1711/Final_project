hpc:Resourceproviderinstance a owl:Class .
hpc:Lsfmanagementhost a owl:Class .
hpc:Computenode a owl:Class .
hpc:Providerinstance a owl:Class .
hpc:Job a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Virtualnetwork a owl:Class .
hpc:Submissionuser a owl:Class .
hpc:Authenticationmethod a owl:Class .
hpc:Javarequirement a owl:Class .

# Object Properties
hpc:hasResourceProviderInstance rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Resourceproviderinstance .
hpc:isManagedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourceproviderinstance ;
    rdfs:range hpc:Lsfmanagementhost .
hpc:hasComputeNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Computenode .
hpc:isRunningOn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Computenode .
hpc:belongsToVirtualNetwork rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourceproviderinstance ;
    rdfs:range hpc:Virtualnetwork .
hpc:mapsToSubmissionUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourceproviderinstance ;
    rdfs:range hpc:Submissionuser .
hpc:usesAuthenticationMethod rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Authenticationmethod .

# Datatype Properties
hpc:requiresRootAccess rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfresourceconnector .
hpc:isReachableFrom rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfresourceconnector ;
    rdfs:range xsd:boolean .
hpc:requiresRestart rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfresourceconnector .
hpc:requiresFamiliarity rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfresourceconnector .
hpc:usesJavaRequirement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Javarequirement .

# Class Subclass Relations
hpc:Lsfresourceconnector a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:intersectionOf ( hpc:LSFCluster owl:ObjectPropertyOf ( hpc:hasResourceProviderInstance ) )
    ] .

# Java Requirements
hpc:Javarequirement a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:intersectionOf ( xsd:string owl:sameAs "Java Runtime Environment (J
