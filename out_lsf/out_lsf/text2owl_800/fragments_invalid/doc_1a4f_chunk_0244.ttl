hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Processorunit a owl:Class .
hpc:Numa a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .

hpc:pack an owl:ObjectProperty .
hpc:pend an owl:ObjectProperty .
hpc:balance an owl:ObjectProperty .
hpc:any an owl:ObjectProperty .
hpc:affinity an owl:ObjectProperty .
hpc:span an owl:ObjectProperty .
hpc:distribute an owl:ObjectProperty .
hpc:cpubind an owl:ObjectProperty .
hpc:membind an owl:ObjectProperty .
hpc:exclusive an owl:ObjectProperty .
hpc:same an owl:ObjectProperty .
hpc:localonly an owl:DatatypeProperty .
hpc:localprefer an owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Task rdfs:subClassOf owl:Class .
hpc:Processorunit rdfs:subClassOf owl:Class .
hpc:Numa rdfs:subClassOf hpc:Processorunit .
hpc:Socket rdfs:subClassOf hpc:Processorunit .
hpc:Core rdfs:subClassOf hpc:Processorunit .
hpc:Thread rdfs:subClassOf hpc:Processorunit .

hpc:Pack rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Pend rdfs:domain hpc:Job ;
    rdfs:range rdf:Boolean .
hpc:Balance rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Any rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Affinity rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Span rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Distribute rdfs:domain hpc:Affinity ;
    rdfs:range xsd:string .
hpc:Cpubind rdfs:domain hpc:Affinity ;
    rdfs:range xsd:string .
hpc:Membind rdfs:domain hpc:Affinity ;
    rdfs:range xsd:string .
hpc:Exclusive rdfs:domain hpc:Affinity ;
    rdfs:range rdf:List .
hpc:Same rdfs:domain hpc:Affinity ;
    rdfs:range rdf:List .
hpc:Localonly rdfs:domain hpc:Cpubind ;
    rdfs:range xsd:string .
hpc:Localprefer rdfs:domain hpc:Cpubind ;
    rdfs:range xsd:string .
