                 rdfs:range rdf:List .
hpc:qos rdfs:domain hpc:JobScript ;
               rdfs:range xsd:string .
hpc:reason rdfs:domain hpc:JobScript ;
               rdfs:range rdf:List .
hpc:reservation rdfs:domain hpc:JobScript ;
                 rdfs:range rdf:List .
hpc:reservationId rdfs:domain hpc:Reservation ;
                    rdfs:range xsd:string .
hpc:state rdfs:domain hpc:JobScript ;
               rdfs:range xsd:string .
hpc:step rdfs:domain hpc:JobScript ;
               rdfs:range xsd:string .
hpc:endTime rdfs:domain hpc:JobScript ;
                 rdfs:range xsd:dateTime .
hpc:startTime rdfs:domain hpc:JobScript ;
                 rdfs:range xsd:dateTime .
hpc:node rdfs:domain hpc:JobScript ;
               rdfs:range xsd:string .
hpc:users rdfs:domain hpc:JobScript ;
