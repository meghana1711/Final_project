hpc:Templateinstancequota a owl:Class .
hpc:Vmattribute a owl:Class .
hpc:AttributeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Vmattribute ;
    rdfs:range xsd:string .
hpc:AttributeType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Vmattribute ;
    rdfs:range xsd:string .
hpc:AttributeValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Vmattribute ;
    rdfs:range xsd:string .
hpc:LSBResourceName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Vmattribute ;
    rdfs:range xsd:string .
hpc:ResourceDefinition rdf:type owl:Class .
hpc:ResourceType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcedefinition ;
    rdfs:range xsd:string .
hpc:ResourceTypeValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcedefinition ;
    rdfs:range xsd:string .
hpc:DefaultHostType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Templateinstancequota ;
    rdfs:range xsd:string .
hpc:SupportedAttribute rdf:type owl:ObjectProperty .
hpc:Templateinstancequota rdfs:subClassOf owl:Class .
hpc:Vmattribute rdfs:subClassOf owl:Class .
hpc:Resourcedefinition rdfs:subClassOf owl:Class .
