hpc:Timewindow a owl:Class .
hpc:hastimewindow a owl:ObjectProperty .
hpc:Hastimewindow rdfs:domain hpc:Reservation .
hpc:Hastimewindow rdfs:range hpc:Timewindow .

hpc:Timewindow rdfs:subClassOf rdf:List .
hpc:Timewindow rdfs:subClassOf hpc:Hastwoelements .
hpc:Hastwoelements rdfs:subClassOf rdf:List .
hpc:Hastwoelements rdfs:subClassOf rdf:list .

hpc:begintime a owl:DatatypeProperty .
hpc:Begintime rdfs:domain hpc:Timewindow .
hpc:Begintime rdfs:range xsd:time .

hpc:endtime a owl:DatatypeProperty .
hpc:Endtime rdfs:domain hpc:Timewindow .
hpc:Endtime rdfs:range xsd:time .

hpc:day a owl:DatatypeProperty .
hpc:Day rdfs:range xsd:nonNegativeInteger .

hpc:hour a owl:DatatypeProperty .
hpc:Hour rdfs:range xsd:nonNegativeInteger .

hpc:minute a owl:DatatypeProperty .
hpc:Minute rdfs:range xsd:nonNegativeInteger .

hpc:Reservation a owl:Class .
hpc:Reservation rdfs:subClassOf rdf:Resource .
