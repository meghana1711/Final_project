# Classes
hpc:SlurmWorkloadManager a owl:Class .
hpc:SlurmPlugin a owl:Class .
hpc:PrepPlugin a owl:Class, rdfs:subClassOf hpc:SlurmPlugin .

# Object Properties
hpc:pluginName a owl:ObjectProperty .
hpc:pluginType a owl:ObjectProperty .
hpc:pluginVersion a owl:ObjectProperty .
hpc:PrEpPlugins a owl:ObjectProperty .
hpc:prepCallbacks a owl:ObjectProperty .

# Datatype Properties
hpc:pluginNameRange a xsd:string .
hpc:pluginTypeRange a xsd:string .

# Slurm PrEp Plugin API
hpc:prep_p_prolog a owl:ObjectProperty .
hpc:prep_p_epilog a owl:ObjectProperty .
hpc:prep_p_prolog_slurmctld a owl:ObjectProperty .
hpc:prep_p_epilog_slurmctld a owl:ObjectProperty .

# Function Requirements
hpc:init a owl:ObjectProperty .
hpc:fini a owl:ObjectProperty .
hpc:prep_p_register_callbacks a owl:ObjectProperty .

# Function Arguments and Returns
hpc:initDomain rdfs:Resource .
hpc:initRange xsd:integer .
hpc:finiDomain rdfs:Resource .
hpc:prep_p_register_callbacksDomain rdfs:Resource .
hpc:prep_p_register_callbacksRange rdfs:Resource .
hpc:prep_p_prologDomain ( rdfs:Resource, rdfs:Resource ) .
hpc:prep_p_prologRange xsd:integer .
hpc:prep_p_epilogDomain ( rdfs:Resource, rdfs:Resource ) .
hpc:prep_p_epilogRange xsd:integer .
hpc:prep_p_prolog_slurmctldDomain ( rdfs:Resource, xsd:boolean ) .
hpc:prep_p_prolog_slurmctldRange xsd:integer .
hpc:prep_p_epilog_slurmctldDomain ( rdfs:Resource, xsd:boolean ) .
hpc:prep_p_epilog_slurmctldRange xsd:integer .
