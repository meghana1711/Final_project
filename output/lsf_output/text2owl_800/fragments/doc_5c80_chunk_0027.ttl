hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in the LSF system." .

hpc:Executionhost a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a host where a job can be executed." .

hpc:Resourcereservation a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents the reservation of resources in the LSF system." .

hpc:currentworkingdirectoryobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The directory where the job is currently working on the execution host." .

hpc:remotefileobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file name with no path to be placed in the job's current working directory on the execution host." .

hpc:homedirectoryobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The home directory on the execution host where the job is run if the current working directory does not exist." .

hpc:resourceconsumptiondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of resources consumed by a job over a period of time." .

hpc:availableresourcedatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of resources available on an execution host." .

hpc:reservedresourcedatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The amount of resources reserved for a job." .

hpc:overcommitmentprevention a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range hpc:Resourcereservation ;
    rdfs:comment "The resource reservation that prevents overcommitment on an execution host." .
