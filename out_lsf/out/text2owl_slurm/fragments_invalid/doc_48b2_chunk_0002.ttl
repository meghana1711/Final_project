hpc:Slurmentity a owl:Class .
hpc:Command a owl:Class .

hpc:Sacct hpc:command ;
    rdfs:comment "Used to report job or job step accounting information about active or completed jobs." .

hpc:Salloc hpc:command ;
    rdfs:comment "Used to allocate resources for a job in real time. Typically this is used to allocate resources and spawn a shell." .

hpc:srun rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
