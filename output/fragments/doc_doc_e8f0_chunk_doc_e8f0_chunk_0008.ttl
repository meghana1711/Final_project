hpc:Plugin a owl:Class .
hpc:CompileablePlugin a owl:Class, rdfs:subClassOf [ hpc:Plugin ] .
hpc:hasBuildEnvironment rdf:Property .
hpc:hasSource rdf:Property .
hpc:hasBuildDirectory rdf:Property .
hpc:hasPluginBuildDirectory rdf:Property, rdfs:domain [ hpc:CompileablePlugin ] .
hpc:hasInstallationLocation rdf:Property .
hpc:buildFromSource rdf:Property .
hpc:configure rdf:Property .
hpc:hasPluginFiles rdf:Property .
hpc:hasPluginCode rdf:Property, rdfs:domain [ hpc:PluginFiles ] .
hpc:copyDependency rdf:Property .
hpc:hasCompileCommand rdf:Property .
hpc:compilesWith gpp:CompileCommand a owl:ObjectProperty .
hpc:compiledBy gpp:CompiledBy a owl:ObjectProperty .
hpc:hasCompileOutput rdf:Property .
hpc:compiledAtTime xsd:dateTime rdfs:range [ hpc:hasCompileOutput ] .

hpc:SlurmPlugin a owl:Class, rdfs:subClassOf [ hpc:CompileablePlugin ] .
```
