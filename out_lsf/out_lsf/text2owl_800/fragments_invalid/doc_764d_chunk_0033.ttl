hpc:Job a owl:Class .
hpc:SubmissionCluster rdf:type owl:Class .
hpc:ReceiveJobsQueue rdf:type owl:Class .
hpc:ExecutionCluster rdf:type owl:Class .
hpc:Host rdf:type owl:Class .
hpc:JobID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:SchedulingCycle rdf:type owl:Class .
hpc:SuitableHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range hpc:Host .
hpc:Dispatch rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range hpc:Job .
hpc:Pending rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Receivejobsqueue ;
    rdfs:range hpc:Job .
hpc:MaxRshedTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LsbMcInitFailRetry rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Psusp rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Submissioncluster ;
    rdfs:range hpc:Job .
hpc:InsufficientResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Submissioncluster ;
    rdfs:range hsw:Resource .
hpc:QueueSchedulingParameters rdf:type owl:Class .
hpc:JobForwardingModel rdf:type owl:Class .
hpc:ConsistentSchedulingBehavior rdf:type owl:Class .
hpc:IdenticalBehavior rdf:type owl:Class ;
    rdfs:subClassOf hpc:Consistentschedulingbehavior .
hpc:DifferentSchedulingPolicies rdf:type owl:Class ;
    rdfs:subClassOf hpc:Consistentschedulingbehavior .
hpc:SendJobsQueueParameters rdf:type owl:Class .
hpc:ReceiveJobsQueueParameters rdf:type owl:Class .
hpc:JobLevelRequirements rdf:type owl:Class ;
    rdfs:subClassOf hpc:Sendjobsqueueparameters .
hpc:QueueLevelParameters rdf:type owl:Class ;
    rdfs:subClassOf hpc:Sendjobsqueueparameters .
hpc:MultiClusterJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:SendJobsQueue rdf:type owl:Class ;
    rdfs:subClassOf hpc:Queueschedulingparameters ;
    rdfs:subClassOf hpc:Sendjobsqueueparameters .
hpc:ReceiveJobsQueue rdf:type owl:Class ;
    rdfs:subClassOf hpc:Queueschedulingparameters ;
