hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job with an increasing memory reservation." .

hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the time period within which the specified resources should be reserved." .

hpc:durationUnit a owl:Enum ;
    rdfs:subClassOf owl:Datatype ;
    rdfs:comment "Specifies the unit of duration: seconds, minutes, or hours." ;
    rdfs:member hpc:seconds ;
    rdfs:member hpc:minutes ;
    rdfs:member hpc:hours .

hpc:seconds rdf:type xsd:nonNegativeInteger ;
    rdfs:range [0,60]xsd:integer ;
    rdfs:comment "The duration is measured in seconds." .

hpc:minutes rdf:type xsd:nonNegativeInteger ;
    rdfs:range [0,1440]xsd:integer ;
    rdfs:comment "The duration is measured in minutes." .

hpc:hours rdf:type xsd:nonNegativeInteger ;
    rdfs:range [0,43200]xsd:integer ;
    rdfs:comment "The duration is measured in hours." .

hpc:Multiphaseresource a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a multi-phase memory resource." .

hpc:Singlephaseresource a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a single-phase memory resource." .

hpc:ELIMUpdatingInterval a xsd:nonNegativeInteger ;
    rdfs:comment "The minimum duration that should be specified for a job." .
