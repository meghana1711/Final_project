hpc:Brsvmodcommand a owl:Class .

hpc:supportsreservationidatclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range xsd:boolean .

hpc:supportsusernameatclustername a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range xsd:boolean .

hpc:numberunitrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand .

hpc:candidatelist a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range rdf:List .

hpc:triggerserror a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range xsd:boolean .

hpc:hostlist a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand .

hpc:findslotsfromhost a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range rdf:Plural .

hpc:removeshostswithnoslots a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range xsd:boolean .

hpc:manuallyaddtimewindow a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range rdf:List .

hpc:begintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Manuallyaddtimewindow .

hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Manuallyaddtimewindow .

hpc:reservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Manuallyaddtimewindow .

hpc:addresource a owl:ObjectProperty ;
    rdfs:domain hpc:Brsvmodcommand ;
    rdfs:range rdf:List .

hpc:numberunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Addresource .

hpc:resourcerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Addresource .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Addresource .

hpc:hostgroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Addresource .

hpc:Placeholderreservation a owl:Class .

hpc:onetimereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Placeholderreservation .

hpc:Recurringreservation a owl:Class .

hpc:cleanedwhenreservationexpires a owl:ObjectProperty ;
    rdfs:domain hpc:Placeholderreservation .

hpc:Timewindow a owl:Class .

