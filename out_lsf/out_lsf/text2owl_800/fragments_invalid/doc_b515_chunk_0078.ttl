hpc:lsfjob SMTMode a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .

hpc:cpuspercore a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:distributionpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .

hpc:BalancePolicy a owl:NamedIndividual ;
    hpc:DistributionPolicy "balance" .

hpc:PackPolicy a owl:NamedIndividual ;
    hpc:DistributionPolicy "pack" .

hpc:AnyPolicy a owl:NamedIndividual ;
    hpc:DistributionPolicy "any" .

hpc:P8Affinity a owl:NamedIndividual ;
    rdfs:subClassOf hpc:Affinity ;
    hpc:cpus_per_core some hpc:CPUsPerCore ;
    hpc:distribution_policy some hpc:DistributionPolicy .

hpc:P8AffinityWithCPUsPerCore a owl:NamedIndividual ;
    rdfs:subClassOf hpc:P8affinity ;
    hpc:cpus_per_core some xsd:integer .

hpc:P8AffinityWithSMT a owl:NamedIndividual ;
    rdfs:subClassOf hpc:P8affinity ;
    hpc:SMTMode some xsd:string .

hpc:DefaultP8Affinity a owl:NamedIndividual ;
    hpc:cpus_per_core 1 ;
    hpc:DistributionPolicy hpc:packpolicy .
