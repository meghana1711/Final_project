hpc:AwsEc2Instance a owl:Class .
hpc:launchtime a owl:DatatypeProperty ;
    rdfs:domain hpc:AwsEc2Instance ;
    rdfs:range xsd:dateTime .

hpc:Template a owl:Class .
hpc:exclusiveresource a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range hpc:Resource .

hpc:Resource a owl:Class .
hpc:isexclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .

hpc:Host a owl:Class .
hpc:hasexclusiveresource a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Resource .

hpc:Job a owl:Class .
hpc:requestsresource a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .

hpc:Federateduser a owl:Class .
hpc:hastemporarycredentials a owl:ObjectProperty ;
    rdfs:domain hpc:Federateduser ;
    rdfs:range xsd:string .

hpc:Exclusiveresourcedefinition a owl:Class .
hpc:isexclusivenot a owl:ObjectProperty ;
    rdfs:domain hpc:Exclusiveresourcedefinition ;
    rdfs:range xsd:string .

hpc:AWS_EC2_Instance_launched_at_t16 a hpc:AWS_EC2_Instance ;
    hpc:launchTime "t16"^^xsd:dateTime .

hpc:test_job_template a hpc:template ;
    hpc:exclusiveResource instance_store .

hpc:cheapest_instance_type a hpc:Resource ;
    hpc:isExclusiveNot "instance_store" .

hpc:scheduler a hpc:Job ;
    hpc:Requestsresource hpc:cheapestInstanceType .

hpc:federated_user a hpc:FederatedUser ;
    hpc:hasTemporaryCredentials "credentials"^^xsd:string .

hpc:exclusive_resource_definition_for_instance_store a hpc:exclusiveResourceDefinition ;
    hpc:isExclusiveNot "instance_store" .
