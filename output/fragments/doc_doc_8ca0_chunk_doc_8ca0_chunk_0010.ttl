hpc:SuspendTimeout
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum time permitted (in second) between when a node suspend request is issued and when the node shutdown is complete." .

hpc:NodeLifecycle
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:PowerSavingState
    a owl:Class ;
    rdfs:subClassOf hpc:NodeLifecycle .

hpc:PowerDownState
    a owl:Class ;
    rdfs:subClassOf hpc:PowerSavingState ;
    rdfs:comment "POWER_DOWN! Power down request." .

hpc:PowerUpState
    a owl:Class ;
    rdfs:subClassOf hpc:PowerSavingState ;
    rdfs:comment "POWER_UP Power up request." .

hpc:PoweredDownState
    a owl:Class ;
    rdfs:subClassOf hpc:PowerSavingState ;
    rdfs:comment "POWERED_DOWN~The node is powered down or in power saving mode." .

hpc:PoweringDownState
    a owl:Class ;
    rdfs:subClassOf hpc:PowerSavingState ;
    rdfs:comment "POWERING_DOWN%The node is in the process of powering down, or being put into power saving mode, and is not capable of running any jobs for SuspendTimeout." .

hpc:PoweringUpState
    a owl:Class ;
    rdfs:subClassOf hpc:PowerSavingState ;
    rdfs:comment "POWERING_UP#The node is in the process of powering up, or being restored from power saving mode." .

hpc:NodeState
    a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:ManualPowerSaving
    a owl:Class ;
    rdfs:subClassOf hpc:NodeState .

hpc:Node
    a owl:Class .

hpc:scontrolUpdateNodeState
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range hpc:ManualPowerSaving .

hpc:scontrolUpdateNodeStatePowerDown
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range hpc:PowerDownState .

hpc:scontrolUpdateNodeStatePowerUp
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range hpc:PowerUpState .
```
