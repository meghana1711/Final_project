hpc:Project a owl:Class .
hpc:Queue a owl:Class .
hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Subgroup a owl:Class .
hpc:Limit a owl:Class .
hpc:perproject a owl:ObjectProperty .
hpc:perqueue a owl:ObjectProperty .
hpc:peruser a owl:ObjectProperty .
hpc:projects a owl:DatatypeProperty .
hpc:queues a owl:DatatypeProperty .
hpc:resource a owl:DatatypeProperty .
hpc:slots a owl:DatatypeProperty .

hpc:Project rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Usergroup rdfs:subClassOf owl:Class .
hpc:Subgroup rdfs:subClassOf hpc:Usergroup .
hpc:Limit rdfs:subClassOf owl:Class .

hpc:Perproject rdfs:domain hpc:Limit ;
          rdfs:range rdf:List .
hpc:Perqueue rdfs:domain hpc:Limit ;
          rdfs:range rdf:List .
hpc:Peruser rdfs:domain hpc:Limit ;
          rdfs:range rdf:List .
hpc:Projects rdfs:domain hpc:Project ;
          rdfs:range rdf:List .
hpc:Queues rdfs:domain hpc:Queue ;
          rdfs:range rdf:List .
hpc:Resource rdfs:domain hpc:Limit ;
          rdfs:range xsd:decimal .
hpc:Slots rdfs:domain hpc:Limit ;
          rdfs:range xsd:nonNegativeInteger .
