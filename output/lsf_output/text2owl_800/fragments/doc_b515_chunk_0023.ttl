hpc:Computeunit a owl:Class .
hpc:Enclosure a owl:Class .
hpc:Rack a owl:Class .
hpc:Balancedallocation a owl:Class .
hpc:slot a owl:DatatypeProperty .
hpc:Hasenclosure rdfs:domain hpc:Computeunit ;
                  rdfs:range hpc:Enclosure .
hpc:Hasrack rdfs:domain hpc:Computeunit ;
              rdfs:range hpc:Rack .
hpc:Hasbalancedallocation rdfs:domain hpc:Computeunit ;
                          rdfs:range hpc:Balancedallocation .
hpc:Hasslot rdfs:domain hpc:Balancedallocation ;
              rdfs:range xsd:integer .

hpc:enclosure1 a hpc:Enclosure ;
              hpc:hasSlot "30" .
hpc:enclosure3 a hpc:Enclosure ;
              hpc:hasSlot "18" .
hpc:enclosure4 a hpc:Enclosure ;
              hpc:hasSlot "16" .
hpc:rack4 a hpc:Rack ;
          hpc:hasSlot "40" .
