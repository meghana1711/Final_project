hpc:Processorreservation a owl:Class .
hpc:hasminimumprocessorrequirements a owl:ObjectProperty ;
    rdfs:domain hpc:Processorreservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:reservationtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Processorreservation ;
    rdfs:range xsd:duration .
hpc:isreserved a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:Processorreservation .
hpc:givesupreservedslotsifnotenoughtostart a owl:ObjectProperty ;
    rdfs:domain hpc:Processorreservation .
hpc:Jobslot a owl:Class .
hpc:isavailable a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:boolean .
hpc:isreserved a owl:ObjectProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:Processorreservation .
hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:requiresjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:nonNegativeInteger .
