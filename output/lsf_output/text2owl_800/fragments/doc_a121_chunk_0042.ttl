hpc:Chunkjob a owl:Class .
hpc:Runlimitcondition a owl:Class .
hpc:Jobstate a owl:Class .
hpc:RUNNING a hpc:JobState .
hpc:UNKNOWN a hpc:JobState .
hpc:Hostunavailable a owl:Class .
hpc:Executioncluster a owl:Class .
hpc:removehungjobsfor a owl:ObjectProperty .
hpc:Orphanjob a owl:Class .
hpc:Orphanjobtermination a owl:Class .
hpc:Dependencycondition a owl:Class .
hpc:Parentjob a owl:Class .
hpc:Childjob a owl:Class .
hpc:Pendingjob a owl:Class .
hpc:orphanjobterminationgraceperiod a owl:DatatypeProperty .
hpc:orphanjobterminationimmediate a owl:ObjectProperty .
hpc:Lsbparams a owl:Class .
hpc:orphanjobterminationenabled a owl:ObjectProperty .

hpc:Chunkjob rdfs:subClassOf owl:Class .
hpc:Runlimitcondition rdfs:subClassOf owl:Class .
hpc:Jobstate rdfs:subClassOf owl:Class .
hpc:Hostunavailable rdfs:subClassOf owl:Class .
hpc:Executioncluster rdfs:subClassOf owl:Class .

hpc:Removehungjobsfor rdfs:domain hpc:Executioncluster .
hpc:Removehungjobsfor rdfs:range hpc:Chunkjob .

hpc:Orphanjobterminationgraceperiod rdfs:domain hpc:Orphanjobtermination .
hpc:Orphanjobterminationgraceperiod rdfs:range xsd:nonNegativeInteger .

hpc:Orphanjobterminationimmediate rdfs:domain hpc:Orphanjob .
hpc:Orphanjobterminationimmediate rdfs:range hpc:Orphanjob .

hpc:Orphanjobtermination rdfs:subClassOf owl:Class .
hpc:Orphanjobtermination rdfs:subClassOf hpc:Chunkjob .

hpc:Dependencycondition rdfs:subClassOf owl:Class .
hpc:Parentjob rdfs:subClassOf hpc:Chunkjob .
hpc:Childjob rdfs:subClassOf hpc:Chunkjob .
hpc:Pendingjob rdfs:subClassOf hpc:Chunkjob .

hpc:Lsbparams a owl:Class .
hpc:Orphanjobterminationenabled rdfs:domain hpc:Lsbparams .
hpc:Orphanjobterminationenabled rdfs:range hpc:Orphanjobtermination .
