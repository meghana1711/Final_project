hpc:Planbasedallocation a owl:Class .
hpc:Planbasedscheduling a owl:Class .
hpc:estimatedruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Planbasedscheduling ;
    rdfs:range xsd:float .
hpc:limitsandprioritization a owl:ObjectProperty ;
    rdfs:domain hpc:Planbasedscheduling ;
    rdfs:range xsd:string .
hpc:reservation a owl:ObjectProperty ;
    rdfs:domain hpc:Planbasedallocation ;
    rdfs:range hpc:Reservation .
hpc:Resourcereservation a owl:Class .
hpc:Canceledallocation a owl:Class ;
    rdfs:subClassOf hpc:Planbasedallocation .
hpc:Idealworld a owl:Class .
hpc:Invalidallocation a owl:Class .
hpc:Highthroughputenvironment a owl:Class .
hpc:Standardlsfscheduling a owl:Class .
hpc:Jobstarvation a owl:Class .
hpc:limitedplannedjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Planbasedallocation ;
    rdfs:range xsd:integer .
hpc:planwindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Planbasedscheduling ;
    rdfs:range xsd:duration .
