hpc:Googlecloudtemplate a owl:Class .
hpc:gcloudregion a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudtemplate ;
    rdfs:range xsd:string .
hpc:googlecloudprojectid a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudtemplate ;
    rdfs:range xsd:string .
hpc:gcloudcredentialfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudtemplate ;
    rdfs:range xsd:string .
hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudtemplate ;
    rdfs:range xsd:string .
hpc:Googlecloudtemplatemapping a owl:Class ;
    rdfs:subClassOf hpc:Googlecloudtemplate .
hpc:Googlecloudinstance a owl:Class .
hpc:numcpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudinstance ;
    rdfs:range xsd:nonNegativeInteger .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudinstance ;
    rdfs:range xsd:nonNegativeInteger .
hpc:softwarestack a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudinstance ;
    rdfs:range xsd:string .
hpc:operatingsystem a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudinstance ;
    rdfs:range xsd:string .
hpc:googlecloudtemplatemapsto a owl:ObjectProperty ;
    rdfs:domain hpc:Googlecloudtemplatemapping ;
    rdfs:range hpc:Googlecloudinstance .
hpc:Googlecloudresourcedemand a owl:Class .
hpc:numinstancesoftemplate a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudresourcedemand ;
    rdfs:range xsd:nonNegativeInteger .
