hpc:ArrayJobId a owl:DatatypeProperty .
hpc:ClusterFeatures a rdf:Property .
hpc:Partition a rdf:Property .
hpc:SegmentSize a owl:DatatypeProperty .
hpc:ThreadsPerCore a owl:Class .
hpc:ThreadsPerCore rdfs:subClassOf [ a owl:Restriction ;
                                      owl:onProperty hpc:threads_per_core ;
                                      owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:threads_per_core a owl:ObjectProperty .
hpc:tres_alloc_str a rdf:Property .
hpc:MemoryPerCpu a owl:Class .
hpc:MemoryPerCpu rdfs:subClassOf [ a owl:Restriction ;
                                    owl:onProperty hpc:memory_per_cpu ;
                                    owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:memory_per_cpu a owl:ObjectProperty .
hpc:CpuFrequencyMinimum a owl:Class .
hpc:CpuFrequencyMinimum rdfs:subClassOf [ a owl:Restriction ;
                                           owl:onProperty hpc:cpu_frequency_minimum ;
                                           owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:cpu_frequency_minimum a owl:ObjectProperty .
hpc:NodeCount a owl:Class .
hpc:NodeCount rdfs:subClassOf [ a owl:Restriction ;
                                 owl:onProperty hpc:node_count ;
                                 owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:power a rdf:Property .
hpc:Deadline a owl:Class .
hpc:Deadline rdfs:subClassOf [ a owl:Restriction ;
                                owl:onProperty hpc:deadline ;
                                owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:deadline a owl:ObjectProperty .
hpc:MailType a rdf:List .
hpc:MailType rdfs:domain hpc:Job .
hpc:MemoryPerNode a owl:Class .
hpc:MemoryPerNode rdfs:subClassOf [ a owl:Restriction ;
                                     owl:onProperty hpc:memory_per_node ;
                                     owl:allValuesFrom [ rdf:type xsd:nonNegativeInteger ] ] .
hpc:memory_per_node a owl:Object
