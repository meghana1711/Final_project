hpc:Goal a owl:Class .
hpc:Guarantee rdf:type owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:timeWindow ;
    owl:hasValue "" ;
    owl:allValuesFrom xsd:string ;
    owl:cardinality 1 .

hpc:timewindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Goal ;
    rdfs:range xsd:string ;
    owl:hasValue "" ;
    owl:cardinality 1 ;
    owl:minCardinality 1 .

hpc:timeWindowValue a owl:Restriction ;
    owl:onProperty hpc:TimeWindow ;
    owl:hasValue "" ;
    owl:allValuesFrom xsd:time ;
    owl:cardinality 1 ;
    owl:onDatatype xsd:time .

hpc:Timewindowformat a owl:Class .
hpc:hastimewindowpart a owl:ObjectProperty ;
    rdfs:domain hpc:Timewindowvalue ;
    rdfs:range hpc:Timewindowpart .

hpc:Timewindowpart a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasTimeWindowPart ;
                        owl:hasValue "_" ;
                        owl:allValuesFrom xsd:string ;
                        owl:cardinality 1 ] ;
    owl:onProperty [ a owl:DatatypeProperty ;
                        rdf:type hpc:TimeWindowPart ;
                        rdfs:range xsd:string ] .

hpc:day a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindowpart ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:rangeMinimum 0 ;
    rdfs:rangeMaximum 6 .

hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindowpart ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:rangeMinimum 0 ;
    rdfs:rangeMaximum 23 .

hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindowpart ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:rangeMinimum 0 ;
    rdfs:rangeMaximum 59 .

hpc:maxhostidletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Goal ;
    rdfs:range xsd:nonNegativeInteger .
