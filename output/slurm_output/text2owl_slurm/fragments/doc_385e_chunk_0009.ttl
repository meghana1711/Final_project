hpc:Jobid a owl:Class .
hpc:Partitionname a owl:Class .
hpc:User a owl:Class .
hpc:st a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range xsd:string .
hpc:stime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range xsd:duration .
hpc:nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Nodelist a owl:Class ;
    rdfs:subClassOf hpc:Reason .
hpc:Reason a owl:Class .
hpc:Linux a owl:Class .
hpc:hasnode a owl:ObjectProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range hpc:Linux .
hpc:finished a owl:ObjectProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range hpc:Jobid .
hpc:running a owl:ObjectProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range hpc:Jobid .
hpc:increase a owl:ObjectProperty ;
    rdfs:domain hpc:Jobid ;
    rdfs:range hpc:Jobthroughput .
hpc:Jobthroughput a owl:Class .
hpc:Cluster a owl:Class .
hpc:wait a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Time .
hpc:efficiency a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
hpc:exclusive a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Boolean .
