hpc:Blusers a owl:Class .
hpc:Fodconf a owl:Class .
hpc:fodadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers ;
    rdfs:range hpc:Fodconf .

hpc:Fodapps a owl:Class .
hpc:Fodhosts a owl:Class .
hpc:Fodid a owl:Class .
hpc:fodhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers ;
    rdfs:range hpc:Fodhosts .

hpc:fodappsstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers ;
    rdfs:range xsd:string .

hpc:fodhostsstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers ;
    rdfs:range xsd:string .

hpc:fodidinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers ;
    rdfs:range xsd:string .

hpc:Taskman a owl:Class .
hpc:Lsflicensescheduler a owl:Class .
hpc:Lsflicenseschedulerconfig a owl:Class .
hpc:requiredsections a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsflicenseschedulerconfig ;
    rdfs:range xsd:string .

hpc:projectgroupoptional a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicenseschedulerconfig ;
    rdfs:range xsd:boolean .

hpc:clustermode a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicenseschedulerconfig ;
    rdfs:range xsd:boolean .

hpc:checkoutlicensetoken a owl:ObjectProperty ;
    rdfs:domain hpc:Taskman ;
    rdfs:range xsd:string .

hpc:manageinteractiveunixapps a owl:ObjectProperty ;
    rdfs:domain hpc:Taskman ;
    rdfs:range xsd:string .

hpc:Lsflicschedconfigchange a owl:Class .
hpc:reconfigureblddaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicschedconfigchange ;
    rdfs:range xsd:string .

hpc:restartmbatchddaemon a owl:ObjectProperty ;
