hpc:Gpurequirement a owl:Class .
hpc:gpumode a owl:ObjectProperty .
hpc:topologyrequirement a owl:ObjectProperty .
hpc:mergedresourcerequirement a owl:DatatypeProperty .
hpc:lsbSub4GpuReq a owl:ObjectProperty .
hpc:gpuReqMerge a owl:DatatypeProperty .
hpc:DefaultClusterGPURequirement a hpc:GPURequirement .
hpc:QueueGPURequirement a hpc:GPURequirement .
hpc:ApplicationProfileGPURequirement a hpc:GPURequirement .
hpc:JobLevelGPURequirement a hpc:GPURequirement .
hpc:ExclusiveProcessGPU a hpc:GPUMode .
hpc:SharedGPU a hpc:GPUMode .
hpc:ExclusiveProcessgpu rdfs:subClassOf hpc:Exclusiveprocessgpu .
hpc:SharedProcessgpu rdfs:subClassOf hpc:Sharedgpu .
hpc:Gpurequirement rdfs:subClassOf rdf:Resource .
hpc:Gpumode rdfs:domain hpc:Gpurequirement ;
                                rdfs:range hpc:Gpumode .
hpc:Topologyrequirement rdfs:domain hpc:Gpurequirement ;
                                rdfs:range rdf:Resource .
hpc:Mergedresourcerequirement rdfs:domain hpc:Gpurequirement ;
                                rdfs:range xsd:nonNegativeInteger .
hpc:LsbSub4GpuReq rdfs:domain hpc:Gpurequirement ;
                                rdfs:range rdf:Resource .
hpc:GpuReqMerge rdfs:domain hpc:Gpurequirement ;
                                rdfs:range xsd:string .
