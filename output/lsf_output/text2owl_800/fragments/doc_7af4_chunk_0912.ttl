hpc:distributionpolicyviolationaction a owl:ObjectProperty .
hpc:Reportingperiod rdfs:domain hpc:Distributionpolicyviolationaction ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Reportingcommand rdfs:domain hpc:Distributionpolicyviolationaction ;
                      rdfs:range xsd:string .
hpc:Distributionpolicyviolation a owl:Class .
hpc:WorkloadDistribution rdfs:subClassOf hpc:Distributionpolicyviolation .
hpc:DISTRIBUTION_POLICY_VIOLATION_ACTION rdfs:subPropertyOf hpc:DistributionPolicyViolationAction .
hpc:DemandLimit rdfs:subClassOf hpc:Distributionpolicyviolation .
hpc:DistributionPolicy a owl:Class .
hpc:projectMode rdfs:subPropertyOf hpc:DISTRIBUTION_POLICY_VIOLATION_ACTION .
