hpc:cpuTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:runJobFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:runTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:fairshareAdjustmentFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Adjustment ;
    rdfs:range xsd:decimal .

hpc:gpuRunTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:ngpusPhysical a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:historicalRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf hpc:run_time .

hpc:Job a owl:Class .
hpc:Adjustment a owl:Class .

hpc:fairshareAdjustment a owl:ObjectProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:Adjustment .

hpc:Lsb a owl:Class .
hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf hpc:Lsb .

hpc:Restarts rdfs:range xsd:integer ;
    rdfs:domain hpc:Mbatchd .

hpc:Reconfigurations rdfs:range xsd:integer ;
    rdfs:domain hpc:Mbatchd .

hpc:CleanedJobs rdfs:range xsd:integer ;
    rdfs:domain hpc:Mbatchd .

hpc:LsbParams a owl:Class .
hpc:LsbEvents a owl:Class .

hpc:CPU_TIME_FACTOR_DEFAULT a xsd:decimal .
hpc:RUN_JOB_FACTOR_DEFAULT a xsd:decimal .
hpc:RUN_TIME_FACTOR_DEFAULT a xsd:decimal .
hpc:FAIRSHARE_ADJUSTMENT_FACTOR_DEFAULT a xsd:decimal .
hpc:HIST_HOURS a xsd:integer .
hpc:CLEAN_PERIOD a xsd:integer .

hpc:Lsb a rdfs:subClassOf rdf:Resource .
hpc:Mbatchd a rdfs:subClassOf rdf:Resource .
hpc:Job a rdfs:subClassOf rdf:Resource .
hpc:Adjustment a rdfs:subClassOf rdf:Resource .
hpc:Scheduler a rdfs:subClassOf rdf:Resource .
hpc:LsbParams rdfs:subClassOf rdf:Resource
