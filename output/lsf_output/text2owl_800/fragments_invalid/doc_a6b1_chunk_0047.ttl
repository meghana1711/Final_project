hpc:Cluster a owl:Class .
hpc:clustername a owl:ObjectProperty .
hpc:Clustername rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Host a owl:Class .
hpc:hosttype a owl:ObjectProperty .
hpc:Hosttype rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource .
hpc:hostmodel a owl:ObjectProperty .
hpc:Hostmodel rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource .
hpc:Resource a owl:Class .
hpc:Cluster a rdfs:subClassOf hpc:Resource .
hpc:Queue a owl:Class .
hpc:queueName a owl:DatatypeProperty .
hpc:QueueName rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:priority a owl:DatatypeProperty .
hpc:Priority rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:stacklimit a owl:DatatypeProperty .
hpc:Stacklimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:description a owl:DatatypeProperty .
hpc:Description rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:qjobLimit a owl:DatatypeProperty .
hpc:QjobLimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:pjobLimit a owl:DatatypeProperty .
hpc:PjobLimit rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:ut a owl:DatatypeProperty .
hpc:Ut rdfs:domain hpc:Queue ;
    rdfs:range xsd:float .
hpc:io a owl:DatatypeProperty .
hpc:Io rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .
hpc:hosts a owl:ObjectProperty .
hpc:Hosts rdfs:domain hpc:Queue ;
    rdfs:range rdf:Resource .
hpc:nice a owl:DatatypeProperty .
hpc:Nice rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
