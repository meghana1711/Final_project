hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:User a owl:Class .
hpc:state a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submitTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:fileSize a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .
hpc:modified a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:dateTime .
hpc:Datahost a owl:Class .
hpc:Folder a owl:Class ;
    rdfs:subClassOf hpc:Datahost .
hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Datahost .
hpc:Tag a owl:Class .
hpc:propdatarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Datarequirement .
hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:File hpc:Tag) ] .
hpc:datasize a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .
hpc:datamodified a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:dateTime .
