hpc:PartitionInfo a owl:Class .
hpc:PartitionInfoMaximumsOversubscribe a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:PartitionInfoMinimums a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:PartitionInfoNodes a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:PartitionInfoQos a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:PartitionInfoTimeouts a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:PartitionInfoTres a owl:Class, rdfs:subClassOf [ hpc:PartitionInfo ] .
hpc:ProcessExitCodeVerboseSignal a owl:Class .
hpc:QosLimits a owl:Class, rdfs:subClassOf [ hpc:Qos ] .

hpc:MemoryPerCpu rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:int64 .

hpc:PartitionMemoryPerCpu rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:uint64 .

hpc:PartitionMemoryPerNode rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:uint64 .

hpc:Nodes rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfoNodes ;
    rdfs:range xsd:uint32 .

hpc:Shares rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:int32 .

hpc:Oversubscribe rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfoMaximumsOversubscribe ;
    rdfs:range xsd:int32 .

hpc:Time rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:uint32 .

hpc:OverTimeLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:PartitionInfo ;
    rdfs:range xsd:uint16 .

