hpc:Managementhost LIM a owl:Class .
hpc:hasipconfiguration a owl:ObjectProperty .
hpc:Ipconfiguration a owl:Class .
hpc:Ipv4address rdfs:domain hpc:Managementhost LIM ;
    rdfs:range xsd:string .
hpc:Ipv6address rdfs:domain hpc:Managementhost LIM ;
    rdfs:range xsd:string .
hpc:iscorrectlyconfigured a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipconfiguration ;
    rdfs:range xsd:boolean .
hpc:Userpermissiondeniederror a owl:Class .
hpc:Remoteexecution a owl:Class .
hpc:requiressecureuserid a owl:ObjectProperty .
hpc:secureuserid a owl:DatatypeProperty ;
    rdfs:domain hpc:Remoteexecution .
hpc:remoteexecutionlog a owl:ObjectProperty ;
    rdfs:domain hpc:Userpermissiondeniederror .
hpc:setuidbit a owl:ObjectProperty .
hpc:nosuidflag a owl:DatatypeProperty ;
    rdfs:domain hpc:Filesystem .
hpc:Inconsistenthostnames a owl:Class .
hpc:nameservermismatch a owl:ObjectProperty ;
    rdfs:domain hpc:Inconsistenthostnames .
