hpc:Processid a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Process IDs are assigned by the operating system, and LSB_JOBPIDS is set by sbatchd." .

hpc:lsbMailsize a owl:ObjectProperty ;
    rdfs:domain hpc:Processid ;
    rdfs:range xsd:integer ;
    rdfs:comment "Gives an estimate of the size of the batch job output when the output is sent by email." .

hpc:lsbMailsizeLimit a owl:ObjectProperty ;
    rdfs:domain hpc:Processid ;
    rdfs:range xsd:integer ;
    rdfs:comment "Explicitly sets the maximum size in kilobytes of the email containing the job information." .

hpc:lsbMailprog a owl:ObjectProperty ;
    rdfs:domain hpc:Processid ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Specifies the custom mail program to be called when the output is larger than desired." .

hpc:lsbMaxNumProcessors a owl:DatatypeProperty ;
    rdfs:domain hpc:Processid ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of processors requested when the job is submitted." .
