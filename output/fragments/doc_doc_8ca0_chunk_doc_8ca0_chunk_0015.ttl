hpc:Node a owl:Class .
hpc:Feature a owl:Class .
hpc:Helper a owl:Class .

hpc:hasFeature a owl:ObjectProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range rdf:List .

hpc:hasHelper a owl:ObjectProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range xsd:string .

hpc:isChangeableFeature a owl:ObjectProperty ;
  rdfs:domain hpc:Feature ;
  rdfs:range xsd:boolean .

hpc:isActiveFeature a owl:ObjectProperty ;
  rdfs:domain hpc:Node ;
  rdfs:range rdf:List .

hpc:isSelectableLabel a owl:ObjectProperty ;
  rdfs:domain hpc:Feature ;
  rdfs:range xsd:boolean .

hpc:CloudCluster a owl:Class ;
  rdfs:subClassOf hpc:Node .

hpc:OnPremiseCluster a owl:Class ;
  rdfs:subClassOf hpc:Node .

hpc:HybridCluster a owl:Class ;
  rdfs:subClass rdf:List ;
    rdf:first hpc:CloudCluster ;
    rdf:rest hpc:OnPremiseCluster .

hpc:Partition a owl:Class .
hpc:hasPartitionName a owl:ObjectProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:string .
hpc:hasMaxTime a owl:ObjectProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:duration .
hpc:hasNodes a owl:ObjectProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range rdf:List .
hpc:hasDefault a owl:ObjectProperty ;
  rdfs:domain hpc:Partition ;
  rdfs:range xsd:boolean .

hpc:SuspendablePartition a owl:Class ;
  rdfs:subClassOf hpc:Partition .

hpc:hasSuspendProgram a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range xsd:string .
hpc:hasResumeProgram a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range xsd:string .
hpc:hasSuspendTime a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range xsd:nonNegativeInteger .
hpc:hasSuspendExcNodes a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range rdf:List .
hpc:hasSuspendExcParts a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range rdf:List .
hpc:hasTreeWidth a owl:ObjectProperty ;
  rdfs:domain hpc:SuspendablePartition ;
  rdfs:range xsd:nonNegativeInteger .
```
