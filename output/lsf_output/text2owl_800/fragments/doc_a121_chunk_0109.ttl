hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A job that can be managed in a computing cluster." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A collection of jobs waiting to be processed in a computing cluster." .

hpc:requeuetobottom a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:comment "The property that indicates a job can be re-queued to the bottom of a queue." .

hpc:automaticrequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The property that indicates if a job is automatically re-queued." .

hpc:exclusiverequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The property that indicates if a failed job is not re-run on the same host." .

hpc:exitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The exit code of a job." .

hpc:exclusiveexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The exit code of a job that is excluded from exclusive re-queue." .

hpc:LSB_REQUEUE_TO_BOTTOM rdf:Datatype rdfs:Integer ;
    rdfs:comment "The configuration setting for re-queuing jobs to the bottom of a queue." .

hpc:LSB_REQUEUE_EXIT_VALUES rdf:Datatype rdfs:String ;
    rdfs:comment "The configuration setting for defining exit codes for automatic job re-queue." .

hpc:EXCLUDE rdf:Datatype rdfs:String ;
    rdfs:comment "The keyword used to define exit codes for exclusive job re-queue." .
