hpc:Node a owl:Class .
hpc:UsableNode a owl:Class, rdfs:subClassOf hpc:Node .
hpc:Idle a owl:Class, rdfs:subClassOf hpc:UsableNode .
hpc:Down a owl:Class, rdfs:subClassOf hpc:UsableNode .
hpc:Draining a owl:Class, rdfs:subClassOf hpc:UsableNode .
hpc:PoweredDown a owl:Class, rdfs:subClassOf hpc:UsableNode .

hpc:NodeSet a owl:Class .
hpc:NodeCount a owl:DatatypeProperty .
hpc:NodeSet rdfs:domain hpc:NodeSet .
hpc:NodeSet rdfs:range xsd:nonNegativeInteger .

hpc:ExcludedNodeSet a owl:Class, rdfs:subClassOf hpc:NodeSet .

hpc:Partition a owl:Class .
hpc:SuspendExcParts a owl:ObjectProperty .
hpc:Partition rdfs:domain hpc:Partition .
hpc:Partition rdfs:range rdf:List .

hpc:State a owl:Class .
hpc:SuspendExcStates a owl:ObjectProperty .
hpc:State rdfs:domain hpc:State .
hpc:State rdfs:range xsd:string .

hpc:SuspendTime a xsd:duration .
```
