hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf hpc:HasQOS ;
    rdfs:subClassOf hpc:HasAssociation ;
    rdfs:subClassOf hpc:HasWCKey ;
    rdfs:subClassOf hpc:HasLimits .

hpc:HasQOS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:QOS .

hpc:QOS a owl:Class .

hpc:HasAssociation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Association .

hpc:Association a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf hpc:HasCluster ;
    rdfs:subClassOf hpc:HasAccount ;
    rdfs:subClassOf hpc:HasUser ;
    rdfs:subClassOf (hpc:HasPartition as owl:ObjectProperty) ;
    rdfs:domain hpc:Association .

hpc:HasCluster rdf:type owl:ObjectProperty ;
    rdfs:range hpc:Cluster .

hpc:HasAccount rdf:type owl:ObjectProperty ;
    rdfs:range hpc:Account .

hpc:HasUser rdf:type owl:ObjectProperty ;
    rdfs:range hpc:User .

hpc:HasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range hpc:Partition .

hpc:HasWCKey rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:WCKey .

hpc:WCKey a owl:Class .

hpc:HasLimits rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Limits .

hpc:Limits a owl:Class ;
    rdfs:subClassOf hpc:HasTRESMinutes .

hpc:HasTRESMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Limits ;
    rdfs:range xsd:nonNegativeInteger .

hpc:safe a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:HasSafe .

hpc:HasSafe a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf rdf:type .

hpc:TrackWCKey a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf rdf:type .

hpc:sacctmgr a owl:Class .
hpc:sacctmgr rdf:type owl:ObjectProperty ;
    rdfs:domain
