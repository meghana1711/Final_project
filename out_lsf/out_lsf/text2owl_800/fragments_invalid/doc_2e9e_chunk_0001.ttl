hpc:Joblevelresourcerequirement a owl:Class .
hpc:bsubr a owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelresourcerequirement ;
    rdfs:range hpc:Resourcerequirement .
hpc:bmodr a owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelresourcerequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:orderclause a owl:ObjectProperty ;
    rdfs:domain hpc:Joblevelresourcerequirement .

hpc:Applicationlevelsection a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Queuelevelsection a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Schedulingcycle a owl:Class .

hpc:Candidatehost a owl:Class .

hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Candidatehost .
    rdfs:range xsd:nonNegativeInteger .

hpc:SCHED_PER_JOB_SORT a xsd:boolean .

hpc:Lsbparams a owl:Class .

hpc:badminmbdrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Lsbparams .

hpc:BadminReconﬁg a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Lsbparams .

hpc:Queue a owl:Class .
hpc:queueName a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:resReq a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Orderclause .
