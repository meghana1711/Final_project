hpc:Useraccountmapping a owl:Class .
hpc:lsfEauthUser a owl:ObjectProperty .
hpc:lsfEexecUser a owl:ObjectProperty .
hpc:lsbPrePostExecUser a owl:ObjectProperty .
hpc:Clusteradministrator a owl:Class .
hpc:clusterName a owl:DatatypeProperty .
hpc:administrators a owl:ObjectProperty .
hpc:lsfRootRex a owl:ObjectProperty .
hpc:lsfStartupUsers a owl:ObjectProperty .
hpc:lsfStartupPath a owl:DatatypeProperty .
hpc:Authorizationfailure a owl:Class .
hpc:UsuspState a owl:Class .
hpc:registerwindowspassword a owl:ObjectProperty .
hpc:bresume a owl:ObjectProperty .
hpc:findhostbyaddr a owl:ObjectProperty .
hpc:gethostbyaddr a owl:ObjectProperty .
hpc:ReconﬁgureDaemons a owl:ObjectProperty .
