hpc:Procedure a owl:Class .
hpc:Defaultproject a owl:Class .
hpc:Submitjob a owl:Class .
hpc:hasproject a owl:ObjectProperty .
hpc:hasdefaultproject a owl:ObjectProperty .
hpc:Rejectedjob a owl:Class .
hpc:strictchecking a owl:ObjectProperty .
hpc:Groupofprojects a owl:Class .
hpc:hasgroup a owl:ObjectProperty .
hpc:Preemptedjob a owl:Class .
hpc:licenses a owl:DatatypeProperty .
hpc:groupownership a owl:ObjectProperty .
hpc:preemption a owl:ObjectProperty .

hpc:Procedure rdfs:subClassOf owl:Class .
hpc:Defaultproject rdfs:subClassOf hpc:Procedure .
hpc:Submitjob rdfs:subClassOf hpc:Procedure .
hpc:Rejectedjob rdfs:subClassOf hpc:Submitjob .
hpc:Groupofprojects rdfs:subClassOf hpc:Procedure .

hpc:Hasproject rdfs:domain hpc:Submitjob ;
    rdfs:range hpc:Project .
hpc:Hasdefaultproject rdfs:domain hpc:Defaultproject ;
    rdfs:range hpc:Project .
hpc:Rejectedjob rdfs:domain hpc:Submitjob ;
    rdfs:range hpc:Rejectedjob .
hpc:Hasgroup rdfs:domain hpc:Groupofprojects ;
    rdfs:range hpc:Group .
hpc:Preemption rdfs:domain hpc:Preemptedjob ;
    rdfs:range hpc:Preemptionreason .

hpc:Licenses rdfs:domain hpc:Procedure ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Groupownership rdfs:domain hpc:Groupofprojects ;
    rdfs:range hpc:Project .

hpc:Preemptionreason a owl:Class .
