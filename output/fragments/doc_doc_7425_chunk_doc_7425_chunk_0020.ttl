hpc:OpenapiPlugin a owl:Class .
hpc:DeprecatedPlugin rdf:type owl:Class ;
    rdfs:subClassOf hpc:OpenapiPlugin .

hpc:RemovedPlugin rdf:type owl:Class ;
    rdfs:subClassOf hpc:OpenapiPlugin .

hpc:NewPlugin rdf:type owl:Class ;
    rdfs:subClassOf hpc:OpenapiPlugin .

hpc:OpenapiVersion a owl:Class .
hpc:JobStateSchema a owl:Class .
hpc:Endpoint a owl:Class .
hpc:JobInfo a owl:Class .

hpc:hasVersion a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range xsd:string .

hpc:hasSchema a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range hpc:JobStateSchema .

hpc:hasEndpoint a owl:ObjectProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range hpc:Endpoint .

hpc:hasJobInfo a owl:ObjectProperty ;
    rdfs:domain hpc:Endpoint ;
    rdfs:range hpc:JobInfo .

hpc:isDeprecated a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range xsd:boolean .

hpc:isRemoved a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range xsd:boolean .

hpc:isNew a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiPlugin ;
    rdfs:range xsd:boolean .

hpc:hasStateSchema a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStateSchema ;
    rdfs:range xsd:string .

hpc:hasPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Endpoint ;
    rdfs:range xsd:string .

hpc:hasSchemaForJobStatesQuery a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStateSchema ;
    rdfs:range xsd:string .

hpc:hasKillJobsResponseSchema a owl:DatatypeProperty ;
    rdfs:domain hpc:Endpoint ;
    rdfs:range hpc:JobStateSchema .

hpc:hasKillJobsMessageSchema a owl:DatatypeProperty ;
    rdfs:domain hpc:Endpoint ;
    rdfs:range hpc:JobStateSchema .

hpc:hasKillJobsResponseMessageSchema a owl:DatatypeProperty ;
    rdfs:domain hpc:Endpoint ;
    rdfs:range hpc:JobStateSchema .

hpc:hasJobExitCodeProperty a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .

hpc:hasDerivedExitCodeProperty a owl:DatatypeProperty ;
    rdfs:domain hpc:JobInfo ;
    rdfs:range xsd:string .
