hpc:Gpuresourcerequirement a owl:Class .

hpc:numgpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:mode a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range hpc:Gpumode .

hpc:Gpumode a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:SharedGPUMode hpc:ExclusiveProcessGPUMode) ] .

hpc:Sharedgpumode a owl:Class .
hpc:Exclusiveprocessgpumode a owl:Class .

hpc:mps a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range hpc:Gpumemorypolicy .

hpc:Gpumemorypolicy a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:YesMPS hpc:NoMPS hpc:PerSocketMPS hpc:PerGPUMPS) ] .

hpc:Yesmps a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:YesSharedMPS hpc:YesSharedNoCVDMPS hpc:YesNoCVDMPS) ] .
hpc:Yessharedmps a owl:Class .
hpc:Yessharednocvdmps a owl:Class .
hpc:Yesnocvdmps a owl:Class .

hpc:Nomps a owl:Class .
hpc:Persocketmps a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:PerSocketSharedMPS hpc:PerSocketNoCVDMPS) ] .
hpc:Persocketsharedmps a owl:Class .
hpc:Persocketnocvdmps a owl:Class .

hpc:Pergpumps a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:unionOf (hpc:PerGPUSharedMPS hpc:PerGPUNoCVDMPS) ] .
hpc:Pergpusharedmps a owl:Class .
hpc:Pergpunocvdmps a owl:Class .

hpc:aff a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:boolean .

hpc:jExclusive a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:boolean .

hpc:block a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:boolean .

hpc:glink a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuresourcerequirement ;
    rdfs:range xsd:boolean .

hpc:gpack a owl:ObjectProperty ;
    rdfs:domain
