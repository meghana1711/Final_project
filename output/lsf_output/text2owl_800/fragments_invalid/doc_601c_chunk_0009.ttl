hpc:ModSslmodule a owl:Class .
hpc:installoperation a owl:ObjectProperty .
hpc:Apachehttpserverinstallation a owl:Class .
hpc:Apachehttpserverinstallation rdfs:subClassOf hpc:Apachehttpserver .
hpc:Apachehttpserverinstallation rdfs:subClassOf rdf:Resource .
hpc:Apachehttpserverinstallation hpc:installoperation some rdf:Description ;
    rdf:type rdf:Description ;
    rdf:subject hpc:ApacheHTTPServer ;
    rdf:predicate rdf:type ;
    rdf:object xsd:string ;
    rdf:first hpc:mod_sslModule .

hpc:File a owl:Class .
hpc:certfile a owl:DatatypeProperty .
hpc:keyfile a owl:DatatypeProperty .
hpc:cacertfile a owl:DatatypeProperty .
hpc:File rdfs:domain hpc:Apachehttpserverinstallation .
hpc:File rdfs:range xsd:string .
hpc:Certfile rdfs:domain hpc:Apachehttpserverinstallation .
hpc:Certfile rdfs:range xsd:string .
hpc:Keyfile rdfs:domain hpc:Apachehttpserverinstallation .
hpc:Keyfile rdfs:range xsd:string .
hpc:Cacertfile rdfs:domain hpc:Apachehttpserverinstallation .
hpc:Cacertfile rdfs:range xsd:string .

hpc:Apachehttpserverconfiguration a owl:Class .
hpc:disablehttp a owl:ObjectProperty .
hpc:enablehttps a owl:ObjectProperty .
hpc:addproxysettings a owl:ObjectProperty .
hpc:Apachehttpserverconfiguration rdfs:subClassOf hpc:Apachehttpserverinstallation .
hpc:Apachehttpserverconfiguration rdfs:subClassOf rdf:Resource .
hpc:Apachehttpserverconfiguration hpc:disablehttp some rdf:Description ;
    rdf:type rdf:Description ;
    rdf:subject hpc:ApacheHTTPServerConfiguration ;
    rdf:predicate rdf:type ;
    rdf:object xsd:boolean ;
    rdf:first hpc:Listen80http .
hpc:Apachehttpserverconfiguration hpc:enablehttps some rdf:Description ;
    rdf:type rdf:Description ;
    rdf:subject hpc:ApacheHTTPServerConfiguration ;
    rdf:predicate rdf:type ;
    rdf:object xsd:boolean ;
    rdf:first hpc:Listen443https .
hpc:Apachehttpserverconfiguration hpc:addproxysettings some rdf:Description ;
    rdf:type rdf:Description ;
    rdf:subject hpc:ApacheHTTPServerConfiguration ;
    rdf:predicate rdf:type ;
    rdf:object hpc:ApacheHTTPServerProxySettings .

hpc:Apachehttpserverproxysettings a owl:Class .
hpc:proxyrequestsoff a owl:ObjectProperty .
hpc:proxypreservehost a owl:ObjectProperty .
hpc:balancermember a owl:ObjectProperty .
