hpc:Datafile a owl:Class ;
    rdfs:subClassOf hpc:Stageddata .

hpc:Folder a owl:Class ;
    rdfs:subClassOf hpc:Stageddata .

hpc:Datatag a owl:Class ;
    rdfs:subClassOf hpc:Stageddata .

hpc:Stageddata a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Stageddata ;
    rdfs:range xsd:string .

hpc:hastag a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range xsd:string .

hpc:istransferred a owl:ObjectProperty ;
    rdfs:domain hpc:Stageddata ;
    rdfs:range xsd:boolean .

hpc:hasstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Stageddata ;
    rdfs:range xsd:string .

hpc:Cacheaccesscontrol a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:requirescacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Cacheaccesscontrol .

hpc:Command a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:requiresowner a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Stageddata .

hpc:changegroupout a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Stageddata .

hpc:changegroupin a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Datatag .

hpc:settoplevelfolderpermissions a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:integer .

hpc:setotherdirectorypermissions a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:integer .

hpc:isintransferredoridlestate a owl:ObjectProperty ;
    rdfs:domain hpc:Stageddata ;
    rdfs:range xsd:boolean .

hpc:isrecursive a owl:DatatypeProperty ;
    rdfs:domain hpc:Folder ;
    rdfs:range xsd:boolean .

hpc:hasdatafilepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:hasdatafolderpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Folder ;
    rdfs:range xsd:string .

hpc:hastagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatag ;
    rdfs:range xsd:string .

