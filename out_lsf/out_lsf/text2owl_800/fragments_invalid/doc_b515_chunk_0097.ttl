hpc:Host a owl:Class .
hpc:Processor a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Processor .
hpc:Thread a owl:Class ;
    rdfs:subClassOf hpc:Core .
hpc:Job a owl:Class .
hpc:pctlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Submittedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Boundjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:boundtocore a owl:ObjectProperty ;
    rdfs:domain hpc:Boundjob ;
    rdfs:range hpc:Core .
hpc:boundtoprocessor a owl:ObjectProperty ;
    rdfs:domain hpc:Boundjob ;
    rdfs:range hpc:Processor .
hpc:hasmaxjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:hasminjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:parallelschedulebyslot a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:bindjob a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:pack a owl:ObjectProperty ;
    rdfs:domain hpc:Bindjob ;
    rdfs:range xsd:boolean .
hpc:balance a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:PCTLevel_core rdf:type hpc:PCTLevel ;
hpc:PCTLevel_thread rdf:type hpc:PCTLevel .
