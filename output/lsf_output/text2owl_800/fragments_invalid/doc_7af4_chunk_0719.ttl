hpc:Job a owl:Class .
hpc:Tgt a owl:Class .
hpc:Environmentvariable a owl:Class .
hpc:krb5ccname a owl:ObjectProperty .
hpc:TGTFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tgt ;
    rdfs:range xsd:string .
hpc:JobLogFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:MBatchdInfoDirectory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:lsbKrbTgtDir a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:string .
hpc:LSF_KRB_TGT_DIR_SymbolicLinkName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbKrbTgtDir ;
    rdfs:range xsd:string .
hpc:DefaultNotDefined rdf:type owl:NamedIndividual ;
    hpc:LSB_KRB_TGT_DIR rdf:value "" .
hpc:lsbLocaldir a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:string .
hpc:EnablesDuplicateLogging rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsbLocaldir ;
    rdfs:range xsd:boolean .
