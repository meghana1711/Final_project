hpc:JobName
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the job." .

hpc:JobArrayIndex
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The index of a job in an array." .

hpc:HostOrHostGroup
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "Represents a host or a host group in the HPC system." .

hpc:Queue
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "Represents a queue in the HPC system." .

hpc:ServiceClass
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "Represents a service class in the HPC system." .

hpc:UserOrUserGroup
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "Represents a user or a user group in the HPC system." .

hpc:SuspendJob
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Job ;
    rdfs:comment "Suspends the specified job." .

hpc:CommandUsage
    a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:String ;
    rdfs:comment "Prints command usage to stderr and exits." .
