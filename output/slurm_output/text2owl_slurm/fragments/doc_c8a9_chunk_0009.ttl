hpc:Cluster a owl:Class .
hpc:Partition a owl:Class .

hpc:haspartition a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Partition .

hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .

hpc:hasnodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasprioritytier a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Isactive a owl:Class ;
    rdfs:subClassOf hpc:Partition .

hpc:Isdefault a owl:Class ;
    rdfs:subClassOf hpc:Partition .

hpc:Ishighpriority a owl:Class ;
    rdfs:subClassOf hpc:Partition .

# Job ontology

hpc:Job a owl:Class .

hpc:haspartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .

hpc:haspreemptmode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Isrunning a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hasstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hastime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .

hpc:hasnodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasnodelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

# Backfill Scheduling ontology

hpc:Backfillcycle a owl:Class .

hpc:reserveswholenodes a owl:ObjectProperty ;
    rdfs:domain hpc:Backfillcycle ;
    rdfs:range hpc:Job .
