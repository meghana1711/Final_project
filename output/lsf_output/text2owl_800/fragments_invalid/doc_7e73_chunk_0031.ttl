hpc:Ec2instance a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Pingablehost a owl:Class .
hpc:Dynamichost a owl:Class .
hpc:Clustermember a owl:Class .
hpc:HasIPAddress an owl:ObjectProperty ;
    rdfs:domain hpc:Pingablehost ;
    rdfs:range xsd:string .
hpc:CanPing an owl:ObjectProperty ;
    rdfs:domain hpc:Pingablehost ;
    rdfs:range hpc:Pingablehost .
hpc:HasName an owl:ObjectProperty ;
    rdfs:domain hpc:Pingablehost ;
    rdfs:range xsd:string .
hpc:IsInCluster rdfs:subPropertyOf hpc:CanPing ;
    rdfs:domain hpc:Pingablehost ;
    rdfs:range hpc:Clustermember .
hpc:HasStatus an owl:DatatypeProperty ;
    rdfs:domain hpc:Clustermember ;
    rdfs:range xsd:string .
hpc:HasEnvironmentSettings an owl:ObjectProperty ;
    rdfs:domain hpc:Pingablehost ;
    rdfs:range hpc:Environmentsettings .
hpc:VPNSetting an owl:Class ;
    rdfs:subClassOf hpc:Environmentsetting .
hpc:FirewallSetting an owl:Class ;
    rdfs:subClassOf hpc:Environmentsetting .
hpc:SecurityGroupSetting an owl:Class ;
    rdfs:subClassOf hpc:Environmentsetting .
hpc:AMI an owl:Class .
hpc:AWSProvTemplate an owl:Class .
hpc:UsesAMI rdfs:subPropertyOf rdf:type ;
    rdfs:domain hpc:Awsprovtemplate ;
    rdfs:range hpc:Ami .
