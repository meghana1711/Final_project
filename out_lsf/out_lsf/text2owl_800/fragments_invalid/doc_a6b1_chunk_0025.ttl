hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Hpcresource ;
    rdfs:comment "Represents a job in LSF." .

hpc:Jobterminationreason a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:comment "Enumeration of job termination reasons reported by LSF." .

hpc:RunLimitExceeded a hpc:JobTerminationReason ;
    rdfs:comment "Job was terminated due to reaching LSF run time limit." .

hpc:Exit a hpc:JobTerminationReason ;
    rdfs:comment "Job completed normally or exited." .

hpc:NodeFailure a hpc:JobTerminationReason ;
    rdfs:comment "Job was terminated due to node failure." .

hpc:SignalTermination a hpc:JobTerminationReason ;
    rdfs:comment "Job was terminated by a signal from LSF, the operating system, or an application." .

hpc:hasjobterminationreason hpc:job a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobterminationreason ;
    rdfs:comment "The reason why a job terminated." .

hpc:hasexitinformation hpc:job a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Exitinformation ;
    rdfs:comment "The exit information logged for a job." .

hpc:Exitinformation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the exit information logged for a job." .

hpc:submittedby a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who submitted the job." .

hpc:project a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The project associated with the job." .

hpc:status a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of the job (e.g., EXIT)." .

hpc:queue a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The queue the job was submitted to." .

hpc:command a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The command executed by the job." .

hpc:host a hpc:exitinformation a owl:DatatypeProperty ;
    rdfs:domain hpc:Exitinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The host the job was executed on." .
