hpc:Windowsuseraccount a owl:Class .
hpc:Lsf a owl:Class .
hpc:Password a owl:Class ;
    rdfs:subClassOf hpc:Encrypteddata .

hpc:haspassword a owl:ObjectProperty ;
    rdfs:domain hpc:Windowsuseraccount ;
    rdfs:range hpc:Password .

hpc:Lsfdatabase a owl:Class .
hpc:protectswithfileaccesspermissions a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatabase .

hpc:lsfjobstart a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Windowsuseraccount .

hpc:windowsuseraccountpassword a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdatabase ;
    rdfs:range xsd:string .

hpc:updatepasswordonwindowschange a owl:ObjectProperty .

hpc:Unixplatform a owl:Class .
hpc:doublequotationmarkusage a owl:ObjectProperty ;
    rdfs:domain hpc:Unixplatform .

hpc:doublebackslashusage a owl:ObjectProperty ;
    rdfs:domain hpc:Unixplatform .

hpc:lspasswdcommandusage a owl:ObjectProperty .

hpc:unixplatform\lspasswdCommand a owl:ObjectProperty ;
    rdfs:domain hpc:Unixplatform .
    rdfs:range hpc:Lspasswdcommandusage .

hpc:"-u" a owl:ObjectProperty ;
    rdfs:domain hpc:Unixplatform\lspasswdCommandUsage ;
    rdfs:range xsd:string .

hpc:"-p" a owl:ObjectProperty .

hpc:"-t" a owl:ObjectProperty ;
    rdfs:domain hpc:Unixplatform\lspasswdCommandUsage ;
    rdfs:range xsd:string .

hpc:checkpasswordvalidity a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
    rdfs:range hpc:Windowsuseraccount .

hpc:Windowsserverhosttype a owl:Class .
hpc:customizedhosttype a owl:ObjectProperty ;
    rdfs:domain hpc:Windowsserverhosttype .
    rdfs:range hpc:Windowsserverhosttype .

hpc:specifiedhosttype a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpasswordvalidity .
    rdfs:range hpc:Windowsserverhosttype .

hpc:executionhosttype a owl:ObjectProperty ;
    rdfs:domain hpc:Specifiedhosttype .
    rdfs:range xsd:string .
