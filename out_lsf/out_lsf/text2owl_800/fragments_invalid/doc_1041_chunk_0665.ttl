hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Computeunit a owl:Class .
hpc:schedule a owl:ObjectProperty .
hpc:notify a owl:ObjectProperty .
hpc:mig a owl:DatatypeProperty .
hpc:synopsis a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:categories a owl:ObjectProperty .
hpc:conflictingoptions a owl:ObjectProperty .

hpc:Host subClassOf rdf:Resource .
hpc:HostGroup subClassOf rdf:Resource .
hpc:ComputeUnit subClassOf rdf:Resource .

hpc:Schedule rdfs:domain hpc:Job .
hpc:Notify rdfs:domain hpc:Job .
hpc:Mig rdfs:domain hpc:Job .
hpc:Synopsis rdfs:range xsd:string .
hpc:Description rdfs:range xsd:string .
hpc:Categories rdfs:range hpc:Category .
hpc:Conflictingoptions rdfs:range hpc:Option .

hpc:hasHost rdf:type owl:ObjectProperty .
hpc:hasComputeUnit rdf:type owl:ObjectProperty .
hpc:hasMigrationThreshold rdf:type owl:DatatypeProperty .
hpc:hasSynopsis rdf:type owl:DatatypeProperty .
hpc:hasDescription rdf:type owl:DatatypeProperty .
hpc:hasCategory rdf:type owl:ObjectProperty .
hpc:hasConflictingOption rdf:type owl:ObjectProperty .

hpc:Job a owl:Class .
hpc:Category a owl:Class .
hpc:Option a owl:Class .
