# Job Execution
hpc:Job a owl:Class .
hpc:CyclicJob a owl:Class, rdfs:subClassOf hpc:Job .
hpc:PlaneJob a owl:Class, rdfs:subClassOf hpc:Job .

hpc:cpuBind a owl:ObjectProperty .
hpc:mem a owl:DatatypeProperty .
hpc:plane a owl:DatatypeProperty .

hpc:CyclicJob rdfs:domain hpc:Job .
hpc:cpuBind rdfs:domain hpc:CyclicJob ;
    rdfs:range xsd:string .
hpc:mem rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:plane rdfs:domain hpc:PlaneJob ;
    rdfs:range xsd:nonNegativeInteger .

# Memory as a Consumable Resource
hpc:MemoryConsumableResource a owl:Class .
hpc:MemoryConsumableJob a owl:Class, rdfs:subClassOf hpc:Job .
hpc:SelectType a owl:Class .
hpc:SelectTypeParameters a owl:DatatypeProperty .

hpc:SelectType rdfs:domain hpc:MemoryConsumableResource ;
    rdfs:range hpc:SelectType .
hpc:SelectTypeParameters rdfs:domain hpc:SelectType ;
    rdfs:range xsd:string .

hpc:CR_Memory a hpc:SelectTypeParameters .

# Task Invocation
hpc:TaskInvocation a owl:Class .
hpc:TaskPerNode a owl:DatatypeProperty .
hpc:TaskPerSocket a owl:DatatypeProperty .
hpc:TaskPerCore a owl:DatatypeProperty .

hpc:TaskInvocation rdfs:domain hpc:Job .
hpc:TaskPerNode rdfs:domain hpc:TaskInvocation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:TaskPerSocket rdfs:domain hpc:TaskInvocation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:TaskPerCore rdfs:domain hpc:TaskInvocation ;
    rdfs:range xsd:nonNegativeInteger .
```
