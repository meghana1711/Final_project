hpc:Cluster a owl:Class .
hpc:Managementhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Candidatemanagementhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Partitionedcluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster .
hpc:Partitionednetwork a owl:Class ;
    rdfs:subClassOf hpc:Partitionedcluster .
hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:RunningJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:ExitedJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:RerunnableJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:PendingJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:lsbeventsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost .
hpc:lockfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
hpc:Jobexception a owl:Class .
hpc:JobExceptionHandling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Jobexception .
hpc:ConfiguredException rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobexception ;
    rdfs:range xsd:integer .
hpc:Authenticateduser a owl:Class .
hpc:AssignedRole rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Authenticateduser .
hpc:Password rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Authenticateduser .
hpc:Lsfsecuritymodel a owl:Class .
hpc:Useraccount a owl:Class ;
    rdfs:subClassOf hpc:Authenticateduser .
