hpc:Cluster a owl:Class .
hpc:Datatransferhost a owl:Class .
hpc:Executionhost a owl:Class .
hpc:hasstagingarea a owl:ObjectProperty .
hpc:mountedstagingarea a owl:DatatypeProperty .
hpc:Datatransferqueue a owl:Class .
hpc:datastagein a owl:ObjectProperty .
hpc:datastageout a owl:ObjectProperty .
hpc:Datatransfer a owl:Class .
hpc:datatransfertool a owl:ObjectProperty .
hpc:datasourcelocation a owl:DatatypeProperty .
hpc:datadestinationlocation a owl:DatatypeProperty .
hpc:Lsbqueuesfile a owl:Class .
hpc:hasdatatransferhosts a owl:ObjectProperty .
hpc:hasdatatransferqueue a owl:ObjectProperty .
hpc:Datatransferhost rdfs:subClassOf hpc:Executionhost .
hpc:Datatransferqueue rdfs:subClassOf hpc:Cluster .
hpc:Datatransfer rdfs:domain hpc:Datatransferqueue ;
    rdfs:range hpc:Datastagein, hpc:Datastageout .
hpc:Datatransferhost rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Datatransfer .
hpc:Hasstagingarea rdfs:domain hpc:Datatransferhost ;
    rdfs:range xsd:string .
hpc:Mountedstagingarea rdfs:domain hpc:Datatransferhost ;
    rdfs:range xsd:string .
hpc:Datastagein rdfs:domain hpc:Datatransfer ;
    rdfs:range xsd:string .
hpc:Datastageout rdfs:domain hpc:Datatransfer ;
    rdfs:range xsd:string .
hpc:Datatransfertool rdfs:domain hpc:Datatransferhost ;
    rdfs:range xsd:string .
hpc:Datasourcelocation rdfs:domain hpc:Datastagein ;
    rdfs:range xsd:string .
hpc:Datadestinationlocation rdfs:domain hpc:Datastageout ;
    rdfs:range xsd:string .
hpc:Hasdatatransferhosts rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:string .
hpc:Hasdatatransferqueue rdfs:domain hpc:Lsbqueuesfile ;
    rdfs:range xsd:string .
