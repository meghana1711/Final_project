hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Status a owl:Class .
hpc:Queue a owl:Class .
hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:cwd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:executioncwd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:combinedcpufrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:specifiedcpufrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:requestedgpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonPositiveInteger .
hpc:combinedgpurequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:effectivegpurequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:esub a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .
hpc:esubscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Esub ;
    rdfs:range rdf:Literal .
hpc:energyusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:EnergyUsageUnit a xsd:string ;
    rdfs:range "Joule" .
hpc:EnergyUsageEnergyUnit a xsd:string ;
    rdfs:range "kWh" .
hpc:Job a rdfs:subClassOf hpc:Resourceallocation .
