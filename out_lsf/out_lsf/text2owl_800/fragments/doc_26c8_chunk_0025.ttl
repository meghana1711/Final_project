hpc:Policy a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "The name of the policy." .

hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Policy ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the policy." .

hpc:Consumer a owl:Class ;
    rdfs:subClassOf hpc:Policyattribute ;
    rdfs:comment "The following consumer attributes are supported:" .

hpc:rcaccount a owl:ObjectProperty ;
    rdfs:domain hpc:Consumer ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of accounts that can borrow hosts through LSF resource connector." .

hpc:Supportedvalues a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Valuelist ;
    rdfs:comment "Supported values are all or any valid account name that is defined in the RC_ACCOUNT tag in the lsb.queues file." .

hpc:all a hpc:supportedValues ;
    rdfs:comment "All valid account names." .

hpc:templatename a owl:ObjectProperty ;
    rdfs:domain hpc:Consumer ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of template names." .

hpc:all a hpc:supportedValues ;
    rdfs:comment "All valid template names." .

hpc:provider a owl:ObjectProperty ;
    rdfs:domain hpc:Consumer ;
    rdfs:range xsd:string ;
    rdfs:comment "A list of resource provider names." .

hpc:wh a hpc:supportedValues ;
    rdfs:comment "All valid provider names." .
