@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Localclusterjob hpc:Configurationfileparameter a owl:Class ;
  rdfs:subClassOf hpc:Configurationfileparameter ;
  rdfs:comment "Controls the maximum number of times to attempt the pre-execution command of a job on the local cluster." .

hpc:localmaxpreexecretry hpc:configurationfileparameterproperty a owl:ObjectProperty ;
  rdfs:domain hpc:Localclusterjob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Specify an integer greater than 0. By default, the number of retries is unlimited." .

hpc:Remoteclusterjob hpc:Configurationfileparameter a owl:Class ;
  rdfs:subClassOf hpc:Configurationfileparameter ;
  rdfs:comment "Controls the maximum number of times to attempt the pre-execution command of a job on the remote cluster." .

hpc:remotemaxpreexecretry hpc:configurationfileparameterproperty a owl:ObjectProperty ;
  rdfs:domain hpc:Remoteclusterjob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Specify an integer greater than 0. By default, the number of retries is 5." .

hpc:Remotemaxpreexecretry hpc:localmaxpreexecretry rdfs:equivalentProperty .

hpc:Localqueuejob hpc:Configurationfileparameter a owl:Class ;
  rdfs:subClassOf hpc:Configurationfileparameter ;
  rdfs:comment "Controls the maximum number of times to attempt the pre-execution command of a job on the local cluster." .

hpc:localmaxpreexecretry hpc:configurationfileparameterproperty a owl:ObjectProperty ;
  rdfs:domain hpc:Localqueuejob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Specify an integer greater than 0. By default, the number of retries is unlimited." .

hpc:remotemaxpreexecretry hpc:configurationfileparameterproperty a owl:ObjectProperty ;
  rdfs:domain hpc:Remotequeuejob ;
  rdfs:range xsd:integer ;
  rdfs:comment "Specify an integer greater than 0. By default, the number of retries is 5." .

hpc:Remotemaxpreexecretry hpc:localmaxpreexecretry rdfs:equivalentProperty .

hpc:Localapplicationjob hpc:Configurationfileparameter a owl:Class ;
  rdfs:subClassOf hpc:Configurationfileparameter ;
  rdfs:comment "Controls the maximum number of times to attempt the pre-execution command of a job on the local cluster." .

