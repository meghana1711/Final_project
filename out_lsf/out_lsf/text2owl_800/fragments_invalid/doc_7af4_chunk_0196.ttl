hpc:Eligiblejob a owl:Class .
hpc:Ineligiblejob a owl:Class .
hpc:Joblimit a owl:Class .
hpc:Joblimittype a owl:Class .

hpc:hasIneligibleState owl:datatype xsd:string .
hpc:hasJobLimitType rdf:datatype xsd:string .
hpc:jobLimitValue xsd:positiveInteger .

hpc:Eligiblejob rdfs:subClassOf hpc:Job .
hpc:Ineligiblejob rdfs:subClassOf hpc:Job .
hpc:Joblimit rdfs:subClassOf hpc:Joblimittype .

hpc:Joblimittype rdfs:subClassOf owl:Class .
hpc:Eligiblejob rdfs:subClassOf owl:Class .
hpc:Ineligiblejob rdfs:subClassOf owl:Class .
hpc:Job rdfs:subClassOf owl:Class .

hpc:Hasineligiblestate rdfs:domain hpc:Ineligiblejob ;
                          rdfs:range xsd:string .
hpc:Hasjoblimittype rdfs:domain hpc:Joblimit ;
                     rdfs:range xsd:string .
hpc:Joblimitvalue rdfs:domain hpc:Joblimit ;
                   rdfs:range xsd:positiveInteger .
