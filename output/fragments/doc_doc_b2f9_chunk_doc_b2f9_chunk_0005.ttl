hpc:GPU a owl:Class .
hpc:Type rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range xsd:string .

hpc:File rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU .

hpc:Cores rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:Name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:AutoDetect rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:Link rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range xsd:string .

hpc:Count rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:MPS .

hpc:TypeName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range xsd:string .

hpc:SubstringMatch a owl:ObjectProperty ;
    rdfs:domain hpc:TypeName ;
    rdfs:range xsd:string .

hpc:UpTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:NodeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:AccountingStorageTRES rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GPU .

hpc:Gres rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:GPU .

hpc:GresCountOnly a owl:ObjectProperty ;
    rdfs:subClassOf hpc:AccountingStorageTRES ;
    rdfs:domain hpc:Gres .

hpc:GresMem rdf:type owl:DatatypeProperty ;
    rdfs:subClassOf hpc:AccountingStorageTRES ;
    rdfs:domain hpc:Gres .

hpc:GresUtil rdf:type owl:DatatypeProperty ;
    rdfs:subClassOf hpc:AccountingStorageTRES ;
    rdfs:domain hpc:Gres .
