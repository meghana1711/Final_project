hpc:Projectgroup a owl:Class .
hpc:Licensefeature a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Groupprojectshare a owl:Class .
hpc:Projectmode a owl:Class .
hpc:activeownership a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range hpc:Projectgroup .
hpc:defaultproject a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range hpc:Projectgroup .
hpc:shareinfofor a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string .
hpc:Group a owl:Class ;
    rdfs:subClassOf hpc:Projectgroup .
hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Projectgroup .
hpc:Feature a owl:Class .
hpc:own a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupprojectshare ;
    rdfs:range xsd:decimal .
hpc:inuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupprojectshare ;
    rdfs:range xsd:decimal .
hpc:reserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupprojectshare ;
    rdfs:range xsd:decimal .
hpc:free a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupprojectshare ;
    rdfs:range xsd:decimal .
hpc:demand a owl:DatatypeProperty ;
    rdfs:domain hpc:Groupprojectshare ;
    rdfs:range xsd:decimal .
