hpc:Job a owl:Class .
hpc:Project rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Applicationprofile rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:cpuTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .
hpc:jobRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .
hpc:averageEfficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .
hpc:cpuAverageEfficiency a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Averageefficiency .
hpc:cpuPeakEfficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .
hpc:cpuPeak a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .
hpc:cpuRequested a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:double .

hpc:Timesummary a owl:Class .
hpc:waitingTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timesummary ;
    rdfs:range xsd:double .
hpc:userSuspendedTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timesummary ;
    rdfs:range xsd:double .
hpc:Run a owl:Class ;
    rdfs:subClassOf hpc:Timesummary .
hpc:runTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Run ;
    rdfs:range xsd:double .
hpc:userSuspendedRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Run ;
    rdfs:range xsd:double .
hpc:systemSuspendedRunTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Run ;
    rdfs:range xsd:double .
hpc:unknown a owl:DatatypeProperty ;
    rdfs:domain hpc:Timesummary ;
    rdfs:range xsd:double .
hpc:total a owl:DatatypeProperty ;
    rdfs:domain hpc:Timesummary ;
    rdfs:range xsd:double .

hpc:Longformat a owl:Class .
hpc:Project rdfs:domain hpc:Longformat ;
    rdfs:range rdf:Resource .
hpc:ApplicationProfile rdfs:domain hpc:Longformat ;
    rdfs:range rdf:Resource .
