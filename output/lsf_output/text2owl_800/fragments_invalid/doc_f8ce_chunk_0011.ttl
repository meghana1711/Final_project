@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Workdirectory a owl:Class.
hpc:JobID rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Workdirectory;
    rdfs:range xsd:string.
hpc:DataInformationFile rdf:type owl:Class;
    rdfs:subClassOf hpc:Workdirectory.
hpc:JobArray rdf:type owl:Class;
    rdfs:subClassOf hpc:Workdirectory.
hpc:ArrayElement rdf:type owl:Class;
    rdfs:subClassOf hpc:Workdirectory.
hpc:DataTag rdf:type owl:Class.
