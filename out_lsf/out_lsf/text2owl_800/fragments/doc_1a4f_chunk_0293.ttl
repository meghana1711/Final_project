hpc:Host a owl:Class .
hpc:Queue a owl:Class .

hpc:suspendingcondition a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:Job a owl:Class .

hpc:suspendaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:suspendsignal a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:suspendedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:resumeevent a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:Checkpointablejob a owl:Class .
hpc:Rerunnablejob a owl:Class .

hpc:migrateonsuspend a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:schedulingthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:suspendingthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:domain hpc:Queue .

hpc:loadindex a owl:DatatypeProperty .

hpc:idlelevel a owl:DatatypeProperty ;
    rdfs:range xsd:float .

hpc:Hostwithnosuspendingthreshold a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:interqueuepriority a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
