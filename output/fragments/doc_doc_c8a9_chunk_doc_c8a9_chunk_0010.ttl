hpc:Partition a owl:Class .
hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:PriorityTier a xsd:integer .
hpc:PreemptMode a owl:Enum .
hpc:SubmittedJob a owl:ObjectProperty .
hpc:PartitionName a rdfs:Label .
hpc:Nodes a rdfs:domain hpc:Partition .
hpc:Default a rdfs:domain hpc:Partition .
hpc:OverSubscribe a rdfs:domain hpc:Partition .
