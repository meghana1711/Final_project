hpc:Ue a owl:Class .
hpc:Uachild a owl:Class .
hpc:Ueparent a owl:Class .
hpc:Schild a owl:Class .
hpc:SallSiblings a owl:Class .

hpc:hasue a owl:ObjectProperty .
hpc:hasuachild a owl:ObjectProperty .
hpc:hasueparent a owl:ObjectProperty .
hpc:hasschild a owl:ObjectProperty .
hpc:hassallSiblings a owl:ObjectProperty .

hpc:Ue rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Uachild rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Ueparent rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Schild rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:SallSiblings rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Account a owl:Class .
hpc:hasshares a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Fairshare a owl:Class .
hpc:hasfairsharefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .

hpc:Fairsharehierarchy a owl:Class .
hpc:hasfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Fairshare .

hpc:Fairsharedisabled a owl:Class .
hpc:hasfairshareparent a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:boolean .

hpc:Account rdfs:subClassOf hpc:Fairsharehierarchy ;
    rdfs:subClassOf hpc:Fairsharedisabled .
