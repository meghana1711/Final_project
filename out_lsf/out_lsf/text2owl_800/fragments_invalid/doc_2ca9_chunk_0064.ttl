hpc:Jobaffinityscheduling a owl:Class .
hpc:Hostattribute a owl:Class .

# Parameters for Job Affinity Scheduling and Host Attributes
hpc:attrcreateusersparam a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range hpc:Hostattribute .
hpc:attrmaxnumparam a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:integer .
hpc:attrttlparam a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:nonNegativeInteger .
hpc:samejobaffinityparam a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:boolean .

# Job Forwarding Delay
hpc:jobforwardingdelay a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
hpc:JobForwardingDelayNegative a owl:NamedIndividual ;
    hpc:JobForwardingDelay rdfs:someValuesFrom <-1> .
hpc:JobForwardingDelayPositive a owl:NamedIndividual ;
    hpc:JobForwardingDelay rdfs:someValuesFrom <1, +inf> .

# LSF Parameters
hpc:Lsfparams a owl:Class .
hpc:rescheduleuponcsmsetuperrorparam a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparams ;
    rdfs:range xsd:boolean .

# Commands
hpc:battrcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:string .
hpc:bhostsattrcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:string .
hpc:bsubjobaffcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinityscheduling ;
    rdfs:range xsd:string .
hpc:lsruncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparams ;
    rdfs:range xsd:string .
hpc:lsgruncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparams ;
    rdfs:range xsd:string .

# LSF Configuration Parameters
hpc:Lsfconf a owl:Class .
hpc:lsfugrouptransferparam a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:boolean .

# Subclass relations
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Lsfparams .
