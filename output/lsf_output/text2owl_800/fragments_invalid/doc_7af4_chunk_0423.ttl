hpc:Enrootjob a owl:Class .
hpc:extendablerunlimit a owl:ObjectProperty .

hpc:base a owl:DatatypeProperty ;
    rdfs:domain hpc:Extendablerunlimit ;
    rdfs:range xsd:integer .

hpc:increment a owl:DatatypeProperty ;
    rdfs:domain hpc:Extendablerunlimit ;
    rdfs:range xsd:integer ;
    rdfs:default xsd:0 .

hpc:grace a owl:DatatypeProperty ;
    rdfs:domain hpc:Extendablerunlimit ;
    rdfs:range xsd:integer ;
    rdfs:default xsd:0 .

hpc:requeue a owl:DatatypeProperty ;
    rdfs:domain hpc:Extendablerunlimit ;
    rdfs:range xsd:string ;
    rdfs:default "N" .

hpc:Enrootjob a rdfs:subClassOf [ a owl:Class ; owl:equivalentClass [ a owl:Restriction ; owl:onProperty hpc:Extendablerunlimit ; owl:allValuesFrom [ a xsd:nonNegativeInteger ] ] ] .
