hpc:ContainerJob a owl:Class .
hpc:Step a owl:Class .
hpc:RequestedContainerJob a hpc:ContainerJob .
hpc:BatchStep a hpc:Step .
hpc:InteractiveStep a hpc:Step .
hpc:Job a owl:Class .
hpc:HasContainer a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range rdf:Resource .
hpc:HasStep a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Step .
hpc:HasBatchStep a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range hpc:BatchStep .
hpc:HasInteractiveStep a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range hpc:InteractiveStep .
hpc:HasJobStep a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Step .
hpc:HasJobStep0 a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Step ;
    rdfs:subPropertyOf hpc:HasJobStep .
hpc:HasStep0 a owl:ObjectProperty ;
    rdfs:domain hpc:BatchStep ;
    rdfs:range hpc:Step .
hpc:HasStep1 a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Step ;
    rdfs:subPropertyOf hpc:HasJobStep .
hpc:HasStep1InsideContainer a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:UsesSlurm a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:string .
hpc:UsesRootlessDocker a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:string .
hpc:RequiresMungeAuthentication a owl:ObjectProperty ;
    rdfs:domain hdfs:ContainerJob ;
    rdfs:range xsd:boolean .
hpc:RequiresMungeScrunLua a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:boolean .
hpc:RequiresOciConf a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:boolean .
hpc:RequiresKernelPingConfigured a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:boolean .
hpc:RequiresRootlessDockerdPortsAllowed a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:boolean .
hpc:RequiresScrunLua a owl:ObjectProperty ;
    rdfs:domain hpc:ContainerJob ;
    rdfs:range xsd:boolean .
