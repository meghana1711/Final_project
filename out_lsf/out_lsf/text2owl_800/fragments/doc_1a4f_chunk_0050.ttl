hpc:Eslim a owl:Class .

hpc:hasnumberofindices a owl:ObjectProperty .
hpc:Hasnumberofindices rdfs:domain hpc:Eslim ;
                        rdfs:range xsd:nonNegativeInteger .

hpc:hasindexname a owl:DatatypeProperty .
hpc:Hasindexname rdfs:domain hpc:Eslim ;
                  rdfs:range xsd:string .

hpc:hasindexvalue a owl:DatatypeProperty .
hpc:Hasindexvalue rdfs:domain hpc:Eslim ;
                  rdfs:range xsd:decimal .

hpc:loadupdatestring a owl:ObjectProperty .
hpc:Loadupdatestring rdfs:domain hpc:Eslim ;
                     rdfs:range xsd:string .

hpc:InfiniteLoad a xsd:decimal ;
                  xsd:minInclusive "-INFINIT_LOAD" ;
                  xsd:maxInclusive "INFINIT_LOAD" .

hpc:Eslim rdfs:subClassOf owl:Thing .
