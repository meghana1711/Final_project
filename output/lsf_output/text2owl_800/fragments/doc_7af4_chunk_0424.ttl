hpc:softrunlimitextensiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specify an integer value for the soft run limit extension time. The default value is the value of the BASE[] keyword." .

hpc:grace a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "If LSF decides not to extend the soft run limit for the job, a hard run limit is set for this amount of minutes from the time the decision is made. The default value is 0 (the job is terminated or requeued immediately)." .

hpc:requeue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional. Specifies the action that LSF takes when a job reaches its hard run limit. If set to N, LSF terminates the job. If set to Y LSF requeues the job. The default value is N (LSF terminates the job once the job reaches its hard run limit)." .

hpc:TerminationAction a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Optional. Specifies the action that LSF takes when a job reaches its hard run limit." ;
    owl:oneOf (hpc:Terminate hpc:Requeue) .

hpc:Terminate a owl:NamedIndividual ;
    rdf:value "N" .

hpc:Requeue a owl:NamedIndividual ;
    rdf:value "Y" .

hpc:hardrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "If LSF decides not to extend the soft run limit for the job, a hard run limit is set for this amount of minutes from the time the decision is made. The default value is 0 (the job is terminated or requeued immediately)." .

hpc:Fairshare a owl:Class ;
    rdfs:comment "Enables queue-level user-based fair share and specifies share assignments." .

hpc:Usershares a owl:Class ;
    rdfs:subClassOf hpc:Fairshare ;
    rdfs:comment "Specify at least one user share assignment." .

hpc:usershareassignment a owl:DatatypeProperty ;
    rdfs:domain hpc:Usershares ;
    rdfs:range xsd:string ;
    rdfs:comment "Syntax FAIRSHARE=USER_SHARES[[user, number_shares] ...]" .

hpc:checkpointing a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Jobs that reach the speciﬁed run limit time (as speciﬁed by the RUNLIMIT parameter or the -W option) are checkpointed (if checkpointable), then terminated, regardless of whether resources are available." .
