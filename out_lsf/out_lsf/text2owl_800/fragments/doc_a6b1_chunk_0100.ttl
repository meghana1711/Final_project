hpc:Micdevice a owl:Class .
hpc:micutil a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micncores a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Nmics a owl:Class ;
    rdfs:subClassOf hpc:Micdevice .
hpc:mictemp0 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:mictemp1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micfreq0 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micfreq1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micpower0 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micpower1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .
hpc:micfreemem a owl:DatatypeProperty ;
    rdfs:domain hpc:Micdevice ;
    rdfs:range xsd:decimal .

hpc:Elimmic a owl:Class ;
    rdfs:subClassOf hpc:Micdevice .
