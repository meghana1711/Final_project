hpc:Job a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Slot a owl:Class .
hpc:balancedallocation a owl:ObjectProperty .
hpc:minimumslotallocation a owl:ObjectProperty .
hpc:usablecuslots a owl:DatatypeProperty .
hpc:rusage a owl:ObjectProperty .
hpc:memory a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Computeunit rdfs:subClassOf owl:Class .
hpc:Slot rdfs:subClassOf owl:Class .

hpc:BalancedAllocation rdf:type owl:ObjectProperty .
hpc:MinimumSlotAllocation rdf:type owl:ObjectProperty .
hpc:UsableCUSlots rdf:type owl:DatatypeProperty .
hpc:Rusage rdf:type owl:ObjectProperty .
hpc:Memory rdf:type owl:DatatypeProperty .

hpc:Balancedallocation rdfs:domain hpc:Job .
hpc:Minimumslotallocation rdfs:domain hpc:Job .
hpc:Usablecuslots rdfs:domain hpc:Job .
hpc:Rusage rdfs:domain hpc:Job .
hpc:Memory rdfs:range xsd:nonNegativeInteger .

hpc:ComputeUnit rdfs:subPropertyOf hpc:BalancedAllocation .
hpc:ComputeUnit rdfs:subPropertyOf hpc:MinimumSlotAllocation .

hpc:Balancedallocation rdfs:range hpc:Balancedallocationrange .
hpc:Minimumslotallocation rdfs:range hpc:Minimumslotallocationrange .

hpc:Balancedallocationrange hpc:hashost rdf:type xsd:nonNegativeInteger ;
    hpc:hasNumberOfSlotsPerHost rdf:type xsd:nonNegativeInteger .
hpc:Minimumslotallocationrange hpc:hashost rdf:type xsd:nonNegativeInteger ;
    hpc:hasMinimumSlotsPerHost rdf:type xsd:nonNegativeInteger .

