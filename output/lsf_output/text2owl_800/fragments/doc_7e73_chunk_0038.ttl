hpc:Hostproviders a owl:Class .
hpc:hastype a owl:ObjectProperty ;
    rdfs:domain hpc:Hostproviders ;
    rdfs:range xsd:string .

hpc:Awsprov a owl:Class ;
    rdfs:subClassOf hpc:Hostproviders .

hpc:confpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsprov ;
    rdfs:range xsd:string .

hpc:scriptpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsprov ;
    rdfs:range xsd:string .

hpc:Awsinstancetemplate a owl:Class .
