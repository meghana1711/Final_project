hpc:Slurmdbd a owl:Class .
hpc:isRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:boolean .

hpc:isUpgrading rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:isBackedUp rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:boolean .

hpc:hasLimitation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:DatabaseOperation rdf:type owl:Class .
hpc:ClusterOperation rdf:type owl:Class ;
    rdfs:subClassOf hpc:DatabaseOperation .

hpc:CreatingDatabase rdf:type owl:Class ;
    rdfs:subClassOf hpc:ClusterOperation .

hpc:UpgradingDatabase rdf:type owl:Class ;
    rdfs:subClassOf hpc:ClusterOperation .

hpc:AddingOrRemovingCluster rdf:type owl:Class ;
    rdfs:subClassOf hpc:ClusterOperation .

hpc:ArchivingOrPurgingAccountingData rdf:type owl:Class ;
    rdfs:subClassOf hpc:ClusterOperation .

hpc:isSlow rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:DatabaseOperation .

hpc:resultsInDataLoss rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ClusterOperation .

hpc:requiresDowntime rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:UpgradingDatabase .

hpc:hasLongPrecautionaryDumpTime rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:UpgradingDatabase .

hpc:isUnresponsive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:UpgradedDaemon .

hpc:isEncouraged rdf:type owl:ObjectProperty .

hpc:hasNonSlurmdbdFunctionality rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Upgrade .

hpc:isOperating rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:NonSlurmdbdFunctionality .

hpc:isFilledUp rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmdbdAgentQueue ;
    rdfs:range xsd:boolean .

hpc:isMonitoringMemoryUsage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld .

hpc:hasDBDMsgQueueSize rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmctld .

hpc:isConfigured rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf .

hpc:MaxDBDMsgs rdf:type owl:DatatypeProperty ;
    rdfs:domain
