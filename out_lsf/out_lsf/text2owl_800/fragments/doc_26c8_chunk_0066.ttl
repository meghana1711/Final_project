hpc:Gpu a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an NVIDIA GPU." .

hpc:gpubrand a owl:ObjectProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string ;
    rdfs:comment "The brand of the GPU. Case sensitive and supports NVIDIA GPUs. For a list of GPU brands and models, run the nvidia-sml -L command." .

hpc:gpumodel a owl:ObjectProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string ;
    rdfs:comment "The model of the GPU. Case sensitive, and supports NVIDIA GPUs. For a list of GPU brands and models, run the nvidia-sml command." .

hpc:gpumemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The total GPU memory, in MB." .

hpc:gpunvlink a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies whether the GPU supports NVLink. Valid values (case insensitive) are y, n, yes, no." .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string ;
    rdfs:comment "The default value is given by the setting of the LSB_RC_DEFAULT_HOST_TYPE in the lsf.conf file. The default value of LSB_RC_DEFAULT_HOST_TYPE is X86_64." .

hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of CPU cores per CPU in machine types described by the template. The default value is 1." .
