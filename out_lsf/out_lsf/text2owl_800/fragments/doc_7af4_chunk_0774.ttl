hpc:Amfirst a owl:Class .
hpc:Amnever a owl:Class .
hpc:lsfApiConntimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:egoLimConntimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range xsd:integer .
hpc:lsfApiRecvtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Ego ;
    rdfs:range xsd:integer .
hpc:LsfApiRecvtimeout rdfs:subClassOf hpc:LsfApiConntimeout .
hpc:lsfAsplugin a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:lsfAuth a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:eauth a owl:NamedIndividual .
hpc:ident a owl:NamedIndividual .
hpc:none a owl:NamedIndividual .
