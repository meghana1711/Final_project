hpc:Jobhostfile a owl:Class .
hpc:jobiddatatype a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobhostfile ;
    rdfs:range xsd:integer .
hpc:hostfile a owl:ObjectProperty ;
    rdfs:domain hpc:Jobhostfile ;
    rdfs:range xsd:string .
hpc:hostsdatatype a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobhostfile ;
    rdfs:range xsd:string .
hpc:lsbDjobHostfile a owl:ObjectProperty ;
    rdfs:domain hpc:Jobhostfile ;
    rdfs:range xsd:string .
hpc:Taskexitaction a owl:Class .
hpc:killjobTaskdone a owl:ObjectProperty ;
    rdfs:domain hpc:Taskexitaction ;
    rdfs:range xsd:string .
hpc:killjobTaskexit a owl:ObjectProperty ;
    rdfs:domain hpc:Taskexitaction ;
    rdfs:range xsd:string .
hpc:rtaskGoneAction a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Taskexitaction .
hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
