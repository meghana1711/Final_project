hpc:Job a owl:Class .
hpc:blocksize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:blockscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Blockschedulingpolicy .

hpc:Blockschedulingpolicy a owl:Class .
hpc:NetworkLatencySensitive a hpc:BlockSchedulingPolicy ;
    rdfs:subClassOf hpc:Blockschedulingpolicy .
hpc:ThroughputPreferred a hpc:BlockSchedulingPolicy ;
    rdfs:subClassOf hpc:Blockschedulingpolicy .

hpc:packingpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Blockschedulingpolicy ;
    rdfs:range hpc:Packingpolicy .

hpc:PackingPolicyOnNewHosts a hpc:PackingPolicy ;
    rdfs:subClassOf hpc:Packingpolicy .

hpc:PackingPolicyOnAnyHost a hpc:PackingPolicy ;
    rdfs:subClassOf hpc:Packingpolicy .

hpc:Packingpolicybyblocksize a owl:Class .
hpc:PackingPolicyByBlockSizeOnOneHostFirst a hpc:PackingPolicyByBlockSize ;
    rdfs:subClassOf hpc:Packingpolicybyblocksize .

hpc:Slot a owl:Class .
hpc:slotblock a owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range hpc:Slotblock .

hpc:Slotblock a owl:Class .
