hpc:SSHConnection a owl:Class .
hpc:Job a owl:Class .
hpc:AdoptedProcess a owl:Class .
hpc:OriginatesFrom a owl:ObjectProperty .
hpc:HasAdoptedProcess a owl:ObjectProperty .
hpc:HasRunningJob a owl:ObjectProperty .

hpc:SSHConnection rdfs:subClassOf hpc:Connection .
hpc:Job rdfs:subClassOf hpc:Workflow .
hpc:AdoptedProcess rdfs:subClassOf hpc:Process .

hpc:OriginatesFrom rdfs:domain hpc:SSHConnection ;
    rdfs:range hpc:Job .

hpc:HasAdoptedProcess rdfs:domain hpc:Job ;
    rdfs:range hpc:AdoptedProcess .

hpc:HasRunningJob rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
```
