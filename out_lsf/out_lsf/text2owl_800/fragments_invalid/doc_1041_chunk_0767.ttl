hpc:Config a owl:Class .
hpc:reconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Config ;
    rdfs:range hpc:Reconfig .

hpc:Reconfig a owl:Class ;
    rdfs:subClassOf hpc:Config ;
    rdfs:comment "Reconfiguration command." .

hpc:reconfigFlag a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:boolean .

hpc:reconfigFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:string .

hpc:reconfigVerbose a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfig ;
    rdfs:range xsd:boolean .

hpc:Limiter a owl:Class .
hpc:limlock a owl:ObjectProperty ;
    rdfs:domain hpc:Limiter ;
    rdfs:range hpc:Limlock .

hpc:Limlock a owl:Class ;
    rdfs:subClassOf hpc:Limiter ;
    rdfs:comment "Limiter lock." .

hpc:limlockTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Limlock ;
    rdfs:range xsd:double .

hpc:limiterUnlock a owl:ObjectProperty ;
    rdfs:domain hpc:Limiter ;
    rdfs:range hpc:LimiterUnlocked .

hpc:LimiterUnlocked a owl:Class ;
    rdfs:subClassOf hpc:Limiter ;
    rdfs:comment "Limiter unlocked state." .

hpc:Resource a owl:Class .
hpc:reslogon a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Reslogon .

hpc:Reslogon a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Resource logon command." .

hpc:reslogonCpuTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reslogon ;
    rdfs:range xsd:double .

hpc:reslogonHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Reslogon ;
    rdfs:range xsd:string .

hpc:reslogonAll a owl:DatatypeProperty ;
    rdfs:domain hpc:Reslogon ;
    rdfs:range xsd:string .

hpc:reslogoff a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Reslogoff .

hpc:Reslogoff a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Resource logoff command." .

hpc:reslogoffHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Reslogoff ;
    rdfs:range xsd:string .

