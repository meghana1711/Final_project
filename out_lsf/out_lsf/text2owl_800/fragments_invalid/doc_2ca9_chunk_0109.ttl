hpc:Glibc_2_26 rdfs:comment "glibc 2.26" .
hpc:Glibc_2_26 rdfs:label "Glibc 2.26" .

# What's new in IBM Spectrum LSF Version 10.1 Fix Pack 6
hpc:Lsf101Fp6 a owl:Class .
