hpc:Interruptiblebackfilljob a owl:Class .
hpc:Queue a owl:Class .
hpc:queueruntimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeDuration .
hpc:minimaltimeslice a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeDuration .
hpc:Regularjob a owl:Class ;
    rdfs:subClassOf hpc:Interruptiblebackfilljob .
hpc:Backfilljob a owl:Class ;
    rdfs:subClassOf hpc:Interruptiblebackfilljob .
hpc:isscheduledby a owl:ObjectProperty ;
    rdfs:domain hpc:Interruptiblebackfilljob ;
    rdfs:range hpc:Queue .
hpc:iskilledby a owl:ObjectProperty ;
    rdfs:domain hpc:Interruptiblebackfilljob ;
    rdfs:range rdf:Resource .
hpc:hasruntimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Regularjob ;
    rdfs:range xsd:nonNegativeDuration .
hpc:isreservedresource a owl:ObjectProperty ;
    rdfs:domain hpc:Backfilljob ;
    rdfs:range rdf:Resource .
