    rdfs:domain hpc:Swapusage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:RSS rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Swapusage ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Jobstarterextend a owl:Class .
