hpc:Job a owl:Class .
hpc:Localfile a owl:Class .
hpc:Remotefile a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Executionhost a owl:Class .

# Object Properties
hpc:overwrites a owl:ObjectProperty .
hpc:createssymboliclink a owl:ObjectProperty .
hpc:copies a owl:ObjectProperty .
hpc:appends a owl:ObjectProperty .
hpc:runscommand a owl:ObjectProperty .

# Datatype Properties
hpc:Hassrcfile rdfs:domain hpc:Localfile;
                 rdfs:range xsd:string .
hpc:Hasdstfile rdfs:domain (hpc:Localfile | hpc:Remotefile);
                 rdfs:range xsd:string .
hpc:Hasstagingarea rdfs:domain hpc:Job;
                   rdfs:range hpc:Stagingarea .
hpc:Hasexecutionhost rdfs:domain hpc:Job;
                     rdfs:range hpc:Executionhost .

# Subclass relations
hpc:Stagingarea a rdfs:subClassOf owl:Class .
hpc:Executionhost a rdfs:subClassOf owl:Class .

# Domain and Range restrictions
hpc:Overwrites rdfs:domain hpc:Localfile;
                rdfs:range xsd:boolean .
hpc:Createssymboliclink rdfs:domain hpc:Job;
                        rdfs:range hpc:Localfile .
hpc:Copies rdfs:domain (hpc:Job | hpc:Localfile);
             rdfs:range hpc:Localfile .
hpc:Appends rdfs:domain hpc:Job;
              rdfs:range (hpc:Localfile | hpc:Remotefile) .
hpc:Runscommand rdfs:domain hpc:Job;
                 rdfs:range xsd:string .

# Specific properties for >, @> operators
hpc:bstageIn rdfs:subPropertyOf hpc:copies .
hpc:Bstagein rdfs:domain hpc:Job .
hpc:Bstagein rdfs:range hpc:Remotefile .
hpc:bstageIn rdfs:subPropertyOf hpc:runsCommand .
hpc:Bstagein rdfs:range "<http://example.org/bstageIn>" .

hpc:bstageInWithLink rdfs:subPropertyOf hpc:createsSymbolicLink .
hpc:Bstageinwithlink rdfs:domain hpc:Job .
hpc:Bstageinwithlink rdfs:range (hpc:Localfile | hpc:Remotefile) .
hpc:bstageInWithLink rdfs:subPropertyOf hpc:runsCommand .
hpc:Bstageinwithlink rdfs:range "<http://example.org/bstageIn -link>" .

# Specific properties for <, @< operators
hpc:bstageOut rdfs:subPropertyOf hpc:copies .
hpc:Bstageout rdfs:domain hpc:Job .
hpc:bstageOut
