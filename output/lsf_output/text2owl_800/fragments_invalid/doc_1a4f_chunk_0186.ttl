hpc:Resourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Num a xsd:nonNegativeInteger .
hpc:unit a owl:DatatypeProperty .
hpc:Resource a owl:Class .
hpc:Memory a rdfs:subClassOf hpc:Resource ;
    rdfs:domain hpc:Simpleresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Swap a rdfs:subClassOf hpc:Resource ;
    rdfs:domain hpc:Simpleresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Temporary a rdfs:subClassOf hpc:Resource ;
    rdfs:domain hpc:Simpleresourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:unitof a owl:DatatypeProperty .
hpc:Memoryunit a rdfs:subClassOf xsd:string ;
    rdfs:range xsd:string .
hpc:Swapunit a rdfs:subClassOf xsd:string ;
    rdfs:range xsd:string .
hpc:Temporaryunit a rdfs:subClassOf xsd:string ;
    rdfs:range xsd:string .
hpc:CompoundResourceRequirement hasNum a hpc:Num ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range hpc:Num .
hpc:CompoundResourceRequirement hasResource a hpc:SimpleResourceRequirement ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range hpc:Simpleresourcerequirement .
hpc:SimpleResourceRequirement hasUnit a hpc:UnitOf ;
    rdfs:domain hpc:Simpleresourcerequirement ;
    rdfs:range hpc:Unit .
