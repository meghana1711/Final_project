hpc:Lsf a owl:Class .
hpc:DLPAR a hpc:Micropartition ;
    rdfs:subClassOf hpc:Partition .
hpc:SharedProcessorMicropartition a hpc:DLPAR ;
    rdfs:subClassOf hpc:Dlpar ;
    rdfs:comment "Micropartition that is configured with shared processors." .
hpc:lsfdetectedcpucount a owl:ObjectProperty ;
    rdfs:domain hpc:Dlpar ;
    rdfs:range xsd:integer .
hpc:lsfreportedcpuutilization a owl:ObjectProperty ;
    rdfs:domain hpc:Dlpar ;
    rdfs:range xsd:decimal .
hpc:lsfnodeentitledcapacity a owl:DatatypeProperty ;
    rdfs:domain hpc:Dlpar ;
    rdfs:range xsd:decimal .
hpc:Wpar a owl:Class .
hpc:ApplicationWPAR a hpc:WPAR ;
    rdfs:subClassOf hpc:Wpar ;
    rdfs:comment "Transient and not suitable for server applications like LSF daemons." .
hpc:SystemWPAR a hpc:WPAR ;
    rdfs:subClassOf hpc:Wpar ;
    rdfs:comment "LSF cannot run on system WPARs." .
hpc:wpardeviceaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Wpar ;
    rdfs:range xsd:string .
hpc:WPARDevice xsd:string "dev/mem" .
hpc:WPARDevice xsd:string "dev/kmem" .
hpc:Performancemetricsmbatchd a owl:Class .
hpc:mbatchdperformancemetricslog a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemetricsmbatchd ;
    rdfs:range xsd:boolean .
hpc:lsbenableperfmetricslog a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricsmbatchd ;
    rdfs:range xsd:boolean .
hpc:perfmetricssampleperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricsmbatchd ;
    rdfs:range xsd:duration .
hpc:perfmetricslogdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetricsmbatchd ;
    rdfs:range xsd:string .
