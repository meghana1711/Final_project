hpc:jobarrayHasstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:JobarrayIsdone a owl:Class ;
    rdfs:subClassOf hpc:Jobarray .

hpc:JobarrayIsexit a owl:Class ;
    rdfs:subClassOf hpc:Jobarray .

hpc:brequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

