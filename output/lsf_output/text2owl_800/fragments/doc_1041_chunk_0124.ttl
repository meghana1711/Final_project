hpc:Usergroup       a owl:Class .
hpc:Hostgroup       a owl:Class .
hpc:Queue           a owl:Class .
hpc:Limit           a owl:Class .
hpc:Gpool           a owl:Class .
hpc:Serviceclass    a owl:Class .
hpc:User            a owl:Class .

# Object Properties
hpc:hasmember       a owl:ObjectProperty .
hpc:ispartof        a owl:ObjectProperty .
hpc:hasqueue        a owl:ObjectProperty .
hpc:haslimit        a owl:ObjectProperty .
hpc:belongstogpool  a owl:ObjectProperty .
hpc:providesservice a owl:ObjectProperty .

# Datatype Properties
hpc:hasname         a owl:DatatypeProperty .
hpc:hasvalue        a owl:DatatypeProperty .

# Domain and Range
hpc:Hasmember rdfs:domain hpc:Usergroup ;
           rdfs:range hpc:User .
hpc:Ispartof rdfs:domain hpc:Usergroup ;
           rdfs:range hpc:Hostgroup .
hpc:Hasqueue rdfs:domain hpc:Queue ;
           rdfs:range hpc:Queue .
hpc:Haslimit rdfs:domain hpc:Limit ;
           rdfs:range xsd:nonNegativeInteger .
hpc:Belongstogpool rdfs:domain hpc:Gpool ;
           rdfs:range hpc:Usergroup .
hpc:Providesservice rdfs:domain hpc:Serviceclass ;
           rdfs:range hpc:Usergroup .
hpc:Hasname rdfs:domain hpc:Usergroup ;
           rdfs:range xsd:string .
hpc:Hasname rdfs:domain hpc:User ;
           rdfs:range xsd:string .
hpc:Hasvalue rdfs:domain hpc:Usergroup ;
           rdfs:domain hpc:Limit ;
           rdfs:range xsd:string .
