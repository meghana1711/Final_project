hpc:Lsfcluster a owl:Class .
hpc:logout a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string .
hpc:logon a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:List .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Logon .
hpc:url a owl:DatatypeProperty ;
    rdfs:domain hpc:Logon .
hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:stat a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:queue a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:fromHost a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs .
hpc:SUBMIT_TIME a xsd:dateTime .
