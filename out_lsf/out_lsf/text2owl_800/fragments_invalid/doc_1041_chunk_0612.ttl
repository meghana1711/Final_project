hpc:Pendingtimelimit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timelimit .

hpc:Eligiblependingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Pendingtimelimit ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Jobleveleligiblependingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Eligiblependingtimelimit ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Queuelevelpendingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Pendingtimelimit ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Applicationlevelpendingtimelimit a owl:Class ;
    rdfs:subClassOf hpc:Pendingtimelimit ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:hastimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Timelimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:iseligiblependingtimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingtimelimit ;
    rdfs:range hpc:Jobleveleligiblependingtimelimit .

hpc:isqueuelevelpendingtimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingtimelimit ;
    rdfs:range hpc:Queuelevelpendingtimelimit .

hpc:isapplicationlevelpendingtimelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingtimelimit ;
    rdfs:range hpc:Applicationlevelpendingtimelimit .

hpc:overrides a owl:ObjectProperty ;
    rdfs:domain hpc:Eligiblependingtimelimit ;
    rdfs:range owl:Nothing .

hpc:hasexternalscheduleroptions a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Externalscheduleroptions .

hpc:Externalscheduleroptions a owl:Class .

hpc:schedule a owl:ObjectProperty ;
    rdfs:domain hpc:Externalscheduleroptions ;
    rdfs:range xsd:string .
