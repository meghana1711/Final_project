hpc:LsfClearcaseWrapperRetry a owl:Class .
hpc:LsfClearcaseWrapperRetryInterval a owl:Class .

hpc:hasretrylimit a owl:ObjectProperty ;
    rdfs:domain hpc:LsfClearcaseWrapperRetry ;
    rdfs:range xsd:nonNegativeInteger .

hpc:retryinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfClearcaseWrapperRetryInterval ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LsfClearcaseWrapperRetry rdfs:subClassOf owl:Class .
hpc:LsfClearcaseWrapperRetryInterval rdfs:subClassOf owl:Class .
