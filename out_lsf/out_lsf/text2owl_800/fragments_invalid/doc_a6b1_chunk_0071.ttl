hpc:Lsfserver a owl:Class .
hpc:LSFAuthFile an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:string .
hpc:LSFConfFile an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:string .
hpc:LSFAuth an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:string .
hpc:LSFAuthDaemons an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserver ;
    rdfs:range xsd:integer .
hpc:Kerberosprincipal a owl:Class .
hpc:KerberosPrincipalName an owl:DatatypeProperty ;
    rdfs:domain hpc:Kerberosprincipal ;
    rdfs:range xsd:string .
hpc:KerberosRealm an owl:DatatypeProperty ;
    rdfs:domain hpc:Kerberosprincipal ;
    rdfs:range xsd:string .
hpc:Kerberosserver a owl:Class .
hpc:KerberosAddPrinc an owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosserver ;
    rdfs:range hpc:Kerberosprincipal .
hpc:KerberosAddKey an owl:ObjectProperty ;
    rdfs:domain hpc:Kerberosserver ;
    rdfs:range hpc:Kerberosprincipal .
