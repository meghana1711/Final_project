hpc:Licensetoken a owl:Class .
hpc:Licenseproject a owl:Class .
hpc:Licensescheduler a owl:Class .
hpc:Flexnetlicensemanager a owl:Class .

hpc:allocateLicenseToken an owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range hpc:Licensetoken .

hpc:checkoutLicenseToken an owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range hpc:Licensetoken .

hpc:reserveLicenseToken an owl:ObjectProperty ;
    rdfs:domain hpc:Licensetoken ;
    rdfs:range xsd:integer .

hpc:LicenseProject hasLicenseTokens hpc:LicenseToken ;
    rdfs:domain hpc:Licenseproject ;
    rdfs:range rdf:List .

hpc:Projectgroup a owl:Class .
hpc:rootmember a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Member .

hpc:projectinfo a owl:ObjectProperty ;
