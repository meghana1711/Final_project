hpc:Host a owl:Class .
hpc:Dispatchwindow a owl:Class .
hpc:hasDispatchWindow rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Dispatchwindow .
hpc:startTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:dateTime .
hpc:endTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:dateTime .
hpc:hostIP rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:hasComment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Event .
hpc:Event a owl:Class .
hpc:commentText rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Event ;
    rdfs:range xsd:string .
hpc:Eventlog a owl:Class .
hpc:hasEvent rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Eventlog ;
    rdfs:range hpc:Event .
