    rdfs:domain hpc:Account ;
    rdfs:range xsd:integer .

hpc:Active a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:boolean .

hpc:Accruing a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Total a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

hpc:Count a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPer ;
    rdfs:range xsd:integer .

hpc:Accruing a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPer ;
    rdfs:range xsd:integer .

hpc:Submitted a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPer ;
    rdfs:range xsd:integer .

hpc:GraceTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer .

hpc:Max a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer .

hpc:Jobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer .

hpc:Factor a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:decimal .

hpc:MinPriorityThreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer .

hpc:PreemptList a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range rdf:List .

hpc:PreemptMode a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:string .

hpc:Hold a owl:Class .
hpc:Comment a owl:Class .
hpc:Administrator a owl:DatatypeProperty ;
    rdfs:domain hpc:Comment ;
    rdfs:range xsd:string .
hpc:Job a owl:Class .
hpc:JobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Limits a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
