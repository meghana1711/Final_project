hpc:Lsfexecutionhost a owl:Class .
hpc:Datatransfernode rdfs:subClassOf hpc:Lsfexecutionhost .

hpc:hasLSFServerHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:string .

hpc:usesDataTransferTool rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfernode .

hpc:FILE_TRANSFER_CMD rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager .

hpc:DATA_TRANSFER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .

hpc:hasDataTransferTool rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager .

hpc:supportsOperatingSystem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host .
    rdfs:range xsd:string .

hpc:requiresPasswordlessSSH rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:Datamanager a owl:Class .
hpc:Submissionhost rdfs:subClassOf hpc:Host .
hpc:Managementhost rdfs:subClassOf hpc:Host .
hpc:Executionhost rdfs:subClassOf hpc:Host .

hpc:Queue a owl:Class .
hpc:stagesIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfertool ;
    rdfs:range xsd:string .

hpc:stagesOut rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datatransfertool ;
    rdfs:range xsd:string .

hpc:Host a owl:Class .
