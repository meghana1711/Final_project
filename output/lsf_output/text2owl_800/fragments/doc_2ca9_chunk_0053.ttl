hpc:Globallimitscheduling a owl:Class ;
    rdfs:subClassOf hpc:Schedulingstrategy ;
    rdfs:comment "Enables global limit scheduling among all clusters." .

hpc:enablegloballimitscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Edits the lsb.params file and defines GLOBAL_LIMITS=Y." .

# Global Job Resource Allocations
hpc:Globaljobresourceallocation a owl:Class ;
    rdfs:subClassOf hpc:Jobresourceallocation ;
    rdfs:comment "Relates to global limits for job resource allocations." .

# Limit Section in lsb.globalpolicies File
hpc:Limitsection a owl:Class ;
    rdfs:subClassOf hpc:Policysection ;
    rdfs:comment "Related reference for the limit section in the lsb.globalpolicies file." .

# Scheduler Efficiency Monitoring
hpc:Schedulerefficiencymonitoring a owl:Class ;
    rdfs:subClassOf hpc:Clustermonitoring ;
    rdfs:comment "Relates to monitoring scheduler efficiency." .

hpc:schedulerefficiencymetric a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerefficiencymonitoring ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Provides a scheduling efficiency metric to help monitor cluster performance." .

hpc:schedulerefficiencyimpactonresourceutilization a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerefficiencymonitoring ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Estimates how the slot and memory utilization of the cluster is affected by scheduling overhead." .

# Scheduler Efficiency Command
hpc:badminperfmoncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerefficiencymonitoring ;
    rdfs:range hpc:Command ;
    rdfs:comment "Run the badmin perfmon command to view the scheduler efficiency for finished jobs within a sample period." .

hpc:bacctcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerefficiencymonitoring ;
    rdfs:range hpc:Command ;
    rdfs:comment "Run the bacct command to view the scheduler efficiency for all finished jobs in a cluster." .

# Security Features
hpc:Clustersecurity a owl:Class ;
    rdfs:subClassOf hpc:Cluster ;
    rdfs:comment "The following new features affect cluster security." .

hpc:strictoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Clustersecurity ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Related to strict output features." .
