hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a host in the HPC system." .

hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the host." .

hpc:hasdispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Dispatchwindow ;
    rdfs:comment "The dispatch window(s) for the host." .

# DispatchWindow class and properties
hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a time window during which a host can receive new jobs." .

hpc:begintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:time ;
    rdfs:comment "The start time of the dispatch window." .

hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:time ;
    rdfs:comment "The end time of the dispatch window." .
