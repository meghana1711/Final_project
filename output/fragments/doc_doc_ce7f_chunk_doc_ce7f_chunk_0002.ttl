hpc:SlurmDaemon a owl:Class .
hpc:SlurmLogFilesParentDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range xsd:string .

hpc:SlurmProcessIDFilesParentDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range xsd:string .

hpc:SlurmStateSaveDirectoriesParentDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range xsd:string .

hpc:SlurmUser rdf:type owl:Class .

hpc:InstallationProcess rdf:type owl:Class .

hpc:Prerequisite rdf:type owl:Class .
hpc:Plugin rdf:type owl:Class ;
    rdfs:subClassOf hpc:Prerequisite .

hpc:LuaAPIRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Requirement for Lua API" .

hpc:PAMSupport rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Requirement for PAM support" .

hpc:PMIxSupport rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Requires --with-pmix at build time" .

hpc:ReadlineSupport rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Requirement for readline support in scontrol and sacctmgr interactive modes" .

hpc:slurmrestdSupport rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Provides support for Slurm's REST API" .

hpc:httpParserRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:slurmrestdSupport ;
    rdfs:comment "Optional prerequisites for additional functionality" .

hpc:jsonCRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:slurmrestdSupport ;
    rdfs:comment "Optional prerequisites for additional functionality" .

hpc:yamlRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:slurmrestdSupport ;
    rdfs:comment "Optional prerequisite" .

hpc:jwtRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:slurmrestdSupport ;
    rdfs:comment "Optional prerequisite" .

hpc:sviewRequirement rdf:type hpc:Prerequisite ;
    rdfs:subClassOf hpc:Plugin ;
    rdfs:comment "Requirement for sview" .

hpc:switchHpeSlingshot
