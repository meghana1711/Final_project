hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A reservation for LSF jobs." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An LSF job." .

hpc:User a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An LSF user." .

hpc:Group a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An LSF group." .

hpc:Day a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "A day of the week." .

hpc:Minute a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger ;
    rdfs:comment "A minute of the day." .

hpc:hasDay an owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Day ;
    rdfs:comment "The day(s) the reservation applies to." .

hpc:hasMinute an owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Minute ;
    rdfs:comment "The minute the reservation applies to (if a specific day is specified)." .

hpc:canSubmitJob an owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User ;
    rdfs:range hpc:Group ;
    rdfs:comment "The users or groups who are able to submit jobs to a reservation." .

hpc:removeFromReservation an owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User ;
    rdfs:range hpc:Group ;
    rdfs:comment "Removes a user or group from the list of those who can submit jobs to a reservation." .

hpc:hasRunLimit an owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum run time for a job using the reservation." .

hpc:hasQueueRunLimit an owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum run time for a job in a queue." .

hpc:hasTerminationTime an owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Minute ;
    rdfs:comment "The time at which the job will be terminated if the reservation expires." .

hpc:setTerminationTime an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Minute ;
    rdfs:comment "Sets the termination time of a job that uses a reservation." .

hpc:has
