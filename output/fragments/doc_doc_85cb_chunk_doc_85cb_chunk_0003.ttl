hpc:Cluster a owl:Class .
hpc:ControlHost rdf:type owl:ObjectProperty .
hpc:Name rdf:type owl:DatatypeProperty .
hpc:Type rdf:type owl:DatatypeProperty .

hpc:Resource a owl:Class .
hpc:Server rdf:type owl:ObjectProperty .
