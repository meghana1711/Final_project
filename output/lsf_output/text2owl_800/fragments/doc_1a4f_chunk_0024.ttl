hpc:Resource a owl:Class .
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:hasdescription a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:isshared a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:isstatic a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:isdynamic a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:Resourcemap a owl:Class .
hpc:hasresource a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemap ;
    rdfs:range hpc:Resource .
hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemap ;
    rdfs:range hpc:Host .
hpc:Host a owl:Class .
hpc:hasresources a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:Resource .
hpc:Cluster a owl:Class .
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:hasresourcemap a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Resourcemap .
hpc:Staticloadindex a owl:Class .
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Staticloadindex ;
    rdfs:range xsd:string .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Staticloadindex ;
    rdfs:range xsd:numeric .
hpc:Dynamicloadindex a owl:Class .
hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamicloadindex ;
