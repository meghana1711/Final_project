hpc:Job a owl:Class .
hpc:Signalname a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Serviceclass a owl:Class .
hpc:operateson a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Serviceclass .
hpc:hasid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:isterminatedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signalname ;
    rdfs:subPropertyOf hpc:operatesOn .
hpc:issuspendedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signalname ;
    rdfs:subPropertyOf hpc:operatesOn .
hpc:isresumedby a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Signalname .
hpc:SIGKILL rdf:type hpc:SignalName ;
    xsd:minInclusive "9" .
hpc:SIGSTOP rdf:type hpc:SignalName ;
    xsd:minInclusive "16" .
hpc:SIGCONT rdf:type hpc:SignalName .
hpc:SIGTSTP rdf:type hpc:SignalName .
hpc:SIG15 rdf:type hpc:SignalName ;
    xsd:minInclusive "15" .
hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:hasjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobgroup .
hpc:killsjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobgroup ;
    rdfs:subPropertyOf hpc:operatesOn .
hpc:-sla a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
