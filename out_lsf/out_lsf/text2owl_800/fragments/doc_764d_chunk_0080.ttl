hpc:Job a owl:Class .
hpc:Remotecluster a owl:Class .
hpc:Submissioncluster a owl:Class .
hpc:maxrschedtime a owl:DatatypeProperty .
hpc:mcsortbysubmittime a owl:ObjectProperty .
hpc:forwardingtime a owl:DatatypeProperty .
hpc:originalsubmittime a owl:DatatypeProperty .
hpc:Lsbqueue a owl:Class .
hpc:Lsbparams a owl:Class .
hpc:Jobstatus a owl:Class .
hpc:Pendingtimeout a owl:Class .
hpc:Rescheduling a owl:Class .
hpc:Dispatched a owl:Class .
hpc:forwarded a owl:ObjectProperty .
hpc:returned a owl:ObjectProperty .
hpc:runsinsubmissioncluster a owl:ObjectProperty .
hpc:runsinremotecluster a owl:ObjectProperty .
hpc:Lsbqueues rdfs:subClassOf hpc:Lsbqueue .
hpc:Lsbparams rdfs:subClassOf hpc:Lsbqueue .
hpc:Jobstatus rdfs:subClassOf hpc:Status .
hpc:Pendingtimeout rdfs:subClassOf hpc:Jobstatus .
hpc:Rescheduling rdfs:subClassOf hpc:Jobstatus .
hpc:Dispatched rdfs:subClassOf hpc:Jobstatus .
hpc:Maxrschedtime rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Mcsortbysubmittime rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:boolean .
hpc:Forwardingtime rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Originalsubmittime rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Forwarded rdfs:domain hpc:Job ;
    rdfs:range hpc:Remotecluster .
hpc:Returned rdfs:domain hpc:Job ;
    rdfs:range hpc:Submissioncluster .
hpc:Runsinsubmissioncluster rdfs:domain hpc:Job ;
    rdfs:range hpc:Submissioncluster .
hpc:Runsinremotecluster rdfs:domain hpc:Job ;
    rdfs:range hpc:Remotecluster .
