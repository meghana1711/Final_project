# Subclass Relations
hpc:Job a hpc:LSF ;
    rdfs:subClassOf [ a owl:Class ;
        owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty hpc:hasJob ;
            owl:hasValue rdf:nil ] ] .

