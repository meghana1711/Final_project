hpc:Host a owl:Class .
hpc:Reghostscachefile a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:ipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:sid a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Registrationrequest a owl:Class .
hpc:MatchesSID an owl:ObjectProperty ;
    rdfs:domain hpc:Registrationrequest ;
    rdfs:range hpc:Host .
hpc:Rejectedregistration a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        owl:intersectionOf ( hpc:RegistrationRequest hpc:MatchesSID ) ] .
hpc:Lsfhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Lsfserver a owl:Class .
hpc:Hostregsetupfile a owl:Class .
hpc:Unixcommand a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Windowscommand a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Cronjob a owl:Class .
hpc:Floatingclient a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:floatingclientsaddrrange a owl:DatatypeProperty ;
    rdfs:domain hpc:Floatingclient ;
    rdfs:range xsd:string .
