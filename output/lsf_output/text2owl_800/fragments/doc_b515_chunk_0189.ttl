hpc:Queue a owl:Class .
hpc:HigherPriorityQueue a hpc:Queue .
hpc:LowerPriorityQueue a hpc:Queue .
hpc:Jobslot a owl:Class .
hpc:Queuepool a owl:Class .
hpc:Pooledqueue a owl:Class .
hpc:Pooledhigherpriorityqueue a owl:Class .
hpc:Pooledlowerpriorityqueue a owl:Class .
hpc:queueshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .
hpc:poolshare a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuepool ;
    rdfs:range xsd:decimal .
hpc:hasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queuepool ;
    rdfs:range hpc:Queue .
hpc:ispooledqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Pooledqueue .
hpc:ishigherpriorityqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Pooledqueue ;
    rdfs:range hpc:Higherpriorityqueue .
hpc:islowerpriorityqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Pooledqueue ;
    rdfs:range hpc:Lowerpriorityqueue .
hpc:Queuepool rdfs:subClassOf hpc:Pool .
hpc:Pooledqueue rdfs:subClassOf hpc:Queue .
