@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:BJOBS_W_DISPLAY_MEM_SWAP_PIDS
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Reference for LSF environment variables." .

hpc:BJOBS_W_DISPLAY_MEM_SWAP_PIDS_YES
    a owl:NamedIndividual ;
    hpc:BJOBS_W_DISPLAY_MEM_SWAP_PIDS "Y" .

hpc:BJOBS_W_DISPLAY_MEM_SWAP_PIDS_NO
    a owl:NamedIndividual ;
    hpc:BJOBS_W_DISPLAY_MEM_SWAP_PIDS "N" .

hpc:BSUB_BLOCK
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Batchmode ;
    rdfs:comment "The BSUB_BLOCK variable is set when you submit a job for synchronous job execution with the bsub -K option." .

hpc:BatchMode
    a owl:Class .

hpc:BSUB_CHK_RESREQ
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "When the BSUB_CHK_RESREQ variable is set, bsub checks the syntax of the resource requirement selection string without actually submitting the job for scheduling and dispatch." .
