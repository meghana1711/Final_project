hpc:Applicationprofile hpc:a owl:Class .
hpc:Cwd hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:DefaultJobCwd hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:Submissiondirectory hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:-hl hpc:a owl:ObjectProperty .
hpc:-hln hpc:a owl:ObjectProperty .

hpc:Pendingjob hpc:a owl:Class .

hpc:LsbResourceEnforce hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile .

hpc:Memory hpc:a owl:Class .
hpc:Swap hpc:a owl:Class .

hpc:-Epn hpc:a owl:ObjectProperty .

hpc:Joblevelpostexecutioncommand hpc:a owl:Class .
hpc:Applicationlevelpostexecutioncommand hpc:a owl:Class .

hpc:Defaultusergroup hpc:a owl:Class .
hpc:LsbParams hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Defaultusergroup .

hpc:Bmod hpc:a owl:ObjectProperty .
hpc:G hpc:a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Defaultusergroupattachedjob hpc:a owl:Class ;
    rdfs:subClassOf hpc:Job .
