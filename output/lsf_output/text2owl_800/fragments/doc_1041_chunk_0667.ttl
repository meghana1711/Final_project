hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Slot a owl:Class .
hpc:Processor a owl:Class .
hpc:minimumtasknumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:maximumtasknumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobsizelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:parallelschedbyslot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:compatiblewithtasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range hpc:Job .
hpc:withinrangeoftasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Job .
hpc:jobsizesatisfiesjobsizelist a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Job .
hpc:overridestasklimit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Tasklimit .
hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Compoundresourcerequirement a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Jobsubmission a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Jobsizelist rdfs:subClassOf xsd:NMTOKEN .
