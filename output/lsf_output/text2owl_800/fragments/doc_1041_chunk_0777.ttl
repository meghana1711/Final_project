hpc:Debugsettings a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Sets debug settings on the specified host or hosts." .

hpc:hostName a owl:ObjectProperty ;
    rdfs:domain hpc:Debugsettings ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the host or hosts." .

hpc:className a owl:DatatypeProperty ;
    rdfs:domain hpc:Debugsettings ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the class name." .

hpc:debugLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Debugsettings ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the debug level." .

hpc:logfileName a owl:DatatypeProperty ;
    rdfs:domain hpc:Debugsettings ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the log file name." .

hpc:isDefault a owl:ObjectProperty ;
    rdfs:domain hpc:Debugsettings ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if the host is the default (the host from which command was submitted)." .

hpc:Debuglevel a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a debug level." .

hpc:limdebug a owl:ObjectProperty ;
    rdfs:domain hpc:Debuglevel ;
    rdfs:range hpc:Debugsettings ;
    rdfs:comment "Relates a debug level to its settings." .

hpc:Lsfadmin a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an LSF administrator." .

hpc:Limtime a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Sets timing level for the LIM daemon." .

hpc:timingLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Limtime ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the timing level." .

hpc:logfileName1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Limtime ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the log file name." .

hpc:isAdmin a owl:ObjectProperty ;
    rdfs:domain hpc:Limtime ;
    rdfs:range hpc:Lsfadmin ;
    rdfs:comment "Indicates if the user is the LSF administrator." .
