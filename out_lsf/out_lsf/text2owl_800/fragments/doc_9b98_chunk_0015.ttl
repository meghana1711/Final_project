hpc:Crossclusteruseraccountmapping a owl:Class .
hpc:Multiclusterenvironment a owl:Class .
hpc:jobsubmission a owl:ObjectProperty .
hpc:jobexecution a owl:ObjectProperty .
hpc:useraccountmapping a owl:ObjectProperty .
hpc:Differentuseraccounts a owl:Class .
hpc:Host a owl:Class .

hpc:Crossclusteruseraccountmapping rdfs:subClassOf hpc:Multiclusterenvironment .
hpc:Jobsubmission rdfs:domain hpc:Crossclusteruseraccountmapping ;
                    rdfs:range hpc:Job .
hpc:Jobexecution rdfs:domain hpc:Crossclusteruseraccountmapping ;
                    rdfs:range hpc:Job .
hpc:Useraccountmapping rdfs:domain hpc:Crossclusteruseraccountmapping ;
                      rdfs:range hpc:Useraccount .
hpc:Differentuseraccounts rdfs:subClassOf hpc:Useraccount .
hpc:Host rdfs:subClassOf hpc:Cluster .
