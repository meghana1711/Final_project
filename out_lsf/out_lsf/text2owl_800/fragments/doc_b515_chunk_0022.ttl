hpc:Enclosure
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf [ rdf:type owl:ObjectProperty ;
                      rdfs:domain hpc:Enclosure ;
                      rdfs:range xsd:nonNegativeInteger ] .

hpc:Job
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:subClassOf [ rdf:type owl:ObjectProperty ;
                      rdfs:domain hpc:Job ;
                      rdfs:range hpc:Enclosure ] .

hpc:prefMaxAvail
    a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunit .

hpc:maxcus
    a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:freeSlots
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:nonNegativeInteger .
