hpc:Slurm a owl:Class.
hpc:Slurmd a owl:Class;
    rdfs:subClassOf hpc:Slurmdaemon.
hpc:Slurmctld a owl:Class;
    rdfs:subClassOf hpc:Slurmdaemon.

hpc:Computenode a owl:Class;
    rdfs:subClassOf hpc:Node.

hpc:Managementnode a owl:Class;
    rdfs:subClassOf hpc:Node.

hpc:Partition a owl:Class;
    rdfs:subClassOf hpc:Jobqueue.

hpc:Job a owl:Class;
    rdfs:subClassOf hpc:Allocation.

hpc:Jobstep a owl:Class.

hpc:allocateresource a owl:ObjectProperty;
    rdfs:domain hpc:Slurm;
    rdfs:range hpc:Job.

hpc:executework a owl:ObjectProperty;
    rdfs:domain hpc:Slurm;
    rdfs:range hpc:Job.

hpc:arbitrate
