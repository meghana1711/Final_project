hpc:Awsec2instance a owl:Class .
hpc:Awsec2instance rdfs:subClassOf owl:Thing .

hpc:hasSecurityGroup rdf:type owl:ObjectProperty .
hpc:Hassecuritygroup rdfs:domain hpc:Awsec2instance ;
                          rdfs:range rdf:Resource .

hpc:hasVPC rdf:type owl:ObjectProperty .
hpc:Hasvpc rdfs:domain hpc:Awsec2instance ;
                          rdfs:range rdf:Resource .

hpc:hasSubnet rdf:type owl:ObjectProperty .
hpc:Hassubnet rdfs:domain hpc:Awsec2instance ;
                          rdfs:range rdf:Resource .

hpc:isPublicSubnet owl:FunctionalProperty .
hpc:Ispublicsubnet rdfs:domain hpc:Subnet .
hpc:Ispublicsubnet rdfs:range xsd:boolean .

hpc:hasAutoAssignPublicIP rdf:type owl:ObjectProperty .
hpc:Hasautoassignpublicip rdfs:domain hpc:Awsec2instance ;
                               rdfs:range xsd:boolean .

hpc:hasManagementHost rdf:type owl:ObjectProperty .
hpc:Hasmanagementhost rdfs:domain hpc:Awsec2instance ;
                             rdfs:range rdf:Resource .

hpc:isOnSameNetworkAs rdf:type owl:ObjectProperty .
hpc:Isonsamenetworkas rdfs:domain hpc:Managementhost ;
                              rdfs:range hpc:Awsec2instance .

hpc:hasPrivateDNS rdf:type owl:DatatypeProperty .
hpc:Hasprivatedns rdfs:domain hpc:Awsec2instance ;
                       rdfs:range xsd:string .

hpc:Lsfserverhostonawsec2instance a owl:Class .
hpc:Lsfserverhostonawsec2instance rdfs:subClassOf hpc:Awsec2instance .

hpc:awsprovTemplatesjsonfile a owl:DatatypeProperty .
hpc:AwsprovTemplatesjsonfile rdfs:domain hpc:Lsfserverhostonawsec2instance ;
                                 rdfs:range xsd:string .
