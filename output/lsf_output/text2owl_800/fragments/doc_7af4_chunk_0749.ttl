hpc:LSB_RC_MQTT_ERROR_LIMIT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the maximum number of messages that the badmin rc error command displays for each host provider." .

hpc:LSB_RC_QUERY_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:integer ;
    rdfs:comment "The interval in seconds that the resource connector checks host status and asynchronous requests from a resource provider." .

hpc:LSB_RC_REQUEUE_BUFFER
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of seconds before the expiration of the reclaim grace period before which LSF starts to send re-queue signals to running jobs on reclaimed hosts." .

hpc:LSB_RC_TEMPLATE_REQUEST_DELAY
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of time that LSF waits before repeating a request for a template, in minutes, if the ebrokerd daemon encountered certain provider errors in a previous request." ;
    rdfs:comment "This parameter takes effect if the ebrokerd daemon encounters one of the following provider errors when requesting a template from the host provider API: InsufficientAddressCapacity: Not enough available addresses to satisfy the minimum request." .
