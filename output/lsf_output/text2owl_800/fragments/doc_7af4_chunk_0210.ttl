hpc:slots a owl:ObjectProperty .
hpc:Hasslots rdfs:domain hpc:Limit ;
                        rdfs:range xsd:nonNegativeInteger .

hpc:swp a owl:ObjectProperty .
hpc:Hasswp rdfs:domain hpc:Limit ;
                        rdfs:range xsd:nonNegativeInteger .
