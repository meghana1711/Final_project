hpc:Job a owl:Class .

hpc:state a owl:ObjectProperty .
hpc:state rdfs:domain hpc:Job .
hpc:state rdfs:range xsd:string .
hpc:state rdfs:subPropertyOf rdf:list .
hpc:state rdfs:member hpc:SIGNALING , hpc:STAGE_OUT .

hpc:time a owl:Class .

hpc:eligible a owl:DatatypeProperty .
hpc:eligible rdfs:domain hpc:Job .
hpc:eligible rdfs:range xsd:string .

hpc:end a owl:DatatypeProperty .
hpc:end rdfs:domain hpc:Job .
hpc:end rdfs:range xsd:string .

hpc:limit a owl:DatatypeProperty .
hpc:limit rdfs:domain hpc:Job .
hpc:limit rdfs:range xsd:integer .

hpc:planned a owl:DatatypeProperty .
hpc:planned rdfs:domain hpc:Job .
hpc:planned rdfs:range xsd:integer .

hpc:start a owl:DatatypeProperty .
hpc:start rdfs:domain hpc:Job .
hpc:start rdfs:range xsd:string .

hpc:submission a owl:DatatypeProperty .
hpc:submission rdfs:domain hpc:Job .
hpc:submission rdfs:range xsd:string .

hpc:wckey a owl:DatatypeProperty .
hpc:wckey rdfs:domain hpc:Job .
hpc:wckey rdfs:range xsd:string .

hpc:argv a owl:DatatypeProperty .
hpc:argv rdfs:domain hpc:Job_desc_msg .
hpc:argv rdfs:range xsd:string .

hpc:begin_time a owl:DatatypeProperty .
hpc:begin_time rdfs:domain hpc:Job_desc_msg .
hpc:begin_time rdfs:range xsd:integer .

hpc:constraints a owl:DatatypeProperty .
hpc:constraints rdfs:domain hpc:Job_desc_msg .
hpc:constraints rdfs:range xsd:string .

hpc:cpu_binding_flags a owl:DatatypeProperty .
