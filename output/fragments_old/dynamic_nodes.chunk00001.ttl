hpc:MaxNodeCount rdfs:domain hpc:SlurmConfiguration ;
    rdfs:range xsd:integer .

hpc:SelectType rdfs:domain hpc:SlurmConfiguration ;
    rdfs:range hpc:SelectType .

hpc:Partition rdfs:subClassOf hpc:SlurmWorkloadManager .
hpc:Nodeset rdfs:subClassOf hpc:Partition .
