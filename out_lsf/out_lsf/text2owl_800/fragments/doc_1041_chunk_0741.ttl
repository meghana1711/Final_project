hpc:Commandusage a owl:Class .
hpc:Groupadmin a owl:Class .
hpc:Usergroup a owl:Class .

# Object Properties
hpc:hasadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range hpc:Groupadmin .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .
hpc:hasugfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:decimal .
hpc:hasusershare a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:decimal .

# Datatype Properties
hpc:hasoptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandusage .
hpc:hasreleaseversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandusage .
hpc:hassynopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup .
hpc:hasdescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup .
