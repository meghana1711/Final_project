hpc:Resourcemanagement a owl:Class .
hpc:containersupport a owl:ObjectProperty .
hpc:lsfcontainersupport a owl:ObjectProperty .
hpc:commandoutputformatting a owl:ObjectProperty .
hpc:otherlsfchanges a owl:ObjectProperty .
hpc:jobschedulingandexecution a owl:ObjectProperty .
hpc:killjobs a owl:ObjectProperty .
hpc:recordjobsasdone a owl:ObjectProperty .
hpc:bkilldcommandoption a owl:DatatypeProperty .
hpc:killjobsbystatus a owl:ObjectProperty .
hpc:bkillstatcommandoption a owl:DatatypeProperty .

hpc:Resourcemanagement rdfs:subClassOf owl:Class .
hpc:Containersupport rdfs:domain hpc:Resourcemanagement ;
                          rdfs:range hpc:Resourcemanagement .
hpc:Lsfcontainersupport rdfs:domain hpc:Resourcemanagement ;
                          rdfs:range hpc:Lsf .
hpc:Commandoutputformatting rdfs:domain hpc:Resourcemanagement ;
                             rdfs:range hpc:Resourcemanagement .
hpc:Otherlsfchanges rdfs:domain hpc:Resourcemanagement ;
                      rdfs:range hpc:Resourcemanagement .
hpc:Jobschedulingandexecution rdfs:domain hpc:Resourcemanagement ;
                               rdfs:range hpc:Job .
hpc:Killjobs rdfs:domain hpc:Jobschedulingandexecution ;
               rdfs:range hpc:Job .
hpc:Recordjobsasdone rdfs:domain hpc:Jobschedulingandexecution ;
                      rdfs:range xsd:boolean .
hpc:Bkilldcommandoption rdfs:domain hpc:Jobschedulingandexecution ;
                          rdfs:range xsd:string .
hpc:Killjobsbystatus rdfs:domain hpc:Jobschedulingandexecution ;
                       rdfs:range xsd:string .
hpc:Bkillstatcommandoption rdfs:domain hpc:Jobschedulingandexecution ;
                             rdfs:range xsd:string .
