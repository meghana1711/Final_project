hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:userpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .

hpc:swapspace a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:apspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Job a owl:Class .
hpc:Queue a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .

hpc:haspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobpriority .

hpc:belongstoqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .

hpc:hasuserpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Userpriority .

hpc:hasswapspace a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Swapspace .

hpc:apsPriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:ApsConfiguration a owl:Class .
hpc:ApsPriorityCalculation a owl:Class .

hpc:ApsConfiguration rdfs:subClassOf owl:Class .
hpc:ApsPriorityCalculation rdfs:subClassOf hpc:ApsConfiguration .

hpc:APS_Priority_Calculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ApsConfiguration ;
    rdfs:range xsd:integer .

hpc:apsPriorityCalculationFormula a owl:ObjectProperty ;
    rdfs:domain hpc:ApsPriorityCalculation ;
    rdfs:range xsd:string .

hpc:APS_Priority_Calculation_Formula "1 * (1 * job_priority + 10 * queue_priority) + 100 * user_priority + 1 * (-10 * SWAP)" .

hpc:apsConfigurationWeight a owl:ObjectProperty ;
    rdfs:domain hpc:ApsConfiguration ;
    rdfs:range hpc:ApsConfigurationWeight .

hpc:ApsConfigurationWeight a owl:Class .

hpc:apsConfigurationWeightJobpriority a owl:ObjectProperty ;
    rdfs:domain hpc:ApsConfigurationWeight ;
    rdfs:range hpc:Jobpriority
