hpc:JobContainer a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A container for a job in Slurm." .

# Tmpfs Job Container
hpc:TmpfsJobContainer a owl:Class ;
    rdfs:subClassOf hpc:JobContainer ;
    rdfs:comment "A JobContainer that uses the tmpfs plugin." .

# JobContainerConf
hpc:JobContainerConf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A configuration file for a JobContainer." .

# SlurmConf
hpc:SlurmConf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A configuration file for Slurm." .

# JobContainerMount
hpc:JobContainerMount a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A mount created inside a JobContainer." .

# BasePath
hpc:BasePath a owl:DatatypeProperty ;
    rdfs:domain hpc:JobContainer ;
    rdfs:range xsd:string ;
    rdfs:comment "The base path used to construct the mount path." .

# JobSpecificDirectory
hpc:JobSpecificDirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A directory created inside the base path for a specific job." .

# MountPath
hps:MountPath a owl:DatatypeProperty ;
    rdfs:domain hpc:JobContainerMount ;
    rdfs:range xsd:string ;
    rdfs:comment "The path where /tmp is mounted." .

# PrivateMount
hpc:PrivateMount a owl:ObjectProperty ;
    rdfs:domain hpc:JobContainer ;
    rdfs:range hpc:JobContainerMount ;
    rdfs:comment "A JobContainerMount that is private to the job." .

# JobId
hpc:JobId a owl:DatatypeProperty ;
    rdfs:domain hpc:JobContainer ;
    rdfs:range xsd:integer ;
    rdfs:comment "The ID of the job." .

# MountNamespace
hpc:MountNamespace a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A namespace created for a JobContainer." .

# PrivateMountNamespace
hpc:PrivateMountNamespace a owl:ObjectProperty ;
    rdfs:domain hpc:JobContainer ;
    rdfs:range hpc:MountNamespace ;
    rdfs:comment "A MountNamespace that is private to the job." .

# JobSpankEnvironment
hpc:JobSpankEnvironment a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The environment set up for a job's spank." .

# InitializationScript
hpc:InitializationScript a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An optional initialization script for a JobContainer." .

# SiteSpecificCustomization
hpc:Site
