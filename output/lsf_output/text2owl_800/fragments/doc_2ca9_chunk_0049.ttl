hpc:Preemptivescheduling a owl:Class .
hpc:Enablinggpufeatures a owl:Class .
hpc:Gpujob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:mode a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:string .

hpc:lsbGpuNewSyntax a owl:DatatypeProperty ;
    rdfs:domain hpc:Configuration .

hpc:Jobschedulingandexecution a owl:Class .
hpc:submitasotheruser a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingandexecution ;
    rdfs:range hpc:Job .

hpc:bsubmitcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Submitasotheruser ;
    rdfs:range hpc:Command .

hpc:lsfusermapping a owl:ObjectProperty ;
    rdfs:domain hpc:Submitasotheruser ;
    rdfs:range hpc:Configuration .
