hpc:Admin1
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an administrative job level." .

hpc:PreExec
    a owl:ObjectProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:string ;
    rdfs:comment "An action executed before a job runs." .

hpc:PostExec
    a owl:ObjectProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:string ;
    rdfs:comment "An action executed after a job finishes." .

hpc:HostPreExec
    a owl:ObjectProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:string ;
    rdfs:comment "A host-based action executed before a job runs." .

hpc:HostPostExec
    a owl:ObjectProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:string ;
    rdfs:comment "A host-based action executed after a job finishes." .

hpc:NJOBS
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of jobs." .

hpc:PEND
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of pending jobs." .

hpc:RUN
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of running jobs." .

hpc:SSUSP
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of suspended jobs." .

hpc:USUSP
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of user-suspended jobs." .

hpc:RSV
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Admin1 ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of reserved jobs." .
