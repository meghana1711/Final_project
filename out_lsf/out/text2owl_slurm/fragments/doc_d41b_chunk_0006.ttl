hpc:GrpSubmitJobs
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The total number of jobs able to be submitted to the system at any given time from an association and its children." .

hpc:GrpTRES
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The total count of TRES able to be used at any given time from jobs running from an association and its children." ;
    rdfs:domain hpc:Grptres .

hpc:GrpTRESRunMins
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Used to limit the combined total number of TRES minutes used by all jobs running with an association and its children." ;
    rdfs:domain hpc:Grptres .

hpc:GrpWall
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The maximum wall clock time running jobs are able to be allocated in aggregate for an association and its children." .

hpc:hasSubmitJobLimit
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grpsubmitjobs ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasTRESLimit
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grptres ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasTRESRunMinsLimit
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grptresrunmins ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasWallClockTimeLimit
    a owl:ObjectProperty ;
    rdfs:domain hpc:Grpwall ;
    rdfs:range xsd:nonNegativeTime .
