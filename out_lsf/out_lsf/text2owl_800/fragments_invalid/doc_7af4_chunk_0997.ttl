hpc:LsfStartupUsers a owl:Class .
hpc:AllAdmins a owl:Class .
hpc:lsfClusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:AllAdmins ;
    rdfs:range xsd:string .
hpc:LsfStartupUsersUser a owl:Class ;
    rdfs:subClassOf hpc:LsfStartupUsers .
hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:LsfStartupUsers ;
    rdfs:range xsd:string .
hpc:NotRecommended a owl:Class ;
    rdfs:subClassOf hpc:LsfStartupUsers .
hpc:WindowsHost a owl:Class .
hpc:ServicesAdminGroup a owl:Class .
hpc:canStartDaemons a owl:ObjectProperty ;
    rdfs:domain hpc:LsfStartupUsers ;
    rdfs:range hpc:LsfStartupUsers .
hpc:lsfStartupPath a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfStartupUsers .
hpc:LsfUsermapping a owl:Class .
hpc:JobExecutionUser a owl:Class .
hpc:JobSubmissionUser a owl:Class .
hpc:usermappingFile a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfUsermapping ;
    rdfs:range xsd:string .
hpc:bsubmitCommand a owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmissionUser ;
    rdfs:range xsd:string .
hpc:ExampleBsubmitCommand a owl:Class ;
    rdfs:subClassOf hpc:BsubmitCommand .
hpc:buildFromSource a owl:ObjectProperty ;
    rdfs:domain hpc:ExampleBsubmitCommand ;
    rdfs:range xsd:string .
hpc:githubRepo a owl:DatatypeProperty ;
    rdfs:domain hpc:ExampleBsubmitCommand ;
    rdfs:range xsd:string .
hpc:mapJobExecutionUsers a owl:ObjectProperty ;
    rdfs:domain hpc:LsfUsermapping ;
    rdfs:range hpc:JobExecutionUser .
hpc:mapJobSubmissionUsers a owl:ObjectProperty ;
    rdfs:domain hpc:LsfUsermapping ;
    rdfs:range hpc:JobSubmissionUser .
hpc:$LSF_ENVDIR a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfUsermapping .
