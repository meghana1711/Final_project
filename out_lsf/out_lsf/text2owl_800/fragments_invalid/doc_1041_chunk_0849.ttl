hpc:Host a owl:Class .
hpc:Localhost rdfs:subClassOf hpc:Host .
hpc:Commandlineinput rdfs:subClassOf hpc:Host .

hpc:Hostname rdfs:domain hpc:Host .
hpc:Hostname rdfs:range xsd:string .

hpc:Path rdfs:subClassOf hpc:Host .
hpc:Absolutepath rdfs:subClassOf hpc:Path .
hpc:Relativepath rdfs:subClassOf hpc:Path .
hpc:Absolutepath rdfs:domain hpc:Host .
hpc:Relativepath rdfs:domain hpc:Host .
hpc:Path rdfs:range xsd:string .

hpc:File a owl:Class .
hpc:Filename rdfs:domain hpc:File .
hpc:Filename rdfs:range xsd:string .
hpc:Filename rdfs:range restrict rdfs:pattern ^[^:]+$ .

hpc:Localfile rdfs:subClassOf hpc:File .
hpc:Remotefile rdfs:subClassOf hpc:File .

hpc:copycommand a owl:ObjectProperty .
hpc:Copycommand rdfs:domain hpc:Commandlineinput .
hpc:Copycommand rdfs:range hpc:File .
hpc:Copycommand rdfs:range hpc:Host .

hpc:LocalToRemote rdfs:subPropertyOf hpc:CopyCommand .
hpc:RemoteToLocal rdfs:subPropertyOf hpc:CopyCommand .

hpc:WindowsToWindows rdfs:subPropertyOf hpc:LocalToRemote .
hpc:WindowsToWindows rdfs:subPropertyOf hpc:RemoteToLocal .
hpc:Windowstowindows rdfs:domain hpc:Localfile .
hpc:Windowstowindows rdfs:range hpc:Remotefile .
hpc:WindowsToWindows rdf:value "\\" .

hpc:UnixToUnix rdfs:subPropertyOf hpc:LocalToRemote .
hpc:UnixToUnix rdfs:subPropertyOf hpc:RemoteToLocal .
hpc:Unixtounix rdfs:domain hpc:Localfile .
hpc:Unixtounix rdfs:range hpc:Remotefile .
hpc:UnixToUnix rdf:value "/" .

hpc:UnixToWindows rdfs:subPropertyOf hpc:LocalToRemote .
hpc:UnixToWindows rdfs:subPropertyOf hpc:RemoteToLocal .
hpc:Unixtowindows rdfs:domain hpc:Localfile .
hpc:Unixtowindows rdfs:range hpc:Remotefile .
hpc:UnixToWindows rdf:value "/" .

hpc:WindowsToUnix rdfs:subPropertyOf hpc:LocalToRemote .
hpc:WindowsToUnix rdfs:subPropertyOf hpc:RemoteToLocal .
hpc:Windowstounix rdfs:domain hpc:Remotefile .
hpc:Windowstounix rdfs:range hpc:Localfile .
hpc:WindowsToUnix rdf:value "/" .
