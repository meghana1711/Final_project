hpc:Interactivejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Standardinput hpc:objectproperty ;
    rdfs:domain hpc:Interactivejob ;
    rdfs:range xsd:string .

hpc:Standardoutput hpc:datatypeproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:range hpc:Outputfile .

hpc:Standarderror hpc:datatypeproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:range hpc:Errorfile .

hpc:Checkpointable hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Rerunnable hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Tty hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Executionhost hpc:class ;
    rdfs:subClassOf hpc:Host .

hpc:Submissionhost hpc:class ;
    rdfs:subClassOf hpc:Host .

hpc:Ssh hpc:objectproperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range hpc:Submissionhost .

hpc:Troubleshooting hpc:objectproperty ;
    rdfs:domain hpc:Ssh ;
    rdfs:range hpc:String .

hpc:Protocolversionmismatch hpc:class ;
    rdfs:subClassOf hpc:Troubleshooting .

hpc:Keypairconfiguration hpc:class ;
    rdfs:subClassOf hpc:Troubleshooting .

hpc:Domainname hpc:class ;
    rdfs:subClassOf hpc:Troubleshooting .
