hpc:Mbatchdaemon a owl:Class .
hpc:lsbqueryport a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:integer .

hpc:mbdrefreshtime a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:integer .

hpc:newjobrefresh a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:boolean .

hpc:Operatingsystem a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:supportsthreadprogramming a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:boolean .

hpc:lsbqueryretryintervalstep a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:duration .

hpc:lsbntryvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbrcdefaulthosttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string .

hpc:LSBRCDefaultHostTypeDefaultValue a xsd:string ;
    rdfs:value "X86_64" .

hpc:lsbrcexternalhostflag a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:boolean .
