hpc:Job a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:Jobbasedresource a owl:Class .
hpc:Hostbasedresource a owl:Class .
hpc:Slotbasedresource a owl:Class .
hpc:Queuelevelrequirement a owl:Class .
hpc:Joblevelrequirement a owl:Class .

hpc:hasResourceRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirement .

hpc:Resourcerequirement rdfs:subClassOf hpc:Queuelevelrequirement ;
    rdfs:subClassOf hpc:Joblevelrequirement .

hpc:Jobbasedresource rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Jobbasedresource .

hpc:Hostbasedresource rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Hostbasedresource .

hpc:Slotbasedresource rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:domain hpc:Slotbasedresource .

hpc:mem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:duration rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:decay rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lic rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:nonNegativeInteger .
