hpc:SlurmPlugin a owl:Class .
hpc:hasPluginType a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPlugin ;
    rdfs:range xsd:string .
hpc:pluginType a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:hasPluginType ;
    rdfs:range xsd:string .
hpc:hasPluginName a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPlugin ;
    rdfs:range xsd:string .
hpc:pluginName a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:hasPluginName ;
    rdfs:range xsd:string .
hpc:hasPluginVersion a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPlugin ;
    rdfs:range xsd:unsignedInt .
hpc:pluginVersion a owl:DatatypeProperty ;
    rdfs:subPropertyOf hpc:hasPluginVersion ;
    rdfs:range xsd:unsignedInt .
hpc:NullPlugin a owl:Class ;
    rdfs:subClassOf hpc:SlurmPlugin .
hpc:NullPlugin_minorType a owl:DatatypeProperty ;
    rdfs:domain hpc:NullPlugin ;
    rdfs:range xsd:string ;
    rdfs:value "none" .
