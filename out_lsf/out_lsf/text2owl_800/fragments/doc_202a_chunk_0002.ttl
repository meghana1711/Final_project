hpc:Remotedesktopserver a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedesktopserver ;
    rdfs:range xsd:string .
hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedesktopserver ;
    rdfs:range xsd:nonNegativeInteger .
hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedesktopserver ;
    rdfs:range xsd:nonNegativeInteger .
hpc:increasing a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedesktopserver ;
    rdfs:range xsd:boolean .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedesktopserver ;
    rdfs:range xsd:string .
hpc:Jobsubmission a owl:Class .
hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:TerminalServer a hpc:RemoteDesktopServer ;
    hpc:ResourceName "term_server" ;
    hpc:Type 60 ;
    hpc:Increasing true ;
    hpc:Description "N (Terminal Server)" .
hpc:LSFLogonDesktop a xsd:boolean .
hpc:LSBTSJob a xsd:boolean .
