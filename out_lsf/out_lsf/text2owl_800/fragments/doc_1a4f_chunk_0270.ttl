hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A queue in LSF for job submission." .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A job submitted to a queue in LSF." .

hpc:runlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum run limit for jobs in a queue." .

hpc:defaultrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The default run limit for jobs in a queue." .

hpc:maxrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum (hard) run limit for jobs in a queue." .

hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue ;
    rdfs:comment "The queue to which a job is submitted." .

hpc:jobrunstate a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Runstate ;
    rdfs:comment "The current run state of a job." .

hpc:Runstate a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:comment "The run state of a job in LSF." .

hpc:RunState_RUN a owl:NamedIndividual ;
    rdf:value "RUN" .

hpc:jobkill a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Runstate ;
    rdfs:comment "Whether a job is killed by LSF." .
