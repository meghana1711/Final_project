hpc:Host a owl:Class .
hpc:Candidatehost a owl:Class .
hpc:GPUVendor a owl:Enum .
hpc:GPUVendor rdfs:member hpc:amd .
hpc:GPUVendor rdfs:member hpc:nvidia .
hpc:Gpuvendor rdfs:subClassOf xsd:string .

hpc:sharedgpuswithrunningjobs a owl:ObjectProperty .
hpc:Sharedgpuswithrunningjobs rdfs:domain hpc:Candidatehost .
hpc:Sharedgpuswithrunningjobs rdfs:range xsd:nonNegativeInteger .

hpc:nonexclusivegpus a owl:ObjectProperty .
hpc:Nonexclusivegpus rdfs:domain hpc:Candidatehost .
hpc:Nonexclusivegpus rdfs:range xsd:nonNegativeInteger .

hpc:order a owl:ObjectProperty .
hpc:Order rdfs:domain hpc:Candidatehost .
hpc:Order rdfs:range xsd:string .

hpc:gpupackpolicy a owl:ObjectProperty .
hpc:Gpupackpolicy rdfs:domain hpc:Candidatehost .
hpc:Gpupackpolicy rdfs:range xsd:string .

hpc:gpupackpolicySortpriority a owl:ObjectProperty .
hpc:GpupackpolicySortpriority rdfs:domain hpc:Gpupackpolicy .
hpc:GpupackpolicySortpriority rdfs:range xsd:string .

hpc:gpupackpolicySharedfirst a owl:ObjectProperty .
hpc:GpupackpolicySharedfirst rdfs:domain hpc:Gpupackpolicy .
hpc:GpupackpolicySharedfirst rdfs:range xsd:string .

hpc:gpupackpolicyNotexclusivenext a owl:ObjectProperty .
hpc:GpupackpolicyNotexclusivenext rdfs:domain hpc:Gpupackpolicy .
hpc:GpupackpolicyNotexclusivenext rdfs:range xsd:string .

hpc:runningjobs a owl:ObjectProperty .
hpc:Runningjobs rdfs:domain hpc:Gpu .
hpc:Runningjobs rdfs:range xsd:nonNegativeInteger .

hpc:Gpu a owl:Class .
hpc:Candidategpu a owl:Class .
hpc:gpuvendortype a owl:DatatypeProperty .
hpc:Gpuvendortype rdfs:domain hpc:Candidategpu .
hpc:Gpuvendortype rdfs:range hpc:Gpuvendor .

hpc:modelname a owl:DatatypeProperty .
hpc:Modelname rdfs:domain hpc:Candidategpu .
hpc:Modelname rdfs:range xsd:string .

hpc:memorysize a owl:DatatypeProperty .
hpc:Memorysize rdfs:domain hpc:Modelname .
hpc:Memorysize rdfs:range xsd:nonNegativeInteger .

hpc:scheduledgpu a owl:ObjectProperty .
hpc:Scheduledgpu rdfs:domain hpc:Candidategpu .
hpc:ScheduledGPU
