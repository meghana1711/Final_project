hpc:Memoryreservation a owl:Class .
hpc:Memoryintensivejob a owl:Class .
hpc:Sequentialjob a owl:Class .
hpc:resourcereserve a owl:ObjectProperty .
hpc:maxreservetime a owl:DatatypeProperty .
hpc:DispatchCycle a xsd:nonNegativeInteger .
hpc:Lsbqueues a owl:Class .
hpc:Lsbmodules a owl:Class .
hpc:Schplugin a owl:Class .
hpc:Schedulerpluginmodule a owl:Class .
hpc:schPlugin a owl:ObjectProperty .
hpc:SCH_DISABLE_PHASES a xsd:string .
hpc:schmodDefault a owl:ObjectProperty .
hpc:schmodReserve a owl:ObjectProperty .
hpc:schmodPreemption a owl:ObjectProperty .
hpc:Queue a owl:Class .
hpc:QueueName a xsd:string .
hpc:Description a xsd:string .
hpc:Priority a xsd:nonNegativeInteger .
hpc:Resourcereserve a rdfs:domain, rdfs:range [ hpc:Queue ] .
hpc:Maxreservetime a rdfs:domain [ hpc:Resourcereserve ] .
hpc:Reservationqueue a owl:Class .
hpc:Reservationqueue rdfs:subClassOf [ hpc:Queue ] .
hpc:Job a owl:Class .
hpc:requiresmemory a owl:DatatypeProperty .
hpc:Jobrequiresmemory a rdfs:domain [ hpc:Job ] .
hpc:Jobrequiresmemory rdfs:range xsd:nonNegativeInteger .
