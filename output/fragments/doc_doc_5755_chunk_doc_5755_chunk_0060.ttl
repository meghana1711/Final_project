hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:ComputationTask ;
    rdfs:comment "Represents a batch job in HPC system." .

hpc:SlurmJob a hpc:Job ;
    rdfs:comment "Represents a Slurm job." .

hpc:SlurmdLogFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The log file for a Slurm job." .

hpc:BatchNode a owl:Class ;
    rdfs:subClassOf hpc:ComputeNode ;
    rdfs:comment "A compute node that is part of a batch job's allocation." .

hpc:BatchStartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:BatchNode ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The start time of a batch node." .

hpc:BatchJobId a owl:DatatypeProperty ;
    rdfs:domain hpc:BatchNode ;
    rdfs:range xsd:string ;
    rdfs:comment "The ID of the batch job associated with a batch node." .

hpc:DebugOption a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The debug option set for a job." .

hpc:MissingBatchJobIdMessage a owl:ObjectProperty ;
    rdfs:domain hpc:BatchNode ;
    rdfs:range xsd:string ;
    rdfs:comment "The message indicating that a batch job ID is missing from a batch node." .

hpc:JobCanceled a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has been canceled." .

hpc:MemoryExhaustion a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has been canceled due to memory exhaustion." .

hpc:CriticalFailure a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that has been canceled due to a critical failure." .

hpc:MultiInstanceGPU a owl:Class ;
hpc:PMIx a owl:Class ;
hpc:hwloc a owl:Class ;
hpc:OpenCL a owl:Class ;
hpc:Slurmstepd a owl:Class ;
hpc:InfinibandHCA a owl:Class ;
hpc:SysfsFolder a owl:Class ;
hpc:NvidiaGPU a owl:Class ;

hpc:InUseByAnotherClientError a owl:Class ;
    rdfs:subClassOf hpc:Error ;
    rdfs:comment "An error indicating that a GPU is in use by another client." .

hpc:NotQueryingOpenCLDevices a owl:ObjectProperty ;
    rdfs:domain hpc:hwloc ;
    rdfs:range xsd:string ;
    rdfs:comment "The action of not querying OpenCL devices
