hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job submitted to a HPC system." .

hpc:Zerosizejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job with zero size." .

hpc:Burstbuffer a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a burst buffer resource." .

hpc:Persistentburstbuffer a owl:Class ;
    rdfs
