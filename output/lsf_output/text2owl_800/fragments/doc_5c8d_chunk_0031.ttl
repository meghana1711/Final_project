hpc:lsbStageTransferRate a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Specifies the estimated data transfer rate for direct data staging." .

hpc:lsbStepCgroupDefault a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the default value for the bsub -step_cgroup option for CSM jobs." .

hpc:csmValidSmt a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Defines a space-delimited list of valid SMT mode values." .

hpc:csmValidSmtDefault a owl:DatatypeProperty ;
    rdfs:domain hpc:CsmValidSmt ;
    rdfs:range xsd:string ;
    rdfs:comment "The first value is the default SMT mode for CSM jobs if the SMT mode is not specified at the queue or job level." .

hpc:reschedUponCsmSetupError a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables LSF to reschedule stage-in or non-transfer jobs that fail during CSM setup if they fail with the specified CSM API error codes." .
