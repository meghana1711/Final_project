hpc:Region
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The region that you select is used as the region of the VPC." .

hpc:Zone
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A zone within a region." .

hpc:VPC
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "A Virtual Private Cloud." .

hpc:hasRegion
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Location ] ;
    rdfs:range [ rdf:type hpc:Region ] ;
    rdfs:comment "The region associated with a Location." .

hpc:hasZone
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Location ] ;
    rdfs:range [ rdf:type hpc:Zone ] ;
    rdfs:comment "The zone associated with a Location." .

hpc:IPRangeSelection
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The IP range selection for a subnet." .

hpc:cannotChangeIPRange
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Iprangeselection ] ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the IP range can be changed after creating the subnet." .

hpc:defaultIPRange
    a owl:DatatypeProperty ;
    rdfs:domain [ rdf:type hpc:Iprangeselection ] ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The default IP range suitable for most purposes." .

hpc:createVirtualPrivateCloud
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Location ] ;
    rdfs:range [ rdf:type hpc:Vpc ] ;
    rdfs:comment "Creates a Virtual Private Cloud and subnet." .

hpc:createAnotherSubnet
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Vpc ] ;
    rdfs:range [ rdf:type hpc:Subnet ] ;
    rdfs:comment "Creates another subnet in the given VPC." .

hpc:VirtualPrivateCloud
    a owl:DatatypeProperty ;
    rdfs:domain [ rdf:type hpc:Subnet ] ;
    rdfs:range [ rdf:type hpc:Vpc ] ;
    rdfs:comment "The Virtual Private Cloud associated with the subnet." .

