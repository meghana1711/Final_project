hpc:Cgroup a owl:Class .
hpc:EventLogging a owl:Class .
hpc:LoggingVerbosity a owl:DatatypeProperty ;
    rdfs:domain hpc:EventLogging ;
    rdfs:range xsd:integer .
hpc:LogFile a owl:ObjectProperty ;
    rdfs:domain hpc:EventLogging ;
    rdfs:range xsd:string .
hpc:SlurmctldLogFile rdfs:subClassOf hpc:LogFile ;
    rdfs:comment "If empty, log goes to syslog" .
hpc:SlurmdLogFile rdfs:subClassOf hpc:LogFile ;
    rdfs:comment "String '%h' in name gets replaced with hostname" .
hpc:JobAccountingGather a owl:Class .
hpc:JobAcctGatherType a owl:ObjectProperty ;
    rdfs:domain hpc:JobAccountingGather ;
    rdfs:range xsd:string .
hpc:None a owl:Class ;
    rdfs:subClassOf hpc:JobAcctGatherType ;
    rdfs:comment "No job accounting" .
hpc:cgroup a owl:Class ;
    rdfs:subClassOf hpc:JobAcctGatherType ;
    rdfs:comment "Specific Linux cgroup information gathered, use with Linux systems only" .
hpc:Linux a owl:Class ;
    rdfs:subClassOf hpc:JobAcctGatherType ;
    rdfs:comment "Specific Linux process table information gathered, use with Linux systems only" .
hpc:JobAccountingStorage a owl:Class .
hpc:AccountingStorageType a owl:ObjectProperty ;
    rdfs:domain hpc:JobAccountingStorage ;
    rdfs:range xsd:string .
hpc:None a owl:Class ;
    rdfs:subClassOf hpc:AccountingStorageType ;
    rdfs:comment "No job accounting storage" .
hpc:SlurmDBD a owl:Class ;
    rdfs:subClassOf hpc:AccountingStorageType ;
    rdfs:comment "Write job accounting to SlurmDBD (database daemon)" .
hpc:ProcessIDLogging a owl:Class .
hpc:PidFile a owl:ObjectProperty ;
    rdfs:domain hpc:ProcessIDLogging ;
    rdfs:range xsd:string .
hpc:SlurmctldPidFile rdfs:subClassOf hpc:PidFile .
hpc:SlurmdPidFile rdfs:subClassOf hpc:PidFile .
```
