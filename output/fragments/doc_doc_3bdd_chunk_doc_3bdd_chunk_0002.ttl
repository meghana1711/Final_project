    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:MakefileAm rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:MakeRpmMk rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:META rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:README rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:slurmSpecIn rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:auxdir a owl:Class ;
    rdfs:subClassOf hpc:TopLevelDirectory .
hpc:contributedTools a owl:Class ;
    rdfs:subClassOf hpc:TopLevelDirectory .
hpc:documentation a owl:Class ;
    rdfs:subClassOf hpc:TopLevelDirectory .
hpc:manPages rdf:type xsd:string ;
    rdfs:domain hpc:Documentation ;
    rdfs:range rdf:PlainLiteral .
hpc:autoconf a owl:ObjectProperty .
hpc:make a owl:ObjectProperty .
hpc:buildAndInstallSlurm rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:buildProcess rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
hpc:copyright rdf:type xsd:string ;
    rdfs:domain hpc:TopLevelDirectory ;
    rdfs:range rdf:PlainLiteral .
hpc:disclaimer rdf:type xsd:string ;
    rdfs:domain hpc:TopLevelDirectory ;
    rdfs:range rdf:PlainLiteral .
hpc:autoconfVersion a owl:DatatypeProperty .
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range xsd:decimal .
