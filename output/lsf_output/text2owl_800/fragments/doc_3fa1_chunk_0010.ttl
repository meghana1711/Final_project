                 rdfs:range xsd:positiveInteger .
hpc:Step rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:positiveInteger .
hpc:propname a owl:ObjectProperty .
hpc:Hasindex rdfs:domain hpc:Jobarray ;
                 rdfs:range xsd:positiveInteger .
