hpc:LsbAcct a owl:Class .
hpc:mbatchdGeneratesRecord a owl:ObjectProperty .
hpc:recordLocation a owl:DatatypeProperty .
hpc:RecordLocation rdfs:domain hpc:LsbAcct ;
                     rdfs:range xsd:string .
hpc:recordStructure a owl:ObjectProperty .
hpc:RecordStructure rdfs:domain hpc:LsbAcct ;
                     rdfs:range xsd:string .
hpc:Field a owl:Class .
hpc:fieldValue a owl:DatatypeProperty .
hpc:FieldValue rdfs:domain hpc:Field ;
                 rdfs:range xsd:string .
hpc:UnavailableValue a owl:Class .
hpc:UnavailableValue rdfs:subClassOf hpc:Field .
hpc:fieldSeparator a owl:ObjectProperty .
hpc:FieldSeparator rdfs:domain hpc:RecordStructure ;
                     rdfs:range xsd:string .
hpc:acctArchiveAge a owl:DatatypeProperty .
hpc:AcctArchiveAge rdfs:domain hpc:LsbParams ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:acctArchiveSize a owl:DatatypeProperty .
hpc:AcctArchiveSize rdfs:domain hpc:LsbParams ;
                      rdfs:range xsd:nonNegativeInteger .
