hpc:Host a owl:Class .
hpc:Queue a owl:Class .
hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Hostlist a owl:Class .
    rdfs:subClassOf [ a owl:Class ;
                        owl:onProperty hpc:hasHost ;
                        owl:hasValue rdf:List ] .
hpc:Hostlist rdfs:subClassOf rdf:List .
hpc:Hostlist rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:hasHost ;
    owl:allValuesFrom rdf:List ;
    owl:cardinality 1 .
