hpc:Localmaxpreexecretryaction a owl:Class .
hpc:LOCAL_MAX_PREEXEC_RETRY_ACTION rdfs:label "LOCAL_MAX_PREEXEC_RETRY_ACTION"@en ;
                                    rdfs:comment "The default behavior of a job when it reaches the maximum number of times to attempt its pre-execution command on the local cluster"@en .

hpc:hasvalue a owl:ObjectProperty ;
            rdfs:domain hpc:Localmaxpreexecretryaction ;
            rdfs:range xsd:string .

hpc:SUSPEND rdf:type hpc:hasValue ;
            hpc:hasValue "SUSPEND" .

hpc:EXIT rdf:type hpc:hasValue ;
        hpc:hasValue "EXIT" .

hpc:Localmaxpreexecretryactiondefault a owl:Class ;
                                      rdfs:subClassOf hpc:Localmaxpreexecretryaction ;
                                      rdfs:label "LocalMaxPreexecRetryActionDefault"@en ;
                                      rdfs:comment "The default value of LOCAL_MAX_PREEXEC_RETRY_ACTION"@en .

hpc:LocalMaxPreexecRetryActionDefault rdf:type hpc:hasValue ;
                                       hpc:hasValue "SUSPEND" .

hpc:LsbCleanPdoneTimeout a owl:Class .
hpc:LSB_CLEAN_PDONE_TIMEOUT rdfs:label "LSB_CLEAN_PDONE_TIMEOUT"@en ;
                              rdfs:comment "Parameter to indicate the maximum amount of time to wait, before cleaning out the finished jobs that remain in DONE state that cannot move to PDONE state"@en .

hpc:hasvaluetimeout a owl:ObjectProperty ;
                      rdfs:domain hpc:LsbCleanPdoneTimeout ;
                      rdfs:range xsd:integer .

hpc:LSB_CLEAN_PDONE_TIMEOUT_GreaterThanZero rdf:type rdfs:Class ;
                                              rdfs:subClassOf hpc:LsbCleanPdoneTimeout ;
                                              rdfs:label "LSB_CLEAN_PDONE_TIMEOUT_GreaterThanZero"@en ;
                                              rdfs:comment "Value of LSB_CLEAN_PDONE_TIMEOUT greater than zero"@en .

hpc:LSB_CLEAN_PDONE_TIMEOUT_GreaterThanZero rdf:type hpc:hasValueTimeout ;
                                             hpc:hasValueTimeout "0" .
