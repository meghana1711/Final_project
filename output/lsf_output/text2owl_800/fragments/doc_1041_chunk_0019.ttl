hpc:Accountname a owl:Class .
hpc:accountnames a owl:ObjectProperty .
hpc:Accountnames rdfs:domain hpc:Accountname .
hpc:Accountnames rdfs:range rdf:List .
hpc:Accountnames rdfs:range rdf:Data .
hpc:Accountname rdfs:subClassOf xsd:string .

hpc:Timeinterval a owl:Class .
hpc:time a owl:DatatypeProperty .
hpc:Time rdfs:domain hpc:Timeinterval .
hpc:Time rdfs:range xsd:dateTime .

hpc:Serviceclass a owl:Class .
hpc:serviceclassname a owl:ObjectProperty .
hpc:Serviceclassname rdfs:domain hpc:Serviceclass .
hpc:Serviceclassname rdfs:range rdf:Literal .

hpc:Reservationid a owl:Class .
hpc:reservationids a owl:ObjectProperty .
hpc:Reservationids rdfs:domain hpc:Reservationid .
hpc:Reservationids rdfs:range rdf:List .
hpc:Reservationids rdfs:range rdf:Data .
hpc:Reservationid rdfs:subClassOf xsd:string .

hpc:Advancereservation a owl:Class .
hpc:advancereservationid a owl:DatatypeProperty .
hpc:Advancereservationid rdfs:domain hpc:Advancereservation .
hpc:Advancereservationid rdfs:range xsd:string .

hpc:Reservationmodification a owl:Class .
hpc:reservationmodificationhistory a owl:ObjectProperty .
hpc:Reservationmodificationhistory rdfs:domain hpc:Reservationmodification .
hpc:Reservationmodificationhistory rdfs:range rdf:List .
hpc:Reservationmodificationhistory rdfs:range rdf:Data .

hpc:User a owl:Class .
hpc:username a owl:DatatypeProperty .
hpc:Username rdfs:domain hpc:User .
hpc:Username rdfs:range xsd:string .

hpc:Localcluster a owl:Class .
hpc:localreservation a owl:ObjectProperty .
hpc:Localreservation rdfs:domain hpc:Advancereservation .
hpc:Localreservation rdfs:range hpc:Localcluster .
