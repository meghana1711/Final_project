hpc:Cgroup a owl:Class .
hpc:Unifiedhierarchy a owl:Class .
hpc:topdownconstraint a owl:ObjectProperty .
hpc:resourcesdistribution a owl:ObjectProperty .
hpc:controllersfile a owl:DatatypeProperty .
hpc:subtreecontrolfile a owl:DatatypeProperty .
hpc:nointernalprocessconstraint a owl:ObjectProperty .
hpc:Cgroupv1 a owl:Class .
hpc:Cgroupv2 a owl:Class .
hpc:systemddependency a owl:ObjectProperty .
hpc:Slurmdscope a owl:Class .
hpc:Slurmstepdscope a owl:Class .
hpc:dbuscall a owl:ObjectProperty .
hpc:systemdcontrolgroupinterface a owl:DatatypeProperty .

hpc:Cgroup rdfs:subClassOf hpc:Cgroupv1, hpc:Cgroupv2 .
hpc:Unifiedhierarchy rdfs:subClassOf hpc:Cgroupv2 .
hpc:Topdownconstraint rdfs:domain hpc:Cgroupv2 ;
    rdfs:range hpc:Cgroup .
hpc:Resourcesdistribution rdfs:domain hpc:Cgroupv2 ;
    rdfs:range hpc:Cgroup .
hpc:Controllersfile rdfs:domain hpc:Cgroupv2 ;
    rdfs:range xsd:string .
hpc:Subtreecontrolfile rdfs:domain hpc:Cgroupv2 ;
    rdfs:range xsd:string .
hpc:Nointernalprocessconstraint rdfs:domain hpc:Cgroupv2 ;
    rdfs:range hpc:Cgroup .
hpc:Cgroupv1 rdfs:subClassOf hpc:Cgroup .
hpc:Cgroupv2 rdfs:subClassOf hpc:Cgroup .
hpc:Slurmdscope rdfs:subClassOf hpc:Cgroupv2 .
hpc:Slurmstepdscope rdfs:subClassOf hpc:Cgroupv2 .
hpc:Dbuscall rdfs:domain hpc:Slurmstepdscope ;
    rdfs:range xsd:string .
hpc:Systemdcontrolgroupinterface rdfs:domain hpc:Cgroupv2 ;
    rdfs:range xsd:string .
