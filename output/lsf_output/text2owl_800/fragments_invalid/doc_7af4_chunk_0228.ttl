hpc:Host a owl:Class .
hpc:Hasloadsched hpc:objectproperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Hasloadstop hpc:objectproperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Affinityscheduling hpc:objectproperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:Affinitycpus hpc:datatypeproperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Affinityjob a owl:Class .
hpc:Cpu a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Cpulist a owl:Class ;
    rdfs:subClassOf hpc:List .
hpc:Cpurange a owl:Class ;
    rdfs:subClassOf hpc:Range .
hpc:Host
    a owl:Class ;
    hpc:hasLoadSched [ rdf:value "mem>=100 && swp>=200" ] ;
    hpc:hasLoadStop [ rdf:value "mem < 10 || swp < 30" ] ;
    hpc:affinityScheduling y ;
    hpc:affinityCpus "" .
hpc:CPU_LIST "1,3,5,7-10" a hpc:CPUList .
hpc:CPU_RANGE "7-10" a hpc:CPURange .
