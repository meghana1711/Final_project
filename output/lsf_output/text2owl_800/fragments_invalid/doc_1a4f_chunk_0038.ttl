hpc:Cluster a owl:Class .
hpc:Resourcemap a owl:Class .
hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:location a owl:ObjectProperty .

hpc:Resourcemap rdfs:subClassOf owl:Class .
hpc:Resource rdfs:subClassOf hpc:Cluster .

hpc:Resourcename rdfs:domain hpc:Resource .
hpc:Resourcename rdfs:range xsd:string .

hpc:Location rdfs:domain hpc:Resourcemap .
hpc:Location rdfs:range rdf:List .
hpc:Location rdfs:range rdf:first owl:ObjectProperty .
hpc:Location rdfs:range rdf:rest owl:ObjectProperty .

hpc:Location rdf:first rdfs:domain hpc:Location .
hpc:Location rdf:first rdfs:range xsd:string .

hpc:Location rdf:rest rdfs:domain hpc:Location .
hpc:Location rdf:rest rdfs:range hpc:Location .

hpc:AllHosts rdf:parseType xsd:anyURI .
hpc:HostName rdf:parseType xsd:string .
hpc:Not rdf:parseType xsd:string .

hpc:allhostsmap a owl:ObjectProperty .
hpc:resourcemapmap a owl:ObjectProperty .
hpc:specifichostsmap a owl:ObjectProperty .

hpc:Allhostsmap rdfs:domain hpc:Resourcemap .
hpc:Allhostsmap rdfs:range hpc:Allhosts .

hpc:Resourcemapmap rdfs:domain hpc:Resource .
hpc:Resourcemapmap rdfs:range hpc:Resourcemap .

hpc:Specifichostsmap rdfs:domain hpc:Resource .
hpc:Specifichostsmap rdfs:range rdf:List .
hpc:Specifichostsmap rdfs:range rdf:first owl:ObjectProperty .
hpc:Specifichostsmap rdfs:range rdf:rest owl:ObjectProperty .

hpc:Specifichostsmap rdf:first rdfs:domain hpc:Specifichostsmap .
hpc:Specifichostsmap rdf:first rdfs:range xsd:string .

hpc:Specifichostsmap rdf:rest rdfs:domain hpc:Specifichostsmap .
hpc:Specifichostsmap rdf:rest rdfs:range hpc:Hostname .

hpc:SetOfHosts rdf:parseType xsd:anyURI .

hpc:setofhostsmap a owl:ObjectProperty .

hpc:Setofhostsmap rdfs:domain hpc:Specifichostsmap .
hpc:Setofhostsmap rdfs:range hpc:Setofhosts .

hpc:Setofhosts rdfs:subClassOf rdf:List .
hpc:Setofhosts rdfs:subClassOf rdf:Seq .

hpc:Setofhosts rdf:first rdfs:domain hpc:Setofhosts .
