hpc:File a owl:Class .
hpc:Directory a owl:Class .
hpc:permission a owl:ObjectProperty .
hpc:owner a owl:ObjectProperty .
hpc:group a owl:ObjectProperty .
hpc:otherusers a owl:ObjectProperty .

hpc:File rdfs:subClassOf hpc:Resource .
hpc:Directory rdfs:subClassOf hpc:Resource .

hpc:Permission rdfs:domain hpc:Resource .
hpc:Owner rdfs:domain hpc:File ;
                             rdfs:range hpc:User .
hpc:Group rdfs:domain hpc:File ;
                             rdfs:range hpc:Group .
hpc:Otherusers rdfs:domain hpc:File ;
                             rdfs:range hpc:User .

hpc:Haspermission hpc:permission .
hpc:Hasowner hpc:owner .
hpc:Belongsto hpc:group .
hpc:Hasotherusers hpc:otherusers .

hpc:File_Permission rdf:type owl:DatatypeProperty ;
                          rdfs:domain hpc:File ;
                          rdfs:range xsd:integer .

hpc:Directory_Permission rdf:type owl:DatatypeProperty ;
                             rdfs:domain hpc:Directory ;
                             rdfs:range xsd:integer .

hpc:consistentWith rdf:type owl:ObjectProperty ;
                      rdfs:domain hpc:FilePermission ;
                      rdfs:range hpc:DirectoryPermission .

hpc:octalMode rdf:type owl:DatatypeProperty ;
                 rdfs:domain hpc:FilePermission ;
                 rdfs:range xsd:integer .

hpc:read rdf:type hpc:Permission ;
          rdfs:label "read" .
hpc:write rdf:type hpc:Permission ;
          rdfs:label "write" .
hpc:execute rdf:type hpc:Permission ;
          rdfs:label "execute" .

hpc:user rdf:type hpc:User .
hpc:group rdf:type hpc:Group .
