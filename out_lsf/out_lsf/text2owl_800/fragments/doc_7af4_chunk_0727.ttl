hpc:Mailserver a owl:Class .
hpc:mailto a owl:ObjectProperty ;
    rdfs:domain hpc:Mailserver ;
    rdfs:range xsd:string .
hpc:Submissionhostname a owl:Class .
hpc:emailformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Submissionhostname ;
    rdfs:range xsd:string .
hpc:LsbMailserver rdfs:subClassOf hpc:Mailserver .
hpc:LsbMailto rdfs:subClassOf hpc:Mailserver .
hpc:Windows rdfs:subClassOf hpc:Mailserver .
hpc:Jobexception rdfs:subClassOf hpc:Windows .
hpc:Primaryadministrator rdfs:subClassOf hpc:Windows .
hpc:Emailaccount rdfs:subClassOf hpc:Primaryadministrator .
