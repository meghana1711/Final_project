hpc:Jobmigration a owl:Class .
hpc:requirescheckpointing a owl:ObjectProperty .
hpc:Requirescheckpointing rdfs:domain hpc:Jobmigration ;
                            rdfs:range hpc:Checkpointablejob .

hpc:Checkpointablejob a owl:Class .
hpc:ischeckpointable a owl:DatatypeProperty ;
                         rdfs:domain hpc:Jobmigration ;
                         rdfs:range xsd:boolean .
hpc:hascheckpointdirectory a owl:DatatypeProperty ;
                             rdfs:domain hpc:Checkpointablejob ;
                             rdfs:range xsd:string .
hpc:hascheckpointperiod a owl:DatatypeProperty ;
                          rdfs:domain hpc:Checkpointablejob ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:hasinitialcheckpointperiod a owl:DatatypeProperty ;
                                 rdfs:domain hpc:Checkpointablejob ;
                                 rdfs:range xsd:nonNegativeInteger .

hpc:Jobmigratablequeue a owl:Class .
hpc:ismigratablequeue a owl:ObjectProperty .
hpc:Ismigratablequeue rdfs:domain hpc:Queue ;
                        rdfs:range hpc:Jobmigratablequeue .

hpc:Queue a owl:Class .
hpc:hasmigratablequeues a owl:ObjectProperty ;
                         rdfs:domain hpc:Lsf ;
                         rdfs:range rdf:List .

hpc:Lsf a owl:Class .
hpc:hasqueues a owl:ObjectProperty .
