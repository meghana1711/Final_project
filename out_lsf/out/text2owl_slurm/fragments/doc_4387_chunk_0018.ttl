hpc:Slurmdbd a owl:Class .
hpc:isRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:boolean .

hpc:startDaemonMode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbd .

hpc:Slurmdbdarchive a owl:Class ;
    rdfs:subClassOf hpc:Slurmdbd .

hpc:archiveData rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdbdarchive .

hpc:Purgedata a owl:Class ;
    rdfs:subClassOf hpc:Slurmdbd .

hpc:purgeData rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Purgedata .

hpc:Archiveserver a owl:Class .

hpc:archiveInstance rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Archiveserver .

hpc:Purgeoptions a owl:Class .

hpc:Archiveoptions a owl:Class .

hpc:ArchiveAfter rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Archiveoptions .

hpc:PurgeAfter rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Purgeoptions .

hpc:units rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Purgeafter ;
    rdfs:range xsd:string .

hpc:Archiveservercommunication a owl:Class .

hpc:communicationWithProductionServer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Archiveservercommunication .

hpc:communicationWithSlurmController rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Archiveservercommunication .

hpc:separateInstances rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Archiveservercommunication .
