hpc:Host a owl:Class .
hpc:Systemar a owl:Class .
hpc:Manualpowersavedmode a owl:Class .
hpc:badmin hpower a owl:ObjectProperty .
hpc:suspends rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Systemar .
hpc:resumes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:Manualpowersavedmode rdfs:subClassOf hpc:Host .
hpc:ManualPowerSavedMode rdf:type owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Lsbparams a owl:Class .
hpc:powerparameters a owl:ObjectProperty .
hpc:powerControlAction rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams .
hpc:powerControlActionSuccess rdf:type xsd:integer .
hpc:powerControlActionFailure rdf:type xsd:integer .
hpc:Powercontrolactionsuccess rdfs:range xsd:integer .
hpc:Powercontrolactionfailure rdfs:range xsd:integer .
hpc:Provisioningsystem a owl:Class .
hpc:integratesWith rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Provisioningsystem .
hpc:Thirdpartyprovisioningtool a owl:Class .
hpc:maintainsNoInformationFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Thirdpartyprovisioningtool .
hpc:storesNoCredentialsOrPasswords rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Thirdpartyprovisioningtool .
hpc:Xcat a owl:Class .
hpc:configuredAsClient rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Xcat ;
    rdfs:range hpc:Provisioningsystem .
hpc:SSLCredentials rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Managementnode .
