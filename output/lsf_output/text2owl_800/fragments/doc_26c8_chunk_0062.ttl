hpc:Serviceaccountkey hpc:a owl:Class ;
    rdfs:comment "File containing Google Cloud Service Account Key." .

hpc:Googlecloudproject hpc:a owl:Class ;
    rdfs:comment "Project in Google Cloud Platform." .

hpc:Googlecloudregion hpc:a owl:Class ;
    rdfs:comment "Default region for LSF resource connector." .

hpc:Createvms hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Googlecloudproject ;
    rdfs:range hpc:Googlecloudvm .

hpc:Createvpcs hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Googlecloudproject ;
    rdfs:range hpc:Googlecloudvpc .

hpc:Googlecloudserviceaccount hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Googlecloudproject ;
    rdfs:range hpc:Serviceaccountkey .

hpc:Googlecloudserviceaccountkeytype hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceaccountkey ;
    rdfs:range xsd:string .

hpc:Googlecloudregion hpc:a owl:DatatypeProperty ;
    rdfs:domain hpc:Googlecloudresourceconnector ;
    rdfs:range xsd:string .

hpc:Googlecloudresourceconnector hpc:a owl:Class ;
    rdfs:subClassOf owl:Agent ;
    rdfs:comment "Connector that uses Google Cloud API." .

hpc:Bulkapiendpoint hpc:a owl:ObjectProperty ;
    rdfs:domain hpc:Googlecloudresourceconnector ;
    rdfs:range hpc:Apiendpoint .

hpc:Zonalbulkapiendpoint hpc:a owl:Class ;
    rdfs:subClassOf hpc:Bulkapiendpoint ;
    rdfs:comment "Bulk API endpoint for zonal instances." .

hpc:Regionalbulkapiendpoint hpc:a owl:Class ;
    rdfs:subClassOf hpc:Bulkapiendpoint ;
    rdfs:comment "Bulk API endpoint for regional instances." .

hpc:Googlecloudinstance hpc:a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Googlecloudvpc hpc:a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Apiendpoint hpc:a owl:Class ;
    rdfs:subClassOf owl:Thing .
