hpc:Lsf10upgrade a owl:Class .
hpc:supportsUpgradeOfManagementHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf10upgrade ;
    rdfs:range xsd:boolean .

hpc:Egoservicecontrollerdaemonmanagementmode a owl:Class .
hpc:startsWindowsServices rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Egoservicecontrollerdaemonmanagementmode ;
    rdfs:range xsd:boolean .
hpc:providesHighAvailabilityServices rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Egoservicecontrollerdaemonmanagementmode ;
    rdfs:range xsd:boolean .
hpc:fasterClusterStartup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Egoservicecontrollerdaemonmanagementmode ;
    rdfs:range xsd:boolean .

hpc:Hostsetupscript a owl:Class .
hpc:functionsTheSameAsPreviousVersions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Hostsetupscript ;
    rdfs:range xsd:boolean .

hpc:Nonsharedmixedclusterinstallation a owl:Class .
hpc:supportsNonSharedInstallation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Nonsharedmixedclusterinstallation ;
    rdfs:range xsd:boolean .
