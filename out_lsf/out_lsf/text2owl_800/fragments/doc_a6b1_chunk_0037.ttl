hpc:Operatingsystem a owl:Class .
hpc:Illegalname a owl:Class .
hpc:EnglishLanguageCharacter rdf:type xsd:string .
hpc:architectureString rdf:type owl:ObjectProperty .
hpc:detectedOperatingSystem rdf:type owl:ObjectProperty .
hpc:lsfSharedFile rdf:type owl:Class .
hpc:Resource rdf:type owl:Class .
hpc:os rdf:type owl:DatatypeProperty .
hpc:ostype rdf:type owl:DatatypeProperty .
hpc:osmajor rdf:type owl:DatatypeProperty .
hpc:kernel rdf:type owl:DatatypeProperty .
hpc:Illegalname rdfs:subClassOf hpc:Operatingsystem .
hpc:Architecturestring rdfs:domain hpc:Illegalname ;
                          rdfs:range xsd:string .
hpc:Detectedoperatingsystem rdfs:domain hpc:Resource ;
                             rdfs:range hpc:Operatingsystem .
hpc:Lsfsharedfile rdfs:subClassOf rdf:Resource .
hpc:Resource rdfs:subClassOf rdf:Resource ;
                 rdfs:subClassOf hpc:Lsfsharedfile .
