hpc:Usershare a owl:Class .
hpc:Usershareassignment rdfs:subClassOf hpc:Usershare .
hpc:Usershare rdfs:subClassOf rdf:List .
hpc:Usershare rdfs:domain hpc:Usershareassignment .
hpc:Usershare rdfs:range hpc:Usershareassignmentitem .
hpc:Usershareassignmentitem a owl:Class .
hpc:Usershareassignmentitem rdfs:subClassOf rdf:List .
hpc:Usershareassignmentitem rdfs:domain hpc:Usershareassignment .
hpc:Usershareassignmentitem rdfs:range ( hpc:User | hpc:Numbershares ) .
hpc:User a owl:Class .
hpc:User rdfs:subClassOf xsd:string .
hpc:Windowsuser a owl:Class .
hpc:Windowsuser rdfs:subClassOf hpc:User .
hpc:WindowsUser rdfs:subPropertyOf hpc:user .
hpc:Windowsuser rdfs:range ( xsd:string, xsd:string ) .
hpc:Group a owl:Class .
hpc:Group rdfs:subClassOf xsd:string .
hpc:domainname a owl:DatatypeProperty .
hpc:Domainname rdfs:domain hpc:Windowsuser .
hpc:Domainname rdfs:range xsd:upperCase .
hpc:groupmembership a owl:ObjectProperty .
hpc:Groupmembership rdfs:domain hpc:Group .
hpc:Groupmembership rdfs:range hpc:User .
hpc:Defaultuser a owl:Class .
hpc:Defaultuser rdfs:subClassOf hpc:User .
hpc:Others a owl:Class .
hpc:Others rdfs:subClassOf hpc:User .
hpc:hierarchicalfairshare a owl:ObjectProperty .
