hpc:ugAdmins rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range hpc:User .

hpc:marketing rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range hpc:Usergroup ;
    rdfs:subPropertyOf hpc:ugAdmins .

hpc:Marketing hpc:user1 rdf:type hpc:ugAdmins .
hpc:Marketing hpc:user2 rdf:type hpc:ugAdmins .
hpc:Marketing hpc:shelley[full] rdf:type hpc:ugAdmins .

hpc:financial rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range hpc:Usergroup ;
    rdfs:subPropertyOf hpc:ugAdmins .

hpc:Financial hpc:user3 rdf:type hpc:ugAdmins .
hpc:Financial hpc:uga rdf:type hpc:ugAdmins .
hpc:Financial hpc:john rdf:type hpc:ugAdmins[usershares] .

hpc:Endusergroup a owl:Class .

hpc:usershares rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:full rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:full rdfs:subPropertyOf hpc:ugAdmins .

hpc:usergroupadmincancontrolalljobs a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:usergroupadmincanadjustusershares a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:usergroupadmincancreatenewusergroups a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:usergroupadmincanadjustgroupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:usergroupadmincanusebconf a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:usergroupadmincanaddusergroupmemberwithfullrights a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range hpc:Usergroup .

hpc:savechanges a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs:range rdfs:Literal .

hpc:runbadminckconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Groupadmin ;
    rdfs
