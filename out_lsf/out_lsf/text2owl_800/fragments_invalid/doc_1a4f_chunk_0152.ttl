hpc:hasjobgrouplimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Jobgrouplimitvalue a owl:Class ;
    rdf:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:hasJobGroupLimit ;
                      owl:hasValue ?value ;
                      rdf:type owl:DatatypeRestriction ] .
hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:movejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:terminatejob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
hpc:deletejobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup .
hpc:autocleanup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean .
hpc:jobgrouphierarchy a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .
hpc:hasparentjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .
hpc:Rootjobgroup a owl:Class ;
    rdf:type owl:NamedIndividual ;
    hpc:hasParentJobGroup undef .
