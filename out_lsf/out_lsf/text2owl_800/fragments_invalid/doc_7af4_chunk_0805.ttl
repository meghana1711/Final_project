hpc:Dynamichostremoval a owl:Class .
hpc:Fixpack15 hpc:Dynamichostremoval rdfs:subClassOf owl:Thing .
hpc:Fixpack14 hpc:Dynamichostremoval rdfs:subClassOf owl:Thing .

hpc:Priortofixpack15 a owl:Class .
hpc:Priortofixpack14 a owl:Class .

hpc:reconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:Dynamichostremoval ;
    rdfs:range hpc:Daemon .

hpc:timeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Priortofixpack14 ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Timeoutvalue a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .

hpc:Asoffixpack14 a owl:Class .
hpc:timeoutvalueallowedminimum a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeoutvalue ;
    rdfs:range xsd:integer ;
    rdfs:range rdfs:minInclusive "10"^^xsd:integer .
hpc:timeoutvalueallowedmaximum a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeoutvalue ;
    rdfs:range xsd:integer ;
    rdfs:range rdfs:maxInclusive "100H"^^xsd:duration .

hpc:timeoutvalueunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeoutvalue ;
    rdfs:range xsd:string .

hpc:Timeoutvalueunithours a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Timeoutvalueunitminutes a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:expiry a owl:ObjectProperty ;
    rdfs:domain hpc:Priortofixpack14 ;
    rdfs:range hpc:Time .

hpc:expirytime a owl:DatatypeProperty ;
    rdfs:domain hpc:Expiry ;
    rdfs:range xsd:nonNegativeInteger .

hpc:expirytimeunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Expirytime ;
    rdfs:range xsd:string .

hpc:Expirytimeunithours a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Expirytimeunitminutes a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Hostcache a owl:Class .
hpc:markedasexpired a owl:ObjectProperty ;
    rdfs:domain hpc:Hostcache ;
    rdfs:range hpc:Host .

hpc:cleanedfromhostcache a owl:ObjectProperty ;
    rdfs:domain hpc:Hostcache ;
    rdfs:range hpc:Time .

hpc:Expiredhostswaitforcleanup a owl:Class .
hpc:Threshold a owl:Dat
