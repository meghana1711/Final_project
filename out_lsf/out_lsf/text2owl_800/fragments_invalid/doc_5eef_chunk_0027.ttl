hpc:Datamanager a owl:Class .
hpc:Tag a owl:Class .
hpc:User a owl:Class .
hpc:Cluster a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Connection a owl:Class .

# Object Properties
hpc:manages a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Cluster .

hpc:managestag a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Tag .

hpc:createdby a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hps:User .

hpc:lastuploadedby a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hps:User .

hpc:lastdownloadedby a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hps:User .

hpc:isinstagingarea a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range hpc:Stagingarea .

hpc:hasconnection a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Connection .

# Datatype Properties
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag .
    rdfs:range xsd:string .

hpc:lastUpload xsd:dateTime .
hpc:lastDownload xsd:dateTime .

# Data Management Configuration
hpc:admin a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager .
    rdfs:range xsd:string .

hpc:cacheInputGracePeriod xsd:nonNegativeInteger .
hpc:cacheOutputGracePeriod xsd:nonNegativeInteger .

hpc:cachePermissions xsd:string .
hpc:fileTransferCmd xsd:string .
hpc:lsbTimeDmd xsd:nonNegativeInteger .
hpc:lsfDataHosts xsd:string .
hpc:lsfDataPort xsd:positiveInteger .
hpc:lsfLogDir xsd:string .
hpc:lsfLogMask xsd:string .
hpc:cacheAccessControl xsd:boolean .
hpc:queryNThreads xsd:nonNegativeInteger .
hpc:stagingArea xsd:string .

# Connections
hpc:managementHost xsd:string .
hpc:status xsd:string .
hpc:outgoingConnections xsd:string .
hpc:incomingConnections xsd:string .
