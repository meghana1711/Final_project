hpc:Prolog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:Epilog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:SrunProlog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:SrunEpilog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:TaskProlog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:TaskEpilog a owl:Class ;
    rdfs:subClassOf hpc:ExecutionScript .

hpc:ExecutionScript rdf:type owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf xsd:string .

hpc:hasProlog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Prolog .

hpc:hasEpilog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Epilog .

hpc:hasSrunProlog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:SrunProlog .

hpc:hasSrunEpilog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:SrunEpilog .

hpc:hasTaskProlog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:TaskProlog .

hpc:hasTaskEpilog rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:TaskEpilog .

hpc:EventLogging a owl:Class .

hpc:SlurmctldLogging a owl:Class ;
    rdfs:subClassOf hpc:EventLogging .

hpc:SlurmdLogging a owl:Class ;
    rdfs:subClassOf hpc:EventLogging .

hpc:SlurmctldDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmctldLogging ;
    rdfs:range xsd:string .

hpc:SlurmctldLogFile a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmctldLogging ;
    rdfs:range xsd:string .

hpc:SlurmdDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmdLogging ;
    rdfs:range xsd:string .

hpc:SlurmdLogFile a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmdLogging ;
    rdfs:range xsd:string .

hpc:JobCompletionLogging a owl:Class ;
    rdfs:subClassOf hpc
