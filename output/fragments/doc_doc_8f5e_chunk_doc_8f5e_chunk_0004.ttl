hpc:Upgrade a owl:Class .
hpc:Preparation a owl:Class .
hpc:ReviewReleaseNotes a owl:ObjectProperty ;
    rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:Preparation .
hpc:CheckDependencies a owl:ObjectProperty ;
    rdfs:domain hpc:Upgrade ;
    rdfs:range xsd:boolean .
hpc:TestInTestEnvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:Preparation .
hpc:ConfigurationChanges a owl:Class .
hpc:TestInProduction a owl:ObjectProperty ;
    rdfs:domain hpc:ConfigurationChanges ;
    rdfs:range hpc:Preparation .
