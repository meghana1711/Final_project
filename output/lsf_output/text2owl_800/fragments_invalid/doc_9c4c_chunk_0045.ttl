hpc:LsfServerHosts a owl:Class .
hpc:hasHostName an rdf:Property ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range xsd:string .
hpc:isManagementHost an rdf:Property ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range xsd:boolean .
hpc:isInLSF_MASTER_LIST an rdf:Property ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range xsd:boolean .
hpc:LsfTardir a owl:Class .
hpc:hasTarDir an rdf:Property ;
    rdfs:domain hpc:LsfTardir ;
    rdfs:range xsd:string .
