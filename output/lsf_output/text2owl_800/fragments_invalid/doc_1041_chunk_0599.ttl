hpc:Filerequirement a owl:Class .
hpc:Tagrequirement a owl:Class .
hpc:Folderrequirement a owl:Class .

hpc:hastag a owl:ObjectProperty ;
    rdfs:domain hpc:Tagrequirement ;
    rdfs:range rdf:List .

hpc:hasfile a owl:ObjectProperty ;
    rdfs:domain hpc:Filerequirement ;
    rdfs:range rdf:List .

hpc:hasfolder a owl:ObjectProperty ;
    rdfs:domain hpc:Folderrequirement ;
    rdfs:range rdf:List .

hpc:Tagrequirement a rdfs:subClassOf hpc:Datarequirement .
hpc:Filerequirement a rdfs:subClassOf hpc:Datarequirement .
hpc:Folderrequirement a rdfs:subClassOf hpc:Datarequirement .

hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    rdfs:subClassOf rdf:List .

hpc:DataRequirement rdfs:subPropertyOf rdf:first .
hpc:DataRequirement rdfs:subPropertyOf rdf:rest .

hpc:Datarequirement rdfs:domain hpc:Job .

hpc:Tag a owl:Datatype .
hpc:File a owl:Datatype .
hpc:Folder a owl:Datatype .

hpc:Tag rdfs:subClassOf xsd:string .
hpc:File rdfs:subClassOf xsd:string .
hpc:Folder rdfs:subClassOf xsd:string .

hpc:Tagname rdfs:domain hpc:Tag .
hpc:Tagname rdfs:range xsd:string .
hpc:Hostname rdfs:domain hpc:File .
hpc:Hostname rdfs:range xsd:string .
hpc:Absfolderpath rdfs:domain hpc:File .
hpc:Absfolderpath rdfs:range xsd:string .

hpc:Tagowner rdfs:domain hpc:Tag .
hpc:Tagowner rdfs:range xsd:string .
