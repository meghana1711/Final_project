hpc:Unixenvironment a owl:Class ;
  rdfs:subClassOf hpc:Environment .

hpc:Windowsenvironment a owl:Class ;
  rdfs:subClassOf hpc:Environment .

hpc:Jobenvironment a owl:Class ;
  rdfs:subClassOf hpc:Environment .

hpc:Environmentvariable a owl:Class .

hpc:hasvalue a owl:DatatypeProperty ;
  rdfs:domain hpc:Environmentvariable ;
  rdfs:range xsd:string .

hpc:isassignedto a owl:ObjectProperty ;
  rdfs:domain hpc:Environmentvariable ;
  rdfs:range hpc:Environment .

hpc:isappendedto a owl:ObjectProperty ;
  rdfs:domain hpc:Environment ;
  rdfs:range hpc:Environmentvariable .

hpc:separatorfor a owl:DatatypeProperty ;
  rdfs:domain hpc:Environment ;
  rdfs:range xsd:string .

hpc:propagateall a owl:ObjectProperty ;
  rdfs:domain hpc:Jobenvironment ;
  rdfs:range hpc:Environment .

hpc:assignvalue a owl:ObjectProperty ;
  rdfs:domain hpc:Jobenvironment ;
  rdfs:range hpc:Environmentvariable .

hpc:excludefrompropagation a owl:ObjectProperty ;
  rdfs:domain hpc:Jobenvironment ;
  rdfs:range hpc:Environmentvariable .

hpc:Forbiddenwords a owl:Class ;
  rdfs:subClassOf xsd:string .

hpc:Forbiddensymbol a owl:Class ;
  rdfs:subClassOf xsd:string .

hpc:Submissionenvironment a owl:Class ;
  rdfs:subClassOf hpc:Jobenvironment .

hpc:Executionenvironment a owl:Class ;
  rdfs:subClassOf hpc:Jobenvironment .

hpc:lsbSubModifyFile a owl:ObjectProperty ;
  rdfs:domain hpc:Environment ;
