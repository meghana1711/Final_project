hpc:Slurmdaemon a owl:Class .
hpc:hascorefilelocation a owl:ObjectProperty .

hpc:Slurmctld a hpc:SlurmDaemon ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             rdfs:onProperty hpc:hasCoreFileLocation ;
                                             rdfs:allValuesFrom [ a xsd:string ;
                                                                     xsd:pattern "^/var/tmp/|(SlurmctldLogFile|StateSaveLocation)$" ] ] ] .

hpc:slurmd a hpc:SlurmDaemon ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             rdfs:onProperty hpc:hasCoreFileLocation ;
                                             rdfs:allValuesFrom [ a xsd:string ;
                                                                     xsd:pattern "^/var/tmp/|(SlurmdLogFile|SlurmdSpoolDir)$" ] ] ] .

hpc:slurmstepd a hpc:SlurmDaemon ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ a owl:Restriction ;
                                             rdfs:onProperty hpc:hasCoreFileLocation ;
                                             rdfs:allValuesFrom [ a xsd:string ;
                                                                     xsd:pattern "^(privileged phase location)$" ] ] ] .

hpc:hasCoreFileLocation
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:string .
