hpc:Reservation a owl:Class .
hpc:addhost a owl:ObjectProperty .
hpc:Numberunit rdfs:domain hpc:Reservation ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Reservationreq rdfs:domain hpc:Addhost ;
                    rdfs:range xsd:string .
hpc:Hostname rdfs:domain hpc:Addhost ;
               rdfs:range xsd:string .
hpc:Hostgroup rdfs:domain hpc:Addhost ;
               rdfs:range xsd:string .
hpc:Hostsonhost rdfs:domain hpc:Addhost ;
                rdfs:range xsf:nonNegativeInteger .
hpc:adduser a owl:ObjectProperty .
hpc:Username rdfs:domain hpc:Adduser ;
              rdfs:range xsd:string .
hpc:Usergroup rdfs:domain hpc:Adduser ;
               rdfs:range xsd:string .
hpc:Reservationid rdfs:domain hpc:Addhost ;
                  rdfs:range xsd:string .
hpc:Leasedhost a owl:Class .
hpc:Localhost a owl:Class .
hpc:Availablehost rdfs:subClassOf hpc:Localhost .
hpc:Reservedhost rdfs:subClassOf hpc:Localhost .
hpc:Reservedslot rdfs:subClassOf hpc:Availablehost .
hpc:AddHostWithoutN optionally takes hpc:NumberUnit as its object .
hpc:AddHostWithN takes hpc:NumberUnit as its object .
hpc:AddHostWithNR takes hpc:ReservationReq and hpc:NumberUnit as its objects .
hpc:AddHostWithNM takes hpc:HostName as its object .
hpc:AddHostWithNMR takes hpc:ReservationReq and hpc:HostName as its objects .
hpc:AddHostWithNMF takes hpc:ReservationReq and hpc:HostsOnHost as its objects .
hpc:AddUserWithNM takes hpc:UserName as its object .
hpc:AddUserWithUG takes hpc:UserGroup as its object .
hpc:AddUserWithRID takes hpc:ReservationID as its object .
hpc:AddHostWithoutN rdfs:subPropertyOf hpc:AddHost .
hpc:AddHostWithN rdfs:subPropertyOf hpc:AddHost .
hpc:AddHostWithNR rdfs:subPropertyOf hpc:AddHost .
hpc:AddHostWithNM rdfs:subPropertyOf hpc:AddHost .
hpc:AddHostWithNMR rdfs:subPropertyOf hpc:AddHost .
hpc:AddHostWithNMF rdfs:subPropertyOf hpc:AddHost .
hpc:AddUserWithNM rdfs:subPropertyOf hpc:AddUser .
hpc:AddUserWithUG rdfs:subPropertyOf hpc:AddUser .
hpc:AddUserWithRID rdfs:subPropertyOf hpc:AddUser .
hpc:AddHost cannot take hpc:NumberUnit alone as its object .
hpc:AddUser can only take hpc:UserName, hpc:UserGroup, or hpc:
