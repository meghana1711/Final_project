hpc:Next
    a owl:ObjectProperty ;
    rdfs:domain hpc:Experimentselection ;
    rdfs:range hpc:Experimentselection ;
    rdfs:comment "Allows clicking to review experiment selections." .

hpc:Rerun
    a owl:ObjectProperty ;
    rdfs:domain hpc:Experimentselection ;
    rdfs:range hpc:Experimentselection ;
    rdfs:comment "Allows clicking to rerun the experiment." .

hpc:Progress
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents the progress of a Sample Experiment job." .

hpc:Completed
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a completed Sample Experiment job." .

hpc:Refresh
    a owl:ObjectProperty ;
    rdfs:domain hpc:Progress ;
    rdfs:range hpc:Progress ;
    rdfs:comment "Allows clicking to update the progress bar in the table." .

hpc:PredictionResults
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents the prediction results of a Sample Experiment." .

hpc:JobData
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a small job data set for practicing creating a model with the LSF Predictor." .

hpc:MemoryPrediction
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a prediction regarding the amount of memory required for a job." .

hpc:Prediction
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Represents a prediction made using the LSF Predictor." .

hpc:MaxMemPredictionTarget
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryprediction ;
    rdfs:range xsd:float ;
    rdfs:comment "Represents the maximum memory prediction target." .

hpc:RegressionPredictionType
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Memoryprediction ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the prediction type as Regression." .
