hpc:Operatingsystem a owl:Class .
hpc:Cpu a owl:Class .
hpc:Hardware a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .
hpc:version a owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .
hpc:SupportType a owl:Enum ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:Certified a rdfs:Literal ;
    rdf:value "Certified" ;
    rdfs:comment "Indicates that the operating system is certified for use with LSF." .
hpc:Supported a rdfs:Literal ;
    rdf:value "Supported" ;
    rdfs:comment "Indicates that the operating system is supported for use with LSF." .
hpc:Managementhost a owl:Class .
hpc:performance a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Indicates the degree of performance achieved by a management host." .
hpc:scalability a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Indicates the scalability achieved by a management host." .
hpc:Serverhost a owl:Class .
hpc:compatibility a owl:ObjectProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range hpc:Managementhost ;
    rdfs:comment "Indicates the compatibility between a server host and a management host." .
hpc:Addon a owl:Class .
hpc:compatibility101 a owl:ObjectProperty ;
    rdfs:domain hpc:Addon ;
    rdfs:range hpc:Addon ;
    rdfs:comment "Indicates the compatibility between LSF 10.1 and an LSF add-on." .
hpc:Api a owl:Class .
hpc:compatibilityapi a owl:ObjectProperty ;
    rdfs:domain hpc:Api ;
    rdfs:range hpc:Api ;
    rdfs:comment "Indicates the compatibility between a new version of LSF and existing LSF applications." .
