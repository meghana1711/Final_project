    rdfs:range xsd:string .
hpc:lostandfoundqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Rmlogjobinfofailed ;
    rdfs:range xsd:string .

hpc:Reconfiguredjobs a owl:Class ;
    rdfs:subClassOf hpc:Mbatchdmessage .
hpc:queuenotfound a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfiguredjobs ;
    rdfs:range xsd:string .
hpc:lostandfoundqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Reconfiguredjobs ;
    rdfs:range xsd:string .

hpc:replaystartjob a owl:ObjectProperty ;
