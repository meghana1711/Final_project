hpc:System a owl:Class .
hpc:CoreFileSizeLimit a owl:Class .
hpc:SoftLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:integer .
hpc:HardLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range xsd:integer .
hpc:CorePattern rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System .
hpc:CoreLocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System .
hpc:SlurmConf rdf:type owl:Class .
hpc:PropagateResourceLimits rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range xsd:string .
hpc:SlurmUser rdf:type owl:Class .
hpc:CoreDumpToPersistentStorage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System .
hpc:DisklessNode rdf:type owl:Class .
hpc:InMemoryFilespace rdf:type owl:Class .
hpc:SharedFilesystem rdf:type owl:Class .
hpc:Centos6 rdf:type owl:Class .
hpc:RHEL6 rdf:type owl:Class .
hpc:SelinuxEnabledSystem rdf:type owl:Class .
hpc:SecuritySystem rdf:type owl:Class .
hpc:Abrt rdf:type owl:Class .
hpc:ProcessUnpackaged rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Abrt ;
    rdfs:range xsd:boolean .
hpc:CoreDumpCtl rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:System .
hpc:Backtrace rdf:type owl:Class .
hpc:Crash rdf:type owl:Class ;
    rdfs:subClassOf hpc:Backtrace .
hpc:SupportRequest rdf:type owl:Class .
hpc:Binary rdf:type owl:Class .
hpc:CompileTime rdf:type owl:Class .
hpc:SystemDistribution rdf:type owl:Class .
hpc:SELinux rdf:type owl:Class .
