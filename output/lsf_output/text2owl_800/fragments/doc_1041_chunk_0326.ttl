hpc:hasrunstate a owl:ObjectProperty .
hpc:hassuspendedstate a owl:ObjectProperty .
hpc:haspendingstate a owl:ObjectProperty .
hpc:hasforwardpendingstate a owl:ObjectProperty .
hpc:hasaffinityresourcerequirements a owl:ObjectProperty .

hpc:Runstate a owl:Class .
hpc:Suspendedbylsf a owl:Class .
hpc:Suspendedbyowneroradmin a owl:Class .
hpc:Unknownstate a owl:Class .
hpc:Lostcontactstate a owl:Class .
hpc:Pendingstate a owl:Class .
hpc:Forwardpendingstate a owl:Class .

hpc:Hascount rdfs:domain hpc:Unfinishedjobsummaryinformation ;
    rdfs:range xsd:integer .

hpc:Hasrunstate rdfs:domain hpc:Unfinishedjobsummaryinformation ;
    rdfs:range hpc:Runstate .
hpc:Hassuspendedstate rdfs:domain hpc:Unfinishedjobsummaryinformation ;
    rdfs:range hpc:Suspendedbylsf, hpc:Suspendedbyowneroradmin, hpc:Unknownstate, hpc:Lostcontactstate .
hpc:Haspendingstate rdfs:domain hpc:Unfinishedjobsummaryinformation ;
    rdfs:range hpc:Pendingstate .
hpc:Hasforwardpendingstate rdfs:domain hpc:Unfinishedjobsummaryinformation ;
    rdfs:range hpc:Forwardpendingstate .

hpc:Affinityresourcerequirements a owl:Class .
hpc:Hascpubinding rdfs:domain hpc:Affinityresourcerequirements ;
    rdfs:range xsd:string .
hpc:Hasmemorybinding rdfs:domain hpc:Affinityresourcerequirements ;
    rdfs:range xsd:string .

hpc:Affinityinformation a owl:Class .
hpc:Hasprocessorunit rdfs:domain hpc:Affinityinformation ;
    rdfs:range xsd:integer .
