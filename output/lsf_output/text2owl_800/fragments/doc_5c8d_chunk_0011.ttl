hpc:Lsfjobsubmission a owl:Class .
hpc:Easymodesubmission a owl:Class .
hpc:Expertmodesubmission a owl:Class .

hpc:defineslsbeasytile a owl:DatatypeProperty .
hpc:Defineslsbeasytile rdfs:domain hpc:Easymodesubmission ;
                        rdfs:range xsd:nonNegativeInteger .

hpc:usebsub a owl:ObjectProperty .
hpc:Usebsub rdfs:domain hpc:Easymodesubmission ;
             rdfs:range xsd:string .

hpc:usejsm a owl:ObjectProperty .
hpc:Usejsm rdfs:domain hpc:Usebsub ;
           rdfs:range xsd:string .

hpc:usestepcgroup a owl:ObjectProperty .
hpc:Usestepcgroup rdfs:domain hpc:Usebsub ;
                rdfs:range xsd:string .

hpc:usecoreisolation a owl:DatatypeProperty .
hpc:Usecoreisolation rdfs:domain hpc:Usebsub ;
                     rdfs:range xsd:nonNegativeInteger .

hpc:uselnslots a owl:DatatypeProperty .
hpc:Uselnslots rdfs:domain hpc:Usebsub ;
              rdfs:range xsd:nonNegativeInteger .

hpc:uselnmem a owl:DatatypeProperty .
hpc:Uselnmem rdfs:domain hpc:Usebsub ;
            rdfs:range xsd:string .

hpc:usennodes a owl:DatatypeProperty .
hpc:Usennodes rdfs:domain hpc:Usebsub ;
             rdfs:range xsd:nonNegativeInteger .

hpc:usecncu a owl:DatatypeProperty .
hpc:Usecncu rdfs:domain hpc:Usebsub ;
           rdfs:range xsd:string .
