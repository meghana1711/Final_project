hpc:PrologSlurmctld a owl:Class .
hpc:SrunProlog a owl:Class .
hpc:TaskProlog a owl:Class .
hpc:EpilogSlurmctld a owl:Class .
hpc:SrunEpilog a owl:Class .
hpc:TaskEpilog a owl:Class .

hpc:ClusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:PrologSlurmctld, hpc:Prolog, hpc:Epilog, hpc:EpilogSlurmctld ;
    rdfs:range xsd:string .

hpc:SlurmConf a owl:DatatypeProperty ;
    rdfs:domain hpc:Prolog, hpc:SrunProlog, hpc:TaskProlog, hpc:Epilog, hpc:SrunEpilog, hpc:TaskEpilog ;
    rdfs:range xsd:string .

hpc:CpusOnNode a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunProlog, hpc:TaskProlog, hpc:SrunEpilog, hpc:TaskEpilog ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Distribution a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunProlog, hpc:TaskProlog, hpc:SrunEpilog, hpc:TaskEpilog ;
    rdfs:range xsd:string .

hpc:Gpus a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunProlog, hpc:TaskProlog, hpc:SrunEpilog, hpc:TaskEpilog ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Gtid a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunProlog, hpc:TaskProlog, hpc:SrunEpilog, hpc:TaskEpilog ;
    rdfs:range xsd:string .

hpc:JobAccount a owl:DatatypeProperty ;
    rdfs:domain hpc:Prolog, hpc:PrologSlurmctld, hpc:Epilog, hpc:EpilogSlurmctld ;
    rdfs:range xsd:string .

hpc:JobComment a owl:DatatypeProperty ;
    rdfs:domain hpc:Prolog, hpc:PrologSlurmctld, hpc:Epilog, hpc:EpilogSlurmctld ;
    rdfs:range xsd:string .

hpc:JobConstraints a owl:DatatypeProperty ;
    rdfs:domain hpc:Prolog, hpc:PrologSlurmctld, hpc:Epilog, hpc:EpilogSlurmctld ;
    rdfs:range xsd:string .

hpc:JobCpusPerNode a owl:DatatypeProperty ;
    rdfs:domain hpc:Prolog, hpc:PrologSlurmctld, hpc:Epilog, hpc:EpilogSlurmctld ;
    r
