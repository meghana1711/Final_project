hpc:Bdata a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Query the status of files and data tags in the staging area cache and manage data tags associated with your jobs." .

hpc:Bjobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Query the status of jobs with data requirements." .

hpc:Bhist a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "View historical information about jobs with data requirements." .

hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specify data requirements and use them in your jobs with the bsub -data command." .

hpc:Dataspecificationfile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Create and use a data specification file to streamline job submission." .

hpc:Datasourcerepository a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A repository from which data can be staged." .

hpc:Datatag a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Use data tags to build a data requirement work flow, and manage your tag name space." .

hpc:stagein a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range DataSourceRepository ;
    rdfs:comment "Stage required data in from a data source repository with the bstage incommand." .

hpc:stageout a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range DataSourceRepository ;
    rdfs:comment "Move job output data back to the data source repository with the bstage out command." .

hpc:datarequirementworkflow a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range DataRequirement ;
    rdfs:comment "Use data tags to build a data requirement work flow." .

hpc:datacache a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range BData ;
    rdfs:comment "The data cache where data is stored for jobs with data requirements." .

hpc:datataglist a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range BData ;
    rdfs:comment "List of data tags associated with a job's data requirements." .

hpc:datarequirementquery a owl:ObjectProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range BData ;
    rdfs:comment "Query the LSF data manager with the bdata command." .

hpc:jobexecutionhost a owl:DatatypeProperty ;
    rdfs:domain DataRequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "The host where the job is executed." .

hpc:datafilerequirement a owl:DatatypeProperty ;
    rdfs:domain DataRequirement ;
    r
