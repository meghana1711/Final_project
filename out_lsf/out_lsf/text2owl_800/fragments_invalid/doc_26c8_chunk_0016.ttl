hpc:Providers a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Providers ;
    rdfs:range xsd:string .

hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Providers ;
    rdfs:range xsd:string .

hpc:confpath a owl:ObjectProperty ;
    rdfs:domain hpc:Providers ;
    rdfs:range xsd:string ;
    rdfs:range ^^xsd:base64Binary .

hpc:scriptpath a owl:ObjectProperty ;
    rdfs:domain hpc:Providers ;
    rdfs:range xsd:string ;
    rdfs:range ^^xsd:base64Binary .

hpc:ProvidersConstraint a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:providers ;
                      owl:cardinality 1 ;
                      owl:allValuesFrom xsd:string ] .

hpc:ProvidersUniquename a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty hpc:name ;
                      owl:allDifferent ] .
