hpc:HeterogeneousJob a owl:Class .
hpc:HeterogeneousStep a owl:Class .
hpc:JobArray a owl:Class .
hpc:JobSubmissionPlugin a owl:Class .
hpc:SchedulerPlugin a owl:Class .
hpc:SrunCommand a owl:Class .
hpc:SlurmEnvironmentVariable a owl:Class .

hpc:hasAllocation a owl:ObjectProperty .
hpc:hasComponent a owl:ObjectProperty .
hpc:hasEnvironmentVariable a owl:ObjectProperty .
hpc:hasLimitTestResult a owl:ObjectProperty .
hpc:hasPartition a owl:ObjectProperty .
hpc:hasPartitionQOS a owl:ObjectProperty .
hpc:hasQOS a owl:ObjectProperty .
hpc:hasResourceLimit a owl:ObjectProperty .
hpc:hasStepLaunchFailureReason a owl:ObjectProperty .
hpc:hasStepLayout a owl:ObjectProperty .
hpc:hasStepLaunchMode a owl:ObjectProperty .
hpc:hasStepSchedulingMode a owl:ObjectProperty .

hpc:HeterogeneousJob rdfs:subClassOf hpc:Job .
hpc:HeterogeneousStep rdfs:subClassOf hpc:JobStep .
hpc:JobArray rdfs:subClassOf hpc:Job .
hpc:JobSubmissionPlugin rdfs:subClassOf hpc:Plugin .
hpc:SchedulerPlugin rdfs:subClassOf hpc:Plugin .
hpc:SrunCommand rdfs:subClassOf hpc:Command .
hpc:SlurmEnvironmentVariable rdfs:subClassOf hpc:Variable .

hpc:hasAllocation rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:Allocation .
hpc:hasComponent rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:HeterogeneousStep .
hpc:hasEnvironmentVariable rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:SlurmEnvironmentVariable .
hpc:hasLimitTestResult rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range xsd:boolean .
hpc:hasPartition rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:Partition .
hpc:hasPartitionQOS rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:QOS .
hpc:hasQOS rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:QOS .
