hpc:TimeSeries a owl:Class .
hpc:DataSample a owl:Class, rdfs:subClassOf hpc:TimeSeries .

hpc:Date a xsd:dateTime .
hpc:TimeOfDay a xsd:dateTime .
hpc:ElapsedTime a xsd:nonNegativeDuration .

hpc:ReadOperations a xsd:nonNegativeInteger .
hpc:MegabytesRead a xsd:decimal .
hpc:Writes a xsd:nonNegativeInteger .
hpc:MegabytesWritten a xsd:decimal .

hpc:Network a owl:Class .
hpc:AcctGatherInterconnectType a xsd:string .

hpc:NetworkData a owl:Class, rdfs:subClassOf hpc:DataSample .
hpc:hasNetworkData a owl:ObjectProperty .
hpc:hasAcctGatherInterconnectType a owl:ObjectProperty .
hpc:hasNetworkType a xsd:string .
hpc:hasFrequency a xsd:nonNegativeInteger .

hpc:TimeSeries rdfs:subClassOf rdf:List .
hpc:DataSample rdfs:domain hpc:TimeSeries .
hpc:hasDate rdfs:domain hpc:DataSample ;
                               rdfs:range hpc:Date .
hpc:hasTimeOfDay rdfs:domain hpc:DataSample ;
                             rdfs:range hpc:TimeOfDay .
hpc:hasElapsedTime rdfs:domain hpc:DataSample ;
                             rdfs:range hpc:ElapsedTime .
hpc:hasReadOperations rdfs:domain hpc:DataSample ;
                               rdfs:range hpc:ReadOperations .
hpc:hasMegabytesRead rdfs:domain hpc:DataSample ;
                               rdfs:range hpc:MegabytesRead .
hpc:hasWrites rdfs:domain hpc:DataSample ;
                             rdfs:range hpc:Writes .
hpc:hasMegabytesWritten rdfs:domain hpc:DataSample ;
                               rdfs:range hpc:MegabytesWritten .
hpc:NetworkData rdfs:domain hpc:Network ;
                             rdfs:range hpc:DataSample .
hpc:hasNetworkData rdfs:domain hpc:Network ;
                             rdfs:range hpc:DataSample .
hpc:hasAcctGatherInterconnectType rdfs:domain hpc:Network ;
                                     rdfs:range hpc:AcctGatherInterconnectType .
hpc:hasNetworkType rdfs:domain hpc:Network ;
                             rdfs:range xsd:string .
hpc:hasFrequency rdfs:domain hpc:Network ;
                             rdfs:range xsd:nonNegativeInteger .
```
