hpc:Job a owl:Class .
hpc:estimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:hardruntimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:exceededestimatedruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:finishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:complete a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobwithnorunlimit a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobwithnoestimatedfinishtime a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:subClassOf hpc:Jobwithnorunlimit .
hpc:Jobwithexceededestimatedruntime a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:subClassOf hpc:Jobwithnorunlimit .
hpc:Lsfmulticlustercapability a owl:Class .
hpc:resourceusage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmulticlustercapability .
hpc:lsfhpcextensions a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmulticlustercapability ;
    rdfs:range xsd:string .
