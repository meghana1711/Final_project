hpc:Container a owl:Class .
hpc:hasimage a owl:ObjectProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range hpc:Image .
hpc:options a owl:ObjectProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range hpc:Options .
hpc:Image a owl:Class .
hpc:startoptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:execDriver a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Driverstarter .
hpc:Driverstarter a owl:Class .
hpc:overrides a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Options .
