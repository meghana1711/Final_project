hpc:OpenapiSlurmResponseSchema a owl:Class .

# Subclass of OpenAPI Response
hpc:OpenapiSlurmResponse a owl:Class ;
    rdfs:subClassOf hpc:OpenapiSlurmResponseSchema .

# Response for a specific reservation
hpc:SpecificReservationResponse a owl:Class ;
    rdfs:subClassOf hpc:OpenapiSlurmResponse .

# Response for all reservations
hpc:AllReservationsResponse a owl:Class ;
    rdfs:subClassOf hpc:OpenapiSlurmResponse .

# Properties
hpc:responseType a owl:ObjectProperty ;
    rdfs:domain hpc:SpecificReservationResponse ;
    rdfs:range xsd:string .

hpc:content a owl:ObjectProperty ;
    rdfs:domain hpc:SpecificReservationResponse ;
    rdfs:range hpc:Content .

hpc:schema a owl:ObjectProperty ;
    rdfs:domain hpc:SpecificReservationResponse ;
    rdfs:range hpc:Schema .

hpc:ref a owl:ObjectProperty ;
    rdfs:domain hpc:Schema ;
    rdfs:range xsd:string .

# Content types
hpc:ApplicationYAML a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:TextYAML a owl:Class ;
    rdfs:subClassOf xsd:string .

# Schema for responses
hpc:v0041OpenapiReservationResp a owl:Class ;
    rdfs:subClassOf hpc:SpecificReservationResponse .
```
