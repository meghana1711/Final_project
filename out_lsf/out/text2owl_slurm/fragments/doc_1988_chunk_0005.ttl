hpc:Partition a owl:Class .
hpc:Job a owl:Class .
hpc:Activebitmap a owl:Class .
hpc:Runqueue a owl:Class .
hpc:Timeslicerthread a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:Runnablejob a owl:Class .
hpc:Concurrentjob a owl:Class .
hpc:schedulertimeslice a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeslicerthread ;
    rdfs:range xsd:nonNegativeInteger .
hpc:schedulertype a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range rdf:Resource .
hpc:preemptmode a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range rdf:Resource .
hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:Job .
hpc:hasactivebitmap a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:Activebitmap .
hpc:hasrunqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Timeslicerthread ;
    rdfs:range hpc:Runqueue .
hpc:hassuspendedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Runqueue ;
    rdfs:range hpc:Suspendedjob .
hpc:hasrunnablejob a owl:ObjectProperty ;
    rdfs:domain hpc:Runqueue ;
    rdfs:range hpc:Runnablejob .
hpc:hasconcurrentjob a owl:ObjectProperty ;
    rdfs:domain hpc:Activebitmap ;
    rdfs:range hpc:Concurrentjob .
