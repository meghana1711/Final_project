@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Cluster a owl:Class .
hpc:clustername a owl:ObjectProperty .
hpc:Clustername rdfs:domain hpc:Cluster .
hpc:Clustername rdfs:range xsd:string .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:Resourcename rdfs:domain hpc:Resource .
hpc:Resourcename rdfs:range xsd:string .
hpc:resourcetype a owl:ObjectProperty .
hpc:Resourcetype rdfs:domain hpc:Resource .
hpc:Resourcetype rdfs:range xsd:string .
hpc:resourceinterval a owl:DatatypeProperty .
hpc:Resourceinterval rdfs:domain hpc:Resource .
hpc:Resourceinterval rdfs:range xsd:boolean .
hpc:resourceincreasing a owl:DatatypeProperty .
hpc:Resourceincreasing rdfs:domain hpc:Resource .
hpc:Resourceincreasing rdfs:range xsd:boolean .
hpc:resourcedescription a owl:DatatypeProperty .
hpc:Resourcedescription rdfs:domain hpc:Resource .
hpc:Resourcedescription rdfs:range xsd:string .

hpc:Gpu a owl:Class .
hpc:gpucount a owl:DatatypeProperty .
hpc:Gpucount rdfs:domain hpc:Gpu .
hpc:Gpucount rdfs:range xsd:nonNegativeInteger .

hpc:vgtotalsize a owl:DatatypeProperty .
hpc:Vgtotalsize rdfs:domain hpc:Resource .
hpc:Vgtotalsize rdfs:range xsd:decimal .
hpc:vgavailablesize a owl:DatatypeProperty .
hpc:Vgavailablesize rdfs:domain hpc:Resource .
hpc:Vgavailablesize rdfs:range xsd:decimal .
hpc:ssd0wear a owl:DatatypeProperty .
hpc:Ssd0wear rdfs:domain hpc:Resource .
hpc:Ssd0wear rdfs:range xsd:decimal .
