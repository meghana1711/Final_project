hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:Numanode a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .

hpc:binds rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:requires rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinityrequirement .

hpc:Affinityrequirement a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:Restriction ;
        owl:onProperty hpc:binds ;
        owl:hasValue (hpc:NumaNode | hpc:Socket | hpc:Core) ] .

hpc:same rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:integer .

hpc:localonly rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement .

hpc:localprefer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement .

hpc:exclusive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:string .

hpc:distribute rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:string .

hpc:pack rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement ;
    rdfs:range xsd:integer .

hpc:cpubind rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement .

hpc:membind rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Affinityrequirement .

hpc:cputask rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
