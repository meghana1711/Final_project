hpc:Lsfmpidistribution a owl:Class .
hpc:integratesWithLSF an owl:ObjectProperty .
hpc:openmpthreadaffinity a owl:ObjectProperty .
hpc:reducescpubottleneck a owl:ObjectProperty .
hpc:Cpuallocation a owl:Class .
hpc:Lsfmpitask a owl:Class .
hpc:Openmpthread a owl:Class .
hpc:Submitjobwithaffinityresourcerequirements a owl:Class .
hpc:Ibmpower8system a owl:Class .
hpc:Bsubcommand a owl:Class .
hpc:Bmodcommand a owl:Class .
hpc:Esub a owl:Class .
hpc:rusage a owl:ObjectProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:Jobresourceusage a owl:Class .
hpc:memory a owl:DatatypeProperty .
hpc:swap a owl:DatatypeProperty .
hpc:lsbSubMemUsage a owl:DatatypeProperty .
hpc:lsbSubSwpUsage a owl:DatatypeProperty .
hpc:lsbSubParamFile a owl:DatatypeProperty .

hpc:Lsfmpidistribution rdfs:subClassOf hpc:Jobschedulingsystem .
hpc:Integrateswithlsf rdfs:domain hpc:Lsfmpidistribution ;
                          rdfs:range hpc:Lsf .
hpc:Openmpthreadaffinity rdfs:domain hpc:Lsfmpidistribution ;
                          rdfs:range hpc:Openmpthread .
hpc:Reducescpubottleneck rdfs:domain hpc:Openmpthreadaffinity ;
                          rdfs:range hpc:Cpuallocation .
hpc:Cpuallocation rdfs:subClassOf hpc:Resourceallocation .
hpc:Lsfmpitask rdfs:subClassOf hpc:Mpitask .
hpc:Openmpthread rdfs:subClassOf hpc:Thread .
hpc:Submitjobwithaffinityresourcerequirements rdfs:subClassOf hpc:Jobsubmission .
hpc:Ibmpower8system rdfs:subClassOf hpc:Computingsystem .
hpc:Bsubcommand rdfs:subClassOf hpc:Jobcommand .
hpc:Bmodcommand rdfs:subClassOf hpc:Jobcommand .
hpc:esub a owl:DatatypeProperty ;
                     rdfs:domain hpc:Jobcommand ;
                     rdfs:range hpc:Jobsubmission .
hpc:Rusage rdfs:domain hpc:Jobcommand ;
                  rdfs:range hpc:Resourceusage .
hpc:Mem rdfs:domain hpc:Resourceusage ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Swp rdfs:domain hpc:Resourceusage ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Jobresourceusage rdfs:subClassOf hpc:Resourceusage .
hpc:Memory rdfs:domain hpc:Jobresourceusage ;
               rdfs:range xsd:nonNegative
