hpc:LcPim a owl:Class .
hpc:Lc2Pim a owl:Class .
hpc:LcPreempt a owl:Class .
hpc:Lc2Preempt a owl:Class .
hpc:Lc2Rc a owl:Class .
hpc:LcResource a owl:Class .
hpc:Lc2Resource a owl:Class .
hpc:LcResreq a owl:Class .
hpc:Lc2Resreq a owl:Class .
hpc:LcSched a owl:Class .
hpc:Lc2Sched a owl:Class .
hpc:LcSignal a owl:Class .
hpc:Lc2Signal a owl:Class .
hpc:LcSys a owl:Class .
hpc:Lc2Sys a owl:Class .
hpc:LcTrace a owl:Class .
hpc:Lc2Trace a owl:Class .
hpc:LcXdr a owl:Class .
hpc:Lc2Xdr a owl:Class .
hpc:LcXdrversion a owl:Class .

hpc:LcXdrversion rdfs:subClassOf hpc:LcXdr .

hpc:logmessage a owl:ObjectProperty .
hpc:Logmessage rdfs:domain hpc:LcPim ;
              rdfs:domain hpc:Lc2Pim ;
              rdfs:domain hpc:LcPreempt ;
              rdfs:domain hpc:Lc2Preempt ;
              rdfs:domain hpc:Lc2Rc ;
              rdfs:domain hpc:LcResource ;
              rdfs:domain hpc:Lc2Resource ;
              rdfs:domain hpc:LcResreq ;
              rdfs:domain hpc:Lc2Resreq ;
              rdfs:domain hpc:LcSched ;
              rdfs:domain hpc:Lc2Sched ;
              rdfs:domain hpc:LcSignal ;
              rdfs:domain hpc:Lc2Signal ;
              rdfs:domain hpc:LcSys ;
              rdfs:domain hpc:Lc2Sys ;
              rdfs:domain hpc:LcTrace ;
              rdfs:domain hpc:Lc2Trace ;
              rdfs:domain hpc:LcXdr ;
              rdfs:domain hpc:Lc2Xdr ;

hpc:logxdrversion a owl:DatatypeProperty .
hpc:Logxdrversion rdfs:domain hpc:LcXdrversion ;
hpc:Logxdrversion rdfs:range xsd:nonNegativeInteger .
