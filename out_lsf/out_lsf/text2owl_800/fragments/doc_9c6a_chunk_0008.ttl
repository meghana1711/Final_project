hpc:Product a owl:Class .
hpc:Product rdfs:subClassOf owl:Class .

hpc:hasproduct a owl:ObjectProperty .
hpc:Hasproduct rdfs:domain hpc:User .
hpc:Hasproduct rdfs:range hpc:Product .

hpc:hasinstalledversion a owl:DatatypeProperty .
hpc:Hasinstalledversion rdfs:domain hpc:Product .
hpc:Hasinstalledversion rdfs:range xsd:string .

hpc:hasplatform a owl:ObjectProperty .
hpc:Hasplatform rdfs:domain hpc:Product .
hpc:Hasplatform rdfs:range hpc:Operatingsystem .

hpc:Operatingsystem a owl:Class .
hpc:Operatingsystem rdfs:subClassOf owl:Class .

hpc:browsefixes a owl:ObjectProperty .
hpc:Browsefixes rdfs:domain hpc:User .
hpc:Browsefixes rdfs:range hpc:Fixlist .

hpc:specifysearch a owl:ObjectProperty .
hpc:Specifysearch rdfs:domain hpc:User .
hpc:Specifysearch rdfs:range hpc:Searchcriteria .

hpc:Searchcriteria a owl:Class .
hpc:Searchcriteria rdfs:subClassOf owl:Class .

hpc:hasaparorspr a owl:DatatypeProperty .
hpc:Hasaparorspr rdfs:domain hpc:Searchcriteria .
hpc:Hasaparorspr rdfs:range xsd:string .

hpc:hasindividualfixid a owl:DatatypeProperty .
hpc:Hasindividualfixid rdfs:domain hpc:Searchcriteria .
hpc:Hasindividualfixid rdfs:range xsd:string .

hpc:hasfixid a owl:DatatypeProperty .
hpc:Hasfixid rdfs:domain hpc:Searchcriteria .
hpc:Hasfixid rdfs:range xsd:string .

hpc:hassearchkeywords a owl:DatatypeProperty .
hpc:Hassearchkeywords rdfs:domain hpc:Searchcriteria .
hpc:Hassearchkeywords rdfs:range xsd:string .

hpc:recommendedfixes a owl:ObjectProperty .
hpc:Recommendedfixes rdfs:domain hpc:User .
hpc:Recommendedfixes rdfs:range hpc:Fixlist .
