hpc:Resourcerequirement a owl:Class .
hpc:resourcerequirementstring a owl:DatatypeProperty .
hpc:Job a owl:Class .
hpc:Error a owl:Class .
hpc:Success a owl:Class .
hpc:Resizablejob a owl:Class .
hpc:resizablejobrequirement a owl:ObjectProperty .
hpc:orderstring a owl:DatatypeProperty .
hpc:selectexpression a owl:ObjectProperty .
hpc:Compoundrequirement a owl:Class .
hpc:Alternativerequirement a owl:Class .
hpc:Resizablejobrequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Selectexpression rdfs:domain hpc:Resizablejobrequirement ;
                        rdfs:range hpc:Selectexpression .
hpc:Orderstring rdfs:domain hpc:Resizablejobrequirement ;
                  rdfs:range xsd:string .
hpc:Compoundrequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Alternativerequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Error rdfs:subClassOf hpc:Job .
hpc:Success rdfs:subClassOf hpc:Job .
