    ) ;
    rdf:value rdfs:subClassOf (
        rdf:List (
            rdf:first rdfs:sequence ;
            rdf:rest (
                rdf:List (
                    rdf:first rdf:exists ;
                    rdf:rest rdf:nil
                )
            )
        )
    ) ;
    rdf:value rdfs:subClassOf (
        rdf:List (
            rdf:first rdfs:sequence ;
