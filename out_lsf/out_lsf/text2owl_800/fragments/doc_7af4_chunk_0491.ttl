hpc:Job a owl:Class .
hpc:Jobsubmission a owl:Class .

hpc:hasrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Requirement .

hpc:Requirement a owl:Class .
hpc:requirementmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:requirementmemduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:requirementmemdecay a owl:DatatypeProperty ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:requirementswap a owl:DatatypeProperty ;
    rdfs:domain hpc:Requirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Queue a owl:Class .
hpc:queueresreq a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Requirement .

hpc:Multiphasejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Singlephasejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:queuemultiphaseresreq a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Requirement .

hpc:joblevelrusage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Requirement .

hpc:queuelevelrusage a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Requirement .

hpc:overrides a owl:ObjectProperty ;
    rdfs:domain hpc:Requirement ;
    rdfs:range hpc:Requirement .

hpc:Reservablelimit a owl:Class .
hpc:reservablelimitmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservablelimit ;
    rdfs:range xsd:nonNegativeInteger .
