hpc:Unixaccount a owl:Class .
hpc:Windowsaccount a owl:Class .
hpc:Lsfuserdomain a owl:Class .
hpc:usernameobjectproperty a owl:ObjectProperty .
hpc:domainnameobjectproperty a owl:ObjectProperty .
hpc:usernamedatatypeproperty a owl:DatatypeProperty .
hpc:domainnamedatatypeproperty a owl:DatatypeProperty .

hpc:Unixaccount rdfs:subClassOf owl:Class .
hpc:Windowsaccount rdfs:subClassOf owl:Class .
hpc:Lsfuserdomain rdfs:subClassOf owl:Class .

hpc:Usernameobjectproperty rdfs:domain hpc:Windowsaccount ;
                                 rdfs:range xsd:string .
hpc:Domainnameobjectproperty rdfs:domain hpc:Windowsaccount ;
                                 rdfs:range xsd:string .
hpc:Usernamedatatypeproperty rdfs:domain hpc:Unixaccount ;
                                 rdfs:range xsd:string .
hpc:Domainnamedatatypeproperty rdfs:domain hpc:Windowsaccount ;
                                 rdfs:range xsd:string .

hpc:Windowsaccount hpc:hasusername hpc:UserNameObjectProperty ;
                      hpc:Hasdomainname hpc:domainnameobjectproperty ;
                      hpc:Hasdomainname hpc:domainnamedatatypeproperty .
hpc:Unixaccount hpc:hasusername hpc:UserNameDatatypeProperty .

hpc:WindowsDomainUser a hpc:WindowsAccount ;
                        hpc:hasDomainName [ rdf:value "_:" ( replace(str(<DOMAIN_NAME>), ".", "_") ) ] ;
                        hpc:hasUserName [ rdf:value "_:" ( replace(str(<user_name>), ".", "_") ) ] .
hpc:LocalAccount a hpc:UNIXAccount ;
                   hpc:hasUserName [ rdf:value "_:" ( replace(str(<user_name>), ".", "_") ) ] .


Replace `<DOMAIN_NAME>` and `<user_name>` with actual domain names and user names when using this ontology.
