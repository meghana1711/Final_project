hpc:Activedirectory a owl:Class .
hpc:Ldapprovider a owl:Class .
hpc:connectionurl a owl:ObjectProperty .
hpc:bindtype a owl:ObjectProperty .
hpc:binddn a owl:DatatypeProperty .
hpc:bindcredentials a owl:DatatypeProperty .
hpc:editmode a owl:DatatypeProperty .
hpc:usersdn a owl:DatatypeProperty .
hpc:usernameldap a owl:DatatypeProperty .
hpc:rdn a owl:DatatypeProperty .
hpc:uuid a owl:DatatypeProperty .
hpc:userobjectclasses a owl:DatatypeProperty .
hpc:importusers a owl:ObjectProperty .
hpc:syncregistrations a owl:ObjectProperty .

hpc:Activedirectory rdfs:subClassOf owl:Class .
hpc:Ldapprovider rdfs:subClassOf hpc:Activedirectory .

hpc:Connectionurl rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Bindtype rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Binddn rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Bindcredentials rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Editmode rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Usersdn rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Usernameldap rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Rdn rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Uuid rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Userobjectclasses rdfs:domain hpc:Ldapprovider ;
    rdfs:range xsd:string .
hpc:Importusers rdfs:domain hpc:Ldapprovider ;
    rdfs:range rdf:Boolean .
hpc:Syncregistrations rdfs:domain hpc:Ldapprovider ;
    rdfs:range rdf:Boolean .
