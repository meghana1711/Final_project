hpc:Userdata a owl:Class .
hpc:haskey a owl:ObjectProperty .
hpc:hasvalue a owl:DatatypeProperty .

hpc:Haskey rdfs:domain hpc:Userdata ;
    rdfs:range xsd:string .

hpc:Hasvalue rdfs:domain hpc:Userdata ;
    rdfs:range xsd:string .

hpc:Environmentvariable a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:Template a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:haspriority a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:hasattribute a owl:ObjectProperty .

hpc:Attribute a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hastype a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:range xsd:string .
