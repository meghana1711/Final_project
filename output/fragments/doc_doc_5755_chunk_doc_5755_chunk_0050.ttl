hpc:Job a owl:Class .
hpc:Job hasExitCode owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ProcessTrackingPlugin a owl:Class .
hpc:KernelPatchPlugin rdfs:subClassOf hpc:ProcessTrackingPlugin .
hpc:GroupIDPlugin rdfs:subClassOf hpc:ProcessTrackingPlugin .
hpc:ParentProcessIDPlugin rdfs:subClassOf hpc:ProcessTrackingPlugin .

hpc:SlurmConfig a owl:Class .
hpc:ProctrackType a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfig .

hpc:RequeueJob a owl:Class .
hpc:SpecialExitState a owl:DatatypeProperty ;
    rdfs:domain hpc:RequeueJob .

hpc:EpilogSlurmctld a owl:Class .
hpc:CheckJobExitValue a owl:ObjectProperty ;
    rdfs:domain hpc:EpilogSlurmctld .
```
