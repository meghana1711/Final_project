hpc:Consumableresource a owl:Class .
hpc:Nonconsumableresource a owl:Class .
hpc:Numericresource a owl:Class .
hpc:Stringresource a owl:Class .
hpc:Booleanresource a owl:Class .

hpc:isconsumable a owl:ObjectProperty .
hpc:hastype a owl:DatatypeProperty .
hpc:isnumericresource a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource;
                                             rdfs:range xsd:decimal .
hpc:isstringresource a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource .
hpc:isbooleanresource a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource .

hpc:Releasable a owl:Class .
hpc:usedinorder a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource;
                               rdfs:range hpc:Nonconsumableresource .
hpc:select a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource;
                             rdfs:range hpc:Nonconsumableresource .
hpc:same a owl:ObjectProperty, rdfs:domain hpc:nonconsumableresource;
                             rdfs:range hpc:Nonconsumableresource .

hpc:Rusage a owl:Class .
hpc:rusageContains a owl:ObjectProperty .

hpc:Builtinstaticresource a owl:Class .
hpc:Externalsharedresource a owl:Class .

