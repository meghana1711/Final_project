@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Servicedomain a owl:Class .
hpc:Feature a owl:Class .
hpc:Name a rdfs:Property ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:domain hpc:Feature .
hpc:licServers a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomain .
hpc:NAME rdfs:subPropertyOf hpc:Name .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature .
hpc:featureDelta a owl:ObjectProperty ;
    rdfs:domain hpc:Feature .
hpc:LanServer a hpc:ServiceDomain .
hpc:LanServer1 a hpc:ServiceDomain .
hpc:f1 a hpc:Feature .

hpc:Lanserver rdfs:subClassOf hpc:Servicedomain .
hpc:Lanserver1 rdfs:subClassOf hpc:Servicedomain .
hpc:Lanserver rdfs:subClassOf hpc:Servicedomain ;
    hpc:LicServers rdfs:range xsd:resource .
hpc:Lanserver1 rdfs:subClassOf hpc:Servicedomain ;
    hpc:LicServers rdfs:range xsd:resource .
hpc:F1 rdfs:subClassOf hpc:Feature ;
    hpc:Distribution rdfs:range hpc:Servicedomain ;
    hpc:FeatureDelta rdfs:range xsd:decimal .

hpc:Lanserver hpc:name "LanServer" .
hpc:Lanserver hpc:licServers ( (38000@bl10e-15) (38000@bl10e-16) ) .
hpc:Lanserver1 hpc:name "LanServer1" .
hpc:Lanserver1 hpc:licServers ( (38000@bl10e-17) ) .
hpc:F1 hpc:name "f1" .
hpc:F1 hpc:distribution ( hpc:LanServer p1 1 p2 1 p3 1 ) ( hpc:LanServer1 p1 1 p2 1 ) .
hpc:F1 hpc:featureDelta ( hpc:LanServer mult 1.5 ) ( hpc:LanServer1 abs 4 ) .
