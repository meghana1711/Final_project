hpc:MaxPendSlots a owl:Class ;
    rdfs:comment "The hard system-wide pending slots threshold.";
    rdfs:subClassOf owl:Integer .

hpc:MaxPendJobs a owl:Class ;
    rdfs:comment "The maximum number of pending jobs.";
    rdfs:subClassOf owl:Integer .

hpc:subTryInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxPendJobs ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbNtries a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxPendJobs ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maxPreexecRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxPreexecRetry ;
    rdfs:range xsd:integer ;
    rdfs:constraints ( xsd:minInclusive "1" ; xsd:maxInclusive "2147483647" ) .

hpc:maxPreexecForwardingRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxPreexecRetry ;
    rdfs:range xsd:integer .
