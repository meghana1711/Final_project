# Slurm Workload Manager
hpc:SlurmWorkloadManager a owl:Class .

# Version
hpc:Version a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmWorkloadManager ;
    rdfs:range xsd:string .

# About
hpc:About a owl:Class .

# Overview
hpc:Overview a owl:Class ;
    rdfs:subClassOf hpc:About .

# Release Notes
hpc:ReleaseNotes a owl:Class ;
    rdfs:subClassOf hpc:About .

# Using
hpc:Using a owl:Class .

# Documentation
hpc:Documentation a owl:Class ;
    rdfs:subClassOf hpc:Using .

# FAQ
hpc:FAQ a owl:Class ;
    rdfs:subClassOf hpc:Using .

# Publications
hpc:Publications a owl:Class ;
    rdfs:subClassOf hpc:Using .

# Installing
hpc:Installing a owl:Class .

# Download
hpc:Download a owl:Class ;
    rdfs:subClassOf hpc:Installing .

# Related Software
hpc:RelatedSoftware a owl:Class ;
    rdfs:subClassOf hpc:Installing .

# Installation Guide
hpc:InstallationGuide a owl:Class ;
    rdfs:subClassOf hpc:RelatedSoftware .

# Getting Help
hpc:GettingHelp a owl:Class .

# Mailing Lists
hpc:MailingLists a owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .

# Support and Training
hpc:SupportAndTraining a owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .

# Troubleshooting
hpc:Troubleshooting a owl:Class ;
    rdfs:subClassOf hpc:GettingHelp .

# Profiling Using HDF5 User Guide
hpc:ProfilingUsingHDF5UserGuide a owl:Class ;
    rdfs:subClassOf hpc:Documentation .

# Contents
hpc:Contents a owl:Class .

# Overview
hpc:Overview a owl:Class ;
