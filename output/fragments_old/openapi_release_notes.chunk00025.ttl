hpc:POWERING_DOWN, hpc:DYNAMIC_FUTURE, hpc:REBOOT_ISSUED, hpc:PLANNED, hpc:INVALID_REG, hpc:POWER_DOWN, hpc:POWER_UP, hpc:POWER_DRAIN, hpc:DYNAMIC_NORM in hpc:state .
