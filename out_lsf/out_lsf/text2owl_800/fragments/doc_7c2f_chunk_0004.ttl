hpc:Jobexecution a owl:Class .
hpc:Jobmanagement a owl:Class .
hpc:viewjobinformation a owl:ObjectProperty .
hpc:controljob a owl:ObjectProperty .
hpc:managejobdependencies a owl:ObjectProperty .

hpc:Jobexecution rdfs:subClassOf owl:Class .
hpc:Jobmanagement rdfs:subClassOf owl:Class .
hpc:Viewjobinformation rdfs:domain hpc:Jobmanagement ;
                          rdfs:range rdf:Resource .
hpc:Controljob rdfs:domain hpc:Jobmanagement ;
                rdfs:range rdf:Resource .
hpc:Managejobdependencies rdfs:domain hpc:Jobmanagement ;
                          rdfs:range rdf:Resource .
