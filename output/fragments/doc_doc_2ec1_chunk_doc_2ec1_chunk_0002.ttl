hpc:SlurmComment a owl:Class ;
  rdfs:subClassOf [ a rdf:Class ;
                     rdfs:subClassOf owl:Comment ] .

hpc:SlurmComment rdfs:comment "Comments can be in either C-style /* comment */ or C++ style // comment formats. Follow the rest of Chapter 8’s recommendations for multi-line comments though." .

hpc:BuildSystemChange a owl:Class ;
  rdfs:subClassOf [ a rdf:Class ;
                     rdfs:subClassOf owl:Change ] .

hpc:MakefileAMChange a owl:ObjectProperty ;
  rdfs:domain hpc:BuildSystemChange ;
  rdfs:range xsd:string .

hpc:MakefileInChange a owl:ObjectProperty ;
  rdfs:domain hpc:BuildSystemChange ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf hpc:MakefileAMChange .

hpc:ConfigureACChange a owl:ObjectProperty ;
  rdfs:domain hpc:BuildSystemChange ;
  rdfs:range xsd:string .

hpc:AuxdirChange a owl:ObjectProperty ;
  rdfs:domain hpc:BuildSystemChange ;
  rdfs:range xsd:string .

hpc:Changelog a owl:DatatypeProperty ;
  rdfs:domain hpc:Change .

hpc:Patch a owl:Class ;
  rdfs:subClassOf [ a rdf:Class ;
                     rdfs:subClassOf owl:Change ] .

hpc:LogicalPatch a owl:ObjectProperty ;
  rdfs:domain hpc:Patch ;
  rdfs:range xsd:boolean .

hpc:FunctionalChange a owl:DatatypeProperty ;
  rdfs:domain hpc:Patch .

hpc:AutomatedChange a owl:ObjectProperty ;
  rdfs:domain hpc:Change ;
  rdfs:range xsd:string .
```
