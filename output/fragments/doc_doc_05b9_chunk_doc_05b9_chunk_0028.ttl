hpc:Node a owl:Class .

hpc:NodeAddr a xsd:string .
hpc:NodeHostname a xsd:string .
hpc:NodeState a rdf:List .
hpc:NodeState rdfs:subClassOf xsd:string .
hpc:operating_system a xsd:string .
hpc:User a xsd:string .
hpc:partitions a rdf:List .
hpc:partitions rdfs:subClassOf xsd:string .
hpc:port a xsd:int .
hpc:real_memory a xsd:long .
hpc:res_cores_per_gpu a xsd:int .
hpc:comment a xsd:string .
hpc:reason a xsd:string .
hpc:reason_changed_at a xsd:string .
hpc:reason_set_by_user a xsd:string .
hpc:resume_after a xsd:string .
hpc:reservation a xsd:string .
hpc:alloc_memory a xsd:long .
hpc:alloc_cpus a xsd:int .
hpc:alloc_idle_cpus a xsd:int .
hpc:tres_used a xsd:string .
hpc:tres_weighted a xsd:double .
hpc:slurmd_start_time a xsd:string .
hpc:sockets a xsd:int .
hpc:threads a xsd:int .
hpc:temporary_disk a xsd:int .
hpc:weight a xsd:int .
hpc:topology a xsd:string .
hpc:tres a xsd:string .
hpc:version a xsd:string .
hpc:association_condition a xsd:string .
hpc:account a xsd:string .
hpc:meta a xsd:string .
hpc:errors a rdf:List .
hpc:errors rdfs:subClassOf hpc:openapi_error .
hpc:warnings a rdf:List .
hpc:warnings rdfs:subClassOf hpc:openapi_warning .

hpc:openapi_error a owl:Class .
hpc:openapi_error rdfs:subClassOf rdf:List .
hpc:openapi_error rdfs:domain hpc:errors .
hpc:openapi_error rdfs:range hpc:openapi_error_description .
hpc:openapi_error_description a xsd:string .
hpc:openapi_error_number a xsd:int .
hpc:openapi_error_error a xsd:string .
hpc:openapi_error_source a xsd:string .

hpc
