hpc:Podman a owl:Class .
hpc:InstallPodman a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdminTask ;
    rdfs:range rdf:XMLLiteral .

hpc:ConfigureRootlessPodman a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdminTask ;
    rdfs:range rdf:XMLLiteral .

hpc:VerifyRootlessPodman a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdminTask ;
    rdfs:range rdf:XMLLiteral .

hpc:CheckRootlessPodmanFunctionality a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdminTask ;
    rdfs:range rdf:XMLLiteral .

hpc:ConfigurePodmanToCallScrun a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdminTask ;
    rdfs:range rdf:XMLLiteral .

hpc:ContainersConfLocation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
                           rdf:type owl:Class ;
                           owl:onProperty hpc:containersConfLocation ;
                           owl:allValuesFrom ( [ a owl:DataSomeValuesFrom ;
                                                owl:onProperty hpc:os ;
                                                owl:allValuesFrom ( [ a xsd:string ;
                                                                     owl:equalTo "/etc/containers/containers.conf" ] ) ] ) ;
                           owl:onClass hpc:LinuxSystem ] .

hpc:PerUserContainersConfLocation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
                           rdf:type owl:Class ;
                           owl:onProperty hpc:containersConfLocation ;
                           owl:allValuesFrom ( [ a owl:DataSomeValuesFrom ;
                                                owl:onProperty hpc:os ;
                                                owl:allValuesFrom ( [ a xsd:string ;
                                                                     owl:or ( [ a xsd:string ;
                                                                               owl:equalTo "$XDG_CONFIG_HOME/containers/containers.conf" ] ) ;
                                                                     [ a xsd:string ;
                                                                       owl:equalTo "~/.config/containers/containers.conf" ] ) ] ) ;
                                                owl:onClass hpc:LinuxSystem ] ] .

hpc:ContainersConf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
                           rdf:type owl:Class ;
                           owl:onProperty hpc:containersConf ;
                           owl:allValuesFrom ( [ a owl:DataSomeValuesFrom ;
                                                owl:onProperty hpc:os ;
                                                owl:allValuesFrom ( [ a xsd:string ;
