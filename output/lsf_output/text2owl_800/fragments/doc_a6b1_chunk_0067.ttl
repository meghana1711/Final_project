hpc:Lsf a owl:Class .
hpc:LsfServerdir a owl:Class .
hpc:Erenew a owl:Class .
hpc:Renewhook a owl:Class .
hpc:TGT a xsd:string .
hpc:Kerberosauthentication a owl:Class .
hpc:Tgtforwarding a owl:Class .
hpc:Usereauth a owl:Class .
hpc:Interdaemonauthentication a owl:Class .
hpc:lsbKrbLibPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:lsbKrbTgtFwd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:lsbKrbCheckInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Kdcserver a owl:Class .
hpc:Principal a owl:Class .
hpc:eauth a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Eauth .
hpc:eauthkrb5 a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Eauthkrb5 .
hpc:aklog a owl:ObjectProperty ;
    rdfs:domain hpc:Afsuser ;
    rdfs:range hpc:Aklog .
hpc:tgtforwardingenabled a owl:ObjectProperty ;
    rdfs:domain hpc:Principal ;
    rdfs:range xsd:boolean .
