<http://example.org/hpc-onto#mode> a owl:Class ;
    rdfs:label "mode" .

<http://example.org/hpc-onto#command> a owl:Class ;
    rdfs:label "command" .

<http://example.org/hpc-onto#default> a owl:Class ;
    rdfs:label "default" .

<http://example.org/hpc-onto#resource> a owl:Class ;
    rdfs:label "resource" .

<http://example.org/hpc-onto#number> a owl:Class ;
    rdfs:label "number" .

<http://example.org/hpc-onto#directory> a owl:Class ;
    rdfs:label "directory" .

<http://example.org/hpc-onto#type> a owl:Class ;
    rdfs:label "type" .

<http://example.org/hpc-onto#system> a owl:Class ;
    rdfs:label "system" .

<http://example.org/hpc-onto#time> a owl:Class ;
    rdfs:label "time" .

<http://example.org/hpc-onto#limit> a owl:Class,
        owl:ObjectProperty ;
    rdfs:label "limit" .

<http://example.org/hpc-onto#config_file> a owl:Class ;
    rdfs:label "config file",
        "config_file" ;
    rdfs:subClassOf <http://example.org/hpc-onto#file> .

<http://example.org/hpc-onto#file> a owl:Class ;
    rdfs:label "file" .

