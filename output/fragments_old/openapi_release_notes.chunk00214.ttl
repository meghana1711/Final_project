hpc:OpenapiAssocsRemovedResp a owl:Class .
hpc:OpenapiClustersResp a owl:Class .
hpc:OpenapiResp a owl:Class .

hpc:hasResponse a owl:ObjectProperty .
hpc:hasResponse rdfs:domain hpc:OpenapiResp .
hpc:hasResponse rdfs:range hpc:Response .

hpc:Response a owl:Class .
hpc:ResponseCode a xsd:integer .
hpc:ResponseContent a owl:DatatypeProperty .
hpc:ResponseContent rdfs:domain hpc:Response .
hpc:ResponseContent rdfs:range xsd:string .
hpc:ResponseContentMediaType a xsd:string .
hpc:ResponseContentMediaType rdfs:domain hpc:ResponseContent .
hpc:ResponseContentSchema a owl:ObjectProperty .
hpc:ResponseContentSchema rdfs:domain hpc:ResponseContent .
hpc:ResponseContentSchema rdfs:range hpc:Schema .

hpc:Schema a owl:Class .
hpc:SchemaRef a xsd:string .
hpc:SchemaRef rdfs:domain hpc:Schema .

hpc:Associations a rdfs:Class .
hpc:Cluster a rdfs:Class .

hpc:post a rdfs:SubClassOf hpc:Associations .
hpc:delete a rdfs:SubClassOf hpc:Associations .
hpc:get a rdfs:SubClassOf hpc:Cluster .

hpc:path a xsd:string .
hpc:path rdfs:domain hpc:Associations .
hpc:path rdfs:range rdf:Property .

hpc:version a xsd:string .
hpc:version rdfs:domain hpc:Schema .
hpc:version rdfs:range xsd:string .
