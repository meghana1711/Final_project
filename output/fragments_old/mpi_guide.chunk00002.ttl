hpc:SlurmInstallation a owl:Class .
hpc:SlurmInstallation rdfs:subClassOf owl:Thing .

hpc:hasConfigLog a owl:ObjectProperty .
hpc:hasConfigLog rdfs:domain hpc:SlurmInstallation ;
                  rdfs:range rdf:Resource .

hpc:hasBuildDirectory a owl:ObjectProperty .
hpc:hasBuildDirectory rdfs:domain hpc:SlurmInstallation ;
                      rdfs:range rdf:Resource .

hpc:hasPmiInstallation a owl:ObjectProperty .
hpc:hasPmiInstallation rdfs:domain hpc:SlurmInstallation ;
                       rdfs:range rdf:Resource .

hpc:PmiInstallation a owl:Class .
hpc:PmiInstallation rdfs:subClassOf owl:Thing .

hpc:hasLocation a owl:ObjectProperty .
hpc:hasLocation rdfs:domain hpc:PmiInstallation ;
                 rdfs:range rdf:Resource .

hpc:hasVersion a owl:DatatypeProperty .
hpc:hasVersion rdfs:domain hpc:PmiInstallation ;
                 rdfs:range xsd:string .

# PMI-1 and PMI-2 Installation
hpc:Pmi1Installation a owl:Class ;
                     hpc:Pmi1Installation rdfs:subClassOf hpc:PmiInstallation .

hpc:Pmi2Installation a owl:Class ;
                     hpc:Pmi2Installation rdfs:subClassOf hpc:PmiInstallation .

# Slurm Configuration
hpc:SlurmConfiguration a owl:Class .
hpc:SlurmConfiguration rdfs:subClassOf owl:Thing .

hpc:hasTmpFS a owl:ObjectProperty .
hpc:hasTmpFS rdfs:domain hpc:SlurmConfiguration ;
               rdfs:range rdf:Resource .

hpc:hasTmpFSPath a owl:DatatypeProperty .
hpc:hasTmpFSPath rdfs:domain hpc:SlurmConfiguration ;
                  rdfs:range xsd:string .

# Test Environment
hpc:TestEnvironment a owl:Class .
hpc:TestEnvironment rdfs:subClassOf owl:Thing .

hpc:hasSlurmNodes a owl:ObjectProperty .
hpc:hasSlurmNodes rdfs:domain hpc:TestEnvironment ;
                   rdfs:range rdf:List .

hpc:hasSlurmNode a owl:ObjectProperty .
hpc:hasSlurmNode rdfs:domain hpc:TestEnvironment ;
                  rdfs:range rdf:Resource .

# PMIx Test
hpc:Pmixtest a owl:Class .
hpc:Pmixtest rdfs:subClassOf owl:Thing .

hpc:hasSrunCommand a owl:ObjectProperty .
hpc:hasSrunCommand rdfs:domain hpc:Pmixtest ;
                    rdfs:range rdf:Resource .

