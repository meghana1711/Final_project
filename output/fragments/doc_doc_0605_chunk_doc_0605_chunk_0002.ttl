hpc:SlurmIndex a owl:Class .
hpc:ElasticsearchServer a owl:Class .
hpc:JobDocument a owl:Class .
hpc:IndexDataFromCluster an owl:ObjectProperty .
hpc:ConfigurableURL a owl:ObjectProperty .
hpc:DebugFlags a owl:DatatypeProperty .
hpc:Kibana a owl:Class .
hpc:DataVisualizationLayer a owl:Class .
hpc:ElasticsearchIndexConfig a owl:DatatypeProperty .
hpc:CurlCommand a owl:Class .
hpc:RESTRequest a owl:Class .
hpc:QueryJobInformation an owl:ObjectProperty .
hpc:DocumentCount a owl:DatatypeProperty .
hpc:QueryAllIndexedJobs an owl:ObjectProperty .
hpc:DeleteIndex an owl:ObjectProperty .
hpc:CatOptionsQuery an owl:ObjectProperty .

hpc:SlurmIndex rdfs:subClassOf hpc:JobDocument .
hpc:ElasticsearchServer rdfs:subClassOf hpc:Server .
hpc:JobDocument rdf:type owl:Thing .
hpc:IndexDataFromCluster rdfs:domain hpc:ElasticsearchServer ;
                          rdfs:range hpc:SlurmIndex .
hpc:ConfigurableURL rdfs:domain hpc:ElasticsearchServer .
hpc:DebugFlags rdfs:domain hpc:ElasticsearchServer ;
                 rdfs:range xsd:string .
hpc:Kibana rdfs:subClassOf hpc:DataVisualizationLayer .
hpc:DataVisualizationLayer rdf:type owl:Thing .
hpc:ElasticsearchIndexConfig rdfs:domain hpc:Kibana ;
                             rdfs:range xsd:string .
hpc:CurlCommand rdf:type owl:Thing .
hpc:RESTRequest rdf:type owl:Thing .
hpc:QueryJobInformation rdfs:domain hpc:CurlCommand ;
                         rdfs:range hpc:JobDocument .
hpc:DocumentCount rdfs:domain hpc:RESTRequest ;
                   rdfs:range xsd:integer .
hpc:QueryAllIndexedJobs rdfs:domain hpc:RESTRequest ;
                         rdfs:range hpc:JobDocument .
hpc:DeleteIndex rdfs:domain hpc:CurlCommand .
hpc:CatOptionsQuery rdfs:domain hpc:CurlCommand ;
                    rdfs:range hpc:RESTRequest .
```
