hpc:User a owl:Class .
hpc:userGroup a owl:ObjectProperty .
hpc:Queue a owl:Class .
hpc:jobName a owl:DatatypeProperty .
hpc:jobDescription a owl:DatatypeProperty .
hpc:projName a owl:DatatypeProperty .
hpc:application a owl:DatatypeProperty .
hpc:serviceClass a owl:DatatypeProperty .
hpc:jobGroup a owl:ObjectProperty .

hpc:User rdfs:subClassOf rdf:Resource .
hpc:UserGroup rdfs:domain hpc:User ;
    rdfs:range hpc:UserGroup .
hpc:Queue rdfs:subClassOf rdf:Resource .
hpc:JobName rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JobDescription rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:ProjName rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Application rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:ServiceClass rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:JobGroup rdfs:domain hpc:Job ;
    rdfs:range hpc:JobGroup .
