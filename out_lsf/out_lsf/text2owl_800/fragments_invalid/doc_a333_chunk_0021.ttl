    rdfs:domain hpc:Experiment ;
    rdfs:range xsd:integer .

hpc:Baseline
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Experiment ;
    rdfs:range hpc:Cluster .

hpc:Graphs
