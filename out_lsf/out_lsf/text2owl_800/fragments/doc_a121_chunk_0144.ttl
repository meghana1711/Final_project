hpc:remoteMaxPreexecRetr a owl:DatatypeProperty .
hpc:RemoteMaxPreexecRetr rdfs:domain hpc:Job .
hpc:RemoteMaxPreexecRetr rdfs:range xsd:integer .

hpc:localMaxPreexecRetry a owl:DatatypeProperty .
hpc:LocalMaxPreexecRetry rdfs:domain hpc:Job .
hpc:LocalMaxPreexecRetry rdfs:range xsd:integer .

hpc:localMaxPreexecRetryAction a owl:ObjectProperty .
hpc:LocalMaxPreexecRetryAction rdfs:domain hpc:Job .
hpc:LocalMaxPreexecRetryAction rdfs:range hpc:Jobbehavior .

hpc:Jobbehavior a owl:Class .
hpc:Jobbehavior rdfs:subClassOf owl:Thing .

hpc:Suspend a owl:Class .
hpc:Exit a owl:Class .
