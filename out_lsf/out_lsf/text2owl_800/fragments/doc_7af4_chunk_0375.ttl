hpc:Reschedulablejob a owl:Class .
hpc:ReschedUponCsmSetupError rdfs:domain hpc:Reschedulablejob ;
    rdfs:range xsd:string .

hpc:reschedulablejob a owl:ObjectProperty .

hpc:Jobstate a owl:Class .
hpc:ExitCsmAlloc rdfs:domain hpc:Jobstate ;
    rdfs:range xsd:string .
hpc:PendCsmApiBadNode rdfs:domain hpc:Jobstate ;
    rdfs:range xsd:string .
hpc:PendCsmPrejobFail rdfs:domain hpc:Jobstate ;
    rdfs:range xsd:string .

hpc:Job a owl:Class .
hpc:nontransferjob a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Job .

hpc:Apsenabled a owl:Class .

hpc:Resizablejob a owl:Class .
hpc:resizablejobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .

hpc:resizablejob a owl:ObjectProperty .
hpc:n rdfs:subPropertyOf hpc:resizableJobs ;
    rdfs:range xsd:string .
hpc:y rdfs:subPropertyOf hpc:resizableJobs ;
    rdfs:range xsd:string .
