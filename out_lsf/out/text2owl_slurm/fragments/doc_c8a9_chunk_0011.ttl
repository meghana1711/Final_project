hpc:Hasnodes rdfs:range rdf:List .
hpc:Nodelist rdfs:subClassOf rdf:List .
hpc:Nodelist rdfs:domain hpc:Partition .
hpc:Nodelist rdfs:range hpc:Node .
hpc:hasreason a owl:DatatypeProperty .
