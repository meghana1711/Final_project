hpc:Gpu a owl:Class .
hpc:Mps a owl:Class .
hpc:allocatedAs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range hpc:Gpu .
hpc:allocatedAsMPS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Mps ;
    rdfs:range hpc:Mps .
hpc:totalCount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Mps ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cannotAllocateAtSameTime rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range hpc:Mps .
hpc:cannotRequestWithinJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Mps .
hpc:cannotSpecifyFrequency rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Prologprogram a owl:Class .
hpc:startAndStopMPSServers rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Prologprogram ;
    rdfs:range hpc:Job .
hpc:CUDA_VISIBLE_DEVICES rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Prologprogram ;
    rdfs:range xsd:string .
hpc:CUDA_MPS_ACTIVE_THREAD_PERCENTAGE rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Prologprogram ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SLURM_JOB_UID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Prologprogram ;
    rdfs:range xsd:string .
hpc:Mpsjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Mpsgres a owl:Class ;
    rdfs:subClassOf hpc:Gres .
hpc:Gpugres a owl:Class ;
    rdfs:subClassOf hpc:Gres .
