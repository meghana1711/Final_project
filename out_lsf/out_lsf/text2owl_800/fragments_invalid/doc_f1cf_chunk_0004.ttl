hpc:Queueinfoentity a owl:Class.
hpc:Queue a rdfs:range hpc:Queueinfoentity;
    rdfs:domain hpc:Getqueueinfobyname;
    rdfs:subClassOf owl:ObjectProperty.

hpc:queuename a owl:DatatypeProperty;
    rdfs:domain hpc:Queueinfoentity.

hpc:queuedescription a owl:DatatypeProperty;
    rdfs:domain hpc:Queueinfoentity.

# Special case for None entity
hpc:None a owl:Class;
    rdf:type hpc:QueueInfoEntity;
    hpc:queue "None" ;
    hpc:queueDescription "" .
