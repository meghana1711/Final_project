hpc:Files a owl:Class .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Files .
hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Files .
hpc:preemptivedelay a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Suspendedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Exclusivejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Host a owl:Class ;
hpc:Jobslot a owl:Class ;
hpc:Globalresource a owl:Class ;
hpc:Staticglobalresource a owl:Class ;
hpc:Dynamicglobalresource a owl:Class ;
hpc:Globalresourceelim a owl:Class ;
hpc:resourcerequirementstring a owl:DatatypeProperty ;
    rdfs:domain hpc:Globalresource .
