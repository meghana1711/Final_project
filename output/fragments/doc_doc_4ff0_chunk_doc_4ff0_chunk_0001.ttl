hpc:File a owl:Class .
hpc:hasGitBranch rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:ModifiesMakefileAM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File .

hpc:ExecutesAutoreconf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurm .

hpc:HasOlderVersionsOf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:ManuallyModifiesMakefileIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File .

hpc:RebuildsAllMakefileInFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:File .

hpc:Plugin a owl:Class .
hpc:HasDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .

hpc:AddsToMakefileAM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .

hpc:Named rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .
