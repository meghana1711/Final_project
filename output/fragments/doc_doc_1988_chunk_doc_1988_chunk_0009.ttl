hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Slurm .
hpc:PerformanceMaximization a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
hpc:CPUBinding a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
