hpc:Inputfile a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Inputfile ] ;
                                          rdfs:hasValue xsd:string ] ] ;
    rdfs:comment "Any type of file, typically a shell script text file." .

hpc:Specialcharacters a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Inputfile ] ;
                                          rdfs:hasValue " %J | %I | %T | %X " ] ] ;
    rdfs:comment "Replaced by the job ID, job array index, task ID, and task array index respectively." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Replaced by the job ID." .

hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Replaced by the job array index." .

hpc:taskid a owl:DatatypeProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Replaced with the task ID." .

hpc:taskarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Replaced by the task array index." .

hpc:inputfilepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The file path can contain up to 4094 characters, including the directory, file name, and expanded values for %J, %I, %T, and %X." .

hpc:Indexlist a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          rdfs:onProperty [ rdf:type owl:ObjectProperty ;
                                                             rdfs:domain hpc:Indexlist ] ;
                                          rdfs:hasValue "[]" ] ] ;
    rdfs:comment "The list of indices for the task array." .

