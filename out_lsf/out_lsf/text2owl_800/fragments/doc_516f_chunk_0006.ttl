hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf hpc:Group ;
    rdfs:comment "Represents a group of jobs in the HPC system." .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job ;
    rdfs:comment "Relates a job group to the jobs it contains." .

hpc:jobstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The current status of a job." .

hpc:jobqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The queue the job is currently in." .

hpc:jobcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The command that was used to submit the job." .

hpc:jobsubmissiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time when the job was submitted." .

hpc:jobhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The host from which the job was submitted." .

hpc:jobcwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The current working directory of the job." .

hpc:jobrequestedresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The resources requested by the job." .

hpc:jobpendingreasons a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The reasons why the job is pending." .

hpc:jobschedulingparameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The scheduling parameters for the job." .

hpc:slaproperty a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "The properties of a service class configured in lsb.serviceclasses." .

hpc:slahistoricalperformance a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Relates a service class to its historical performance." .
