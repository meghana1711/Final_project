hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Process ;
    rdfs:range xsd:nonNegativeInteger .

hpc:stacklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Process ;
    rdfs:range xsd:nonNegativeInteger .

hpc:cpufactor a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range xsd:nonNegativeFloat .

hpc:Executionhost a owl:Class .
hpc:Process a owl:Class .

hpc:bindJob a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:NCName .

hpc:Applicationprofile a owl:Class .

hpc:applicationname a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:testprocessorbindingoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Applicationprofile .

hpc:bindJobDefined a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .

hpc:checkpointDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .

hpc:chkpntDir a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Directory .

hpc:Directory a owl:Class .

hpc:chkpntInitperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .

hpc:chkpntPeriod a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .

hpc:chkpntInitperiodElapse a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .

hpc:chkpntPeriodic a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .
