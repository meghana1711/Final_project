hpc:Echkpntapplication a owl:Class .
hpc:Echkpntmethoddirectory a owl:Class .
hpc:Enablesestimation a owl:Class .

hpc:Hasechkpntmethoddirectory hpc:Echkpntapplication rdfs:domain hpc:Echkpntapplication ;
  rdfs:range hpc:Echkpntmethoddirectory .

hpc:haspath hpc:echkpntmethoddirectory a owl:DatatypeProperty ;
  rdfs:domain hpc:Echkpntmethoddirectory ;
  rdfs:range xsd:string .

hpc:enablesestimation hpc:enablesestimation a owl:ObjectProperty ;
  rdfs:domain hpc:Enablesestimation ;
  rdfs:range xsd:string .
