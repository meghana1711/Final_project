hpc:lsbGslaDisplayAllocHosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationparameter ;
    rdfs:range xsd:boolean .

hpc:lsbLshostsFormat a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationparameter ;
    rdfs:range xsd:string .

hpc:lsfBjobsFormat a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationparameter ;
    rdfs:range xsd:string .

# LSF Commands
hpc:Bsla a owl:Class .
hpc:Bjobs a owl:Class .
hpc:Bkill a owl:Class .
hpc:Lshosts a owl:Class .

# bsla Command Options
hpc:lsAllocHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Bsla ;
    rdfs:range hpc:Usedguaranteehost .

hpc:slaPresent a owl:ObjectProperty ;
    rdfs:domain hpc:Bsla ;
    rdfs:range xsd:boolean .

# bjobs Command Options
hpc:nreqSlot a owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:nonNegativeInteger .

# bjobs and LSF_BJOBS_FORMAT Output Fields
hpc:gpuNum a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

# bkill Command Option
hpc:-C_REASON a owl:DatatypeProperty ;
    rdfs:domain hpc:Bkill ;
    rdfs:range xsd:string .

# Custom Host Resource Information Output
hpc:Customhostresourceinformationoutput a owl:Class .

# Used Guarantee Host
hpc:Usedguaranteehost a owl:Class ;
    rdfs:subClassOf hpc:Host .
