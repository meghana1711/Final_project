hpc:JobState a owl:DatatypeProperty ;
    rdfs:domain hpc:JobMessage ;
    rdfs:range xsd:string ;
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf rdf:list .

hpc:JobStateItems a owl:Class ;
    rdf:type owl:Restriction ;
    rdfs:subClassOf hpc:JobState ;
    owl:onClass hpc:JobState ;
    owl:hasValue ( "PENDING"^^xsd:string
                   "RUNNING"^^xsd:string
                   "SUSPENDED"^^xsd:string
                   "COMPLETED"^^xsd:string
                   "CANCELLED"^^xsd:string
                   "FAILED"^^xsd:string
                   "TIMEOUT"^^xsd:string
                   "NODE_FAIL"^^xsd:string
                   "PREEMPTED"^^xsd:string
                   "BOOT_FAIL"^^xsd:string
                   "DEADLINE"^^xsd:string
                   "OUT_OF_MEMORY"^^xsd:string
                   "LAUNCH_FAILED"^^xsd:string
                   "REQUEUED"^^xsd:string
                   "REQUEUE_HOLD"^^xsd:string
                   "SPECIAL_EXIT"^^xsd:string
                   "RESIZING"^^xsd:string
                   "CONFIGURING"^^xsd:string
                   "COMPLETING"^^xsd:string
                   "STOPPED"^^xsd:string
                   "RECONFIG_FAIL"^^xsd:string
                   "POWER_UP_NODE"^^xsd:string
                   "REVOKED"^^xsd:string
                   "REQUEUE_FED"^^xsd:string
                   "RESV_DEL_HOLD"^^xsd:string
                   "SIGNALING"^^xsd:string
                   "STAGE_OUT"^^xsd:string ) .
```
