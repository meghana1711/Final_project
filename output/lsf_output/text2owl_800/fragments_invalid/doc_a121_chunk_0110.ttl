hpc:Job a owl:Class .
hpc:exitcode a owl:DatatypeProperty .
hpc:Host a owl:Class .
hpc:requeuestatus a owl:ObjectProperty .
hpc:Hosts a rdfs:Bag .
hpc:requeueexitvalues a owl:DatatypeProperty .
hpc:excludeexitcode a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Exitcode rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Requeuestatus rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:Hosts rdfs:range hpc:Host .
hpc:Requeueexitvalues rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Excludeexitcode rdfs:domain hpc:Requeueexitvalues .

hpc:RequeueStatus rdfs:subPropertyOf owl:ObjectProperty .
hpc:Hosts rdfs:subPropertyOf owl:ObjectProperty .
hpc:RequeueExitValues rdfs:subPropertyOf owl:DatatypeProperty .
hpc:ExcludeExitCode rdfs:subPropertyOf owl:ObjectProperty .

hpc:Re-QueuedJob a hpc:Job ;
    hpc:Requeuestatus hpc:pending ;
    hpc:RequeueExitValues ?value .
hpc:DispatchedJob a hpc:Job ;
    hpc:Requeuestatus hpc:dispatched ;
    hpc:Host ?host .
hpc:PendingJob a hpc:Job ;
    hpc:Requeuestatus hpc:pending .

hpc:HostA a hpc:Host .
hpc:hostB a hpc:Host .
hpc:hostC a hpc:Host .

hpc:Re-QueuedJob[hpc:RequeueExitValues=30; hpc:ExcludeExitCode=20] a hpc:DispatchedJob ;
    hpc:Host (hpc:HostA hpc:hostB hpc:hostC) .
hpc:Re-QueuedJob[hpc:RequeueExitValues=20; hpc:ExcludeExitCode=20] a hpc:PendingJob ;
    FILTER(?host != hpc:HostA) .
hpc:Re-QueuedJob[hpc:RequeueExitValues=20; hpc:Host=hpc:hostA] a hpc:PendingJob .
