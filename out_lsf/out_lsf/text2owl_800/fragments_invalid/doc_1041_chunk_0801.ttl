hpc:FieldJustification a owl:Enum;
  rdfs:label "justification"@en;
  rdfs:comment "Specifies the justification for a field's output in lshosts.";
  rdfs:subClassOf owl:Enum;
  rdf:type rdf:Property;
  rdfs:range xsd:string.

hpc:RightJustification a hpc:FieldJustification; rdfs:label "right"@en.
hpc:LeftJustification a hpc:FieldJustification; rdfs:label "left"@en.

hpc:Fieldunit a owl:Class;
  rdfs:label "field unit"@en;
  rdfs:comment "Specifies the unit for a field's output in lshosts.";
  rdfs:subClassOf owl:Class.

hpc:Builtinconversion a owl:Class;
  rdfs:label "built-in conversion"@en;
  rdfs:comment "Specifies a built-in conversion for space or capacity, duration or time.";
  rdfs:subClassOf owl:Class.

hpc:SpaceOrCapacityConversion a hpc:BuiltInConversion;
  rdfs:label "space or capacity"@en;
  rdfs:comment "Specifies a built-in conversion for space or capacity.";
  rdfs:subClassOf owl:Class.

hpc:DurationOrTimeConversion a hpc:BuiltInConversion;
  rdfs:label "duration or time"@en;
  rdfs:comment "Specifies a built-in conversion for duration or time.";
  rdfs:subClassOf owl:Class.

hpc:Field a owl:Class;
  rdfs:label "field"@en;
  rdfs:comment "Represents a field in lshosts.";
  rdfs:subClassOf owl:Class.

hpc:hasjustification a owl:ObjectProperty;
  rdfs:domain hpc:Field;
  rdfs:range hpc:Fieldjustification.

hpc:hasunit a owl:ObjectProperty;
  rdfs:domain hpc:Field;
  rdfs:range hpc:Fieldunit.

hpc:hasconversion a owl:ObjectProperty;
  rdfs:domain hpc:Fieldunit;
  rdfs:range hpc:Builtinconversion.

hpc:spaceorcapacityconversionunit a owl:DatatypeProperty;
  rdfs:domain hpc:Spaceorcapacityconversion;
  rdfs:range xsd:string;
  rdfs:range rdfs:literal;
  rdfs:comment "Specifies the unit for space or capacity conversion.".

hpc:durationortimeconversionunit a owl:DatatypeProperty;
  rdfs:domain hpc:Durationortimeconversion;
  rdfs:range xsd:string;
  rdfs:range rdfs:literal;
  rdfs:comment "Specifies the unit for duration or time conversion.".

hpc:hasname a owl:DatatypeProperty;
  rdfs:domain hpc:Field;
  rdfs:range xsd:string;
  rdfs:range rdfs
