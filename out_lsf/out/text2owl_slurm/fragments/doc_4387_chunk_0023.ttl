hpc:executeline a owl:ObjectProperty .
hpc:Entity a owl:Class .
hpc:Option a owl:Class .
hpc:modify a owl:ObjectProperty .
hpc:remove a owl:ObjectProperty .
hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:default a owl:DatatypeProperty .
hpc:Accounting a owl:Class .
hpc:Task a owl:Class .

hpc:Executeline rdfs:domain hpc:Entity .
hpc:Modify rdfs:domain hpc:Executeline .
hpc:Remove rdfs:domain hpc:Executeline .
hpc:User rdfs:subClassOf hpc:Entity .
hpc:Account rdfs:subClassOf hpc:Entity .
hpc:Default rdfs:domain hpc:User .
hpc:Default rdfs:range xsd:string .
hpc:Accounting rdfs:subClassOf hpc:Entity .
hpc:Task rdfs:subClassOf hpc:Accounting .
