hpc:Nodestatuschange a owl:Class .
hpc:Reason rdfs:domain hpc:Nodestatuschange ;
    rdfs:range xsd:string .
hpc:Time rdfs:domain hpc:Nodestatuschange ;
    rdfs:range xsd:dateTime .
hpc:Insufficientresources rdfs:subClassOf hpc:Reason .
hpc:Notresponding rdfs:subClassOf hpc:Reason .
hpc:Communicationissue rdfs:subClassOf hpc:Reason ;
    rdfs:subClassOf hpc:Notresponding .
hpc:Diskspaceissue rdfs:subClassOf hpc:Insufficientresources .
hpc:Memoryspaceissue rdfs:subClassOf hpc:Insufficientresources .
hpc:Fixnode rdfs:subClassOf hpc:Action .
hpc:Changeslurmconf rdfs:subClassOf hpc:Action .
hpc:Ping rdfs:domain hpc:Communicationissue ;
    rdfs:range xsd:boolean .
hpc:Nodeaddr rdfs:domain hpc:Ping ;
    rdfs:range xsd:string .
hpc:Checkcommunications rdfs:subClassOf hpc:Action .
hpc:Loginnode rdfs:domain hpc:Action ;
    rdfs:range xsd:string .
hpc:Slurmddaemon rdfs:domain hpc:Action ;
    rdfs:range xsd:string .
hpc:Psel rdfs:domain hpc:Action ;
    rdfs:range xsd:string .
hpc:Grepslurmd rdfs:domain hpc:Psel ;
    rdfs:range xsd:string .
hpc:Restartslurmd rdfs:subClassOf hpc:Action .
hpc:Slurmdlog rdfs:domain hpc:Action ;
    rdfs:range xsd:string .
hpc:Scontrolshowslurmd rdfs:domain hpc:Action ;
    rdfs:range xsd:string .
hpc:Lastslurmctldmsgtime rdfs:domain hpc:Scontrolshowslurmd ;
    rdfs:range xsd:dateTime .
hpc:Slurmdnotresponding rdfs:subClassOf hpc:Notresponding .
hpc:Killandrestartslurmd rdfs:subClassOf hpc:Action .
hpc:Slurmctldcommunication rdfs:subClassOf hpc:Action .
hpc:Increasedebugmessages rdfs:subClassOf hpc:Action .
hpc:Slurmstop rdfs:domain hpc:Killandrestartslurmd ;
    rdfs:range xsd:string .
hpc:Slurmstart rdfs:domain hpc:Killandrestartslurmd ;
    rdfs:range xsd:string .
hpc:Slurmstartclean rdfs:subClassOf hpc:Killandrestartslurmd .
hpc:Slurmddebug rdfs:domain hpc:Increasedebugmessages ;
    rdfs:range xsd:integer .
