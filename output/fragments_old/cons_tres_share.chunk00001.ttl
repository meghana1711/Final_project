# Classes
hpc:Partition a owl:Class .
hpc:ConsumableResource a owl:Class .
hpc:Core a hpc:ConsumableResource .
hpc:Socket a hpc:ConsumableResource .
hpc:CPU a hpc:ConsumableResource .
hpc:Node a owl:Class .
hpc:Job a owl:Class .

# Object Properties
hpc:hasPartition a owl:ObjectProperty .
hpc:hasConsumableResource a owl:ObjectProperty .
hpc:isShared a owl:ObjectProperty .

# Datatype Properties
hpc:overSubscribe a owl:DatatypeProperty .
hpc:overSubscribeRange a xsd:string .

# Subclass relations
hpc:SelectType_cons_tres rdfs:subClassOf hpc:Partition .
hpc:SelectType_linear rdfs:subClassOf hpc:Partition .

# Domain and Range
hpc:hasPartition rdfs:domain hpc:Node ;
    rdfs:range hpc:Partition .
hpc:hasConsumableResource rdfs:domain hpc:Partition ;
    rdfs:range hpc:ConsumableResource .
hpc:isShared rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

# OverSubscribe property values
hpc:NO "NO" .
hpc:YES "YES" .
hpc:FORCE "FORCE" .

# SelectTypeParameters values
hpc:CR_Core "CR_Core" .
hpc:CR_Core_Memory "CR_Core_Memory" .
hpc:CR_CPU "CR_CPU" .
hpc:CR_CPU_Memory "CR_CPU_Memory" .
hpc:CR_Socket "CR_Socket" .
hpc:CR_Socket_Memory "CR_Socket_Memory" .

# Resulting Behavior table
hpc:SelectType_cons_tres_OverSubscribe_NO hpc:hasConsumableResource hpc:Core ;
    hpc:isShared xsd:false .
hpc:SelectType_cons_tres_OverSubscribe_YES hpc:hasConsumableResource hpc:Core ;
    hpc:isShared xsd:false .
hpc:SelectType_cons_tres_OverSubscribe_FORCE hpc:hasConsumableResource hpc:Core ;
    hpc:isShared xsd:true .
hpc:SelectType_cons_tres_CR_Core hpc:hasConsumableResource hpc:Core ;
    hpc:isShared xsd:false .
hpc:SelectType_cons_tres_CR_Core_Memory hpc:hasConsumableResource hpc:Core ;
    hpc:isShared xsd:false
