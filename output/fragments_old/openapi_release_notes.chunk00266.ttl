# Error response
hpc:ErrorResponse a owl:Class .
hpc:error_number a owl:DatatypeProperty ;
    rdfs:domain hpc:ErrorResponse .

# Response schemas
hpc:DiagResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:PingResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:JobsResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:JobResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:JobSubmissionResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:NodesResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:PartitionsResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:ReservationsResponse a owl:Class ;
    rdfs:subClassOf hpc:ErrorResponse .
hpc:Errors a owl:Class .

# Paths and responses
hpc:Path a owl:Class .
hpc:responses a owl:ObjectProperty ;
    rdfs:domain hpc:Path .
hpc:default a owl:DatatypeProperty ;
    rdfs:domain hpc:Path .

hpc:ping a hpc:Path .
hpc:jobs a hpc:Path .
hpc:job a hpc:Path ;
    rdfs:subPropertyOf hpc:jobs .
hpc:job_submit a hpc:Path .
hpc:nodes a hpc:Path .
hpc:node a hpc:Path ;
    rdfs:subPropertyOf hpc:nodes .
hpc:partitions a hpc:Path .
hpc:partition a hpc:Path ;
    rdfs:subPropertyOf hpc:partitions .
hpc:reservations a hpc:Path .
hpc:reservation a hpc:Path ;
    rdfs:subPropertyOf hpc:reservations .

hpc:paths a owl:Class .
hpc:parameters a owl:ObjectProperty ;
    rdfs:domain hpc:paths .

# Parameter styles
hpc:update_type a xsd:string .
hpc:job_id a xsd:string .
hpc:node_name a xsd:string .
hpc:partition_name a xsd:string .
hpc:reservation_name a xsd:string .
hpc:update_time a xsd:string .

# OperationId
