hpc:Lsf a owl:Class .
hpc:lsfEnableHpcAllocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:effectivencpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Affinityjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:preprovisioning a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Command .

hpc:postprovisioning a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Command .

hpc:Resourceprovisioningpolicy a owl:Class .

hpc:Builtinpolicy a owl:Class ;
    rdfs:subClassOf hpc:Resourceprovisioningpolicy .

hpc:Custompolicy a owl:Class ;
    rdfs:subClassOf hpc:Resourceprovisioningpolicy .

hpc:Resourceconnector a owl:Class .

hpc:Unit a owl:Enum ;
    rdfs:subClassOf xsd:string ;
    owl:hasValue "KB" ;
    owl:hasValue "MB" ;
    owl:hasValue "GB" ;
    owl:hasValue "TB" ;
    owl:hasValue "PB" ;
    owl:hasValue "ZB" ;
    owl:hasValue "Z" .

hpc:resourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .

hpc:resourcelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .

hpc:Resource a owl:Class .
