hpc:Hosta a owl:Class .
hpc:Hostb a owl:Class .

hpc:Reservation a owl:Class .
hpc:reservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:creator a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:host a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Host .
hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:time .
hpc:maxslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Usergroup a owl:Class .
hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Usergroup .
hpc:Group a owl:Class ;
    rdfs:subClassOf hpc:Usergroup .

hpc:Reservation "user1#0" a hpc:Reservation ;
    hpc:Creator "user1" ;
    hpc:Host "hostA" ;
    hpc:StartTime "6:0"^^xsd:time ;
    hpc:EndTime "8:0"^^xsd:time ;
    hpc:MaxSlots 1024 .

hpc:Reservation "user1#0" a hpc:Reservation ;
    hpc:Creator "user1" ;
    hpc:Host "hostA" ;
    hpc:StartTime "6:0"^^xsd:time ;
    hpc:EndTime "8:0"^^xsd:time ;
    hpc:MaxSlots 1024 ;
    hpc:ReservationID "user1#0" .

hpc:Reservation "groupA#0" a hpc:Reservation ;
    hpc:Creator "groupA" ;
    rdfs:subClassOf hpc:Reservation .

hpc:brsvadd a owl:ObjectProperty .
hpc:brsvdel a owl:ObjectProperty .
hpc:brsvmod a owl:ObjectProperty .
hpc:brsvs a owl:ObjectProperty .
hpc:lsbResources a owl:ObjectProperty .
