hpc:Cluster a owl:Class .
hpc:Gpdcluster a owl:Class .
hpc:lsbGpdCluster a owl:DatatypeProperty .
hpc:lsbGpdPort a owl:DatatypeProperty .
hpc:LsfConf a owl:Class .
hpc:Lsbatchd a owl:Class .
hpc:ClusterName a owl:Class .
hpc:LsbGlobalpolicies a owl:Class .
hpc:Globalfairshare a owl:Class .
hpc:name a owl:ObjectProperty .
hpc:participants a owl:ObjectProperty .
hpc:syncMode a owl:ObjectProperty .
hpc:HighIoPolicy a owl:Class .
hpc:HighIoQueue a owl:Class .
hpc:Orga a owl:Class .
hpc:Orgb a owl:Class .
hpc:Crossqueueuserbasedglobalfairshare a owl:Class .
hpc:LsbEnvdir a owl:Class .
hpc:Bconf a owl:Class .
hpc:Fairsharetree a owl:Class .
hpc:Liveconfiguration a owl:Class .
hpc:Lsfmulticlustercapability a owl:Class .
hpc:jobforwardmode a owl:ObjectProperty .
hpc:fsPolicy a owl:DatatypeProperty .

hpc:Cluster rdfs:subClassOf rdf:Resource .
hpc:Gpdcluster rdfs:subClassOf hpc:Cluster .
hpc:LsbGpdCluster rdfs:domain lsf_conf ;
                               rdfs:range xsd:string .
hpc:LsbGpdPort rdfs:domain lsf_conf ;
                               rdfs:range xsd:integer .
hpc:Lsbatchd rdfs:subClassOf rdf:Resource .
hpc:ClusterName rdfs:subClassOf rdf:Resource .
hpc:LsbGlobalpolicies rdfs:subClassOf rdf:Resource .
hpc:Globalfairshare rdfs:subClassOf hpc:LsbGlobalpolicies .
hpc:Name rdfs:domain GlobalFairshare ;
                             rdfs:range xsd:string .
hpc:Participants rdfs:domain GlobalFairshare ;
                             rdfs:range rdf:List .
hpc:SyncMode rdfs:domain GlobalFairshare ;
                             rdfs:range xsd:string .
hpc:HighIoPolicy rdfs:subClassOf hpc:Globalfairshare .
hpc:HighIoQueue rdfs:subClassOf rdf:Resource .
hpc:Orga rdfs:subClassOf rdf:Resource .
hpc:Orgb rdfs:subClassOf rdf:Resource .
hpc:Crossqueueuserbasedglobalfairshare rdfs:subClassOf hpc:Globalfairshare .
hpc:LsbEnvdir rdfs:subClassOf rdf:Resource .
hpc:Bconf rdfs:subClassOf rdf:Resource .
