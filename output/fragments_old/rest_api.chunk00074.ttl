hpc:User a owl:Class .
hpc:association a owl:Class .
hpc:default a owl:Class .
hpc:administratorLevel a owl:Class .
hpc:oldName a owl:DatatypeProperty .
hpc:wckey a owl:DatatypeProperty .
hpc:account a owl:DatatypeProperty .
hpc:cluster a owl:DatatypeProperty .
hpc:partition a owl:DatatypeProperty .
hpc:id a owl:DatatypeProperty .
hpc:name a owl:DatatypeProperty .
hpc:TRES a owl:Class .
hpc:type a owl:DatatypeProperty .
hpc:count a owl:DatatypeProperty .
hpc:idAlt a owl:DatatypeProperty .
hpc:seconds a xsd:nonNegativeInteger .
hpc:allocated a owl:ObjectProperty .
hpc:coordinators a owl:ObjectProperty .
hpc:flags a owl:DatatypeProperty .
hpc:error a owl:Class .
hpc:description a owl:DatatypeProperty .
hpc:source a owl:DatatypeProperty .
hpc:errorNumber a xsd:nonNegativeInteger .

hpc:User rdfs:subClassOf owl:Class .
hpc:association rdfs:subClassOf hpc:User .
hpc:default rdfs:subClassOf hpc:User .
hpc:administratorLevel rdfs:subClassOf hpc:User .
hpc:oldName rdfs:domain hpc:User ;
                               rdfs:range xsd:string .
hpc:wckey rdfs:domain hpc:User ;
                               rdfs:range xsd:string .
hpc:account rdfs:domain hpc:User ;
                               rdfs:range xsd:string .
hpc:cluster rdfs:domain hpc:association ;
                               rdfs:range xsd:string .
hpc:partition rdfs:domain hpc:association ;
                               rdfs:range xsd:string .
hpc:id rdfs:domain hpc:association ;
                               rdfs:range xsd:integer .
hpc:name rdfs:domain hpc:association ;
                               rdfs:range xsd:string .
hpc:TRES rdfs:subClassOf hpc:association .
hpc:type rdfs:domain hpc:TRES ;
                               rdfs:range xsd:string .
hpc:count rdfs:domain hpc:TRES ;
                               rdfs:range xsd:nonNegativeInteger .
