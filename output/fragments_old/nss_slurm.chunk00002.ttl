hpc:Slurmd a owl:Class .
hpc:hasNodeName rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:string .
hpc:hasSlurmdSpoolDir rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:string .
hpc:SlurmctldNode a owl:Class .
hpc:hasPotentialMismatch rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldNode .
hpc:hasDefaultShell rdf:Type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmctldNode ;
    rdfs:range xsd:string .
hpc:InteractiveSallocFailure rdf:Type owl:Class .
hpc:causedByMismatchedDefaultShell rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:InteractiveSallocFailure ;
    rdfs:range hpc:SlurmctldNode .
hpc:ProctrackPgidSlurmd a owl:Class .
hpc:requiresOwnPgid rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:ProctrackPgidSlurmd .
hpc:InteractiveSessionIgnored rdf:Type owl:Class .
hpc:dueToNotBeingInOwnSession rdf:Type owl:ObjectProperty ;
    rdfs:domain hpc:InteractiveSessionIgnored ;
    rdfs:range hpc:Slurmd .
