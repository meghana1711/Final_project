hpc:Job a owl:Class .
hpc:Processlimit a owl:Class .
hpc:cputimelimit a owl:DatatypeProperty .
hpc:Cluster a owl:Class .
hpc:clustername a owl:ObjectProperty .
hpc:curesourcerequirement a owl:DatatypeProperty .
hpc:Computenode a owl:Class .
hpc:memorylimit a owl:DatatypeProperty .
hpc:coreisolation a owl:ObjectProperty .
hpc:expertmode a owl:ObjectProperty .
hpc:resourcerequirementstring a owl:DatatypeProperty .
hpc:currentworkingdirectory a owl:DatatypeProperty .
hpc:processdatasegmentsizelimit a owl:DatatypeProperty .
hpc:Datarequirement a owl:Class .
hpc:sanitycheck a owl:ObjectProperty .
hpc:filehash a owl:ObjectProperty .
hpc:Jobdatarequirement a owl:Class .
hpc:Fileorfolder a owl:Class .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Processlimit rdfs:subClassOf hpc:Job .
hpc:Cputimelimit rdfs:domain hpc:Processlimit ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Clustername rdfs:domain hpc:Cluster ;
                rdfs:range rdf:XMLLiteral .
hpc:Curesourcerequirement rdfs:domain hpc:Cluster ;
                rdfs:range xsd:string .
hpc:Computenode rdfs:subClassOf owl:Class .
hpc:Memorylimit rdfs:domain hpc:Computenode ;
                rdfs:range xsd:nonNegativeInteger .
hpc:Coreisolation rdfs:domain hpc:Computenode ;
                rdfs:range xsd:boolean .
hpc:Expertmode rdfs:domain hpc:Job ;
                rdfs:range xsd:boolean .
hpc:Resourcerequirementstring rdfs:domain hpc:Job ;
                rdfs:range xsd:string .
hpc:Currentworkingdirectory rdfs:domain hpc:Job ;
                rdfs:range xsd:string .
hpc:Processdatasegmentsizelimit rdfs:domain hpc:Processlimit ;
                rdfs:range xsd:nonNegativeInteger .
hpc:Datarequirement rdfs:subClassOf hpc:Job .
hpc:Sanitycheck rdfs:domain hpc:Datarequirement ;
                rdfs:range hpc:Fileorfolder .
hpc:Filehash rdfs:domain hpc:Datarequirement ;
                rdfs:range hpc:Fileorfolder .
hpc:Jobdatarequirement a owl:Class .
hpc:Fileorfolder rdfs:subClassOf owl:Class .
