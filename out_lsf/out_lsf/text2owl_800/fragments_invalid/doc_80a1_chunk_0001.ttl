hpc:Gccinstalled hpc:linuxhost ;
 rdfs:comment "Has gcc installed." ;
 rdfs:domain hpc:Linuxhost .

hpc:Lsfsimulatordirectory hpc:linuxhost ;
 rdfs:comment "Directory of LSF Simulator." ;
 rdfs:domain hpc:Linuxhost .

hpc:Osarch hpc:linuxhost ;
 rdfs:comment "Architecture of the Linux OS." ;
 rdfs:domain hpc:Linuxhost .

hpc:Plugindirectory a owl:Class ;
 rdfs:subClassOf hpc:Lsfsimulatordirectory ;
 rdfs:comment "Directory of LSF Simulator plug-ins." .

hpc:Wconvertplugin a owl:Class ;
 rdfs:subClassOf hpc:Plugindirectory ;
 rdfs:comment "Workload snapshot modification plug-in." .

hpc:Wconvertpluginfile a owl:Class ;
 rdfs:subClassOf rdf:Resource ;
 rdfs:comment "File of the wconvert plug-in." .

hpc:Makefile a owl:Class ;
 rdfs:subClassOf rdf:Resource ;
 rdfs:comment "Makefile for compiling the plug-in library." .

hpc:dynamiclibraryname a owl:DatatypeProperty ;
 rdfs:domain hpc:Makefile ;
 rdfs:range xsd:string ;
 rdfs:comment "Name of the dynamic library." .

hpc:wconvertcommand a owl:ObjectProperty ;
 rdfs:domain hpc:Wconvertpluginfile ;
 rdfs:range hpc:Command ;
 rdfs:comment "Command to use the wconvert plug-in." .

hpc:Lsfsimulatorservice a owl:Class ;
 rdfs:subClassOf rdf:Resource ;
 rdfs:comment "IBM Spectrum LSF Simulator service." .

hpc:Lsfsimulatoruser a owl:Class ;
 rdfs:subClassOf rdf:Resource ;
 rdfs:comment "User for the LSF Simulator." .

hpc:Installationdirectory a owl:Class ;
 rdfs:subClassOf hpc:Lsfsimulatorhost ;
 rdfs:comment "Directory of LSF Simulator installation." .

hpc:stopservice a owl:ObjectProperty ;
 rdfs:domain hpc:Lsfsimulatorservice ;
 rdfs:range hpc:Action ;
 rdfs:comment "Stop the current LSF Simulator service." .

hpc:extractpackage a owl:ObjectProperty ;
 rdfs:domain hpc:Lsfsimulatorservice ;
 rdfs:range hpc:Action ;
 rdfs:comment "Extract the new package of the LSF Simulator service." .
