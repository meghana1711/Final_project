hpc:UpdateNodeMsg a owl:Class .
hpc:OpenapiResp a owl:Class .
hpc:UpdateNodeMsg_JSON a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:UpdateNodeMsg ] .
hpc:OpenapiResp_JSON a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:OpenapiResp ] .
hpc:UpdateNodeMsg_YAML a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:UpdateNodeMsg ] .
hpc:OpenapiResp_YAML a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:OpenapiResp ] .

hpc:hasContent a owl:ObjectProperty .
hpc:hasContent_JSON a owl:ObjectProperty, rdfs:domain hpc:UpdateNodeMsg, rdfs:range xsd:anyURI .
hpc:hasContent_YAML a owl:ObjectProperty, rdfs:domain hpc:UpdateNodeMsg, rdfs:range xsd:anyURI .
hpc:hasSchema a owl:ObjectProperty .
hpc:hasSchema_JSON a owl:ObjectProperty, rdfs:domain hpc:UpdateNodeMsg, rdfs:range xsd:anyURI .
hpc:hasSchema_YAML a owl:ObjectProperty, rdfs:domain hpc:UpdateNodeMsg, rdfs:range xsd:anyURI .

hpc:Response a owl:Class .
hpc:Response_200 a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:Response ] .
hpc:Response_default a owl:Class, rdfs:subClassOf [ a owl:Class; rdfs:subClassOf hpc:Response ] .
hpc:hasContent_JSON_Response a owl:ObjectProperty, rdfs:domain hpc:Response_200, rdfs:range xsd:anyURI .
hpc:hasContent_YAML_Response a owl:ObjectProperty, rdfs:domain hpc:Response_200, rdfs:range xsd:anyURI .
hpc:hasContent_JSON_default a owl:ObjectProperty, rdfs:domain hpc:Response_default, rdfs:range xsd:anyURI .
hpc:hasContent_YAML_default a owl:ObjectProperty, rdfs:domain hpc:Response_default, rdfs:range xsd:anyURI .
