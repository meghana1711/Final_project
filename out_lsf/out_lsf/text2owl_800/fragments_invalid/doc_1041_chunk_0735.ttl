hair:NonDecayedRunTime rdfs:range xsd:decimal .
hair:UndecayedRunTime rdfs:range xsd:decimal .
hair:ReservableResourceLimit rdfs:range xsd:decimal .
hair:MaximumRusageValues rdfs:range xsd:decimal .
hair:MinimumRusageValues rdfs:range xsd:decimal .
hair:EffectiveResourceRequirements rdfs:range hpc:Resourcerequirement .
hair:BSWITCH_MODIFY_RUSAGE rdfs:range xsd:boolean .
hair:ScheduledJob rdfs:subClassOf hpc:Job .
