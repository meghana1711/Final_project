hpc:ssh a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Server .

hpc:gitclone a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Repository .

hpc:editfile a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:File .

hpc:compile a owl:ObjectProperty ;
    rdfs:domain hpc:Sourcecode ;
    rdfs:range hpc:Executable .

hpc:install a owl:ObjectProperty ;
    rdfs:domain hpc:Executable ;
    rdfs:range hpc:Installationdirectory .

hpc:configure a owl:ObjectProperty ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range hpc:Configuration .

hpc:run a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Computingresource .

hpc:Scheduler a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Builtinscheduler a owl:Class ;
    rdfs:subClassOf hpc:Scheduler ;
    rdfs:subClassOf owl:Class .

hpc:Backfillscheduler a owl:Class ;
    rdfs:subClassOf hpc:Scheduler ;
    rdfs:subClassOf owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Computingresource a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:User a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Server a owl:Class ;
    rdfs:subClassOf hpc:Computingresource .

hpc:Repository a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Sourcecode a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Executable a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Installationdirectory a owl:Class ;
    rdfs:subClassOf hpc:Directory .

hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Directory a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Resource rdfs:subClassOf hpc:Namedthing ;
    rdfs:subClassOf owl:Class .

hpc:Namedthing rdfs:subClassOf rdf:Resource ;
    rdfs:subClassOf owl:Class .

hpc:x11LibexecProg a owl:DatatypeProperty ;
    rdfs:domain hpc:Executable ;
    rdfs:range xsd:string .
