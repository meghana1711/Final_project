@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Hostgroup a owl:Class .
hpc:hasname a owl:ObjectProperty .
hpc:hasmembers a owl:ObjectProperty .

hpc:Host a owl:Class .

hpc:Hasname rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:string .

hpc:Hasmembers rdfs:domain hpc:Hostgroup ;
    rdfs:range rdf:List .

hpc:GroupA a hpc:HostGroup ;
    hpc:hasName "all" .
hpc:groupB a hpc:HostGroup ;
    hpc:hasName "_" ;
    hpc:hasMembers (hpc:hostA hpc:hostB) .
hpc:groupC a hpc:HostGroup ;
    hpc:hasName "hostX hostY hostZ" .
hpc:groupD a hpc:HostGroup ;
    hpc:hasName "_hostX" .
hpc:groupE a hpc:HostGroup ;
    hpc:hasName "_groupC _hostB" .
hpc:groupF a hpc:HostGroup ;
    hpc:hasName "hostF groupC hostK" .
hpc:desk_tops a hpc:HostGroup ;
    hpc:hasName "hostD hostE hostF hostG" .
hpc:Big_servers a hpc:HostGroup ;
    hpc:hasName "!" .
