hpc:Serviceclass a owl:Class .
hpc:serviceclassname a owl:ObjectProperty .
hpc:priority a owl:DatatypeProperty .
hpc:consumer a owl:DatatypeProperty .
hpc:egoResReq a owl:DatatypeProperty .
hpc:maxHostIdleTime a owl:DatatypeProperty .
hpc:userGroup a owl:ObjectProperty .
hpc:goal a owl:DatatypeProperty .
hpc:activewindow a owl:DatatypeProperty .
hpc:status a owl:DatatypeProperty .
hpc:slathroughput a owl:DatatypeProperty .
hpc:njobspendingrun SSUSP USUSP Finish a owl:DatatypeProperty .

hpc:Serviceclass rdfs:subClassOf owl:Class .
hpc:Daytimenighttimesla rdfs:subClassOf hpc:Serviceclass .

hpc:Serviceclassname rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string .
hpc:Priority rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:integer .
hpc:Consumer rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:string .
hpc:EgoResReq rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:string .
hpc:MaxHostIdleTime rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:integer .
hpc:UserGroup rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range rdf:List .
hpc:UserGroup rdfs:range rdf:List ;
    rdf:first hpc:User .
hpc:Goal rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:string .
hpc:Activewindow rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:string .
hpc:Slathroughput rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:decimal .
hpc:Njobspendingrun SSUSP USUSP Finish rdfs:domain hpc:Daytimenighttimesla ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Guaranteedresourcepool a owl:Class .
hpc:name a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:hosts a owl:ObjectProperty .
hpc:distribution a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .

hpc:Guaranteedresourcepool rdfs:subClassOf owl:Class .
hpc:resourcepool a owl:ObjectProperty .
hpc:Host a owl:Class .
hpc:sla a owl:ObjectProperty .

hpc:
