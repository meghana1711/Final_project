hpc:Hostname a owl:Class .
hpc:gpuid a owl:ObjectProperty .
hpc:taskid a owl:DatatypeProperty .
hpc:Task a owl:Class .
hpc:Model a owl:Class .
hpc:Model rdfs:subClassOf owl:Class .
hpc:mtotal a owl:DatatypeProperty .
hpc:Mtotal rdfs:domain hpc:Model .
hpc:Mtotal rdfs:range xsd:decimal .
hpc:gpucomputecapability a owl:DatatypeProperty .
hpc:Gpucomputecapability rdfs:domain hpc:Model .
hpc:mrsv a owl:DatatypeProperty .
hpc:Mrsv rdfs:domain hpc:Model .
hpc:Mrsv rdfs:range xsd:decimal .
hpc:socket a owl:DatatypeProperty .
hpc:Socket rdfs:domain hpc:Gpuid .
hpc:Socket rdfs:range xsd:nonNegativeInteger .
hpc:nvlink a owl:ObjectProperty .
hpc:Nvlink rdfs:domain hpc:Gpuid .
hpc:Nvlink rdfs:range xsd:string .
hpc:joberrorwarningmessage a owl:DatatypeProperty .
hpc:Joberrorwarningmessage rdfs:domain hpc:Gpuid .
hpc:Joberrorwarningmessage rdfs:range xsd:string .
hpc:Longformat a owl:Class .
