hpc:Interruptiblebackfillqueue a owl:Class .
hpc:REQUEUE_EXIT_VALUES rdf:type owl:ObjectProperty .
hpc:RERUNNABLE rdf:type owl:ObjectProperty .
hpc:RES_REQ rdf:type owl:ObjectProperty .

hpc:Interruptiblebackfillqueue rdfs:subClassOf hpc:Queue .

hpc:RequeueExitValues rdfs:domain hpc:Interruptiblebackfillqueue ;
    rdfs:range xsd:integer .

hpc:Rerunnable rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:boolean .

hpc:ResReq rdfs:domain hpc:Interruptiblebackfillqueue ;
    rdfs:range xsd:string .

hpc:REQUEUE_EXIT_VALUES_Value30 a owl:NamedIndividual ;
    hpc:RequeueExitValues hpc:requeueExitValues .

hpc:REQUEUE_EXIT_VALUES_Value20 a owl:NamedIndividual ;
    hpc:RequeueExitValues hpc:requeueExitValues ;
    hpc:Exclude hpc:exclude .

hpc:RERUNNABLE_Yes a owl:NamedIndividual ;
    hpc:Rerunnable hpc:rerunnable .

hpc:RERUNNABLE_No a owl:NamedIndividual ;
    hpc:Rerunnable hpc:rerunnable .
