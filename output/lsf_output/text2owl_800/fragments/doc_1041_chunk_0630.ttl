hpc:Sharedgpujob a owl:Class .
hpc:Exclusivegpujob a owl:Class .
hpc:Exclusiveprocessgpujob a owl:Class .
hpc:Numaawaregpujob a owl:Class .
hpc:Miggpujob a owl:Class .

# GPU Job Properties
hpc:num a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:integer .

hpc:mode a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range hpc:Gpujobtype .

hpc:jExclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range xsd:boolean .

# GPU Job Types Definitions
hpc:Gpujobtype a owl:Class .
hpc:DefaultMode a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Gpujobtype .
hpc:Shared a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Gpujobtype .
hpc:Exclusive a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Gpujobtype .
hpc:ExclusiveProcess a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Exclusive .
hpc:NumaAware a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Gpujobtype .
hpc:MIG a hpc:GPUJobType ;
    rdfs:subClassOf hpc:Gpujobtype .

# GPU Job Subclasses
hpc:Taskbasedgpujob a owl:Class ;
    rdfs:subClassOf hpc:Numaawaregpujob .

hpc:Miggpuinstance a owl:Class .
hpc:Computeinstance a owl:Class .
hpc:Gpuinstance a owl:Class .
