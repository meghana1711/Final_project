hpc:Cluster a owl:Class .
hpc:hasclustername a owl:ObjectProperty .
hpc:Hasclustername rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:Servicedomain a owl:Class .
hpc:hasservicedomainname a owl:ObjectProperty .
hpc:Hasservicedomainname rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string .
hpc:haslicenseservers a owl:ObjectProperty .
hpc:Haslicenseservers rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string .
hpc:haslicensecollector a owl:ObjectProperty .
hpc:Haslicensecollector rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string .
hpc:lmStatInterval a owl:DatatypeProperty .
hpc:lmStatPerFeature a owl:DatatypeProperty .
hpc:lmStatTimeout a owl:DatatypeProperty .
hpc:lmType a owl:DatatypeProperty .

hpc:Clusterssection a owl:Class .
hpc:hasbeginclusters a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasendclusters a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasclusters a owl:ObjectProperty ;
    rdfs:domain hpc:Clusterssection ;
    rdfs:range hpc:Cluster .

hpc:Servicedomainsection a owl:Class .
hpc:hasbeginservicedomain a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasendservicedomain a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:hasservicedomains a owl:ObjectProperty ;
    rdfs:domain hpc:Servicedomainsection ;
    rdfs:range hpc:Servicedomain .
