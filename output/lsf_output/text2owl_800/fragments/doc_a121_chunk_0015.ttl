hpc:Joboutputformat a owl:Class .
hpc:Field a owl:Class .

# Object Properties
hpc:hasfield a owl:ObjectProperty .
hpc:hasformat a owl:ObjectProperty .

# Datatype Properties
hpc:name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string .
hpc:outputWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .
hpc:unitPrefix rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:string .
hpc:delimiter rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutputformat ;
    rdfs:range xsd:string .

# Object Property Restrictions
hpc:Joboutputformat rdfs:subClassOf owl:Class ;
    owl:onProperty hpc:hasField .
hpc:Field rdfs:subClassOf owl:Class ;
    owl:onProperty hpc:hasFormat .

# Data Values
hpc:JOB_NAME a hpc:Field ;
    hpc:name "jobName" ;
    hpc:hasFormat "*" .

hpc:field_name a hpc:Field ;
    hpc:name "fieldName" .

hpc:output_width a hpc:Field ;
    hpc:name "outputWidth" .

hpc:unit_prefix a hpc:Field ;
    hpc:name "unitPrefix" .

hpc:delimiter a hpc:JobOutputFormat ;
    hpc:delimiter "'" .

hpc:all a hpc:JobOutputFormat ;
    hpc:delimiter "" .

hpc:colon a hpc:Field ;
    hpc:name ":" .
