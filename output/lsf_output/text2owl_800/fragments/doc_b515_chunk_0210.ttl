hpc:Checkpointdirectory a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Directory where checkpoints are stored." .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Time in minutes between checkpoints." .

hpc:Checkpointablejob a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Job that can be checkpointed." .

hpc:hascheckpointdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range hpc:Checkpointdirectory ;
    rdfs:comment "The directory where checkpoints for this job are stored." .

hpc:hascheckpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The period in minutes for checkpointing this job." .
