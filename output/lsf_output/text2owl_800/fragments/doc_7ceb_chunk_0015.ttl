hpc:Lsfhost a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:startlsfdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range hpc:Lsfdaemon .
hpc:stoplsfdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range hpc:Lsfdaemon .
hpc:reconfigurelsf a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range hpc:Lsf .
hpc:setuplsfenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Lsf .
hpc:cshrclsf a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:profilelsf a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range xsd:string .
hpc:Lsf a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Lsfcluster a owl:Class ;
