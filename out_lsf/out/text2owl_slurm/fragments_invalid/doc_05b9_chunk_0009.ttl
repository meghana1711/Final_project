hpc:GetAssociationInfo
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the Get association info operation." .

hpc:GetAssociationInfo
    hpc:account
        rdfs:domain hpc:Getassociationinfo ;
        rdfs:range xsd:string ;
        rdfs:comment "CSV accounts list." .

hpc:GetAssociationInfo
    hpc:cluster
        rdfs:domain hpc:Getassociationinfo ;
        rdfs:range xsd:string ;
        rdfs:comment "CSV clusters list." .

hpc:GetAssociationInfo
    hpc:default_qos
        rdfs:domain hpc:Getassociationinfo ;
        rdfs:range xsd:string ;
        rdfs:comment "CSV QOS list." .

hpc:GetAssociationInfo
    hpc:includeDeletedAssociations
        rdfs:domain hpc:Getassociationinfo ;
        rdfs:range xsd:boolean ;
        rdfs:comment "Include deleted associations." .

hpc
