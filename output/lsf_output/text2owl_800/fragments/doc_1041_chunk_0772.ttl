hpc:Tasklog a owl:Class .
hpc:Host a owl:Class .
hpc:Cluster a owl:Class .
hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklog ;
    rdfs:range xsd:decimal .
hpc:logfile a owl:ObjectProperty ;
    rdfs:domain hpc:Tasklog ;
    rdfs:range xsd:string .
hpc:logdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .
hpc:reslogoff a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:Reslogoffargument a owl:Class ;
    rdfs:subClassOf hpc:Stringliteral .
hpc:resLogoffAll a hpc:ResLogoffArgument .
hpc:resLogoffLocal a hpc:ResLogoffArgument .
hpc:resLogoffHost a hpc:ResLogoffArgument ;
    rdfs:subPropertyOf hpc:resLogoff .
hpc:resLogoffHosts a rdf:List ;
    rdfs:first hpc:resLogoffHost ;
    rdfs:rest hpc:resLogoffHost .
hpc:reslogon a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:Boolean .
hpc:resLogOnOff a hpc:ResLogOnArgument .
hpc:resLogOnLocal a hpc:ResLogOnArgument .
hpc:resLogOnHost a hpc:ResLogOnArgument ;
    rdfs:subPropertyOf hpc:resLogOn .
hpc:resLogOnHosts a rdf:List ;
    rdfs:first hpc:resLogOnHost ;
    rdfs:rest hpc:resLogOnHost .
hpc:reslogsetlevel a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:Reslogsetlevelargument a owl:Class ;
    rdfs:subClassOf hpc:Stringliteral .
hpc:resLogSetLevelDebugLevel a hpc:ResLogSetLevelArgument .
hpc:resLogSetLevelClass a hpc:ResLogSetLevelArgument .
hpc:resLogSetLevelLogfile a hpc:ResLogSetLevelArgument .
hpc:resLogSetLevelOption a hpc:ResLogSetLevelArgument .
hpc:Lsfconfiguration a owl:Class .
