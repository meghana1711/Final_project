hpc:Gpuresource a owl:Class .
hpc:mps a owl:ObjectProperty .
hpc:MpsEnabled rdfs:domain hpc:Gpuresource ;
                 rdfs:range xsd:boolean .
hpc:MpsExclusiveProcess rdfs:domain hpc:Mps ;
                          rdfs:range xsd:string .
hpc:mpsDaemonSharing a owl:ObjectProperty .
hpc:MpsDaemonSharingEnabled rdfs:domain hpc:Mps ;
                                 rdfs:range xsd:boolean .
hpc:MpsDaemonShared rdfs:domain hpc:Mps ;
                        rdfs:range xsd:string .
hpc:MpsPerHost rdfs:subClassOf hpc:Gpuresource ;
                  rdfs:comment "LSF starts one MPS daemon per host per job." .
hpc:MpsPerHostShared rdfs:subClassOf hpc:Gpuresource ;
                        rdfs:comment "LSF starts one MPS daemon per host for all jobs that are submitted by the same user with the same resource requirements." .
hpc:MpsNoCudaVisibleDevices rdfs:subClassOf hpc:Gpuresource ;
                                 rdfs:comment "LSF does not set the CUDA_VISIBLE_DEVICES environment variables for tasks." .
