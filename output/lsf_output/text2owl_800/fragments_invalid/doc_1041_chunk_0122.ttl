hpc:Disc a owl:Class ;
    rdfs:comment "No communication between the two clusters." .

hpc:Conn a owl:Class ;
    rdfs:comment "The two clusters communicate, but the lease is not established." .

hpc:remoteclusterapplicationinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Conn ;
    rdfs:range hpc:Remoteclusterapplicationinformationdata .

hpc:Remoteclusterapplicationinformationdata a owl:Class ;
    rdfs:comment "Output: Remote cluster application information" .

hpc:remoteCluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Remoteclusterapplicationinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the remote cluster." .

hpc:appName a owl:DatatypeProperty ;
    rdfs:domain hpc:Remoteclusterapplicationinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the application profile available in the remote cluster." .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:AppName ;
    rdfs:range xsd:string ;
    rdfs:comment "The description of the application profile." .

hpc:files a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "Reads the lsb.queues and lsb.applications files." .

hpc:bconf a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Submits live reconfiguration requests, updating configuration settings in active memory without restarting daemons." .

hpc:bapp rdfs:seeAlso xsd:string ;
hpc:bhosts rdfs:seeAlso xsd:string ;
hpc:bqueues rdfs:seeAlso xsd:string ;
hpc:lsclusters rdfs:seeAlso xsd:string ;
hpc:lsinfo rdfs:seeAlso xsd:string ;
hpc:lsb.applications rdfs:seeAlso xsd:string ;
hpc:lsb.queues rdfs:seeAlso xsd:string .
