hpc:Srun a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:Slurmd a owl:Class .
hpc:Slurmstepd a owl:Class .

hpc:sendstepcreaterequest a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range hpc:Slurmctld .

hpc:respondwithstepcredential a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range hpc:Srun .

hpc:opensocketsforio a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range hpc:Srun .

hpc:forwardcredential a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range hpc:Slurmd .

hpc:forkexecslurmstepd a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range hpc:Slurmstepd .

hpc:connectio a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmstepd ;
    rdfs:range hpc:Slurmstepd .

hpc:launchtasks a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmstepd ;
    rdfs:range hpc:Slurmstepd .

hpc:notifyontermination a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmstepd ;
    rdfs:range hpc:Srun .

hpc:notifyjobtermination a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range hpc:Slurmctld .

hpc:verifytermination a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range hpc:Slurmctld .

hpc:releaseresources a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range hpc:Slurmctld .

hpc:communication a owl:ObjectProperty .

hpc:Multiplecontrollers a owl:Class .
hpc:fallbackslurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:Multiplecontrollers ;
    rdfs:range hpc:Slurmctld .
hpc:fallbackslurmdbd a owl:ObjectProperty ;
    rdfs:domain hpc:Multiplecontrollers ;
    rdfs:range hpc:Slurmdbd .

hpc:Multipleclusters a owl:Class .
hpc:multiclusterconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Multipleclusters ;
    rdfs:range xsd:string .

hpc:Federation a owl:Class .
hpc:peertopeercommunication a owl:ObjectProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range hpc:Federation .
