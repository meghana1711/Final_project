hpc:Applicationprofile a owl:Class .
hpc:Job a owl:Class .
hpc:User a owl:Class .

hpc:hasApplicationProfile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Applicationprofile .

hpc:suspend rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Applicationprofile .

hpc:resume rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Applicationprofile .

hpc:kill rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .

hpc:mostRecentlySubmitted rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Job .

hpc:allJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Job .

hpc:currentUser rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:ApplicationProfileExclusion rdf:type owl:Class .
hpc:excludes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Applicationprofileexclusion .

hpc:Queue rdf:type owl:Class .
hpc:appliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Queue .
