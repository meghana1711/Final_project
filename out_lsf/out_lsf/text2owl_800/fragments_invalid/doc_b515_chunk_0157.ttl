@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:Advancereservation a owl:Class.
hpc:Nonadvancereservationjob a owl:Class.
hpc:Host a owl:Class.
hpc:Slot a owl:Class.

hpc:preemptedbyadvancereservation a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Advancereservation.

hpc:resumesafter a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range (hpc:Advancereservation hpc:Nonadvancereservationjob
