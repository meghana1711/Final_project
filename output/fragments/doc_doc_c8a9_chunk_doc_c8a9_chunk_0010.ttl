hpc:PreemptMode rdfs:domain hpc:Partition .
hpc:PreemptedBy hpc:Job a owl:ObjectProperty .
hpc:PreemptedBy rdfs:domain hpc:Job .
hpc:PreemptedBy rdfs:range hpc:Job .
hpc:RunningOn hpc:Node a owl:ObjectProperty .
hpc:RunningOn rdfs:domain hpc:Job .
hpc:RunningOn rdfs:range rdf:List .
hpc:ListItem a rdf:Property .
