hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:normalizedcputime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cputime .

hpc:cpufactor a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hostmodelname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:defaulthostspec a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Host .

hpc:sndjobsto a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Cluster .

hpc:submithost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Chunkjobqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf owl:Thing .

hpc:Candidatequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:subClassOf owl:Thing .

hpc:clusters a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cluster .
