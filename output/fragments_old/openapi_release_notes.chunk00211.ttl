hpc:hasContent rdfs:domain hpc:OpenapiAccountsResp ;
                 rdfs:range xsd:string .
hpc:hasContent rdfs:domain hpc:OpenapiResp ;
                 rdfs:range xsd:string .

hpc:hasSchema a owl:ObjectProperty .
hpc:hasSchema rdfs:domain hpc:AccountResponse ;
              rdfs:range hpc:Schema .
hpc:hasSchema rdfs:domain hpc:AccountsResponse ;
              rdfs:range hpc:Schema .
hpc:hasSchema rdfs:domain hpc:OpenapiAccountsResp ;
              rdfs:range hpc:Schema .
hpc:hasSchema rdfs:domain hpc:OpenapiResp ;
              rdfs:range hpc:Schema .

hpc:Schema a owl:Class .

