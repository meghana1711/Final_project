hpc:Jobdescription a owl:Class .
hpc:hasselinuxcontext a owl:ObjectProperty .
hpc:reqcontext a owl:DatatypeProperty .
hpc:admincomment a owl:DatatypeProperty .

hpc:Jobdescription rdfs:subClassOf owl:Class .
hpc:Hasselinuxcontext rdfs:domain hpc:Jobdescription ;
                          rdfs:range hpc:Selinuxcontext .
hpc:Reqcontext rdfs:domain hpc:Jobdescription ;
                   rdfs:range xsd:string .
hpc:Admincomment rdfs:domain hpc:Jobdescription ;
                   rdfs:range xsd:string .

hpc:Selinuxcontext a owl:Class .
hpc:Selinuxcontext rdfs:subClassOf xsd:string .
