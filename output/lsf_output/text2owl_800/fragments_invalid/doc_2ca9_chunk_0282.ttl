hpc:Transferjob a owl:Class .
hpc:sanityCheck an owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range xsd:boolean .

hpc:Lsfversion a owl:Class .
hpc:FixPack an owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfversion .

hpc:Parameter a owl:Class .
hpc:name an owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:value an owl:DatatypeProperty ;
    rdfs:range xsd:string .

hpc:Deprecatedparameter a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:Cluster a owl:Class .
hpc:globalLicenses an owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:Lsfsudoers a owl:Class .

hpc:Eauthkey a owl:Class .
hpc:expiryDate an owl:DatatypeProperty ;
    rdfs:domain hpc:Eauthkey .

hpc:Lsfusermapping a owl:Class .
hpc:bsubmitCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Lsfusermapping .

hpc:Deprecatedfile a owl:Class .
