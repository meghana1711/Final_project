hpc:Unit a owl:Class .
hpc:Builtinconversion a owl:Class .
hpc:SpaceConversion a hpc:BuiltInConversion ;
    rdfs:subClassOf hpc:Builtinconversion .
hpc:TimeConversion a hpc:BuiltInConversion ;
    rdfs:subClassOf hpc:Builtinconversion .
hpc:Customconversion a owl:Class ;
    rdfs:subClassOf hpc:Builtinconversion .

hpc:hasunit a owl:ObjectProperty ;
    rdfs:domain hpc:Unit ;
    rdfs:range xsd:string .

hpc:Field a owl:Class .
hpc:hasconversion a owl:ObjectProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range hpc:Unit .
hpc:haswidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Field ;
    rdfs:range xsd:nonNegativeInteger .

hpc:SpaceConversionUnit a hpc:Unit ;
    hpc:hasUnit "S" .
hpc:spaceconversionscale a owl:ObjectProperty ;
    rdfs:domain hpc:Spaceconversionunit ;
    rdfs:range xsd:string .
hpc:spaceconversionscalevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Spaceconversionscale ;
    rdfs:range xsd:nonNegativeInteger .

hpc:TimeConversionUnit a hpc:Unit ;
    hdfs:hasUnit "s" .
hpc:timeconversionscale a owl:ObjectProperty ;
    rdfs:domain hpc:Timeconversionunit ;
    rdfs:range xsd:string .
hpc:timeconversionscalevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeconversionscale ;
    rdfs:range xdfs:nonNegativeInteger .

hpc:CustomConversionUnit a hpc:Unit ;
    hpc:hasUnit ?custom .

hpc:delimiter a owl:ObjectProperty ;
    rdfs:domain hpc:Field .
hpc:delimitervalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Delimiter ;
    rdfs:range xsd:string .
