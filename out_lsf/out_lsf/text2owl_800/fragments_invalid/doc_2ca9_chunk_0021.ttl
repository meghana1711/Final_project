hpc:Resource a owl:Class .

# SharedResource (implicitly subclass of Resource)
hpc:Sharedresource a owl:Class ;
  rdfs:subClassOf hpc:Resource .

# AssignableResource (implicitly subclass of Resource)
hpc:Assignableresource a owl:Class ;
  rdfs:subClassOf hpc:Resource .

# ResourceRequirement
hpc:Resourcerequirement a owl:Class .

# ResourceMap
hpc:resourcemap a owl:ObjectProperty ;
  rdfs:domain hpc:Cluster ;
  rdfs:range hpc:Resourcemapentry .

# ResourceMapEntry
hpc:Resourcemapentry a owl:Class ;
  rdfs:subClassOf rdf:List .

# ResourceMapEntry/resource
hpc:resourcemapentry/resource a owl:DatatypeProperty ;
  rdfs:domain hpc:Resourcemapentry ;
  rdfs:range hpc:Resource .

# ResourceMapEntry/value
hpc:resourcemapentry/value a owl:DatatypeProperty ;
  rdfs:domain hpc:Resourcemapentry ;
  rdfs:range xsd:string .

# Job
hpc:Job a owl:Class .

# JobResourceRequirement
hpc:jobresourcerequirement a owl:ObjectProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range hpc:Resourcerequirement .

# JobAssociatedResource
hpc:jobassociatedresource a owl:ObjectProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range hpc:Resource .

# EnhancedOutput
hpc:Enhancedoutput a owl:Class .

# EnhancedOutput/jobListCommand
hpc:enhancedoutput/jobListCommand a owl:ObjectProperty ;
  rdfs:domain hpc:Enhancedoutput ;
  rdfs:range rdf:List ;
  rdfs:range hpc:Command .

# Command
hpc:Command a owl:Class .

# Command/command
hpc:command/command a owl:DatatypeProperty ;
  rdfs:domain hpc:Command ;
  rdfs:range xsd:string .

# Command/output
hpc:command/output a owl:DatatypeProperty ;
  rdfs:domain hpc:Command ;
  rdfs:range xsd:string .
