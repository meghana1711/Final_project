hpc:GPU a owl:Class .
hpc:GTX1080 a hpc:GPU ;
    hpc:file [ rdf:datatype xsd:string ] "/dev/nvidia0" ;
    hpc:cores [ rdf:datatype xsd:string ] "0,1" .
hpc:GTX1070 a hpc:GPU ;
    hpc:file [ rdf:datatype xsd:string ] "/dev/nvidia1" ;
    hpc:cores [ rdf:datatype xsd:string ] "0,1" .
hpc:GTX1060 a hpc:GPU ;
    hpc:file [ rdf:datatype xsd:string ] "/dev/nvidia2" ;
    hpc:cores [ rdf:datatype xsd:string ] "2,3" .
hpc:GTX1050 a hpc:GPU ;
    hpc:file [ rdf:datatype xsd:string ] "/dev/nvidia3" ;
    hpc:cores [ rdf:datatype xsd:string ] "2,3" .

# MPS Class
hpc:MPS a owl:Class .
hpc:hasCount a owl:DatatypeProperty ;
    rdfs:domain hpc:MPS ;
    rdfs:range xsd:integer .
hpc:hasFile a owl:DatatypeProperty ;
    rdfs:domain hpc:MPS ;
    rdfs:range xsd:string .

# Relationship between GPU and MPS (assuming one MPS can be associated with one GPU)
hpc:hasMPS a owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range hpc:MPS .
```

# Fragment: gres.chunk00005.ttl
hpc:GPU a owl:Class .
hpc:Shard a owl:Class .
hpc:GRES a owl:Class .
hpc:Node a owl:Class .

hpc:hasGPU a owl:ObjectProperty .
hpc:hasShard a owl:ObjectProperty .
hpc:hasCount a owl:DatatypeProperty .
hpc:hasFile a owl:DatatypeProperty .
hpc:hasName a owl:DatatypeProperty .

hpc:GPU rdfs:subClassOf hpc:GRES .
hpc:Shard rdfs:subClassOf hpc:GRES .
hpc:Node rdfs:subClassOf hpc:GRES .

hpc:hasGPU rdfs:domain hpc:GRES ;
    rdfs:range hpc:GPU .
hpc:hasShard rdfs:domain hpc:GRES ;
    rdfs:range hpc:Shard .
hpc:hasNode rdfs:domain hpc:Node ;
    rdfs:range hpc:GRES .

hpc:hasCount rdfs:domain hpc:GRES ;
    rdfs:range xsd:integer .
hpc:hasFile rdfs:domain hpc:GRES ;
    rdfs:range xsd:string .
hpc:hasName rdfs:domain hpc:GRES ;
    rdfs:range xsd:string .
```

This ontology fragment defines classes for GPU, Shard, and Node, which are all subclasses of GRES. It also defines properties for having GPUs, Shards, and Nodes, as well as properties for having a name, count, and file. The domain and range for each property are also defined.

