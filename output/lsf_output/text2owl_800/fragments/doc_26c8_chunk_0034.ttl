hpc:Attribute a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdfs:Resource ] .

hpc:attributename a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:string .

hpc:attributetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:range .

hpc:Lsfresource a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdfs:Resource ] .

hpc:propname a owl:ObjectProperty .
