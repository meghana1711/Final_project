hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Queue a owl:Class .
hpc:Resource a owl:Class .
hpc:Reservedresource a owl:Class .
hpc:currentvalue a owl:DatatypeProperty .
hpc:reservedamount a owl:DatatypeProperty .
hpc:availableamount a owl:DatatypeProperty .
hpc:Loadindex a owl:Class .
hpc:submitjob a owl:ObjectProperty .
hpc:viewresourceinfo a owl:ObjectProperty .
hpc:hostlevelresourceinfo a owl:ObjectProperty .
hpc:queuelevelresourceinfo a owl:ObjectProperty .
hpc:resourcerequirement a owl:DatatypeProperty .
hpc:rusage a owl:ObjectProperty .
hpc:timeofday a owl:DatatypeProperty .
hpc:computeunit a owl:DatatypeProperty .
hpc:resourcereservation a owl:ObjectProperty .

hpc:Job rdfs:subClassOf hpc:Resource .
hpc:Host rdfs:subClassOf hpc:Resource .
hpc:Queue rdfs:subClassOf hpc:Resource .

hpc:Submitjob rdfs:domain hpc:Job ;
                 rdfs:range rdf:Resource .
hpc:Viewresourceinfo rdfs:domain hpc:Resource ;
                     rdfs:range rdf:Resource .
hpc:Hostlevelresourceinfo rdfs:domain hpc:Host ;
                      rdfs:range rdf:Resource .
hpc:Queuelevelresourceinfo rdfs:domain hpc:Queue ;
                          rdfs:range rdf:Resource .
hpc:Resourcereservation rdfs:domain hpc:Job ;
                         rdfs:range hpc:Reservedresource .
hpc:Currentvalue rdfs:domain hpc:Resource ;
                   rdfs:range xsd:decimal .
hpc:Reservedamount rdfs:domain hpc:Reservedresource ;
                    rdfs:range xsd:decimal .
hpc:Availableamount rdfs:domain hpc:Resource ;
                     rdfs:range xsd:decimal .
hpc:Loadindex rdfs:subClassOf hpc:Resource .
hpc:Timeofday rdfs:domain hpc:Job ;
                   rdfs:range xsd:time .
hpc:Computeunit rdfs:domain hpc:Job ;
                   rdfs:range xsd:decimal .
