hpc:Job a owl:Class .
hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:categories a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Notify a owl:Class ;
    rdfs:subClassOf hpc:Categories .
hpc:Schedule a owl:Class ;
    rdfs:subClassOf hpc:Categories .
hpc:Limit a owl:Class .

hpc:bsub a owl:ObjectProperty .
hpc:bsub -ar rdf:type hpc:bsub ;
    rdfs:range hpc:Job ;
    rdfs:comment "Sends mail to you when the job is dispatched and begins execution." .
hpc:bsub -B rdf:type hpc:bsub ;
    rdfs:range hpc:Job ;
    rdfs:comment "Dispatches the job for execution on or after the specified date and time." .
hpc:bsub -b rdf:type hpc:bsub ;
    rdfs:range hpc:Job ;
    rdfs:comment "Submit the job to run at the specified time." .
hpc:bsub -C rdf:type hpc:bsub ;
    rdfs:range hpc:Job ;
    rdfs:comment "Sets a per-process (soft) core file size limit for all the processes that belong to this job." .
