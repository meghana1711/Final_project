hpc:Licensetoken       a owl:Class .
hpc:Licensefeature     a owl:Class .
hpc:Featuregroup       a owl:Class .
hpc:Lsfservicedomain   a owl:Class .

hpc:haslicensetoken    a owl:ObjectProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range hpc:Licensetoken .

hpc:belongstogroup     a owl:ObjectProperty ;
                        rdfs:domain hpc:Featuregroup ;
                        rdfs:range hpc:Licensefeature .

hpc:isservicedomainof a owl:ObjectProperty ;
                        rdfs:domain hpc:Lsfservicedomain ;
                        rdfs:range hpc:Licenseserver .

hpc:configuredin      a owl:ObjectProperty ;
                        rdfs:domain hpc:Featuregroup ;
                        rdfs:range hpc:Lsflicensescheduler .

hpc:definedin         a owl:ObjectProperty ;
                        rdfs:domain hpc:Featuregroup ;
                        rdfs:range xsd:string .

hpc:ignored          a owl:ObjectProperty ;
                        rdfs:domain hpc:Featuregroup ;
                        rdfs:range xsd:boolean .

hpc:sortedby          a owl:ObjectProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range xsd:string .

hpc:clusterlocality   a owl:DatatypeProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range xsd:string .

hpc:hierarchicalinfo  a owl:DatatypeProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range xsd:string .

hpc:licenseproject    a owl:DatatypeProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range xsd:string .

hpc:licensetokennames a owl:DatatypeProperty ;
                        rdfs:domain hpc:Licensefeature ;
                        rdfs:range xsd:string .

hpc:Lsfservicedomains a owl:Class ;
                        rdfs:subClassOf hpc:Lsfservicedomain .

hpc:Featuregroup      a owl:Class ;
                        rdfs:subClassOf hpc:Feature .

hpc:Featurelist       a owl:Class ;
                        rdfs:subClassOf hpc:Feature .

hpc:Feature          a owl:Class .
