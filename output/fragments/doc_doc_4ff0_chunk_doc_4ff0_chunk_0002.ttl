hpc:MakefileAM a owl:Class .
hpc:MakefileIn a owl:Class .
hpc:GitRepository a owl:Class .
hpc:HasMakefileAM a owl:ObjectProperty .
hpc:HasMakefileIn a owl:ObjectProperty .
hpc:HasGitRepository a owl:ObjectProperty .
hpc:IsInGitRepository rdfs:domain hpc:File .
hpc:IsInMakefileAM rdfs:domain hpc:Directory .
hpc:IsInMakefileIn rdfs:domain hpc:Directory .
hpc:IsBuiltAtSlurmConfigureTime rdfs:domain hpc:MakefileAM .
hpc:IsPartOfTopLevelDirectory rdfs:domain hpc:MakefileAM .
hpc:RequiresAutoreconf rdfs:domain hpc:MakefileAM .
hpc:HasOlderVersions rdfs:domain hpc:MakefileAM .
hpc:RequiresModification rdfs:domain hpc:MakefileAM .
hpc:IsPartOfSlurmSpec rdfs:domain hpc:PluginFile .
hpc:PluginFile a owl:Class .
hpc:HasPluginFile rdfs:domain hpc:SlurmSpec .

hpc:Directory rdfs:subClassOf xsd:string .
hpc:File rdfs:subClassOf xsd:string .
hpc:PluginFile rdfs:subClassOf hpc:File .
hpc:MakefileAM rdfs:subClassOf hpc:File .
hpc:MakefileIn rdfs:subClassOf hpc:File .
hpc:SlurmSpec a owl:Class .

hpc:HasMakefileAM rdfs:range hpc:MakefileAM .
hpc:HasMakefileIn rdfs:range hpc:MakefileIn .
hpc:IsInGitRepository rdfs:range hpc:GitRepository .
hpc:IsPartOfTopLevelDirectory rdfs:range xsd:string .
hpc:IsBuiltAtSlurmConfigureTime rdfs:range hpc:MakefileAM .
hpc:RequiresAutoreconf rdfs:range hpc:MakefileAM .
hpc:HasOlderVersions rdfs:range xsd:boolean .
hpc:RequiresModification rdfs:range hpc:MakefileAM .
hpc:IsPartOfSlurmSpec rdfs:range hpc:PluginFile .
