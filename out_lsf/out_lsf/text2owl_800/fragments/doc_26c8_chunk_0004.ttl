hpc:RcAccount a owl:Class .
hpc:RcDemandPolicy a owl:Class .

hpc:hasaccount a owl:ObjectProperty ;
    rdfs:domain hpc:RcAccount ;
    rdfs:range xsd:string .

hpc:hasthresholdcondition a owl:ObjectProperty ;
    rdfs:domain hpc:RcDemandPolicy .

hpc:defaultAccount a xsd:string .
hpc:RC_ACCOUNT "default" hpc:defaultAccount .

hpc:borrowhosttype a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfresourceconnector .

hpc:Lsfresourceconnector a owl:Class .
