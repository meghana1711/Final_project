hpc:File a owl:Class .
hpc:LocalFile a hpc:File, owl:DatatypeProperty .
hpc:RemoteFile a hpc:File, owl:DatatypeProperty .

hpc:copyoperation a owl:ObjectProperty .
hpc:overwrite a owl:ObjectProperty .
hpc:append a owl:ObjectProperty .
hpc:create a owl:ObjectProperty .

hpc:Localfile rdfs:domain hpc:Job .
hpc:Remotefile rdfs:domain hpc:Job .
hpc:Copyoperation rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:operation .
hpc:Overwrite rdfs:domain hpc:Copyoperation ;
    rdfs:range xsd:boolean .
hpc:Append rdfs:domain hpc:Copyoperation ;
    rdfs:range xsd:boolean .
hpc:Create rdfs:domain hpc:Copyoperation ;
    rdfs:range xsd:boolean .

hpc:sameas a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:copyOperation ;
    rdfs:range hpc:Copyoperation ;
    rdfs:domain hpc:Copyoperation .

hpc:Differentdirectorystructures a owl:Class .
hpc:Ensuredirectoryexists rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
