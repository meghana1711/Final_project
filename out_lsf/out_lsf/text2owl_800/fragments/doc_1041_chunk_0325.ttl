hpc:Psusp a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:string .
hpc:owner a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:string .
hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:string .
hpc:numberofheldjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:integer .
hpc:pend a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:integer .
hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:integer .
hpc:done a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:integer .
hpc:exit a owl:DatatypeProperty ;
    rdfs:domain hpc:Psusp ;
    rdfs:range xsd:integer .
