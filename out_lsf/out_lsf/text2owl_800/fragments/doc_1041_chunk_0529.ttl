hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an advance reservation in LSF." .

hpc:Postscript a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a post-script in LSF." .

hpc:Prescript a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a pre-script in LSF." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in LSF." .

hpc:hasendtime a owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservation, hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The end time for a reservation or job." .

hpc:hasprescripttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of time, in minutes, before the start of the advance reservation for LSF to run the pre-script." .

hpc:haspostscripttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:integer ;
    rdfs:comment "The amount of time, in minutes, before the expiry of the advance reservation for LSF to run the post-script." .

hpc:hasendtimeoffset a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation, hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "An offset in minutes to the current end time of a reservation or job." .

hpc:year a xsd:datatype ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Represents a year after 1900." .
