hpc:Submittinguser rdfs:domain hpc:Chunkjob ;
    rdfs:range hpc:Job .
hpc:Resourcerequirements rdfs:domain hpc:Chunkjob ;
    rdfs:range hpc:Resource .
hpc:Hostrequirements rdfs:domain hpc:Chunkjob ;
    rdfs:range hpc:Host .
hpc:Queueorapplicationprofile rdfs:domain hpc:Chunkjob ;
    rdfs:range hpc:Queueorapplicationprofile .
hpc:Jobpriority rdfs:domain hpc:Chunkjob ;
    rdfs:range xsd:decimal .
hpc:Backfillscheduling rdfs:domain hpc:Chunkjob ;
    rdfs:range xsd:boolean .
hpc:Advancereservation rdfs:subClassOf hpc:Currentresourcereservationpolicy .
hpc:Resizablejob rdfs:subClassOf hpc:Job .
hpc:Originaljob rdfs:subClassOf hpc:Job .
hpc:Subsequentcalculation rdfs:subClassOf hpc:Job .
hpc:Factor rdfs:subClassOf hpc:Apsvalue .
hpc:Subfactor rdfs:subClassOf hpc:Factor .
hpc:Behavior rdfs:subClassOf hpc:Apsvalue .
hpc:Fairshare rdfs:subClassOf hpc:Queuepolicy .
hpc:Resizablejobinfairsharequeue rdfs:subClassOf hpc:Resizablejob .
hpc:Regularjob rdfs:subClassOf hpc:Job .
hpc:Fairshareuserprioritypolicy rdfs:subClassOf hpc:Queuepolicy .
hpc:Pendingresizeallocationrequest rdfs:subClassOf hpc:Job .

hpc:Fairshareresizablejobs rdfs:subClassOf hpc:Resizablejobinfairsharequeue .
hpc:LSFTreatsPendingResizeAllocationRequestsAsAReg
