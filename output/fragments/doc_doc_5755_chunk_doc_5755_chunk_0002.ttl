hpc:JobScheduling a owl:Class .
hpc:JobNotRunning a hpc:JobScheduling .
hpc:SlurmBackfillScheduler a hpc:JobScheduling .

# Killed Jobs
hpc:KilledJob a owl:Class .
hpc:PrematurelyKilledJob a hpc:KilledJob .
hpc:BatchJobKilled a hpc:KilledJob .
hpc:ForceTerminatedJob a hpc:KilledJob .
hpc:FirstTaskExited a hpc:KilledJob .
hpc:JobFailed a hpc:KilledJob .

# Managing Jobs
hpc:JobManagement a owl:Class .
hpc:TemporaryJobHold a hpc:JobManagement .
hpc:ChangeJobSize a hpc:JobManagement .
hpc:EstimatedStartTimeNotDisplayed a hpc:JobManagement .

# Job Output
hpc:JobOutput a owl:Class .
hpc:ColorCodedOutput a hpc:JobOutput .

# Commands
hpc:SrunCommand a owl:Class .
hpc:SbatchCommand a owl:Class .
hpc:RemoteTerminalTaskLaunch a hpc:SrunCommand .
hpc:InteractiveModeShellPrompt a hpc:SrunCommand .
hpc:X11DisplayExport a hpc:SrunCommand .

# Options
hpc:OvercommitOption a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:boolean .
hpc:UnbufferedOption a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:boolean .
hpc:CarriageReturnInOutput a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:string .
