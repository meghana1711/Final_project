hpc:Lsf a owl:Class .
hpc:Applicationcenter a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:comment "Version 10.2.x or later" ;
    rdfs:label "Application Center" .
hpc:Explorer a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:comment "Version 10.2.x or later" ;
    rdfs:label "Explorer" .
hpc:Processmanager a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:comment "Version 10.2.x or later" ;
    rdfs:label "Process Manager" .
hpc:Rtm a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:comment "Version 10.2.x or later" ;
    rdfs:label "RTM" .

hpc:hasversion a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

