hpc:Elasticsearchconnection a owl:Class .
hpc:UseSsl rdfs:domain hpc:Elasticsearchconnection ;
                 rdfs:range xsd:boolean .
hpc:CaCerts rdfs:domain hpc:Elasticsearchconnection ;
                 rdfs:range xsd:string .
hpc:VerifyCerts rdfs:domain hpc:Elasticsearchconnection ;
                 rdfs:range xsd:boolean .

hpc:Lsfsimulatorelasticsearchconnection a owl:Class ;
    rdfs:subClassOf hpc:Elasticsearchconnection .
