hpc:Relativeqos a owl:Class ;
    rdfs:subClassOf hpc:Qos ;
    rdfs:comment "When added to a QOS, slurmctld must be restarted or reconfigured for the flag to take effect." .

hpc:haspartitionqos a owl:ObjectProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range hpc:Qos ;
    rdfs:comment "Limits will be calculated relative to the partition's resources." .

hpc:partitionexclusive a owl:ObjectProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer ;
    rdfs:comment "Only one partition may have this QOS as its partition QOS." .

hpc:jobexclusion a owl:ObjectProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Jobs will not be allowed to use it as a normal QOS." .

hpc:denyonlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Jobs using this QOS will be rejected at submission time if they do not conform to the QOS 'Max' limits as stand-alone jobs." .

hpc:maxlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Qos ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum limit for jobs using this QOS." .
