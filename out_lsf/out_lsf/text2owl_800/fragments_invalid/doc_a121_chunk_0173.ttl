hpc:Esub a owl:Class ;
    rdfs:subClassOf hpc:Jobcontrol ;
    rdfs:comment "An esub started by bmod or brestart cannot change the environment.";
    rdfs:comment "Any esub messages that are provided to the user must be directed to standard error, not to standard output.";
    rdfs:comment "Standard output from any esub is automatically passed to eexec.";
    rdfs:comment "An eexec can handle only one standard output stream from an esub as standard input to eexec.";
    rdfs:comment "You must make sure that your eexec handles standard output from correctly if any esub writes to standard output.";
    rdfs:comment "The esub and eexec combination cannot handle daemon authentication.";
    rdfs:comment "To conﬁgure daemon authentication, you must enable external authentication, which uses the eauth executable ﬁle.";

hpc:Eexec a owl:Class ;
    rdfs:subClassOf hpc:Jobcontrol ;
    rdfs:comment "Configuration to enable job submission and execution controls with at least one esub, epsub, or eexec executable file in the directory specified by the parameter LSF_SERVERDIR in the lsf.conf file.";
    rdfs:comment "LSF does not include a default esub, epsub, or eexec; write your own executable files to meet the job requirements of your site.";
    rdfs:comment "Executable file UNIX naming convention Windows naming convention";

hpc:hasexecutable a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of your esub/epsub indicates the application with which it runs.";

hpc:Reservednames a owl:Class ;
    rdfs:subClassOf hpc:String ;
    rdfs:comment "The names esub.user and epsub.user are reserved.";

hpc:Validfilename a owl:Class ;
    rdfs:subClassOf hpc:String ;
    rdfs:comment "Valid file names contain only alphanumeric characters, underscores (_), and hyphens (-).";

hpc:jobassociation a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrol ;
    rdfs:range hpc:Job ;
    rdfs:comment "Users can specify the esub/epsub executable files that are associated with each job they submit.";

hpc:defaultexec a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Eexec ;
    rdfs:comment "If an eexec exists in LSF_SERVERDIR, LSF invokes that eexec for all jobs that are submitted to the cluster.";
