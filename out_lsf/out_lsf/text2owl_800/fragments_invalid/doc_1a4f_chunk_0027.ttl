@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:type a owl:ObjectProperty .
hpc:interval a owl:DatatypeProperty .
hpc:increasing a owl:ObjectProperty .
hpc:consumable a owl:ObjectProperty .
hpc:description a owl:DatatypeProperty .

hpc:Numericresource a rdfs:subClassOf hpc:Resource .
hpc:Stringresource a rdfs:subClassOf hpc:Resource .
hpc:Booleanresource a rdfs:subClassOf hpc:Resource .

hpc:Builtin a owl:Class .
hpc:Dynamic a owl:Class .
hpc:release a owl:DatatypeProperty .

hpc:Patchrev rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Patch revision" .

hpc:Specman rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specman" .

hpc:Switch rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Network Switch" .

hpc:Rack rdfs:domain hpc:Stringresource ;
    rdfs:range xsd:string ;
    rdfs:comment "Server room rack" .

hpc:Owner rdfs:domain hpc:Stringresource ;
    rdfs:range xsd:string ;
    rdfs:comment "Owner of the host" .

hpc:Elimres rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "elim generated index" .

hpc:Consumable rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .

hpc:Builtin rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Built-in static resources are not consumable." .

hpc:Dynamic rdfs:subClassOf hpc:Resource .

hpc:Numeric rdfs:subClassOf hpc:Dynamic ;
    rdfs:comment "All numeric resources are consumable." .

hpc:String rdfs:subClassOf hpc:Dynamic ;
    rdfs:comment "String resources are not consumable." .

hpc:Boolean rdfs:subClassOf hpc:Dynamic ;
    rdfs:comment "Boolean resources are not consumable." .

hpc:Nonconsumable a owl:Class
