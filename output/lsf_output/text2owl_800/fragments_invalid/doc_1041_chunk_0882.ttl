hpc:Errorfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Specify a file path. Appends the standard error output of the job to the specified file.";

hpc:haserrorfilelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Gets the standard error file location for the job.";

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the LSF Session Scheduler.";

hpc:hasjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The job ID.";

hpc:hasjobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The job array index.";

hpc:hastaskid a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The task ID.";

hpc:hastaskarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The task array index.";

hpc:Inputfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Specify an input file for the job.";

hpc:hasinputfilelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Inputfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Gets the input file location.";

hpc:Joblocation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The location where the job runs.";

hpc:lsbstdoutdirect a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether the standard error output of a task is written to the specified file directly.";

hpc:standarderroroutputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The file where the standard error output of the job is written.";

hpc:standarderroroutputfiletemporary a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The temporary file where the standard error output of a task is written if LSB_STDOUT_DIRECT is not set.";

hpc:maximumfilelength a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger ;
