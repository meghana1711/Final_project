hpc:AssocGrpGRES a owl:Class .
hpc:AssocGrpGRESMinutes a owl:Class .
hpc:AssocGrpGRESRunMinutes a owl:Class .
hpc:AssocGrpJobsLimit a owl:Class .
hpc:AssocGrpLicense a owl:Class .
hpc:AssocGrpLicenseMinutes a owl:Class .
hpc:AssocGrpLicenseRunMinutes a owl:Class .
hpc:AssocGrpMemLimit a owl:Class .
hpc:AssocGrpMemMinutes a owl:Class .
hpc:AssocGrpMemRunMinutes a owl:Class .
hpc:AssocGrpNodeLimit a owl:Class .
hpc:AssocGrpNodeMinutes a owl:Class .
hpc:AssocGrpNodeRunMinutes a owl:Class .
hpc:AssocGrpSubmitJobsLimit a owl:Class .

hpc:hasReachedAggregateGRESLimit a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateGRES a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateGRESRun a owl:ObjectProperty .
hpc:hasReachedMaxJobsAggregate a owl:ObjectProperty .
hpc:hasReachedAggregateLicenseLimit a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateLicense a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateLicenseRun a owl:ObjectProperty .
hpc:hasReachedAggregateMemoryLimit a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateMemory a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateMemoryRun a owl:ObjectProperty .
hpc:hasReachedAggregateNodeLimit a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateNode a owl:ObjectProperty .
hpc:hasReachedMaxMinutesAggregateNodeRun a owl:ObjectProperty .
hpc:hasReachedMaxSubmittingJobsLimit a owl:ObjectProperty .

hpc:AssocGrpGRES rdfs:subClassOf [ a owl:Restriction ;
                                   owl:onProperty hpc:hasReachedAggregateGRESLimit ;
                                   owl:hasValue xsd:decimal ] .
hpc:AssocGrpGRESMinutes rdfs:subClassOf [ a owl:Restriction ;
                                            owl:onProperty hpc:hasReachedMaxMinutesAggregateGRES ;
                                            owl:hasValue xsd:decimal ] .
hpc:AssocGrpGRESRunMinutes rdfs:subClassOf [ a owl:Restriction ;
                                               owl:onProperty hpc:hasReachedMaxMinutesAggregateGRESRun ;
                                               owl:hasValue xsd:decimal ] .
hpc:AssocGrpJobsLimit rdfs:subClassOf [ a owl:Restriction ;
                                          owl:onProperty hpc:hasReachedMaxJobsAggregate ;
                                          owl:hasValue xsd:nonNegativeInteger ] .
