hpc:Job a owl:Class .
hpc:Group a owl:Class .
hpc:Partition a owl:Class .
hpc:Host a owl:Class .
hpc:Sla a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:Serviceclassname rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Priority rdfs:domain hpc:Sla ;
    rdfs:range xsd:decimal .
hpc:Goal rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Activewindow rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Sla ;
    rdfs:range xsd:string .
hpc:Slathroughput rdfs:domain hpc:Sla ;
    rdfs:range xsd:decimal .
hpc:Njobspend rdfs:domain hpc:Sla ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Run rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Started rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Reserved rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:CpuTime rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:RunTime rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:Bhpart rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:HostPartitionName rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:Hosts rdfs:domain hpc:Partition ;
    rdfs:range rdf:List .
hpc:ShareInfoFor rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:Usershare rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Groupshare rdfs:domain hpc:Partition ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Group a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:group1 a hpc:Group ;
    hpc:STARTED 10 ;
    hpc:RESERVED 5 ;
    hpc:CPU_TIME 200.0 ;
    hpc:RUN_TIME 1324 ;
    hpc:bhpart "Partition1" ;
    hpc:SHARE_INFO_FOR "Partition1/" .
hpc:Partition1 a hpc:Partition ;
    hpc:HOST_PARTITION_NAME "Partition1" ;
    hpc:HOSTS (hpc:hostA hpc:hostB hpc:hostC) .
