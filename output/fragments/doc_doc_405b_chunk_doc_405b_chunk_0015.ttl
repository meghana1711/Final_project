hpc:QOSMaxEnergyPerJob a owl:Class .
hpc:QOSMaxEnergyPerNode a owl:Class .
hpc:QOSMaxEnergyPerUser a owl:Class .
hpc:QOSMaxGRESMinutesPerJob a owl:Class .
hpc:QOSMaxGRESPerJob a owl:Class .
hpc:QOSMaxGRESPerNode a owl:Class .
hpc:QOSMaxGRESPerUser a owl:Class .
hpc:QOSMaxJobsPerUserLimit a owl:Class .
hpc:QOSMaxLicenseMinutesPerJob a owl:Class .
hpc:QOSMaxLicensePerJob a owl:Class .
hpc:QOSMaxLicensePerUser a owl:Class .
hpc:QOSMaxMemoryMinutesPerJob a owl:Class .

hpc:exceedsMax a owl:ObjectProperty ;
    rdfs:domain hpc:QOSMax* ;
    rdfs:range xsd:boolean .

hpc:usedByJob a owl:ObjectProperty ;
    rdfs:domain hpc:QOSMax* ;
    rdfs:range hpc:Job .

hpc:usedByNode a owl:ObjectProperty ;
    rdfs:domain hpc:QOSMaxGRES* ;
    rdfs:range hpc:Node .

hpc:usedByUser a owl:ObjectProperty ;
    rdfs:domain hpc:QOSMaxEnergyPer*, hpc:QOSMaxGRES*, hpc:QOSMaxLicense*, hpc:QOSMaxJobsPerUserLimit ;
    rdfs:range hpc:User .

hpc:QOSMaxJobsPerUserLimit a rdfs:subClassOf [ a owl:Class ;
    rdfs:subClassOf hpc:QOSMaxJobsPerUser ;
    rdfs:comment "The limit on the number of jobs a user is allowed to run at a given time has been met for the requested QOS." ] .
```
