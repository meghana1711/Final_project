hpc:Remotedatamanager a owl:Class .
hpc:clustername a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:string .
hpc:servers a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:string .
hpc:port a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:integer .
hpc:Cluster a owl:Class .
hpc:Server a owl:Class .
hpc:hascluster a owl:ObjectProperty ;
    rdfs:domain hpc:Server ;
    rdfs:range hpc:Cluster .
hpc:hasserver a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Server .
hpc:Remotedatamanagers a owl:Class ;
    rdfs:subClassOf hpc:Remotedatamanager .
hpc:remotedatamanagers hasPart a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedatamanagers ;
    rdfs:range hpc:Remotedatamanager .
hpc:Remotedatamanagerssection a owl:Class ;
    rdfs:subClassOf hpc:Remotedatamanagers .
hpc:remotedatamanagerssection hasRemoteDataManager a owl:ObjectProperty ;
    rdfs:domain hpc:Remotedatamanagerssection ;
    rdfs:range hpc:Remotedatamanager .
