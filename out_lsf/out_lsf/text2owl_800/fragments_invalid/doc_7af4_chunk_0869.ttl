hpc:Lsfserver a owl:Class .
hpc:lsfproxydport a owl:DatatypeProperty .
hpc:lsfproxydhosts a owl:ObjectProperty .
hpc:Ratelimiter a owl:Class .
hpc:Clientrequestport owl:FunctionalProperty rdfs:domain hpc:Ratelimiter ;
                                               rdfs:range xsd:integer .
hpc:Badminrequestport owl:FunctionalProperty rdfs:domain hpc:Ratelimiter ;
                                               rdfs:range xsd:integer .
hpc:RateLimiterTokenRequestPort rdfs:subPropertyOf hpc:ClientRequestPort .
hpc:BadminRequestPort rdfs:subPropertyOf hpc:BadminRequestPort .
hpc:Validpositiveinteger a owl:Class ;
                            rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Defaultnotdefined a owl:Class .
