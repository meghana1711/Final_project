hpc:JobAttaDir a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
                       rdfs:subClassOf rdf:String ] .

hpc:hasdirectorytype a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the type of directory (UNIX or Windows)" .

hpc:isshareddirectory a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory is shared by all hosts in the cluster" .

hpc:isownedbyprimaryadmin a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the primary LSF administrator who owns the directory" .

hpc:haswritablepermission a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory is writable by the primary LSF administrator" .

hpc:hasfreespace a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Specifies the minimum free space in the directory (in MB)" .

hpc:hasmaxlength a owl:DatatypeProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the maximum length of the directory path (in characters)" .

hpc:isabsolutepathonunix a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the UNIX path is absolute" .

hpc:isuncpathonwindows a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the Windows path is a UNC path" .

hpc:hasdriveletteronwindows a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the Windows path has a drive letter" .

hpc:isusedforattacheddata a owl:ObjectProperty ;
    rdfs:domain hpc:JobAttaDir ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Indicates that the directory is used for storing attached data of messages posted with the bpost command" .
