hpc:Lsfcluster a owl:Class .
hpc:installprocedure a owl:ObjectProperty .
hpc:configurationfile a owl:DatatypeProperty .
hpc:clusterName owl:ObjectProperty .
hpc:adminUser owl:DatatypeProperty .
hpc:lsfconffile a owl:DatatypeProperty .
hpc:passwdfile a owl:DatatypeProperty .
hpc:batchconfigurationfile a owl:DatatypeProperty .

hpc:Lsfcluster rdfs:subClassOf owl:Class .
hpc:Installprocedure rdfs:domain hpc:Lsfcluster ;
                          rdfs:range rdf:Seq .
hpc:Configurationfile rdfs:domain hpc:Lsfcluster ;
                          rdfs:range xsd:string .
hpc:Clustername rdfs:domain hpc:Lsfcluster ;
                  rdfs:range xsd:string .
hpc:Adminuser rdfs:domain hpc:Lsfcluster ;
             rdfs:range xsd:string .
hpc:Lsfconffile rdfs:domain hpc:Lsfcluster ;
               rdfs:range xsd:string .
hpc:Passwdfile rdfs:domain hpc:Lsfcluster ;
              rdfs:range xsd:string .
hpc:Batchconfigurationfile rdfs:domain hpc:Lsfcluster ;
                          rdfs:range xsd:string .

hpc:migratevalues a owl:ObjectProperty ;
                   rdfs:domain hpc:Lsfcluster ;
                   rdfs:range rdf:Seq .
hpc:copypasswdfile a owl:ObjectProperty ;
                    rdfs:domain hpc:Lsfcluster ;
                    rdfs:range xsd:string .
hpc:copybatchconfigurationfiles a owl:ObjectProperty ;
                                 rdfs:domain hpc:Lsfcluster ;
                                 rdfs:range rdf:Seq .
