# Software
hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a hpc:SlurmWorkloadManager .

# Navigation
hpc:Overview a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:ReleaseNotes a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:Using a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:Documentation a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:FAQ a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:Publications a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:Installing a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:GettingHelp a rdfs:SubClassOf hpc:SlurmWorkloadManager .
hpc:MailingLists a rdfs:SubClassOf hpc:GettingHelp .
hpc:SupportAndTraining a rdfs:SubClassOf hpc:GettingHelp .
hpc:Troubleshooting a rdfs:SubClassOf hpc:GettingHelp .

# pam_slurm_adopt
hpc:pam_slurm_adopt a owl:Class .
hpc:pam_slurm_adopt rdfs:subClassOf hpc:Software .

hpc:installationMethod a owl:ObjectProperty .
hpc:slurmConfiguration a owl:ObjectProperty .
hpc:sshConfiguration a owl:ObjectProperty .
hpc:pamConfiguration a owl:ObjectProperty .
hpc:administrativeAccessConfiguration a owl:ObjectProperty .
hpc:pamModuleOptions a owl:ObjectProperty .
hpc:firewallsIPAddresses a owl:ObjectProperty .
hpc:selinux a owl:ObjectProperty .
hpc:limitations a owl:ObjectProperty .

hpc:installationMethod rdfs:domain hpc:pam_slurm_adopt ;
  rdfs:range hpc:InstallationMethod .

hpc:slurmConfiguration rdfs:domain hpc:pam_slurm_adopt ;
  rdfs:range hpc:SlurmConfiguration .

hpc:sshConfiguration rdfs:domain hpc:pam_slurm_adopt ;
  rdfs:range hpc:SSHConfiguration .

hpc:pamConfiguration rdfs:domain hpc:pam_slurm_adopt ;
  rdfs:range hpc:PAMConfiguration .

hpc:administrativeAccessConfiguration rdfs:domain hpc:pam_
