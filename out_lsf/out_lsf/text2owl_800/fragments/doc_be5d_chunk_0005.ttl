hpc:Lsfjob a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:Lsfhost a owl:Class .
hpc:Lsflicense a owl:Class .
hpc:Lsftoken a owl:Class .
hpc:lsfjobpriority a owl:ObjectProperty .
hpc:Haslsfhost rdfs:domain hpc:Lsfjob ;
                 rdfs:range hpc:Lsfhost .
hpc:Belongstolsfproject rdfs:domain hpc:Lsfjob ;
                        rdfs:range xsd:string .
hpc:Haslsflicense rdfs:domain hpc:Lsfjob ;
                  rdfs:range hpc:Lsflicense .
hpc:Haslsftoken rdfs:domain hpc:Lsfjob ;
                 rdfs:range hpc:Lsftoken .
hpc:lsfclusterconnection a owl:ObjectProperty .
hpc:Isconnected rdfs:domain hpc:Lsfcluster ;
                   rdfs:range xsd:boolean .
hpc:Isdisconnected rdfs:domain hpc:Lsfcluster ;
                    rdfs:range xsd:boolean .
hpc:Lsfclusteroffline a owl:Class .
hpc:Hasmbatchd rdfs:domain hpc:Lsfcluster ;
                   rdfs:range xsd:boolean .
hpc:Lsfbldoffline a owl:Class .
hpc:Hastokendistribution rdfs:domain hpc:Lsfbld ;
                      rdfs:range hpc:Lsftoken .
hpc:Updatestokendistribution rdfs:domain hpc:Mbatchd ;
                            rdfs:range xsd:boolean .
hpc:Losesconnection rdfs:domain hpc:Mbatchd ;
                      rdfs:range xsd:boolean .
