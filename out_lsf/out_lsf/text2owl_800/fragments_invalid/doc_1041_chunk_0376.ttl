hpc:Nonshareddistribution a owl:Class .
hpc:Workloaddistribution a owl:Class .
hpc:Lsf a owl:Class .
hpc:NonLsf a owl:Class .

hpc:hasWorkloadDistribution rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Workloaddistribution ;
    rdfs:range hpc:Workloaddistribution .

hpc:lsfPercentage a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:decimal .

hpc:nonLsfPercentage a owl:DatatypeProperty ;
    rdfs:domain hpc:NonLsf ;
    rdfs:range xsd:decimal .

hpc:nonshareddistributionPercentage a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonshareddistribution ;
    rdfs:range xsd:decimal .

hpc:hasNonSharedDistribution rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Nonshareddistribution .

hpc:Files a owl:Class .
hpc:reads a owl:ObjectProperty ;
    rdfs:domain hpc:Files ;
    rdfs:range rdf:Resource .

hpc:Blkill a owl:Class .
hpc:terminatestask a owl:ObjectProperty ;
    rdfs:domain hpc:Blkill .

hpc:taskid a owl:DatatypeProperty ;
    rdfs:domain hpc:Blkill ;
    rdfs:range xsd:nonNegativeInteger .

hpc:seconds a owl:DatatypeProperty ;
    rdfs:domain hpc:Blkill ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Blparams a owl:Class .
hpc:displaysinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Blparams .

hpc:Lsflicensescheduler a owl:Class .
hpc:readsfile a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range rdf:Resource .

hpc:Blusers a owl:Class .
hpc:seealso a owl:ObjectProperty ;
    rdfs:domain hpc:Blusers .
    rdfs:range rdf:Resource .

hpc:Blstat a owl:Class .
hpc:seealso a owl:ObjectProperty ;
    rdfs:domain hpc:Blstat .
    rdfs:range rdf:Resource .

hpc:Lsfconf a owl:Class .
hpc:seealso a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconf .
    rdfs:range rdf:Resource .
