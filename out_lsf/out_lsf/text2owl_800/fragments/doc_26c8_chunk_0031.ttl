hpc:AwsApiCredentials a owl:Class .
hpc:awsCredentialScript a owl:ObjectProperty ;
    rdfs:domain hpc:AwsApiCredentials ;
    rdfs:range xsd:string .
hpc:awsCredentialFile a owl:DatatypeProperty ;
    rdfs:domain hpc:AwsApiCredentials ;
    rdfs:range xsd:string .
hpc:awsEndpointUrl a owl:ObjectProperty ;
    rdfs:domain hpc:AwsApiCredentials ;
    rdfs:range xsd:string .
hpc:awsRegion a owl:DatatypeProperty ;
    rdfs:domain hpc:AwsApiCredentials ;
    rdfs:range xsd:string .
hpc:awsKeyFile a owl:DatatypeProperty ;
    rdfs:domain hpc:AwsApiCredentials ;
    rdfs:range xsd:string .
hpc:AwsCredentialScriptFederated a owl:Class ;
    rdfs:subClassOf hpc:AwsCredentialScript .
hpc:AwsCredentialFileIgnored a owl:Class ;
    rdfs:subClassOf hpc:AwsApiCredentials ;
    rdfs:subClassOf hpc:AwsCredentialScriptFederated .
