hpc:Reservation a owl:Class ;
    rdfs:subClassOf hpc:Advancereservation .

hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timeboundreservation ;
    rdfs:subClassOf hpc:Modifiablereservation .

hpc:Timeboundreservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Reservation ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:dateTime .

hpc:Modifiablereservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timeboundreservation ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:boolean .

hpc:hasbegintime a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
