hpc:Pendingreason a owl:Class .
hpc:Haspendingreasonmessage rdfs:domain hpc:Pendingreason ;
                             rdfs:range xsd:string .
hpc:Hasconfigurablemessage rdfs:domain hpc:Pendingreason ;
                             rdfs:range xsd:boolean .
hpc:Isconfiguredin rdfs:domain hpc:Pendingreason ;
                    rdfs:range hpc:Configurationfile .
hpc:Configurationfile a owl:Class .
hpc:hascustomer a owl:ObjectProperty .
hpc:hascommand a owl:ObjectProperty .
hpc:hasformatspec a owl:ObjectProperty .
hpc:hasfield a owl:ObjectProperty .
hpc:hasdetailedreason a owl:ObjectProperty .
hpc:hashostname a owl:DatatypeProperty .
hpc:hasqueuename a owl:DatatypeProperty .
hpc:hasjobgroupname a owl:DatatypeProperty .
hpc:hasusergroupname a owl:DatatypeProperty .
hpc:haslimitname a owl:DatatypeProperty .
hpc:haslimitvalue a owl:DatatypeProperty .
hpc:haspendingreasonlevel a owl:DatatypeProperty .
hpc:haspendreasonlevelvalue a owl:DatatypeProperty .
hpc:haspendreasonsummary a owl:ObjectProperty .
hpc:haspsumoption a owl:DatatypeProperty .
hpc:Configurationfile a rdfs:subClassOf hpc:Resource .
hpc:Pendingreason rdfs:subClassOf hpc:Resource .
