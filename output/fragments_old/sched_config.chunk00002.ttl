hpc:Job a owl:Class .
hpc:JobPair a owl:Class .
hpc:StartTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:BackfillResolution rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .
hpc:BackfillWindow rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .
hpc:BackfillYieldInterval rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .
hpc:BackfillYieldSleep rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .
hpc:CanStartNow a owl:ObjectProperty .
hpc:JobPair rdfs:subClassOf hpc:Job .
hpc:HasSameJob as hpc:CanStartNow .
hpc:HasBackfillResolution a owl:ObjectProperty .
hpc:HasBackfillWindow a owl:ObjectProperty .
hpc:HasBackfillYieldInterval a owl:ObjectProperty .
hpc:HasBackfillYieldSleep a owl:ObjectProperty .
```
