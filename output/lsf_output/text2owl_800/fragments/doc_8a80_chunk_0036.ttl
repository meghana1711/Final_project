hpc:Cluster a owl:Class .
hpc:Interactivetask a owl:Class .
hpc:Feature a owl:Class .
hpc:License a owl:Class .
hpc:Lsfjob a owl:Class .

hpc:hasallocation a owl:ObjectProperty;
    rdfs:domain hpc:Feature;
    rdfs:range hpc:Allocation .

hpc:hascluster a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range hpc:Cluster .

hpc:hasinteractivetaskshare a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:integer .

hpc:hasjobshare a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:integer .

hpc:hasname a owl:DatatypeProperty;
    rdfs:domain hpc:Feature;
    rdfs:range xsd:string .

hpc:hasdistribution a owl:DatatypeProperty;
    rdfs:domain hpc:Feature;
    rdfs:range xsd:string .

hpc:isprojectmode a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:boolean .

hpc:ignoresglobalinteractivesetting a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:boolean .

hpc:ismegacluster a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range hpc:Allocation .

hpc:hasequalshare a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:integer .

hpc:hasnointeractivetaskshare a owl:ObjectProperty;
    rdfs:domain hpc:Allocation;
    rdfs:range xsd:integer .
