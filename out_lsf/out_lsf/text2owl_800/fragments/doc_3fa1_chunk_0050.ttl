hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:Fairsharetree a owl:Class .
hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .
hpc:userpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .
hpc:hasfairshareassignment a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Fairshareassignment .
hpc:isallowedtousequeue a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Queue .
hpc:hasfairsharetree a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Fairsharetree .
hpc:Fairsharequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:parentqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharequeue ;
    rdfs:range hpc:Queue .
hpc:childqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Fairsharequeue .
hpc:fairsharetreehasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharetree ;
    rdfs:range hpc:Queue .
hpc:fairsharetreehasparent a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharetree ;
    rdfs:range hpc:Fairsharetree .
hpc:Fairshare a owl:Class ;
    rdfs:subClassOf hpc:Fairsharetree .
hpc:fairsharetreehasfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharetree ;
    rdfs:range hpc:Fairshare .
hpc:fairsharequeuehasfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Fairsharequeue ;
    rdfs:range hpc:Fairshare .
hpc:fairshareQueues a owl:ObjectProperty ;
    rdfs:domain hpc:Fairshare ;
    rdfs:range hpc:Fairsharequeue .
hpc:dispatchorder a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Crossqueuefairshare a owl:Class ;
    rdfs:subClassOf hpc:Fairsharetree .
hpc:crossqueuefairsharehaspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Crossqueuefairshare ;
