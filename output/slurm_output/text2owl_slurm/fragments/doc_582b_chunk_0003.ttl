hpc:Systemdservice a owl:Class .
hpc:tasksmax a owl:ObjectProperty .
hpc:Tasksmax rdfs:domain hpc:Systemdservice ;
                 rdfs:range xsd:nonNegativeInteger .

hpc:Initscript a owl:Class .
hpc:overridefile a owl:ObjectProperty .
hpc:Overridefile rdfs:domain hpc:Initscript ;
                 rdfs:range rdf:XMLLiteral .

hpc:Systemdservicefile a owl:Class .
hpc:tasksmaxsetting a owl:DatatypeProperty .
hpc:Systemdservicefile rdfs:subClassOf hpc:Systemdservice .
hpc:systemdservicefiletasksmaxsetting a owl:ObjectProperty ;
                               rdfs:domain hpc:Systemdservicefile ;
                               rdfs:range xsd:nonNegativeInteger .

hpc:Ulimit a owl:Class .
hpc:memorysize a owl:DatatypeProperty .
hpc:openfilecount a owl:DatatypeProperty .
hpc:stacksize a owl:DatatypeProperty .
hpc:Ulimit rdfs:subClassOf hpc:Systemdservice .

hpc:Nodeselectionplugin a owl:Class .
hpc:selecttype a owl:ObjectProperty .
hpc:Selecttype rdfs:domain hpc:Nodeselectionplugin .

hpc:Jobaccountinggatherplugin a owl:Class .
hpc:jobacctgathertype a owl:ObjectProperty .
hpc:Jobacctgathertype rdfs:domain hpc:Jobaccountinggatherplugin .

hpc:jobaccountinggatherfrequency a owl:DatatypeProperty .

hpc:Jobcompletionrecords a owl:Class .
hpc:jobcomptype a owl:ObjectProperty .
hpc:Jobcomptype rdfs:domain hpc:Jobcompletionrecords .

hpc:Systemnoise a owl:Class .
