hpc:Predictiondescription a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Description of the prediction." .

hpc:datalocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Prediction ;
    rdfs:range xsd:string .

hpc:lsfclustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Prediction ;
    rdfs:range xsd:string .

hpc:workloadstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Prediction ;
    rdfs:range xsd:dateTime .

hpc:workloadendtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Prediction ;
    rdfs:range xsd:dateTime .

hpc:Jobfeature a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:modeltrainingdata a owl:ObjectProperty ;
    rdfs:domain hpc:Jobfeature ;
    rdfs:range hpc:Jobfeature .

hpc:Pipelinedetails a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:pipelinerank a owl:DatatypeProperty ;
    rdfs:domain hpc:Pipelinedetails ;
    rdfs:range xsd:integer .

hpc:modeltrainingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pipelinedetails ;
    rdfs:range xsd:duration .

hpc:modelpublish a owl:ObjectProperty ;
    rdfs:domain hpc:Pipelinedetails ;
    rdfs:range hpc:Model .

hpc:modeltest a owl:ObjectProperty ;
    rdfs:domain hpc:Prediction ;
    rdfs:range hpc:Predictionresult .

hpc:Predictionresult a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
