hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Linuxjob ;
    rdfs:comment "A job in the HPC system." .

hpc:memoryswaplimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The memory and swap limit for a job." .

hpc:lsbresourceenforce a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether a host-based memory limit is set for the job." .

hpc:hl a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the -hl option is applied to the job." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A parallel job in the HPC system." .

hpc:cgroupenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether cgroup limits are enforced for the parallel job." .

hpc:launchframework a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the framework used to launch the parallel job." .

hpc:lsfnotifications a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the notifications received by LSF for the parallel job." .

hpc:Zombieprocess a owl:Class ;
    rdfs:subClassOf hpc:Paralleljob ;
    rdfs:comment "A multithreaded application that becomes a zombie process." .

hpc:Pamlimits a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "System resource limits defined in limits.conf for a job." .

hpc:Pamconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Pamlimits ;
    rdfs:comment "The configuration of PAM for a job." .

hpc:Linuxpam a owl:Class ;
    rdfs:subClassOf hpc:Pamconfiguration ;
    rdfs:comment "PAM limits applied to a Linux host." .

hpc:usePamCreds a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether to apply PAM limits to a queue." .

hpc:Lsfqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue in the LSF system." .

hpc:Lsfapplication a owl:Class ;
    rdfs:subClassOf hpc:Application
