hpc:MBatchd
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Handles new queries while old queries are finished." .

hpc:ChildMBatchd
    a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd ;
    rdfs:comment "Forked by mbatchd to handle new queries." .

hpc:JobQuery
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A query related to a job." .

hpc:BatchQuery
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A query related to a batch job." .

hpc:MAX_CONCURRENT_QUERY
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Sets the maximum number of queries that can be handled by each child mbatchd." .

hpc:LSB_QUERY_ENH
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables multithreaded query support for all batch query requests." .

hpc:FastHostStatusUpdate
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Improves the speed of host status updates." .

hpc:FastHostStatusDiscovery
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fasthoststatusupdate ;
    rdfs:range hpc:Fasthoststatusupdate ;
    rdfs:comment "Improves the speed of host status discovery after cluster startup." .

hpc:MultiThreadedUDPCommunications
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fasthoststatusupdate ;
    rdfs:range hpc:Fasthoststatusupdate ;
    rdfs:comment "Improves the speed of host status updates using multi-threaded UDP communications." .

hpc:FastResponseToHostStatusChange
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fasthoststatusupdate ;
    rdfs:range hpc:Fasthoststatusupdate ;
    rdfs:comment "Improves the speed of response to static or dynamic host status change." .

hpc:SimultaneousHostRegistration
    a owl:ObjectProperty ;
    rdfs:domain hpc:Fasthoststatusupdate ;
    rdfs:range hpc:Fasthoststatusupdate ;
    rdfs:comment "Simultaneously accepts new host registration." .

hpc:LSB_SYNC_HOST_STAT_LIM
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Improves the speed with which mbatchd obtains host status." .

hpc:LSB_MAX_PROBE_SBD
    a owl:DatatypeProperty ;
    rdfs:domain hp:LSF ;
