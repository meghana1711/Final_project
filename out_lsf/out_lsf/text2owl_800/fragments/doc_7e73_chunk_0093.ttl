hpc:Azureblobstorage a owl:Class .
hpc:hasBlobURL rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Azureblobstorage ;
    rdfs:range xsd:string .

hpc:Azureresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:hasDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:isInstanceFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Azureresource .

hpc:Lsfconfiguration a owl:Class .
hpc:hasModule rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration .

hpc:Pluginmodule a owl:Class .
hpc:hasPluginName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Pluginmodule .

hpc:ResourceName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:ResourceType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:ResourceInterval rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:Increasing rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:Description rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .
