hpc:Computenode a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range xsd:string .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range xsd:decimal .
hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range xsd:decimal .
hpc:modeltype a owl:DatatypeProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range xsd:string .
hpc:Server a owl:Class ;
    rdfs:subClassOf hpc:Computenode .
hpc:Gpu a owl:Class ;
    rdfs:subClassOf hpc:Computenode .
hpc:hasresource a owl:ObjectProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range hpc:Resource .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:resourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:Vnode a hpc:Resource ;
    hpc:ResourceName "craylinux" ;
    hpc:ResourceType "vnode" .
hpc:Gpu a hpc:Resource ;
    hpc:ResourceName "craylinux" ;
    hpc:ResourceType "vnode gpu" .

