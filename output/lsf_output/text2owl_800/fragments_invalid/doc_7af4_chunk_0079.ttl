hpc:Sbatchddeletionpolicy a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Options for sbatchd deleting CWD when all process related to the job finish.";

hpc:cwddeletiontimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Sbatchddeletionpolicy ;
    rdfs:range xsd:integer ;
    rdfs:comment "Timeout after which the CWD for a job is deleted.";

hpc:NeverDeleteCWD a owl:NamedIndividual ;
    hpc:CWDDeletionTimeout xsd:0 ;

hpc:checkeveryfiveminutes a owl:ObjectProperty ;
    rdfs:domain hpc:Sbatchddeletionpolicy ;
    rdfs:range hpc:Checkeveryfiveminutes ;
    rdfs:comment "The system checks the directory list every 5 minutes with regards to cleaning.";

hpc:avoidconflicts a owl:ObjectProperty ;
    rdfs:domain hpc:Sbatchddeletionpolicy ;
    rdfs:range hpc:Avoidconflicts ;
    rdfs:comment "Avoids conflicts when multiple jobs share some parent directories.";

hpc:postexecscriptfinishes a owl:ObjectProperty ;
    rdfs:domain hpc:Cwddeletiontimeout ;
    rdfs:range xsd:boolean ;
    rdfs:comment "TTL will be calculated after the post-exec script finishes.";

hpc:checkatstart a owl:ObjectProperty ;
    rdfs:domain hpc:Sbatchddeletionpolicy ;
    rdfs:range hpc:Checkatstart ;
    rdfs:comment "When LSF (sbatchd) starts, it checks the directory list file and deletes expired CWDs.";

hpc:NotDefined a owl:NamedIndividual ;
    hpc:CWDDeletionTimeout xsd:2147483647 ;

hpc:JobIncludePostproc a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies whether LSF includes the post-execution processing of the job as part of the job.";

hpc:preventsnewjob a owl:ObjectProperty ;
    rdfs:domain hpc:JobIncludePostproc ;
    rdfs:range hpc:Preventsnewjob ;
    rdfs:comment "Prevents a new job from starting on a host until post-execution processing is finished on that host.";

hpc:includescpuandruntimes a owl:ObjectProperty ;
    rdfs:domain hpc:JobIncludePostproc ;
    rdfs:range hpc:Includescpuandruntimes ;
    rdfs:comment "Includes the CPU and run times of post-execution processing with the job CPU and run times.";

hpc:sendsbothstatuses a owl:ObjectProperty ;
    rdfs:domain hpc:JobIncludePostproc ;
    rdfs:range hpc:Sendsbothstatuses ;
    rdfs:comment "sbatchd sends both job finish
