hpc:checkoutfromfirsthostonly a owl:DatatypeProperty .
hpc:Hascheckoutfromfirsthostonly rdfs:domain hpc:Job .
hpc:Hascheckoutfromfirsthostonly rdfs:range xsd:boolean .

hpc:clustermode a owl:ObjectProperty .
