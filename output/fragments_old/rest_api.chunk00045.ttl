hpc:Cluster a owl:Class .
hpc:Association a owl:Class .
hpc:Tres a owl:Class .
hpc:Tres_minutes a owl:Class .
hpc:Tres_minutes_per a owl:Class .
hpc:Tres_per a owl:Class .
hpc:Tres_per_job a owl:Class .
hpc:Tres_per_node a owl:Class .
hpc:Tres_per_group a owl:Class .
hpc:Tres_group_minutes a owl:Class .
hpc:Tres_group_active a owl:Class .
