hpc:lsfUgroupTransfer a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobexecutionmodel ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables users to specify a supplementary group from the client side." .

hpc:lsfUnitForLimits a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceusagelimits ;
    rdfs:range xsd:string ;
    rdfs:comment "Scales limits for the following resource usage limits: core, mem, stack, swp, tmp." .

hpc:Resourceusagelimit a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a resource usage limit." .

hpc:Jobexecutionmodel a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the default job execution model." .
