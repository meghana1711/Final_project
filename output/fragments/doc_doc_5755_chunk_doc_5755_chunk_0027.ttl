hpc:Slurmd a owl:Class .
hpc:SLURMD_OPTIONS a owl:ObjectProperty .

hpc:SlurmdMemlock rdf:type hpc:SLURMD_OPTIONS ;
    rdfs:label "Memlocks the slurmd process's memory" ;
    rdfs:domain hpc:Slurmd .

hpc:TestEnvironment a owl:Class .
hpc:CanRunInParallel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TestEnvironment ;
    rdfs:range xsd:Boolean .

hpc:TestSlurmSystem rdf:type hpc:TestEnvironment ;
    rdfs:label "Test Slurm system" .

hpc:AvoidConflicts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TestSlurmSystem ;
    rdfs:range xsd:Boolean .

hpc:Emulation rdf:type owl:ObjectProperty .
hpc:EmulateLargerCluster rdf:type hpc:Emulation ;
    rdfs:label "Emulate a larger cluster" .

hpc:PartitionNode rdf:type owl:ObjectProperty .
hpc:PartitionFatNode rdf:type hpc:PartitionNode ;
    rdfs:label "Partition 'fat' nodes into multiple Slurm nodes" .

hpc:EmulationMethod rdf:type owl:Class .
hpc:RunOneSlurmdDaemonPerEmulatedNode rdf:type hpc:EmulationMethod ;
    rdfs:label "Run one slurmd daemon per emulated node" .
```
