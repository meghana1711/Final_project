@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:freecpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:nnodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ncpuNode a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:nstaticCpusets a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:longFormat a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Longformat .

hpc:FreeCpuList rdfs:range xsd:string .

hpc:NfreecpusOnEachNode rdfs:range xsd:nonNegativeInteger .

hpc:StaticCpusets rdfs:domain hpc:Resource ;
    rdfs:range rdf:List .

hpc:cpuRadius a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range rdf:PlainLiteral .

hpc:CPU_RADIUS_0 rdfs:subPropertyOf hpc:CPU_RADIUS ;
    rdfs:range 2 .

hpc:CPU_RADIUS_1 rdfs:subPropertyOf hpc:CPU_RADIUS ;
    rdfs:range 3 .

hpc:Resource a owl:Class .
hpc:Longformat a owl:Class .
