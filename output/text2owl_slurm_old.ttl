hpc:Node a owl:Class .

hpc:hasTopology a owl:ObjectProperty .
hpc:hasSwitch a owl:ObjectProperty .
hpc:hasNodes a owl:ObjectProperty .
hpc:hasChildren a owl:ObjectProperty .
