hpc:Queue a owl:Class .
hpc:haspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:hasnice a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:hasfairshare a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Usershare .
hpc:hasfairsharequeues a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List .
hpc:Usershare a owl:Class ;
    rdfs:subClassOf rdf:List .
hpc:usershareMember a owl:ObjectProperty ;
    rdfs:domain hpc:Usershare ;
    rdfs:range hpc:User .
hpc:User a owl:Class .

hpc:Queue1 a hpc:Queue ;
    hpc:hasPriority 30 ;
    hpc:hasNice 20 ;
    hpc:hasFairShare (hpc:UserShare_Member hpc:user1 100) ;
    hpc:hasFairShareQueues (hpc:Queue2 hpc:Queue3) ;
    hpc:description "For normal low priority jobs, running only if hosts are lightly loaded." .
