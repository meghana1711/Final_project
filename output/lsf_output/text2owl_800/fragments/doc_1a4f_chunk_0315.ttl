hpc:Jobcontrols a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Set JOB_CONTROLS (or TERMINATE_WHEN) in the low-priority queues. Optional." .

hpc:resreq a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcontrols ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Set RES_REQ to automatically reserve the custom resource." .

hpc:Lsf a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Define the custom resource in the Resource section." .

hpc:Sharedresource a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Define the custom resource in the ResourceMap section." .

hpc:clustername a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:comment "Define how the custom resource is shared in the ResourceMap section." .

hpc:preempttableresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:comment "Set PREEMPTABLE_RESOURCES and specify the custom resource." .

hpc:preemptionwaittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer ;
    rdfs:comment "Set PREEMPTION_WAIT_TIME to specify how many seconds to wait for dynamic resources to become available." .

hpc:preemptjobtype a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:comment "Set PREEMPT_JOBTYPE to enable preemption of exclusive and backfill jobs." .

hpc:preemptresourcetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptjobtype ;
    rdfs:range xsd:string ;
    rdfs:comment "Specify one or both of the keywords EXCLUSIVE and BACKFILL." .

hpc:Preemptionconfig a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "View information about preemption configuration in your cluster." .

hpc:resourcereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionconfig ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Use resource reservation to reserve the preemption resource." .

hpc:Dynamicresource a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "For dynamic resources, you must specify a duration as well as a quantity." .
