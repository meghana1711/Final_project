hpc:MaxWallClockPerJob a owl:Class .
hpc:MaxJobsActiveAccount a owl:Class .
hpc:MaxJobsActiveUser a owl:Class .
hpc:PerAccount a owl:Class .
hpc:AccruingPerAccount a owl:Class .
hpc:AccruingPerUser a owl:Class .
hpc:MinPriorityThreshold a owl:Class .
hpc:Hold a owl:ObjectProperty .
hpc:Priority a owl:DatatypeProperty .
hpc:Required a owl:ObjectProperty .
hpc:Start a owl:DatatypeProperty .
hpc:AllowedAllocation a owl:DatatypeProperty .
hpc:Configured a owl:DatatypeProperty .
hpc:AllowedAccounts a owl:Class .
hpc:AllowedQOS a owl:Class .
hpc:Deny a owl:Class .
hpc:BillingWeights a owl:DatatypeProperty .
hpc:TaskBinding a owl:ObjectProperty .
hpc:MemoryPerCpu a owl:DatatypeProperty .
hpc:Time a owl:DatatypeProperty .
hpc:Maximums a owl:Class .
hpc:CpusPerNode a owl:DatatypeProperty .

hpc:MaxWallClockPerJob rdfs:subClassOf owl:Class .
hpc:MaxJobsActiveAccount rdfs:subClassOf hpc:Max .
hpc:MaxJobsActiveUser rdfs:subClassOf hpc:Max .
hpc:PerAccount rdfs:subClassOf owl:Class .
hpc:AccruingPerAccount rdfs:subClassOf hpc:Accruing .
hpc:AccruingPerUser rdfs:subClassOf hpc:Accruing .
hpc:MinPriorityThreshold rdfs:subClassOf owl:Class .
hpc:Hold rdfs:domain hpc:JobDescMsg ;
                               rdfs:range rdf:Statement .
hpc:Priority rdfs:domain hpc:JobDescMsg ;
                               rdfs:range xsd:double .
hpc:Required rdfs:domain hpc:JobDescMsg ;
                               rdfs:range rdf:List .
hpc:Start rdfs:domain hpc:CronEntry ;
                               rdfs:range xsd:string .
hpc:AllowedAllocation rdfs:domain hpc:PartitionInfo ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:Configured rdfs:domain hpc:PartitionInfo ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:AllowedAccounts rdfs:subClassOf owl:Class .
hpc:AllowedQOS rdfs:subClassOf owl:Class .
hpc:Deny rdfs:subClassOf owl:Class .
hpc:BillingWeights rdfs:domain hpc:PartitionInfo ;
                               rdfs:range xsd:nonNegativeInteger .
hpc:TaskBinding rdfs:domain hpc:PartitionInfo ;
                               rdfs:range xsd:string .
hpc:MemoryPerCpu rdfs:domain hpc:PartitionInfo ;
                               rdfs:range xsd:nonNegativeInteger .
hpc
