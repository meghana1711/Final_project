hpc:LsfSudoers a owl:Class .
hpc:haslocation a owl:ObjectProperty .
hpc:haspermissions a owl:DatatypeProperty .
hpc:issetuidenabled a owl:ObjectProperty .
hpc:LSF_sudoers_File rdf:type hpc:LSF_sudoers ;
    rdfs:subClassOf hpc:LsfFile ;
    rdfs:comment "One lsf.sudoers file per host." .
hpc:UNIX_LSF_sudoers a hpc:LSF_sudoers ;
    rdfs:subClassOf hpc:LsfSudoers ;
    hpc:hasLocation "http://example.org/hpc#/etc" ;
    rdfs:comment "On UNIX, this file is located in the directory specified by the LSF_SECUREDIR parameter in the lsf.conf file." .
hpc:Windows_LSF_sudoers a hpc:LSF_sudoers ;
    rdfs:subClassOf hpc:LsfSudoers ;
    hpc:hasLocation "http://example.org/hpc#%SYSTEMROOT%" ;
    rdfs:comment "On Windows, this file is shared over an NTFS network, not duplicated on every Windows host." .
hpc:lsfSudoersFilePermission a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfSudoersFile ;
    rdfs:range xsd:integer ;
    rdfs:comment "Permission for /etc/lsf.sudoers must be 600 and be readable and writable only by root." .
hpc:issetuidenabledFor a owl:ObjectProperty ;
    rdfs:domain hpc:LsfSudoersFile ;
    rdfs:range hpc:LsfExecutableFile ;
    rdfs:comment "Enables the setuid bit for the specified LSF executable files." .
hpc:LsfExecutableFile a owl:Class ;
    rdfs:subClassOf hpc:File ;
    rdfs:comment "Executable files for LSF administration commands." .
hpc:badmin rdf:type hpc:LSF_Executable_File ;
hpc:lsadmin rdf:type hpc:LSF_Executable_File ;
hpc:egosh rdf:type hpc:LSF_Executable_File ;
hpc:utmpreg rdf:type hpc:LSF_Executable_File ;
hpc:swtbl_api rdf:type hpc:LSF_Executable_File ;
hpc:ntbl_api rdf:type hpc:LSF_Executable_File ;
hpc:lstbl_nid rdf:type hpc:LSF_Executable_File ;
hpc:swtbl_poe rdf:type hpc:LSF_Executable_File .
hpc:badminReconfig a owl:ObjectProperty ;
    rdfs:domain hpc:LsfSudoersFile ;
    rdfs:range hpc:Action ;
    rdfs:comment "Run badmin reconﬁg to reload the conﬁguration files." .
hpc:Action a owl:Class .
``
