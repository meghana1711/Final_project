hpc:jobcontrolaction a owl:ObjectProperty .
hpc:SuspendAction rdf:type owl:ObjectProperty .
hpc:ResumeAction rdf:type owl:ObjectProperty .
hpc:TerminateAction rdf:type owl:ObjectProperty .

hpc:Jobstate a owl:Class .
hpc:RUN a hpc:JobState .
hpc:SSUSP a hpc:JobState .
hpc:USUSP a hpc:JobState .
hpc:PSUSP a hpc:JobState .
hpc:EXIT a hpc:JobState .

hpc:lsExecT a owl:DatatypeProperty .
hpc:LsExecT rdfs:domain hpc:Job .
hpc:LsExecT rdfs:range xsd:string .

hpc:JOB_CONTROLS a xsd:string .

hpc:SIGTSTP a xsd:string .
hpc:SIGSTOP a xsd:string .
hpc:LSB_SIGSTOP a xsd:string .

hpc:bstop a xsd:string .
hpc:bresume a xsd:string .
hpc:bkill a xsd:string .
hpc:brequeue a xsd:string .

hpc:Suspend rdfs:subClassOf hpc:Jobcontrolaction .
hpc:Resume rdfs:subClassOf hpc:Jobcontrolaction .
hpc:Terminate rdfs:subClassOf hpc:Jobcontrolaction .

hpc:suspendReason a owl:ObjectProperty .
hpc:resumeReason a owl:ObjectProperty .
hpc:terminateReason a owl:ObjectProperty .

hpc:SuspendReasonReasons rdfs:subClassOf hpc:SuspendReason .
hpc:ResumeReasonReasons rdfs:subClassOf hpc:ResumeReason .
hpc:TerminateReasonReasons rdfs:subClassOf hpc:TerminateReason .

hpc:SUSPEND_REASON_USER_COMMAND rdf:type hpc:SUSPEND_REASON_REASONS .
hpc:SUSPEND_REASON_LSF_COMMAND rdf:type hpc:SUSPEND_REASON_REASONS .
hpc:SUSPEND_REASON_LOAD_CONDITIONS rdf:type hpc:SUSPEND_REASON_REASONS .
hpc:SUSPEND_REASON_RUN_WINDOW rdf:type hpc:SUSPEND_REASON_REASONS .
hpc:SUSPEND_REASON_PREEMPTION rdf:type hpc:SUSPEND_REASON_REASONS .
hpc:RESUME_REASON_USER_COMMAND rdf:type hpc:RESUME_REASON_REASONS .
hpc:RESUME_REASON_LOAD_CONDITIONS rdf:type hpc:RESUME_REASON_REASONS .
