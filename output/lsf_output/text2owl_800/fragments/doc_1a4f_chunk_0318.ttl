hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Memorypreemption a owl:Class .
hpc:Memoryallocation a owl:Class .
hpc:Highpriorityjob a owl:Class .
hpc:Lowpriorityjob a owl:Class .

hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:isHostedOn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:hasMemoryPreemption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Memorypreemption .

hpc:hasMemoryAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Memoryallocation .

hpc:MemoryReservation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Job .

hpc:MemoryOccupation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MemorySwapping rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:MemorySwapSpace rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MemoryPreemptionEnabled rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Memorypreemption ;
    rdfs:range xsd:boolean .

hpc:MemoryExceeded rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Job .

hpc:PreemptionCalculation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionmodule ;
    rdfs:range xsd:nonNegativeInteger .
