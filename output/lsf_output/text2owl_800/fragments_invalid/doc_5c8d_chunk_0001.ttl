hpc:Script a owl:Class .
hpc:Hashadoopcommands hpc:Script rdfs:domain hpc:Script ;
 rdfs:range rdf:List .

hpc:Hadoopcommand a owl:Class ;
 rdfs:subClassOf hpc:Hashadoopcommands .

hpc:Hadoopcommandlist a owl:Class ;
 rdfs:subClassOf rdf:List .

hpc:Hadoopcommanditem a owl:Class ;
 rdfs:subClassOf hpc:Hadoopcommandlist .

hpc:Hashadoopcommand hpc:Script rdfs:domain hpc:Script ;
 rdfs:range hpc:Hadoopcommand .

hpc:Isexecutable hpc:Script rdfs:domain hpc:Script ;
 rdfs:range xsd:boolean .

hpc:Runwithlsf hpc:Script rdfs:domain hpc:Script ;
 rdfs:range rdf:Statement .

hpc:Lsfjob hpc:Runwithlsf rdfs:range .

hpc:Lsfjoballocation hpc:Lsfjob rdfs:domain hpc:Lsfjob ;
 rdfs:range xsd:boolean .

hpc:Lsfjobworkingdirectory hpc:Lsfjob rdfs:domain hpc:Lsfjob ;
 rdfs:range xsd:string .

hpc:Lsfjobdatafilesdirectory rdfs:domain hpc:Lsfjob ;
 rdfs:range xsd:string .

hpc:Lsfjobhadoopcommand hpc:Lsfjob rdfs:domain hpc:Lsfjob ;
 rdfs:range hpc:Hadoopcommand .

hpc:Hadoopcommandjar hpc:Hadoopcommand rdfs:domain hpc:Hadoopcommand ;
 rdfs:range xsd:string .

hpc:Hadoopcommandinput hpc:Hadoopcommand rdfs:domain hpc:Hadoopcommand ;
 rdfs:range xsd:string .

hpc:Hadoopcommandoutput hpc:Hadoopcommand rdfs:domain hpc:Hadoopcommand ;
 rdfs:range xsd:string .
