hpc:Job a owl:Class .
hpc:Jobname rdfs:domain hpc:Job .
hpc:Jobname rdfs:range xsd:string .
hpc:JobName rdfs:maxLength 4094 .

hpc:Jobnamecancontainwildcard rdfs:subClassOf hpc:Jobname .
hpc:JobNameCanContainWildcard rdfs:comment "The wildcard character (*) can be used anywhere within a job name, but it cannot appear within an array index." .

hpc:Jobnamepattern rdfs:subClassOf hpc:Jobnamecancontainwildcard .
hpc:JobNamePattern rdfs:comment "Pattern used to check for jobs with the specified name." .

hpc:Jobnamepatternwithwildcard rdfs:subClassOf hpc:Jobnamepattern .
hpc:JobNamePatternWithWildcard rdfs:comment "The wildcard character (*) can be used in the job name pattern." .

hpc:Arrayindexwildcard rdfs:subClassOf hpc:Jobname .
hpc:ArrayIndexWildcard rdfs:comment "The wildcard character (*) cannot appear within an array index." .

hpc:Jobcheckpointperiod rdfs:domain hpc:Job .
hpc:Jobcheckpointperiod rdfs:range xsd:nonNegativeInteger .

hpc:Periodiccheckpointing rdfs:subClassOf hpc:Job .
hpc:PeriodicCheckpointing rdfs:comment "Enables periodic checkpointing and specifies the checkpoint period." .

hpc:Checkpointperiodzero rdfs:subClassOf hpc:Periodiccheckpointing .
hpc:CheckpointPeriodZero rdfs:comment "Specify -p 0 (zero) to disable periodic checkpointing." .

hpc:Resourceintensiveoperation rdfs:subClassOf hpc:Checkpointperiodzero .
hpc:ResourceIntensiveOperation rdfs:comment "Checkpointing is a resource-intensive operation." .

hpc:Checkpointprogress rdfs:subClassOf hpc:Checkpointperiodzero .
hpc:CheckpointProgress rdfs:comment "For your job to make progress while still providing fault tolerance, specify a checkpoint period of 30 minutes or longer." .

hpc:Jobkill rdfs:subClassOf hpc:Job .
hpc:JobKill rdfs:comment "Kills a job after it is successfully checkpointed." .

hpc:Jobkillperiod rdfs:domain hpc:Jobkill .
hpc:Jobkillperiod rdfs:range xsd:nonNegativeInteger .

hpc:Checkpointedjob rdfs:subClassOf hpc:Job .
hpc:CheckpointedJob rdfs:comment "A job that has been checkpointed." .

