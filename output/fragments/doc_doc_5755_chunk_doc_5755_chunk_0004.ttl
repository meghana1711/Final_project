hpc:PatchFileGeneration a owl:Class .
hpc:generatePatchFile a owl:ObjectProperty ;
    rdfs:domain hpc:GitHubCommit ;
    rdfs:range hpc:PatchFile .

hpc:SlurmSource a owl:Class .

hpc:ApplyPatch a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSource ;
    rdfs:range hpc:SlurmSource .

hpc:SlurmUpdate a owl:Class .

hpc:RelocateController a owl:Class .
hpc:primaryController a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:backupController a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:SynchronizedClock a owl:Class .
hpc:maintainSynchronizedClocks a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:SlurmJobScheduling a owl:Class .
hpc:dryUpWorkload a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmJobScheduling .

hpc:SlurmUpgrade a owl:Class .

hpc:DatabaseServerUpgrade a owl:Class .

hpc:SlurmConfigurationCopy a owl:Class .
hpc:copySlurmClusterConfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConfigurationCopy ;
    rdfs:range hpc:SlurmCluster .

hpc:LostJob a owl:Class .
hpc:submittedBeforeSlurmCrash a owl:ObjectProperty ;
    rdfs:domain hpc:LostJob ;
    rdfs:range hpc:SlurmctldDaemonCrash .

hpc:HomogeneousCluster a owl:Class .
hpc:resourceLimitPropagationUseful a owl:ObjectProperty ;
    rdfs:domain hpc:HomogeneousCluster .

hpc:ResourceLimitEnforcement a owl:Class .
hpc:resourceLimitsNotEnforced a owl:ObjectProperty ;
    rdfs:domain rdfs:ResourceLimitEnforcement .

hpc:SlurmLicenceManagement a owl:Class .

hpc:SwitchFromPBSorTorqueToSlurm a owl:Class .

hpc:MPIPerformance a owl:Class .
hpc:belowExpectedLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:MPIPerformance ;
    rdfs:range xsd:decimal .

hpc:PartitionRemoval a owl:Class .
hpc:safelyRemovePartitions a owl:ObjectProperty ;
    rdfs:domain hpc:PartitionRemoval .
