hpc:Job a owl:Class .
hpc:Preemptablejob a owl:Class .
hpc:Nonpreemptablejob a owl:Class .

hpc:haspreemptionrestriction a owl:ObjectProperty .
hpc:Haspreemptionrestriction rdfs:domain hpc:Job .
hpc:Haspreemptionrestriction rdfs:range hpc:Preemptionrestriction .

hpc:MAX_JOB_PREEMPT a xsd:nonNegativeInteger .
hpc:PREEMPT_RESERVE a xsd:nonNegativeInteger .
hpc:LM_REMOVE_INTERVAL a xsd:duration .

hpc:currentcheckingservicedomain a owl:ObjectProperty .
hpc:Currentcheckingservicedomain rdfs:domain hpc:Job .
hpc:Currentcheckingservicedomain rdfs:range hpc:Servicedomain .

hpc:submittedwithtimeduration a owl:ObjectProperty .
hpc:Submittedwithtimeduration rdfs:domain hpc:Job .
hpc:Submittedwithtimeduration rdfs:range xsd:dateTime .

hpc:expiredTimeDuration a xsd:duration .

hpc:LS_ENABLE_MAX_PREEMPT a xsd:boolean .
hpc:LS_MAX_TASKMAN_PREEMPT a xsd:nonNegativeInteger .

hpc:Lsfjob a owl:Class .
hpc:Taskmanjob a owl:Class .

hpc:licensemanaged a owl:ObjectProperty .
hpc:Licensemanaged rdfs:domain hpc:License .
hpc:Licensemanaged rdfs:range hpc:Job .

hpc:ownership a owl:ObjectProperty .
hpc:Ownership rdfs:domain hpc:Project .
hpc:Ownership rdfs:range hpc:Job .

hpc:Licensescheduler a owl:Class .
hpc:Lsf a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Project a owl:Class .
hpc:Application a owl:Class .
hpc:License a owl:Class .
