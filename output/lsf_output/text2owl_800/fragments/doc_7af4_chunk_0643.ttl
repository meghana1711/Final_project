hpc:Lsf a owl:Class .
hpc:Erenewscript a owl:Class ;
    rdfs:subClassOf hpc:Lsf .

hpc:runs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Erenewscript .

hpc:runsaklog a owl:ObjectProperty ;
    rdfs:domain hpc:Erenewscript ;
    rdfs:range rdf:Literal .

hpc:assumesjobSpoolDirinafsvolume a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range rdf:Literal .

hpc:kerberizeschildsbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range rdf:Literal .

hpc:lsbAfsLibDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .

hpc:lsbAfsJobSupport a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Literal .

hpc:requireslibkopenafsso a owl:ObjectProperty ;
    rdfs:domain hpc:LsbAfsJobSupport ;
    rdfs:range rdf:Resource .

hpc:trieseachiteminlist a owl:ObjectProperty ;
    rdfs:domain hpc:LsbAfsLibDir ;
    rdfs:range rdf:Literal .

hpc:cannotbefound a owl:ObjectProperty ;
    rdfs:domain hpc:LsbAfsLibDir ;
    rdfs:range rdf:Resource .

hpc:searchesindirectories a owl:ObjectProperty ;
    rdfs:domain hpc:LsbAfsLibDir ;
    rdfs:range xsd:string .

hpc:Predefineddirectories a owl:Class ;
    rdfs:subClassOf hpc:Directory .

hpc:lsbApiConntimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .

hpc:bcommandswait a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource .

hpc:handshake a owl:ObjectProperty ;
    rdfs:domain hpc:Bcommandswait ;
    rdfs:range rdf:Resource .

hpc:actualcontentsrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Bcommandswait ;
    rdfs:range rdf:Resource .

hpc:lsbApiRecvtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Bcommandswait ;
    rdfs:range xsd:nonNegativeInteger .
