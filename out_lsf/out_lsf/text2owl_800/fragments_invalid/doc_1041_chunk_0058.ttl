hpc:Batchserverhost a owl:Class .
hpc:closesbatchserverhost a owl:ObjectProperty ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range rdf:Resource .

hpc:hasArgument rdf:DatatypeProperty ;
    rdfs:domain hpc:Closesbatchserverhost ;
    rdfs:range xsd:string .

hpc:localHost rdf:Resource .
hpc:all rdf:Literal .
hpc:Closedhost a owl:Class ;
    rdfs:subClassOf hpc:Batchserverhost .

hpc:jobAcceptance rdf:Property ;
    rdfs:domain hpc:Closedhost ;
    rdfs:range xsd:boolean .

hpc:alreadyClosed rdf:Property ;
    rdfs:domain hpc:Closesbatchserverhost ;
    rdfs:range xsd:boolean .

hpc:hostGroup rdf:Class ;
    rdfs:subClassOf hpc:Batchserverhost .

hpc:computeUnit rdf:Class ;
    rdfs:subClassOf hpc:Batchserverhost .

hpc:jobDispatched rdf:Property ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range xsd:boolean .

hpc:hostClosedByWindow rdf:Class ;
    rdfs:subClassOf hpc:Batchserverhost .

hpc:suspendedJob rdf:Property ;
    rdfs:domain hpc:Hostclosedbywindow ;
    rdfs:range xsd:boolean .

hpc:lsbEvents rdf:Resource .
hpc:administratorComment rdf:Property ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:range xsd:string ;
    rdfs:maxLength xsd:integer "512" .

hpc:hostGroupMember rdf:Property ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range rdf:Resource .

hpc:computeUnitMember rdf:Property ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range rdf:Resource .

hpc:cannotOpenBorrowedHost rdf:Property ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range xsd:boolean .

hpc:closed_RC rdf:Resource .

hpc:lockID rdf:DatatypeProperty ;
    rdfs:domain hpc:Closesbatchserverhost ;
    rdfs:range xsd:string ;
    rdfs:maxLength xsd:integer "128" ;
    owl:hasValue hpc:all rdfs:RejectedValue .
