hpc:User a owl:Class .
hpc:Jobsummaryinfo a owl:Class .
hpc:Jobdetailinfo a owl:Class .
hpc:hasjobinfo a owl:ObjectProperty .
hpc:Jobid rdfs:domain hpc:Jobsummaryinfo ;
                      rdfs:range xsd:string .
hpc:Jobguaranteepolicy a owl:Class .
hpc:simplifiedguarantee a owl:DatatypeProperty ;
                         rdfs:domain hpc:Jobguaranteepolicy ;
                         rdfs:range xsd:boolean .
hpc:Packagepool a owl:Class .
hpc:Slotpool a owl:Class .
hpc:Packagesize rdfs:domain PackagePool ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Hostpool a owl:Class .
hpc:Ownerhost a owl:Class .
hpc:Sharedhost a owl:Class .
hpc:preemption a owl:ObjectProperty .
hpc:Preemptiontype rdfs:domain hpc:Preemption ;
                     rdfs:range xsd:string .
hpc:queuebasedpreemption a owl:ObjectProperty .
hpc:Borrowedresource rdfs:domain hpc:Jobsummaryinfo ;
                         rdfs:range hpc:Resource .
hpc:Loaningusage rdfs:domain hpc:Jobsummaryinfo ;
                     rdfs:range xsd:nonNegativeInteger .
