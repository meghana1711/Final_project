hpc:LsbMailserver a owl:Class.
hpc:Emailsizelimit a owl:Class.

# Object Properties
hpc:hasmailserverprotocol a owl:ObjectProperty.
hpc:hasmailserverhost a owl:ObjectProperty.
hpc:hasmailsizelimit a owl:ObjectProperty.

# Datatype Properties
hpc:mailServerProtocol rdf:type owl:DatatypeProperty.
hpc:mailServerHost rdf:type owl:DatatypeProperty.
hpc:emailSizeLimit rdf:type owl:DatatypeProperty.

# Domain and Range
hpc:Hasmailserverprotocol rdfs:domain hpc:LsbMailserver.
hpc:Mailserverprotocol rdfs:range xsd:string.
hpc:Hasmailserverhost rdfs:domain hpc:LsbMailserver.
hpc:Mailserverhost rdfs:range xsd:string.
hpc:Hasmailsizelimit rdfs:domain hpc:Emailsizelimit.
hpc:Emailsizelimit rdfs:range xsd:positiveInteger.

# Subclass
hpc:Exchangemailserver a rdfs:subClassOf hpc:LsbMailserver.
hpc:ExchangeMailServer rdf:type hpc:LSB_MAILSERVER.
hpc:Exchangemailserver hpc:mailserverprotocol "EXCHANGE:".

# LSB_MAILSERVER
hpc:LSB_MAILSERVER_UNIX a hpc:LSB_MAILSERVER.
hpc:LSB_MAILSERVER_UNIX rdf:type hpc:LSB_MAILSERVER.
hpc:LsbMailserverUnix hpc:hasmailserverprotocol "SMTP"^^xsd:string.
hpc:LsbMailserverUnix hpc:hasmailserverhost ?unixHost.

hpc:LSB_MAILSERVER_WINDOWS a hpc:LSB_MAILSERVER.
hpc:LSB_MAILSERVER_WINDOWS rdf:type hpc:LSB_MAILSERVER.
hpc:LsbMailserverWindows hpc:hasmailserverprotocol ?protocol.
hpc:LsbMailserverWindows hpc:hasmailserverhost ?host.

# Email Size Limit
hpc:DefaultEmailSizeLimit a hpc:EmailSizeLimit.
hpc:DefaultEmailSizeLimit rdf:type hpc:EmailSizeLimit.
hpc:Defaultemailsizelimit hpc:emailsizelimit "0"^^xsd:positiveInteger.

hpc:CustomEmailSizeLimit a hpc:EmailSizeLimit.
hpc:CustomEmailSizeLimit rdf:type hpc:EmailSizeLimit.
hpc:Customemailsizelimit hpc:emailsizelimit ?size.
