hpc:Resourcerequirement a owl:Class .
hpc:selectionstring a owl:ObjectProperty .
hpc:ResourceName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
hpc:LogicalExpression rdf:type owl:Class ;
    rdfs:subClassOf hpc:Selectionstring .
hpc:ArithmeticOperator rdf:type owl:Class ;
    rdfs:subClassOf hpc:Logicalexpression .
hpc:BooleanResource rdf:type owl:Class ;
    rdfs:subClassOf hpc:Resourcename .
hpc:CPUUtilization rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:float .
hpc:Type rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .
hpc:Local rdf:type owl:NamedIndividual ;
    hpc:Type "local" .
hpc:Any rdf:type owl:NamedIndividual ;
    hpc:Type "any" .
