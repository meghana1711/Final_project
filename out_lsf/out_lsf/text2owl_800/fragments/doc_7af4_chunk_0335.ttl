hpc:maxNumJobsKillOverRunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer ;
    rdfs:comment "Sets the maximum number of jobs that can be killed by the KILL_JOBS_OVER_RUNLIMIT parameter in one cycle." .

hpc:killJobsOverRunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Lsfparameter ;
    rdfs:comment "Related reference" .

hpc:maxPendJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of pending jobs in the cluster. This is the hard system-wide pending job threshold." .

hpc:subTryInterval a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Lsfparameter ;
    rdfs:comment "See also" .

hpc:MaxPendJobsRejected a owl:Class ;
    rdfs:subClassOf hpc:Jobstatus ;
    rdfs:comment "A job that has been rejected due to exceeding the MAX_PEND_JOBS limit." .

hpc:maxPendJobsRejectedByUser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User ;
    rdfs:comment "The user whose job was rejected due to exceeding the MAX_PEND_JOBS limit." .

hpc:maxPendSlots a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of pending job slots available in the system. This is the hard system-wide pending slots threshold." .
