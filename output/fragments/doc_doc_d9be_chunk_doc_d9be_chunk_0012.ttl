hpc:Job a owl:Class .
hpc:RequiresCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:HasTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Task .

hpc:HasCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger .

hpc:HasCPUsPerTask rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NoOvercommitment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task .

hpc:RunOnNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Partition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:AllocationMethod rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:DistributionMethod rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:CPUBinding rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:NodeName a owl:Class .
hpc:SocketId a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeName ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NumberOfAllocatedCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeName ;
    rdfs:range xsd:nonNegativeInteger .

hpc:AllocatedCPUIds a owl:DatatypeProperty ;
    rdfs:domain hpc:NodeName ;
    rdfs:range xsd:string .

hpc:BindingOfTasksToCPUs a owl:ObjectProperty ;
    rdfs:domain hpc:NodeName ;
    rdfs:range hpc:CPU .

hpc:CPU a owl:Class .
hpc:Id a owl:DatatypeProperty ;
    rdfs:domain hpc:CPU ;
    rdfs:range xsd:nonNegativeInteger .

hpc:TaskId a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
```
