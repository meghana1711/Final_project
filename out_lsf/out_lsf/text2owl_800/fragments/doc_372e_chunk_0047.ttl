hpc:groupName a owl:DatatypeProperty ;
    rdfs:domain hpc:Featuregroup ;
    rdfs:range xsd:string .

hpc:featureList a owl:ObjectProperty ;
    rdfs:domain hpc:Featuregroup ;
    rdfs:range rdf:List .

hpc:Feature a owl:Class .

hpc:Corporate a hpc:FeatureGroup ;
    hpc:Group_Name "Corporate" ;
    hpc:Feature_List (hpc:ASTRO hpc:VCS_Runtime_Net hpc:Hsim hpc:Hspice) .

hpc:Offsite a hpc:FeatureGroup ;
    hpc:Group_Name "Offsite" ;
    hpc:Feature_List (hpc:Encounter hpc:NCSim hpc:NCVerilog) .

hpc:blinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:PlainLiteral .

hpc:blstat a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:PlainLiteral .
