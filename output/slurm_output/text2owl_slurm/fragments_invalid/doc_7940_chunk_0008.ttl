hpc:Job a owl:Class.
hpc:Originjob a owl:Class.
hpc:Siblingjob a owl:Class.
hpc:originclusterid a owl:DatatypeProperty;
    rdfs:domain hpc:Originjob;
    rdfs:range xsd:string.
hpc:localjobid a owl:DatatypeProperty;
    rdfs:domain hpc:Originjob;
    rdfs:range xsd:nonNegativeInteger.
hpc:Cluster a owl:Class.
hpc:associatedcluster a owl:ObjectProperty;
    rdfs:domain hpc:Siblingjob;
    rdfs:range hpc:Cluster.
hpc:communicationsroutedthrough a owl:ObjectProperty;
    rdfs:domain hpc:Originjob;
    rdfs:range hpc:Origincluster.
hpc:Revokedstate a owl:Class;
    rdfs:subClassOf hpc:Stateofthecluster;
    rdfs:domain hpc:Originjob.
hpc:Viablesibling a owl:Class;
    rdfs:domain hpc:Sibling
