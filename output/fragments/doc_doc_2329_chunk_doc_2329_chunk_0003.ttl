hpc:Slurm a owl:Class .
hpc:PMIx a owl:Class .
hpc:Version a owl:Class .
hpc:SupportsPMIx hpc:Slurm rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range rdf:List .
hpc:SupportsVersion hpc:Slurm hpc:Version ;
    rdfs:domain hpc:Slurm ;
    rdfs:range rdf:List .
hpc:VersionNumber rdf:type xsd:integer .
hpc:MinimumVersion hpc:PMIx hpc:VersionNumber ;
    rdfs:domain hpc:PMIx ;
    rdfs:range xsd:integer .
hpc:CompatibilityIssues hpc:PMIx hpc:Version ;
    rdfs:domain hpc:PMIx ;
    rdfs:range rdf:List .
hpc:OfficiallySupportedBy hpc:IntelMPI hpc:PMIx a rdf:Boolean ;
    rdfs:domain hpc:PMIx ;
    rdfs:range rdf:Boolean .
hpc:InstallationLocation hpc:PMIx hpc:String ;
    rdfs:domain hpc:PMIx ;
    rdfs:range xsd:string .
hpc:BuiltWithPMIx hpc:Slurm a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range rdf:Boolean .
hpc:PMIxLibrary hpc:Slurm hpc:File ;
    rdfs:domain hpc:Slurm ;
    rdfs:range rdf:Resource .
hpc:Conflict hpc:PMIxLibrary hpc:PMIxLibrary ;
