hpc:Tshirtsize a owl:Class .
hpc:supports a owl:ObjectProperty ;
    rdfs:domain hpc:Tshirtsize ;
    rdfs:range xsd:string .

hpc:Small a owl:Class ;
    rdfs:subClassOf hpc:Tshirtsize ;
    hpc:vCPUs xsd:int "2" ;
    hpc:RAM xsd:int "8" .

hpc:Medium a owl:Class ;
    rdfs:subClassOf hpc:Tshirtsize ;
    hpc:vCPUs xsd:int "4" ;
    hpc:RAM xsd:int "16" .

hpc:Large a owl:Class ;
    rdfs:subClassOf hpc:Tshirtsize ;
    hpc:vCPUs xsd:int "8" ;
    hpc:RAM xsd:int "32" .

hpc:Extralarge a owl:Class ;
    rdfs:subClassOf hpc:Tshirtsize ;
    hpc:vCPUs xsd:int "16" ;
    hpc:RAM xsd:int "64" .

hpc:Esubscript a owl:Class .
hpc:download a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .

hpc:customize a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .

hpc:lsfpredictorrestapi a owl:ObjectProperty .

hpc:organizedata a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .

hpc:callapi a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .

hpc:replacememory a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .

hpc:replaceruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Esubscript .
