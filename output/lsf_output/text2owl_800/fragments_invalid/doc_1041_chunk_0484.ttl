hpc:Hostspec a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Release the number of tasks that are specified by positive_integer on the host that is specified by host_name. If the number of tasks is not specified, all tasks on the specified host are released." .

hpc:HostName rdfs:domain hpc:Hostspec ;
    rdfs:range xsd:string .

hpc:PositiveInteger rdfs:domain hpc:Hostspec ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Excludehostspec a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies hosts to exclude when you release tasks. Tasks on the specified hosts are not released. The tilde (not) operator (~) must be used together with all keyword." .

hpc:~ a owl:ObjectProperty ;
    rdfs:domain hpc:Excludehostspec ;
    rdfs:range hpc:Hostspec ;
    rdfs:comment "The tilde (not) operator (~) must be used together with all keyword." .

hpc:minTask a owl:DatatypeProperty ;
    rdfs:domain ?JobResizingCommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Optional. The minimum number of tasks to be added to the job. LSF pends the manual job resize request if the queue cannot meet the minimum tasks request." .

hpc:task a owl:ObjectProperty ;
    rdfs:domain ?JobResizingCommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Required for the request subcommand. The maximum number of tasks to be added to the job." .

hpc:jobId a owl:DatatypeProperty ;
    rdfs:domain ?JobResizingCommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Required. The job ID of the job to be resized. For job arrays, this also includes the array index." .
