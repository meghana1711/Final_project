hpc:LmType a owl:Class .
hpc:LmType rdfs:subClassOf owl:Enum .
hpc:LmType rdfs:range xsd:string .

hpc:Flexlm a owl:Class .
hpc:Rlm a owl:Class .

hpc:LmTypeFlexlm hpc:lmType rdf:value "FLEXLM" .
hpc:LmTypeRlm hpc:lmType rdf:value "RLM" .

hpc:Hasdefault hpc:lmType rdf:value "FLEXLM" .

hpc:lmTypeHasdescription a owl:ObjectProperty .
hpc:LmTypeHasdescription rdfs:domain hpc:LmType .
hpc:LmTypeHasdescription rdfs:range rdfs:Literal .

hpc:definesLmType a owl:ObjectProperty .
hpc:DefinesLmType rdfs:domain rdf:Resource .
hpc:DefinesLmType rdfs:range hpc:LmType .

hpc:LM_TYPE_isIgnored a owl:FunctionalProperty .
hpc:LmTypeIsignored rdfs:domain rdf:Property .
hpc:LmTypeIsignored rdfs:range xsd:boolean .

hpc:LM_TYPE_requires_LIC_SERVERS a owl:FunctionalProperty .
hpc:LmTypeRequiresLicServers rdfs:domain hpc:LmType .
hpc:LmTypeRequiresLicServers rdfs:range xsd:boolean .

hpc:LicServers a owl:Class .
hpc:LicServers rdfs:subClassOf owl:Object .
hpc:LicServers rdfs:range rdf:List .

hpc:licServersHasportnumber a owl:ObjectProperty .
hpc:LicServersHasportnumber rdfs:domain hpc:LicServers .
hpc:LicServersHasportnumber rdfs:range xsd:integer .

hpc:licServersHashostname a owl:ObjectProperty .
hpc:LicServersHashostname rdfs:domain hpc:LicServers .
hpc:LicServersHashostname rdfs:range xsd:string .

hpc:RemoteLmstatServers a owl:Class .
hpc:RemoteLmstatServers rdfs:subClassOf owl:Object .
hpc:RemoteLmstatServers rdfs:range rdf:List .

hpc:remoteLmstatServersHashostname a owl:ObjectProperty .
hpc:RemoteLmstatServersHashostname rdfs:domain hpc:RemoteLmstatServers .
hpc:RemoteLmstatServersHashostname rdfs:range xsd:string .
