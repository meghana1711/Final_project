@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class.
hpc:Command a owl:Class.
hpc:Jobslot a owl:Class.
hpc:Host a owl:Class.
hpc:Queue a owl:Class.

hpc:hascommand a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Command.

hpc:hasjobslot a owl:ObjectProperty;
    rdfs:domain hpc:Host;
    rdfs:range hpc:Jobslot.

hpc:isinqueue a owl:ObjectProperty;
    rdfs:domain hpc:Job;
