hpc:Licensecollector a owl:Class .
hpc:Remoteagenthost a owl:Class .
hpc:connectionmethod a owl:ObjectProperty .
hpc:remotelmstatprotocol a owl:DatatypeProperty .

hpc:Licensecollector rdfs:subClassOf owl:Class .
hpc:Remoteagenthost rdfs:subClassOf owl:Class .
hpc:Connectionmethod rdfs:domain hpc:Licensecollector ;
                          rdfs:range xsd:string .
hpc:Remotelmstatprotocol rdfs:domain hpc:Licensecollector ;
                          rdfs:range xsd:string .
