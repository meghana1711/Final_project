hpc:User a owl:Class .
hpc:Wckey a owl:Class .
hpc:adduser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range rdf:Statement ;
    rdfs:range hpc:Wckey .
hpc:removeuser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range rdf:Statement ;
    rdfs:range hpc:Wckey .
hpc:moduser a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range rdf:Statement ;
    rdfs:range hpc:Wckey ;
    rdfs:range xsd:string .
hpc:defaultwckey a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:Sacctmgr a owl:Class .
hpc:Sreport a owl:Class .
