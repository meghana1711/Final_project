hpc:Interactive a owl:Class .
hpc:fromhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:firsthost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Exechost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "All execution hosts for the job." .
hpc:nextexechost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Exechost .
hpc:numexechosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:askhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:allocslot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:ExecHost .
hpc:nallocslot a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:hostfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:exclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
