hpc:Daemon a owl:Class .
hpc:loglevel a owl:DatatypeProperty .
hpc:daemonruns a owl:ObjectProperty .
hpc:logfile a owl:DatatypeProperty .
hpc:LogLevelDomain a rdfs:Class .
hpc:LogLevelRange xsd:nonNegativeInteger .
hpc:Logclass a owl:Class .
hpc:LogClassDomain a rdfs:Class .
hpc:LogClassRange rdfs:Class .
hpc:DaemonLogLevel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Loglevel .
hpc:DaemonLogFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Daemon .
hpc:LogClassLogLevel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Logclass ;
    rdfs:range hpc:Loglevel .
hpc:BLD a hpc:Daemon .
hpc:BLCollect a hpc:Daemon .
hpc:LS_LOG_MASK rdf:type xsd:nonNegativeInteger .
hpc:LSF_LOGDIR rdf:type xsd:string .
hpc:bladmin blddebug a owl:ObjectProperty ;
    rdfs:comment "Temporarily change the log level for the bld daemon." .
hpc:bladmin blddebug rdfs:subPropertyOf hpc:DaemonLogLevel .
hpc:Bladmin blddebug rdfs:domain hpc:Bld .
hpc:bladmin blcdebug a owl:ObjectProperty ;
    rdfs:comment "Temporarily change the log level for the blcollect daemon." .
hpc:bladmin blcdebug rdfs:subPropertyOf hpc:DaemonLogLevel .
hpc:Bladmin blcdebug rdfs:domain hpc:Blcollect .
hpc:all a hpc:BLCollect .
hpc:setdebugsettingstoconfiguredvalues a owl:ObjectProperty ;
    rdfs:comment "Return the debug settings to their configured values (set with LS_LOG_MASK in lsf.licensescheduler)." .
