@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Slurmplugin a owl:Class.

hpc:hasinitfunction a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmplugin ;
    rdfs:range xsd:string .

hpc:hasfinifunction a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmplugin ;
    rdfs:range xsd:string .

hpc:threadsafety a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmplugin ;
    rdfs:range xsd:boolean .

hpc:runtimesupport a owl:DatatypeProperty ;
    rdfs
