hpc:Mbatchd a owl:Class .
hpc:Bld a owl:Class .

hpc:hasconnection a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Bld .

hpc:gettokendistributiondecisions a owl:ObjectProperty ;
    rdfs:domain hpc:Bld ;
    rdfs:range hpc:Mbatchd .

hpc:Offlinebld a owl:Class ;
    rdfs:subClassOf hpc:Bld .

hpc:OfflineBLD rdf:value xsd:boolean ;
    rdfs:range xsd:boolean .

hpc:losesconnection a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range hpc:Offlinebld .
