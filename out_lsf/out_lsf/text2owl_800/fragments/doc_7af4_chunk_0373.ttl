hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Exitstatus a owl:Class .
hpc:runlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:hostunavail a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:waittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:remoteMaxPreexecRetry a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:reschedUponCsmSetupError a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:List a owl:Class ;
    rdfs:subClassOf owl:Collection .
hpc:listmember a owl:ObjectProperty ;
    rdfs:domain hpc:List ;
    rdfs:range hpc:Error .
hpc:Error a owl:Class .
