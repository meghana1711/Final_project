hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:Queue a owl:Class .

hpc:hasresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Resourcerequirement .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:hasresourcerequirementatjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirement .

hpc:iscandidatehost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Externalhostgroup a owl:Class .
