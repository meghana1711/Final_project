hpc:Gpuresource a owl:Class .
hpc:Ssh a owl:Class .
hpc:x11forwarding a owl:ObjectProperty .
hpc:Xserver a owl:Class .
hpc:Lsfhost a owl:Class .
hpc:Displayhost a owl:Class .
hpc:Executionhost a owl:Class .
hpc:Clientdesktop a owl:Class .
hpc:Submissionhost a owl:Class .

hpc:Gpuresource rdfs:subClassOf owl:Class .
hpc:Ssh rdfs:subClassOf owl:Class .
hpc:X11forwarding rdfs:domain hpc:Ssh ;
    rdfs:range rdf:List .
hpc:Xserver rdfs:subClassOf owl:Class .
hpc:Lsfhost rdfs:subClassOf owl:Class .
hpc:Displayhost rdfs:subClassOf hpc:Lsfhost .
hpc:Executionhost rdfs:subClassOf hpc:Lsfhost .
hpc:Clientdesktop rdfs:subClassOf owl:Class .
hpc:Submissionhost rdfs:subClassOf hpc:Lsfhost .

hpc:hasGPUResource owl:ObjectProperty .
hpc:hasX11Forwarding owl:ObjectProperty .
hpc:hasXServer owl:ObjectProperty .
hpc:isConnectedTo rdf:Property .
hpc:isConfiguredForX11Forwarding owl:ObjectProperty .
hpc:worksWithX11Forwarding owl:ObjectProperty .
hpc:doesNotAttemptToSetDISPLAYEnvironment owl:ObjectProperty .

hpc:Hasgpuresource rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Gpuresource .
hpc:Hasx11forwarding rdfs:domain hpc:Ssh ;
    rdfs:range rdf:List .
hpc:Hasxserver rdfs:domain hpc:Clientdesktop ;
    rdfs:range hpc:Xserver .
hpc:Isconnectedto rdfs:domain hpc:Lsfhost ;
    rdfs:range hpc:Displayhost .
hpc:Isconfiguredforx11forwarding rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:boolean .
hpc:Workswithx11forwarding rdfs:domain hpc:Ssh ;
    rdfs:range xsd:boolean .
hpc:Doesnotattempttosetdisplayenvironment rdfs:domain hpc:User ;
    rdfs:range xsd:boolean .
