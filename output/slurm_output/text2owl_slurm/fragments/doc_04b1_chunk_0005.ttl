hpc:Jobwritelock a owl:Class .
hpc:Schedulerparameters a owl:Class .
hpc:batchscheddelay a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparameters ;
    rdfs:range xsd:nonNegativeInteger .
hpc:defer a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerparameters .
hpc:deferBatch a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerparameters .
hpc:schedMinInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerparameters ;
    rdfs:range xsd:nonNegativeInteger .
