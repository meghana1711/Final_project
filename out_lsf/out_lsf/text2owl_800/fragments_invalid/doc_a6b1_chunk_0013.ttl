hpc:Lsf a owl:Class .
hpc:LsfEvents hpc:lsf rdf:subClassOf owl:Class .
hpc:LSF_events_current a hpc:LSF_events ;
    rdfs:comment "The current lsb.events file." ;
    rdfs:label "Current LSF Events" .

hpc:LsfEventsBackup hpc:lsfEvents ;
    rdfs:comment "A duplicate copy of lsb.events used for backup." ;
    rdfs:label "LSF Events Backup" .

hpc:LsfEventsArchive hpc:lsfEvents ;
    rdfs:comment "Old lsb.events files that are archived or removed periodically." ;
    rdfs:label "Archived LSF Events" .

hpc:MoveEvents hpc:objectproperty ;
    rdfs:domain hpc:LsfEvents ;
    rdfs:range hpc:LsfEvents .

hpc:DuplicateLogging hpc:objectproperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:LsfEventsBackup .

hpc:PrimaryStorage rdfs:domain hpc:LsfEventsBackup ;
    rdfs:range hpc:Fileserver .

hpc:ManagementHost rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Host .

hpc:ReliableFileServer rdfs:subClassOf hpc:Fileserver ;
    rdfs:comment "A file server that contains critical applications necessary for running jobs." .

hpc:critical_applications rdfs:DatatypeProperty ;
    rdfs:domain hpc:Fileserver ;
    rdfs:range xsd:string .
