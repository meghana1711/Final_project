hpc:Perfmon a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Run the badmin perfmon view command to determine the average value." .

hpc:maxschedulingcycletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum value for the maximum scheduling cycle time." .

hpc:maxSbdConns a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of open file connections between mbatchd and sbatchd." .

hpc:lsbMaxJobDispatchPerSession a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of jobs that LSF can dispatch per session." .

hpc:jobDispatchPackSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The size of the job dispatch pack." .

hpc:jobSchedulingInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The interval at which jobs are scheduled." .

hpc:lsfAcceptNumclients a owl:DatatypeProperty ;
    rdfs:domain hpc:Perfmon ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of new client connections to the mbatchd port that mbatchd accepts during each scheduling cycle." .
