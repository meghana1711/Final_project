hpc:LSF_CLEARCASE_WRAPPER_RETRY
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonwrapper ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LSF_CLEARCASE_WRAPPER_RETRY_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonwrapper ;
    rdfs:range xsd:nonNegativeInteger .

# Debugging ClearCase Issues

hpc:DAEMON_WRAP_DEBUG
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:boolean .

# ClearCase Logging

hpc:DaemonWrapper
    a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:subClassOf hpc:Processwrapper ;
    rdfs:subClassOf hpc:Wrapper .

hpc:DaemonWrapper_logs_ClearCase_stdout_stderr
    a owl:ObjectProperty ;
    rdfs:domain hpc:Daemonwrapper ;
    rdfs:range hpc:Logfile .

hpc:DaemonWrapper_has_log_file
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Daemonwrapper ;
    rdfs:range xsd:string .

# LSF Job Submission

hpc:LSF_DAEMON_WRAP
    a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range hpc:Daemonwrapper .

hpc:LSF_integration_for_ClearCase
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Configuration .
