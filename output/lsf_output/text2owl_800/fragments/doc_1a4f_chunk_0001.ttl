hpc:Remotetask a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "A task that runs on a remote host using standard UNIX system calls." .

hpc:filesharing a owl:ObjectProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The file sharing mechanism used by the remote task, such as NFS or AFS." .

hpc:fileaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The location where the task's files are available on the cluster." .

hpc:Tmpdirectory a owl:Class ;
    rdfs:subClassOf hpc:Fileaccess ;
    rdfs:comment "The /tmp directory on each host, usually private." .

hpc:localfileaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The access to files on the same remote host where they were copied." .

hpc:lsffilecopy a owl:ObjectProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The use of lsrcp command to copy files across LSF hosts." .

hpc:shellmode a owl:ObjectProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range hpc:Shellmode ;
    rdfs:comment "The use of shell mode for running interactive applications." .

hpc:Shellmodesupport a owl:Class ;
    rdfs:subClassOf hpc:Remotetask ;
    rdfs:comment "A remote task that uses shell mode support." .

hpc:Unixshellmode a owl:Class ;
    rdfs:subClassOf hpc:Shellmodesupport ;
    rdfs:comment "Shell mode support provided for running interactive applications on UNIX." .

hpc:Windowsshellmode a owl:Class ;
    rdfs:subClassOf hpc:Shellmodesupport ;
    rdfs:comment "Not supported for Windows." .

hpc:Interactiveshell a owl:Class ;
    rdfs:subClassOf hpc:Remotetask ;
    rdfs:comment "An interactive shell or application." .

hpc:Keyredefinition a owl:Class ;
    rdfs:subClassOf hpc:Interactiveshell ;
    rdfs:comment "An interactive shell or application that redefines CTRL-C and CTRL-Z keys." .

hpc:lsrunoption a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotetask ;
    rdfs:range xsd:string ;
    rdfs:comment "The -S option of lsrun, ch or lsgrun." .
