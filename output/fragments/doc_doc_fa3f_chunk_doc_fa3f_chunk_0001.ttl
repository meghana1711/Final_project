hpc:Job a owl:Class .
hpc:BaseState a owl:Class .
hpc:StateFlag a owl:Class .

hpc:hasBaseState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:BaseState .

hpc:hasStateFlag rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:StateFlag .

hpc:isDisplayedAs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BaseState ;
    rdfs:range xsd:string .

hpc:isCodeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:BaseState ;
    rdfs:range xsd:string .

hpc:isUserFacingName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:StateFlag ;
    rdfs:range xsd:string .

hpc:isCodeNameStartsWithJOB_ rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:StateFlag ;
    rdfs:range xsd:string .
```
