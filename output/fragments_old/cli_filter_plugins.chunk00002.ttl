hpc:CLI_Filter a owl:Class .
hpc:CLI_Filter_P_Pre_Submit hpc:CLI_Filter subClassOf owl:FunctionalRole .
hpc:CLI_Filter_P_Post_Submit hpc:CLI_Filter subClassOf owl:FunctionalRole .

hpc:hasOffset a owl:ObjectProperty ;
    rdfs:domain hpc:CLI_Filter_P_Post_Submit ;
    rdfs:range xsd:integer .

hpc:hasJobID a owl:ObjectProperty ;
    rdfs:domain hpc:CLI_Filter_P_Post_Submit ;
    rdfs:range xsd:unsignedInt .

hpc:hasStepID a owl:ObjectProperty ;
    rdfs:domain hpc:CLI_Filter_P_Post_Submit ;
    rdfs:range xsd:unsignedInt .

hpc:Job hpc:JobID a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:Step hpc:StepID a owl:DatatypeProperty ;
    rdfs:domain hpc:Step .
