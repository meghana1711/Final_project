@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Subcommand a owl:Class .
hpc:hostName a owl:ObjectProperty .
hpc:timingLevel a owl:DatatypeProperty .
hpc:logfileName a owl:DatatypeProperty .
hpc:debugLevel a owl:DatatypeProperty .
hpc:logQueueSize a owl:DatatypeProperty .
hpc:className a owl:ObjectProperty .
hpc:Sbdtime a owl:Class .
hpc:Schdtime a owl:Class .
hpc:SecurityView a owl:Class .
hpc:Showconf a owl:Class .
hpc:Showstatus a owl:Class .

hpc:Subcommand rdfs:subClassOf owl:Class .
hpc:Sbdtime rdfs:subClassOf hpc:Subcommand .
hpc:Schdtime rdfs:subClassOf hpc:Subcommand .
hpc:SecurityView rdfs:subClassOf hpc:Subcommand .
hpc:Showconf rdfs:subClassOf hpc:Subcommand .
hpc:Showstatus rdfs:subClassOf hpc:Subcommand .

hpc:Sbdtime rdfs:domain hpc:Subcommand .
hpc:Schdtime rdfs:domain hpc:Subcommand .
hpc:SecurityView rdfs:domain hpc:Subcommand .
hpc:Showconf rdfs:domain hpc:Subcommand .
hpc:Showstatus rdfs:domain hpc:Subcommand .

hpc:Sbdtime rdfs:range hpc:HostName .
hpc:Sbdtime rdfs:range hpc:ClassName .
hpc:Schdtime rdfs:range hpc:TimingLevel .
hpc:Schdtime rdfs:range hpc:LogfileName .
hpc:SecurityView rdfs:range hpc:View .
hpc:Showconf rdfs:range hpc:View .
hpc:Showstatus rdfs:range rdf:nil .

hpc:View rdfs:domain hpc:SecurityView .
hpc:View rdfs:range xsd:boolean .

hpc:TimingLevel rdfs:range xsd:nonNegativeInteger .
hpc:LogfileName rdfs:range xsd:string .
hpc:DebugLevel rdfs:range xsd:nonNegativeInteger .
hpc:LogQueueSize rdfs:range xsd:nonNegativeInteger .
