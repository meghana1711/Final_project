hpc:License a owl:Class .
hpc:License hasLicenseCount xsd:integer .
hpc:License hasFlags xsd:string .
hpc:License hasCluster rdf:Resource .
hpc:License hasAllowed xsd:integer .
hpc:License hasLastConsumed xsd:integer .
hpc:License hasLastDeficit xsd:integer .
hpc:License hasLastUpdate rdf:Datatype .

hpc:Cluster a owl:Class .
hpc:Cluster hasName xsd:string .
hpc:Cluster hasTotal xsd:integer .
hpc:Cluster hasUsed xsd:integer .
hpc:Cluster hasFree xsd:integer .
hpc:Cluster hasReserved xsd:integer .
hpc:Cluster hasRemote xsd:boolean .
hpc:Cluster hasLastConsumed xsd:integer .
hpc:Cluster hasLastDeficit xsd:integer .
hpc:Cluster hasLastUpdate rdf:Datatype .

hpc:Resource a owl:Class .
hpc:Resource hasName xsd:string .
hpc:Resource hasServer rdf:Resource .
hpc:Resource hasDescription xsd:string .
hpc:Resource hasCount xsd:integer .
hpc:Resource hasFlags xsd:string .
hpc:Resource hasType xsd:string .

hpc:updateResource a owl:ObjectProperty .
hpc:updateResource rdfs:domain hpc:Resource .
hpc:updateResource rdfs:range rdf:Resource .

hpc:sacctmgr a owl:ObjectProperty .
hpc:sacctmgr rdfs:domain hpc:License .
hpc:sacctmgr rdfs:range rdf:Resource .

hpc:scontrolShowLicense a owl:ObjectProperty .
hpc:scontrolShowLicense rdfs:domain hpc:License .
hpc:scontrolShowLicense rdfs:range rdf:Resource .
