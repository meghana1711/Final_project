hpc:Commandoutput a owl:Class .
hpc:Customizedoutputformat a owl:Class .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .

# Object Properties
hpc:appliesto a owl:ObjectProperty .
hpc:displays a owl:ObjectProperty .

# Datatype Properties
hpc:field a owl:DatatypeProperty .
hpc:order a owl:DatatypeProperty .

# Domain and Range
hpc:Commandoutput rdfs:subClassOf hpc:Output .
hpc:Customizedoutputformat rdfs:subClassOf hpc:Commandoutput .
hpc:Host rdfs:subClassOf owl:Thing .
hpc:Hostgroup rdfs:subClassOf owl:Thing .
hpc:Appliesto rdfs:domain hpc:Commandoutput ;
                                rdfs:range hpc:Hostgroup .
hpc:Displays rdfs:domain hpc:Commandoutput ;
                                rdfs:range hpc:Field .

# Fields
hpc:columnheadingsremoved a owl:ObjectProperty .
hpc:jsonoutputnotallowed a owl:ObjectProperty .
hpc:outputformatspecified a owl:ObjectProperty .

# Data Types
hpc:Field a owl:Class ;
          rdfs:subClassOf xsd:string .

# Range for columnHeadingsRemoved
hpc:Field rdfs:range xsd:boolean .

# Range for jsonOutputNotAllowed
hpc:Customizedoutputformat rdfs:range xsd:boolean .

# Range for outputFormatSpecified
hpc:Customizedoutputformat rdfs:range hpc:Fieldsequence .
