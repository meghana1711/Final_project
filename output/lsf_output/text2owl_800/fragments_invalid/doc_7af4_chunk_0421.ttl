hpc:Useraccount a owl:Class .
hpc:hasDockerGroupMembership rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:isDefaultUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:string .
hpc:isExecutableScript rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:boolean .
hpc:scriptFileOwnership rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:integer .
hpc:scriptFilePermissions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Useraccount ;
    rdfs:range xsd:integer .
hpc:Executiondriverscript a owl:Class ;
    rdfs:subClassOf hpc:Executablescript .
hpc:Dockerstarterscript a owl:Class ;
    rdf:type hpc:ExecutionDriverScript ;
    hpc:isRequiredFor Docker .
hpc:Dockermonitorscript a owl:Class ;
    rdf:type hpc:ExecutionDriverScript ;
    hpc:isRequiredFor ( Docker ( cgroupfsDriver systemd ) ) .
hpc:Dockercontrolscript a owl:Class ;
    rdf:type hpc:ExecutionDriverScript ;
    hpc:isRequiredFor Docker .
hpc:Podmanmonitorscript a owl:Class ;
    rdf:type hpc:ExecutionDriverScript ;
    hpc:isOptionalFor Podman .
hpc:Podmancontrolscript a owl:Class ;
    rdf:type hpc:ExecutionDriverScript ;
    hpc:isRequiredFor Podman .
