hpc:Job a owl:Class .
hpc:Jobsubmission a owl:Class .
hpc:jobtemporarydirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:defaultjoboutputdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .
hpc:joboutputdirectoryrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range rdf:List .
hpc:Application a owl:Class .
hpc:joboutputdirectorypattern a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboutputdirectoryrequirement ;
    rdfs:range xsd:string .
hpc:joboutputdirectorycreationfailureaction a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutputdirectoryrequirement ;
    rdfs:range xsd:string .
hpc:joboutputdirectorycreationsuccessaction a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutputdirectoryrequirement ;
    rdfs:range xsd:string .
hpc:jobcurrentworkingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
