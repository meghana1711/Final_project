hpc:Job a owl:Class .
hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:sshx11forwarding a owl:DatatypeProperty ;
    rdfs:domain hpc:Submitjob ;
    rdfs:range xsd:boolean .

hpc:killjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Jobgroup a owl:Class .
hpc:jobgrouppath a owl:DatatypeProperty ;
    rdfs:domain hpc:Killjob ;
    rdfs:range xsd:string .

hpc:runstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Killjob ;
    rdfs:range xsd:string .

hpc:Terminatedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:recordedjob a owl:DatatypeProperty ;
    rdfs:domain hpc:Killjob ;
    rdfs:range xsd:string .

hpc:killjobwithdonerecording a owl:ObjectProperty ;
    rdfs:domain hpc:Killjob ;
    rdfs:range hpc:Terminatedjob .

hpc:killjobignoringoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Killjob ;
    rdfs:range xsd:boolean .
