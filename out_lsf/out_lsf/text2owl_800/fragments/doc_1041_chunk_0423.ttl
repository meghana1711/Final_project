hpc:Job a owl:Class .
hpc:resourceusagerequirement a owl:ObjectProperty .
hpc:consumableresourcerequirement a owl:DatatypeProperty .
hpc:durationrequirement a owl:DatatypeProperty .
hpc:decayrequirement a owl:DatatypeProperty .

hpc:Resourceusagerequirement rdfs:domain hpc:Job .
hpc:Consumableresourcerequirement rdfs:domain hpc:Resourceusagerequirement .
hpc:Durationrequirement rdfs:domain hpc:Resourceusagerequirement .
hpc:Decayrequirement rdfs:domain hpc:Resourceusagerequirement .

hpc:Consumableresourcerequirement rdfs:range xsd:nonNegativeInteger .
hpc:Durationrequirement rdfs:range xsd:nonNegativeInteger .
hpc:Decayrequirement rdfs:range xsd:decimal .

hpc:Jobmodification a owl:Class .
hpc:modifiedresourceusagerequirement a owl:ObjectProperty .

hpc:Modifiedresourceusagerequirement rdfs:domain hpc:Jobmodification .
hpc:Modifiedresourceusagerequirement rdfs:range hpc:Resourceusagerequirement .

hpc:Reservationlimit a owl:Class .
hpc:Reservationlimit rdfs:subClassOf hpc:Consumableresourcerequirement .

hpc:Jobphase a owl:Class .
hpc:memoryrequirement a owl:DatatypeProperty .
hpc:durationrequirement a owl:DatatypeProperty .
hpc:decayrequirement a owl:DatatypeProperty .

hpc:Jobphase rdfs:subClassOf hpc:Resourceusagerequirement .
hpc:Memoryrequirement rdfs:domain hpc:Jobphase .
hpc:Durationrequirement rdfs:domain hpc:Jobphase .
hpc:Decayrequirement rdfs:domain hpc:Jobphase .

hpc:Jobphase rdfs:subClassOf hpc:Job .
