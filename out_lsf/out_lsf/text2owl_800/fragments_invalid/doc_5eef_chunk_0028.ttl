hpc:Lsfdatamanager a owl:Class .
hpc:StagingArea rdf:type owl:DatatypeProperty .
hpc:Connections rdf:type owl:ObjectProperty .
hpc:Cluster rdf:type owl:Class .
hpc:Master rdf:type owl:Class .
hpc:Status rdf:type owl:DatatypeProperty .
hpc:OutgoingRemote rdf:type owl:ObjectProperty .
hpc:ClusterName rdf:type owl:DatatypeProperty .
hpc:DataHosts rdf:type owl:DatatypeProperty .

hpc:Lsfdatamanager rdfs:subClassOf owl:Class .
hpc:Stagingarea rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
hpc:Connections rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range rdf:List .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Master rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Status rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Outgoingremote rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range rdf:List .
hpc:Clustername rdfs:domain hdfs:OutgoingRemote ;
    rdfs:range xsd:string .
hpc:Datahosts rdfs:domain hdfs:OutgoingRemote ;
    rdfs:range rdf:List .
