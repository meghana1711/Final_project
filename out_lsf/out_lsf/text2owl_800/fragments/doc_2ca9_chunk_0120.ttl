hpc:Interactivejob a owl:Class .
hpc:Bsubcommandoption a owl:Class .
hpc:Lsbparameter a owl:Class .
hpc:Dynamicjobmanagement a owl:Class .
hpc:eadmintriggerinterval a owl:DatatypeProperty .
hpc:persistliveconfig a owl:DatatypeProperty .
hpc:udpportrange a owl:DatatypeProperty .

hpc:Bsubcommandoption rdfs:subClassOf hpc:Objectproperty .
hpc:Lsbparameter rdfs:subClassOf hpc:Datatypeproperty .

hpc:Interactivejob rdfs:subClassOf rdf:Resource .
hpc:Bsubcommandoption rdfs:domain hpc:Interactivejob ;
    rdfs:range xsd:string .

hpc:Lsbparameter rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .

hpc:Eadmintriggerinterval rdfs:domain hpc:Lsbparameter ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Persistliveconfig rdfs:domain hpc:Lsbparameter ;
    rdfs:range xsd:boolean .

hpc:Udpportrange rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .
