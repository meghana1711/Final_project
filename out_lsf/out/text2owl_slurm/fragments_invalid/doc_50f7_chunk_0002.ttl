hpc:Mcsjob a owl:Class .
hpc:mcsplugin a owl:ObjectProperty .
hpc:mcsparameters a owl:ObjectProperty .

hpc:Hasmcsplugin rdfs:domain hpc:Mcsjob ;
    rdfs:range hpc:Mcsplugin .

hpc:Hasmcsparameters rdfs:domain hpc:Mcsjob ;
    rdfs:range rdf:List .

hpc:Mcspluginvalue a owl:Class .
hpc:none a hpc:MCSPluginValue ;
    rdfs:label "none" .
hpc:account a hpc:MCSPluginValue ;
    rdfs:label "account" .
hpc:group a hpc:MCSPluginValue ;
    rdfs:label "group" .
hpc:user a hpc:MCSPluginValue ;
    rdfs:label "user" .
hpc:label a hpc:MCSPluginValue ;
    rdfs:label "label" .

hpc:Mcslabel a owl:Class .
hpc:Hasmcslabel rdfs:domain hpc:Mcsjob
