hpc:Hostlist a owl:Class .
hpc:Attrdelete a owl:Class .

hpc:version a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrdelete ;
    rdfs:range xsd:integer .

hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostlist ;
    rdfs:range xsd:string .

hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostlist ;
    rdfs:range xsd:string .

hpc:attrnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrdelete ;
    rdfs:range xsd:integer .

hpc:attributelist a owl:ObjectProperty ;
    rdfs:domain hpc:Attrdelete .

hpc:hostnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Attrdelete ;
    rdfs:range xsd:integer .

hpc:hostlist1 a owl:ObjectProperty ;
    rdfs:domain hpc:Attrdelete ;
    rdfs:range hpc:Hostlist .

hpc:hostlist2 a owl:ObjectProperty ;
    rdfs:domain hpc:Hostlist ;
    rdfs:range hpc:Hostlist .

hpc:desc a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostlist ;
    rdfs:range xsd:string .
