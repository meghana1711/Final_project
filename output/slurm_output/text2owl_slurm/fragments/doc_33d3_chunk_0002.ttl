hpc:Jobsubmission a owl:Class .
hpc:validateoptions a owl:ObjectProperty .
hpc:prioritycheck a owl:ObjectProperty .
hpc:resourceallocation a owl:ObjectProperty .
hpc:nodeselection a owl:ObjectProperty .
hpc:selectplugin a owl:ObjectProperty .
hpc:jobstepresourceallocation a owl:ObjectProperty .
hpc:credential a owl:DatatypeProperty .
hpc:sruncommand a owl:ObjectProperty .
hpc:Slurmddaemon a owl:Class .
hpc:Slurmstepd a owl:Class .
hpc:tasklaunch a owl:ObjectProperty .
hpc:executablename a owl:DatatypeProperty .
hpc:filenames a owl:DatatypeProperty .
hpc:treewidth a owl:DatatypeProperty .

hpc:Jobsubmission rdfs:subClassOf owl:Class .
hpc:Validateoptions rdfs:domain hpc:Jobsubmission ;
                      rdfs:range rdf:Resource .
hpc:Prioritycheck rdfs:domain hpc:Jobsubmission ;
                      rdfs:range rdf:Boolean .
hpc:Resourceallocation rdfs:domain hpc:Jobsubmission ;
                      rdfs:range rdf:Resource .
hpc:Nodeselection rdfs:domain hpc:Jobsubmission ;
                      rdfs:range rdf:Resource .
hpc:Selectplugin rdfs:domain hpc:Jobsubmission ;
                      rdfs:range rdf:Resource .
hpc:Jobstepresourceallocation rdfs:domain hpc:Jobstep ;
                         rdfs:range rdf:Resource .
hpc:Credential rdfs:domain hpc:Jobstepresourceallocation ;
                      rdfs:range xsd:string .
hpc:Sruncommand rdfs:domain hpc:Tasklaunch ;
                      rdfs:range rdf:Resource .
hpc:Executablename rdfs:domain hpc:Tasklaunch ;
                      rdfs:range xsd:string .
hpc:Filenames rdfs:domain hpc:Tasklaunch ;
                      rdfs:range rdf:List .
hpc:Treewidth rdfs:domain hpc:Tasklaunch ;
                      rdfs:range xsd:nonNegativeInteger .
