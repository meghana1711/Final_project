hpc:Project a owl:Class .
hpc:demandlimit a owl:ObjectProperty .
hpc:Demand a owl:Class .
hpc:Cluster a owl:Class .
hpc:Job a owl:Class .
hpc:rusage a owl:DatatypeProperty .
hpc:pendingreason a owl:ObjectProperty .

hpc:Project rdfs:subClassOf owl:Class .
hpc:DemandLimit rdf:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:Demand rdf:subClassOf owl:Class .
hpc:Cluster rdf:subClassOf owl:Class .
hpc:Job rdf:subClassOf owl:Class .
hpc:Rusage rdf:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PendingReason rdf:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job .
