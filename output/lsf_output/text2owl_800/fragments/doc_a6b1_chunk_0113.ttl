hpc:Globalpolicydaemoncluster a owl:Class .
hpc:Unixhost rdfs:subClassOf hpc:Globalpolicydaemoncluster .
hpc:Managementhost rdfs:subClassOf hpc:Globalpolicydaemoncluster .
hpc:Gpolicyd a owl:Class .
hpc:Startedbysbatchd rdfs:domain hpc:Gpolicyd ;
                        rdfs:range hpc:Managementhost .
hpc:ConfiguredbylsbGpdCluster rdfs:domain hpc:Managementhost ;
                               rdfs:range xsd:string .
hpc:Globalfairsharepolicy a owl:Class .
hpc:Participant rdfs:domain hpc:Globalfairsharepolicy ;
                      rdfs:range hpc:Queueatcluster .
hpc:Globalfairsharesection rdfs:subClassOf rdf:Resource .
hpc:Globalfairshare a owl:Class ;
                     rdfs:subClassOf hpc:Globalfairsharesection .
hpc:name a owl:DatatypeProperty ;
      rdfs:domain hpc:Globalfairshare ;
      rdfs:range xsd:string .
hpc:participants a owl:ObjectProperty ;
      rdfs:domain hpc:Globalfairshare .
hpc:Remotefairshareloadimpactsdynamicpriority rdfs:domain hpc:Jobscheduling .
hpc:bgpinfo a owl:ObjectProperty .
