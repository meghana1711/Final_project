hpc:Computeinstancesize a owl:Class .
hpc:Gpuinstancesize a owl:Class .
hpc:Migdevice a owl:Class .
hpc:NumMIGDevices an owl:DatatypeProperty ;
    rdfs:domain hpc:Migdevice ;
    rdfs:range xsd:nonNegativeInteger .
hpc:migsupport a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuinstancesize ;
    rdfs:range hpc:Computeinstancesize .
hpc:lsfmanagemig a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuinstancesize ;
    rdfs:range xsd:string .
hpc:LSFDynamicMIG a rdfs:Literal ;
    rdf:value "Y" .
hpc:LSDynamicMIC a rdfs:Literal ;
    rdf:value "Y" .
hpc:LSSstaticMIG a rdfs:Literal ;
    rdf:value "N" .
hpc:Migsupportedcombination a owl:Class ;
    rdfs:subClassOf hpc:Computeinstancesize .
hpc:UnsupportedCombination1 a hpc:MIGSupportedCombination ;
    rdf:value "4/3" .
hpc:UnsupportedCombination2 a hpc:MIGSupportedCombination ;
    rdf:value "7/5" .
hpc:UnsupportedCombination3 a hpc:MIGSupportedCombination ;
    rdf:value "7/6" .
hpc:defaultcomputeinstancesize a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuinstancesize ;
    rdfs:range hpc:Computeinstancesize .
hpc:lsfmanagemigdomain a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuinstancesize ;
    rdfs:range hpc:Migdevice .
hpc:lsfstaticmigdomain a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuinstancesize ;
    rdfs:range hpc:Migdevice .
hpc:MIGJobFinish a rdfs:Literal .
hpc:MIGDestroy a rdfs:Literal .
hpc:MIGCreate a rdfs:Literal .
hpc:LSFDaemonsRestart a rdfs:Literal .
hpc:lshostsupportsmig a owl:ObjectProperty ;
    rdfs:domain hpc:Lshost ;
    rdfs:range hpc:Migdevice .
hpc:lshostdetailedmig a owl:ObjectProperty ;
    rdfs:domain hpc:Lshost ;
    rdfs:range hpc:Migdevice .
hpc:bhostgpu a owl:ObjectProperty ;
    rdfs:domain hpc:Bhost ;
    rdfs:range hpc:Migdevice .
hpc:bhostmiginfo a owl:ObjectProperty ;
    rdfs:domain hpc:Bhost ;
    rdfs:range hpc:Migdevice .
