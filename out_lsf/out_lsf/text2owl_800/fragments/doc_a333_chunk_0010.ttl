hpc:hassysctlparameter a owl:ObjectProperty .
hpc:Sysctlparameter rdfs:domain hpc:Sysctlconfiguration ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasSysctlParameter .

hpc:maxmapcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Sysctlconfiguration .

hpc:Installationdirectory a owl:Class .
hpc:extractpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Installationdirectory .

hpc:Installationpackage a owl:Class ;
    rdfs:range xsd:string .

hpc:Largeparalleljobenvironment a owl:Class .
hpc:hassharedmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Largeparalleljobenvironment .
