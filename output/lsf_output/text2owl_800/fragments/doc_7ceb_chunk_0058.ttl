hpc:Lshosts a owl:Class .
hpc:hostName a owl:ObjectProperty .

hpc:Cpuf rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:string .
hpc:Ncpus rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:integer .
hpc:Maxmem rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:decimal .
hpc:Maxswp rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:decimal .
hpc:Server rdfs:domain hpc:Lshosts ;
    rdfs:range xsd:boolean .

hpc:hostA a hpc:lshosts ;
    hpc:cpuf "UNKNOWN" ;
    hpc:ncpus 20.2 ;
    hpc:ncpus 2 ;
    hpc:maxmem "256 M" ;
    hpc:maxswp "710M" ;
    hpc:server "Yes" ;
    hpc:server false .
