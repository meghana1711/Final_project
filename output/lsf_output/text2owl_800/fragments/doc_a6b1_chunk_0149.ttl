hpc:reexec a owl:ObjectProperty ;
    rdfs:domain hpc:Xwindowprogram ;
    rdfs:range rdf:XMLLiteral .

hpc:Xwindowprogram a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "Program type is X window." .

hpc:startmethod a owl:DatatypeProperty ;
    rdfs:domain hpc:Xwindowprogram ;
    rdfs:range xsd:string .

hpc:host a owl:DatatypeProperty ;
    rdfs:domain hpc:Reexec ;
    rdfs:range xsd:string .

hpc:programtype a owl:DatatypeProperty ;
    rdfs:domain hpc:Xwindowprogram ;
    rdfs:range xsd:string .

hpc:Best a owl:Class ;
    rdfs:subClassOf hpc:Xwindowprogram .

hpc:appy a owl:ObjectProperty ;
    rdfs:domain hpc:Xwindowprogram ;
    rdfs:range rdf:XMLLiteral .

hpc:commandline a owl:DatatypeProperty ;
    rdfs:domain hpc:Appy ;
    rdfs:range xsd:string .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Xwindowprogram ;
    rdfs:range xsd:string .
