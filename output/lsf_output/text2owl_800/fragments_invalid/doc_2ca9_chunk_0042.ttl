hpc:Gpujob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Migdevice a owl:Class .

hpc:Migallocation a owl:Class ;
    rdfs:subClassOf hpc:Allocation .

hpc:Deprecatedfeature a owl:Class .

# Object Properties
hpc:hasmigdevice a owl:ObjectProperty ;
    rdfs:domain hpc:Gpujob ;
    rdfs:range hpc:Migdevice .

hpc:hasmigallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Migdevice ;
    rdfs:range hpc:Migallocation .

hpc:isdeprecated a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Deprecatedfeature .

# Datatype Properties
hpc:correspondingDeprecatedParametersAndCommands rdfs:datatype xsd:string ;
    rdfs:range hpc:Deprecatedfeature .

hpc:alternativeFeature rdfs:datatype xsd:string ;
    rdfs:range hpc:Feature .

# Classes for Deprecated Features
hpc:LSFMultiClusterCapabilityResourceLeasingModel a hpc:DeprecatedFeature .

hpc:HostExportSection a hpc:DeprecatedFeature .

hpc:SharedResourceExportSection a hpc:DeprecatedFeature .

hpc:allremote a hpc:DeprecatedFeature .

hpc:all@cluster_name a hpc:DeprecatedFeature .

hpc:-cnameOption a hpc:DeprecatedFeature .

hpc:bacctCommand a hpc:DeprecatedFeature .

hpc:bhostsCommand a hpc:DeprecatedFeature .

hpc:bmgroupCommand a hpc:DeprecatedFeature .

hpc:lshostsCommand a hpc:DeprecatedFeature .

hpc:lsloadCommand a hpc:DeprecatedFeature .

hpc:jobSlotPoolsForFairShareScheduling a hpc:DeprecatedFeature .

hpc:HOSTSKeyword a hpc:DeprecatedFeature .

hpc:MAX_SLOTS_IN_POOL a hpc:DeprecatedFeature .

hpc:SLOT_POOL a hpc:DeprecatedFeature .

hpc:SLOT_SHARE a hpc:DeprecatedFeature .

hpc:USE_PRIORITY_IN_POOL a hpc:DeprecatedFeature .

hpc:GuaranteeSLA a hpc:DeprecatedFeature .

hpc:toplibIntegrations a hpc:DeprecatedFeature .

hpc:LSF_TOPD_PORT a hpc:DeprecatedFeature .

hpc:LSF_TOPD_TIMEOUT a hpc:DeprecatedFeature .

hpc:ChunkJobScheduling a hpc:DeprecatedFeature .

hpc:LSB_CHUNK_RUSAGE a hpc:DeprecatedFeature .

hpc:CHUNK_JOB_DURATION a hpc:DeprecatedFeature .

hpc:CHUNK_JOB_SIZE a hpc:DeprecatedFeature .

