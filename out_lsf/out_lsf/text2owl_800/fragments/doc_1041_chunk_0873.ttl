hpc:Fullinstallation a owl:Class .
hpc:Newclusterinstallation a owl:Class ;
    rdfs:subClassOf hpc:Fullinstallation .
hpc:Versionupgrade a owl:Class ;
    rdfs:subClassOf hpc:Fullinstallation .
hpc:Patch a owl:Class ;
    rdfs:subClassOf hpc:Fullinstallation .

hpc:Installedbinary a owl:Class ;
    rdfs:subClassOf hpc:Fullinstallation .
hpc:installeddate a owl:DatatypeProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:installedfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:installedfilepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:lastpatched a owl:ObjectProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:lastpatchedbuildnumber a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:lastpatcheddate a owl:DatatypeProperty ;
    rdfs:range xsd:date .
hpc:lastpatchnotes a owl:DatatypeProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:lastpatchfixes a owl:DatatypeProperty ;
    rdfs:domain hpc:Installedbinary .
hpc:buildversioninformation a owl:ObjectProperty .
hpc:buildversioninformationProductname a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:buildversioninformationVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:buildversioninformationBinarytype a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:buildversioninformationBuildnumber a owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:buildversioninformationBuilddate a owl:DatatypeProperty ;
    rdfs:range xsd:date .
hpc:buildversioninformationNotes a owl:DatatypeProperty ;
    rdfs:domain hpc:Buildversioninformation .
