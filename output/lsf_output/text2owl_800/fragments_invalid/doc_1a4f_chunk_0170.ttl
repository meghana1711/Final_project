hpc:Hostgroupdefinition a owl:Class .
hpc:hasexclusion a owl:ObjectProperty .
hpc:Hasexclusion rdfs:domain hpc:Hostgroupdefinition ;
                  rdfs:range rdf:String .
hpc:haswildcard a owl:ObjectProperty .
hpc:Haswildcard rdfs:domain hpc:Hostgroupdefinition ;
                 rdfs:range rdf:String .
hpc:hasrange a owl:ObjectProperty .
hpc:Hasrange rdfs:domain hpc:Hostgroupdefinition ;
               rdfs:range xsd:nonNegativeInteger .
hpc:hasindividualrange a owl:ObjectProperty .
hpc:Hasindividualrange rdfs:domain hpc:Hostgroupdefinition ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:hasmultipleranges a owl:ObjectProperty .
hpc:Hasmultipleranges rdfs:domain hpc:Hostgroupdefinition ;
                       rdfs:range xsd:nonNegativeInteger .
hpc:Hostgroupdefinition rdfs:subClassOf owl:Class .
hpc:Hostgroup rdfs:subClassOf hpc:Hostgroupdefinition .
hpc:Hostgroupdefinition rdfs:subClassOf owl:Restriction ;
                        rdfs:subPropertyOf rdf:type ;
                        rdfs:someValuesFrom hpc:HostGroup .


This ontology fragment defines classes for `HostGroupDefinition` and `HostGroup`, and object properties for handling exclusions, wildcards, ranges, and multiple ranges for defining host groups. The `HostGroup` class is a subclass of `HostGroupDefinition`. The `HostGroupDefinition` class is further restricted by the properties it can have.
