hpc:ShortLivedJwtToken a owl:Class .
hpc:AuthenticatingProxy a owl:Class .
hpc:SingleSignOn a owl:Class .
hpc:AuthenticationFailureMessage a owl:DatatypeProperty .
hpc:SlurmDaemon a owl:Class .
hpc:JwtAuthentication a owl:Class .
hpc:JwtTokenAuthentication a owl:Class .
hpc:AuthenticatingAgainstSso a owl:ObjectProperty .
hpc:HasCommunicationType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmRESTAPI ;
    rdfs:range hpc:CommunicationType .
hpc:HasProtectionAgainstAttacks rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmRESTAPI ;
    rdfs:range hpc:ProtectionType .
hpc:HasNetwork rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TrustedNetwork ;
    rdfs:range hpc:Network .
hpc:HasClient rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TrustedClient ;
    rdfs:range hpc:Client .
hpc:HasCommunication rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TrustedNetwork ;
    rdfs:range hpc:Communication .
hpc:HasCommunication rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TrustedClient ;
    rdfs:range hpc:Communication .
hpc:HasProtectionLevel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Communication ;
    rdfs:range hpc:ProtectionLevel .
hpc:HasFiltering rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TrustedClient ;
    rdfs:range hpc:FilteringType .
hpc:HasTokenLifespan rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JwtToken ;
    rdfs:range xsd:nonNegativeInteger .
hpc:HasTokenGenerator rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JwtToken ;
    rdfs:range hpc:TokenGenerator .
