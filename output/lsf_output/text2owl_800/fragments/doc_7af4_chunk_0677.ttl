hpc:LSB_CONFDIR
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Directory where configuration files for each cluster are stored." .

hpc:configuration_directory
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Subdirectory of LSB_CONFDIR that contains configuration files." .

hpc:cluster_name
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Name of the cluster." .

hpc:LSF_LIVE_CONFDIR
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Directory where live configuration files are written to and read from." .

hpc:LSF_CONFDIR
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Default LSF configuration directory." .

hpc:lsbatch
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Default LSF configuration directory for lsbatch." .

hpc:LSB_CPUACCT_STAT
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Parameter to separate CPU and system time accounting." .

hpc:LSB_CPUACCT_STAT_value
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbCpuacctStat ;
    rdfs:range xsd:string ;
    rdfs:comment "Syntax for setting the LSB_CPUACCT_STAT parameter." .

hpc:LSB_DEBUG
    a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Parameter to set LSF batch system to debug." .

hpc:LSB_DEBUG_value
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbDebug ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Syntax for setting the LSB_DEBUG parameter." .
