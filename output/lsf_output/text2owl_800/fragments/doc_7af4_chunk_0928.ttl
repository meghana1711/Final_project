hpc:port a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfhost ;
    rdfs:range xsd:integer .

hpc:preemptAction a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range xsd:string .

hpc:PREEMPT_ACTION_Not_defined a owl:NamedIndividual ;
    hpc:PREEMPT_ACTION "TSTP signal" .

hpc:PREEMPT_ACTION_Script a owl:NamedIndividual .

hpc:projectGroupPath a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range xsd:boolean .

hpc:Hierarchicalprojectgrouppaths a owl:Class ;
    rdfs:subClassOf hpc:Projectgrouppath .

hpc:projectgrouphierarchyenabled a owl:ObjectProperty ;
    rdfs:domain hpc:Hierarchicalprojectgrouppaths ;
    rdfs:range xsd:boolean .

hpc:uniqueprojectsorprojectgroups a owl:ObjectProperty ;
    rdfs:domain hpc:Hierarchicalprojectgrouppaths ;
    rdfs:range xsd:boolean .

hpc:Projecthierarchypath a owl:Class ;
    rdfs:subClassOf hpc:Projectgrouppath .
