hpc:lsbSimMaxm a owl:DatatypeProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:integer .

hpc:lsbSimNslo a owl:DatatypeProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:integer .

hpc:lsbSimRunt a owl:DatatypeProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:integer .

hpc:lsbSimSubTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/simulation-ontology#> .

hpc:lsbSimSubUser a owl:ObjectProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:string .

hpc:lsbSimTraceType a owl:DatatypeProperty ;
    rdfs:domain hpc:Simulation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/simulation-ontology#> ;
    rdfs:subPropertyOf hpc:LSB_SIM_SUB_TIME .

hpc:Modificationscript a owl:Class ;
    rdfs:subClassOf hpc:Simulationmodification .

hpc:Modificationplugin a owl:Class ;
    rdfs:subClassOf hpc:Simulationmodification .

hpc:Simulationmodification a owl:Class .
