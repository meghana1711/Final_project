hpc:Job a owl:Class .
hpc:Task a owl:Class .
hpc:SrunCommand a owl:Class .
hpc:IO a owl:Class .
hpc:TerminatedJob a owl:Class .
hpc:ForceTerminatedJob a owl:Class .
hpc:JobFailed a owl:Class .
hpc:FirstTaskExited a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:srunMonitorsExitedTasks a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range hpc:Job .
hpc:srunDefaultTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:duration .
hpc:srunHasPendingIO a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range hpc:IO .
hpc:IOAbandoned a owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range hpc:IO .
hpc:JobHoldState a owl:Class .
hpc:JobCanBeHold a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobHoldState .
hpc:JobSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:JobCanDecreaseSize a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
