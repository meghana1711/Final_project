hpc:Hadoopcluster a owl:Class .
hpc:Apachehadoopintegration a owl:Class .
hpc:Sharedfilesystem a owl:Class .
hpc:Hpccluster a owl:Class .
hpc:Hpcjob a owl:Class .
hpc:Sparkapplication a owl:Class .
hpc:Lsfintegration a owl:Class .
hpc:Apachespark a owl:Class .
hpc:Hadoop a owl:Class .
hpc:Sparkjob a owl:Class .
hpc:Lsfscheduler a owl:Class .
hpc:Sparkcluster a owl:Class .

hpc:Hassharedfilesystem rdfs:domain hpc:Hadoopcluster .
hpc:Hasapachehadoopintegration rdfs:domain hpc:Hadoopcluster .
hpc:Requiresnohdfs rdfs:range xsd:boolean .
hpc:Usesexistingfilesystems rdfs:range xsd:boolean .
hpc:Isintegratedwith rdfs:domain hpc:Hadoop .
hpc:Provideshighlevelapis rdfs:range xsd:string .
hpc:Providesoptimizedengine rdfs:range xsd:string .
hpc:Supportsgeneralexecutiongraphs rdfs:range xsd:string .
hpc:Providessparksql rdfs:range xsd:string .
hpc:Providessparkstreaming rdfs:range xsd:string .
hpc:Providesmllib rdfs:range xsd:string .
hpc:Requiresdistributedcomputednodes rdfs:range xsd:boolean .
hpc:Requireslargememory rdfs:range xsd:boolean .
hpc:Requireshighspeednetwork rdfs:range xsd:boolean .
hpc:Hasnofilesystemdependencies rdfs:range xsd:boolean .
hpc:Canruninhpcenvironment rdfs:range xsd:boolean .
hpc:Issubmittedaslsfjob rdfs:domain hpc:Sparkapplication .
hpc:Allocatesresources rdfs:domain hpc:Lsfintegration .
hpc:Tracksmonitorsandcontrolsjobexecution rdfs:range xsd:string .
hpc:Isresizablejob a owl:Class .
hpc:Hasalternativeresourcerequirements rdfs:range hpc:Resourcerequirements .
hpc:Hascompoundresourcerequirements rdfs:range hpc:Compoundresourcerequirements .
hpc:Hascomputeunitrequirements rdfs:range hpc:Computeunitrequirements .
hpc:Isresizablebybresizerelease rdfs:domain hpc:Resourcerequirements .
hpc:Canreleaseonlylasttermslots rdfs:range xsd:boolean .
hpc:Requiresrepeatedbresizerelease rdfs:range xsd:boolean .
