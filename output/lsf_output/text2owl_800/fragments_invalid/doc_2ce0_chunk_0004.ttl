hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Job a owl:Class .
hpc:Jobinfo a owl:Class .
hpc:hasJobInfo an owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Jobinfo .
hpc:hasUser rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobinfo .
    rdfs:range xsd:string .
hpc:isAdminOf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Group .
    rdfs:range hpc:User .
hpc:SecureJobInfoLevel an owl:DatatypeProperty ;
    rdfs:range xsd:integer .
hpc:EnableJobInfoByAdminRole an owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
    rdfs:range hpc:Usergroup .

hpc:Lsf a owl:Class .
hpc:Usergroup a owl:Class .
