hpc:Advancereservation       a owl:Class ;
                             rdfs:subClassOf owl:NamedIndividual ;
                             rdfs:comment "Represents an advance reservation." .

hpc:brsvadd                 a owl:ObjectProperty ;
                             rdfs:domain hpc:Advancereservation ;
                             rdfs:range hpc:Advancereservation ;
                             rdfs:comment "Adds an advance reservation." .

hpc:brsvdel                a owl:ObjectProperty ;
                             rdfs:domain hpc:Advancereservation ;
                             rdfs:range hpc:Advancereservation ;
                             rdfs:comment "Deletes an advance reservation." .

hpc:brsvjob                a owl:ObjectProperty ;
                             rdfs:domain hpc:Advancereservation ;
                             rdfs:range hpc:Job ;
                             rdfs:comment "Shows information about jobs submitted with the brsvsub command to a specific advance reservation." .

hpc:brsvmod                a owl:ObjectProperty ;
                             rdfs:domain hpc:Advancereservation ;
                             rdfs:range hpc:Advancereservation ;
                             rdfs:comment "Modifies an advance reservation." .

hpc:brsvs                  a owl:ObjectProperty ;
                             rdfs:domain xsd:anyURI ;
                             rdfs:range hpc:Advancereservationlist ;
                             rdfs:comment "Displays advance reservations." .

hpc:brsvsub                a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range hpc:Advancereservation ;
                             rdfs:comment "Creates a dynamically scheduled reservation and submits a job to fill the advance reservation when the resources required by the job are available." .

hpc:brun                   a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range xsd:boolean ;
                             rdfs:comment "Forces a job to run immediately." .

hpc:bsla                   a owl:ObjectProperty ;
                             rdfs:domain xsd:anyURI ;
                             rdfs:range hpc:Serviceclasslist ;
                             rdfs:comment "Displays information about service classes. Service classes are used in guaranteed resource policies and service-level agreement (SLA) scheduling." .

hpc:bslots                 a owl:ObjectProperty ;
                             rdfs:domain xsd:anyURI ;
                             rdfs:range hpc:Slotlist ;
                             rdfs:comment "Displays slots available and backfill windows available for backfill jobs." .

hpc:bstage                a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range hpc:Datafilelist ;
                             rdfs:comment "Stages data files for jobs with data requirements by copying files or creating symbolic links for them between the local staging cache and the job execution environment. You must run bstage only within the context of an LSF job (like blaunch)." .
