hpc:Taskrecord a owl:Class .
hpc:haspid a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:integer .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:string .
hpc:exitstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:integer .
hpc:dispatchtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:long .
hpc:completiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:long .
hpc:submissionhostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:string .
hpc:executionhostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:string .
hpc:currentworkingdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:string .
hpc:commandline a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskrecord ;
    rdfs:range xsd:string .
hpc:Lsfrusage a owl:Class .
hpc:ruUtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfrusage ;
    rdfs:range xsd:float .
hpc:ruStime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfrusage ;
    rdfs:range xsd:float .
hpc:ruMaxrss a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfrusage ;
    rdfs:range xsd:integer .
hpc:ruIxrss a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfrusage ;
    rdfs:range xsd:integer .
