hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Clusteradministeredattribute a owl:Class .
hpc:Usermanagedattribute a owl:Class .
hpc:deleteattributeoperation a owl:ObjectProperty .
hpc:resetclusteraffinityoperation a owl:ObjectProperty .
hpc:Hostname rdfs:domain hpc:Deleteattributeoperation ;
                                rdfs:range hpc:Host .
hpc:Hostgroup rdfs:domain hpc:Deleteattributeoperation ;
                                rdfs:range hpc:Hostgroup .
hpc:Username rdfs:domain hpc:Resetclusteraffinityoperation ;
                                rdfs:range xsd:string .
hpc:Clusteraffinityattribute rdfs:subClassOf hpc:Clusteradministeredattribute .
hpc:Usermanagedattribute rdfs:subClassOf hpc:Clusteradministeredattribute .
hpc:Usermanagedattribute rdfs:subClassOf hpc:Clusteradministeredattribute ;
                                rdfs:subClassOf hpc:Usermanagedattribute ;
                                rdfs:subClassOf hpc:Attribute .
hpc:Deleteattributeoperation rdfs:subClassOf owl:ObjectProperty .
hpc:Resetclusteraffinityoperation rdfs:subClassOf owl:ObjectProperty .
