hpc:Host a owl:Class .
hpc:Commanduser a owl:Class .
hpc:Multicluster a owl:Class .
hpc:Debuglevel a owl:Class .
hpc:Logfile a owl:Class .
hpc:classname a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:debuglevelvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Debuglevel ;
    rdfs:range xsd:nonNegativeInteger .
hpc:logclass a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range rdf:List .
hpc:Logclassmember a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Logclassmember .
hpc:LC_ADVRSV a hpc:LogClassMember .
hpc:LC2_ADVRSV a hpc:LogClassMember .
hpc:LC2_AFFINITY a hpc:LogClassMember .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:commandsubmittedhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Commanduser ;
    rdfs:range hpc:Host .
hpc:multiclusterSamecluster a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Host .
