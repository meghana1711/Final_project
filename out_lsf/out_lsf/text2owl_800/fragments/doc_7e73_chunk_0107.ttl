hpc:Launchinstancetemplate a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a Google Cloud instance template." .

hpc:launchtemplateid a owl:ObjectProperty ;
    rdfs:domain hpc:Launchinstancetemplate ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifier of the launch instance template in Google Cloud." .

hpc:zoneorregion a owl:DatatypeProperty ;
    rdfs:domain hpc:Launchinstancetemplate ;
    rdfs:range xsd:string ;
    rdfs:comment "Zone or region for the instance in Google Cloud." .

hpc:googleprovTemplatesjson a owl:ObjectProperty ;
    rdfs:domain hpc:Launchinstancetemplate ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The JSON file containing the instance template details." .

hpc:overridebehavior a owl:ObjectProperty ;
    rdfs:domain hpc:Launchinstancetemplate ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Behavior of instance template overrides in Google Cloud." .

hpc:userdata a owl:DatatypeProperty ;
    rdfs:domain hpc:GoogleprovTemplatesjson ;
    rdfs:range xsd:string ;
    rdfs:comment "Environment variables to be exported to the instances." .

hpc:instancetags a owl:DatatypeProperty ;
    rdfs:domain hpc:GoogleprovTemplatesjson ;
    rdfs:range xsd:string ;
    rdfs:comment "Labels to be added to the instances." .

hpc:Localssd a owl:Class ;
    rdfs:subClassOf hpc:Disk ;
    rdfs:comment "Represents a Local SSD in Google Cloud." .

hpc:attachlocalssd a owl:ObjectProperty ;
    rdfs:domain hpc:Launchinstancetemplate ;
    rdfs:range hpc:Localssd ;
    rdfs:comment "Relates a launch instance template to a Local SSD." .

hpc:disktype a owl:DatatypeProperty ;
    rdfs:domain hpc:Localssd ;
    rdfs:range xsd:string ;
    rdfs:comment "Type of the Local SSD (Local SSD scratch disk)." .

hpc:mountssd a owl:ObjectProperty ;
    rdfs:domain hpc:Localssd ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Relates a Local SSD to the process of mounting it." .
