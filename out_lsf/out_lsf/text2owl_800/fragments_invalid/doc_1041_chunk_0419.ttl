hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A computational job submitted for execution." .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "A group of users in the HPC system." .

hpc:Hasusergroup hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "The user group to which a job is attached." .

hpc:Canrunin hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup ;
    rdfs:comment "Indicates whether a job can run in a specific user group." .

hpc:Hasgpu hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of GPUs required by a job." .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that can be resized." .

hpc:Resizeallocationrequest hpc:resizablejob owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Resource ;
    rdfs:comment "The resource request for resizing a resizable job." .

hpc:Canrequeue hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a job can be requeued." .

hpc:Firstexecutionhostlist hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host list for the first execution of a job." .

hpc:Compoundresourcerequirement hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Compoundresourcerequirement ;
    rdfs:comment "The compound resource requirement for a job." .

hpc:Simpleresourcerequirement hpc:compoundresourcerequirement owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirement ;
    rdfs:range hpc:Resourcerequirement ;
    rdfs:comment "The simple resource requirement in a compound resource requirement." .

hpc:Jobmodify2event a owl:Class ;
    rdfs:subClassOf rdf:Event ;
    rdfs:comment "An event triggered when a job's notification request is modified." .

hpc:Haschangedrecord hpc:jobmodify2event owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodify2event ;
    rdfs:range hpc:Record ;
    rdfs:comment "The record that was changed in the JobModify2 event." .

hpc:Jobarray hpc:job owl:ObjectProperty ;
    rdfs
