hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Submittedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that has been submitted to the HPC system." .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that is currently running on the HPC system." .

hpc:Completedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that has completed on the HPC system." .

# Properties

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who submitted the job." .

hpc:hasproject a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The project associated with the job." .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The current status of the job." .

hpc:isinqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The queue the job is in." .

hpc:hascommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The command associated with the job." .

hpc:wassubmittedfrom a owl:ObjectProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string ;
    rdfs:comment "The host from which the job was submitted." .

hpc:hascwd a owl:ObjectProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string ;
    rdfs:comment "The current working directory of the job." .

hpc:hashostfile a owl:ObjectProperty ;
    rdfs:domain hpc:Submittedjob ;
    rdfs:range xsd:string ;
    rdfs:comment "The user-specified host file associated with the job." .

hpc:hashostfilecontent a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The content of the user-specified host file." .

hpc:hashostslot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of slots allocated on a specific host." .

hpc:hashost a owl:ObjectProperty ;
    rdfs
