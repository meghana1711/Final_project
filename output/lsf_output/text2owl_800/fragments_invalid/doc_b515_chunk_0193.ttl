@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>
@prefix hpc: <http://example.org/hpc#>

hpc:Queue a owl:Class.
hpc:Pool a owl:Class.

hpc:Slotpool rdfs:domain hpc:Queue;
             rdfs:range hpc:Pool.
hpc:Hosts rdfs:domain hpc:Queue;
             rdfs:range rdf:Resource.
hpc:Priority rdfs:domain hpc:Queue;
             rdfs:range xsd:integer.
hpc:Slotshare rdfs:domain hpc:Queue;
             rdfs:range xsd:integer.
hpc:Maxslotsinpool rdfs:domain hpc:Pool;
             rdfs:range xsd:
