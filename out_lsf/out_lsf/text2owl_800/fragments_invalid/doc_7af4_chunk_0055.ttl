hpc:Value a owl:Class ;
    rdfs:subClassOf <http://example.org/hpc#FloatNumber> .

hpc:Value rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:frequency ;
    owl:hasValue xsd:decimal ;
    rdfs:range xsd:decimal ;
    owl:allValuesFrom xsd:nonNegativeFloat ;
    owl:someValuesFrom ( xsd:decimal ;
        rdf:value "GHz"^^xsd:string ;
        rdf:value "MHz"^^xsd:string ;
        rdf:value "KHz"^^xsd:string ) ;
    owl:default ( xsd:decimal "Nominal CPU frequency"^^xsd:string ) .

hpc:frequency a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:Cpulimit a owl:Class ;
    rdfs:subClassOf hpc:Timelimit .

hpc:Cpulimit rdfs:subClassOf owl:Restriction ;
    owl:onProperty hpc:totalCPUTime ;
    owl:hasValue xsd:nonNegativeInteger ;
    owl:allValuesFrom xsd:nonNegativeInteger ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:someValuesFrom ( xsd:nonNegativeInteger ;
        rdf:value "hour:"^^xsd:string ;
        rdf:value "minute"^^xsd:string ) ;
    owl:default ( xsd:nonNegativeInteger "Not defined"^^xsd:string ) ;
    rdfs:domain hpc:Job .

hpc:totalcputime a owl:DatatypeProperty ;
    rdfs:range xsd:duration .

hpc:joblevelcpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cpulimit ;
    rdfs:subPropertyOf hpc:CPULIMIT .

hpc:applicationprofilecpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cpulimit ;
    rdfs:subPropertyOf hpc:CPULIMIT .

hpc:queuecpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Cpulimit ;
    rdfs:subPropertyOf hpc:CPULIMIT .

hpc:runawayjobprevention a owl:ObjectProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:boolean .

hpc:graceperiod a owl:DatatypeProperty ;
    rdfs:range xsd:duration .
