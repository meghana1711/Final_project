hpc:Buffer a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:AllocBuffer rdfs:domain hpc:Buffer ;
    rdfs:range xsd:integer .

hpc:Free a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:demand a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .

hpc:Feature a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Licensename rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:ServiceDomain rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:TotalInuse rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer .

hpc:TotalReserve rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer .

hpc:TotalFree rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer .

hpc:Others rdfs:domain hpc:Feature ;
    rdfs:range xsd:integer .

hpc:EnableDynamicUsage rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Projectmode rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean .

hpc:License a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:Checkout rdfs:domain hpc:License ;
    rdfs:range hpc:User ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:License ;
