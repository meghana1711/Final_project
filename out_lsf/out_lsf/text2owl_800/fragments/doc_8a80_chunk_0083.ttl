hpc:Collector a owl:Class .
hpc:lastupdtime a owl:DatatypeProperty .
hpc:hostname a owl:ObjectProperty .
hpc:Licenseserver a owl:Class .
hpc:reachable a owl:ObjectProperty .
hpc:unreachable a owl:ObjectProperty .
hpc:unknown a owl:ObjectProperty .
hpc:licenseservers a owl:ObjectProperty .
hpc:features a owl:DatatypeProperty .

hpc:Collector rdfs:subClassOf owl:Class .
hpc:Lastupdtime rdfs:domain hpc:Collector ;
                 rdfs:range xsd:dateTime .
hpc:Hostname rdfs:domain hpc:Collector ;
               rdfs:range xsd:string .
hpc:Licenseserver rdfs:subClassOf hpc:Collector .
hpc:Reachable rdfs:domain hpc:Licenseserver ;
                rdfs:range xsd:boolean .
hpc:Unreachable rdfs:domain hpc:Licenseserver ;
                rdfs:range xsd:boolean .
hpc:Unknown rdfs:domain hpc:Licenseserver ;
                rdfs:range xsd:boolean .
hpc:Licenseservers rdfs:domain hpc:Collector ;
                 rdfs:range rdf:List .
hpc:Features rdfs:domain hpc:Collector ;
               rdfs:range rdf:List .
