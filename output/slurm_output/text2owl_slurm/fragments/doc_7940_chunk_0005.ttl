    rdfs:domain hpc:Mpiinterfaceimplementation ;
    rdfs:range hpc:Workaroundtype .
hpc:Workaroundtype a owl:Class .
hpc:getallocationoncomputenode a owl:ObjectProperty ;
    rdfs:domain hpc:Workaroundtype .

hpc:Federatedallocation a owl:Class .
hpc:Cancelrequest a owl:Class .
hpc:cancelsiblingjob a owl:ObjectProperty ;
    rdfs:domain hpc:Cancelrequest ;
    rdfs:range xsd:integer .
hpc:Siblingjobremoval a owl:Class .
hpc:removesiblingjobfromlist a owl:ObjectProperty ;
    rdfs:domain hpc:Siblingjobremoval ;
    rdfs:range xsd:string .
hpc:Jobmodification a owl:Class .
hpc:jobmodificationrouting a owl:ObjectProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:string .
hpc:Origincluster a owl:Class .
hpc:Jobarray a owl:Class .
hpc:jobarrayorigincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Origincluster .
hpc:Statuscommand a owl:Class .
hpc:Localclusterview a owl:Class .
hpc:Unifiedfederationview a owl:Class .
hpc:Federationstatuscommand a owl:Class ;
    rdfs:subClassOf hpc:Statuscommand .
