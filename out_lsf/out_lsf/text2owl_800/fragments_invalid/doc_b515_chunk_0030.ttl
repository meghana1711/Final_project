hpc:Bestfitjob a owl:Class .
hpc:hasMaxCUS an owl:DatatypeProperty ;
    rdfs:domain hpc:Bestfitjob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Compoundresourcejob a owl:Class .

hpc:Computeunit a owl:Class .
hpc:hasPreference an owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Host a owl:Class .
hpc:belongsto a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Computeunit .

hpc:Job a owl:Class .
hpc:hasResourceRequirement an owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Resourcerequirement a owl:Class .
hpc:hasComputeUnitOrder an owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement .
hpc:hasResourceRequirementPolicy an owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirement .

hpc:Resourcerequirementpolicy a owl:Class .
hpc:isconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementpolicy ;
    rdfs:range hpc:Resourcerequirementpolicy .
hpc:ismaxavail a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementpolicy ;
    rdfs:range hpc:Resourcerequirementpolicy .
hpc:isminavail a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementpolicy ;
    rdfs:range hpc:Resourcerequirementpolicy .

hpc:Hostpreference a owl:Class .
hpc:hasHostPreference an owl:DatatypeProperty ;
    rdfs:domain hpc:Hostpreference ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Candidatehostpreference a owl:Class .
hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Candidatehostpreference ;
    rdfs:range hpc:Host .
