hpc:Res a owl:Class .
hpc:Lsf a owl:Class .
hpc:Rcpbinaryfile a owl:Class .
hpc:copyfiles a owl:ObjectProperty .
hpc:lsrcpcommand a owl:ObjectProperty .
hpc:Lsfdatamanager a owl:Class .
hpc:datastaging a owl:ObjectProperty .
hpc:Inputdata a owl:Class .
hpc:Outputdata a owl:Class .
hpc:Cache a owl:Class .
hpc:Clusterexecutionhost a owl:Class .
hpc:Joballocation a owl:Class .
hpc:Largeamountsofdata a owl:Class .
hpc:dataavailability a owl:ObjectProperty .
hpc:Multiclustercapabilityenvironment a owl:Class .
hpc:datatransfer a owl:ObjectProperty .
hpc:remoteexecutionclusterselection a owl:ObjectProperty .
hpc:clusteraffinity a owl:ObjectProperty .
hpc:datareuse a owl:ObjectProperty .
hpc:Cloudcluster a owl:Class .
hpc:Publiccloud a owl:Class .
hpc:Virtualmachine a owl:Class .
hpc:datagateway a owl:ObjectProperty .
hpc:Lsfresourceconnector a owl:Class .
hpc:dataavailabilityincloud a owl:ObjectProperty .
hpc:datamovingbetweenclusters a owl:ObjectProperty .

hpc:Res rdfs:subClassOf hpc:Clusterresource .
hpc:Lsf rdfs:subClassOf hpc:Computingresource .
hpc:Rcpbinaryfile rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Copyfiles rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Rcpbinaryfile .
hpc:Lsrcpcommand rdfs:domain hpc:Lsf .
hpc:Lsfdatamanager rdfs:subClassOf hpc:Lsf .
hpc:Datastaging rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Inputdata .
hpc:Inputdata rdfs:subClassOf hpc:File .
hpc:Outputdata rdfs:subClassOf hpc:File .
hpc:Cache rdfs:subClassOf hpc:Storage .
hpc:Clusterexecutionhost rdfs:subClassOf hpc:Host .
hpc:Joballocation rdfs:subClassOf hpc:Event .
hpc:Largeamountsofdata rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Dataavailability rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Cluster .
hpc:Multiclustercapabilityenvironment rdfs:subClassOf hpc:Environment .
hpc:Datatransfer rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Outputdata .
hpc:Remoteexecutionclusterselection rdfs:domain hpc:Lsfdatamanager .
hpc:Clusteraffinity rdfs:domain hpc:Lsfdatamanager .
hpc:Datareuse rdfs:domain hpc:Lsfdatamanager .
hpc:cloudCluster rdfs:subClass
