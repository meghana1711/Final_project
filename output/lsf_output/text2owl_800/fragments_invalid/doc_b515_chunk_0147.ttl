hpc:Advancereservation a owl:Class;
    rdfs:subClassOf owl:NamedIndividual;
    rdfs:comment "Represents an advance reservation." .

hpc:hasreservationid a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range xsd:string;
    rdfs:comment "The unique identifier for the reservation." .

hpc:isactive a owl:DatatypeProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range xsd:boolean;
    rdfs:comment "Indicates whether the reservation is active or not." .

hpc:isdisabled a owl:DatatypeProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range xsd:boolean;
    rdfs:comment "Indicates whether the reservation is disabled or not." .

hpc:deletereservation a owl:ObjectProperty;
    rdfs:domain hpc:Advancereservation;
    rdfs:range rdf:Resource;
    rdfs:comment "The action of deleting a reservation." .

hpc:deleter
