hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:toposition a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queuetype a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:movejob a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadmin ;
    rdfs:range hpc:Job .
hpc:suspendjobs a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobgroup .
