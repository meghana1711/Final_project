hpc:Enhancedmulticlusterscheduler a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:mcPluginRemoteResource a owl:ObjectProperty ;
    rdfs:domain hpc:Enhancedmulticlusterscheduler ;
    rdfs:range xsd:boolean .

hpc:mcPluginUpdateInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Enhancedmulticlusterscheduler ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MC_PLUGIN_UPDATE_INTERVAL_Default a xsd:nonNegativeInteger ;
    rdf:value "0" .

hpc:mcPluginScheduleEnhance a owl:ObjectProperty ;
    rdfs:domain hpc:Enhancedmulticlusterscheduler ;
    rdfs:range xsd:boolean .

hpc:mcReclaimDelay a owl:DatatypeProperty ;
    rdfs:domain hpc:Enhancedmulticlusterscheduler ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MC_RECLAIM_DELAY_Default a xsd:nonNegativeInteger ;
    rdf:value "10" .

hpc:mcResourceMatchingCriteria a owl:ObjectProperty ;
    rdfs:domain hpc:Enhancedmulticlusterscheduler ;
    rdfs:range hpc:Resourcematchingcriteria .

hpc:Resourcematchingcriteria a owl:Class ;
    rdfs:subClassOf owl:Thing .
