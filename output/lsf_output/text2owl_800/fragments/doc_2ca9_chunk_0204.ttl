hpc:Command a owl:Class .
hpc:resourcerequirementstring a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Bacct a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:expansionfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:averageexpansionfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Expansionfactor .

hpc:maximumexpansionfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Expansionfactor .

hpc:minimumexpansionfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Expansionfactor .

hpc:eligiblependingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:totalpendingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:ineligiblependingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:energyconsumption a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:turnaroundtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:waittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:schedulerefficiency a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:storagepoolbytes a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:resourceconnectoraccountname a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:lsbacctlogfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:lsbparamsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:lsfconffile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:lsfversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:fixpackversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct .

hpc:gpuresourceusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:boolean .

hpc:ibmspectrumscaleioaccounting a owl:DatatypeProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:boolean .
