hpc:Host a owl:Class .
hpc:Host rdfs:subClassOf rdf:Resource .
hpc:hasname a owl:ObjectProperty .
hpc:Hasname rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:hascpulist a owl:ObjectProperty .
hpc:Hascpulist rdfs:domain hpc:Host ;
    rdfs:range rdf:List .

hpc:Cpu a owl:Class .
hpc:Cpu rdfs:subClassOf rdf:Resource .
hpc:hassocket a owl:ObjectProperty .
hpc:Hassocket rdfs:domain hpc:Cpu ;
    rdfs:range rdf:List .

hpc:Socket a owl:Class .
hpc:Socket rdfs:subClassOf rdf:Resource .
hpc:hascore a owl:ObjectProperty .
hpc:Hascore rdfs:domain hpc:Socket ;
    rdfs:range xsd:integer .

hpc:Numanode a owl:Class .
hpc:Numanode rdfs:subClassOf rdf:Resource .
hpc:hasmemory a owl:DatatypeProperty .
hpc:Hasmemory rdfs:domain hpc:Numanode ;
    rdfs:range xsd:decimal .

hpc:loadsched a owl:ObjectProperty .
hpc:Loadsched rdfs:domain hpc:Host ;
    rdfs:range rdf:List .

hpc:loadthreshold a owl:DatatypeProperty .
hpc:Loadthreshold rdfs:domain hpc:Loadsched ;
    rdfs:range xsd:string .

hpc:loadstop a owl:ObjectProperty .
hpc:Loadstop rdfs:domain hpc:Host .

hpc:affinityenabled a owl:ObjectProperty .
hpc:Affinityenabled rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:configuredaffinitycpulist a owl:DatatypeProperty .
hpc:Configuredaffinitycpulist rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Gpu a owl:Class .
hpc:Gpu rdfs:subClassOf rdf:Resource .
hpc:hashostname a owl:ObjectProperty .
hpc:Hashostname rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string .

hpc:hasgpuid a owl:ObjectProperty .
hpc:Hasgpuid rdfs:domain hpc:Gpu ;
    rdfs:range rdf:List .

hpc:hasmodelname a owl:DatatypeProperty .
hpc:Hasmodelname rdfs:domain hpc:Gpu ;
    rdfs:range xsd:string .

hpc:hasmused a owl:DatatypeProperty .
hpc:Hasmused rdfs:domain hpc:Gpu ;
    rdfs:range xsd:decimal .

hpc:gpuoption a owl:ObjectProperty .
hpc:Gpuoption rdfs:domain rdf:Resource ;
    rdfs:range xsd:string .
