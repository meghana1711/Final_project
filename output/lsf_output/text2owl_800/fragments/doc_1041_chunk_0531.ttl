hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Advancereservation .

hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Reservation ;
    rdfs:subClassOf hpc:Jobreservation ;
    rdfs:subClassOf hpc:Systemreservation .

hpc:Jobreservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Reservation .

hpc:Systemreservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Reservation .

hpc:numberUnit a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:queueName a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range rdf:List .

hpc:AllowedQueue a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:subClassOf rdf:Bag ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf hpc:Queuename .

hpc:Queuename a owl:Class ;
    rdfs:subClassOf rdf:Literal .

hpc:resourceRequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Resourcerequirement .

hpc:Resourcerequirement a owl:Class .
