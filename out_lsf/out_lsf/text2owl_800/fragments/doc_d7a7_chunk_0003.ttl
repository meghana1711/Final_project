hpc:Installationsite a owl:Class .
hpc:Fileserver a owl:Class .
hpc:loginasroot a owl:ObjectProperty .
hpc:download a owl:ObjectProperty .
hpc:decompress a owl:ObjectProperty .
hpc:extract a owl:ObjectProperty .
hpc:Platform a owl:Class .
hpc:kernelversion a owl:DatatypeProperty .
hpc:architecture a owl:DatatypeProperty .
hpc:Distributiondirectory a owl:Class .
hpc:silentinstall a owl:ObjectProperty .
hpc:setupconfig a owl:ObjectProperty .
hpc:confirmpath a owl:ObjectProperty .
hpc:lsfconf a owl:DatatypeProperty .
hpc:Distributionfile a owl:Class .
hpc:tarball a owl:DatatypeProperty .
hpc:Distributiondirectory rdfs:subClassOf hpc:Installationsite .
hpc:Distributionfile rdfs:subClassOf hpc:File .
hpc:Loginasroot rdfs:domain hpc:Installationsite ;
    rdfs:range xsd:string .
hpc:Download rdfs:domain hpc:Installationsite ;
    rdfs:range hpc:Distributionfile .
hpc:Decompress rdfs:domain hpc:Installationsite ;
    rdfs:range xsd:string .
hpc:Extract rdfs:domain hpc:Installationsite ;
    rdfs:range xsd:string .
hpc:Platform rdfs:range xsd:string .
hpc:Kernelversion rdfs:domain hpc:Platform ;
    rdfs:range xsd:string .
hpc:Architecture rdfs:domain hpc:Platform ;
    rdfs:range xsd:string .
hpc:Distributiondirectory rdfs:subClassOf hpc:Installationsite .
hpc:Silentinstall rdfs:domain hpc:Distributiondirectory ;
    rdfs:range xsd:boolean .
hpc:Setupconfig rdfs:domain hpc:Distributiondirectory ;
    rdfs:range hpc:Setupconfig .
hpc:Confirmpath rdfs:domain hpc:Setupconfig ;
    rdfs:range xsd:string .
hpc:Lsfconf rdfs:domain hpc:Setupconfig ;
    rdfs:range xsd:string .
hpc:Distributionfile rdfs:subClassOf hpc:File .
hpc:Tarball rdfs:domain hpc:Distributionfile ;
    rdfs:range xsd:string .
