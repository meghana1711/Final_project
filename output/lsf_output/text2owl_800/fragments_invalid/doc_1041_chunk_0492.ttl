# Datatype Properties
hpc:Hasapplicationprofilename rdfs:domain hpc:Bresumecommand ;
  rdfs:range xsd:string .

# Class Relations
hpc:Brestartcommand rdfs:subClassOf hpc:Command .
hpc:Esubfile rdfs:subClassOf hpc:Executablefile .
hpc:Mandatoryesubfile rdfs:subClassOf hpc:Esubfile .
