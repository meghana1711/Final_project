hpc:Appy a owl:Class .
hpc:resourcerequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:Appy ;
    rdfs:range xsd:string .
hpc:commandline a owl:ObjectProperty ;
    rdfs:domain hpc:Appy .
hpc:Xsession a owl:Class .
hpc:Xdesktopenvironment a owl:Class ;
    rdfs:subClassOf hpc:Xsession .
hpc:Resource a owl:Class .
hpc:resourceorder a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range rdfs:Resource .
hpc:Lslaunch a owl:Class .
hpc:Lsxterm a owl:Class ;
    rdfs:subClassOf hpc:Lslaunch .
hpc:Totalviewdebugging a owl:Class .
hpc:Totalview a owl:Class .
hpc:etnustotalview a owl:ObjectProperty ;
    rdfs:domain hpc:Totalviewdebugging ;
    rdfs:range hpc:Totalview .
