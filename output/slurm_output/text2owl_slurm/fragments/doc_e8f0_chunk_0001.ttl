hpc:Plugin a owl:Class .
hpc:pluginname a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .

hpc:plugintype a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .

hpc:Jobsubmitplugin a owl:Class ;
    rdfs:subClassOf hpc:Plugin .

hpc:Allpartitionsplugin a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmitplugin .

hpc:Defaultsplugin a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmitplugin .

hpc:Loggingplugin a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmitplugin .

hpc:Luaplugin a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmitplugin ;
    rdfs:subClassOf hpc:Pluginwithscript .

hpc:Pluginwithscript a owl:Class .
hpc:scriptname a owl:DatatypeProperty ;
    rdfs:domain hpc:Pluginwithscript ;
    rdfs:range xsd:string .

hpc:scriptlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Pluginwithscript ;
    rdfs:range xsd:string .

hpc:scriptrequired a owl:ObjectProperty ;
    rdfs:domain hpc:Pluginwithscript ;
    rdfs:range hpc:Plugin ;
    rdfs:range hpc:Jobsubmitplugin .
