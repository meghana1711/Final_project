hpc:Lsfdatamanager a owl:Class .
hpc:Job a owl:Class .
hpc:Executionnode a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Cache a owl:Class .
hpc:Executionenvironment a owl:Class .
hpc:Datafile a owl:Class .
hpc:Remotedatamanager a owl:Class .
hpc:Localdatamanager a owl:Class .
hpc:Lsfmanagementhost a owl:Class .
hpc:Datastagingstep a owl:Class .
hpc:Jobsubmission a owl:Class .
hpc:Transferjob a owl:Class .
hpc:Datarequirement a owl:Class .
hpc:Candidatecluster a owl:Class .
hpc:Clusterpreference a owl:Class .

hpc:hasDataManager rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Lsfdatamanager .

hpc:isScheduled rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executionnode .

hpc:requiresData rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Datafile .

hpc:isRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Executionnode .

hpc:findsData rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Runningjob ;
    rdfs:range hpc:Stagingarea .

hpc:determinesLocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Cache .

hpc:determinesLocationInEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range hpc:Executionenvironment .

hpc:hasRemoteDataManagers rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Remotedatamanager .

hpc:isConnectedTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range hpc:Localdatamanager .

hpc:submitJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobsubmission .

hpc:hasDataSourceHost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .

hpc:hasFilePath rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string .

hpc:hasFileSize rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:decimal .

