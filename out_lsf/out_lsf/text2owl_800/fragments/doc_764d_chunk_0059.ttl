hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:queueid a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:totalslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .

hpc:availableslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:runningslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:pendingslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:preemptableavailableslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:Preemptablequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:preemptablequeueid a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablequeue ;
    rdfs:range xsd:integer .

hpc:preemptablequeuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablequeue ;
    rdfs:range xsd:integer .

hpc:preemptableavailableslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablequeue ;
    rdfs:range xsd:decimal .

hpc:Preemptablequeuecounters a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:haspreemptablequeuecounter a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptablequeuecounters ;
    rdfs:range hpc:Preemptablequeuecounter .

hpc:Preemptablequeuecounter a owl:Class ;
    rdfs:subClassOf hpc:Counter .

hpc:MC_PLUGIN_UPDATE_INTERVAL a xsd:duration .
hpc:MC_PLUGIN_SCHEDULE_ENHANCE a xsd:boolean .
