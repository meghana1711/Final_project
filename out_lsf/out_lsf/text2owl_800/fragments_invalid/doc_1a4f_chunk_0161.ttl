hpc:Jobgroup a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:Bondgroup a owl:Class .
hpc:Riskgroup a owl:Class .
hpc:Admigroup a owl:Class .

hpc:Hasserviceclass hpc:objectproperty .
hpc:Hasserviceclass rdfs:domain hpc:Jobgroup ;
                      rdfs:range hpc:Serviceclass .

hpc:Suspendjob hpc:objectproperty .
hpc:Suspendjob rdfs:domain hpc:Jobgroup ;
               rdfs:range xsd:integer .

hpc:Resumejob hpc:objectproperty .
hpc:Resumejob rdfs:domain hpc:Jobgroup ;
              rdfs:range xsd:integer .

hpc:Movejob hpc:objectproperty .
hpc:Movejob rdfs:domain hpc:Jobgroup ;
            rdfs:range xsd:integer .

hpc:Terminatejob hpc:objectproperty .
hpc:Terminatejob rdfs:domain hpc:Jobgroup ;
                rdfs:range xsd:integer .

hpc:Deletejobgroup hpc:objectproperty .
hpc:Deletejobgroup rdfs:domain hpc:Jobgroup ;
                rdfs:range xsd:integer .

hpc:Modifyjobgrouplimit hpc:objectproperty .
hpc:Modifyjobgrouplimit rdfs:domain hpc:Jobgroup ;
                rdfs:range xsd:integer .
