hpc:Procedure a owl:Class .
hpc:Host a owl:Class .
hpc:Filesystem a owl:Class .
hpc:Package a owl:Class .
hpc:Tarfile a owl:Class .
hpc:Directory a owl:Class .
hpc:installationdirectory a owl:DatatypeProperty .
hpc:Highavailability a owl:Class .
hpc:Environmentvariable a owl:Class .
hpc:variablename a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:examplevalue a owl:DatatypeProperty .

hpc:Procedure rdfs:subClassOf hpc:Highavailabilityinstallation .
hpc:Host rdfs:subClassOf hpc:Highavailabilityenvironment .
hpc:Filesystem rdfs:subClassOf hpc:Highavailabilityresource .
hpc:Package rdfs:subClassOf hpc:Softwarepackage .
hpc:Tarfile rdfs:subClassOf hpc:Package .
hpc:Directory rdfs:subClassOf hpc:Tarfile .

hpc:Installationdirectory rdfs:domain hpc:Highavailabilityinstallation ;
    rdfs:range xsd:string .

hpc:Highavailabilityenvironment rdfs:subClassOf hpc:Environment ;
    rdfs:subClassOf hpc:Host .

hpc:Environment rdfs:subClassOf hpc:Resource .

hpc:Highavailabilityresource rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .

hpc:Softwarepackage a owl:Class .

hpc:Package rdfs:subClassOf hpc:Softwarepackage .

hpc:Tarfile rdfs:subClassOf hpc:Package .

hpc:Directory rdfs:subClassOf hpc:Tarfile .

hpc:Filesystem rdfs:subClassOf hpc:Resource .

hpc:Procedure rdfs:subClassOf hpc:Action .
