hpc:LsfPasswdDir a owl:Class .
hpc:LsfPimInfodir a owl:Class .

hpc:haslocation a owl:ObjectProperty ;
    rdfs:domain hpc:LsfPasswdDir ;
    rdfs:range xsd:string .

hpc:writesfile a owl:ObjectProperty ;
    rdfs:domain hpc:LsfPimInfodir ;
    rdfs:range xsd:string .

hpc:hasdefaultlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfPasswdDir ;
    rdfs:range xsd:string .

hpc:hasprocessinfofile a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfPimInfodir ;
    rdfs:range xsd:string .

hpc:requiresreadwritepermissions a owl:ObjectProperty ;
    rdfs:domain hpc:LsfPasswdDir .

hpc:EgoPimInfodir a owl:Class ;
    rdfs:subClassOf hpc:LsfPimInfodir .

hpc:hasegoparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:EgoPimInfodir ;
    rdfs:range xsd:string .

hpc:hasnodefault a owl:DatatypeProperty ;
    rdfs:domain hpc:EgoPimInfodir .
