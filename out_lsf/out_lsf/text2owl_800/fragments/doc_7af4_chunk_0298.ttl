hpc:Jobdependencyevaluation a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Schedulingsession ;
    rdfs:comment "The process of evaluating job dependencies." .

hpc:Schedulingsession a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A time period during which jobs are dispatched." .

hpc:jobdispatch a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Schedulingsession ;
    rdfs:comment "The act of dispatching a job to a scheduling session." .

hpc:jobdependencyevaluationorder a owl:ObjectProperty ;
    rdfs:domain hpc:Jobdependencyevaluation ;
    rdfs:range xsd:Integer ;
    rdfs:comment "The order in which job dependencies are evaluated." .

hpc:jobdependencyevaluationstartlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdependencyevaluation ;
    rdfs:range xsd:string ;
    rdfs:comment "The endpoint from which job dependency evaluation starts." .

hpc:jobdependencyevaluationendlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdependencyevaluation ;
    rdfs:range xsd:string ;
    rdfs:comment "The endpoint where job dependency evaluation ends." .

hpc:jobdispatchorder a owl:ObjectProperty ;
    rdfs:domain hpc:Jobdispatch ;
    rdfs:range xsd:Integer ;
    rdfs:comment "The order in which jobs are dispatched." .

hpc:jobdispatchdelay a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The delay in dispatching a job due to dependency evaluation." .

hpc:evaluateJobDependency a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum number of jobs that are evaluated in one scheduling cycle." .

hpc:evaluateJobDependencyTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration ;
    rdfs:comment "The explicit time limit for job dependency evaluation." .

hpc:evaluateWaitConditionTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration ;
    rdfs:comment "A limit to the amount of time that the mbatchd daemon spends on evaluating the bwait wait conditions." .
