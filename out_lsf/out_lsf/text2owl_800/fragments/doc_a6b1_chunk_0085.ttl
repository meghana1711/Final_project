hpc:Jobexception a owl:Class .
hpc:Jobunderrun a owl:Class .
hpc:Joboverrun a owl:Class .
hpc:Idlejob a owl:Class .

hpc:hasthreshold a owl:ObjectProperty .

hpc:jobunderrunthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobunderrun ;
    rdfs:range xsd:nonNegativeInteger .

hpc:joboverrunthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboverrun ;
    rdfs:range xsd:nonNegativeInteger .

hpc:idlejobthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Idlejob ;
    rdfs:range xsd:decimal .

hpc:JobIdle a hpc:IdleJob ;
    hpc:Hasthreshold hpc:jobIdle .

hpc:JobOverrun a hpc:JobOverrun ;
    hpc:Hasthreshold hpc:jobOverrun .

hpc:JobUnderrun a hpc:JobUnderrun ;
    hpc:Hasthreshold hpc:jobUnderrun .
