hpc:Status a owl:Class .
hpc:Disconnected rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:Rejected rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:Ok rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Status ;
    rdfs:range xsd:string .
hpc:Gpolicyd a owl:Class .
hpc:GPOLICYD_HOST rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpolicyd ;
    rdfs:range xsd:string .
hpc:GPOLICYD_CLUSTER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpolicyd ;
    rdfs:range xsd:string .
hpc:Globalfairsharepolicy a owl:Class .
hpc:PolicyName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Globalfairsharepolicy ;
    rdfs:range xsd:string .
hpc:ParticipantsStatus rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Globalfairsharepolicy ;
    rdfs:range hpc:Participantstatus .
hpc:Participantstatus a owl:Class .
hpc:PolicyName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Participantstatus ;
    rdfs:range xsd:string .
hpc:Cluster rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Participantstatus ;
    rdfs:range xsd:string .
hpc:Status rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Participantstatus ;
    rdfs:range xsd:string .
hpc:bhist a owl:ObjectProperty .
hpc:bhist_options rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:string .
