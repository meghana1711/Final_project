hpc:Workgroupusermanagement a owl:Class .
hpc:Useraccount a owl:Class .

hpc:Modifyuseraccounts hpc:Workgroupusermanagement rdfs:subClassOf owl:ObjectProperty .
hpc:Removeuseraccounts hpc:Workgroupusermanagement rdfs:subClassOf owl:ObjectProperty .
hpc:Hasusername hpc:Modifyuseraccounts rdfs:domain hpc:Workgroupusermanagement ;
                                          rdfs:range xsd:string .
hpc:Affectedhost rdfs:domain hpc:Modifyuseraccounts ;
                  rdfs:range xsd:string .
hpc:Result rdfs:domain hpc:Modifyuseraccounts ;
              rdfs:range xsd:string .
hpc:Haspassword hpc:Modifyuseraccounts rdfs:domain hpc:Workgroupusermanagement ;
                               rdfs:range xsd:string .
hpc:Hasadminprivileges hpc:Workgroupusermanagement rdfs:domain hpc:Workgroupusermanagement ;
                              rdfs:range xsd:boolean .
hpc:Runonworkgroup hpc:Workgroupusermanagement rdfs:domain hpc:Workgroupusermanagement ;
                         rdfs:range xsd:boolean .
hpc:Requireshostinworkgroup hpc:workgroupusermanagement rdfs:subPropertyOf hpc:runOnWorkgroup .
hpc:Hasrequiredusernames hpc:Modifyuseraccounts rdfs:domain hpc:Workgroupusermanagement ;
                                 rdfs:range rdf:List .
hpc:listmember rdf:List a owl:ObjectProperty ;
                   rdfs:domain rdf:List ;
                   rdfs:range xsd:string .

hpc:Removeuseraccount hpc:Removeuseraccounts rdfs:subClassOf hpc:Modifyuseraccount .
