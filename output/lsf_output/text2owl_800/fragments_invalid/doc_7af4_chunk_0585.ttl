hpc:User a owl:Class .
hpc:Windowsuser a owl:Class .
hpc:Unixuser a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Administrator a owl:Class .
hpc:Windowsadministrator a owl:Class .
hpc:Unixadministrator a owl:Class .
hpc:Groupadministrator a owl:Class .
hpc:hasFullRights an owl:ObjectProperty .
hpc:isMember an owl:ObjectProperty .
hpc:hasadminrights a owl:DatatypeProperty .
hpc:usergroupcontrol a owl:DatatypeProperty .
hpc:Usergroupcontrol rdfs:range xsd:string .
hpc:strictugcontrol a owl:DatatypeProperty .
hpc:Strictugcontrol rdfs:range xsd:string .
hpc:User rdfs:subClassOf [ a owl:Restriction ;
                              rdf:property hpc:UserGroupControl ;
                              owl:allValuesFrom xsd:string ;
                              owl:onClass hpc:UserGroup ;
                              owl:someValuesFrom (hpc:StrictUGControl "Y"^^xsd:string) ] .
hpc:Groupadministrator rdfs:domain hpc:Usergroup .
hpc:Groupadministrator rdfs:range [ a owl:Restriction ;
                                       rdf:property hpc:hasAdminRights ;
                                       owl:onClass hpc:Administrator ] .
hpc:Hasfullrights rdfs:domain hpc:Usergroup .
hpc:Hasfullrights rdfs:domain hpc:Administrator .
hpc:Hasfullrights rdfs:range hpc:Usergroup .
hpc:Ismember rdfs:domain hpc:Usergroup .
hpc:Ismember rdfs:range hpc:User .
