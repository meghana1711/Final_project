@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Loglevel a owl:Class .
hpc:Loglevel rdfs:domain hpc:Loglevel .
hpc:Loglevel rdfs:range xsd:string .

hpc:Slurmddebug rdfs:subClassOf hpc:Loglevel .
hpc:defaultLogLevel owl:equivalentTo hpc:info .

hpc:Nodename a owl:Class .
hpc:Nodename rdfs:domain hpc:Nodename .
hpc:Nodename rdfs:range xsd:string .

hpc:Nodenameinslurmconf rdfs:subClassOf hpc
