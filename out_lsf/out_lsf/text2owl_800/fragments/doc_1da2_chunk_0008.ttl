hpc:Jobstarter a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "In the job starter." .

hpc:Commandline a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "From the command line." .

hpc:clearcaseRoot a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobstarter, hpc:Commandline ;
    rdfs:range xsd:string ;
    rdfs:comment "The ClearCase root directory." .

hpc:daemonWrapDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandline ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables daemon wrapper debugging for the LSF integration for Rational ClearCase." .

hpc:setenv a owl:ObjectProperty ;
    rdfs:domain hpc:Commandline ;
    rdfs:range hpc:Commandline ;
    rdfs:comment "Sets an environment variable in csh or tcsh." .

hpc:setenv1 a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:setenv ;
    rdfs:domain hpc:Commandline ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the environment variable to 1." .

hpc:export a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:setenv ;
    rdfs:domain hpc:Commandline ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the environment variable in sh, ksh, or bash." .

hpc:daemonWrapDebug1 a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The value 1 for DAEMON_WRAP_DEBUG." .

hpc:rdfsLog a owl:ObjectProperty ;
    rdfs:domain hpc:DaemonWrapDebug ;
    rdfs:range xsd:string ;
    rdfs:comment "The log file where ClearCase stdout and stderr streams are logged." .

hpc:Obsolete a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Obsolete." .

hpc:nocheckviewPostexec a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandline ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Configures the daemon wrapper to skip running the checkView function during the post-execution phase of a job." .

hpc:setenv2 a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:setenv ;
    rdfs:domain hpc:Commandline ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the NOCHECKVIEW_POSTEXEC environment variable to 1." .
