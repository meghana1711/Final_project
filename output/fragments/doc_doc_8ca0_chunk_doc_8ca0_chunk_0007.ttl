hpc:SuspendProgram a owl:Class .
hpc:SuspendProgram rdfs:subClassOf owl:NamedIndividual .

hpc:executes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SuspendProgram ;
    rdfs:range rdf:Resource .

hpc:SlurmUser rdf:type owl:Class .

hpc:hostlistExpressionFormat rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SuspendProgram .

hpc:SuspendRate a owl:Class .
hpc:SuspendRate rdfs:subClassOf xsd:nonNegativeInteger .

hpc:SuspendTime a owl:Class .
hpc:SuspendTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SuspendProgram .
    rdfs:range xsd:nonNegativeInteger .

hpc:SuspendTimeout a owl:Class .
hpc:SuspendTimeout rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SuspendProgram .
    rdfs:range xsd:positiveInteger .

hpc:NodeConfiguration a owl:Class .

hpc:NodeFeature a owl:Class .
hpc:NodeFeature rdfs:subClassOf owl:NamedIndividual .

hpc:name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:NodeFeature .
    rdfs:range rdf:Literal .

hpc:Feature rdf:type owl:Class .
