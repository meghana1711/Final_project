hpc:Localadministratorsgroup a owl:Class .
hpc:Host a owl:Class .
hpc:Lsfinstallation a owl:Class .
hpc:Lsfdistributionfile a owl:Class .
hpc:downloadstep a owl:ObjectProperty .
hpc:Managementhost a owl:Class .
hpc:performancescalability a owl:ObjectProperty .
hpc:Powerfulmanagementhost a owl:Class .
hpc:Windowsserver2012 a owl:Class .
hpc:remotedesktopservices a owl:ObjectProperty .
hpc:quickstart a owl:ObjectProperty .
hpc:sessionbaseddesktopdeployment a owl:ObjectProperty .
hpc:Domainuser a owl:Class .
hpc:addrolesandfeatureswizard a owl:ObjectProperty .
hpc:logon a owl:ObjectProperty .
hpc:start a owl:ObjectProperty .
hpc:Deploymentscenario rdfs:domain hpc:Remotedesktopservices ;
    rdfs:range hpc:Deploymentscenariovalue .
hpc:Deploymentscenariovalue a owl:Class .
hpc:Sessionbaseddesktopdeployment rdfs:subClassOf hpc:Deploymentscenariovalue .
hpc:Powerfulmanagementhost rdfs:subClassOf hpc:Managementhost .
hpc:Host rdfs:subClassOf hpc:Localadministratorsgroup .
hpc:Lsfinstallation rdfs:subClassOf hpc:Host .
hpc:Lsfdistributionfile rdfs:subClassOf hpc:File .
hpc:Downloadstep rdfs:domain hpc:Lsfinstallation ;
    rdfs:range hpc:Lsfdistributionfile .
hpc:Performancescalability rdfs:domain hpc:Managementhost .
hpc:Performancescalability rdfs:range hpc:Powerfulmanagementhost .
