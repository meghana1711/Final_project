hpc:Lsfpredictor a owl:Class .
hpc:supportsmulticlustermode a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictor ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Predictor does not support multicluster mode." .

hpc:Lsfpredictorversion101 a owl:Class ;
    rdfs:subClassOf hpc:Lsfpredictor .

hpc:singlelsfclustersupport a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictorversion101 ;
    rdfs:range xsd:boolean ;
    rdfs:comment "LSF Predictor 10.1 only works with a single LSF cluster." .

hpc:fairshareusergroupsnotimportedwithworkloadsnapshot a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictor ;
    rdfs:range xsd:boolean ;
    rdfs:comment "User groups defined in queue level as fairshare are not imported when you import a workload snapshot." .

hpc:Importedfairshareusergroups a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "User groups defined in bsub -G are imported properly." .

hpc:installationprerequisite a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictor ;
    rdfs:range hpc:Operatingsystem ;
    rdfs:comment "Consider the following prerequisites when selecting a host for installing LSF Predictor:" .

hpc:Cloudpakfordata a owl:Class ;
    rdfs:comment "IBM Spectrum LSF Predictor uses AutoAI in IBM Cloud Pak for Data 4.0 as the training engine." .

hpc:requirescloudpakfordata a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfpredictor ;
    rdfs:range hpc:Cloudpakfordata ;
    rdfs:comment "It is required to have Cloud Pak for Data installed and running for LSF Predictor." .

hpc:Supportedoperatingsystem a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "LSF Predictor supports the following Linux operating systems running on x64 platforms:" .

hpc:requiresdockerce a owl:ObjectProperty ;
    rdfs:domain hpc:Supportedoperatingsystem ;
    rdfs:range xsd:string ;
    rdfs:comment "Docker CE (docker-ce) 19.03, or later, must be installed and running." .
