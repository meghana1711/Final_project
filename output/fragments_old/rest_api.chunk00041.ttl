# Classes
hpc:Association a owl:Class .
hpc:Account a owl:Class .
hpc:QOS a owl:Class .
hpc:Partition a owl:Class .
hpc:Cluster a owl:Class .
hpc:Plugin a owl:Class .
hpc:Client a owl:Class .
hpc:Warning a owl:Class .
hpc:Error a owl:Class .

# Object Properties
hpc:hasPriority a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .
hpc:hasPriorityThreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .
hpc:hasParentAccount a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:hasDefaultQOS a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range rdf:List .
hpc:hasMinPriorityThreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .
hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:hasQOS a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range rdf:List .
hpc:hasComment a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:hasID a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:integer .
hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:hasAccount a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .

# Datatype Properties
hpc:hasLineage a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:hasSharesRaw a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:integer .

# Class Hierarchy
hpc:Association rdfs:subClassOf hpc:Account .

# Plugin Properties
hpc:hasCluster
