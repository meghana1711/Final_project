@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:resourcereq a owl:DatatypeProperty .
hpc:Hasresourcereq rdfs:domain hpc:Host ;
                    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty .
hpc:Hashostname rdfs:domain hpc:Host ;
              rdfs:range xsd:string .

hpc:hoststatus a owl:DatatypeProperty .
hpc:Hashoststatus rdfs:domain hpc:Host ;
               rdfs:range xsd:string .

hpc:jobstatestats a owl:ObjectProperty .
hpc:Hasjobstatestats rdfs:domain hpc:Host ;
               rdfs:range hpc:Jobstatestats .

hpc:jobslotlimits a owl:ObjectProperty .
hpc:Hasjobslotlimits rdfs:domain hpc:Host ;
               rdfs:range hpc:Jobslotlimit .

hpc:Hostgroup a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Cluster a owl:Class .

hpc:bhosts a owl:ObjectProperty .
hpc:bhostsCondensed rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostscondensed rdfs:domain hpc:Host ;
               rdfs:range hpc:Host .

hpc:bhostsResource rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostsresource rdfs:domain hpc:Host ;
               rdfs:range rdf:Resource .

hpc:bhostsAffinity rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostsaffinity rdfs:domain hpc:Host ;
               rdfs:range hpc:Host .

hpc:bhostsCluster rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostscluster rdfs:domain hpc:Host ;
               rdfs:range hpc:Cluster .

hpc:bhostsResourceName rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostsresourcename rdfs:domain hpc:Bhosts ;
               rdfs:range rdf:PlainLiteral .

hpc:bhostsAffinityFlag rdfs:subPropertyOf hpc:bhosts .
hpc:Bhostsaffinityflag rdfs:domain hpc:Bhosts ;
               rdfs:range xsd:boolean .

hpc:bhostsListResource rdfs:subPropertyOf hpc:bhosts .
hpc:bhostsListResource rdfs:
