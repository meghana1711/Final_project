hpc:Jobsubmitter a owl:Class .
hpc:Jobsubmitterscript rdfs:domain hpc:Jobsubmitter ;
                        rdfs:range xsd:string ;
                        rdfs:label "job_submit_script" .
hpc:Installedat rdfs:domain hpc:Jobsubmitter ;
                 rdfs:range xsd:string ;
                 rdfs:label "installed_at" .
hpc:Installationlocation rdfs:domain hpc:Jobsubmitter ;
                        rdfs:range xsd:string ;
                        rdfs:label "installation_location" .
