hpc:isignored a owl:DatatypeProperty ;
 rdfs:domain hpc:Featurelist ;
 rdfs:range xsd:boolean .

hpc:hasslot a owl:ObjectProperty .

hpc:currentjobslotsinuse a owl:DatatypeProperty ;
 rdfs:domain hpc:Slot .

hpc:peakjobslotsused a owl:DatatypeProperty ;
 rdfs:domain hpc:Slot .

