hpc:Planbasedscheduling a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A scheduling approach that aims to replace legacy LSF reservation policies." .

hpc:Allocationplanner a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A feature in LSF that extends job run limits when the resources are not needed by other jobs." .

hpc:estimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Allocationplanner ;
    rdfs:range xsd:nonNegativeInteger .

hpc:plan a owl:ObjectProperty ;
    rdfs:domain hpc:Allocationplanner ;
    rdfs:range hpc:Plan .

hpc:allocatedresources a owl:ObjectProperty ;
    rdfs:domain hpc:Planbasedscheduling ;
    rdfs:range hpc:Resource .

hpc:extendablerunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A collection of jobs waiting to be executed." .

hpc:Jobforwardingrestriction a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A feature that allows restricting users or user groups from forwarding jobs to remote clusters." .

hpc:Userorusergroup a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A class representing a user or a group of users." .

hpc:Defaultepsubprogram a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An executable file that runs even if no mandatory epsub programs are defined." .

hpc:lsbEsubMethod a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Epsubprogram .

hpc:Epsubprogram a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An executable file that controls the execution of jobs." .
