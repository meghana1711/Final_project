hpc:Schedmetricenable rdfs:range xsd:string .

hpc:schedmetricsampleperiod a owl:DatatypeProperty .
hpc:Schedmetricsampleperiod rdfs:domain xsd:duration .
hpc:Schedmetricsampleperiod rdfs:range xsd:duration .

hpc:Usergroup a owl:Class .

