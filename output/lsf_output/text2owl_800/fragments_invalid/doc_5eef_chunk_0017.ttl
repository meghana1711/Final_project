hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Cacheableresource ;
    rdfs:comment "Represents a file in the context of the LSF data manager." .

hpc:Cacheableresource a owl:Class ;
    rdfs:comment "Represents a resource that can be cached by the LSF data manager." .

hpc:Linkedfile a owl:Class ;
    rdfs:subClassOf hpc:File ;
    rdfs:comment "Represents a file that is symbolically linked in the cache." ;
    rdfs:subClassOf hpc:Cachedresource ;
    rdfs:comment "Represents a resource that is cached by the LSF data manager and has a symbolic link." .

hpc:Cachedresource a owl:Class ;
    rdfs:subClassOf hpc:File ;
    rdfs:comment "Represents a resource that is cached by the LSF data manager." .

hpc:Transferjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that transfers a file." .

hpc:graceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:duration ;
    rdfs:comment "Represents the remaining hours and minutes of the grace period for a file." .

hpc:LinkedStatus owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a file is symbolically linked." .

hpc:RefJob owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Job ;
    rdfs:comment "Represents the job ID of the transfer job associated with a file." .

hpc:TransferStatus owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the status of the transfer job associated with a file." .

hpc:Job a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "Represents a job in the LSF data manager." .
