hpc:Model a owl:Class .
hpc:architecture a owl:DatatypeProperty .
hpc:modelname a owl:ObjectProperty .
hpc:hardwareplatform a owl:DatatypeProperty .
hpc:processorspeed a owl:DatatypeProperty .
hpc:processortype a owl:DatatypeProperty .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:interval a owl:DatatypeProperty .
hpc:increasing a owl:DatatypeProperty .
hpc:consumable a owl:DatatypeProperty .
hpc:patchrev a owl:DatatypeProperty .
hpc:specman a owl:DatatypeProperty .
hpc:switch a owl:DatatypeProperty .
hpc:rack a owl:DatatypeProperty .
hpc:owner a owl:DatatypeProperty .
hpc:elimres a owl:DatatypeProperty .
hpc:ostype a owl:DatatypeProperty .
hpc:lmhostid a owl:DatatypeProperty .
hpc:limversion a owl:DatatypeProperty .

hpc:Model rdfs:subClassOf owl:Class .
hpc:Architecture rdfs:domain hpc:Model ;
                   rdfs:range xsd:string .
hpc:Modelname rdfs:domain hpc:Model ;
               rdfs:range xsd:string .
hpc:Hardwareplatform rdfs:domain hpc:Model ;
                rdfs:range xsd:string .
hpc:Processorspeed rdfs:domain hpc:Model ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Processortype rdfs:domain hpc:Model ;
               rdfs:range xsd:string .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:Resourcename rdfs:domain hpc:Resource ;
               rdfs:range xsd:string .
hpc:Description rdfs:domain hpc:Resource ;
               rdfs:range xsd:string .
hpc:Type rdfs:domain hpc:Resource ;
               rdfs:range xsd:string .
hpc:Interval rdfs:domain hpc:Resource ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Increasing rdfs:domain hpc:Resource ;
               rdfs:range xsd:boolean .
hpc:Consumable rdfs:domain hpc:Resource ;
               rdfs:range xsd:boolean .
hpc:Patchrev rdfs:domain hpc:Resource ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Specman rdfs:domain hpc:Resource ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Switch rdfs:domain hpc:Resource ;
               rdfs:range xsd:nonNegativeInteger .
hpc:Rack rdfs:domain hpc:Resource ;
               rdfs:range xsd:string .
hpc:Owner rdfs:domain hpc:Resource ;
               rdfs:range xsd
