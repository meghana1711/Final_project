hpc:Ipaddressrange a owl:Class .
hpc:Ipv4range a owl:Class .
hpc:Ipv6range a owl:Class .
hpc:Ipaddress a owl:Class .

hpc:Ipaddressrange rdfs:subClassOf owl:Class .
hpc:Ipv4range rdfs:subClassOf hpc:Ipaddressrange .
hpc:Ipv6range rdfs:subClassOf hpc:Ipaddressrange .
hpc:Ipaddress rdfs:subClassOf hpc:Ipaddressrange .

hpc:hasipaddress a owl:ObjectProperty .
hpc:Ipv4range rdfs:domain hpc:Ipaddressrange ;
                 rdfs:range xsd:string .
hpc:Ipv6range rdfs:domain hpc:Ipaddressrange ;
                 rdfs:range xsd:string .
hpc:Hasipaddress rdfs:domain hpc:Ipaddressrange ;
                 rdfs:range hpc:Ipaddress .
