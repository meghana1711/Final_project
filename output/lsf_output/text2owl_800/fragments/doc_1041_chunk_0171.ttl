hpc:hasJobLimit
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of jobs a job group can contain." .

hpc:hasParentJobGroup
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup ;
    rdfs:comment "The parent job group of a job group." .

hpc:isRootJobGroup
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a job group is the root job group (has no parent)." .

hpc:hasSLA
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Sla ;
    rdfs:comment "The Service Level Agreement associated with a job group." .

hpc:SLA
    a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a Service Level Agreement in the HPC system." .

hpc:JobGroupName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string ;
    rdfs:maxLength "512" ;
    rdfs:comment "The name of a job group." .

hpc:hasServiceClass
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Serviceclass ;
    rdfs:comment "The service class associated with a job group." .

hpc:ServiceClass
    a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a service class in the HPC system." .

hpc:GlobalLimitScheduling
    a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether global limit scheduling is enabled for a job group." .

hpc:LSBParamsFile
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The path to the LSB parameters file." .

hpc:ENABLE_DEFAULT_EGO_SLA
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the default EGO SLA is enabled for a job group." .
