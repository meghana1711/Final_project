hpc:lsbJsmDefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specifies the default value for the bsub -jsm option for CSM jobs." .

hpc:lsbStageInExec a owl:ObjectProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range hpc:Directdatastaging ;
    rdfs:comment "Specifies the stage in script for direct data staging (for example, IBM CAST burst buffer)." .

hpc:lsbStageMaxStageIn a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the maximum number of concurrent stage in processes that can run on the host." .

hpc:lsbStageOutExec a owl:ObjectProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range hpc:Directdatastaging ;
    rdfs:comment "Specifies the stage out script for direct data staging (for example, IBM CAST burst buffer)." .

hpc:lsbStageStorage a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the resource name to report available storage space for direct data staging (for example, IBM CAST burst buffer)." .

hpc:lsbStageTransferRate a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:nonNegativeFloat ;
    rdfs:comment "Specifies the estimated data transfer rate for direct data staging (for example, IBM CAST burst buffer)." .

hpc:lsbStepCgroupDefault a owl:DatatypeProperty ;
    rdfs:domain hpc:Csmjob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Specifies the default value for the bsub -step_cgroup option for CSM jobs." .

hpc:Directdatastaging a owl:Class .
