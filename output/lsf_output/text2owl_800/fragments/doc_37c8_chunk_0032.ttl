hpc:Server a owl:Class .
hpc:Hostname rdfs:domain hpc:Server ;
    rdfs:range xsd:string .
hpc:Type rdfs:domain hpc:Server ;
    rdfs:range xsd:string .
hpc:Mem rdfs:domain hpc:Server ;
    rdfs:range xsd:decimal .
hpc:Swp rdfs:domain hpc:Server ;
    rdfs:range xsd:decimal .
hpc:Resources rdfs:domain hpc:Server ;
    rdfs:range xsd:decimal .
hpc:hasdocker a owl:ObjectProperty ;
    rdfs:domain hpc:Server ;
    rdfs:range xsd:boolean .
hpc:Podmancontainerengine a owl:Class .
hpc:Container a owl:Class .
hpc:Imagename rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Podmanrunoptions rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:runpodmanjob a owl:ObjectProperty ;
    rdfs:domain hpc:Server ;
    rdfs:range hpc:Container .
hpc:Preexecutionscript rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Postexecutionscript rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Preexecutiondata rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Customizecontainer rdfs:domain hpc:Container ;
    rdfs:range xsd:string .
hpc:Containerparameter rdfs:domain hpc:Applicationprofile ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:Applicationprofile a owl:Class .
hpc:Queue a owl:Class .
