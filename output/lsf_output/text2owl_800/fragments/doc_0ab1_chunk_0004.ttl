hpc:Gpujobdevice a owl:Class .
hpc:Linuxcgroupdevice a owl:Class .
hpc:Gpuenforcement a owl:Class .
hpc:Redhatenterpriselinux a owl:Class .
hpc:Suselinuxenterpriselinux a owl:Class .
hpc:Gpuidreallocation a owl:Class .
hpc:Cudaversion a owl:Class .
hpc:Jobprocessbinding a owl:Class .
hpc:cudavisibledevices a owl:ObjectProperty .
hpc:gpuallocation a owl:ObjectProperty .
hpc:devicecontainer a owl:ObjectProperty .
hpc:Gpujobprocess a owl:Class .
hpc:Exclusivethreadgpu a owl:Class .
hpc:Gpujob a owl:Class .

hpc:Gpujobdevice rdfs:subClassOf owl:Class .
hpc:Linuxcgroupdevice rdfs:subClassOf hpc:Gpujobdevice .
hpc:Gpuenforcement rdfs:subClassOf owl:Class .
hpc:Redhatenterpriselinux rdfs:subClassOf hpc:Gpuenforcement .
hpc:Suselinuxenterpriselinux rdfs:subClassOf hpc:Gpuenforcement .
hpc:Gpuidreallocation rdfs:subClassOf hpc:Gpuenforcement .
