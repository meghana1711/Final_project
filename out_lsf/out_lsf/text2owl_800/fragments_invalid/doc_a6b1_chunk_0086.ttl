hpc:Jobunderrunexception a owl:Class .
hpc:Joboverrunexception a owl:Class .
hpc:Jobidleexception a owl:Class .

hpc:hasruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:duration .

hpc:hascputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:duration .

hpc:hasidlefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:decimal .

hpc:hasexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
    rdfs:range xsd:integer .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty hpc:hasExitCode ;
                                             owl:allValuesFrom [ xsd:integer "0" ] ] ] .

hpc:Overrunjob a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty hpc:hasRuntime ;
                                             owl:greaterThan [ xsd:duration "PT5M" ] ] ] .

hpc:Underrunjob a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty hpc:hasRuntime ;
                                             owl:lessThan [ xsd:duration "PT2M" ] ] ] .

hpc:Idlejob a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty hpc:hasIdleFactor ;
                                             owl:lessThan [ xsd:decimal "0.10" ] ] ] .
