@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:lsbResourceEnforce a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string .

hpc:Resourcemap a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:Resource a owl:Class ;
    rdfs:subClassOf rdf:List .

hpc:resourcename a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcemap ;
    rdfs:range hpc:Resourcelocation .

hpc:location a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:ngpus a owl:NamedIndividual ;
    hpc:RESOURCENAME "ngpus" ;
    hpc:LOCATION "[default]" .

hpc:ngpus_shared a owl:NamedIndividual ;
    hpc:RESOURCENAME "ngpus_shared" ;
    hpc:LOCATION "[default]" .

hpc:ngpus_excl_t a owl:NamedIndividual ;
    hpc:RESOURCENAME "ngpus_excl_t" ;
    hpc:LOCATION "[default]" .

hpc:ngpus_excl_p a owl:NamedIndividual ;
    hpc:RESOURCENAME "ngpus_excl_p" ;
    hpc:LOCATION "[default]" .

hpc:gpu_topology a owl:NamedIndividual ;
    hpc:RESOURCENAME "gpu_topology" .

hpc:resourceName a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:resourceLocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:Numeric a owl:Datatype .

hpc:String a owl:Datatype .

hpc:Enable_GPU a owl:NamedIndividual .

hpc:enableGpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string .

hpc:enableStream a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string .
