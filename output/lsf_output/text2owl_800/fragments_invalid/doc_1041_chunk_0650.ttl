hpc:Jobaffinity a owl:Class .
hpc:Mandatoryaffinity a owl:Class .
hpc:Preferredaffinity a owl:Class .

# Job Affinity Properties
hpc:clusteraffinity a owl:ObjectProperty .
hpc:samehostaffinity a owl:ObjectProperty .
hpc:samecuaffinity a owl:ObjectProperty .

# Job Affinity Domain and Range
hpc:Clusteraffinity rdfs:domain hpc:Jobaffinity ;
    rdfs:range hpc:Cluster .
hpc:Samehostaffinity rdfs:domain hpc:Mandatoryaffinity ;
    rdfs:range hpc:Computeunit .
hpc:Samecuaffinity rdfs:domain hpc:Preferredaffinity ;
    rdfs:range hpc:Computeunit .

# Job Affinity Constraints
hpc:clusterAffinity
    rdfs:subPropertyOf hpc:hasClusterAffinity ;
    rdfs:domain hpc:Jobaffinity ;
    rdfs:range hpc:Cluster ;
    owl:hasValue hpc:cluster_affinity ;
    xsd:maxLength "40"^^xsd:nonNegativeInteger ;
    owl:inDomain (hpc:AlphabeticCharacter | hpc:AlphanumericCharacter | "_" | "=" | "-" | ".") ;
    owl:differentFrom (hpc:attribute | hpc:samehost | hpc:sameCU | hpc:cluster_affinity) .

hpc:samehostAffinity rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:hasSamehostAffinity ;
    owl:inverseOf hpc:onSameHost .

hpc:sameCUAffinity rdf:type owl:FunctionalProperty ;
    rdfs:subPropertyOf hpc:hasSameCUAffinity ;
    owl:inverseOf hpc:onSameCU .

# Job Submission
hpc:Jobsubmission a owl:Class .
hpc:Jsdlsubmission a owl:Class .

hpc:battr a owl:ObjectProperty .
hpc:jsdl a owl:ObjectProperty .

hpc:Battr rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Attribute .

hpc:Jsdl rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Jsdl .

# JSDL Submission Conflicting Options
hpc:JsdlConflictingoptions a owl:Class .
hpc:json a hpc:jsdl_conflictingOptions .
hpc:jsdl_strict a hpc:jsdl_conflictingOptions .
hpc:yaml a hpc:jsdl_conflictingOptions .

hpc:jsdl_conflictingOptions rdfs:subPropertyOf rdf:type ;
    rdfs:domain hpc:Jsdlsubmission .
