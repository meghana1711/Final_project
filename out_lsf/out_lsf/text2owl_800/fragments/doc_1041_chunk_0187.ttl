hpc:Gpuid a owl:Class .
hpc:taskID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:integer .
hpc:jobTask rdf:type owl:Class ;
    rdfs:subClassOf hpc:Gpuid .
hpc:model rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:MTotal rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:decimal .
hpc:GPUComputeCapability rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:MRSV rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:socketID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:integer .
hpc:NVLink rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:errorWarning rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:synchronousExecution rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:execution rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
hpc:rusage rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuid ;
    rdfs:range xsd:string .
