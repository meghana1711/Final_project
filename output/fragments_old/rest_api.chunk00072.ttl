# Classes
hpc:QOS a owl:Class .
hpc:TRES a owl:Class .
hpc:User a owl:Class .

# Object Properties
hpc:hasQOS a owl:ObjectProperty .
hpc:hasTRES a owl:ObjectProperty .

# Datatype Properties
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:string .
hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:nonNegativeInteger .
hpc:id a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:nonNegativeInteger .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:string .
hpc:factor a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:double .
hpc:graceTime a owl:DatatypeProperty ;
    rdfs:domain hpc:QOS ;
    rdfs:range xsd:nonNegativeInteger .
hpc:nameTRES a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdfs:range xsd:string .
hpc:countTRES a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdfs:range xsd:nonNegativeInteger .
hpc:idTRES a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdfs:range xsd:nonNegativeInteger .
hpc:typeTRES a owl:DatatypeProperty ;
    rdfs:domain hpc:TRES ;
    rdfs:range xsd:string .
hpc:nameUser a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

# Subclass relations
hpc:QOS rdfs:subClassOf owl:Class .
hpc:TRES rdfs:subClassOf hpc:QOS .
hpc:User rdfs:subClassOf hpc:QOS .
