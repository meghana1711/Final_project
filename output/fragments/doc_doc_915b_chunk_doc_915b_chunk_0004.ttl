hpc:Key a owl:Class .
hpc:KeyIdentifier a owl:DatatypeProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:string .
hpc:K a owl:DatatypeProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:base64Binary .
hpc:Kty a owl:ObjectProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:string .
hpc:Alg a owl:ObjectProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:Kty .
hpc:Use a owl:ObjectProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:string ;
    rdfs:subClassOf rdf:List .
hpc:Exp a owl:DatatypeProperty ;
    rdfs:domain hpc:Key ;
    rdfs:range xsd:xsd:dateTime .
hpc:DefaultKey a owl:Class ;
    rdfs:subClassOf hpc:Key .
hpc:HasDefaultKey a owl:ObjectProperty ;
    rdfs:domain hpc:DefaultKey ;
    rdfs:range rdf:List ;
    rdfs:range rdf:List .
