hpc:Jobgroup a owl:Class .
hpc:Jobslot a owl:Class .
hpc:GroupName an rdf:Property ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:NSLOTS an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PEND an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:RUN an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SSUSP an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:USUSP an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:RSV an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:nonNegativeInteger .
hpc:SLA an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:Owner an owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:Job a owl:Class .
hpc:jobslot hpc:job a owl:ObjectProperty .
hpc:Hierarchy hpc:Jobgroup rdfs:subClassOf hpc:Job .
hpc:bjgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .
hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job .
