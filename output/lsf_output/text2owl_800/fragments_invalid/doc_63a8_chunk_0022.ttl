hpc:File a owl:Class ;
    rdfs:subClassOf hpc:Datafile .

hpc:Group a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasfile a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Group .

hpc:haspermission a owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range hpc:Permission .

hpc:Permission a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hashash a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:hassize a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:hasrefjob a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:hasxferjob a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:hasgrace a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:hasmodified a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:dateTime .

hpc:hascachelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string .

hpc:Datarequirement a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasusergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range hpc:Group .

hpc:Job a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:hasproject a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Project .

hpc:hascommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hassubmittedfrom a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

