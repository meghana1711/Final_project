hpc:SlurmJob a owl:Class .
hpc:submitTime a xsd:dateTime .

hpc:hasSubmitTime rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmJob ;
    rdfs:range xsd:dateTime .

hpc:SLURMJWTAuthenticationFailure a owl:Class .
hpc:isFixedByClearingSLURMJWT rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SLURMJWTAuthenticationFailure .
