hpc:Reservation a owl:Class .
hpc:Job a owl:Class .
hpc:FlexReservation a owl:Class, rdfs:subClassOf hpc:Reservation .
hpc:MagneticReservation a owl:Class, rdfs:subClassOf hpc:Reservation .
hpc:PurgableReservation a owl:Class, rdfs:subClassOf hpc:Reservation .

hpc:hasFlag a owl:ObjectProperty .
hpc:hasUser a owl:ObjectProperty .
hpc:hasNodes a owl:ObjectProperty .
hpc:startTime a owl:DatatypeProperty, rdfs:domain hpc:Reservation; rdfs:range xsd:dateTime .
hpc:duration a owl:DatatypeProperty, rdfs:domain hpc:Reservation; rdfs:range xsd:duration .
hpc:state a owl:DatatypeProperty, rdfs:domain hpc:Reservation; rdfs:range xsd:string .

hpc:FlexReservation hasFlag "flex" .
hpc:MagneticReservation hasFlag "magnetic" .
hpc:PurgableReservation aowl:FunctionalProperty .
hpc:Reservation hpc:hasFlag rdfs:domain hpc:ReservationCreation .
hpc:Reservation hpc:hasUser rdfs:domain hpc:ReservationCreation .
hpc:Reservation hpc:hasNodes rdfs:domain hpc:ReservationCreation .
hpc:ReservationCreation rdfs:subClassOf hpc:Event .
hpc:Reservation rdfs:subClassOf hpc:Resource .
hpc:Job rdfs:subClassOf hpc:Resource .
