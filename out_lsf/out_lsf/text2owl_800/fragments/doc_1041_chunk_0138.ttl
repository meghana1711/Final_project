hpc:Host a owl:Class .
hpc:Subcommand a owl:Class .
hpc:run a owl:ObjectProperty ;
    rdfs:domain hpc:Subcommand ;
    rdfs:range hpc:Host .
hpc:restart a owl:ObjectProperty ;
    rdfs:domain hpc:Subcommand ;
    rdfs:range rdf:List .
hpc:Lim a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:All a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Subcommand ;
    rdfs:range xsd:string .
hpc:f a owl:DatatypeProperty ;
    rdfs:domain hpc:Stop ;
    rdfs:range xsd:boolean .
