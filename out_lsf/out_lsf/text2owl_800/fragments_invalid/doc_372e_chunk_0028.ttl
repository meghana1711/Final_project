hpc:Licenseserver a owl:Class .
hpc:Remoteagenthost a owl:Class .
hpc:Subnet a owl:Class .
hpc:licenseserverhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Licenseserver ;
    rdfs:range xsd:string .
hpc:subnethost a owl:DatatypeProperty ;
    rdfs:domain hpc:Subnet ;
    rdfs:range xsd:string .
hpc:serves a owl:ObjectProperty ;
    rdfs:domain hpc:Licenseserver ;
    rdfs:range hpc:Licenseserver .
hpc:insubnet a owl:ObjectProperty ;
    rdfs:domain hpc:Remoteagenthost ;
    rdfs:range hpc:Subnet .

hpc:Locallicenseserver a rdfs:subClassOf hpc:Licenseserver .
hpc:Remotelicenseserver a rdfs:subClassOf hpc:Licenseserver .
hpc:Remoteagent a rdfs:subClassOf hpc:Remoteagenthost .

hpc:Licenseserverhost rdfs:subClassOf xsd:string .
hpc:Subnethost rdfs:subClassOf xsd:string .

hpc:Locallicenseserver hpc:serves hpc:LocalLicenseServerHost .
hpc:Remotelicenseserver hpc:serves hpc:RemoteLicenseServerHost .
hpc:Remoteagent hpc:insubnet hpc:SubnetHost .

hpc:LicServers a owl:Class ;
    rdfs:subClassOf hpc:Remoteagenthost .
hpc:RemoteLmstatServers a owl:Class ;
    rdfs:subClassOf hpc:Remoteagent .

hpc:LicServers hpc:serves hpc:LicenseServerHost ;
    rdfs:subPropertyOf hpc:Serves .
hpc:RemoteLmstatServers hpc:insubnet hpc:SubnetHost ;
    rdfs:subPropertyOf hpc:InSubnet .

hpc:LIC_SERVERS "((1700@hostA)(1700@hostB))" .
hpc:REMOTE_LMSTAT_SERVERS "hostB" .
hpc:REMOTE_LMSTAT_SERVERS "hostC" .
hpc:REMOTE_LMSTAT_SERVERS "hostD" .
hpc:REMOTE_LMSTAT_SERVERS "hostE" .
hpc:REMOTE_LMSTAT_SERVERS "hostF" .
hpc:Subnet "((1700@hostA)(1700@hostB))" a hpc:Subnet .
hpc:Subnet "hostB(hostC)" a hpc:Subnet .
hpc:Subnet "hostD(hostE hostF)" a hpc:Subnet .
