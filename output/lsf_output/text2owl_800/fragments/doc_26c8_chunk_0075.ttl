hpc:Gpumodel a owl:Class .
hpc:Gpumodel rdfs:subClassOf xsd:string .

hpc:totalgpumemory a owl:DatatypeProperty .
hpc:Totalgpumemory rdfs:domain hpc:Gpumodel ;
                     rdfs:range xsd:decimal .

hpc:supportsnvlink a owl:ObjectProperty .
hpc:Supportsnvlink rdfs:domain hpc:Gpumodel ;
                     rdfs:range xsd:string .

hpc:computeunit a owl:ObjectProperty .
hpc:Computeunit rdfs:domain hpc:Gpumodel ;
                 rdfs:range hpc:Computeunit .

hpc:Computeunit a owl:Class .
hpc:Computeunit rdfs:subClassOf xsd:string .

hpc:imageid a owl:DatatypeProperty .
hpc:Imageid rdfs:domain hpc:Gpumodel ;
              rdfs:range xsd:string .
