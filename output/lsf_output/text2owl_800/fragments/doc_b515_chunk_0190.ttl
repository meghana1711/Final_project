hpc:Jobslot a owl:Class .
hpc:Queue a owl:Class .
hpc:Pool a owl:Class .
hpc:joblimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hostlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:slotreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobslot .
hpc:backfill a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobslot .
hpc:Fairsharepool a owl:Class ;
    rdfs:subClassOf hpc:Pool .
hpc:Preemptivequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:Preemptablequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:Queuebasedfairsharepool a owl:Class ;
    rdfs:subClassOf hpc:Pool .
hpc:Crossqueueuserbasedfairsharequeue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:Queuebasedfairshareconflict a owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    rdfs:onProperty hpc:SlotReservation ;
    owl:hasValue hpc:JobSlot ;
    owl:someValuesFrom hpc:Queue .
hpc:Queuebasedfairsharepoolconflict a owl:Class ;
    rdfs:subClassOf owl:Restriction ;
    rdfs:onProperty hpc:Backfill ;
    owl:hasValue hpc:JobSlot ;
    owl:someValuesFrom hpc:Queue .
