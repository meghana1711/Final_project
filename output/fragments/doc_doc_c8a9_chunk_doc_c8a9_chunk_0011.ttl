hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:Node a owl:Class .
hpc:State a owl:EnumeredClass ; rdfs:subClassOf owl:Class .
hpc:State owl:enumeration ( :Active , :Idle ) .
hpc:hasPartition a owl:ObjectProperty ; rdfs:domain hpc:Job ; rdfs:range hpc:Partition .
hpc:hasNode a owl:ObjectProperty ; rdfs:domain hpc:Job .
hpc:hasNodeList a owl:ObjectProperty ; rdfs:domain hpc:Job .
hpc:hasState a owl:DatatypeProperty ; rdfs:domain hpc:Job .
hpc:hasTime a owl:DatatypeProperty ; rdfs:domain hpc:Job .
hpc:hasName a owl:DatatypeProperty ; rdfs:domain hpc:Partition .
hpc:isAllocated a owl:ObjectProperty ; rdfs:domain hpc:Node ; rdfs:range hpc:Partition .
hpc:isIdle a owl:ObjectProperty ; rdfs:domain hpc:Node ; rdfs:range xsd:boolean .
hpc:isUp a owl:ObjectProperty ; rdfs:domain hpc:Partition ; rdfs:range xsd:boolean .
hpc:getNodes a owl:ObjectProperty ; rdfs:domain hpc:Partition .
hpc:getState a owl:ObjectProperty ; rdfs:domain hpc:Node .
hpc:getTime a owl:ObjectProperty ; rdfs:domain hpc:Job .
hpc:getUser a owl:ObjectProperty ; rdfs:domain hpc:Job .
hpc:hasTimeLimit a owl:DatatypeProperty ; rdfs:domain hpc:Partition .
```
