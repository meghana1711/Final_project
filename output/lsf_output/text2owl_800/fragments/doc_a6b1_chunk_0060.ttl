hpc:LsfServer a owl:Class .
hpc:LsfConf a owl:Class .
hpc:Eauthexecutable a owl:Class .
hpc:Defaulteauthexecutable a owl:Class .
hpc:Configurationfile a owl:Class .
hpc:Parameter a owl:Class .
hpc:Syntax a owl:Class .
hpc:Defaultbehavior a owl:Class .
hpc:enables a owl:ObjectProperty .
hpc:LSF_AUTH a hpc:Parameter ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:Enables .
hpc:enablesdaemonauthentication a owl:ObjectProperty .
hpc:LSF_AUTH_DAEMONS a hpc:Parameter ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:EnablesDaemonAuthentication .
hpc:monitors a owl:DatatypeProperty .
hpc:LSF_AUTH_MONS a xsd:integer .
hpc:specifies a owl:ObjectProperty .
hpc:LSF_EAUTH_USER a hpc:Parameter ;
    rdfs:domain hpc:Configurationfile ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:Specifies .
hpc:querycommandauthentication a owl:ObjectProperty .
hpc:requiresupdate a owl:ObjectProperty .
hpc:LSF_Version a xsd:string .
hpc:FixPack a xsd:string .
hpc:Latestversion a owl:Class ;
    rdfs:subClassOf hpc:LsfVersion .
hpc:rebuildcommands a owl:ObjectProperty .
hpc:samekey a owl:ObjectProperty .
hpc:LSF_EAUTH_KEY a xsd:string .
hpc:Customizedeauthexecutable a owl:Class .
hpc:providesauthentication a owl:ObjectProperty .
hpc:CredentialsFile a xsd:string .
