hpc:Googlecloudplatforminstance a owl:Class .
hpc:userdata a owl:ObjectProperty .
hpc:logfile a owl:DatatypeProperty .
hpc:Logfilerange rdfs:domain hpc:Googlecloudplatforminstance ;
                  rdfs:range xsd:string .
hpc:Script a owl:Class .
hpc:Script hasLogFile hpc:LogFile .
hpc:scriptrunson a owl:ObjectProperty .
hpc:Scriptrunsonrange rdfs:domain hpc:Script ;
                      rdfs:range hpc:Googlecloudplatforminstance .
hpc:Lsfconfiguration a owl:Class .
hpc:LSFConfiguration hasLSFTop hpc:LSFTop .
hpc:LSFConfiguration hasLSFConfFile hpc:LSFConfFile .
hpc:lsftop a owl:DatatypeProperty .
hpc:Lsftoprange rdfs:domain hpc:Lsfconfiguration ;
                 rdfs:range xsd:string .
hpc:lsfconffile a owl:DatatypeProperty .
hpc:Lsfconffilerange rdfs:domain hpc:Lsfconfiguration ;
                    rdfs:range xsd:string .
hpc:lsfdaemonsstart a owl:ObjectProperty .
hpc:Lsfdaemonsstartrange rdfs:domain hpc:Googlecloudplatforminstance .
hpc:Googlehost a owl:Class .
hpc:Googlehost isResourceMapResource rdfs:subClassOf owl:Thing .
hpc:googlehosttemplate a owl:ObjectProperty .
hpc:Googlehosttemplaterange rdfs:domain hpc:Googlehost ;
                          rdfs:range hpc:Googlecloudplatforminstance .
hpc:GoogleCloudPlatformInstance hasGoogleHost hpc:GoogleHost .
hpc:GoogleCloudPlatformInstance hasLSFConfiguration hpc:LSFConfiguration .
hpc:GoogleCloudPlatformInstance runsScript hpc:Script .
hpc:GoogleCloudPlatformInstance hasRCAccount rdfs:Datatype .
hpc:Googlecloudplatforminstance supportsRCAccountResource rdfs:subClassOf owl:Thing ;
                                                         rdfs:subClassOf hpc:Googlecloudplatforminstance .
hpc:Rcaccountpolicy a owl:Class .
