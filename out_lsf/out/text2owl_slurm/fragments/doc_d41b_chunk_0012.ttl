hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourceallocation ;
    rdfs:comment "The value is recorded in minutes with rounding as needed." .

hpc:minpriothreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float ;
    rdfs:comment "Minimum priority required to reserve resources when scheduling." .

hpc:mintresperjob a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float ;
    rdfs:comment "The minimum size in TRES any given job can have when using the requested QOS." .

hpc:usagefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:float ;
    rdfs:comment "A float that is factored into a job's TRES usage." .

hpc:usagefactorsafe a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "If set, jobs will only be able to run if the job can run to completion with the UsageFactor applied." .

hpc:accountingstorageenforce a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "See AccountingStorageEnforce in the slurm.conf man page." .
