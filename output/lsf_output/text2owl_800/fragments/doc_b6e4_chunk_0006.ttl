hpc:Lsfwebservice a owl:Class .
hpc:hasstatus a owl:ObjectProperty .
hpc:haspid a owl:DatatypeProperty .
hpc:hasport a owl:DatatypeProperty .
hpc:hashost a owl:DatatypeProperty .
hpc:Lsfclient a owl:Class .
hpc:authenticatesto a owl:ObjectProperty .
hpc:hasusername a owl:DatatypeProperty .
hpc:hasurl a owl:DatatypeProperty .
hpc:haspassword a owl:DatatypeProperty .
hpc:runscommand a owl:ObjectProperty .
hpc:Lsfcommand a owl:Class .
hpc:lsfversion a owl:DatatypeProperty .
hpc:hascommit a owl:DatatypeProperty .

hpc:Lsfwebservice rdfs:subClassOf hpc:Resource .
hpc:Lsfclient rdfs:subClassOf hpc:User .
hpc:Lsfcommand rdfs:subClassOf hpc:Command .

hpc:Hasstatus rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:string .
hpc:Haspid rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:integer .
hpc:Hasport rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:integer .
hpc:Hashost rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:string .
hpc:Authenticatesto rdfs:domain hpc:Lsfclient ;
    rdfs:range hpc:Lsfwebservice .
hpc:Hasusername rdfs:domain hpc:Lsfclient ;
    rdfs:range xsd:string .
hpc:Hasurl rdfs:domain hpc:Lsfclient ;
    rdfs:range xsd:string .
hpc:Haspassword rdfs:domain hpc:Lsfclient ;
    rdfs:range xsd:string .
hpc:Runscommand rdfs:domain hpc:Lsfclient ;
    rdfs:range hpc:Lsfcommand .
hpc:Lsfversion rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:string .
hpc:Hascommit rdfs:domain hpc:Lsfwebservice ;
    rdfs:range xsd:string .
