hpc:Association a owl:Class .

hpc:excludeParentIdName a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "Exclude parent id/name" .

hpc:excludeLimitsFromParents a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Exclude limits from parents" .

hpc:format a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV format list" .

hpc:id a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV id list" .

hpc:parent_account a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV names of parent account" .

hpc:partition a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV partition name list" .

hpc:qos a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV QOS list" .

hpc:usage_end a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "usage end UNIX timestamp" .

hpc:usage_start a owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "usage start UNIX timestamp" .

hpc:user a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string ;
    rdfs:comment "CSV user list" .

hpc:includeDeletedAssociations a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Include deleted associations" .

hpc:includeUsage a owl:ObjectProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:boolean ;
