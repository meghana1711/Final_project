hpc:Collector a owl:Class .
hpc:CollectorName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range xsd:string .

hpc:launchcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range xsd:string .

hpc:hasreleaseversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range xsd:string .

hpc:launchesparalleltasks a owl:ObjectProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .
hpc:HostName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Host .

hpc:UsesLoginShell an owl:ObjectProperty ;
    rdfs:domain hpc:Launchesparalleltasks .

hpc:NoShell an owl:ObjectProperty ;
    rdfs:domain hpc:Launchesparalleltasks .

hpc:Command an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Launchesparalleltasks ;
    rdfs:range xsd:string .

hpc:Arguments an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Launchesparalleltasks ;
    rdfs:range xsd:string .

hpc:HostFile an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Launchesparalleltasks ;
    rdfs:range xsd:string .

hpc:ZHost an rdfs:DatatypeProperty ;
    rdfs:domain hpc:Launchesparalleltasks ;
    rdfs:range xsd:string .

hpc:printusageerror a owl:ObjectProperty ;
    rdfs:domain hpc:Collector .

hpc:printreleaseversion a owl:ObjectProperty ;
    rdfs:domain hpc:Collector .
