hpc:Submissiondirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Directory created by LSF for job file copying." .

hpc:haspermission a owl:ObjectProperty ;
    rdfs:domain hpc:Submissiondirectory ;
    rdfs:range xsd:integer ;
    rdfs:comment "Permission level of the directory." .

hpc:ownership a owl:ObjectProperty ;
    rdfs:domain hpc:Submissiondirectory ;
    rdfs:range hpc:User ;
    rdfs:comment "User who owns the directory." .

hpc:creationfailure a owl:ObjectProperty ;
    rdfs:domain hpc:Submissiondirectory ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory creation failed." .

hpc:deletionaction a owl:ObjectProperty ;
    rdfs:domain hpc:Submissiondirectory ;
    rdfs:range hpc:Directory ;
    rdfs:comment "Directories to be deleted if creation fails." .

hpc:User a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "User in the context of LSF." .
