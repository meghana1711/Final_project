hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Jobgroup a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a group of jobs in the HPC system." .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Job ;
    rdfs:comment "Relates a job to its job group." .

hpc:isvalidvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Indicates the valid range of values for a job." ;
    rdfs:range [
        xsd:minInclusive "1" ;
        xsd:maxInclusive "100" ;
        xsd:fractionDigits "2"
    ] .

hpc:supportsdigits a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job supports two digits after decimal." .

hpc:hascpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Relates a job to its CPU factor." .

hpc:normalizestime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates that a job normalizes the time with the CPU factor." .

hpc:modifyjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobgroup ;
    rdfs:comment "Allows a user to modify a job group." .

hpc:movejob a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "Allows a user to move a job or a job array from one job group to another." .

hpc:jobgrouppath a owl:DatatypeProperty ;
    rdfs:domain hdfs:moveJob ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Indicates the path of the destination job group for moving a job or a job array." .

hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a pending job." .

hpc:cannotoperateonrunningorfinishedjobs a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job ;
    rdfs:comment "Indicates that a user cannot operate on running or finished jobs." .

hpc:cannotmodifyownjobgroups a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobgroup ;
