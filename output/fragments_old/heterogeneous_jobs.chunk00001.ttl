hpc:InstallationGuide a owl:Class .

# salloc, sbatch, srun
hpc:Command a owl:Class .

# Version, Cluster, Account, QOS
hpc:Resource a owl:Class .

# cpus-per-task, mem-per-cpu, ntasks, cluster-constraint, clusters, comment, deadline, dependency, distribution, epilog, error, export, export-file, exclude, get-user-env, gid, hold, ignore-pbs, immediate, input, job-name, kill-on-bad-exit, label, mcs-label, mem, msg-timeout, no-allocate, no-requeue, nice, no-kill, open-mode, output, parsable, priority, profile, propagate, prolog, pty, qos, quiet, quit-on-interrupt, reboot, reservation, requeue, signal, slurmd-debug, task-epilog, task-prolog, time, test-only, time-min, uid, unbuffered, verbose, wait, wait-all-nodes, wckey, workdir
hpc:Option a owl:Class .

hpc:Resource rdfs:subClassOf hpc:Option .

hpc:propagatedOption a owl:ObjectProperty .
hpc:propagatedOption rdfs:domain hpc:Option ;
