hpc:Node a owl:Class .
hpc:hascpubind a owl:ObjectProperty .
hpc:Node rdfs:subClassOf hpc:Resource .
hpc:Hascpubind rdfs:domain hpc:Node ;
                      rdfs:range xsd:string .

hpc:Slurmconffile a owl:Class .
hpc:scontrolcommand a owl:ObjectProperty .
hpc:Slurmconffile rdfs:subClassOf hpc:Configurationfile .
hpc:Scontrolcommand rdfs:domain hpc:Slurmconffile ;
                      rdfs:range xsd:string .

hpc:Nodefeatureplugin a owl:Class .
hpc:numacpubind a owl:DatatypeProperty .
hpc:Nodefeatureplugin rdfs:subClassOf hpc:Plugin .
hpc:Numacpubind rdfs:domain hpc:Nodefeatureplugin ;
                      rdfs:range xsd:string .

hpc:Numamode a owl:Class .
hpc:Cpubindoption a owl:Class .
hpc:Numamode rdfs:subClassOf hpc:Resourcemode .
hpc:Cpubindoption rdfs:subClassOf xsd:string .

hpc:Knlconffile a owl:Class .
hpc:numacpubindconfiguration a owl:ObjectProperty .
hpc:Knlconffile rdfs:subClassOf hpc:Configurationfile .
hpc:Numacpubindconfiguration rdfs:domain hpc:Knlconffile ;
                               rdfs:range rdf:List .

hpc:Numacpubindpair a owl:Class .
hpc:NumaMode rdf:type rdf:List ;
             rdf:first hpc:NumaMode ;
             rdf:rest rdf:List ;
             rdf:first hpc:CpuBindOption ;
             rdf:rest rdf:nil .

hpc:Partition a owl:Class .
hpc:haspartitioncpubind a owl:DatatypeProperty .
hpc:Partition rdfs:subClassOf hpc:Resource .
hpc:Haspartitioncpubind rdfs:domain hpc:Partition ;
                        rdfs:range xsd:string .

hpc:Slurmpartitionconffile a owl:Class .
hpc:scontrolcommand a owl:ObjectProperty .
hpc:Slurmpartitionconffile rdfs:subClassOf hpc:Configurationfile .
hpc:Scontrolcommand rdfs:domain hpc:Slurmpartitionconffile ;
                      rdfs:range xsd:string .

hpc:Taskpluginparam a owl:Class .
hpc:slurmconffile a owl:DatatypeProperty .
hpc:Taskpluginparam rdfs:subClassOf hpc:Configurationparameter .
hpc:Slurmconffile rdfs:domain hpc:Taskpluginparam ;
                   rdfs:range hpc:Slurmconffile .
