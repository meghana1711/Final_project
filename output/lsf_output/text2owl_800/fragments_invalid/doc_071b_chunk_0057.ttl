hpc:Directoryforjoboutput a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Directory where job output and error files are created." .

hpc:joboutputdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Directoryforjoboutput ;
    rdfs:range hpc:Directory ;
    rdfs:comment "The directory where LSF creates the standard output and standard error files." .

hpc:uniquejobidbasednaming a owl:ObjectProperty ;
    rdfs:domain hpc:Joboutputdirectory ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether job output and error files are created with unique names based on the job ID." .

# Temporary Job Directories
hpc:Temporaryjobdirectories a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Directories used by jobs for working files and temporary output." .

hpc:defaultoperatingsystemtemporarydirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Temporaryjobdirectories ;
    rdfs:range xsd:string ;
    rdfs:comment "The default operating system temporary directory used by IBM Spectrum LSF for temporary directories." .

# Flexible Job CWD
hpc:Currentworkingdirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The job's current working directory." .

hpc:dynamiccwdmanagement a owl:ObjectProperty ;
    rdfs:domain hpc:Currentworkingdirectory ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job CWD can be managed dynamically based on configuration parameters." .

hpc:dynamicpatterninpath a owl:ObjectProperty ;
    rdfs:domain hpc:Currentworkingdirectory ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether dynamic patterns can be included in the job's current working directory path." .

# Flexible Job Output Directory
hpc:Flexiblejoboutputdirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The directory where the job output and error files are created dynamically based on configuration parameters." .

hpc:Outputoptions a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The options related to job output and error files." .

hpc:fileordirectorypath a owl:DatatypeProperty ;
    rdfs:domain hpc:Outputoptions ;
    rdfs:range xsd:string ;
    rdfs:comment "The file name or directory path for job output and error files." .

hpc:uniquejobidbasednamingindirectorypath a owl:ObjectProperty ;
    rdfs:domain hpc:Fileordirectorypath ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether job output and error files are created with unique names based on the job ID in the specified directory path." .

hpc:MaximumPathLength a owl:Datatype
