hpc:Resourceconnector a owl:Class .
hpc:deallocatesHost an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Host .
hpc:cannotUseBadminHopenCommand an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Command .
hpc:configuringmicrosoftazure a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Configuration .
hpc:requiresibmspectrumlsfversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .
hpc:requireslatestlsffixpack a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Fixpack .
hpc:moveRequiredConfigurationFiles an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Filemovement .
hpc:changeOwnershipOfFilesAndDirectories an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Fileownershipchange .
hpc:requiresrootaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Accesslevel .
hpc:requirescommunicationbetweenhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Communication .
hpc:requiresAbilityToRestartLSFCluster an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Clusterrestart .
hpc:requiresMicrosoftAzureAdministrativeOperations an owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Azureoperations .
hpc:Lsfmanagementhost a owl:Class .
hpc:Computenode a owl:Class .
hpc:Microsoftazureinstance a owl:Class ;
    rdfs:subClassOf hpc:Computenode .
hpc:LSFResourceConnectorTerminatesIdleInstances an owl:ObjectProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range hpc:Termination .
