@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:longlasttimemonthlyrolluprun a owl:DatatypeProperty ;
    rdfs:domain hpc:Rollup ;
    rdfs:range xsd:int64 .

hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Rollup ;
    rdfs:range xsd:int64 .

hpc:V0043rollupstatsmonthlyduration a owl:Class .

hpc:v0043rollupstatsmonthlyduration Up a owl:ObjectProperty ;
    rdfs:domain hpc:V0043rollupstatsmonthlyduration .

hpc:last a owl:DatatypeProperty ;
    rdfs:domain
