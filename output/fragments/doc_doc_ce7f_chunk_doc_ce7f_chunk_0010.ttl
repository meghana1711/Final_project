hpc:AuthType a owl:Class .
hpc:authSlurm a hpc:AuthType ;
    rdfs:comment "internal authentication plugin requiring a key file shared to all Slurm daemons and jwt package installation" .

hpc:AuthPlugin a owl:Class .
hpc:requiresJwt a hpc:AuthPlugin ;
    rdfs:comment "requires installation of the jwt package" .

hpc:MPISupport a owl:Class .

hpc:SchedulerSupport a owl:Class .

hpc:PriorityType a owl:Enum ;
    rdfs:member hpc:basic ;
    rdfs:member hpc:multifactor .

hpc:JobPriorityPlugin a owl:Class .
hpc:multifactorJobPriorityPlugin a hpc:JobPriorityPlugin ;
    rdfs:comment "assigns a priority to jobs based upon a multitude of configuration parameters" .

hpc:SchedType a owl:Class .
hpc:builtinScheduler a hpc:SchedType ;
    rdfs:comment "initiates jobs strictly in their priority order" .
hpc:backfillScheduler a hpc:SchedType ;
    rdfs:comment "initiates a lower-priority job if doing so does not delay the expected initiation time of higher priority jobs" .

hpc:JobTimeLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
```
