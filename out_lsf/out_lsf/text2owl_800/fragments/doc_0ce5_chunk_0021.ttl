hpc:Host a owl:Class .
hpc:Port a owl:Class .
hpc:Lsfproxyddaemon a owl:Class .
hpc:Lsbparams a owl:Class .
hpc:Proxydpolicy a owl:Class .
hpc:max a owl:ObjectProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:nominal a owl:ObjectProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:throttle a owl:ObjectProperty ;
    rdfs:domain hpc:Proxydpolicy ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lsfconf a owl:Class .
hpc:lsfproxydhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:string .
hpc:lsfproxydport a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range xsd:nonNegativeInteger .
hpc:lsbadmins a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconf ;
    rdfs:range hpc:Host .
hpc:limrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbadmins ;
    rdfs:range hpc:Host .
hpc:proxydpolicies a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:string .
