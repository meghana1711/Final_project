hpc:Lsf a owl:Class .
hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:environmentsetupproperly a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .
hpc:configurationerror a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:Edition a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
hpc:Standardedition a owl:Class ;
    rdfs:subClassOf hpc:Edition .
hpc:initentitlement a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer ;
    rdfs:range [ xsd:minInclusive "100" ; xsd:maxInclusive "100" ] .
hpc:EgoAuditMaxSize rdfs:range xsd:integer .
hpc:EgoAuditMaxRotate rdfs:range xsd:integer .
hpc:recheckclass a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer .
hpc:numhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Recheckclass ;
    rdfs:range xsd:integer .
hpc:exchintvl a owl:DatatypeProperty ;
    rdfs:domain hpc:Recheckclass ;
    rdfs:range xsd:float .
hpc:checkingdone a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .
hpc:errorsfound a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkingdone ;
    rdfs:range xsd:boolean .
hpc:Troubleshootinglsfproblems a owl:Class .
hpc:Commandreference a owl:Class .
hpc:lsidcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Troubleshootinglsfproblems ;
    rdfs:range xsd:string .
hpc:lsloadcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Troubleshootinglsfproblems ;
    rdfs:range xsd:string .
hpc:cannotopenlsfconffilemessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Troubleshootinglsfproblems ;
    rdfs:range xsd:string .
hpc:LsfEnvdir a owl:Class .
hpc:cshrc_lsf a owl
