hpc:GPU a owl:Class .
hpc:Node a owl:Class .
hpc:GRES a owl:Class .
hpc:MPS a owl:Class .
hpc:GRESGPU a owl:Class .
hpc:GPUMPS a owl:Class .

hpc:hasGPU a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:GPU .

hpc:hasGRES a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:GRES .

hpc:isMPS a owl:ObjectProperty ;
    rdfs:domain hpc:GRES ;
    rdfs:range xsd:integer .

hpc:count a owl:DatatypeProperty ;
    rdfs:domain hpc:GRES .

hpc:isGRESGPU a owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range hpc:GRESGPU .

hpc:isGPUMPS a owl:ObjectProperty ;
    rdfs:domain hpc:GPU ;
    rdfs:range hdfs:GPUMPS .

hpc:GRESGPU rdfs:subClassOf hpc:GPU .
hpc:GPUMPS rdfs:subClassOf hpc:GPU .

hpc:GRESGPU rdfs:subClassOf hpc:GRES .
hpc:GPUMPS rdfs:subClassOf hpc:GRES .

hpc:GPUMPS rdfs:subClassOf hpc:MPS .

hpc:GPUMPS disjointWith hpc:GRESGPU .
```
