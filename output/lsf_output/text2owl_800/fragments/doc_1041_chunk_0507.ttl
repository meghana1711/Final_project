hpc:Ar a owl:Class .
hpc:AR_JOBIDS rdf:type owl:ObjectProperty .
hpc:AR_CREATOR rdf:type owl:DatatypeProperty .
hpc:AR_OWNERS rdf:type owl:ObjectProperty .
hpc:SCRIPT rdf:type owl:Class .
hpc:SCRIPT_RUN_ENVIRONMENT rdf:type owl:ObjectProperty .
hpc:SCRIPT_NOTIFY rdf:type owl:ObjectProperty .
hpc:SCRIPT_LOG rdf:type owl:ObjectProperty .
hpc:SCRIPT_MODIFIED rdf:type owl:DatatypeProperty .
hpc:SCRIPT_VERSION rdf:type owl:DatatypeProperty .
hpc:SCRIPT_NOTIFY_OWNER rdf:type owl:ObjectProperty .
hpc:SCRIPT_NOTIFY_CREATOR rdf:type owl:ObjectProperty .
hpc:POST_AR_TIME rdf:type owl:DatatypeProperty .
hpc:PRE_AR_TIME rdf:type owl:DatatypeProperty .

hpc:Ar rdfs:subClassOf owl:Class .
hpc:ArJobids rdfs:domain hpc:Ar ;
                 rdfs:range rdf:Resource .
hpc:ArCreator rdfs:domain hpc:Ar ;
                 rdfs:range xsd:string .
hpc:ArOwners rdfs:domain hpc:Ar ;
                 rdfs:range xsd:string .
hpc:Script rdfs:subClassOf owl:Class .
hpc:ScriptRunEnvironment rdfs:domain hpc:Script ;
                 rdfs:range xsd:string .
hpc:ScriptNotify rdfs:domain hpc:Script ;
                 rdfs:range xsd:string .
hpc:ScriptLog rdfs:domain hpc:Script ;
                 rdfs:range xsd:string .
hpc:ScriptModified rdfs:domain hpc:Script ;
                 rdfs:range xsd:dateTime .
hpc:ScriptVersion rdfs:domain hpc:Script ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:ScriptNotifyOwner rdfs:domain hpc:Script ;
                 rdfs:range xsd:string .
hpc:ScriptNotifyCreator rdfs:domain hpc:Script ;
                 rdfs:range xsd:string .
hpc:PostArTime rdfs:domain hpc:Ar ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:PreArTime rdfs:domain hpc:Ar ;
                 rdfs:range xsd:nonNegativeInteger .
