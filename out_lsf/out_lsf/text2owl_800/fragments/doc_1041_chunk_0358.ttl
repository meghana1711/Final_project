hpc:Resourceallocation a owl:Class .
hpc:Policyname a owl:Class .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:Host a owl:Class .
hpc:Projectname a owl:Class .
hpc:Applicationprofile a owl:Class .
hpc:Limit a owl:Class .
hpc:Slotlimit a owl:Class .
hpc:Memorylimit a owl:Class .
hpc:Temporarylimit a owl:Class .
hpc:Swaplimit a owl:Class .
hpc:Joblimit a owl:Class .
hpc:Ineligiblelimit a owl:Class .

# Object Properties
hpc:haspolicyname a owl:ObjectProperty .
hpc:hasuser a owl:ObjectProperty .
hpc:hasqueue a owl:ObjectProperty .
hpc:onhost a owl:ObjectProperty .
hpc:forproject a owl:ObjectProperty .
hpc:forapplicationprofile a owl:ObjectProperty .
hpc:haslimit a owl:ObjectProperty .

# Datatype Properties
hpc:limittype a owl:DatatypeProperty .

# Domain and Range
rdfs:domain hpc:Haspolicyname hpc:Resourceallocation .
rdfs:domain hpc:Hasuser hpc:Resourceallocation .
rdfs:domain hpc:Hasqueue hpc:Resourceallocation .
rdfs:domain hpc:Onhost hpc:Resourceallocation .
rdfs:domain hpc:Forproject hpc:Resourceallocation .
rdfs:domain hpc:Forapplicationprofile hpc:Resourceallocation .
rdfs:domain hpc:Haslimit hpc:Limit .

rdfs:range hpc:Limittype xsd:string .

# Subclass relations
hpc:Slotlimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Memorylimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Temporarylimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Swaplimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Joblimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
hpc:Ineligiblelimit a owl:Class ;
    rdfs:subClassOf hpc:Limit .
