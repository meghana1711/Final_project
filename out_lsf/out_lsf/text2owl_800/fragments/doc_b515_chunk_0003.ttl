hpc:Computeunit a owl:Class .
hpc:NetworkLatencyMinimization rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:boolean .

hpc:Controlprocessorallocation a owl:Class .
hpc:HostAllocationControl rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Controlprocessorallocation .

hpc:Homogeneoushost a owl:Class .

hpc:Heterogeneoushost a owl:Class .

hpc:Paralleljob a owl:Class .
hpc:ProcessType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:string .

hpc:TASKLIMIT rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob .

hpc:HOSTLIMIT_PER_JOB rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob .

hpc:Reservedjobslot a owl:Class .

hpc:BackfillScheduling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservedjobslot .

hpc:DeadlineConstraintScheduling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservedjobslot .

hpc:OptimizedPreemption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservedjobslot .
