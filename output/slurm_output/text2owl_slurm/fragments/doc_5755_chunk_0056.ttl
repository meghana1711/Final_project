hpc:Slurmddaemon a owl:Class .
hpc:Slurmdstepd a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:Corefile a owl:Class .
hpc:Privilegedphase a owl:Class .
hpc:Unprivilegedphase a owl:Class .
hpc:Rhel a hpc:Class .

hpc:locatedIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmddaemon ;
    rdfs:range hpc:Location .

hpc:runningIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdstepd ;
    rdfs:range hpc:Phase .

hpc:generatedIn rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Corefile ;
    rdfs:range hpc:Location .

hpc:varies rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem .

hpc:capturedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Corefile ;
    rdfs:range hpc:Daemon .

hpc:setuid rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmdstepd .

hpc:suid_dumpable rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:integer .

hpc:set rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range hpc:Command .

hpc:permanent rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:boolean .

hpc:kernel_core_pattern rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string .

hpc:core_limits rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range hpc:Corelimit .

hpc:CoreLimit a owl:Class .
hpc:core_size rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Corelimit ;
    rdfs:range xsd:integer .

hpc:suidsafe rdf:type owl:Class .
hpc:readableByRootOnly rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Suidsafe ;
    rdfs:range xsd:boolean .

hpc:overwrite rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Suidsafe ;
    rdfs:range xsd:boolean .
