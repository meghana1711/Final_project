@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:slot a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:occupiedslots a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Slot .

hpc:availableslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:candidatehosts a owl:Object
