hpc:Awsidentityandfederation a owl:Class .
hpc:Awsidentityandfederation rdfs:subClassOf owl:Thing .

hpc:Awsvpc a owl:Class .
hpc:Awsvpc rdfs:subClassOf owl:Thing .

hpc:Awsuser a owl:Class .
hpc:Awsuser rdfs:subClassOf owl:Thing .

hpc:Ec2instance a owl:Class .
hpc:Ec2instance rdfs:subClassOf owl:Thing .

hpc:Iamrole a owl:Class .
hpc:Iamrole rdfs:subClassOf owl:Thing .

hpc:Iamuser a owl:Class .
hpc:Iamuser rdfs:subClassOf owl:Thing .

hpc:Keypair a owl:Class .
hpc:Keypair rdfs:subClassOf owl:Thing .

hpc:launchec2instance a owl:ObjectProperty .
hpc:Launchec2instance rdfs:domain hpc:Awsuser ;
                             rdfs:range hpc:Ec2instance .

hpc:buildcloudimage a owl:ObjectProperty .
hpc:Buildcloudimage rdfs:domain hpc:Awsuser ;
                             rdfs:range hpc:Ec2instance .

hpc:installlsf a owl:ObjectProperty .
hpc:Installlsf rdfs:domain hpc:Ec2instance .

hpc:saveami a owl:ObjectProperty .
hpc:Saveami rdfs:domain hpc:Ec2instance .

hpc:setupiamroles a owl:ObjectProperty .
hpc:Setupiamroles rdfs:domain hpc:Iamuser .

hpc:configuredns a owl:ObjectProperty .
hpc:Configuredns rdfs:domain hpc:Awsuser .

hpc:Hasauthenticationtype rdfs:domain hpc:Awsuser ;
                             rdfs:range xsd:string .

hpc:Hasipaddress rdfs:domain hpc:Ec2instance ;
                   rdfs:range xsd:string .

hpc:Haskeypair rdfs:domain hpc:Awsuser ;
               rdfs:range hpc:Keypair .

hpc:Haspermission rdfs:domain hpc:Iamuser ;
                   rdfs:range xsd:string .
