hpc:Paths a owl:Class .
hpc:Job a owl:Class .
hpc:QoS a owl:Class .
hpc:Tres a owl:Class .
hpc:User a owl:Class .
hpc:UserName a owl:DatatypeProperty .
hpc:JobId a xsd:string .
hpc:JobOffset a xsd:integer .
hpc:ConfigInfo a owl:Class .
hpc:Tres a owl:DatatypeProperty .
hpc:Diag a owl:Class .
hpc:Users a owl:Class .
hpc:WithDeleted a owl:ObjectProperty .
hpc:Deleted a xsd:boolean .
hpc:Qos a owl:Class .
hpc:Name a owl:DatatypeProperty .
hpc:Limits a owl:Class .
hpc:Properties a owl:Class .
hpc:Max a owl:Class .
hpc:Min a owl:Class .
hpc:TresMin a owl:DatatypeProperty .
hpc:Minutes a xsd:nonNegativeInteger .
hpc:Per a owl:ObjectProperty .
hpc:Qos a owl:ObjectProperty .
hpc:Het a owl:Class .
hpc:JobIdHet a owl:DatatypeProperty .
hpc:JobOffsetHet a owl:DatatypeProperty .

hpc:Paths rdfs:subClassOf rdf:Resource .
hpc:Job rdfs:subClassOf hpc:Paths .
hpc:QoS rdfs:subClassOf hpc:Paths .
hpc:Tres rdfs:subClassOf hpc:Paths .
hpc:Users rdfs:subClassOf hpc:Paths .
hpc:User rdfs:subClassOf hpc:Users .
hpc:JobIdHet rdfs:domain hpc:Het ;
                        rdfs:range xsd:string .
hpc:JobOffsetHet rdfs:domain hpc:Het ;
                        rdfs:range xsd:integer .
hpc:WithDeleted rdfs:domain hpc:Paths ;
                        rdfs:range hpc:Deleted .
hpc:Qos rdfs:subPropertyOf hpc:Qos .
hpc:Name rdfs:domain hpc:Qos ;
                        rdfs:range xsd:string .
hpc:Limits rdfs:subClassOf hpc:Properties .
hpc:Properties rdfs:subClassOf rdf:Resource .
hpc:Max rdfs:subClassOf hpc:Limits .
hpc:Min rdfs:subClassOf hpc:Limits .
