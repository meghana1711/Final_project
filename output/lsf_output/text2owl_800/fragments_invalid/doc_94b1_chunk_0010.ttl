hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Computeunit a owl:Class .
hpc:Hostpartition a owl:Class .

hpc:Badmin a owl:Class .

hpc:hpower a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range [ hpc:Suspend , hpc:Resume ] .

hpc:suspend a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range hpc:Host .

hpc:resume a owl:ObjectProperty ;
    rdfs:domain hpc:Badmin ;
    rdfs:range hpc:Host .

hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspend , hpc:Resume ;
    rdfs:range xsd:string .

hpc:POWER_SUSPEND_CMD rdfs:Datatype rdf:nil .

hpc:CYCLE_TIME rdfs:Datatype rdf:nil .

hpc:Host a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ;
        owl:unionOf ( hpc:Host , hpc:HostGroup , hpc:ComputeUnit , hpc:HostPartition ) ] .

hpc:hpoweron a owl:ObjectProperty ;
    rdfs:domain hpc:Suspend ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( rdf:type owl:Class ;
            owl:onProperty hpc:hpower ;
            owl:onProperty hpc:host_name ;
            rdfs:comment "Host <host_name> suspend request done. Host <host_name> suspend. Power State" ) ] .

hpc:hpowerononsuccess a owl:ObjectProperty ;
    rdfs:domain hpc:Hpoweron ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( rdf:type owl:Class ;
            owl:onProperty hpc:hpower ;
            owl:onProperty hpc:host_name ;
            rdfs:comment "Host <host_name> suspend request from administrator" ) ] .

hpc:hpowerononfailure a owl:ObjectProperty ;
    rdfs:domain hpc:Hpoweron ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( rdf:type owl:Class ;
            owl:onProperty hpc:hpower ;
            owl:onProperty hpc:host_name ;
            rdfs:comment "Host <host_name> suspend request failed." ) ] .
