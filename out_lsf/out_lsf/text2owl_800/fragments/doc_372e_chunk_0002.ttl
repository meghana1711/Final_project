hpc:Clustermode a owl:Class .
hpc:hasclustermode a owl:ObjectProperty ;
    rdfs:domain hpc:Licensefeature ;
    rdfs:range xsd:string .

hpc:Licenseschedulerhost a owl:Class .
hpc:ishost a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range xsd:string .

hpc:preferenceorder a owl:ObjectProperty ;
    rdfs:domain hpc:Licenseschedulerhost ;
    rdfs:range rdf:List .

hpc:lmstatinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range xsd:nonNegativeInteger .

hpc:licensemanagercommandpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensemanager .
