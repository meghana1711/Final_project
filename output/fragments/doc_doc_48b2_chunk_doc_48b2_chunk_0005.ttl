hpc:Partition a owl:Class .
hpc:AvailTime a xsd:duration .
hpc:TimeLimit a xsd:duration .
hpc:Nodes a owl:Class .
hpc:State a owl:ObjectProperty .
hpc:NodeList a rdf:List .
hpc:Node a owl:Class .

hpc:Partition rdfs:subClassOf owl:Class .
hpc:AvailTime rdfs:domain hpc:Partition ;
                 rdfs:range xsd:duration .
hpc:TimeLimit rdfs:domain hpc:Partition ;
                 rdfs:range xsd:duration .
hpc:Nodes rdfs:domain hpc:Partition ;
                rdfs:range rdf:List .
hpc:State rdfs:domain hpc:Partition ;
             rdfs:range hpc:StateType .

# State types
hpc:Up a owl:Class .
hpc:Down a owl:Class .
hpc:Idle a owl:Class .
hpc:Pending a owl:Class .

hpc:Up rdfs:subClassOf hpc:StateType .
hpc:Down rdfs:subClassOf hpc:StateType .
hpc:Idle rdfs:subClassOf hpc:StateType .
hpc:Pending rdfs:subClassOf hpc:StateType .

# Node ontology
hpc:NodeName a owl:DatatypeProperty .
hpc:State a owl:ObjectProperty .

hpc:NodeName rdfs:domain hpc:Node ;
             rdfs:range xsd:string .
hpc:State rdfs:domain hpc:Node ;
            rdfs:range hpc:StateType .

# Job ontology
hpc:Job a owl:Class .
hpc:PartitionName a xsd:string .
hpc:User a xsd:string .
hpc:State a owl:ObjectProperty .
hpc:Time a xsd:duration .
hpc:Nodes a rdf:List .
hpc:NodeListReason a xsd:string .

hpc:Job rdfs:subClassOf owl:Class .
hpc:PartitionName rdfs:domain hpc:Job ;
                   rdfs:range xsd:string .
hpc:User rdfs:domain hpc:Job ;
             rdfs:range xsd:string .
hpc:State rdfs:domain hpc:Job ;
             rdfs:range hpc:JobStateType .
hpc:Time rdfs:domain hpc:Job ;
              rdfs:range xsd:duration .
hpc:Nodes rdfs:domain hpc:Job ;
              rdfs:range rdf:List .
hpc:NodeListReason rdfs:domain hpc:Job ;
                    rdfs:range xsd:string .

# Job state types
hpc:Running a owl:Class .
hpc:Pending a owl:Class .

hpc:Running rdfs:subClassOf hpc:JobStateType .
hpc:Pending rdfs:subClassOf hpc:JobStateType .
```
