hpc:Resourcemap a owl:Class .
hpc:Resource a owl:Class .
hpc:Staticresource a owl:Class .
hpc:Dynamicresource a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:location a owl:ObjectProperty .

rdfs:domain hpc:Resourcename rdfs:range xsd:string .
rdfs:domain hpc:Location rdfs:range xsd:string .

hpc:Resourcemap rdfs:subClassOf rdf:List .
hpc:Resourcemap hpc:location rdf:first hpc:Resource .
hpc:Resourcemap hpc:resource rdf:rest hpc:ResourceMap .
hpc:Resource [ hpc:ResourceName ?resourceName ;
                 hpc:Location ( [ ?host ] | all ?host | others | default ) ] .
hpc:StaticResource [ hpc:ResourceName ?resourceName ;
                      hpc:ResourceValue ?resourceValue ;
                      hpc:Location ( [ ?host ] | all ?host | others | default ) ] .
