hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobgroup a owl:Class .
hpc:jobgroupid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:bkill a owl:ObjectProperty ;
    rdfs:domain rdf:Literal ;
    rdfs:range hpc:Job .
hpc:Jobgroup hpc:hasjob rdf:List ;
    rdfs:subPropertyOf hpc:bsub ;
    rdfs:domain hpc:Jobgroup .
hpc:Job hpc:belongsto hpc:JobGroup ;
    rdfs:subPropertyOf hpc:JobGroup hpc:hasJob ;
    rdfs:domain hpc:Job .
hpc:Jobgroup hpc:issubgroupof hpc:JobGroup ;
    rdfs:subPropertyOf rdf:type-from rdf:type ;
    rdfs:domain hpc:Jobgroup .
hpc:Job hpc:haslength rdf:Literal ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Job hpc:hassignal rdf:Literal ;
    rdfs:range xsd:string .
hpc:Job hpc:isinqueue rdf:Literal ;
    rdfs:range xsd:string .
hpc:Job hpc:hasgroup rdf:List ;
    rdfs:subPropertyOf hpc:JobGroup hpc:hasJob ;
    rdfs:domain hpc:Job .
