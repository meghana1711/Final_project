@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Processinformationmanager a owl:Class .
hpc:egoPimInfodir a owl:DatatypeProperty .
hpc:lsfPimLinuxEnhance a owl:ObjectProperty .
hpc:LsfPimLinuxEnhance rdfs:domain hpc:Processinformationmanager .
hpc:LsfPimLinuxEnhance rdfs:range xsd:string .
hpc:LSF_PIM_LINUX_ENHANCE_Y a xsd:string .
hpc:LSF_PIM_LINUX_ENHANCE_N a xsd:string .
hpc:lsfPimSleeptime a owl:DatatypeProperty .
hpc:lsfPimSleeptimeUpdate a owl:ObjectProperty .
hpc:LsfPimSleeptimeUpdate rdfs:domain hpc:Processinformationmanager .
hpc:LsfPimSleeptimeUpdate rdfs:range xsd:string .
