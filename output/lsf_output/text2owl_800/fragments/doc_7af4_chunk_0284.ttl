hpc:Schedulerjobbucketsnapshot a owl:Class .
hpc:snapshotname a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerjobbucketsnapshot ;
    rdfs:range xsd:string .
hpc:format a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerjobbucketsnapshot ;
    rdfs:range xsd:string .
hpc:path a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerjobbucketsnapshot .
hpc:LsfLogdir a owl:Class .
hpc:DisableUacctMap a owl:Class ;
    rdfs:subClassOf hpc:Booleansetting .
hpc:DockerImageAffinity a owl:Class ;
    rdfs:subClassOf hpc:Jobschedulingoption .
hpc:dockerimageaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:DockerImageAffinity ;
    rdfs:range hpc:Executionhost .
hpc:hostpreference a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerimageaffinity ;
    rdfs:range hpc:Executionhost .
hpc:order a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerimageaffinity ;
    rdfs:range xsd:string .
