hpc:Bctrldcommand a owl:Class .
hpc:lsfconfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Bctrldcommand ;
    rdfs:range xsd:string .
hpc:Sudolinuxgroup a owl:Class .
hpc:startdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Bctrldcommand ;
    rdfs:range hpc:Daemon .
hpc:stopdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Bctrldcommand ;
    rdfs:range hpc:Daemon .
hpc:restartdaemon a owl:ObjectProperty ;
    rdfs:domain hpc:Bctrldcommand ;
    rdfs:range hpc:Daemon .

hpc:Daemon a owl:Class .
hpc:Lim a hpc:Daemon ;
    rdfs:subClassOf hpc:Daemon .
hpc:Res a hpc:Daemon ;
    rdfs:subClassOf hpc:Daemon .
hpc:Sbd a hpc:Daemon ;
    rdfs:subClassOf hpc:Daemon .
