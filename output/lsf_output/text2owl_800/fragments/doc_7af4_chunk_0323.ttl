hpc:Job            a owl:Class ;
                   rdfs:subClassOf owl:NamedIndividual ;
                   rdfs:comment "Represents a job in the HPC system." .

hpc:JOB_SCHEDULING_INTERVAL
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The minimum scheduling cycle time for a job." .

hpc:JOB_SCHEDULING_INTERVAL_MIN
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The minimum value for JOB_SCHEDULING_INTERVAL." ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The default minimum value for JOB_SCHEDULING_INTERVAL." .

hpc:JOB_SCHEDULING_INTERVAL_THRESHOLD
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The job scheduling interval threshold time." .

hpc:JOB_SPOOL_DIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the directory for buffering batch standard output and standard error for a job." .
