@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Mpsserver a owl:Class.
hpc:hasgpu a owl:ObjectProperty;
    rdfs:domain hpc:Mpsserver;
    rdfs:range xsd:integer.
hpc:iscontrolledby a owl:ObjectProperty;
    rdfs:domain hpc:Mpsserver;
    rdfs:range hpc:User.
hpc:hasdeviceid a owl:DatatypeProperty;
    rdfs:domain hpc:Mpsserver;
    rdfs:range xsd:integer.
hpc:isstartedby a owl:DatatypeProperty;
    rdfs:domain hpc:
