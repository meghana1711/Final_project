hpc:Jobreason a owl:Class .
hpc:Host a owl:Class .
hpc:Jobpendingtimelimit a owl:Class .
hpc:Eligiblejobpendingtimelimit a owl:Class .
hpc:Memoryusage a owl:Class .
hpc:Cpuusage a owl:Class .
hpc:cpuefficiency a owl:DatatypeProperty .
hpc:cpupeakusage a owl:DatatypeProperty .
hpc:memoryefficiency a owl:DatatypeProperty .
hpc:eligiblependingtime a owl:DatatypeProperty .
hpc:ineligiblependingtime a owl:DatatypeProperty .
hpc:Loaninfo a owl:Class .
hpc:Borrowedresourcepool a owl:Class .
hpc:accountname a owl:DatatypeProperty .
hpc:Resourcename a owl:Class .
hpc:assignedresourcename a owl:DatatypeProperty .
hpc:Jobmodification a owl:Class .
hpc:absolutepriorityscheduling a owl:ObjectProperty .
hpc:autoresizablejob a owl:ObjectProperty .
hpc:currentworkingdirectory a owl:DatatypeProperty .
hpc:datarequirements a owl:ObjectProperty .
hpc:postexecutioncommand a owl:ObjectProperty .
hpc:jobdescription a owl:ObjectProperty .
hpc:checkpointoptions a owl:ObjectProperty .
hpc:migrationthreshold a owl:ObjectProperty .
hpc:jobresizenotificationcommand a owl:ObjectProperty .
hpc:userlimits a owl:ObjectProperty .
hpc:runtimeestimate a owl:ObjectProperty .

hpc:Jobreason rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Jobpendingtimelimit rdfs:subClassOf owl:Class .
hpc:Eligiblejobpendingtimelimit rdfs:subClassOf hpc:Jobpendingtimelimit .
hpc:Memoryusage rdfs:subClassOf owl:Class .
hpc:Cpuusage rdfs:subClassOf owl:Class .
hpc:Cpuefficiency rdfs:domain hpc:Cpuusage ;
                      rdfs:range xsd:decimal .
hpc:Cpupeakusage rdfs:domain hpc:Cpuusage ;
                      rdfs:range xsd:decimal .
hpc:Memoryefficiency rdfs:domain hpc:Memoryusage ;
                      rdfs:range xsd:decimal .
hpc:Eligiblependingtime rdfs:domain hpc:Eligiblejobpendingtimelimit ;
                        rdfs:range xsd:duration .
hpc:Ineligiblependingtime rdfs:domain hpc:Jobpendingtimelimit ;
                        rdfs:range xsd:duration .
hpc:Loaninfo rdfs:subClassOf owl:Class .
hpc:Borrowedresourcepool rdfs:subClassOf hpc:Loaninfo .
hpc:Accountname rdfs:domain hpc:Host ;
                   rdfs:range xsd:string .
hpc:Resourcename rdfs:subClassOf owl:Class .
hpc:Assignedresourcename rdfs:domain hpc
