hpc:LsfDaemon a owl:Class .
hpc:hasmemoryrequirement a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:decimal .

hpc:Physicalmemory a owl:Class .
hpc:Cluster a owl:Class ;
    rdfs:subClassOf hpc:Physicalmemory ;
    hpc:hassize a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .

hpc:Activejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Managementhost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Servercpu a owl:Class ;
    rdfs:subClassOf hpc:Hardware .

hpc:hasservercpu a owl:ObjectProperty ;
    rdfs:domain hpc:Host .

hpc:Hasmemory hpc:physicalmemory ;
    rdfs:range hpc:Memoryrequirement .

hpc:hasclustersize a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:nonNegativeInteger .

hpc:hasactivejobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:nonNegativeInteger .

hpc:recommendedmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:decimal .

hpc:recommendedservercpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range xsd:nonNegativeInteger .

hpc:Supportedoperatingsystem a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:iswindows a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem .
    rdfs:range hpc:Boolean .

hpc:isserver a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem .
    rdfs:range hpc:Boolean .

hpc:IbmSpectrumLsf a owl:Class ;
    rdfs:subClassOf hpc:Managementhost .

hpc:iscompatiblewith a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost .
    rdfs:range hpc:Server .

hpc:supportsfeatures a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost .
    rdfs:range hpc:Feature .

hpc:requiresupgrade a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range hpc:Managementhost .

hpc:Largecluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:Fastmemory a owl:Class ;
