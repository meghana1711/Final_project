hpc:Elim a owl:Class ;
    rdfs:subClassOf owl:ObjectPropertyDomain rdf:Resource .

hpc:statusindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string .

hpc:Status a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:ok a owl:NamedIndividual ;
    rdf:value "ok"^^xsd:string .

hpc:busy a owl:NamedIndividual ;
    rdf:value "busy"^^xsd:string .

hpc:lockW a owl:NamedIndividual ;
    rdf:value "lockW"^^xsd:string .

hpc:lockU a owl:NamedIndividual ;
    rdf:value "lockU"^^xsd:string .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range hpc:Status .
