hpc:DirectoryStructure a owl:Class .
hpc:TopLevelDirectory a owl:Class ;
    rdfs:subClassOf hpc:DirectoryStructure .

hpc:GeneralBuildTools a owl:Class ;
    rdfs:subClassOf hpc:TopLevelDirectory .
hpc:acincludeM4 rdf:type xsd:string ;
    rdfs:domain hpc:GeneralBuildTools ;
    rdfs:range rdf:PlainLiteral .
