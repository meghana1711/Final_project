hpc:Jobpreproctimeout a owl:Class .
hpc:JOB_PREPROC_TIMEOUT rdfs:comment "JOB_PREPROC_TIMEOUT cannot be defined in the user environment. On UNIX and Linux, sbatchd kills the entire process group of the job's pre-execution processes. On Windows, only the parent process of the pre-execution command is killed when the timeout expires, the child processes of the pre-execution command are not killed." .

hpc:Multiclusterjobforwardingmodel a owl:Class .
hpc:Multiclusterjobleasemodel a owl:Class .

hpc:JOB_PREPROC_TIMEOUT_UNIX_LINUX rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreproctimeout ;
    rdfs:range xsd:string ;
    rdfs:comment "On UNIX and Linux, sbatchd kills the entire process group of the job's pre-execution processes." .

hpc:JOB_PREPROC_TIMEOUT_WINDOWS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreproctimeout ;
    rdfs:range xsd:string ;
    rdfs:comment "On Windows, only the parent process of the pre-execution command is killed when the timeout expires, the child processes of the pre-execution command are not killed." .

hpc:MultiClusterAppliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreproctimeout ;
    rdfs:range hpc:Jobprocessingmodel ;
    rdfs:comment "In the MultiCluster job forwarding model, JOB_PREPROC_TIMEOUT and the number of pre-execution retries defined in the receiving cluster apply to the job." .

hpc:SubmissionClusterAppliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobpreproctimeout ;
    rdfs:range hpc:Jobprocessingmodel ;
    rdfs:comment "In the MultiCluster job lease model, JOB_PREPROC_TIMEOUT and the number of pre-execution retries defined in the submission cluster apply to jobs running on remote leased hosts, as if they were running on local hosts." .

hpc:JobPriorityOverTime a owl:Class .
hpc:jobPriorityOverTimeIncrement a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPriorityOverTime ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the value used to increase job priority every interval minutes." .

hpc:jobPriorityOverTimeInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPriorityOverTime ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the frequency, in minutes, to increment job priority." .
