hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a user in the HPC system." .

hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a project in the HPC system." .

hpc:Status a owl:Enum ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of a job." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents a queue in the HPC system." .

hpc:command a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The command executed by the job." .

hpc:share a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The group charged for the job." .

hpc:submittedfrom a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host from which the job was submitted." .

hpc:startedon a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host on which the job started execution." .

hpc:executionhome a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The execution home of the job." .

hpc:executioncwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The execution current working directory of the job." .

hpc:Schedulingparameters a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents the scheduling parameters for a job." .

hpc:Resourcerequirementdetails a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Represents the resource requirement details for a job." .

hpc:combined a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementdetails ;
    rdfs:range hpc:Resourceselection ;
    rdfs:comment "The combined resource selection for a job." .

hpc:effective a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcerequirementdetails ;
    rdfs:range hpc:Resourceselection ;
    rdfs:comment "The effective resource selection for a job." .

hpc
