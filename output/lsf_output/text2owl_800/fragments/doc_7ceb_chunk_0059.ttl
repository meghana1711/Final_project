hpc:Host a owl:Class .
hpc:hasType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hosttype .
hpc:Hosttype a owl:Class .
hpc:hasModel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hostmodel .
hpc:Hostmodel a owl:Class .
hpc:hasCPUFactor rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Defaulthost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Inefficienthost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf hpc:Defaulthost .
hpc:Binaryincompatiblehost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf hpc:Defaulthost .
