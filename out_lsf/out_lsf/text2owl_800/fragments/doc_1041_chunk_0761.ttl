hpc:Host a owl:Class .
hpc:Accountinglogfile a owl:Class .
hpc:Task a owl:Class .
hpc:Timeinterval a owl:Class .
hpc:Tasklogfile a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:taskstatistics a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Taskstatistics .
hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeinterval ;
    rdfs:range xsd:time .
hpc:tasklogfilepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklogfile ;
    rdfs:range xsd:string .
hpc:hostnamelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Tasklogfile ;
    rdfs:range xsd:string .
hpc:taskexecutionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Host .
hpc:timeintervalspecified a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeinterval ;
    rdfs:range xsd:dateTime .
