hpc:Interactivetask a owl:Class .
hpc:Interactivetask rdfs:subClassOf hpc:Task .
hpc:InteractiveTask rdfs:comment "A command that is not submitted to a batch queue and scheduled by LSF, but is dispatched immediately." .

hpc:Interactivetask rdfs:domain hpc:Job .

hpc:Localtask a owl:Class .
hpc:Localtask rdfs:subClassOf hpc:Task .
hpc:LocalTask rdfs:comment "An application or command that does not make sense to run remotely." .

hpc:Remotetask a owl:Class .
hpc:Remotetask rdfs:subClassOf hpc:Task .
hpc:RemoteTask rdfs:comment "An application or command that can be run on another machine in the cluster." .

hpc:Task rdfs:subClassOf owl:Class .

hpc:Job rdfs:subClassOf owl:Class .

hpc:Hosttype a owl:Class .
hpc:Hosttype rdfs:subClassOf owl:Class .
hpc:HostType rdfs:comment "The combination of operating system and host CPU architecture." .

hpc:Host rdfs:subClassOf owl:Class .

hpc:hasresourcerequirement a owl:ObjectProperty .
hpc:Hasresourcerequirement rdfs:domain hpc:Task .
hpc:Hasresourcerequirement rdfs:range rdf:Resource .

hpc:isbesthostfor a owl:ObjectProperty .
hpc:Isbesthostfor rdfs:domain hpc:Task .
hpc:Isbesthostfor rdfs:range hpc:Host .

hpc:islocal a owl:ObjectProperty .
hpc:Islocal rdfs:domain hpc:Task .
hpc:Islocal rdfs:range xsd:boolean .

hpc:Requiresresources rdfs:domain hpc:Task .
hpc:Requiresresources rdfs:range rdf:List .
hpc:Requiresresources rdfs:rangeMembership rdf:first hpc:Resourcerequirement .

hpc:Resourcerequirement a owl:Class .

hpc:Hasload rdfs:domain hpc:Host .
hpc:Hasload rdfs:range xsd:float .

hpc:Hostmodel a owl:Class .
hpc:Hostmodel rdfs:subClassOf hpc:Host .

hpc:Hosttype rdfs:subPropertyOf rdfs:subClassOf .
hpc:HostType rdfs:subPropertyOf rdf:type .
hpc:HostType rdfs:subPropertyOf rdf:first owl:Restriction .
hpc:HostType rdfs:subPropertyOf owl:Restriction rdfs:onClass hpc:OperatingSystem .
hpc:HostType rdfs:subPropertyOf owl:Restriction rdfs:onProperty hpc:hasCPUArchitecture .

hpc:hascpuarchitecture a owl:DatatypeProperty .
hpc:Hascpuarchitecture rdfs:domain hpc:Host .
hpc:Hascpuarchitecture rdfs:range xsd:string .

hpc:Operatingsystem a owl:Class
