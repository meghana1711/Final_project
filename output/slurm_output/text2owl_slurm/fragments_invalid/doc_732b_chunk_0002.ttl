hpc:Module a owl:Class.
hpc:launchparameters a owl:ObjectProperty;
    rdfs:domain hpc:Module;
    rdfs:range xsd:string.

hpc:usepam a owl:ObjectProperty;
    rdfs:domain hpc:Module;
    rdfs:range xsd:boolean.

hpc:Slurmconf a owl:Class.
hpc:slurmconfoption a owl:ObjectProperty;
    rdfs:domain hpc:Slurmconf;
    rdfs:range xsd:string.

hpc:Sshconfiguration a owl:Class.
hpc:sshconfigurationoption a owl:ObjectProperty;
    rdfs:domain hpc:Sshconfiguration;
    rdfs:range xsd:string.

hpc:Pamconfiguration a owl:Class.
hpc:pamconfigurationoption a owl:ObjectProperty;
    rdfs:domain hpc:Pamconfiguration;
    rdfs:range xsd:string.

hpc:pamcontrolflag a owl:DatatypeProperty;
    rdfs:subClassOf owl:Datatype
