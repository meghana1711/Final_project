hpc:CoreBlockNumbering rdfs:domain hpc:Node .
hpc:CyclicCoreNumbering rdfs:domain hpc:Node .
hpc:hasCoreMapping rdfs:domain hpc:Node .

hpc:CoreMapping rdfs:range hpc:CoreMapping .

