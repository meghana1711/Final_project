hpc:Multiclusterenvironment a owl:Class .
hpc:CrossClusterUserAccountMapping an owl:ObjectProperty .
hpc:Lsfdatamanager a owl:Class .
hpc:LsfdatamanagerHascrossclusteruseraccountmapping rdfs:domain hpc:Multiclusterenvironment ;
                                                      rdfs:range hpc:Crossclusteruseraccountmapping .

hpc:LsbUsersConfigurationFile an owl:DatatypeProperty .
hpc:LsbusersconfigurationfileDomain rdfs:domain hpc:Crossclusteruseraccountmapping ;
                                      rdfs:range xsd:string .

hpc:CgroupsEnforcement an owl:ObjectProperty .
hpc:CgroupsenforcementDomain rdfs:domain hpc:Lsfdatamanager ;
                               rdfs:range xsd:string .

hpc:DCGMVersion an owl:DatatypeProperty .
hpc:DcgmversionDomain rdfs:domain hpc:Lsfdatamanager ;
                      rdfs:range xsd:string .

hpc:MIGDeviceIsolation an owl:ObjectProperty .
hpc:MigdeviceisolationDomain rdfs:domain hpc:Lsfdatamanager .

hpc:GPUJobPreemption an owl:ObjectProperty .
hpc:GpujobpreemptionDomain rdfs:domain hps:MulticlusterEnvironment ;
                            rdfs:range hpc:Gpujob .

hpc:KeyLSFDaemonsRestartable an owl:ObjectProperty .
hpc:KeylsfdaemonsrestartableDomain rdfs:domain hpc:Multiclusterenvironment .

hpc:LsfdService an owl:Class .
hpc:LsfdserviceHaschildservice rdfs:domain hpc:Keylsfdaemonsrestartable ;
                               rdfs:range hpc:Lsfservice .

hpc:LsfService an owl:Class .
hpc:Lsfservice a owl:Class .

hpc:LsfdLimService an owl:Class .
hpc:LsfdResService an owl:Class .
hpc:LsfdSbdService an owl:Class .

hpc:LsfdlimserviceIschildof rdfs:domain hpc:Lsfdservice ;
                             rdfs:range hpc:Lsfd .
hpc:LsfdresserviceIschildof rdfs:domain hpc:Lsfdservice ;
                             rdfs:range hpc:Lsfd .
hpc:LsfdsbdserviceIschildof rdfs:domain hpc:Lsfdservice ;
                             rdfs:range hpc:Lsfd .

hpc:LsfCgroupCoreAutoCreate an owl:ObjectProperty .
hpc:LsfcgroupcoreautocreateDomain rdfs:domain hpc:Multiclusterenvironment ;
                                  rdfs:range xsd:boolean .
