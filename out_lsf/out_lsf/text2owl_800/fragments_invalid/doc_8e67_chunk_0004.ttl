hpc:Sparkapplication a owl:Class .
hpc:sparksql a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkapplication ;
    rdfs:range rdf:Resource .
hpc:sparkstreaming a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkapplication ;
    rdfs:range rdf:Resource .
hpc:mlib a owl:ObjectProperty ;
    rdfs:domain hpc:Sparkapplication ;
    rdfs:range rdf:Resource .
hpc:Highperformancecomputingenvironment a owl:Class .
hpc:sparkapplicationrequires a owl:DatatypeProperty ;
    rdfs:domain hpc:Sparkapplication ;
    rdfs:range xsd:string .
hpc:Traditionalhpcenvironment a rdfs:subClassOf hpc:Highperformancecomputingenvironment .
hpc:Lsfintegration a owl:Class .
hpc:lsftracks a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfintegration ;
    rdfs:range rdf:Resource .
hpc:lsfmonitors a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfintegration ;
    rdfs:range rdf:Resource .
hpc:lsfcontrols a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfintegration ;
    rdfs:range rdf:Resource .
hpc:lsfallocatesresources a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfintegration ;
    rdfs:range rdf:Resource .
hpc:lsfshutsdown a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfintegration ;
    rdfs:range rdf:Resource .
hpc:Apachesparkintegration a owl:Class .
hpc:X8664 a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Ppc64 a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Ppc64le a owl:Class ;
    rdfs:subClassOf xsd:string .
