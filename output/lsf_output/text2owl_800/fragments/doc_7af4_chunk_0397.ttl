hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:hasapppriority a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal .

hpc:User a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:hasuserpriority a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:hasusergrouppriority a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:decimal .

hpc:Admin a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:setsjobapspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range xsd:decimal .
