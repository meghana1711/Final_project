@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Pammodule a owl:Class.
hpc:hasaction a owl:ObjectProperty;
    rdfs:domain hpc:Pammodule;
    rdfs:range xsd:string.
hpc:hasoption a owl:ObjectProperty;
    rdfs:domain hpc:Pammodule;
    rdfs:range xsd:string.
hpc:hassense a owl:ObjectProperty;
    rdfs:domain hpc:Pammodule;
    rdfs:range xsd:string.
hpc:hasitem a owl:ObjectProperty;
    rdfs:domain hpc:Pammodule;
