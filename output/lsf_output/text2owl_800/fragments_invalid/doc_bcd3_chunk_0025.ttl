hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "A job submitted for execution." ;
    rdfs:label "Job" ;
    rdfs:isDefinedBy <http://example.org/hpc> ;
    rdfs:subClassOf (a owl:Class ;
                        rdfs:subClassOf (a owl:Restriction ;
                                            rdfs:onProperty hpc:hasUser ;
                                            rdfs:allValuesFrom hpc:User)) ;
    rdfs:subClassOf (a owl:Class ;
                        rdfs:subClassOf (a owl:Restriction ;
                                            rdfs:onProperty hpc:hasProject ;
                                            rdfs:allValuesFrom hpc:Project)) ;
    rdfs:subClassOf (a owl:Class ;
                        rdfs:subClassOf (a owl:Restriction ;
                                            rdfs:onProperty hpc:hasCommand ;
                                            rdfs:onDatatype xsd:string)) ;
    rdfs:subClassOf (a owl:Class ;
                        rdfs
