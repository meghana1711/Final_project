hpc:JWTAuthentication a owl:Class .
hpc:SlurmUser a owl:Class .
hpc:RootUser a owl:Class .
hpc:ProxyUser a owl:Class .
hpc:SlurmRestd a owl:Class .
hpc:SlurmJWT a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmRestd ;
    rdfs:range xsd:string .
hpc:SlurmConf a owl:Class .
hpc:SlurmdbdConf a owl:Class .
hpc:AuthAltTypes a owl:DatatypeProperty ;
    rdfs:domain (hpc:SlurmConf hpc:SlurmdbdConf) ;
    rdfs:range xsd:string .
hpc:LocalAuthentication a owl:Class .
hpc:MungeSecurityDomain a owl:Class .
hpc:UnixDomainSocketAuthentication a owl:Class ;
    rdfs:subClassOf hpc:LocalAuthentication .
hpc:KernelAuthenticated a owl:Class ;
    rdfs:subClassOf hpc:UnixDomainSocketAuthentication .
hpc:SlurmRestdStartup a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmRestd ;
    rdfs:range xsd:string .
hpc:InvalidSLURM_JWT a owl:Class .
hpc:JWTTokenProvided a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmRestd ;
    rdfs:range hpc:JWTToken .
hpc:JWTProxy a owl:Class ;
    rdfs:subClassOf hpc:ProxyUser .
hpc:JWTProxyToken a owl:DatatypeProperty ;
    rdfs:domain hpc:JWTProxy ;
    rdfs:range hpc:JWTToken .
hpc:JWTProxyUser a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:JWTAuthenticationRequired a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmRestd ;
    rdfs:range hpc:JWTAuthentication .
