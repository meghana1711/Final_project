hpc:Mbatchd a owl:Class .
hpc:LSBEvents rdf:type owl:Class .
hpc:LSBParams rdf:type owl:Class .
hpc:Queue rdf:type owl:Class .
hpc:Cluster rdf:type owl:Class .
hpc:Job rdf:type owl:Class .
hpc:CleanPeriod rdf:type owl:DatatypeProperty .
hpc:CLEAN_PERIOD rdf:domain hpc:MBatchd ;
    rdfs:range xsd:nonNegativeInteger .
hpc:EnableHistRunTime rdf:type owl:ObjectProperty .
hpc:ENABLE_HIST_RUN_TIME rdf:domain hpc:Queue, hpc:Cluster ;
    rdfs:range xsd:boolean .
hpc:HistoricalRunTime rdf:type owl:DatatypeProperty .
hpc:historical_run_time rdf:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:HistHours rdf:type owl:DatatypeProperty .
hpc:HIST_HOURS rdf:domain hpc:LSBParams ;
    rdfs:range xsd:nonNegativeInteger .
hpc:DynamicPriority rdf:type owl:DatatypeProperty .
hpc:dynamic_priority rdf:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:CPU_TIME_FACTOR rdf:type owl:DatatypeProperty .
hpc:RUN_TIME_FACTOR rdf:type owl:DatatypeProperty .
hpc:RUN_JOB_FACTOR rdf:type owl:DatatypeProperty .
hpc:FAIRSHARE_ADJUSTMENT_FACTOR rdf:type owl:DatatypeProperty .
hpc:GPU_RUN_TIME_FACTOR rdf:type owl:DatatypeProperty .
hpc:ngpus_physical rdf:type owl:DatatypeProperty .
