hpc:Executioncwd a owl:Class .
hpc:Hostfile a owl:Class .
hpc:initialcheckpointperiod a owl:DatatypeProperty .
hpc:checkpointperiod a owl:DatatypeProperty .
hpc:checkpointdirectory a owl:DatatypeProperty .
hpc:migrationthreshold a owl:DatatypeProperty .
hpc:postexecutecommand a owl:ObjectProperty .
hpc:Pendingreasons a owl:Class .
hpc:Suspendingreasons a owl:Class .
hpc:Loadsched a owl:Class .

hpc:Executioncwd rdfs:subClassOf owl:NamedIndividual .
hpc:Hostfile rdfs:subClassOf owl:NamedIndividual .
hpc:Initialcheckpointperiod rdfs:domain hpc:Job .
hpc:Checkpointperiod rdfs:domain hpc:Job .
hpc:Checkpointdirectory rdfs:domain hpc:Job .
hpc:Migrationthreshold rdfs:domain hpc:Job .
hpc:Postexecutecommand rdfs:domain hpc:Job .
hpc:Pendingreasons rdfs:subClassOf owl:NamedIndividual .
hpc:Suspendingreasons rdfs:subClassOf owl:NamedIndividual .
hpc:Loadsched rdfs:subClassOf owl:NamedIndividual .

hpc:Initialcheckpointperiod rdfs:range xsd:nonNegativeInteger .
hpc:Checkpointperiod rdfs:range xsd:nonNegativeInteger .
hpc:Checkpointdirectory rdfs:range xsd:string .
hpc:Migrationthreshold rdfs:range xsd:nonNegativeInteger .
