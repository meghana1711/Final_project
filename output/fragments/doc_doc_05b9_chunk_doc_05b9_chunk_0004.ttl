    rdfs:domain hpc:BatchUpdateNodeResponse ;
    rdfs:range xsd:string .
hpc:BatchUpdateNodeResponse hasContentType application/json ;
    rdfs:domain hpc:BatchUpdateNodeResponse .

hpc:ReservationModResponse a owl:Class .
hpc:error rdf:datatype xsd:string ;
    rdfs:domain hpc:ReservationModResponse ;
    rdfs:range xsd:string .
hpc:ReservationModResponse hasContentType application/json ;
    rdfs:domain hpc:ReservationModResponse .

hpc:AccountsRemovedResponse a owl:Class .
hpc:removed_accounts rdf:list ;
    rdfs:domain hpc:AccountsRemovedResponse ;
    rdfs:range rdf:List .
