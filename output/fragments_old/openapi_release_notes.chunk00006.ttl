hpc:AssocSharesObjWrapType a owl:Class ;
    rdfs:domain xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty rdf:type ;
                      owl:allValuesFrom ( "USER" "ASSOCIATION" ) ] .

hpc:ClusterRec a owl:Class ;
    rdfs:domain xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty rdf:type ;
                                         owl:allValuesFrom ( xsd:string ) ] ] ;
    rdfs:subPropertyOf hpc:hasFlag .

hpc:ClusterRecFlag a owl:Class ;
    rdfs:domain xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty rdf:type ;
                                         owl:allValuesFrom ( "DELETED" "REGISTERING" "MULTIPLE_SLURMD" "FEDERATION" "EXTERNAL" ) ] ] .

hpc:ControllerPing a owl:Class ;
    rdfs:comment "Is responding slurmctld the primary controller" .

hpc:CpuBindingFlags a owl:Class ;
    rdfs:domain xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty rdf:type ;
                                         owl:allValuesFrom ( xsd:string ) ] ] .

hpc:CrType a owl:Class ;
    rdfs:domain xsd:string ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf [ a owl:Restriction ;
                                         owl:onProperty rdf:type ;
                                         owl:allValuesFrom ( "CPU" "SOCKET" "CORE" "BOARD" "MEMORY" "ONE_TASK_PER_CORE" "PACK_NODE" ) ] ] .
```
