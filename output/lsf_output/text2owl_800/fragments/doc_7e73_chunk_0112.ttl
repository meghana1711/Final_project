hpc:Openstackservice a owl:Class .
hpc:KeystoneService rdf:type hpc:OpenStackService ;
    rdfs:subClassOf hpc:Identityservice .
hpc:GlanceService rdf:type hpc:OpenStackService ;
    rdfs:subClassOf hpc:Imageservice .
hpc:NovaService rdf:type hpc:OpenStackService ;
    rdfs:subClassOf hpc:Computeservice .
hpc:NeutronService rdf:type hpc:OpenStackService ;
    rdfs:subClassOf hpc:Networkingservice .

hpc:Lsfproject a owl:Class .
hpc:Lsfuser a owl:Class .
hpc:Lsfrole a owl:Class .
hpc:Securitygroup a owl:Class .

hpc:hasOpenStackService rdf:type owl:ObjectProperty .
hpc:hasProject rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Openstackservice ;
    rdfs:range hpc:Lsfproject .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproject ;
    rdfs:range hpc:Lsfuser .
hpc:hasRole rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfproject ;
    rdfs:range hpc:Lsfrole .
hpc:hasSecurityGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Openstackservice ;
    rdfs:range hpc:Securitygroup .

hpc:hasOpenStackRole rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfuser ;
    rdfs:range hpc:Lsfrole .

hpc:hasLSFImage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Openstackservice ;
    rdfs:range hpc:Lsfimage .

hpc:Lsfimage a owl:Class .
hpc:hasLSFVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfimage ;
    rdfs:range xsd:string .

hpc:LSFPort rdf:type owl:Class .
hpc:hasPortNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfport ;
    rdfs:range xsd:integer .

hpc:LSF_LIM_PORT a hpc:LSFPort ;
    hpc:hasPortNumber "7869"^^xsd:integer .
hpc:LSF_RES_PORT a hpc:LSFPort ;
    hpc:hasPortNumber "6878"^^xsd:integer .
hpc:LSB_SBD_PORT a hpc:LSFPort ;
    hpc:hasPortNumber "6882"^^xsd:integer .
