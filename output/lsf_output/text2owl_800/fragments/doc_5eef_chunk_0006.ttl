hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Workflowstep .

hpc:Group a owl:Class .

hpc:datagroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Group .

hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Datagroup .

hpc:tagowner a owl:DatatypeProperty ;
    rdfs:domain hpc:Datagroup ;
    rdfs:range xsd:string .

hpc:cacheaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:sanitycheck a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:datachk a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Fileorfolder a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:fileaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Fileorfolder .

hpc:pathtodata a owl:DatatypeProperty ;
    rdfs:domain hpc:Datagroup ;
    rdfs:range xsd:string .

hpc:wildcardcharacters a owl:DatatypeProperty ;
    rdfs:domain hpc:Pathtodata .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:ivariable a owl:DatatypeProperty ;
    rdfs:domain hpc:Pathtodata .

hpc:runtimevariable a owl:DatatypeProperty ;
    rdfs:domain hpc:Fileorfolder .
