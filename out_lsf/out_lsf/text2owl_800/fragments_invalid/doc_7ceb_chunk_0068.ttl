hpc:Lsf a owl:Class .
hpc:limApiNtries hpc:ignoredby a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:lsbApiVerbose hpc:hasverboselevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf .

hpc:LsbApiVerboseY hpc:verboselevel a xsd:boolean .
hpc:LsbApiVerboseN hpc:verboselevel a xsd:boolean .

hpc:notrespondingretryerrormessage a owl:ObjectProperty ;
    rdfs:domain hpc:Batchcommand ;
    rdfs:range xsd:string .

hpc:lsfBatchcommandserrormessage a owl:ObjectProperty ;
    rdfs:domain hpc:Batchcommand ;
    rdfs:range xsd:string .

hpc:mbatchddaemonbusy a owl:ObjectProperty ;
    rdfs:domain hpc:Batchcommand ;
    rdfs:range xsd:string .

hpc:mbatchddaemondown a owl:ObjectProperty ;
    rdfs:domain hpc:Batchcommand ;
    rdfs:range xsd:string .

hpc:cannotconnecttolsf a owl:ObjectProperty ;
    rdfs:domain hpc:Batchcommand ;
    rdfs:range xsd:string .

hpc:Pointoffailure a owl:Class .
hpc:possiblereason a owl:ObjectProperty ;
    rdfs:domain hpc:Pointoffailure ;
    rdfs:range hpc:Errorreason .

hpc:Errorreason a owl:Class .
hpc:EstablishingConnectionWithMbatchdDaemon a hpc:PointOfFailure ;
    hpc:Possiblereason hpc:mbatchddaemonbusy ;
    hpc:errorMessageOutput xsd:"The mbatchd daemon is too busy to accept new connections. The connect() system call times out. LSF is processing your request. Please wait…" .

hpc:EstablishingConnectionWithMbatchdDaemonDown a hpc:PointOfFailure ;
    hpc:Possiblereason hpc:mbatchddaemondown ;
    hpc:errorMessageOutput xsd:"LSF is down. Please wait…" .

hpc:EstablishingConnectionWithMbatchdDaemonBusyBhosts a hpc:PointOfFailure ;
    hpc:Possiblereason hpc:mbatchddaemondown ;
    hpc:errorMessageOutput xsd:"Cannot connect to LSF." .

hpc:EstablishingConnectionWithMbatchdDaemonQueryPortBusy a hpc:PointOfFailure ;
    hpc:Possiblereason hpc:mbatchddaemondown ;
    hpc:errorMessageOutput xsd:"bjobs displays Cannot connect to LSF." .
