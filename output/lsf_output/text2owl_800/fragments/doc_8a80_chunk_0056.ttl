hpc:Feature a owl:Class .
hpc:hasfeaturename a owl:DatatypeProperty .
hpc:hasdistribution a owl:ObjectProperty .

hpc:Feature rdfs:subClassOf owl:Class .
hpc:Hasfeaturename rdfs:domain hpc:Feature ;
                     rdfs:range xsd:string .
hpc:Hasdistribution rdfs:domain hpc:Feature ;
                     rdfs:range hpc:Distribution .

hpc:Distribution a owl:Class .
hpc:DistributionProject a owl:Class .
hpc:distributionPercentage a owl:DatatypeProperty .
hpc:distributionProjectCount a owl:DatatypeProperty .

hpc:distribution a owl:ObjectProperty ;
                 rdfs:domain hpc:Feature ;
                 rdfs:range hpc:Distribution .
hpc:distributionProject a owl:ObjectProperty ;
                 rdfs:domain hpc:Distribution ;
                 rdfs:range hpc:DistributionProject .

hpc:DistributionProject rdfs:subClassOf owl:Class .
hpc:distributionProjectProject a owl:ObjectProperty .
hpc:distributionProjectPercentagelimit a owl:DatatypeProperty .
hpc:distributionProjectPreemption a owl:DatatypeProperty .

hpc:DistributionProject rdfs:subClassOf hpc:DistributionProject ;
                         rdfs:subClassOf owl:Class .
hpc:DistributionProjectProject rdfs:domain hpc:DistributionProject ;
                               rdfs:range hpc:Project .
hpc:DistributionProjectPercentagelimit rdfs:domain hpc:DistributionProject ;
                                        rdfs:range xsd:decimal .
hpc:DistributionProjectPreemption rdfs:domain hpc:DistributionProject ;
                                    rdfs:range xsd:boolean .

hpc:Projectgroup a owl:Class .
hpc:projectgroupProject a owl:ObjectProperty .
hpc:projectgroupProjectPercentage a owl:DatatypeProperty .
hpc:projectgroupProjectOwnershiplimit a owl:DatatypeProperty .
hpc:projectgroupProjectNonshared a owl:DatatypeProperty .

hpc:Projectgroup rdfs:subClassOf owl:Class .
hpc:ProjectgroupProject rdfs:domain hpc:Projectgroup ;
                        rdfs:range hpc:Project .
hpc:ProjectgroupProjectPercentage rdfs:domain hpc:Projectgroup ;
                                rdfs:range xsd:decimal .
hpc:ProjectgroupProjectOwnershiplimit rdfs:domain hpc:Projectgroup ;
                                    rdfs:range xsd:decimal .
hpc:ProjectgroupProjectNonshared rdfs:domain hpc:Projectgroup ;
                               rdfs:range xsd:integer .
