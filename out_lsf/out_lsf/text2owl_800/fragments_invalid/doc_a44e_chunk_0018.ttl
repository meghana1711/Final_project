hpc:Cachepermission a owl:Class .
hpc:hascachepermission a owl:ObjectProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:string .

hpc:Stagingarea a owl:Class .

hpc:cacherefreshinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Datamanager a owl:Class .

hpc:filetransfercmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:string .

hpc:Transfercommand a owl:Class ;
    rdfs:subClassOf owl:Object .

hpc:transfercommand takesTwoArguments a owl:ObjectProperty ;
    rdfs:domain hpc:Transfercommand ;
    rdfs:range hpc:Absolutefilepath .

hpc:Absolutefilepath a owl:Class .
