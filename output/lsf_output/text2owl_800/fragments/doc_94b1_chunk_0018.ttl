hpc:Lsf a owl:Class .
hpc:Poweractionscript a owl:Class .
hpc:POWER_SUSPEND_CMD rdf:value "$LSF_SERVERDIR/../../util/eass3/rpower_suspend.sh" ;
   rdfs:domain hpc:Lsf ;
   rdfs:range xsd:string .
hpc:POWER_RESUME_CMD rdf:value "$LSF_SERVERDIR/../../util/eass3/rpower_resume.sh" ;
   rdfs:domain hpc:Lsf ;
   rdfs:range xsd:string .
hpc:POWER_RESET_CMD rdf:value "$LSF_SERVERDIR/../../util/eass3/rpower_reset.sh" ;
   rdfs:domain hpc:Lsf ;
   rdfs:range xsd:string .
hpc:Cpufrequencymanagement a owl:Class .
hpc:lsfManageFrequency a owl:DatatypeProperty ;
   rdfs:domain hpc:Cpufrequencymanagement ;
   rdfs:range xsd:string .
hpc:Linuxkernelmodule a owl:Class .
hpc:msr rdf:value "CONFIG_X86_MSR" ;
   rdfs:domain hpc:Linuxkernelmodule ;
   rdfs:range xsd:string .
hpc:ibmaem rdf:value "CONFIG_SENSORS_IBMAEM" ;
   rdfs:domain hpc:Linuxkernelmodule ;
   rdfs:range xsd:string .
hpc:ipmi_si rdf:value "CONFIG_IPMI_SI" ;
   rdfs:domain hpc:Linuxkernelmodule ;
   rdfs:range xsd:string .
hpc:acpi_cpufreq rdf:value "CONFIG_X86_ACPI_CPUFREQ" ;
   rdfs:domain hpc:Linuxkernelmodule ;
   rdfs:range xsd:string .
hpc:Systemrequirements a owl:Class .
hpc:Cpufrequencymanagementrequirement a owl:Class .
hpc:Cpufreq-util a owl:Class .
hpc:Cpufrequencymanagementspecification a owl:Class .
hpc:cpuFrequency a owl:DatatypeProperty ;
   rdfs:domain hpc:Cpufrequencymanagementspecification ;
   rdfs:range xsd:decimal .
