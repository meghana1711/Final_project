hpc:Clusters a owl:Class .
hpc:OpenapiClustersResp a owl:Class .
hpc:SlurmdbClustersResp a owl:Class .
hpc:SlurmdbWckeyResp a owl:Class .

hpc:RemoveCluster a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiClustersResp .

hpc:GetClusters a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiClustersResp .

hpc:PostClusters a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiClustersResp .

hpc:GetJobs a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiSlurmdbdJobsResp .

hpc:GetUsers a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiResp .

hpc:PostUsers a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiResp .

hpc:GetWckey a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiWckeyResp .

hpc:GetWckeys a owl:ObjectProperty ;
    rdfs:domain hpc:Clusters ;
    rdfs:range hpc:OpenapiWckeyResp .

hpc:OpenapiClustersResp rdfs:subClassOf owl:Resource .
hpc:SlurmdbClustersResp rdfs:subClassOf hpc:OpenapiClustersResp .
hpc:SlurmdbWckeyResp rdfs:subClassOf owl:Resource .
hpc:OpenapiResp rdfs:subClassOf owl:Resource .

hpc:Id a xsd:string .
hpc:Name a xsd:string .
hpc:ClusterName a xsd:string .
```
