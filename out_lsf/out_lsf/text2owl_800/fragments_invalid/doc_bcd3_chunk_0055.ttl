hpc:Bqueuesformat a owl:Class .
hpc:Bqueuesoption a owl:Class .

hpc:hasoutputformat a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesformat ;
    rdfs:range hpc:Bqueuesoption .
hpc:hasoutputwidth a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesoption ;
    rdfs:range xsd:nonNegativeInteger .
hpc:justification a owl:ObjectProperty ;
    rdfs:domain hpc:Bqueuesoption ;
    rdfs:range xsd:string
