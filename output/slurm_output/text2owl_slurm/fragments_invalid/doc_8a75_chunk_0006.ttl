@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Clustername a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Job .

hpc:Slurmconf a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:domain hpc:Job .

hpc:Cpusonnode a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger ;
    rdfs:domain hpc:Job .

hpc:Distributiontype a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs
