hpc:Jobsubmission a owl:Class .
hpc:LocalJobSubmission a hpc:JobSubmission .
hpc:HostSpecificJobSubmission a hpc:JobSubmission .
hpc:HostListJobSubmission a hpc:JobSubmission .
hpc:HostFileJobSubmission a hpc:JobSubmission .
hpc:ApplicationProfileJobSubmission a hpc:JobSubmission .

# Blaunch Parameters
hpc:lsfResAliveTimeout a owl:ObjectProperty .
hpc:lsfDjobTaskRegWaitTime a owl:ObjectProperty .
hpc:lsbFanoutTimeoutPerLayer a owl:ObjectProperty .
hpc:lsbTaskGeometry a owl:ObjectProperty .

# Domain and Range
hpc:LsfResAliveTimeout rdfs:domain hpc:Jobsubmission ;
  rdfs:range xsd:nonNegativeInteger .
hpc:LsfDjobTaskRegWaitTime rdfs:domain hpc:Jobsubmission ;
  rdfs:range xsd:nonNegativeInteger .
hpc:LsbFanoutTimeoutPerLayer rdfs:domain hpc:Jobsubmission ;
  rdfs:range xsd:nonNegativeInteger .
hpc:LsbTaskGeometry rdfs:domain hpc:Jobsubmission ;
  rdfs:range xsd:string .

# Blaunch Job Submission Specialization
hpc:Localjobsubmission a owl:Class ;
  rdfs:subClassOf hpc:Jobsubmission .
hpc:Hostspecificjobsubmission a owl:Class ;
  rdfs:subClassOf hpc:Jobsubmission .
hpc:Hostlistjobsubmission a owl:Class ;
  rdfs:subClassOf hpc:Jobsubmission .
hpc:Hostfilejobsubmission a owl:Class ;
  rdfs:subClassOf hpc:Jobsubmission .
hpc:Applicationprofilejobsubmission a owl:Class ;
  rdfs:subClassOf hpc:Jobsubmission .

# ANSYS Job Launching
hpc:Ansysjoblaunch a owl:Class .

# Properties for ANSYS Job Launching
hpc:ansyslmdLicenseFile a owl:ObjectProperty .
hpc:mpiRemsh a owl:ObjectProperty .
hpc:program a owl:ObjectProperty .

# Domain and Range for ANSYS Job Launching
hpc:AnsyslmdLicenseFile rdfs:domain hpc:Ansysjoblaunch ;
  rdfs:range xsd:string .
hpc:MpiRemsh rdfs:domain hpc:Ansysjoblaunch ;
  rdfs:range xsd:string .
hpc:Program rdfs:domain hpc:Ansysjoblaunch ;
  rdfs:range xsd:string .
