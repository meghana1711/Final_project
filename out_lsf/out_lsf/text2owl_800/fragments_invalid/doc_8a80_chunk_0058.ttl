hpc:License a owl:Class .
hpc:ownership a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Distribution .
hpc:nonshareddistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Distribution .
hpc:Distribution a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:Distribution ;
                        owl:hasValue ?num . ] .
hpc:Distribution(?project ?server ?shares) a hpc:Distribution ;
    hpc:project ?project ;
    hpc:server ?server ;
    hpc:shares ?shares .
hpc:NonSharedDistribution(?project ?server ?shares) a hpc:NonSharedDistribution ;
    hpc:project ?project ;
    hpc:server ?server ;
    hpc:shares ?shares .
hpc:Lanserver a owl:Class .
hpc:LP1 a hpc:Project ;
    hpc:name "f1" .
hpc:VCS-RUNTIME a hpc:License .
hpc:Lanserver(?server ?ip1 ?ip2) a owl:Class ;
    hpc:server ?server ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:server ;
                        owl:hasValue ?ip1 ;
                        owl:allValuesFrom hpc:IP .
                        owl:onProperty hpc:server ;
                        owl:hasValue ?ip2 ;
                        owl:allValuesFrom hpc:IP . ] .
hpc:IP a rdfs:Datatype .
hpc:Ownership(hpc:LP1 hpc:LanServer(hpc:Lp1 ?shares)) ^^ xsd:integer .
hpc:Distribution(hpc:LanServer(hpc:Lp1 ?shares1) hpc:LanServer(hpc:Lp1 4/10 hpc:Lp2 1)) .
hpc:NonSharedDistribution(hpc:LanServer(hpc:Lp1 10)) .
hpc:LP2 a hpc:Project ;
    hpc:name "Lp2" .
