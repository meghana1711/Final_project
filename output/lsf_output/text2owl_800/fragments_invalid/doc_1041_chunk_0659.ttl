hpc:Loginshell a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The specified login shell must be an absolute path. This is not necessarily the shell under which the job is executed. Login shell is not supported on Windows. On UNIX and Linux, the file path of the login shell can contain up to 58 characters.";

hpc:Lsfproject a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Assigns the job to the specified LSF License Scheduler project.";

hpc:lsfprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "LSF License Scheduler project names can be up to 511 characters long.";

hpc:unixlinuxfilepathlength a owl:DatatypeProperty ;
    rdfs:domain hpc:Loginshell ;
    rdfs:range xsd:integer ;
    rdfs:comment "On UNIX and Linux, the file path of the login shell can contain up to 58 characters.";

hpc:windowsnotsupported a owl:DatatypeProperty ;
    rdfs:domain hpc:Loginshell ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Login shell is not supported on Windows.";

hpc:conflictingoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "Do not use with the -csm y option.";

hpc:Lsflicensescheduler a owl:Class ;
    rdfs:subClassOf owl:ObjectProperty ;
    rdfs:domain hpc:Job ;

hpc:lnmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the memory limit on the launch node (LN) host for the CSM job.";

hpc:csmmode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "This option is for easy mode LSF job submission to run with the IBM Cluster Systems Manager (CSM) integration package.";

hpc:conflictingwithcsmy a owl:ObjectProperty ;
    rdfs:domain hpc:Lnmemorylimit ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "Do not use with the -csm y option.";
