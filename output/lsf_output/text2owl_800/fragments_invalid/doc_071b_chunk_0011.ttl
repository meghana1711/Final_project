hpc:LsfDaemon a owl:Class .
hpc:LsfService a owl:Class .
hpc:Event_Log_File owl:DatatypeProperty .
hpc:User_Account owl:Class .
hpc:daemonStartupControl a owl:ObjectProperty .
hpc:lsadmin owl:ObjectProperty .
hpc:badmin owl:ObjectProperty .
hpc:LsadminUser a owl:Class .
hpc:lsf_sudoers_File owl:DatatypeProperty .
hpc:StartupControlCommand a owl:Class .
hpc:bhosts a hpc:Startup_Control_Command .
hpc:lsload a hpc:Startup_Control_Command .
hpc:bctrld_start_sbd a hpc:Startup_Control_Command .
hpc:bctrld_start_lim a hpc:Startup_Control_Command .
hpc:bctrld_start_res a hpc:Startup_Control_Command .
hpc:badmin_showconf a hpc:Startup_Control_Command .

hpc:LsfDaemon rdfs:subClassOf hpc:SystemComponent .
hpc:LsfService rdfs:subClassOf hpc:Service .
hpc:EventLogFile rdfs:domain hpc:LsfDaemon ;
                      rdfs:range xsd:string .
hpc:UserAccount rdfs:subClassOf xsd:string .
hpc:DaemonStartupControl rdfs:domain hpc:LsfDaemon ;
                         rdfs:range hpc:UserAccount .
hpc:Lsadmin rdfs:domain hpc:UserAccount ;
              rdfs:range hpc:LsfDaemon .
hpc:Badmin rdfs:domain hpc:UserAccount ;
              rdfs:range hpc:LsfDaemon .
hpc:LsadminUser rdfs:subClassOf hpc:UserAccount .
hpc:LsfSudoersFile rdfs:domain hpc:LsfDaemon ;
                     rdfs:range xsd:string .
