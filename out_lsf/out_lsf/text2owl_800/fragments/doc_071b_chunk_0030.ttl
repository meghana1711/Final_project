hpc:Host a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:jlU a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:max a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ssusp a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ususp a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
hpc:rsv a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Serverhost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:cpuf a owl:DatatypeProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range xsd:decimal .
hpc:dispatchWindows a owl:DatatypeProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range xsd:string .

hpc:Currentload a owl:Class .
hpc:total a owl:DatatypeProperty ;
    rdfs:domain hpc:Currentload ;
    rdfs:range xsd:decimal .
hpc:reserved a owl:DatatypeProperty ;
    rdfs:domain hpc:Currentload ;
    rdfs:range xsd:decimal .
hpc:LoadThreshold a owl:Class .
hpc:loadsched a owl:DatatypeProperty ;
    rdfs:domain hpc:LoadThreshold ;
    rdfs:range xsd:decimal .
hpc:loadstop a owl:DatatypeProperty ;
    rdfs:domain hpc:LoadThreshold ;
    rdfs:range xsd:decimal .
hpc:cpuspeed a owl:DatatypeProperty ;
    rdfs:domain hpc:LoadThreshold ;
    rdfs:range xsd:decimal .
hpc:bandwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:LoadThreshold ;
    rdfs:range xsd:decimal .
