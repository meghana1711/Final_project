hpc:Fixpack15 a owl:Class ;
    rdfs:label "Fix Pack 15" ;
    rdfs:seeAlso <https://www.ibm.com/support/pages/node/6896044> .

hpc:Fixpack12 a owl:Class ;
    rdfs:label "Fix Pack 12" ;
    rdfs:seeAlso <https://www.ibm.com/support/pages/node/6896044> .

hpc:ReleaseDate a xsd:date ;
    rdfs:domain hpc:Fixpack .

hpc:IssueTrackedBetween a xsd:dateTime ;
    rdfs:range xsd:dateTime .

hpc:Enhancement a owl:Class ;
    rdfs:subClassOf hpc:Fix .

hpc:Securityenhancement a owl:Class ;
    rdfs:subClassOf hpc:Enhancement .

hpc:Fixpack7 a owl:Class ;
    rdfs:label "Fix Pack 7" ;
    rdfs:seeAlso <https://www.ibm.com/support/pages/node/6896044> .

hpc:preventlicensepreemption a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack .

hpc:disablepreemptionparameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Preventlicensepreemption .

hpc:Featuresection a owl:Class ;
    rdfs:label "Feature section of the lsf.licensescheduler file" .

hpc:Lsflicenseschedulerfile a owl:Class ;
    rdfs:subClassOf owl:Document .

hpc:projectownership a owl:DatatypeProperty ;
    rdfs:domain hpc:Preventlicensepreemption ;
    rdfs:range xsd:integer .
