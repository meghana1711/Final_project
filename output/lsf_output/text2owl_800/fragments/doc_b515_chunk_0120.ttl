hpc:Advancereservation a owl:Class .
hpc:Activeadvancereservation a owl:Class .
hpc:Reservedhost a owl:Class .
hpc:Reservedslot a owl:Class .
hpc:schmodadvrsv a owl:ObjectProperty .
hpc:Lsbresources a owl:Class .
hpc:resourcereservation a owl:ObjectProperty .
hpc:Advancereservationuserpolicy a owl:Class .
hpc:advancereservationcommand a owl:ObjectProperty .
hpc:Hostbasedadvresv a owl:Class .
hpc:Slotbasedadvresv a owl:Class .
hpc:Reservedhosts rdfs:domain hpc:Reservedhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Reservedslots rdfs:domain hpc:Reservedslot ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Associatedusers rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:User .
hpc:Associatedgroups rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:Group .
hpc:Activetime rdfs:domain hpc:Activeadvancereservation ;
    rdfs:range xsd:dateTime .
hpc:Reservedhostsfor rdfs:domain hpc:Reservedhost ;
    rdfs:range hpc:Time .
hpc:Reservedslotsfor rdfs:domain hpc:Reservedslot ;
    rdfs:range hpc:Time .
hpc:Createdby rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:User .
hpc:Deletedby rdfs:domain hpc:Advancereservation ;
    rdfs:range hpc:User .
