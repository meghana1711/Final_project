hpc:cpuPeakSampleDuration a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:integer ;
    rdfs:comment "An integer in the range 1 - 2147483647. Default" .

hpc:cpuTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Used only with fair share scheduling. CPU time weighting factor. In the calculation of a user’s dynamic share priority, this factor determines the relative importance of the cumulative CPU time used by a user’s jobs. This parameter can also be set for an individual queue in lsb.queues. If deﬁned, the queue value takes precedence. Default" .

hpc:csmValidSmt a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string ;
    rdfs:comment "Deﬁnes a space-delimited list of valid SMT mode values. This option is for LSF jobs that are submitted with the IBM Cluster Systems Manager (CSM) integration package. The ﬁrst value is the default SMT mode for CSM jobs if the SMT mode is not speciﬁed at the queue or job level." .
