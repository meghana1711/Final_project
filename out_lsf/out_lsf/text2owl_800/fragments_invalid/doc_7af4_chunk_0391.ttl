hpc:Defaultusergroup a owl:Class .
hpc:enforceoneuglimit a owl:ObjectProperty .
hpc:enforceugtree a owl:ObjectProperty .
hpc:subtryinterval a owl:DatatypeProperty .
hpc:Subtryinterval rdfs:domain hpc:Enforceoneuglimit ;
                     rdfs:domain hpc:Enforceugtree ;
                     rdfs:range xsd:integer .

hpc:Maxpendingjobs a owl:Class .
hpc:systemmappingaccount a owl:ObjectProperty .
hpc:Systemmappingaccount rdfs:domain rdf:Resource ;
                          rdfs:range xsd:string .

hpc:TrackEligiblePendinfo a owl:Class .
hpc:TrackEligiblePendinfo rdfs:subClassOf owl:Boolean .

hpc:TRACK_ELIGIBLE_PENDINFO_Y a owl:NamedIndividual ;
                                 rdf:value "Y" .
hpc:TRACK_ELIGIBLE_PENDINFO_N a owl:NamedIndividual ;
                                 rdf:value "N" .

hpc:systemMappingAccount a owl:DatatypeProperty .
hpc:SystemMappingAccount rdfs:domain rdf:Resource ;
                             rdfs:range xsd:string .

hpc:StrictOutputRules a owl:Class .
hpc:StrictOutputRules rdfs:subClassOf owl:Restriction ;
                          rdfs:label "Strict Output Rules"@en .

hpc:STRICT_OUTPUT_RULES_1 a owl:NamedIndividual ;
                             rdf:value "Return ONLY Turtle statements (no explanations, no markdown, no code fences like `)."@en .
hpc:STRICT_OUTPUT_RULES_2 a owl:NamedIndividual ;
                             rdf:value "Use ONLY these prefixes in triples: hpc:, rdf:, rdfs:, owl:, xsd: (do not invent others)."@en .
hpc:STRICT_OUTPUT_RULES_3 a owl:NamedIndividual ;
                             rdf:value "Every statement MUST end with a period '.'."@en .
hpc:STRICT_OUTPUT_RULES_4 a owl:NamedIndividual ;
                             rdf:value "Do NOT use 'rdf:Type' anywhere."@en .
hpc:STRICT_OUTPUT_RULES_5 a owl:NamedIndividual ;
                             rdf:value "Never write 'a ... xsd:*' (xsd:* is ONLY allowed as the object of rdfs:range)."@en .
hpc:STRICT_OUTPUT_RULES_6 a owl:NamedIndividual ;
                             rdf:value "Do not chain with ',' after 'a owl:Class' (i.e., do NOT write 'a owl:Class, ...')."@en .

hpc:ModelingRules a owl:Class .
hpc:ModelingRules rdfs:subClassOf owl:Restriction ;
