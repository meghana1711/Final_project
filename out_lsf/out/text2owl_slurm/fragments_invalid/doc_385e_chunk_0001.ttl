hpc:Cpu a owl:Class ;
    rdfs:subClassOf hpc:Crcpu .

hpc:Crcpu rdfs:subClassOf owl:Class ;
    rdfs:comment "CPU as a consumable resource." ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Board a owl:Class ;
    rdfs:subClassOf hpc:Crboard .

hpc:Crboard rdfs:subClassOf owl:Class ;
    rdfs:comment "Baseboard as a consumable resource." ;
