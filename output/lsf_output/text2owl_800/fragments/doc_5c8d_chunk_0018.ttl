hpc:Y a owl:Class .
hpc:Hosts a owl:Class ;
    rdfs:subClassOf hpc:Y .
hpc:hasnodename a owl:ObjectProperty ;
    rdfs:domain hpc:Hosts ;
    rdfs:range xsd:string .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Y .
hpc:hasqueuename a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
hpc:isplan a owl:ObjectProperty ;
    rdfs:domain hpc:Queue .
hpc:isrerunnable a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .
hpc:hasjobcontrols a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:Datajobqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .

hpc:BBQ a hpc:Queue .
hpc:BBQ rdf:type hpc:DataJobQueue .
hpc:Bbq hpc:isplan "Y" .
hpc:Bbq hpc:hasjobcontrols "SUSPEND[bmig $LSB_BATCH_JID]" .
hpc:Bbq hpc:isrerunnable "Y" .
