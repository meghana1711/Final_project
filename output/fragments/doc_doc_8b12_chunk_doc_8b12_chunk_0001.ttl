hpc:SlurmSource a owl:Class .
hpc:downloadableFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSource ;
    rdfs:range xsd:string ;
    rdfs:comment "The URL from where Slurm can be downloaded." .

hpc:RelatedSoftware a owl:Class .
hpc:requiredForFunctionality rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:RelatedSoftware ;
    rdfs:range hpc:RelatedSoftware ;
    rdfs:comment "Software required for certain Slurm functionality." .

hpc:AuthenticationPlugin a owl:Class ;
    rdfs:subClassOf hpc:RelatedSoftware .

hpc:MUNGE a hpc:AuthenticationPlugin ;
    rdfs:comment "Authentication plugin recommended for Slurm." .

hpc:CompilationRequirement a owl:Class ;
    rdfs:subClassOf hpc:AuthenticationPlugin .

hpc:MUNGECompilationRequirement a hpc:CompilationRequirement ;
    rdfs:comment "Requirement for compiling the 'auth/munge' authentication plugin for Slurm." .

hpc:UserAuthenticationTool a owl:Class ;
    rdfs:subClassOf hpc:RelatedSoftware .

hpc:AUKS a hpc:UserAuthenticationTool ;
    rdfs:comment "Utility designed to ease Kerberos V credential support for non-interactive applications." .

hpc:Database a owl:Class ;
    rdfs:subClassOf hpc:RelatedSoftware .

hpc:AccountingDatabase a hpc:Database ;
    rdfs:comment "Databases used to store accounting information." .

hpc:MySQL a hpc:Database ;
    rdfs:subClassOf hpc:AccountingDatabase .

hpc:MariaDB a hpc:Database ;
    rdfs:subClassOf hpc:AccountingDatabase .

hpc:DRMAA a owl:Class ;
    rdfs:subClassOf hpc:RelatedSoftware .

hpc:DRMAAforSlurm a hpc:DRMAA ;
    rdfs:comment "Implementation of Open Grid Forum DRMAA 1.0 specification for submission and control of jobs to Slurm." .
```
