hpc:Cluster a owl:Class.

# Federated Job
hpc:Federatedjob a owl:Class;
    rdfs:subClassOf hpc:Job;
    rdfs:comment "A job that is submitted to the federated cluster." .

# Origin Cluster ID
hpc:originclusterid a owl:DatatypeProperty;
    rdfs:domain hpc:Federatedjob;
    rdfs:range xsd:integer.

# Local Job ID
hpc:localjobid a owl:DatatypeProperty;
    rdfs:domain hpc:Federatedjob;
    rdfs:range xsd:integer.

# Job ID (combination of Origin Cluster ID and Local Job ID)
hpc:jobid a owl:DatatypeProperty;
    rdfs:domain hpc:Federatedjob;
    rdfs:range xsd:string.

# Cluster Name
hpc:clustername a owl:DatatypeProperty;
    rdfs:domain hpc:Partition;
    rdfs:range xsd:string.

# Partition
hpc:Partition a owl:Class.
