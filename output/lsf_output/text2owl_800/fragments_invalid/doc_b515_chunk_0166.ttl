hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:shareassignment a owl:ObjectProperty .

hpc:User1 hpc:shareassignment some hpc:Share .
hpc:Group hpc:shareassignment some hpc:Share .
hpc:User2 hpc:shareassignment some hpc:Share .
hpc:Others hpc:shareassignment some hpc:Share .

hpc:Hasshare rdfs:domain hpc:User ;
          rdfs:range xsd:integer ;
          rdfs:subPropertyOf hpc:shareassignment .

hpc:User1 rdf:type hpc:ImportantUser ;
         hpc:hasShare 10 .
hpc:Group rdf:type hpc:GroupOfUsers ;
          hpc:hasMember rdf:* .
hpc:User rdf:type hpc:GroupMember ;
         hpc:hasShare ?share .

hpc:Groupofusers rdfs:subClassOf hpc:Group ;
                rdfs:subClassOf (hpc:Group [ rdf:first hpc:User ; rdf:rest (hpc:Groupofusers [ rdf:first ?user
