hpc:Slurmdnode a owl:Class .
hpc:Controller a owl:Class .
hpc:Upgrade a owl:Class .
hpc:slurmdtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdnode ;
    rdfs:range xsd:nonNegativeInteger .
hpc:upgradeprocedure a owl:ObjectProperty ;
    rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:Procedurestep .
hpc:Procedurestep a owl:Class .
hpc:IncreaseSlurmdTimeout a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:ShutdownSlurmd a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:BackupStateSaveLocation a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:UpgradeSlurmd a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:RestartSlurmd a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:ValidateOperation a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:CommunicationWithController a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:JobStartFinish a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:MarkedDown a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
hpc:KilledJobs a hpc:ProcedureStep ;
    rdfs:subClassOf hpc:Procedurestep .
