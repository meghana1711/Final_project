hpc:Job rdf:type owl:Class .
hpc:CPU rdf:type owl:Class .
hpc:Node rdf:type owl:Class .
hpc:Core rdf:type owl:Class .
hpc:QuadCoreProcessor rdf:type owl:Class .
hpc:TimeslicedJob hpc:CPU rdf:type hpc:Job ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is timesliced." .

hpc:SuspendedJob hpc:Job rdf:type owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is suspended." .

hpc:SharedCore hpc:Core hpc:CPU ;
    rdfs:subClassOf hpc:Core ;
    rdfs:comment "A core that is shared among multiple jobs." .

hpc:DedicatedCore hpc:Core hpc:CPU ;
    rdfs:subClassOf hpc:Core ;
    rdfs:comment "A core that is dedicated to a single job." .

hpc:hasCore hpc:Job hpc:Core ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Core ;
    rdfs:comment "The core(s) a job is allocated to." .

hpc:hasCPU hpc:Node hpc:CPU ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:CPU ;
    rdfs:comment "The CPU(s) a node contains." .

hpc:hasQuadCoreProcessor hpc:Node hpc:QuadCoreProcessor ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:QuadCoreProcessor ;
    rdfs:comment "The quad-core processors a node contains." .

hpc:requiresCPUPerNode hpc:Job xsd:integer ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The number of CPUs each job requests per node." .

hpc:SelectTypeParameters rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string ;
    rdfs:comment "The configured SelectTypeParameters for a partition." .

hpc:SelectType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:SelectType ;
    rdfs:comment "The type of selector used for a partition." .

hpc:SelectType a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:comment "The types of selectors available." .

hpc:selectCons_tres a owl:NamedIndividual ;
    rdf:type hpc:SelectType ;
    rdfs:label "cons_tres"@en .

hpc:CR_Core_Memory a owl:NamedIndividual ;
    rdf:type hpc:SelectTypeParameters ;
    rdfs:label "CR_CORE_MEMORY"@en .

hpc:CR_CPU_Memory a owl:Named
