hpc:Jobrequirement a owl:Class .

hpc:hasexclusivejobs a owl:ObjectProperty .
hpc:hasaffinity a owl:ObjectProperty .
hpc:hasblock a owl:ObjectProperty .
hpc:hasgpack a owl:ObjectProperty .
hpc:hasgvendor a owl:ObjectProperty .
hpc:hasgmodel a owl:ObjectProperty .
hpc:hasgtile a owl:ObjectProperty .
hpc:hasglink a owl:ObjectProperty .
hpc:hasmig a owl:ObjectProperty .

hpc:hasnumgpus a owl:DatatypeProperty .
hpc:Hasnumgpus rdfs:domain hpc:Jobrequirement .
hpc:Hasnumgpus rdfs:range xsd:nonNegativeInteger .
hpc:hasNumGPUsPerTask rdfs:subPropertyOf hpc:hasNumGPUs .
hpc:Hasnumgpuspertask rdfs:domain hpc:Jobrequirement .
hpc:Hasnumgpuspertask rdfs:range xsd:nonNegativeInteger .

hpc:hasmode a owl:ObjectProperty .
hpc:Hasmode rdfs:domain hpc:Jobrequirement .
hpc:Hasmode rdfs:range xsd:string .

hpc:hasmps a owl:ObjectProperty .
hpc:Hasmps rdfs:domain hpc:Jobrequirement .
hpc:Hasmps rdfs:range xsd:boolean .

hpc:hasjexclusive a owl:ObjectProperty .
hpc:Hasjexclusive rdfs:domain hpc:Jobrequirement .
hpc:Hasjexclusive rdfs:range xsd:boolean .

hpc:Hasgmodel rdfs:domain hpc:Jobrequirement .
hpc:Hasgmodel rdfs:range xsd:string .

hpc:Hasgtile rdfs:domain hpc:Jobrequirement .
hpc:Hasgtile rdfs:range xsd:string .

hpc:hasgmem a owl:DatatypeProperty .
hpc:Hasgmem rdfs:domain hpc:Jobrequirement .
hpc:Hasgmem rdfs:range xsd:nonNegativeInteger .

hpc:hasnvlink a owl:ObjectProperty .
hpc:Hasnvlink rdfs:domain hpc:Jobrequirement .
hpc:Hasnvlink rdfs:range xsd:boolean .

hpc:DefaultJobRequirement a hpc:JobRequirement .
hpc:Defaultjobrequirement hpc:hasnumgpus "1" .
hpc:Defaultjobrequirement hpc:hasmode "shared" .
hpc:Defaultjobrequirement hpc:hasmps "false" .
hpc:Defaultjobrequirement hpc:hasjexclusive "false" .
