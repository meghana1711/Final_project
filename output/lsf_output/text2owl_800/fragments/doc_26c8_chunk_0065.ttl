hpc:Booleanresource a owl:Class .
hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Booleanresource ;
    rdfs:range xsd:integer .

hpc:Numericresource a owl:Class .
hpc:hasminvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:integer .
hpc:hasmaxvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:integer .

hpc:nram a owl:DatatypeProperty ;
    rdfs:domain hpc:Numericresource ;
    rdfs:range xsd:integer .

hpc:Googlehost a owl:Class ;
    rdfs:subClassOf hpc:Booleanresource .

hpc:N1series a owl:Class .

hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:N1series ;
    rdfs:range xsd:integer .

hpc:ncores a owl:DatatypeProperty ;
    rdfs:domain hpc:N1series ;
    rdfs:range xsd:integer .

hpc:Gpuextend a owl:Class .
hpc:hasgpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuextend ;
    rdfs:range xsd:integer .

hpc:hasnnumas a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuextend ;
    rdfs:range xsd:integer .

hpc:gbrand a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpuextend ;
    rdfs:range xsd:string .
