hpc:Privatecloudconnection a owl:Class .
hpc:Ibmcloudregion hpc:hastype xsd:string .
hpc:Ibmcloudpakfordataurl hpc:hastype xsd:string .
hpc:Username hpc:hastype xsd:string .
hpc:Password hpc:hastype xsd:string .
hpc:Workingprojectname hpc:hastype xsd:string .

hpc:Publiccloudconnection a owl:Class .
hpc:Ibmcloudregion hpc:hastype xsd:string .
hpc:Ibmcloudapikey hpc:hastype xsd:string .
hpc:Ibmcloudspaceid hpc:hastype xsd:string .
hpc:Workingprojectname hpc:hastype xsd:string .

hpc:managelsfpredictorservice a owl:ObjectProperty .
hpc:Managelsfpredictorservice rdfs:domain hpc:Privatecloudconnection .
hpc:Managelsfpredictorservice rdfs:range hpc:Lsfpredictorservice .

hpc:Lsfpredictorservice a owl:Class .

hpc:logintolsfpredictorhost a owl:ObjectProperty .
hpc:Logintolsfpredictorhost rdfs:domain hpc:Lsfpredictorservice .
hpc:Logintolsfpredictorhost rdfs:range xsd:string .

hpc:navigatetolsfpredictordirectory a owl:ObjectProperty .
hpc:Navigatetolsfpredictordirectory rdfs:domain hpc:Lsfpredictorservice .
hpc:Navigatetolsfpredictordirectory rdfs:range xsd:string .
