hpc:EgoResourceGroup a owl:Class .
hpc:Goals a owl:Class .
hpc:guarantee a owl:ObjectProperty .

hpc:Goals rdfs:subClassOf hpc:Goals .
hpc:Guarantee rdfs:domain hpc:Goals ;
                               rdfs:range hpc:EgoResourceGroup .

hpc:throughput a owl:ObjectProperty ;
              rdfs:subPropertyOf hpc:GOALS ;
              rdfs:domain hpc:Goals ;
              rdfs:range xsd:nonNegativeInteger ;
              rdfs:range hpc:Timewindow .

hpc:velocity a owl:ObjectProperty ;
            rdfs:subPropertyOf hpc:GOALS ;
            rdfs:domain hpc:Goals ;
            rdfs:range xsd:nonNegativeInteger ;
            rdfs:range hpc:Timewindow .

hpc:timewindow a owl:DatatypeProperty ;
              rdfs:domain hpc:Througput ;
              rdfs:domain hpc:Velocity ;
              rdfs:range xsd:dateTime .

hpc:numJobs a owl:DatatypeProperty ;
             rdfs:domain hpc:Throughtput ;
             rdfs:domain hpc:Velocity ;
             rdfs:range xsd:nonNegativeInteger .
