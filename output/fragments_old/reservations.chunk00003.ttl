# Reservation
hpc:Reservation a owl:Class .

# Reservation properties
hpc:startTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:endTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:dateTime .
hpc:duration a xsd:duration .
hpc:nodes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Node .
hpc:users a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User .
hpc:flags a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .
hpc:state a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

# Node
hpc:Node a owl:Class .

# User
hpc:User a owl:Class .

# Flag
hpc:NO_HOLD_JOBS_AFTER_END a xsd:string .
hpc:maint a xsd:string .
hpc:overlap a xsd:string .
hpc:TIME_FLOAT a xsd:string .
hpc:REPLACE a xsd:string .
hpc:REPLACE_DOWN a xsd:string .
hpc:FLEX a xsd:string .

# Reservation subclasses
hpc:ReservationWithNoHoldJobsAfterEnd a hpc:Reservation ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:flags ;
                        owl:hasValue hpc:NO_HOLD_JOBS_AFTER_END ] .
hpc:MaintenanceReservation a hpc:Reservation ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:flags ;
                        owl:hasValue hpc:maint ] .
hpc:OverlappingReservation a hpc:Reservation ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:flags ;
                        owl:hasValue hpc:overlap ] .
