hpc:Esubpjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hasexecutable a owl:ObjectProperty ;
    rdfs:domain hpc:Esubpjob ;
    rdfs:range xsd:string .

hpc:hasarguments a owl:DatatypeProperty ;
    rdfs:domain hpc:Esubpjob ;
    rdfs:range xsd:string .

hpc:hasflag a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .

hpc:Lsfjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hasallocationflags a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .

hpc:hasapplicationprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Applicationprofile .

hpc:Autoresizable a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:notifiesuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Applicationprofile a owl:Class .
