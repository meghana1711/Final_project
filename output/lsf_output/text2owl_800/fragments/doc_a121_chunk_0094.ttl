hpc:Job a owl:Class .
hpc:systemapspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:calculatedapspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeDecimal .
hpc:adminapspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeDecimal .
hpc:Jobwithstaticsystemapspriority a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobwithrecalculatedapspriority a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobwithoverriddenapspriorities a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Jobwithpreservedapspriorities a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:hassystemapspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Jobwithstaticsystemapspriority ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hascalculatedapspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobwithrecalculatedapspriority .
hpc:hasadminapspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobwithoverriddenapspriorities .
hpc:haspreservedapspriorities a owl:ObjectProperty ;
    rdfs:domain hpc:Jobwithpreservedapspriorities .

hpc:jobundopreviousapssetting a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:jobchangecalculatedapspriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:jobalwaysoverridesapspriorities a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
