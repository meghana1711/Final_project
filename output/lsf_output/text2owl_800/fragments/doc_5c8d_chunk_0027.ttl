hpc:CsmReq a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Specifies the required values for the CSM bsub job submission options." .

hpc:hascsmReqOption a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range rdf:List ;
    rdfs:comment "Use a colon (:) to separate multiple CSM job options." .

hpc:CsmReqOption a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A single option within the CSM_REQ." .

hpc:hascsmReqOptionValue a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReqOption ;
    rdfs:range xsd:string ;
    rdfs:comment "The value of the CSM_REQ option." .

hpc:hascolondelimitedoptions a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReqOption ;
    rdfs:range rdf:List ;
    rdfs:comment "Separate multiple options with a colon (:)." .

hpc:hasoptionvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Hascolondelimitedoptions ;
    rdfs:range xsd:string ;
    rdfs:comment "The value of a single option." .

hpc:hasallocflags a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReqOption ;
    rdfs:range xsd:string ;
    rdfs:comment "An alphanumeric string of flags separated by spaces." .

hpc:LsbJsmDefault a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Specifies the default value for the bsub -jsm option for CSM jobs." .
