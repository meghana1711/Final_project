hpc:Lsbparameter a owl:Class .

hpc:hasdefinition a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparameter ;
    rdfs:range xsd:string .

hpc:issetduringjobexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparameter .

hpc:LSB_BHOSTS_FORMAT a hpc:LSBParameter ;
    hpc:hasDefinition "This parameter can be set from the command line or from lsf.conf. See LSB_BHOSTS_FORMAT in lsf.conf." .

hpc:LSB_BJOBS_FORMAT a hpc:LSBParameter ;
    hpc:hasDefinition "This parameter can be set from the command line or from lsf.conf. See LSB_BJOBS_FORMAT in lsf.conf." .

hpc:LSB_BMGROUP_ALLREMOTE_EXPAND a hpc:LSBParameter ;
    hpc:hasDefinition "Syntax
This parameter can be set from the command line or from lsf.conf. See LSB_BMGROUP_ALLREMOTE_EXPAND in lsf.conf." .

hpc:LSB_BQUEUES_FORMAT a hpc:LSBParameter ;
    hpc:hasDefinition "This parameter can be set from the command line or from lsf.conf. See LSB_BQUEUES_FORMAT in lsf.conf." .

hpc:LSB_BSUB_ERR_RETRY a hpc:LSBParameter ;
    hpc:hasDefinition "In some cases, jobs can benefit from being automatically retried in the case of failing for a particular error." .

hpc:lsbBsubErrRetryRetryCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbBsubErrRetry ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbBsubErrRetryErrType a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbBsubErrRetry ;
    rdfs:range xsd:string .
