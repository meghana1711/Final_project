hpc:Plugin a owl:Class ;
  rdfs:subClassOf owl:Class ;
  rdfs:comment "Represents a Slurm CLI filter plugin." .

hpc:pluginname a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range xsd:string ;
  rdfs:comment "Identifies the plugin." .

hpc:plugintype a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range xsd:string ;
  rdfs:comment "The major and minor type of the plugin." .

hpc:majortype a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugintype ;
  rdfs:range xsd:string ;
  rdfs:comment "The major type must be 'cli_filter'." .

hpc:minortype a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugintype ;
  rdfs:range xsd:string ;
  rdfs:comment "The minor type can be any suitable name for the type of job submission package." .

hpc:pluginversion a owl:DatatypeProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range xsd:unsignedInt ;
  rdfs:comment "Identifies the version of Slurm used to build this plugin." .

hpc:clifilterpsetupdefaults a owl:ObjectProperty ;
  rdfs:domain hpc:Plugin ;
  rdfs:range hpc:Slurmopt ;
  rdfs:comment "Called by the salloc, sbatch, or srun command line interface (CLI) programs shortly before processing any options from the environment, command line, or script." .
