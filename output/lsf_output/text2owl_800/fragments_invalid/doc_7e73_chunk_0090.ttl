hpc:Lsfmanagementhost a owl:Class .
hpc:installjavaversion a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:sourcelsfenvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:copyconnectorpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:extractconnectorpackage a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:copyconnectordirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:createcyclecloudsubdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:copyconfdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:edithostprovidersjson a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:replaceebrokerdexecutable a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:string .
hpc:Azurecyclecloudprovider a owl:Class .
hpc:hasazurecyclecloudprovider a owl:ObjectProperty ;
    rdfs:domain hpc:LsfTop/conf/resource_connector/hostProviders.json ;
    rdfs:range hpc:Azurecyclecloudprovider .
