    hpc:Status "ok" ;
    hpc:JL 1.0 ;
    hpc:U 0.0 ;
    hpc:MAX 0.0 ;
    hpc:NJOBS 8.2 ;
    hpc:RUN 2 ;
    hpc:SSUSP 2 ;
    hpc:USUSP 14 ;
    hpc:RSV "4231M" ;
    hpc:belongsTo _:groupB .

