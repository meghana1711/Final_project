@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Lsfdnsserver a owl:Class .
hpc:Dnsforwardzone a owl:Class .
hpc:openstackdnsforwarder a owl:ObjectProperty .
hpc:instancedomain a owl:DatatypeProperty .
hpc:Openstackdnsserver a rdfs:subClassOf hpc:Lsfdnsserver .
hpc:hasforwardzone a owl:ObjectProperty .
hpc:hasopenstackdnsforwarder a owl:DatatypeProperty .
hpc:hasinstancedomain a owl:DatatypeProperty .

hpc:Openstackresourceconnector a owl:Class .
hpc:Osprovconfiguration a owl:Class .
hpc:Osprovtemplate a owl:Class .
hpc:osprovconfigure a owl:ObjectProperty .
hpc:osprovtemplates a owl:DatatypeProperty .
hpc:Openstackresourceconnector a rdfs:subClassOf hpc:Lsfdnsserver .
hpc:hasosprovconfiguration a owl:ObjectProperty .
hpc:hasosprovtemplates a owl:DatatypeProperty .

hpc:ncpus a owl:DatatypeProperty .
hpc:openstackhost a owl:DatatypeProperty .

hpc:Osprovtemplate a rdfs:subClassOf hpc:Osprovconfiguration .
rdfs:domain(hpc:Osprovtemplate) hpc:Ncpus ;
rdfs:domain(hpc:Osprovtemplate) hpc:Openstackhost ;
rdfs:range(hpc:Ncpus) xsd:nonNegativeInteger ;
rdfs:range(hpc:Openstackhost) xsd:boolean .
