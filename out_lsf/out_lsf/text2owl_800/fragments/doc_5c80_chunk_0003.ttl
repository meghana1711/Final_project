hpc:Procedure a owl:Class .
hpc:Queues a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Job a owl:Class .
hpc:Queuetype a owl:Class .
hpc:Nightqueue rdfs:subClassOf hpc:Queuetype .
hpc:Priorityqueue rdfs:subClassOf hpc:Queuetype .
hpc:Idlequeue rdfs:subClassOf hpc:Queuetype .
hpc:Shortqueue rdfs:subClassOf hpc:Queuetype .
hpc:submitjob a owl:ObjectProperty .
hpc:Queue rdfs:domain hpc:Job ;
    rdfs:range hpc:Queues .
hpc:User rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:Hour rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Host rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:Project rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:projectname a owl:DatatypeProperty .
hpc:queuetype a owl:ObjectProperty .
hpc:queuename a owl:DatatypeProperty .
hpc:queuedescription a owl:DatatypeProperty .
hpc:projectassociation a owl:ObjectProperty .
