hpc:Pendingreason a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Candidatehost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Noncandidatehost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Jobinformationquerycommand a owl:Class ;
    rdfs:subClassOf owl:Thing .

# Object Properties
hpc:hasPendingReason an owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Pendingreason .

hpc:showsReason an owl:ObjectProperty ;
    rdfs:domain hpc:Pendingreason ;
    rdfs:range hpc:Host .

hpc:hasNumberOfHosts an owl:ObjectProperty ;
    rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:nonNegativeInteger .

hpc:isMoreCommon an owl:ObjectProperty ;
    rdfs:domain hpc:Pendingreason ;
    rdfs:range hpc:Pendingreason .

hpc:isCandidateHost an owl:ObjectProperty ;
    rdfs:domain hps:Host ;
    rdfs:range hpc:Candidatehost .

hpc:isNonCandidateHost an owl:ObjectProperty ;
    rdfs:domain hps:Host ;
    rdfs:range hpc:Noncandidatehost .

hpc:hasTimeout an owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformationquerycommand ;
    rdfs:range xsd:nonNegativeInteger .

# Datatype Properties
hpc:hastimeoutinminutes a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbBlockJobinfoTimeout ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:string .

# Individuals
hpc:LSB_BLOCK_JOBINFO_TIMEOUT a hpc:JobInformationQueryCommand .
