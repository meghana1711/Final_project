hpc:SLURM_TASKS_PER_NODE a owl:DatatypeProperty .
hpc:SLURM_TASKS_PER_NODE rdfs:domain SrunProlog ;
                                   rdfs:domain TaskProlog ;
                                   rdfs:domain SrunEpilog ;
                                   rdfs:domain TaskEpilog .
hpc:SLURM_TASKS_PER_NODE rdfs:range xsd:nonNegativeInteger .

hpc:SLURM_TOPOLOGY_ADDR a owl:DatatypeProperty .
hpc:SLURM_TOPOLOGY_ADDR rdfs:domain SrunProlog ;
                                   rdfs:domain TaskProlog ;
                                   rdfs:domain SrunEpilog ;
                                   rdfs:domain TaskEpilog .
hpc:SLURM_TOPOLOGY_ADDR rdfs:range xsd:string .

hpc:SLURM_TOPOLOGY_ADDR_PATTERN a owl:DatatypeProperty .
