hpc:NoPreemptRunTime a owl:Class .
hpc:hasruntime a owl:ObjectProperty ;
    rdfs:domain hpc:NoPreemptRunTime ;
    rdfs:range xsd:string .

hpc:Runtime a owl:Class .
hpc:islsbapplicationruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Runtime .

hpc:Runlimit a owl:Class ;
    rdfs:subClassOf hpc:Runtime .

hpc:LsbApplications a owl:Class ;
    rdfs:subClassOf hpc:Runtime .

hpc:LsbQueues a owl:Class ;
    rdfs:subClassOf hpc:Runtime .

hpc:runLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:string .

hpc:bsubW a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:string .

hpc:MaxJobMsgNum a owl:Class .
hpc:hasmaxmessageslots a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxJobMsgNum ;
    rdfs:range xsd:integer .

hpc:OrphanJobTermGracePeriod a owl:Class .
hpc:hasorphanjobtermgraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:OrphanJobTermGracePeriod ;
    rdfs:range xsd:integer .

hpc:ORPHAN_JOB_TERM_GRACE_PERIOD_NOT_DEFINED a owl:NamedIndividual ;
    hpc:hasOrphanJobTermGracePeriod xsd:0 .

hpc:OrphanJobTermGracePeriodEnabled a owl:Class ;
    rdfs:subClassOf hpc:OrphanJobTermGracePeriod .

hpc:OrphanJobTermGracePeriodDefined a owl:Class ;
    rdfs:subClassOf hpc:OrphanJobTermGracePeriod .

hpc:ParallelSchedBySlot a owl:Class .
hpc:usesslotbasedscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:ParallelSchedBySlot .
