hpc:Cloudinstance a owl:Class .
hpc:Defaultclouduser a owl:Class .
hpc:Rootuser a owl:Class .
hpc:Firewall a owl:Class .
hpc:firewallcommunication a owl:ObjectProperty .
hpc:firewallportopening a owl:ObjectProperty .
hpc:Firewallport rdfs:domain hpc:Firewallcommunication ;
    rdfs:range xsd:integer .
hpc:Lsf a owl:Class .
hpc:Lsfinstallation a owl:Class .
hpc:Serverconfigfile a owl:Class .
hpc:Lsfparameter a owl:Class .
hpc:lsfparametervalue a owl:DatatypeProperty .
hpc:Lsfparametervalue rdfs:range xsd:string .
hpc:lsfinstallcommand a owl:ObjectProperty .
hpc:Userpreparation a owl:Class .
hpc:usermapping a owl:ObjectProperty .
hpc:Instanceuser a owl:Class .
hpc:portnumber a owl:DatatypeProperty .
hpc:Portnumber rdfs:range xsd:integer .
hpc:logout a owl:ObjectProperty .

hpc:Cloudinstance rdfs:subClassOf owl:Class .
hpc:Defaultclouduser rdfs:subClassOf hpc:Cloudinstance .
hpc:Rootuser rdfs:subClassOf hpc:Cloudinstance .
hpc:Firewall rdfs:subClassOf owl:Class .
hpc:Firewallcommunication rdfs:domain hpc:Firewall ;
    rdfs:range hpc:Cloudinstance .
hpc:Firewallportopening rdfs:domain hpc:Firewallcommunication ;
    rdfs:range hpc:Firewallport .
hpc:Lsf rdfs:subClassOf owl:Class .
hpc:Lsfinstallation rdfs:subClassOf hpc:Lsf .
hpc:Serverconfigfile rdfs:subClassOf owl:Class .
hpc:Lsfparameter rdfs:subClassOf owl:Class .
hpc:Lsfparametervalue rdfs:domain hpc:Lsfparameter .
hpc:Lsfinstallcommand rdfs:domain hpc:Lsfinstallation ;
    rdfs:range rdf:Literal .
hpc:Userpreparation rdfs:subClassOf owl:Class .
hpc:Usermapping rdfs:domain hpc:Userpreparation ;
    rdfs:range rdf:List .
hpc:Instanceuser rdfs:subClassOf owl:Class .
hpc:Portnumber rdfs:domain hpc:Instanceuser .
hpc:Logout rdfs:domain hpc:Cloudinstance .

hpc:LSF_LIM_PORT a hpc:LSFParameter ;
    rdfs:label "LSF_LIM_PORT" ;
    rdfs:comment "Default LSF_LIM_PORT value" ;
    hpc:LSFParameterValue "7869" .
hpc:LSF_RES_PORT a hpc:LSFParameter ;
    rdfs:label "LSF_RES_PORT" ;
    rdfs:comment "Default LSF_RES_PORT value"
