    rdfs:range rdf:List ;
    rdfs:subPropertyOf owl:FunctionalProperty .
hpc:profile rdf:first a xsd:string .

hpc:profile rdf:rest rdf:type hpc:ProfileEnum .
hpc:ProfileEnum a owl:Class .
hpc:ProfileEnum rdfs:subClassOf xsd:string .

hpc:ProfileEnum "NOT_SET" .
hpc:ProfileEnum "NONE" .
hpc:ProfileEnum "ENERGY" .
hpc:ProfileEnum "LUSTRE" .
hpc:ProfileEnum "NETWORK" .
hpc:ProfileEnum "TASK" .

hpc:profile rdf:type rdfs:Resource .

hpc:profile rdf:type rdf:List .

