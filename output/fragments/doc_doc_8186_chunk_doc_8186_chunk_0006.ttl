hpc:SlurmUser a owl:Class .
hpc:RootUser a owl:Class, rdfs:subClassOf hpc:SlurmUser .

hpc:providesCorrectHTTPHeaders a owl:ObjectProperty .
hpc:providesCorrectHTTPHeaders rdfs:domain hpc:SlurmUser ;
                                 rdfs:range xsd:boolean .

hpc:XSLURMUSERNAME a owl:DatatypeProperty .
hpc:XSLURMUSERNAME rdfs:domain hpc:SlurmUser ;
                      rdfs:range xsd:string .

hpc:XSLURMUSERTOKEN a owl:DatatypeProperty .
hpc:XSLURMUSERTOKEN rdfs:domain hpc:SlurmUser ;
                        rdfs:range xsd:string .

hpc:HTTP1_1Compliant a owl:ObjectProperty .
hpc:HTTP1_1Compliant rdfs:domain hpc:AuthenticatingProxy ;
                          rdfs:range xsd:boolean .

hpc:AuthenticatingProxy a owl:Class .
hpc:followsSiteSecurityPolicies a owl:ObjectProperty .
hpc:followsSiteSecurityPolicies rdfs:domain hpc:AuthenticatingProxy ;
                                     rdfs:range xsd:boolean .

hpc:proxiedRequestsFromCorrectUser a owl:ObjectProperty .
hpc:proxiedRequestsFromCorrectUser rdfs:domain hpc:AuthenticatingProxy ;
                                         rdfs:range xsd:boolean .
```
