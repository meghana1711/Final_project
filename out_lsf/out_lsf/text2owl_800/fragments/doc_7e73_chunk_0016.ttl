hpc:Lsfadministrator a owl:Class .
hpc:Ibmvpcpackage a owl:Class .
hpc:Ibmcloudnetworkingservicespackage a owl:Class .

hpc:installprocedure a owl:ObjectProperty .
hpc:Installprocedure rdfs:domain hpc:Lsfadministrator .
hpc:Installprocedure rdfs:range hpc:Ibmvpcpackage, hpc:Ibmcloudnetworkingservicespackage .

hpc:enabledynamichosts a owl:ObjectProperty .
hpc:Enabledynamichosts rdfs:domain hpc:Lsfadministrator .
hpc:Enabledynamichosts rdfs:range hpc:Lsfconfiguration .

hpc:editlsfconf a owl:ObjectProperty .
hpc:Editlsfconf rdfs:domain hpc:Lsfadministrator .
hpc:Editlsfconf rdfs:range hpc:Lsfconfiguration .

hpc:editlsfclusterconfig a owl:ObjectProperty .
hpc:Editlsfclusterconfig rdfs:domain hpc:Lsfadministrator .
hpc:Editlsfclusterconfig rdfs:range hpc:Lsfconfiguration .

hpc:adddemandcalculationschedulermodule a owl:ObjectProperty .
hpc:Adddemandcalculationschedulermodule rdfs:domain hpc:Lsfadministrator .
hpc:Adddemandcalculationschedulermodule rdfs:range hpc:Lsbmodules .

hpc:Lsfconfiguration a owl:Class .
hpc:Lsfconfiguration rdfs:subClassOf owl:Class .
hpc:Lsfconfiguration rdfs:range xsd:string .

hpc:Lsbmodules a owl:Class .
hpc:Lsbmodules rdfs:subClassOf owl:Class .
hpc:Lsbmodules rdfs:range xsd:string .

hpc:lsfDynamicHostWaitTime a owl:DatatypeProperty .
hpc:LsfDynamicHostWaitTime rdfs:domain hpc:Lsfconfiguration .
hpc:LsfDynamicHostWaitTime rdfs:range xsd:string .

hpc:lsfHostAddrRange a owl:DatatypeProperty .
hpc:LsfHostAddrRange rdfs:domain hpc:Lsfconfiguration .
hpc:LsfHostAddrRange rdfs:range xsd:string .
