hpc:SlurmMailingList a owl:Class .
hpc:SlurmAnnounceList a hpc:SlurmMailingList ;
    rdfs:comment "Designated for communications about Slurm releases. Only SchedMD may post to this list. Low traffic." ;
    rdfs:subClassOf hpc:MailingList .

hpc:SlurmUsersList a hpc:SlurmMailingList ;
    rdfs:comment "For discussion by the Slurm community, and is typically used by Slurm system administrators for discussion and community-provided support. Any person subscribed to this mailing list may post to it. High traffic." ;
    rdfs:subClassOf hpc:MailingList .

hpc:MailingList a owl:Class .

hpc:canPost a owl:ObjectProperty ;
    rdfs:domain hpc:MailingList ;
    rdfs:range xsd:boolean .

hpc:trafficLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:MailingList ;
    rdfs:range xsd:string .

hpc:hasArchive a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmMailingList .
```
