@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

# Classes
hpc:Fieldspecification a owl:Class .
hpc:Fieldwidth a owl:Class .
hpc:Justification a owl:Class .
hpc:Unitprefix a owl:Class .
hpc:Delimiter a owl:Class .

# Object Properties
hpc:hasfieldspecification a owl:ObjectProperty .
hpc:haswidth a owl:ObjectProperty .
hpc:hasjustification a owl:ObjectProperty .
hpc:hasunitprefix a owl:ObjectProperty .
hpc:hasdelimiter a owl:ObjectProperty .

# Datatype Properties
hpc:fieldname a owl:DatatypeProperty .
hpc:width a owl:DatatypeProperty .
hpc:justification a owl:DatatypeProperty .
hpc:unitprefix a owl:DatatypeProperty .
hpc:delimiter a owl:DatatypeProperty .

# Domain and Range
hpc:Fieldspecification rdfs:subClassOf owl:Class .
hpc:Hasfieldspecification rdfs:domain hpc:Fieldspecification ;
                                        rdfs:range rdf:Resource .
hpc:Haswidth rdfs:domain hpc:Fieldspecification ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:Hasjustification rdfs:domain hpc:Fieldspecification ;
                             rdfs:range hpc:Justification .
hpc:Hasunitprefix rdfs:domain hpc:Fieldspecification ;
                             rdfs:range hpc:Unitprefix .
hpc:Hasdelimiter rdfs:domain hpc:Fieldspecification ;
                             rdfs:range xsd:string .

# Enumerated Classes for Justification
hpc:LeftJustification a hpc:Justification .
hpc:RightJustification a hpc:Justification .

# Enumerated Classes for UnitPrefix
hpc:Kilobytes a hpc:UnitPrefix .
hpc:Megabytes a hpc:UnitPrefix .
hpc:Gigabytes a hpc:UnitPrefix .
hpc:Terabytes a hpc:UnitPrefix .
hpc:Petabytes a hpc:UnitPrefix .
hpc:Exabytes a hpc:UnitPrefix .
hpc:Zettabytes a hpc:UnitPrefix .
hpc:Automatic a hpc:UnitPrefix .
