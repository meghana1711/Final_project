hpc:Lsfinstallation a owl:Class .
hpc:hasEdition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:isldapintegrated a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:boolean .

hpc:hasInstallerUserPrivileges rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ldapconfiguration ;
    rdfs:range xsd:string .

hpc:Ldapadministrator a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Lsfinstalleruser a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Lsfcluster a owl:Class ;
    rdfs:subClassOf hpc:Lsfinstallation .

hpc:edInstallationRequired rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:boolean .

hpc:Installationfileserver a owl:Class ;
    rdfs:subClassOf hpc:System .

hpc:installationdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:configurationfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range xsd:string .

hpc:System a owl:Class .
