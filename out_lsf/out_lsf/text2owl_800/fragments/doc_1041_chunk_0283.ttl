hpc:Host a owl:Class .
hpc:askhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:numberofexecutionhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:allocationslot a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Allocation .
hpc:Allocation a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        owl:intersectionOf ( hpc:ExecutionHost hpc:NumberOfSlots ) ] .
hpc:numberofslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range xsd:integer .
hpc:hostfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:exclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:requiredslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:estimatedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:specifiedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:specifiedterminatetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:timeleft a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
