hpc:Logfile a owl:Class .
hpc:defaultlocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:Linux a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Windows a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Logtype a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:NamedLog a hpc:LogType ;
hpc:PemLog a hpc:LogType ;
hpc:VemkdLog a hpc:LogType ;
hpc:WsgLog a hpc:LogType ;
hpc:EscLog a hpc:LogType .

hpc:location a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range hpc:Linux .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:logcontent a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .
