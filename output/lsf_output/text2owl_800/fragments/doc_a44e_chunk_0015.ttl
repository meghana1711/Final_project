hpc:Cacheinputfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A file that LSF data manager can access directly via a symbolic link in the cache." ;
    rdfs:label "CacheInputFile" ;
    rdfs:domain hpc:Job .

hpc:Cacheoutputfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A file that is staged out after the completion of a job." ;
    rdfs:label "CacheOutputFile" ;
    rdfs:domain hpc:Job .

hpc:cacheinputgraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Minimum time in minutes that an input file is kept in the LSF data manager cache after no jobs reference it." ;
    rdfs:label "cacheInputGracePeriod" .

hpc:cacheoutputgraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Minimum time in minutes that an output file is kept in the LSF data manager cache after its transfer completes." ;
    rdfs:label "cacheOutputGracePeriod" .
