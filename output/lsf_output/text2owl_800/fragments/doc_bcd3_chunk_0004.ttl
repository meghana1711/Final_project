hpc:Daemonlogfile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Log files for daemons used for diagnostics." .

hpc:Mbatchddaemon a owl:Class ;
    rdfs:subClassOf hpc:Daemonlogfile ;
    rdfs:comment "LSF daemon for monitoring mbatchd." .

hpc:Lsfproxyddaemon a owl:Class ;
    rdfs:subClassOf hpc:Daemonlogfile ;
    rdfs:comment "LSF daemon for monitoring lsfproxyd, including the LSF rate limiter." .

hpc:Schedulerdiagnostics a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Diagnostic information for scheduler." .

hpc:Schedulerefficiency a owl:Class ;
    rdfs:subClassOf hpc:Schedulerdiagnostics ;
    rdfs:comment "Monitoring scheduler efficiency." .

hpc:Scheduleroverhead a owl:Class ;
    rdfs:subClassOf hpc:Schedulerdiagnostics ;
    rdfs:comment "Monitoring scheduler overhead." .

hpc:Performancemetrics a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Performance metrics collected by LSF." .

hpc:perfmonview a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemetrics ;
    rdfs:range hpc:Viewcommand ;
    rdfs:comment "Command to monitor performance metrics in real time." .

hpc:sampleperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetrics ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Sampling period for performance metrics." .

hpc:Lsbparamsfile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "File containing LSF parameters." .

hpc:metriccollection a owl:ObjectProperty ;
    rdfs:domain hpc:Performancemetrics ;
    rdfs:range hpc:Collectionstatus ;
    rdfs:comment "Start or stop performance metric collection." .

hpc:Collectionstatus a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Status of performance metric collection." .

hpc:Enabled a owl:Class ;
    rdfs:subClassOf hpc:Collectionstatus ;
    rdfs:comment "Performance metric collection is enabled." .

hpc:Disabled a owl:Class ;
    rdfs:subClassOf hpc:Collectionstatus ;
    rdfs:comment "Performance metric collection is disabled." .
