  rdfs:range xsd:integer .

hpc:MinFrequency rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:Step ;
  rdfs:range xsd:integer .

hpc:ExitCode rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:Step .

hpc:State rdf:type owl:Class ;
  rdfs:subClassOf xsd:string .

hpc:NodeState rdf:type owl:Class ;
  rdfs:subClassOf hpc:State .

hpc:ResumeAfter rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:Updatenodemsg .

hpc:StateArray rdf:type owl:Class ;
  rdfs:subClassOf xsd:string .

hpc:Topology rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:Updatenodemsg .

hpc:Weight rdf:type owl:DatatypeProperty ;
  rdfs:domain hpc:Updatenodemsg .

