hpc:User a owl:Class .
hpc:Administrator rdf:subClassOf hpc:User .

hpc:Jobgroup a owl:Class .
hpc:ImplicitJobGroup rdf:subClassOf hpc:JobGroup .
hpc:ExplicitJobGroup rdf:subClassOf hpc:JobGroup .

hpc:ownsjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobgroup .

hpc:hassubjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Jobgroup .

hpc:isemptyjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:boolean .

hpc:deleteemptyjobgroups a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Jobgroup .

hpc:deleteemptyjobgroupsforspecifieduser a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Jobgroup .

hpc:deleteallemptyjobgroupsforspecifieduser a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Jobgroup .

hpc:deletejobgroupandsubgroups a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Jobgroup .

hpc:deleteallemptyjobgroupsbelowjobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Jobgroup .

hpc:jobgroupname a owl:DatatypeProperty ;
    rdfs:domain hpc:Objectproperty .

hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Objectproperty .
