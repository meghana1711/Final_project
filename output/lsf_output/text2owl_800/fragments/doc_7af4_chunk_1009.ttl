hpc:Environmentvariable a owl:Class .
hpc:Jobenvironmentvariable a owl:Class .
hpc:Sessionenvironmentvariable rdfs:subClassOf hpc:Jobenvironmentvariable .
hpc:Dataprovenanceenvironmentvariable rdfs:subClassOf hpc:Jobenvironmentvariable .
hpc:Lsfenvironmentvariable a owl:Class .
hpc:Jobexecutionenvironmentvariable a owl:Class .
hpc:Filevariables rdfs:subClassOf hpc:Lsfenvironmentvariable .
hpc:Commandvariables rdfs:subClassOf hpc:Lsfenvironmentvariable .
hpc:nameproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .
hpc:valueproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .
hpc:Jobeffectiveresourcerequirement rdfs:domain hpc:Jobexecutionenvironmentvariable ;
    rdfs:range xsd:string .
hpc:Errorfile rdfs:domain hpc:Filevariables ;
    rdfs:range xsd:string .
hpc:Effectiversrcreq rdfs:domain hpc:Jobexecutionenvironmentvariable ;
    rdfs:range xsd:string .
