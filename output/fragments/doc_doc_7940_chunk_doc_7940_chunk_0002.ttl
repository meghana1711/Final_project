hpc:Federation a owl:Class .
hpc:Cluster a owl:Class .

hpc:hasFederation a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Federation .

hpc:isInFederation a owl:ObjectProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range hpc:Cluster .

hpc:addClusterToFederation a owl:ObjectProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range hpc:Cluster .

hpc:removeClusterFromFederation a owl:ObjectProperty ;
    rdfs:domain hpc:Federation ;
    rdfs:range hpc:Cluster .

hpc:drainAndRemoveFromFederation a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean .

hpc:setFederationState a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:hasFeature a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range rdf:List .

hpc:Feature a owl:Class .

hpc:hasFederatedJobID a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:Job a owl:Class .
```
