hpc:Applicationprofile a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .
hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:filelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:datalimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:corelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:tasklimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:preExec a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .
hpc:requeueExitValues a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:nonNegativeInteger .
