hpc:Hosttype a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:architecture a owl:DatatypeProperty .
hpc:hasHostType rdf:type owl:ObjectProperty .
hpc:hasModel rdf:type owl:ObjectProperty .
hpc:Modelname rdf:type rdfs:domain, rdfs:range xsd:string .
hpc:Cpufactor rdf:type rdfs:domain, rdfs:range xsd:decimal .
hpc:Architecture rdf:type rdfs:range xsd:string .

hpc:HostType
  rdfs:subClassOf [ a owl:Class ;
                    owl:unionOf ( hpc:SOL64 hpc:SOLSPARC hpc:LINUX86LINUXPPC hpc:LINUX64 hpc:NTX86 hpc:NTX64 hpc:NTIA64 )
  ] .

hpc:HostModel
  rdfs:subClassOf [ a owl:Class ;
                    rdfs:subClassOf [ a owl:Class ;
                                       owl:onProperty hpc:hasModel
                                     ]
  ] .

hpc:hasHostType
  rdfs:domain hpc:Hosttype ;
  rdfs:range hpc:Host .

hpc:hasModel
  rdfs:domain hpc:Hostmodel ;
  rdfs:range hpc:Host .

hpc:modelName
  rdfs:domain hpc:Hostmodel ;
  rdfs:range xsd:string .

hpc:cpuFactor
  rdfs:domain hpc:Hostmodel ;
  rdfs:range xsd:decimal .

hpc:architecture
  rdfs:domain hpc:Hostmodel ;
  rdfs:range xsd:string .

hpc:Sol64 a owl:Class .
hpc:Solsparc a owl:Class .
hpc:Linux86linuxppc a owl:Class .
hpc:Linux64 a owl:Class .
hpc:Ntx86 a owl:Class .
hpc:Ntx64 a owl:Class .
hpc:Ntia64 a owl:Class .

hpc:PC400 a hpc:HostModel ;
          hpc:modelName "PC400" ;
          hpc:cpuFactor 13.0 ;
          hpc:architecture "i86pc_400 i686_400" .

hpc:PC450 a hpc:HostModel ;
          hpc:modelName "PC450" ;
          hpc:cpuFactor 13.2 ;
          hpc:architecture "i86pc_450 i686_450" .

hpc:Sparc5F a hpc:HostModel ;
            hpc:modelName "Sparc5F" ;
            hpc:cpuFactor 3.0 ;
            hpc:architecture "SUNWSPARCstation5_170_sparc" .

