hpc:Host a owl:Class .
hpc:memory a owl:DatatypeProperty .
hpc:Hasmemory rdfs:domain hpc:Host ;
                 rdfs:range xsd:decimal .

hpc:Numanode a owl:Class .
hpc:maxmemory a owl:DatatypeProperty .
hpc:Hasmaxmemory rdfs:domain hpc:Numanode ;
                 rdfs:range xsd:decimal .

hpc:Job a owl:Class .
hpc:requestsCores owl:ObjectProperty .
hpc:requestsSockets owl:ObjectProperty .
hpc:requestsCPUs owl:ObjectProperty .
hpc:Runsonhost rdfs:domain hpc:Job ;
                 rdfs:range hpc:Host .

hpc:Hosttopology a owl:Class .
hpc:Hostmemory rdfs:domain hpc:Hosttopology ;
                 rdfs:range xsd:decimal .
hpc:Numanode rdfs:domain hpc:Hosttopology ;
                 rdfs:range hpc:Numanode .
hpc:Socket rdfs:domain hpc:Hosttopology .
hpc:Core rdfs:domain hpc:Hosttopology .
hpc:Thread rdfs:domain hpc:Hosttopology .
