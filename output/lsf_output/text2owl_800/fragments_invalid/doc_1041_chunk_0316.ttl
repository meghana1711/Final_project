hpc:Lsfjobsuspensionreason a owl:Class .
hpc:Loadconditionexceeded a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobsuspensionreason ;
    rdfs:comment "The load conditions on the execution host or hosts have exceeded a threshold according to the loadStop vector defined for the host or queue." .

hpc:Runwindowclosed a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobsuspensionreason ;
    rdfs:comment "The run window of the job's queue is closed." .

hpc:Jobterminatedwithzerostatus a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobstatus ;
    rdfs:comment "The job has terminated with status of 0." .

hpc:Jobterminatedwithnonzerostatus a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobstatus ;
    rdfs:comment "The job has terminated with a non-zero status – it may have been aborted due to an error in its execution, or killed by its owner or the LSF administrator." .

hpc:jobabortedbyerror a owl:ObjectProperty ;
    rdfs:domain hpc:Jobterminatedwithnonzerostatus ;
    rdfs:range xsd:integer ;
    rdfs:comment "For example, exit code 131 means that the job exceeded a configured resource usage limit and LSF killed the job." .

hpc:jobkilledbyowner a owl:ObjectProperty ;
    rdfs:domain hpc:Jobterminatedwithnonzerostatus ;
    rdfs:range xsd:string ;
    rdfs:comment "For example, killed by its owner." .

hpc:jobkilledbyadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Jobterminatedwithnonzerostatus ;
    rdfs:range xsd:string ;
    rdfs:comment "For example, killed by the LSF administrator." .

hpc:Lostcontact a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobsuspensionreason ;
    rdfs:comment "mbatchd has lost contact with the sbatchd on the host on which the job runs." .

hpc:Zombiejob a owl:Class ;
    rdfs:subClassOf hpc:Lsfjobsuspensionreason ;
    rdfs:comment "A job becomes ZOMBI if: A non-rerunnable job is killed by bkill while the sbatchd on the execution host is unreachable and the job is shown as UNKWN." .

hpc:zombiejobexecutionclustertreatment a owl:ObjectProperty ;
    rdfs:domain hpc:Zombiejob ;
    rdfs:range xsd:string ;
    rdfs:comment "With the LSF multicluster capability, when a job running on a remote execution cluster becomes a ZOMBI job, the execution cluster treats the job the same way as local ZOMBI jobs." .

hpc:Jobstatus a owl:Class ;
    rdfs:subClassOf owl:Enum ;
    rdfs:comment "The status of an LSF job." .

hpc:LSFJob
