hpc:Node a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Defines a node. This includes the number and layout of boards, sockets, cores, threads and processors (logical CPUs) on the node." .

hpc:Partition a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Defines a partition. Several parameters of the partition definition affect the allocation of CPU resources to jobs (e.g., Nodes, OverSubscribe, MaxNodes)" .

hpc:configOverrides a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Resource ;
    rdfs:comment "Controls how the information in a node definition is used." .

hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Node, hpc:Partition ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the node or partition." .
