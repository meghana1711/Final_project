hpc:Globalpolicydaemon a owl:Class .
hpc:LsbGlobalPoliciesFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Globalpolicydaemon ;
    rdfs:range xsd:string .

hpc:Batchfeature a owl:Class .
hpc:jobforwardmode a owl:ObjectProperty ;
    rdfs:domain hpc:Batchfeature ;
    rdfs:range hpc:Jobforwardmode .
hpc:leasemode a owl:ObjectProperty ;
    rdfs:domain hpc:Batchfeature ;
    rdfs:range hpc:Leasemode .

hpc:Jobgrouplimit a owl:Class ;
    rdfs:subClassOf hpc:Batchfeature .

hpc:gpureqmerge a owl:DatatypeProperty ;
    rdfs:domain hpc:Globalpolicydaemon ;
    rdfs:range xsd:string .

hpc:Gpureq a owl:Class .
hpc:NumGpus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpureq ;
    rdfs:range xsd:nonNegativeInteger .
hpc:GpuModel rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpureq ;
    rdfs:range xsd:string .
hpc:Gmem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpureq ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Mode rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpureq ;
    rdfs:range xsd:string .
hpc:Glink rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Gpureq ;
    rdfs:range xsd:boolean .

hpc:Queuelevel a owl:Class ;
    rdfs:subClassOf hpc:Gpureq .

hpc:Queue a owl:Class .
hpc:GpuReqQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queuelevel .

hpc:Applicationlevel a owl:Class ;
    rdfs:subClassOf hpc:Gpureq .

hpc:Applicationprofile a owl:Class .
hpc:GpuReqApplication rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Applicationlevel .

hpc:Joblevel a owl:Class ;
    rdfs:subClassOf hpc:Gpureq .

hpc:Job a owl:Class .
hpc:GpuReqJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Joblevel .
hpc:QueueJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:AppJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Application
