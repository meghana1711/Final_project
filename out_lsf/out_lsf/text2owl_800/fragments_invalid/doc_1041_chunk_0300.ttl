hpc:Pendingjob a owl:Class .
hpc:Individualhostbasedreason a owl:Class .
hpc:Jobresourcerequirementnotsatisfied a owl:Class .
hpc:Newjobwaitingforscheduling a owl:Class .

# Job properties
hpc:haspendingreason a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Pendingreason .

hpc:hasindividualhostbasedreason a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Individualhostbasedreason .

hpc:hasjobresourcerequirementnotsatisfied a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Jobresourcerequirementnotsatisfied .

hpc:hasnewjobwaitingforscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Newjobwaitingforscheduling .

# Individual host based reasons
hpc:Loadinformationunavailable a owl:Class ;
    rdfs:subClassOf hpc:Individualhostbasedreason .

hpc:Closedbylsfadministrator a owl:Class ;
    rdfs:subClassOf hpc:Individualhostbasedreason .

hpc:Notspecifiedinjobsubmission a owl:Class ;
    rdfs:subClassOf hpc:Individualhostbasedreason .

hpc:Jobrequirementsforreservingresource a owl:Class ;
    rdfs:subClassOf hpc:Individualhostbasedreason .

# Job requirements for reserving resource
hpc:Resourcerequirement a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string .

hpc:jobrequiresresource a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Resourcerequirement .

# Queue classes
hpc:Queue a owl:Class .

# bjobs command classes
hpc:Bjobscommand a owl:Class .
hpc:displayspendingjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Queue .

hpc:displaysfinishedjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Queue .

hpc:displaysrunningjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Queue .

hpc:displaysjobresourceusage a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Queue .

# Categories
hpc:Category a owl:Class .
hpc:filter a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
