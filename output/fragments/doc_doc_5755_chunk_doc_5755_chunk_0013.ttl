# Job
hpc:Job a owl:Class .

# SubmittedBatchJob
hpc:SubmittedBatchJob a owl:Class, rdfs:subClassOf(hpc:Job) .
hpc:hasID a owl:ObjectProperty .

# User
hpc:User a owl:Class .
hpc:hasUsername a owl:DatatypeProperty .

# File
hpc:File a owl:Class .
hpc:hasName a owl:DatatypeProperty .
hpc:hasSize a owl:DatatypeProperty .
hpc:hasCreationTime a owl:DatatypeProperty .

# Directory
hpc:Directory a owl:Class .
hpc:hasOwner a owl:ObjectProperty .
hpc:hasFiles a owl:ObjectProperty .

# SlurmJobEnvironment
hpc:SlurmJobEnvironment a owl:Class .
hpc:hasVariables a owl:ObjectProperty .

# SlurmProcess
hpc:SlurmProcess a owl:Class .
hpc:isDirectlyExecBySlurmd a owl:ObjectProperty .

# Script
hpc:Script a owl:Class .
hpc:hasShebang a owl:DatatypeProperty .

# AnsysProgram
hpc:AnsysProgram a owl:Class .
hpc:isInteractive a owl:DatatypeProperty .
hpc:hasRunScript a owl:ObjectProperty .
```
