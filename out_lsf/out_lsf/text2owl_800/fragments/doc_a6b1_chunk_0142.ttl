hpc:wsgPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Webservicegateway ;
    rdfs:range xsd:integer .

hpc:wsgDebugDetail a owl:DatatypeProperty ;
    rdfs:domain hpc:Webservicegateway ;
    rdfs:range xsd:string .

hpc:logfilelocation a owl:ObjectProperty ;
    rdfs:domain hpc:Webservicegateway .

hpc:LogClass a owl:Enum ;
    rdfs:member "critical" ;
    rdfs:member "error" ;
    rdfs:member "warning" ;
    rdfs:member "notice" ;
    rdfs:member "info" ;
    rdfs:member "debug" ;
    rdfs:member "dynamic" .

hpc:logseverity a owl:DatatypeProperty ;
    rdfs:domain hpc:Logclass ;
    rdfs:range xsd:string .

hpc:loglevel a owl:DatatypeProperty ;
    rdf:subClassOf hpc:LogClass ;
    rdfs:domain hpc:Logclass ;
    rdfs:range xsd:string .

hpc:Loggrowthrate a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:RegularOperationLogLevel a owl:NamedIndividual ;
    hpc:LogLevel "LOG_WARNING" .

hpc:TroubleshootingLogLevel a owl:NamedIndividual ;
    hpc:LogLevel "LOG_DEBUG" .
