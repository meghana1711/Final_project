hpc:IBMCloudPakForDataMainWebConsoleURL rdf:type owl:DatatypeProperty .
hpc:IBMCloudPakForDataEmptyProjectName rdf:type owl:DatatypeProperty .
hpc:IBMCloudPakForDataAdministratorUsername rdf:type owl:DatatypeProperty .
hpc:IBMCloudPakForDataAdministratorPassword rdf:type owl:DatatypeProperty .

hpc:Watsonstudioserviceinstance a owl:Class .
hpc:IBMCloudAccount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Watsonstudioserviceinstance ;
    rdfs:range xsd:string .
hpc:Region rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:LitePlan rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:InstanceName rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
