hpc:Jobforwardingmode a owl:Class .
hpc:Filter a owl:Class .
hpc:Usergroupfilter a owl:Class .
hpc:Jobgroupfilter a owl:Class .

hpc:hasfilteredjob a owl:ObjectProperty ;
    rdfs:domain hpc:Jobforwardingmode ;
    rdfs:range hpc:Job .

hpc:hasusergroupfilter a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroupfilter ;
    rdfs:range hpc:Job .

hpc:hasjobgroupfilter a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroupfilter ;
    rdfs:range hpc:Job .

hpc:conflictingoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Jobforwardingmode ;
    rdfs:range hpc:Option .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf owl:NamedIndividual ] .

hpc:Option a owl:Class .
