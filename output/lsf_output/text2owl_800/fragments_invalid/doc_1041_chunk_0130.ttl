    rdfs:subClassOf rdf:Bag ;
    rdfs:subClassOf rdf:Alt ;
    rdfs:subClassOf rdf:First ;
    rdfs:subClassOf rdf:Rest .

hpc:userSharesValueUser a owl:DatatypeProperty ;
