hpc:Affinity a owl:Class .
hpc:Affinity rdfs:subClassOf owl:Class .

hpc:Thread a owl:Class .
hpc:Socket a owl:Class .
hpc:Core a owl:Class .

hpc:affinity rdf:type owl:ObjectProperty .
hpc:Affinity rdfs:domain hpc:Affinity .
hpc:Affinity rdfs:range hpc:Core .

hpc:cpubind rdf:type owl:DatatypeProperty .
hpc:Cpubind rdfs:domain hpc:Affinity .

hpc:membind rdf:type owl:DatatypeProperty .
hpc:Membind rdfs:domain hpc:Affinity .

hpc:Membind rdfs:range xsd:string .

hpc:membind rdfs:subPropertyOf hpc:cpubind .

hpc:bindLevel rdf:type owl:DatatypeProperty .
hpc:Bindlevel rdfs:domain hpc:Cpubind .
hpc:Bindlevel rdfs:range xsd:integer .

hpc:membind rdfs:subPropertyOf hpc:bindLevel .

hpc:membindValue rdf:type owl:DatatypeProperty .
hpc:Membindvalue rdfs:domain hpc:Membind .
hpc:Membindvalue rdfs:range xsd:string .

hpc:taskDistribution rdf:type owl:DatatypeProperty .
hpc:Taskdistribution rdfs:domain hpc:Affinity .
hpc:Taskdistribution rdfs:range xsd:string .

hpc:localonly rdf:type owl:Class .
hpc:localprefer rdf:type owl:Class .
hpc:distribute rdf:type owl:Class .

hpc:Localonly rdfs:subClassOf hpc:Distribute .
hpc:Localprefer rdfs:subClassOf hpc:Distribute .
