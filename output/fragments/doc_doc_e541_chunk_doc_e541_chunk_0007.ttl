hpc:EnergyTimeSeries a owl:Class .
hpc:Date a xsd:dateTime .
hpc:Time a xsd:time .
hpc:Power a xsd:decimal .
hpc:CPUFrequency a xsd:decimal .
hpc:EnergyIPMIFrequency a xsd:decimal .

hpc:FilesystemTimeSeries a owl:Class .
hpc:AcctGatherFilesystemType a xsd:string .
hpc:Filesystem a xsd:string .

hpc:JobAcctGatherFrequency rdf:type owl:ObjectProperty .
hpc:EnergyIPMIFrequency rdf:type owl:DatatypeProperty .
hpc:Filesystem rdf:type owl:DatatypeProperty .

hpc:EnergyTimeSeries rdfs:subClassOf [ a owl:Class ;
                                       rdfs:subClassOf hpc:DataSeries ] .
hpc:FilesystemTimeSeries rdfs:subClassOf [ a owl:Class ;
                                            rdfs:subClassOf hpc:DataSeries ] .

hpc:DataSeries rdf:type owl:Class .
hpc:DataSeries rdfs:subClassOf [ a owl:Class ;
                                  rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasDate a owl:ObjectProperty .
hpc:hasTime a owl:ObjectProperty .
hpc:hasPower a owl:DatatypeProperty .
hpc:hasCPUFrequency a owl:DatatypeProperty .
hpc:hasEnergyIPMI a owl:DatatypeProperty .
hpc:hasFilesystem a owl:DatatypeProperty .

hpc:DataSeries rdfs:domain hpc:DataSeries .
hpc:hasDate rdfs:domain hpc:EnergyTimeSeries ;
               rdfs:range hpc:Date .
hpc:hasTime rdfs:domain hpc:EnergyTimeSeries ;
               rdfs:range hpc:Time .
hpc:hasPower rdfs:domain hpc:EnergyTimeSeries ;
               rdfs:range hpc:Power .
hpc:hasCPUFrequency rdfs:domain hpc:EnergyTimeSeries ;
               rdfs:range hpc:CPUFrequency .
hpc:hasEnergyIPMI rdfs:domain hpc:EnergyTimeSeries ;
               rdfs:range hpc:EnergyIPMIFrequency .
hpc:hasFilesystem rdfs:domain hpc:FilesystemTimeSeries ;
               rdfs:range hpc:Filesystem .
```
