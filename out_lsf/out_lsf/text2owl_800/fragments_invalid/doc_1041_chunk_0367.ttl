hpc:Project a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "List of project names on which limits are enforced." .

hpc:hasproject a owl:ObjectProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range hpc:Project ;
    rdfs:comment "The project that the limit policy applies to." .

# App
hpc:App a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "List of application names on which limits are enforced." .

hpc:hasapp a owl:ObjectProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range hpc:App ;
    rdfs:comment "The application that the limit policy applies to." .

# LimitPolicy
hpc:Limitpolicy a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A policy that enforces resource limits." .

# Resource
hpc:Resource a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A resource that has a limit." .

# Slots
hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of slots that are currently used and maximum number of slots that are configured for the limit policy." .

# Mem
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The amount of memory that is currently used and maximum that is configured for the limit policy." .

# Tmp
hpc:tmp a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The amount of tmp space that is currently used and maximum amount of tmp space that is configured for the limit policy." .

# Swp
hpc:swp a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The amount of swap space that is currently used and maximum amount of swap space that is configured for the limit policy." .

# Jobs
hpc:jobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of currently running and suspended jobs and the maximum number of jobs that are configured for the limit policy." .

# Ineligible
hpc:ineligible a owl:DatatypeProperty ;
    rdfs:domain hpc:Limitpolicy ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Displays the value that has been configured for the limit policy." .

# LimitSection
hpc:Limitsection a owl:Class ;
    rdfs:subClassOf
