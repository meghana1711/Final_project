hpc:Policy a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a policy in the LSF system." .

hpc:userdefinedscriptpath a owl:ObjectProperty ;
    rdfs:domain hpc:Policy ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to the custom policy script." .

hpc:Threshold a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a threshold in the LSF system." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a queue in the LSF system." .

hpc:rcDemandPolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Policy ;
    rdfs:comment "The demand policy for a queue." .

hpc:Condition a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a condition in the demand policy." .

hpc:numPendJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Condition ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of eligible pending jobs." .

hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Condition ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The duration in minutes." .

hpc:or a owl:ObjectProperty ;
    rdfs:domain hpc:Policy ;
    rdfs:range hpc:Policy ;
    rdfs:comment "Represents an OR relationship between conditions in a demand policy." .

hpc:and a owl:ObjectProperty ;
    rdfs:domain hdfs:Policy ;
    rdfs:range hpc:Policy ;
    rdfs:comment "Represents an AND relationship between policies." .
