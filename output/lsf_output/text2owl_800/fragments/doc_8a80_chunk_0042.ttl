hpc:Project a owl:Class .
hpc:Cluster a owl:Class .
hpc:Job a owl:Class .
hpc:demandlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:demand a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:pendingreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:potentialdemand a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .
