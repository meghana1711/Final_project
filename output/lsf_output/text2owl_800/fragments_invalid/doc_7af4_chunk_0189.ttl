hpc:Cluster a owl:Class .
hpc:lsfUnitForLimits a owl:DatatypeProperty .
hpc:Mem a owl:Class .
hpc:Swp a owl:Class .
hpc:Tmp a owl:Class .
hpc:Resource a owl:Class .
hpc:App a owl:Class .
hpc:Queue a owl:Class .
hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Project a owl:Class .
hpc:LicProject a owl:Class .
hpc:Consumertype a owl:Class .
hpc:Job a owl:Class .
hpc:Runningjob a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:totaljobs a owl:DatatypeProperty .
hpc:tempspace a owl:DatatypeProperty .
hpc:sharedresources a owl:ObjectProperty .
hpc:Resourcelimit a owl:Class .
hpc:resourcename a owl:DatatypeProperty .
hpc:consumers a owl:ObjectProperty .
hpc:Strictconfiguration a owl:Class .
hpc:horizontalformat a owl:DatatypeProperty .

hpc:Cluster rdfs:subClassOf owl:Class .
hpc:LsfUnitForLimits rdfs:domain hpc:Cluster ;
                             rdfs:range xsd:string .
hpc:Mem rdfs:subClassOf hpc:Resource .
hpc:Swp rdfs:subClassOf hpc:Resource .
hpc:Tmp rdfs:subClassOf hpc:Resource .
hpc:Resource rdfs:subClassOf owl:Class .
hpc:App rdfs:subClassOf hpc:Consumertype .
hpc:Queue rdfs:subClassOf hpc:Consumertype .
hpc:User rdfs:subClassOf hpc:Consumertype .
hpc:Usergroup rdfs:subClassOf hpc:Consumertype .
hpc:Project rdfs:subClassOf hpc:Consumertype .
hpc:LicProject rdfs:subClassOf hpc:Consumertype .
hpc:Job rdfs:subClassOf owl:Class .
hpc:Runningjob rdfs:subClassOf hpc:Job .
hpc:Suspendedjob rdfs:subClassOf hpc:Job .
hpc:Totaljobs rdfs:domain hpc:Cluster ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Tempspace rdfs:domain hpc:Cluster ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Sharedresources rdfs:domain hpc:Cluster ;
                      rdfs:range rdf:List .
hpc:Resourcelimit rdfs:subClassOf owl:Class .
hpc:Resourcename rdfs:domain hpc:Resourcelimit ;
                      rdfs:range xsd:string .
hpc:Consumers rdfs:domain hpc:Resourcelimit ;
                      rdfs:range rdf:List .
hpc:Strictconfiguration a owl:Class .
hpc:Horizontalformat rdfs:domain hpc:Strictconfiguration ;
