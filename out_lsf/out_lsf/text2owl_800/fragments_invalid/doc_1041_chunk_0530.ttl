hpc:Endtime a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timevalue .

hpc:Timevalue a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:Endtime ;
    rdfs:range xsd:string ;
    rdfs:comment "The time value for the end time." .

hpc:year a owl:DatatypeProperty ;
    rdfs:domain hpc:Timevalue ;
    rdfs:range xsd:integer ;
    rdfs:comment "Any year after 1900." .

hpc:month a owl:DatatypeProperty ;
    rdfs:domain hpc:Timevalue ;
    rdfs:range xsd:gYearMonth ;
    rdfs:comment "A month in the year." .

hpc:day a owl:DatatypeProperty ;
    rdfs:domain hpc:Timevalue ;
    rdfs:range xsd:day ;
    rdfs:comment "A day of the month." .

hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Timevalue ;
    rdfs:range xsd:gYearMonthDay ;
    rdfs:comment "An hour of the day." .

hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Timevalue ;
    rdfs:range xsd:gYearMonthDayTime ;
    rdfs:comment "A minute of the hour." .

hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timevalue ;
    rdfs:comment "Dynamically selects hosts based on the specified resource requirements." .

hpc:arAvailableStatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "If AR_AVAILABLE_STATUS in lsb.params is defined, then hosts with that status are preferred in the AR creation." .

hpc:Hostgroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "A group of hosts." .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of a host." .

hpc:Hostsreservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Timevalue ;
    rdfs:comment "Changes the list of hosts for which job slots or number of hosts are reserved." .

hpc:numberunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostsreservation ;
    rdfs:range xsd:string ;
    r
