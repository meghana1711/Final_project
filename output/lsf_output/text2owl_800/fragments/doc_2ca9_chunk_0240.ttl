hpc:Resourcereservationmethod a owl:Class .
hpc:TaskResourceReservation a hpc:ResourceReservationMethod .
hpc:JobResourceReservation a hpc:ResourceReservationMethod .
hpc:HostResourceReservation a hpc:ResourceReservationMethod .
hpc:Consumableresource a owl:Class .
hpc:stripe a owl:ObjectProperty .
hpc:Stripe rdfs:domain hpc:Resourcereservationmethod ;
                               rdfs:range hpc:Job .
hpc:Preferenceforexecutionhost a owl:Class .
hpc:Preferenceforexecutionhost rdfs:subClassOf hpc:Resourcereservationmethod .
hpc:DockerImagePreference a hpc:PreferenceForExecutionHost .
hpc:nocvd a owl:ObjectProperty .
hpc:Nocvd rdfs:domain hpc:Gpuresourcerequirement ;
                               rdfs:range xsd:string .
hpc:blockdistribution a owl:ObjectProperty .
hpc:Blockdistribution rdfs:domain hpc:Gpuresourcerequirement ;
                               rdfs:range xsd:boolean .
hpc:packscheduling a owl:ObjectProperty .
hpc:Packscheduling rdfs:domain hpc:Gpuresourcerequirement ;
                               rdfs:range xsd:boolean .
hpc:Pamsession a owl:Class .
hpc:PAMSession a hpc:USE_PAM_CREDS .
hpc:session a owl:ObjectProperty .
hpc:Session rdfs:domain hpc:Pamsession ;
                               rdfs:range xsd:string .
hpc:limits a owl:ObjectProperty .
hpc:Limits rdfs:domain hpc:Pamsession ;
                               rdfs:range xsd:string .
hpc:Container a owl:Class .
hpc:lsfversion a owl:DatatypeProperty .
hpc:Lsfversion rdfs:range xsd:string .
