hpc:Configurationtemplate a owl:Class .
hpc:egodaemoncontrol a owl:ObjectProperty .
hpc:enablecgroup a owl:ObjectProperty .
hpc:enabledynamichosts a owl:ObjectProperty .
hpc:enableego a owl:ObjectProperty .
hpc:enablestream a owl:ObjectProperty .
hpc:lsfaddservers a owl:ObjectProperty .
hpc:lsfaddclients a owl:ObjectProperty .
hpc:lsfadmins a owl:ObjectProperty .
hpc:lsfclustername a owl:ObjectProperty .
hpc:lsfdynamichostwaittime a owl:DatatypeProperty .
hpc:lsfentitlementfile a owl:ObjectProperty .
hpc:lsfmasterlist a owl:ObjectProperty .
hpc:lsfquietinst a owl:ObjectProperty .
hpc:lsfsilentinstalltarlist a owl:ObjectProperty .
hpc:lsftardir a owl:ObjectProperty .
hpc:lsftop a owl:ObjectProperty .
hpc:patchbackupdir a owl:ObjectProperty .
hpc:patchhistorydir a owl:ObjectProperty .
hpc:silentinstall a owl:ObjectProperty .

hpc:Configurationtemplate rdfs:subClassOf owl:Class .
hpc:Egodaemoncontrol rdfs:domain hpc:Configurationtemplate ;
                          rdfs:range xsd:string .
hpc:Enablecgroup rdfs:domain hpc:Configurationtemplate ;
                  rdfs:range xsd:boolean .
hpc:Enabledynamichosts rdfs:domain hpc:Configurationtemplate ;
                      rdfs:range xsd:boolean .
hpc:Enableego rdfs:domain hpc:Configurationtemplate ;
                  rdfs:range xsd:boolean .
hpc:Enablestream rdfs:domain hpc:Configurationtemplate ;
                  rdfs:range xsd:boolean .
hpc:Lsfaddservers rdfs:domain hpc:Configurationtemplate ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:Lsfaddclients rdfs:domain hpc:Configurationtemplate ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Lsfadmins rdfs:domain hpc:Configurationtemplate ;
                 rdfs:range xsd:string .
hpc:Lsfclustername rdfs:domain hpc:Configurationtemplate ;
                   rdfs:range xsd:string .
hpc:Lsfdynamichostwaittime rdfs:domain hpc:Configurationtemplate ;
                         rdfs:range xsd:nonNegativeInteger .
hpc:Lsfentitlementfile rdfs:domain hpc:Configurationtemplate ;
                       rdfs:range xsd:string .
hpc:Lsfmasterlist rdfs:domain hpc:Configurationtemplate ;
                   rdfs:range xsd:string .
hpc:Lsfquietinst rdfs:domain hpc:Configurationtemplate ;
                   rdfs:range xsd:boolean .
hpc:Lsfsilentinstalltarlist rdfs:domain hpc:Configurationtemplate ;
                               rdfs:range xsd:string .
hpc:LsfTardir rd
