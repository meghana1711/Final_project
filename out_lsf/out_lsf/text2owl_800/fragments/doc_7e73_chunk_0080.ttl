hpc:LsfCluster a owl:Class .
hpc:LsfResourceprovider a owl:Class .
hpc:Azureinstance a owl:Class .
hpc:lsfHostAddrRange a owl:DatatypeProperty .
hpc:lsfDynamicHostWaitTime a owl:DatatypeProperty .
hpc:ebrokerd a owl:ObjectProperty .
hpc:hostprovidersJson a owl:DatatypeProperty .
hpc:azureprovConfig a owl:DatatypeProperty .
hpc:azureprovTemplates a owl:DatatypeProperty .
hpc:bsub a owl:ObjectProperty .
hpc:bhosts a owl:ObjectProperty .
hpc:OkInstanceStatus a owl:Class .
hpc:DynamicHost a owl:Class .
hpc:azurehost a owl:ObjectProperty .
hpc:select a owl:ObjectProperty .

hpc:LsfCluster rdfs:subClassOf owl:Class .
hpc:LsfResourceprovider rdfs:subClassOf owl:Class .
hpc:Azureinstance rdfs:subClassOf hpc:LsfResourceprovider .
hpc:LsfHostAddrRange rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:string .
hpc:LsfDynamicHostWaitTime rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ebrokerd rdfs:domain hpc:LsfCluster ;
    rdfs:range rdf:Resource .
hpc:HostprovidersJson rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:string .
hpc:AzureprovConfig rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:string .
hpc:AzureprovTemplates rdfs:domain hpc:LsfCluster ;
    rdfs:range xsd:string .
hpc:Bsub rdfs:domain hpc:LsfCluster ;
    rdfs:range rdf:Resource .
hpc:Bhosts rdfs:domain hpc:LsfCluster ;
    rdfs:range rdf:Resource .
hpc:OkInstanceStatus rdfs:subClassOf owl:Class .
hpc:DynamicHost rdfs:subClassOf owl:Class .
hpc:Azurehost rdfs:domain hpc:Azureinstance ;
    rdfs:range xsd:boolean .
hpc:Select rdfs:domain hpc:Bsub ;
    rdfs:range rdf:Resource .
