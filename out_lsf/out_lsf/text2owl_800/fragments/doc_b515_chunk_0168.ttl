hpc:Userdynamicpriority a owl:Class .
hpc:Queue a owl:Class .
hpc:Partition a owl:Class .
hpc:Host a owl:Class .
hpc:Queuebasedfairshare a owl:Class .
hpc:numbershares a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeFloat .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeFloat .
hpc:jobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeInteger .
hpc:fairshareadjustment a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeFloat .
hpc:cputimefactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:runtimefactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:runjobfactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:fwdjobfactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:fairshareadjustmentfactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:gpuphysical a owl:DatatypeProperty ;
    rdfs:domain hpc:Userdynamicpriority ;
    rdfs:range xsd:nonNegativeInteger .
hpc:gpuruntimefactor a owl:DatatypeProperty ;
    rdfs:domain rdf:nil ;
    rdfs:range xsd:nonNegativeFloat .
hpc:QueueUsesHostsInSamePartition rdf:subClassOf hpc:Queue .
hpc:QueueBasedFairShare rdf:subClassOf hpc:Queue .
