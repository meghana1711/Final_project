hpc:Resource a owl:Class .
hpc:Host a hpc:Resource .
hpc:CPUSlot a hpc:Resource .
hpc:License a hpc:Resource .

hpc:Lsfcluster a owl:Class .
hpc:manages rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Resource .
hpc:acceptsAndSchedulesWorkload rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:monitorsEvents rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:isAccessibleBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:User .
hpc:hasCommandLineInterface rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:hasAPI rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .
hpc:hasIBMSpectrumLSFApplicationCenter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster .

hpc:Ibmspectrumlsf a owl:Class .
hpc:hasDaemonsAndFunctionsToScheduleAndRunJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsf .

hpc:Ibmspectrumlicensescheduler a owl:Class .
hpc:controlsTheWaySoftwareLicensesAreShared rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlicensescheduler .
hpc:worksWithFlexNet rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlicensescheduler .

hpc:Lsfclustercommunicationpath a owl:Class .

hpc:Lsfdaemonprocess a owl:Class .
hpc:runsOnEachHostInTheCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdaemonprocess .
hpc:isManagementHostOrComputeHost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdaemonprocess ;
    rdfs:range xsd:boolean .

hpc:Lsfclustercommunicationpath a owl:Class .

hpc:Faulttoleranceandautomaticmanagementhostfailover a owl:Class .

hpc:Lsfsecurity a owl:Class .
hpc:authentication rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsecurity .
hpc:userRoles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsecurity .
