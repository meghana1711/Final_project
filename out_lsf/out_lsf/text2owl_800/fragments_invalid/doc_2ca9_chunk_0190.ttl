hpc:Installerpackage a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:Thing ] .

hpc:StandardInstallerPackage a InstallerPackage ;
    rdfs:comment "Use this package in a heterogeneous cluster with a mix of systems other than x86-64." ;
    rdfs:seeAlso <http://example.org/lsf10.1_lsfinstall_linux_x86_64.tar.Z> ;
    rdfs:label "Standard Installer Package" ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf InstallerPackage ] ;
    rdfs:domain x86_64Cluster ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf owl:Thing ] ;
    rdfs:domain HeterogeneousCluster ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf InstallerPackage ] ;
    rdfs:comment "Requires approximately 1 GB free space." .

hpc:HomogeneousInstallerPackage a InstallerPackage ;
    rdfs:comment "Use this smaller installer package in a homogeneous x86-64 cluster." ;
    rdfs:seeAlso <http://example.org/lsf10.1_no_jre_lsfinstall.tar.Z> ;
    rdfs:label "Homogeneous Installer Package" ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf InstallerPackage ] ;
    rdfs:domain x86_64Cluster ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf owl:Thing ] ;
    rdfs:domain HomogeneousCluster ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf InstallerPackage ] ;
    rdfs:comment "If you add other non-x86-64 hosts, you must use the standard installer package." ;
    rdfs:comment "Requires approximately 100 MB free space." .

hpc:PlatformInstallerPackage a InstallerPackage ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf InstallerPackage ] ;
    rdfs:domain Platform ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf owl:Thing ] .

hpc:NonJREInstallerPackage a PlatformInstallerPackage ;
    rdfs:seeAlso <http://example.org/lsf10.1_lsfinstall_linux_ppc64le.tar.Z> ;
    rdfs:label "Non-JRE Installer Package" ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf PlatformInstallerPackage ] ;
    rdfs:domain Linux ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf InstallerPackage ] ;
