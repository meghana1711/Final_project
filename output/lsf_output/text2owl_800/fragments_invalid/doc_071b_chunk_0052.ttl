hpc:Dualstackhost a owl:Class .
hpc:hasOfficialName an owl:ObjectProperty .
hpc:Hasofficialname rdfs:domain hpc:Dualstackhost ;
                     rdfs:range xsd:string .
hpc:hasIPv4Address an owl:DatatypeProperty .
hpc:Hasipv4address rdfs:domain hpc:Dualstackhost ;
                    rdfs:range xsd:string .
hpc:hasIPv6Address an owl:DatatypeProperty .
hpc:Hasipv6address rdfs:domain hpc:Dualstackhost ;
                    rdfs:range xsd:string .
hpc:InterfaceAlias an owl:Class .
hpc:Interfacealias rdfs:subClassOf hpc:Dualstackhost .
hpc:hasInterfaceAlias an owl:ObjectProperty .
hpc:Hasinterfacealias rdfs:domain hpc:Dualstackhost ;
                       rdfs:range xsd:string .
