hpc:Provider a owl:Class.
hpc:hasprovider a owl:ObjectProperty.
hpc:Hasprovider rdfs:domain hpc:Provider.
hpc:Hasprovider rdfs:range xsd:string.

hpc:Time a owl:Class.
hpc:hastime a owl:DatatypeProperty.
hpc:Hastime rdfs:domain hpc:Time.
hpc:Hastime rdfs:range xsd:dateTime.

hpc:Event a owl:Class.
hpc:haseventtype a owl:ObjectProperty.
hpc:Haseventtype rdfs:domain hpc:Event.
hpc:Haseventtype rdfs:range xsd:string.

hpc:Lsfevent a owl:Class.
hpc:islsfevent a owl:ObjectProperty.
hpc:Islsfevent rdfs:domain hpc:Event.
hpc:Islsfevent rdfs:range xsd:boolean.

hpc:Jobfinish2event a owl:Class.
hpc:isjobfinish2event a owl:ObjectProperty.
hpc:Isjobfinish2event rdfs:subClassOf hpc:Lsf
