hpc:Gpurequirement a owl:Class .
hpc:GPUMode an owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .
hpc:Gpurequirementsmerged a owl:Class ;
    rdfs:subClassOf hpc:Gpurequirement .
hpc:gpurequirementstring a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirementsmerged ;
    rdfs:range xsd:string .
hpc:gpupoweroffduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:integer .
hpc:gpumodechange a owl:ObjectProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range hpc:Job .
hpc:Job a owl:Class .
