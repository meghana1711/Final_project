hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:MCS_Label a owl:Class .

hpc:hasMCS_Label a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:MCS_Label .

hpc:hasAllocatedMCS_Label a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:MCS_Label ;
    rdfs:subPropertyOf hpc:hasMCS_Label .

hpc:displayMCS_LabelOnJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf rdf:type .

hpc:displayMCS_LabelOnNode a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf rdf:type .

hpc:updateMCS_LabelOnJob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf rdf:type .
    rdfs:domain hpc:Job rdf:value PENDING .

hpc:requestedMCS_LabelByUser a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:enforcedMCS_Label a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:MCS_Label .

hpc:MCS_LabelFilter a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
    rdfs:subPropertyOf rdf:type .

hpc:MCSParameters a owl:Class .
hpc:configuresLabelEnforcement a owl:ObjectProperty ;
    rdfs:domain hpc:MCSParameters ;
    rdfs:range xsd:boolean .

hpc:configuresNodeSelectionFilteringPolicy a owl:ObjectProperty ;
    rdfs:domain hpc:MCSParameters ;
    rdfs:range xsd:string .

hpc:configuresPrivateDataBasedOnLabels a owl:ObjectProperty ;
    rdfs:domain hpc:MCSParameters ;
    rdfs:range xsd:boolean .

hpc:configuresUserGroupsAllowedToMapToMCSLabels a owl:ObjectProperty ;
    rdfs:domain hpc:MCSParameters ;
    rdfs:range rdf:Resource .
```
