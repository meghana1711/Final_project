hpc:Linux64bit a owl:Class .
hpc:Linuxx8664 a owl:Class .
hpc:Linuxppc64le a owl:Class .

hpc:installedversion a owl:DatatypeProperty ;
  rdfs:domain hpc:Linux64bit ;
  rdfs:domain hpc:Linuxx8664 ;
  rdfs:domain hpc:Linuxppc64le ;
  rdfs:range xsd:string .

hpc:Product a owl:Class .
hpc:Productgroup a owl:Class .
hpc:productselector a owl:ObjectProperty ;
  rdfs:domain hpc:Product .
  rdfs:range hpc:Productselectorvalue .

hpc:Productselectorvalue a owl:Class .
hpc:producthistory a owl:ObjectProperty ;
  rdfs:domain hpc:Product .
  rdfs:range hpc:Product .

hpc:myproducthistory a owl:ObjectProperty ;
  rdfs:domain hpc:Product .
  rdfs:range hpc:Product .

hpc:productlist a owl:ObjectProperty ;
  rdfs:domain hpc:Product .
  rdfs:range hpc:Product .
