hpc:Task a owl:Class .
hpc:Job a owl:Class .

hpc:donetask a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Task .
hpc:totaldonetasks a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:integer .

hpc:totalcputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:averagecputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:maxcputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:mincputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:totalwaittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:averagewaittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:maxwaittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:minwaittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .

hpc:averageturnaroundtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:maxturnaroundtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:minturnaroundtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:averagehogfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Session ;
    rdfs:range xsd:decimal .
hpc:maxhogfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .
hpc:minhogfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:decimal .

hpc:Session a owl:Class .
hpc:Session a rdfs:subClassOf owl:Class .
