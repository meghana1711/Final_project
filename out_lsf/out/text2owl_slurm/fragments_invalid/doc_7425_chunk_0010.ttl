hpc:Flag a owl:Enum.
hpc:NotSet a hpc:Flag; rdfs:label "NOT_SET" .
hpc:Add a hpc:Flag; rdfs:label "ADD" .
hpc:Remove a hpc:Flag; rdfs:label "REMOVE" .
hpc:Deleted a hpc:Flag; rdfs:label "DELETED" .
hpc:PartitionMinimumNode a hpc:Flag; rdfs:label "PARTITION_MINIMUM_NODE" .
hpc:PartitionMaximumNode a hpc:Flag; rdfs:label "PARTITION_MAXIMUM_NODE" .

hpc:preemptmode a owl:ObjectProperty;
    rdfs:domain hpc:Qos;
    rdfs:range hpc:Preemptmode .

hpc:preemptmode a owl:DatatypeProperty;
    rdfs:domain hpc:Qos;
    rdfs:range xsd:string;
    rdfs:subPropertyOf hpc:PreemptMode .

hpc:Preemptmodepreemptmodes a owl:Class .
hpc:NotSet rdf:type
