hpc:Esubjobcluster a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Name of submission cluster (for a cluster with LSF multicluster capability only)." .

hpc:lsbSubCluster a owl:ObjectProperty ;
    rdfs:domain hpc:Esubjobcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "Set by LSF on the submission host before running esub." .

hpc:Submissionenvironment a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Environment where the parameter is passed to the execution cluster environment." .

hpc:Executionclusterenvironment a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Environment where the parameter is valid." .

hpc:lsbSubCommandname a owl:ObjectProperty ;
    rdfs:domain hpc:Esubjobcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "The job command line. If set, enables esub to use the variable LSB_SUB_COMMAND_LINE in the esub job parameter file specified by the $LSB_SUB_PARM_FILE environment variable." .

hpc:esubjobcommandline a owl:DatatypeProperty ;
    rdfs:domain hpc:Esubjobcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "The job command line. The job command line can be up to 4094 characters long for UNIX and Linux or up to 255 characters for Windows." .
