hpc:hostA a hpc:Host ;
    hpc:Status "ok" ;
    hpc:JL 0.0 ;
    hpc:U 0.0 ;
    hpc:MAX 0.0 ;
    hpc:NJOBS 4 ;
    hpc:RUN 0.4 ;
    hpc:SSUSP 0 ;
    hpc:USUSP 4316 ;
    hpc:RSV "10G" ;
    hpc:Belongsto hpc:groupa .

