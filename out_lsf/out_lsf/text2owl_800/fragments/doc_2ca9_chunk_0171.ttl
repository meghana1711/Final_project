hpc:Resourceconnectorforlsf a owl:Class .
hpc:ResourceProvider rdf:type owl:Class .
hpc:EnterpriseGrid rdf:type hpc:ResourceProvider .
hpc:OpenStack rdf:type hpc:ResourceProvider .
hpc:HostFactory rdf:type owl:ObjectProperty .
hpc:Hostfactory rdfs:domain hpc:Resourceconnectorforlsf ;
                     rdfs:range hpc:Resourceprovider .
hpc:BorrowedHost rdf:type owl:Class .
hpc:BsubCommand rdf:type owl:ObjectProperty .
hpc:Bsubcommand rdfs:domain hpc:Resourceconnectorforlsf ;
                     rdfs:range xsd:string .
hpc:BhostsCommand rdf:type owl:ObjectProperty .
hpc:Bhostscommand rdfs:domain hpc:Resourceconnectorforlsf ;
                     rdfs:range xsd:string .
hpc:Lsfwithapachehadoop a owl:Class .
hpc:ConnectorScript rdf:type owl:ObjectProperty .
hpc:Connectorscript rdfs:domain hpc:Lsfwithapachehadoop ;
                     rdfs:range xsd:string .
hpc:Hadoop rdf:type owl:Class .
hpc:HadoopDistributedFileSystem rdf:type owl:ObjectProperty .
hpc:Hadoopdistributedfilesystem rdfs:domain hpc:Hadoop ;
                             rdfs:range xsd:string .
hpc:MapReduce rdf:type owl:Class .
hpc:StandAloneEnvironment rdf:type owl:ObjectProperty .
hpc:Standaloneenvironment rdfs:domain hpc:Mapreduce .
hpc:HPCCluster rdf:type owl:Class .
hpc:ParallelFileSystem rdf:type owl:ObjectProperty .
hpc:Parallelfilesystem rdfs:domain hpc:Hpccluster ;
                        rdfs:range xsd:string .
hpc:LSFHadoopJob rdf:type owl:Class .
hpc:ProvisionAndMonitorCommand rdf:type owl:ObjectProperty .
hpc:Provisionandmonitorcommand rdfs:domain hpc:Lsfhadoopjob ;
                               rdfs:range xsd:string .
hpc:MultiTenancy rdf:type owl:Class .
hpc:CommonPoolOfHPCClusterResources rdf:type owl:ObjectProperty .
hpc:Commonpoolofhpcclusterresources rdfs:domain hpc:Multitenancy ;
                                 rdfs:range hpc:Hpccluster .
hpc:ResourceUsage rdf:type owl:Class .
hpc:MapReduceWorkload rdf:type owl:Class .
hpc:JobLifecycle rdf:type owl:ObjectProperty .
hpc:Joblifecycle rdfs:domain hpc:Resourceusage ;
                    rdfs:range xsd:string .
hpc:LSFShutsDownHadoopCluster rdf:type owl:ObjectProperty .
hpc:Lsfshutsdownhadoopcluster rdfs:domain hpc:Resourceusage .
