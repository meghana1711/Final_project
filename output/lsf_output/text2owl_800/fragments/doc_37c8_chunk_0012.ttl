hpc:Nvidiadockerjob a owl:Class .
hpc:DockerImageAffinity rdfs:domain hpc:Nvidiadockerjob ;
                             rdfs:range xsd:string .
hpc:container a owl:ObjectProperty ;
                rdfs:domain hpc:Nvidiadockerjob ;
                rdfs:range hpc:Containerspec .
hpc:Containerspec a owl:Class ;
                   rdfs:subClassOf hpc:Namedcontainerspec .
hpc:Namedcontainerspec a owl:Class .
hpc:Image rdfs:domain hpc:Containerspec ;
             rdfs:range xsd:string .
hpc:Options rdfs:domain hpc:Containerspec ;
             rdfs:range xsd:string .
hpc:Ubuntu a owl:Class .
hpc:rm a owl:DatatypeProperty ;
         rdfs:domain hpc:Containerspec .
hpc:Nvidiadocker a owl:Class .
