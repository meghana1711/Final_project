hpc:Slurmdaemon a owl:Class .
hpc:Initdaemon a owl:Class .
hpc:Operatingsystem a owl:Class .
hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:Cluster a owl:Class .
hpc:resourcelimit a owl:ObjectProperty .
hpc:hardresourcelimit a owl:DatatypeProperty .
hpc:softresourcelimit a owl:DatatypeProperty .
hpc:submithost a owl:ObjectProperty .
hpc:allocatednode a owl:ObjectProperty .
hpc:slurmconf a owl:ObjectProperty .
hpc:ulimitcommand a owl:ObjectProperty .
hpc:pam a owl:ObjectProperty .
hpc:uniformhardresourcelimit a owl:ObjectProperty .
hpc:propagateresourcelimits a owl:ObjectProperty .
hpc:propagateresourcelimitsexcept a owl:ObjectProperty .
hpc:errormessage a owl:DatatypeProperty .

hpc:Slurmdaemon rdfs:subClassOf hpc:Initdaemon .
hpc:Operatingsystem rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf hpc:Operatingsystem .
hpc:Job rdfs:subClassOf hpc:User .
hpc:Node rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .

hpc:Resourcelimit rdfs:domain hpc:Slurmdaemon ;
                    rdfs:range xsd:string .
hpc:Hardresourcelimit rdfs:domain hpc:Slurmdaemon ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:Softresourcelimit rdfs:domain hpc:User ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:Submithost rdfs:domain hpc:User ;
                    rdfs:range hpc:Node .
hpc:Allocatednode rdfs:domain hpc:Job ;
                    rdfs:range hpc:Node .
hpc:Slurmconf rdfs:domain hpc:Cluster ;
                    rdfs:range hpc:Slurmdaemon .
hpc:Ulimitcommand rdfs:domain hpc:Slurmconf ;
                    rdfs:range xsd:string .
hpc:Pam rdfs:domain hpc:Slurmconf ;
                    rdfs:range xsd:boolean .
hpc:Uniformhardresourcelimit rdfs:domain hpc:Cluster ;
                    rdfs:range hpc:Node .
hpc:Propagateresourcelimits rdfs:domain hpc:Cluster ;
                    rdfs:range hpc:Resourcelimit .
hpc:Propagateresourcelimitsexcept rdfs:domain hpc:Cluster ;
                    rdfs:range xsd:string .
hpc:Errormessage rdfs:domain hpc:Slurmdaemon ;
                    rdfs:range xsd:string .
