hpc:Nonsharedclass a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:ownership ;
                        owl:hasValue ?LIMITS ;
                        owl:minCardinality 1 ] .

hpc:Ownershipclass a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:ownership ;
                        owl:hasValue ?NON_SHARED ;
                        owl:maxCardinality 1 ] .

hpc:Ownershipclass2 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:ownership ;
                        owl:hasValue ?LIMITS ] .

hpc:ownershipproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Hierarchicalgroupmemberproject ;
    rdfs:range xsd:positiveInteger .

hpc:priorityproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Hierarchicalgroupmemberproject ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Nonshared rdfs:domain hpc:Nonsharedclass ;
    rdfs:range xsd:positiveInteger .

hpc:Ownership rdfs:domain hpc:Ownershipclass ;
    rdfs:range xsd:positiveInteger .

hpc:Ownership rdfs:domain hpc:Ownershipclass2 ;
    rdfs:range xsd:positiveInteger .


Assuming the following classes and properties are already defined:

hpc:Hierarchicalgroupmemberproject a owl:Class .
hpc:Hierarchicalgroup a owl:Class .
