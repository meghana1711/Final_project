hpc:Host a owl:Class .
hpc:server a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:model a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:rexpri a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .

hpc:Host_a a hpc:Host ;
    hpc:model "SUNSOL" ;
    hpc:server 1 ;
    hpc:mem "1.0" ;
    hpc:REXPRI "" .
hpc:Host_b a hpc:Host ;
    hpc:model "LINUX" ;
    hpc:server 0 ;
    hpc:mem "1.0" ;
    hpc:REXPRI "" .
hpc:Host_c a hpc:Host ;
    hpc:model "HPPA" ;
    hpc:server 1 ;
    hpc:mem "1.0" ;
    hpc:REXPRI "" .
