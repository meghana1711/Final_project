hpc:Cluster a owl:Class .

# Data Manager
hpc:Datamanager a owl:Class .

# StagingArea
hpc:Stagingarea a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

# DataFile
hpc:Datafile a owl:Class .

# DataAvailability
hpc:dataavailability a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Datafile .

# DataStage
hpc:datastage a owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea ;
    rdfs:range hpc:Datafile .

# DataTransfer
hpc:datatransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hibm:Cluster .

# ClusterAffinity
hpc:clusteraffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Cluster .

# MulticlusterCapabilityEnvironment
hpc:Multiclustercapabilityenvironment a owl:Class .

# IBM_Spectrum_LSF
hpc:IbmSpectrumLsf a owl:Class ;
    rdfs:subClassOf hpc:Multiclustercapabilityenvironment .

# JobForwarding
hpc:jobforwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Cluster .
