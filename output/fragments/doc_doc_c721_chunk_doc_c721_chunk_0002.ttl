hpc:Usage a owl:Class .
hpc:HistoricalUsage a hpc:Usage .
hpc:CurrentPeriod a xsd:nonNegativeReal .
hpc:LastPeriod a xsd:nonNegativeReal .
hpc:Period2 a xsd:nonNegativeReal .
hpc:DecayFactor a xsd:decimal .
hpc:DecayFactor rdfs:domain hpc:HistoricalUsage ;
                  rdfs:range xsd:decimal .

hpc:TotalHistoricalUsage a owl:Class .
hpc:CurrentTotalPeriod a xsd:nonNegativeReal .
hpc:LastTotalPeriod a xsd:nonNegativeReal .
hpc:Period2Total a xsd:nonNegativeReal .
hpc:DecayFactor a xsd:decimal .
hpc:TotalHistoricalUsage rdfs:subClassOf hpc:Usage .

hpc:NormalizedUsage a owl:Class .
hpc:NormalizedHistoricalUsage a hpc:NormalizedUsage .
hpc:NormalizedTotalHistoricalUsage a hpc:NormalizedUsage .
hpc:HistoricalUsage rdfs:domain hpc:NormalizedHistoricalUsage ;
                      rdfs:range hpc:TotalHistoricalUsage .
hpc:HistoricalUsage rdfs:subProperty hpc:hasHistoricalUsage .
hpc:TotalHistoricalUsage rdfs:domain hpc:NormalizedTotalHistoricalUsage ;
                          rdfs:range hpc:TotalHistoricalUsage .

hpc:FairShareFactor a owl:Class .
hpc:FairShareFactor rdfs:subClassOf owl:Real .
hpc:FairShareFactor rdfs:domain hpc:FairShareFactor .
hpc:Shares a xsd:nonNegativeReal .
hpc:Usage a rdfs:domain hpc:FairShareFactor ;
             rdfs:range hpc:NormalizedUsage .
hpc:FairShareDampeningFactor a xsd:nonNegativeReal .
hpc:FairShareDampeningFactor rdfs:default (1) .
```
