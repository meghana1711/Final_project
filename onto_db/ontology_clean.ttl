@prefix ex:   <http://example.org/hpc#> .

<http://example.org/hpc/ontology/clean> a owl:Ontology ;
  rdfs:label "HPC Scheduler Ontology (Clean Taxonomy)" ;
  ex:generatedAt "2026-01-25T12:32:19Z"^^xsd:dateTime .

