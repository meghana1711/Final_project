hpc:Lsfparameter a owl:Class .
hpc:licenseschedulerdaemonstart a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter ;
    rdfs:range hpc:Lsfhost .

hpc:Candidatelicenseschedulerhost a owl:Class .

hpc:Clusterinstallationwarning a owl:Class .
hpc:uniformdirectorypath a owl:DatatypeProperty ;
    rdfs:domain hpc:Clusterinstallationwarning .

hpc:preemptedjobrequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter .

hpc:preemptedjobkillandrequeue a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter .

hpc:preemptedjobmemoryresourcerelease a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter .

hpc:preemptedjobmemorypreemption a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptedjobmemoryresourcerelease ;
    rdfs:range xsd:boolean .

hpc:preemptedjobstrictprojectnamecheck a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfparameter .

hpc:Misspelledprojectjobrejection a owl:Class .
hpc:casesensitivity a owl:DatatypeProperty ;
    rdfs:domain hpc:Misspelledprojectjobrejection .
