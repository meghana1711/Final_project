hpc:Deprecatedparameter a owl:Class .
hpc:JobSize a DeprecatedParameter .
hpc:Hosts a DeprecatedParameter .
hpc:Allremote a rdfs:Class ;
  rdfs:subClassOf hpc:Hosts ;
  rdfs:comment "allremote keyword only" .
hpc:AllClusterName a rdfs:Class ;
  rdfs:subClassOf hpc:Hosts ;
  rdfs:comment "all@cluster_name keywords only" .
hpc:MaxProtocolInstances a DeprecatedParameter .
hpc:MaxSlotsInPool a DeprecatedParameter .
hpc:NetworkReq a DeprecatedParameter .
hpc:SlotPool a DeprecatedParameter .
hpc:SlotShare a DeprecatedParameter .
hpc:StripingWithMinimumNetwork a DeprecatedParameter .
hpc:UsePriorityInPool a DeprecatedParameter .

hpc:Newparameter a owl:Class .
hpc:ImptJoblimit a NewParameter .
hpc:ImptTasklimit a NewParameter .

hpc:SupportedPodmanVersion a xsd:string ;
  rdfs:range xsd:string .

hpc:Containerconfiguration a owl:Class .
hpc:PodmanConfiguration a ContainerConfiguration ;
  rdfs:comment "podman configuration" .
hpc:UserConfiguration a rdfs:Class ;
  rdfs:subClassOf hpc:Podmanconfiguration ;
  rdfs:comment "for the Podman jobs to start" .
hpc:ControllerConfiguration a rdfs:Class ;
  rdfs:subClassOf hpc:Podmanconfiguration ;
  rdfs:comment "for Podman to work" .
hpc:Apptainercontainerjob a owl:Class ;
  rdfs:subClassOf hpc:Containerconfiguration .

hpc:Lsbreasons a owl:Class .
hpc:CustomizedMessage a rdfs:Class ;
  rdfs:subClassOf hpc:Lsbreasons ;
  rdfs:comment "customized for one or more pending reasons" .
hpc:ResourcePriority a rdfs:Class ;
  rdfs:subClassOf hpc:Lsbreasons ;
  rdfs:comment "priority that is given to particular resources" .
