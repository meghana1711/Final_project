@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>
@prefix hpc: <http://example.org/hpc#>

hpc:Jobexample15 a owl:Class.
hpc:hasnumberofcpus a owl:DatatypeProperty;
    rdfs:domain hpc:Jobexample15;
    rdfs:range xsd:integer.
hpc:hasnumberoftasks a owl:DatatypeProperty;
    rdfs:domain hpc:Jobexample15;
    rdfs:range xsd:integer.
hpc:hassocketid a owl:DatatypeProperty;
    rdfs:domain hpc:Jobexample15;
    rdfs:range xsd:integer.
hpc:hastaskid a owl:DatatypeProperty;
    rdfs
