@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:lmStatTimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensemanagersettings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Sets the timeout value passed to the lmutil lmstat, lmstat, rlmutil rlmstat, or rlmstat command." .

hpc:lmType a owl:ObjectProperty ;
    rdfs:domain hpc:Licensemanagersettings ;
    rdfs:range rdf:List ;
    rdfs:comment "Deﬁnes the license manager system that is used by the license servers." .

hpc:LM_TYPE_FLEXLM a rdf:PlainLiteral ;
    rdfs:datatype xsd:string ;
    rdfs:comment "Used when the license servers are using FlexNet Manager as the license manager system." .

hpc:LM_TYPE_RLM a rdf:PlainLiteral ;
    rdfs:datatype xsd:string ;
    rdfs:comment "Used when the license servers are using Reprise License Manager as the license manager system." .

hpc:lmremoveSuspJobsObsolete a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensemanagersettings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Use LM_REMOVE_SUSP_JOBS instead. This parameter is only maintained for backwards compatibility." .

hpc:lmremoveSuspJobsIntervalObsolete a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensemanagersettings ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Replace LMREMOVE_SUSP_JOBS_INTERVAL with LM_REMOVE_SUSP_JOBS_INTERVAL instead. LMREMOVE_SUSP_JOBS_INTERVAL is only maintained for backwards compatibility." .

hpc:lmstatPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensemanagersettings ;
    rdfs:range xsd:string ;
    rdfs:comment "Deﬁnes the full path to the location of the FlexNet command lmutil (or lmstat)." .

hpc:Licensemanagersettings a owl:Class .
