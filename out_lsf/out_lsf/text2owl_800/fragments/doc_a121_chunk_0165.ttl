hpc:Cgroup a owl:Class .
hpc:freezer a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroup ;
    rdfs:range hpc:Freezer .
hpc:cpuset a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroup ;
    rdfs:range hpc:Cpuset .
hpc:cpuacct a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroup ;
    rdfs:range hpc:Cpuacct .
hpc:memory a owl:ObjectProperty ;
    rdfs:domain hpc:Cgroup ;
    rdfs:range hpc:Memory .
hpc:Mountpoint a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:fstab a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range hpc:Mountpoint .
hpc:cgconfig a owl:ObjectProperty ;
    rdfs:domain hpc:Systemconfiguration ;
    rdfs:range hpc:Mountpoint .
hpc:cgconfigconf a owl:ObjectProperty ;
    rdfs:domain hpc:Cgconfig ;
    rdfs:range hpc:Mountconfiguration .
hpc:Mountconfiguration a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:mount a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Mountpoint .
hpc:dismount a owl:ObjectProperty ;
    rdfs:domain hpc:System ;
    rdfs:range hpc:Mountpoint .
hpc:Jobsubmissionuser a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:jobexecutionuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission .
hpc:usesusermapping a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionuser ;
    rdfs:range hpc:Jobexecutionuser .
