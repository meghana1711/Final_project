hpc:Lsfcluster a owl:Class .
hpc:Oncloudlsfcluster a owl:Class .
hpc:Locallsfcluster a owl:Class .
hpc:ManagementHost owl:ObjectProperty .
hpc:ConnectedTo owl:ObjectProperty .
hpc:ResourceConnector owl:ObjectProperty .
hpc:GrowsShrinks owl:ObjectProperty .
hpc:DataManager owl:ObjectProperty .
hpc:DataAvailability owl:ObjectProperty .
hpc:BsubFCommand owl:ObjectProperty .
hpc:SSHAccess owl:ObjectProperty .
hpc:IONode owl:Class .
hpc:TransferQueue owl:Class .
hpc:FileServer owl:Class .
hpc:StagingArea owl:Class .
hpc:Ibmdatamanager a owl:Class .
hpc:Directdatastaging a owl:Class .
hpc:Bsubstagecommand a owl:Class .
hpc:StorageRequirement owl:DatatypeProperty .
hpc:StageInScript owl:DatatypeProperty .
hpc:StageOutScript owl:DatatypeProperty .
hpc:Stageinhost rdfs:domain hpc:Bsubstagecommand ;
    rdfs:range hpc:Fileserver .
hpc:Stageouthost rdfs:domain hpc:Bsubstagecommand ;
    rdfs:range hpc:Fileserver .
hpc:Directdatastaging a rdfs:subClassOf hpc:Bsubstagecommand .
hpc:Oncloudlsfcluster rdfs:subClassOf hpc:Lsfcluster .
hpc:Locallsfcluster rdfs:subClassOf hpc:Lsfcluster .
hpc:Managementhost rdfs:domain hpc:Oncloudlsfcluster ;
    rdfs:range rdf:Resource .
hpc:Connectedto rdfs:domain hpc:Oncloudlsfcluster ;
    rdfs:range hpc:Oncloudlsfcluster .
hpc:Resourceconnector rdfs:domain hpc:Oncloudlsfcluster ;
    rdfs:range rdf:Resource .
hpc:Growsshrinks rdfs:domain hpc:Oncloudlsfcluster ;
    rdfs:range rdf:Resource .
hpc:Datamanager rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .
hpc:Dataavailability rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .
hpc:Bsubfcommand rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .
hpc:Sshaccess rdfs:domain (hpc:Ionode | hpc:Transferqueue) ;
    rdfs:range hpc:Fileserver .
