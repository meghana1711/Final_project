hpc:Message a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a message written to the log file prompting the restart." .

hpc:Mbatchddaemon a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the mbatchd daemon." .

hpc:restart a owl:ObjectProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range hpc:Mbatchddaemon ;
    rdfs:comment "Relates a message to the mbatchd daemon for restart." .

hpc:badmin a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchddaemon ;
    rdfs:range xsd:string ;
    rdfs:comment "Relates an LSF cluster to the mbatchd daemon." .

hpc:Parametersection a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a section defining License Scheduler configuration parameters." .

hpc:required a owl:ObjectProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if a parameter is required." .

hpc:admin a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the LSF License Scheduler administrator using a valid UNIX user account." .

hpc:hosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the hosts for the mbatchd daemon." .

hpc:lmstatPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the path to the License Scheduler statistics." .

hpc:rlmstatPath a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:string ;
    rdfs:comment "Defines the path to the Resource License Manager statistics." .

hpc:lmStatInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Defines the interval for License Scheduler statistics." .

hpc:port a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Defines the port for the mbatchd daemon." .

hpc:auth a owl:DatatypeProperty ;
    rdfs:domain hpc:Parametersection ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables LSF License Scheduler user authentication for projects for taskman jobs." .
