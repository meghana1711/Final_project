hpc:Script a owl:Class .
hpc:hasvmtype a owl:ObjectProperty .
hpc:Vmtype a owl:Class .
hpc:logfile a owl:DatatypeProperty .
hpc:lsfConfFile a owl:DatatypeProperty .

hpc:Script rdfs:subClassOf owl:Class .
hpc:Hasvmtype rdfs:domain hpc:Script ;
                 rdfs:range hpc:Vmtype .
hpc:Vmtype rdfs:subClassOf owl:Class .
hpc:Logfile rdfs:domain hpc:Script ;
              rdfs:range xsd:string .
hpc:LsfConfFile rdfs:domain hpc:Script ;
              rdfs:range xsd:string .
