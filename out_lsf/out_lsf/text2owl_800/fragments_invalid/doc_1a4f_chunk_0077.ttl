hpc:Queue1 a owl:Class ;
    hpc:priority xsd:int "45" ;
    hpc:dispatchWindow rdfs:datatype xsd:time ;
    hpc:dispatchWindow "4:30-12:00"^^xsd:time .

hpc:Runwindow a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:Plural ;
    hpc:isActive rdf:Boolean .

hpc:isactive a owl:ObjectProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range xsd:boolean .
