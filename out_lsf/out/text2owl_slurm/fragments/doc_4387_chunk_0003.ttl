hpc:Slurmdbd a owl:Class .
hpc:Slurmplugin a owl:Class .
hpc:Mysqlplugin rdfs:subClassOf hpc:Slurmplugin .
hpc:Slurmdbdplugin rdfs:subClassOf hpc:Slurmplugin .
hpc:Slurmdbdinstallation a owl:Class .
hpc:requiresrpm a owl:ObjectProperty .
hpc:Requiresrpm rdfs:domain hpc:Slurmdbdinstallation ;
    rdfs:range xsd:string .
hpc:Slurmdbdconfiguration a owl:Class .
hpc:usesslurmplugin a owl:ObjectProperty .
hpc:Usesslurmplugin rdfs:domain hpc:Slurmdbdconfiguration ;
    rdfs:range hpc:Slurmplugin .
hpc:Slurmdbdresponse a owl:Class .
hpc:respondstoslurmctld a owl:ObjectProperty .
hpc:Respondstoslurmctld rdfs:domain hpc:Slurmdbd ;
    rdfs:range xsd:boolean .
hpc:Slurmdbdcache a owl:Class .
hpc:usesslurmctld a owl:ObjectProperty .
hpc:Usesslurmctld rdfs:domain hpc:Slurmdbdcache ;
    rdfs:range hpc:Slurmctld .
hpc:Slurmdbddatacollection a owl:Class .
hpc:collectsdatafrommultipleclusters a owl:ObjectProperty .
hpc:Collectsdatafrommultipleclusters rdfs:domain hpc:Slurmdbddatacollection .
