hpc:Esecurityjson a owl:Class .
hpc:hasaddresses a owl:ObjectProperty .
hpc:Hasaddresses rdfs:domain hpc:Esecurityjson ;
                  rdfs:range xsd:string[] .

hpc:cidrformat a owl:DatatypeProperty .
hpc:Cidrformat rdfs:domain xsd:string ;
                rdfs:range xsd:string .

hpc:Allowedipaddresses a owl:Class .
hpc:Allowedipaddresses rdfs:subClassOf hpc:Esecurityjson .
hpc:Allowedipaddresses hpc:hasaddresses rdf:value "[]"^^xsd:string .
hpc:Allowedipaddresses hpc:hasaddresses rdf:first  hpc:BlockedIPAddresses ;
                                         rdf:rest   hpc:AllowedIPAddresses .

hpc:Blockedipaddresses a owl:Class .
hpc:Blockedipaddresses rdfs:subClassOf hpc:Esecurityjson .
hpc:Blockedipaddresses hpc:hasaddresses rdf:value "[]"^^xsd:string .

hpc:Anyipaddressrange a owl:Class .
hpc:AnyIPAddressRange a owl:NamedIndividual ;
                        hpc:CIDRFormat "0.0.0.0/0" .

hpc:Ipaddressrange a owl:Class .
hpc:IPAddressRange a owl:NamedIndividual ;
                    rdf:type hpc:CIDRFormat .

hpc:Esecurityfile a owl:Class .
hpc:ESecurityFile a owl:NamedIndividual ;
                   rdf:type hpc:File .
hpc:Esecurityfile hpc:location "http://example.org/hpc#LWS_TOP/conf/esecurity.json" .

hpc:Lwswebservicesaccess a owl:Class .
hpc:LWSWebServicesAccess a owl:NamedIndividual ;
                          rdf:type hpc:AccessControl .
hpc:Lwswebservicesaccess hpc:securedby hpc:ESecurityJSON .

hpc:Accesscontrol a owl:Class .
hpc:accesscontrol a owl:ObjectProperty .
hpc:Accesscontrol rdfs:domain hpc:Lwswebservices .
