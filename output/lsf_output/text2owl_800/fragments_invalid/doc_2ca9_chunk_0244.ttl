hpc:Lsfversion a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Different versions of LSF." .

hpc:Fixpack11 a owl:Class ;
    rdfs:subClassOf hpc:Lsfversion ;
    rdfs:comment "Version 10.1 Fix Pack 11." .

hpc:Fixpack13 a owl:Class ;
    rdfs:subClassOf hpc:Lsfversion ;
    rdfs:comment "Version 10.1 Fix Pack 13." .

# Per-consumer limits
hpc:perapp a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Resourceallocation ;
    rdfs:comment "Global per-application resource allocations." .

hpc:perlicproject a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Resourceallocation ;
    rdfs:comment "Global per-licensed project resource allocations." .

hpc:perproject a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Resourceallocation ;
    rdfs:comment "Global per-project resource allocations." .

hpc:perqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Resourceallocation ;
    rdfs:comment "Global per-queue resource allocations." .

hpc:peruser a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Resourceallocation ;
    rdfs:comment "Global per-user resource allocations." .

# Resource section
hpc:Resourcesection a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Global resources shared between all clusters." .

# ResourceMap section
hpc:Resourcemapsection a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Mapping between shared resources and their sharing clusters." .

# DistributePolicy section
hpc:Distributepolicysection a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Distribution policies for global resources and global limits." .

# ReservationUsage section
hpc:Reservationusagesection a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Method of reserving global resources." .

# ComputeUnit section
hpc:Computeunit a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Compute unit section in LSF configuration." .

hpc:member a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunit ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Allows use of colons (:) or hyphens (-) to specify a range of numbers in condensed notation
