hpc:Jobgroup a owl:Class .
hpc:Jobgroup rdfs:subClassOf owl:NamedIndividual .
hpc:Jobgroup rdfs:subClassOf hpc:Resourcegroup .
hpc:Jobgroup rdfs:domain xsd:string .
hpc:Jobgroup rdfs:range maxLength(512) .

hpc:hassla a owl:ObjectProperty .
hpc:Hassla rdfs:domain hpc:Jobgroup .
hpc:Hassla rdfs:range hpc:Serviceclass .

hpc:isslajob a owl:ObjectProperty .
hpc:Isslajob rdfs:domain hpc:Job .
hpc:Isslajob rdfs:range xsd:boolean .

hpc:Serviceclass a owl:Class .
hpc:Serviceclass rdfs:subClassOf owl:NamedIndividual .

hpc:Gpuresource a owl:Class .
hpc:Gpuresource rdfs:subClassOf hpc:Resource .

hpc:numgpus a owl:DatatypeProperty .
hpc:Numgpus rdfs:domain hpc:Gpuresource .
hpc:Numgpus rdfs:range xsd:nonNegativeInteger .

hpc:mode a owl:DatatypeProperty .
hpc:Mode rdfs:domain hpc:Gpuresource .
hpc:Mode rdfs:range xsd:string .

hpc:mps a owl:DatatypeProperty .
hpc:Mps rdfs:domain hpc:Gpuresource .
hpc:Mps rdfs:range xsd:string .

hpc:jExclusive a owl:DatatypeProperty .
hpc:JExclusive rdfs:domain hpc:Gpuresource .
hpc:JExclusive rdfs:range xsd:string .

hpc:aff a owl:DatatypeProperty .
hpc:Aff rdfs:domain hpc:Gpuresource .
hpc:Aff rdfs:range xsd:string .

hpc:block a owl:DatatypeProperty .
hpc:Block rdfs:domain hpc:Gpuresource .
hpc:Block rdfs:range xsd:string .

hpc:gpack a owl:DatatypeProperty .
hpc:Gpack rdfs:domain hpc:Gpuresource .
hpc:Gpack rdfs:range xsd:string .

hpc:gvendor a owl:DatatypeProperty .
hpc:Gvendor rdfs:domain hpc:Gpuresource .
hpc:Gvendor rdfs:range xsd:string .

hpc:affinity a owl:ObjectProperty .
hpc:Affinity rdfs:domain hpc:Gpuresource .
hpc:Affinity rdfs:range hpc:Resource .

hpc:guaranteegoal a owl:ObjectProperty .
hpc:Guaranteegoal rdfs:domain hpc:Sla .
hpc:Guaranteegoal rdfs:range xsd:boolean .
