hpc:ThreeDimensionalTorusInterconnect
    a owl:Class ;
    rdfs:subClassOf hpc:Interconnect .

hpc:HilbertCurve
    a owl:ObjectProperty ;
    rdfs:domain hpc:Threedimensionaltorusinterconnect ;
    rdfs:range xsd:string .

hpc:HierarchicalNetwork
    a owl:Class ;
    rdfs:subClassOf hpc:Interconnect .

hpc:FatTreeNetwork
    a owl:Class ;
    rdfs:subClassOf hpc:Hierarchicalnetwork .

hpc:DragonflyNetwork
    a owl:Class ;
    rdfs:subClassOf hpc:Hierarchicalnetwork .

hpc:BestFitResourceAllocation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range hpc:Job .
