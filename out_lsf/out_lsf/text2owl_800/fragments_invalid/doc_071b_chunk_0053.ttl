hpc:Host a owl:Class .
hpc:hasaddress a owl:ObjectProperty .
hpc:hasptrrecord a owl:ObjectProperty .
hpc:ipv4address a owl:DatatypeProperty .
hpc:ipv6address a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Hasaddress rdfs:domain hpc:Host ;
                      rdfs:range xsd:string .
hpc:Hasptrrecord rdfs:domain hpc:Host ;
                    rdfs:range xsd:string .
hpc:Ipv4address rdfs:domain hpc:Host ;
                rdfs:range xsd:string .
hpc:Ipv6address rdfs:domain hpc:Host ;
                rdfs:range xsd:string .

hpc:DNS A rdf:Type owl:Class .
hpc:Dns rdfs:subClassOf rdf:Resource .
hpc:hasipv4ptrrecord a owl:ObjectProperty ;
                      rdfs:domain hpc:Dns ;
                      rdfs:range hpc:Ipv4address .
hpc:hasipv6ptrrecord a owl:ObjectProperty ;
                      rdfs:domain hpc:Dns ;
                      rdfs:range hpc:Ipv6address .

hpc:IPv4Address rdf:type xsd:string .
hpc:IPv6Address rdf:type xsd:string .

hpc:Ipv4address hpc:inaddrarpadomain PTR hpc:IPv4 .
hpc:Ipv6address hpc:inaddrarpadomain PTR hpc:IPv6 .

hpc:Ipv4 hpc:hasdottedquad xsd:string .
hpc:Ipv6 hpc:hasdottedquad xsd:string .

hpc:Ipv4 hpc:hasdottedquad "AA.AA.AA.AA" .
hpc:Ipv6 hpc:hasdottedquad "BBBB:BBBB:BBBB:BBBB" .

hpc:Ipv4 hpc:inaddrarpadomain PTR "host.domain" .
hpc:Ipv6 hpc:inaddrarpadomain PTR "host.domain.in-addr.arpa" .

hpc:Ipv4 hpc:inaddrarpadomain2 PTR "host.domain" .
hpc:Ipv6 hpc:inaddrarpadomain2 PTR "BBBB:BBBB:BBBB:BBBB.in-addr.arpa" .

hpc:Ipv4 hpc:inaddrarpadomain3 PTR "host.domain" .
hpc:Ipv6 hpc:inaddrarpadomain3 PTR "BBBB:BBBB:BBBB::BBBB.in-addr.arpa" .
