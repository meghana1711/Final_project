hpc:Jobbasedpreexecutionprocessing a owl:Class .
hpc:Jobbasedpostexecutionprocessing a owl:Class .
hpc:Queuelevelprocessing a owl:Class .
hpc:Applicationlevelprocessing a owl:Class .
hpc:Joblevelprocessing a owl:Class .
hpc:commandpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing ;
    rdfs:range xsd:string .
hpc:Operatingsystem a owl:Class ;
    rdfs:subClassOf owl:Class .
hpc:Unix a rdfs:subClassOf hpc:Operatingsystem .
hpc:Windows a rdfs:subClassOf hpc:Operatingsystem .
hpc:Mixedoperatingsystem a rdfs:subClassOf hpc:Operatingsystem .
hpc:jobdependencies a owl:ObjectProperty ;
    rdfs:domain hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing ;
    rdfs:range hpc:Operatingsystem .
hpc:Hostbasedpreexecutionprocessing a owl:Class .
hpc:Hostbasedpostexecutionprocessing a owl:Class .
hpc:Paralleljob a rdfs:subClassOf hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing .
hpc:Sequentialjob a rdfs:subClassOf hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing .
hpc:Hostbasedpreprocessing a rdfs:subClassOf hpc:Hostbasedpreexecutionprocessing .
hpc:Hostbasedpostprocessing a rdfs:subClassOf hpc:Hostbasedpostexecutionprocessing .
hpc:Executionhost a rdfs:subClassOf hpc:Hostbasedpreexecutionprocessing, hpc:Hostbasedpostexecutionprocessing .
hpc:jobresizable a owl:ObjectProperty ;
    rdfs:domain hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing .
hpc:Batchjob a rdfs:subClassOf hpc:Jobbasedpreexecutionprocessing, hpc:Jobbasedpostexecutionprocessing .
