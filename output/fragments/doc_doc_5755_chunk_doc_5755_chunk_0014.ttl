hpc:SLURMJob a owl:Class .
hpc:HostsFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SLURMJob ;
    rdfs:range xsd:string .

hpc:FluentCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SLURMJob ;
    rdfs:range xsd:string .

hpc:InteractiveSession a owl:Class ;
    rdfs:subClassOf hpc:SLURMJob .

hpc:CommandToExecute rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:InteractiveSession ;
    rdfs:range xsd:string .

hpc:Options rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:InteractiveSession ;
    rdfs:range xsd:string .

hpc:SrunOption rdf:type owl:Class .
hpc:SrunCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SrunOption ;
    rdfs:range xsd:string .

hpc:SrunOptionValue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SrunOption ;
    rdfs:range xsd:string .

hpc:OvercommitOption rdf:type hpc:SrunOption ;
    hpc:SrunCommand "srun" ;
    hpc:SrunOptionValue "--overcommit" .

hpc:OvercommitBehavior rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OvercommitOption ;
    rdfs:range xsd:string .

hpc:OversubscribeOption rdf:type hpc:SrunOption ;
    rdfs:subClassOf hpc:SrunOption ;
    hpc:SrunCommand "srun" ;
    hpc:SrunOptionValue "--oversubscribe" .

hpc:UOption rdf:type hpc:SrunOption ;
    hpc:SrunCommand "srun" ;
    hpc:SrunOptionValue "--u" .

hpc:UnbufferedOption rdf:type hpc:UOption ;
    hpc:SrunOptionValue "--unbuffered" .
```
