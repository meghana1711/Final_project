@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Path a owl:Class .
hpc:Post a owl:Class .

hpc:requestbody a owl:ObjectProperty ;
    rdfs:domain hpc:Path ;
    rdfs:range rdf:Resource .

hpc:path.paths.associations a hpc:path ;
    hpc:Post hpc:post .

hpc:path.paths.wckeys a hpc:path ;
    hpc:Post hpc:post .

hpc:path.paths.config a hpc:path ;
    hpc:Post hpc:post .

hpc:Field a owl:Class .
hpc:requestbody
