hpc:Compoundresourcerequirement a owl:Class .
hpc:Guaranteedresourcepool a owl:Class .
hpc:Paralleljob a owl:Class .
hpc:Compoundresourceterm a owl:Class .
hpc:Host a owl:Class .
hpc:resourceallocation a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range hpc:Compoundresourceterm .
hpc:Rejectedhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Jobslot a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .
hpc:finalresourcerequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range hpc:Jobslot .
hpc:totaljobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numx a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Resourcerequirementspecification a owl:Class .
hpc:slotsorprocessors a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcerequirementspecification ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Memoryrequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementspecification .
hpc:Gpurequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementspecification .
hpc:physicalgpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:gpumodel a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .
hpc:reservedgpumemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:specialconnections a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .
hpc:migrequirements a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:string .
hpc:gtile a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpurequirement ;
    rdfs:range xsd:nonNegativeInteger .
