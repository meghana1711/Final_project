hpc:LsfLicSchedPreemptStop a owl:Class .
hpc:Feature a owl:Class .
hpc:Project a owl:Class .
hpc:Group a owl:Class .
hpc:share a owl:ObjectProperty ;
    rdfs:domain hpc:Group ;
    rdfs:range xsd:integer .
hpc:nonshared a owl:DatatypeProperty ;
    rdfs:domain hpc:Project .
hpc:Shares rdfs:subClassOf hpc:Nonshared .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Project .
hpc:projectname a owl:DatatypeProperty .
hpc:licensename a owl:DatatypeProperty .
hpc:localto a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Project .
hpc:Hierarchicalgroup a owl:Class .
hpc:Hierarchicalgroupmember a owl:Class .
hpc:hierarchicalgrouping a owl:ObjectProperty ;
    rdfs:domain hpc:Hierarchicalgroup ;
    rdfs:range (hpc:Hierarchicalgroupmember .) .
