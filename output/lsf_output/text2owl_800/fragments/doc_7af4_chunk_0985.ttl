hpc:Booleanclass a owl:Class .
hpc:Stringclass a owl:Class .
hpc:Numericclass a owl:Class .

hpc:hasvalue a owl:ObjectProperty .
hpc:hasType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Booleanclass ;
    rdfs:range xsd:integer .

hpc:hastype a owl:ObjectProperty ;
    rdfs:domain hpc:Stringclass .

hpc:Hasvalue rdfs:range xsd:integer .

hpc:hasinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Numericclass ;
    rdfs:range xsd:integer .

hpc:isincreasing a owl:DatatypeProperty ;
    rdfs:domain hpc:Numericclass ;
    rdfs:range xsd:boolean .

hpc:isconsumable a owl:ObjectProperty ;
    rdfs:domain hpc:Numericclass .

hpc:Consumableresource rdfs:subClassOf hpc:Numericclass .

hpc:r15s a hpc:ConsumableResource .
hpc:r1m a hpc:ConsumableResource .
hpc:r15m a hpc:ConsumableResource .
hpc:ut a hpc:ConsumableResource .
hpc:pg a hpc:ConsumableResource .
hpc:io a hpc:ConsumableResource .
hpc:ls a hpc:ConsumableResource .
hpc:it a hpc:ConsumableResource .
hpc:tmp a hpc:ConsumableResource .
hpc:swp a hpc:ConsumableResource .
hpc:mem a hpc:ConsumableResource .

hpc:Isstatic rdfs:subClassOf hpc:Numericclass .
hpc:Isexternalloadindex rdfs:subClassOf hpc:Numericclass .

hpc:isstatic a owl:ObjectProperty ;
    rdfs:domain hpc:Numericclass .

hpc:isexternalloadindex a owl:ObjectProperty ;
    rdfs:domain hpc:Numericclass ;
    rdfs:subPropertyOf hpc:hasInterval .
