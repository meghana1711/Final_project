hpc:LsfStripDomain a owl:Class .
hpc:EgoStripDomain a owl:Class .
hpc:lsfTcpKeepaliveTime a owl:DatatypeProperty .

hpc:LsfStripDomain rdfs:subClassOf owl:Class .
hpc:EgoStripDomain rdfs:subClassOf owl:Class .
