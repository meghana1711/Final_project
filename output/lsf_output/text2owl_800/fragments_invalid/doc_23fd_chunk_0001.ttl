@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Lsfcluster a owl:Class .
hpc:lsfclusterlogon a owl:ObjectProperty .
hpc:lsfclusterlist a owl:ObjectProperty .
hpc:lsfjobsubmission a owl:ObjectProperty .
hpc:Lwsconf a owl:Class .
hpc:Commandsjson a owl:Class .
hpc:Esecurityjson a owl:Class .
hpc:Lwsconffile a owl:Class .
hpc:lwsconffilelocation a owl:DatatypeProperty .
hpc:lwsconffileformat a owl:DatatypeProperty .
hpc:Lwsconfentry a owl:Class .
hpc:lwsconfentryname a owl:DatatypeProperty .
hpc:lwsconfentryvalue a owl:DatatypeProperty .

hpc:Lsfclusterlogon rdfs:domain hpc:User .
hpc:Lsfclusterlogon rdfs:range hpc:Lsfcluster .
hpc:Lsfclusterlist rdfs:domain hpc:Lsfcluster .
hpc:Lsfclusterlist rdfs:range hpc:Lsfclusterlisting .
hpc:Lsfjobsubmission rdfs:domain hpc:User .
hpc:Lsfjobsubmission rdfs:range hpc:Lsfjob .
hpc:Lwsconf rdfs:subClassOf hpc:Lwsconffile .
hpc:Commandsjson rdfs:subClassOf hpc:Lwsconffile .
hpc:Esecurityjson rdfs:subClassOf hpc:Lwsconffile .
hpc:Lwsconffilelocation rdfs:range xsd:string .
hpc:Lwsconffileformat rdfs:range xsd:string .
hpc:Lwsconfentry rdfs:subClassOf hpc:Lwsconf .
hpc:Lwsconfentryname rdfs:domain hpc:Lwsconfentry .
hpc:Lwsconfentryvalue rdfs:domain hpc:Lwsconfentry .
