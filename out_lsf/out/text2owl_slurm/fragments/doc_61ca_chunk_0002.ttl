hpc:Plugin a owl:Class .
hpc:init a owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:integer .
hpc:fini a owl:ObjectProperty ;
    rdfs:domain hpc:Plugin .
hpc:prologSlurmctldCallback a owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:anyURI .
hpc:epilogSlurmctldCallback a owl:ObjectProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:anyURI .
hpc:Asyncoperation a owl:Class ;
    rdfs:subClassOf hpc:Plugin .
hpc:asyncoperationrequireslocalcopy a owl:ObjectProperty ;
    rdfs:domain hpc:Asyncoperation ;
    rdfs:range xsd:boolean .
hpc:asyncoperationspawnsthread a owl:ObjectProperty ;
    rdfs:domain hpc:Asyncoperation ;
    rdfs:range xsd:boolean .
hpc:asyncoperationsetscallback a owl:ObjectProperty ;
    rdfs:domain hpc:Asyncoperation ;
    rdfs:range xsd:anyURI .
