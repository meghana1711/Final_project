hpc:Project a owl:Class .
hpc:Defaultvpc a owl:Class .
hpc:Autosubnets a owl:Class .
hpc:Customsubnets a owl:Class .
hpc:Subnetwork a owl:Class .
hpc:Region a owl:Class .
hpc:communication a owl:ObjectProperty .
hpc:lsfnetwork a owl:ObjectProperty .
hpc:Subnetcreationmode rdfs:domain hpc:Project ;
                          rdfs:range hpc:Autosubnets, hpc:Customsubnets .
hpc:Defaultvpcnetwork rdfs:domain hpc:Project ;
                       rdfs:range hpc:Defaultvpc .
hpc:Firewall a owl:Class .
hpc:Firewallrule a owl:Class .
hpc:incomingtraffic a owl:ObjectProperty .
hpc:outgoingtraffic a owl:ObjectProperty .
hpc:trafficblocked a owl:ObjectProperty .
hpc:opentraffic a owl:ObjectProperty .
hpc:customizedrule a owl:ObjectProperty .
hpc:Lsflisteningports rdfs:domain hpc:Firewallrule ;
                       rdfs:range xsd:integer .
hpc:LSF_LIM_PORT a xsd:integer .
hpc:LSF_RES_PORT a xsd:integer .
hpc:LSB_SBD_PORT a xsd:integer .
hpc:Managementhost rdfs:domain hpc:Firewallrule ;
                   rdfs:range xsd:string .
hpc:Googlecloudinstance a owl:Class .
hpc:Sshkey a owl:Class .
hpc:connect a owl:ObjectProperty .
hpc:Googlecloudplatform a owl:Class .
hpc:Googleclouddocumentation rdfs:domain hpc:Googlecloudplatform ;
                             rdfs:range xsd:string .
hpc:PublicIP a xsd:string .
hpc:gcloudCommand a xsd:string .

hpc:Project rdfs:subClassOf owl:Class .
hpc:Autosubnets rdfs:subClassOf hpc:Subnetwork .
hpc:Customsubnets rdfs:subClassOf hpc:Subnetwork .
hpc:Subnetwork rdfs:subClassOf owl:Class .
hpc:Region rdfs:subClassOf owl:Class .
hpc:Defaultvpc rdfs:subClassOf hpc:Vpc .
hpc:Vpc rdfs:subClassOf owl:Class .
hpc:Firewall rdfs:subClassOf owl:Class .
hpc:Firewallrule rdfs:subClassOf hpc:Firewall .
hpc:Googlecloudinstance rdfs:subClassOf owl:Class .
hpc:Sshkey rdfs:subClassOf owl:Class .

hpc:Communication rdfs:domain hpc:Subnetwork ;
                    rdfs:range hpc:Subnetwork .
hpc:Lsfnetwork rdfs:domain hpc:Project ;
                 rdfs:range hpc:Defaultvpc .
hpc:Incomingtraffic rdfs:domain hpc:Firewallrule ;
                     rd
