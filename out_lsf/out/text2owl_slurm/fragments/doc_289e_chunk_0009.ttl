hpc:User a owl:Class .
hpc:Qos a owl:Class .
hpc:belongsto a owl:ObjectProperty .
hpc:qosMembership a owl:DatatypeProperty .

hpc:Belongsto rdfs:domain hpc:User .
hpc:Belongsto rdfs:range rdf:List .
hpc:QosMembership rdfs:domain hpc:User .
hpc:QosMembership rdfs:range xsd:string .

hpc:QOS1 a hpc:QOS ;
    hpc:QOS_membership "alligator" .
hpc:QOS2 a hpc:QOS ;
    hpc:QOS_membership "zebra" .
hpc:canis_major a hpc:User .
hpc:root a hpc:User .
hpc:crock a hpc:User .

hpc:CanisMajor hpc:belongsto (hpc:QOS2) .
hpc:Root hpc:belongsto (hpc:QOS2) .
hpc:CanisMajor hpc:belongsto (hpc:QOS1) .
hpc:Crock hpc:belongsto (hpc:QOS2) .
hpc:Crock hpc:belongsto (hpc:QOS1) .

hpc:Crock hpc:qosMembership "alligator" ;
    hpc:QOS_membership "zebra" .
