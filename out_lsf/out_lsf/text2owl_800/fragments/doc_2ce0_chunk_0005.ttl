hpc:Job a owl:Class .
hpc:submittime a owl:DatatypeProperty .
hpc:jobname a owl:DatatypeProperty .
hpc:User a owl:Class .
hpc:status a owl:DatatypeProperty .
hpc:queue a owl:DatatypeProperty .
hpc:fromhost a owl:DatatypeProperty .
hpc:Jobhistory a owl:Class .
hpc:secureinfodiruseraccess a owl:DatatypeProperty .
hpc:badminmbdrestart a owl:ObjectProperty .
hpc:bparams a owl:ObjectProperty .
hpc:bhist a owl:ObjectProperty .
hpc:bacct a owl:ObjectProperty .
hpc:chmod a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Submittime rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Jobname rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:User rdfs:subClassOf owl:Class .
hpc:Status rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Queue rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Fromhost rdfs:domain hpc:Job ;
                 rdfs:range xsd:string .
hpc:Jobhistory rdfs:subClassOf owl:Class .
hpc:Secureinfodiruseraccess rdfs:domain hpc:Jobhistory ;
                 rdfs:range xsd:boolean .
hpc:Badminmbdrestart rdfs:domain hpc:Jobhistory ;
                 rdfs:range rdf:Resource .
hpc:Bparams rdfs:domain hpc:Jobhistory ;
                 rdfs:range rdf:Resource .
hpc:Bhist rdfs:domain hpc:Jobhistory ;
                 rdfs:range rdf:Resource .
hpc:Bacct rdfs:domain hpc:Jobhistory ;
                 rdfs:range rdf:Resource .
hpc:Chmod rdfs:domain hpc:Jobhistory ;
                 rdfs:range rdf:Resource .
