hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job submitted to the HPC system." .

hpc:synchronousexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job was submitted with the bsub -K command." .

hpc:unformattedjobdetailinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Unformattedjobdetailinformation ;
    rdfs:comment "Represents the unformatted job detail information." .

hpc:scriptparsingkeyword a owl:ObjectProperty ;
    rdfs:domain hpc:Unformattedjobdetailinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the keywords that can be parsed from the unformatted job detail information." .

hpc:outputcontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Unformattedjobdetailinformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the control over the output format and length." .

hpc:timestamp a owl:DatatypeProperty ;
    rdfs:domain hpc:Unformattedjobdetailinformation ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Represents the time stamp in the unformatted job detail information." .

hpc:Jobexception a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that triggered a job exception." .

hpc:exceptionstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Jobexception ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the status of the job exception." .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an application profile configured in lsb.applications." .

hpc:accountinginformation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Accountinginformation ;
    rdfs:comment "Represents accounting information about jobs submitted to the specified application profile." .

hpc:timeinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Accountinginformation ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the time interval for accounting information." .

hpc:Archivedlogfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents an archived log file." .

hpc:Accountingstatistics a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents accounting statistics for jobs that completed or exited during a specified time interval." .

hpc:timeinterval1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Accountingstatistics ;
    rdfs
