hpc:Submissioncluster a owl:Class .
hpc:Executioncluster a owl:Class .
hpc:Lsfdatamanager a owl:Class .
hpc:Remotedatamanager a owl:Class .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:string .
hpc:servers a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:string .
hpc:port a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:integer .
hpc:reconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Lsfdatamanager .
hpc:runreconfigcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range xsd:string .
hpc:hasconnection a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Connection .
hpc:Connection a owl:Class .
hpc:managementhostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range xsd:string .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range xsd:string .
hpc:outgoingconnections a owl:DatatypeProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range xsd:string .
hpc:incomingconnections a owl:DatatypeProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range xsd:string .
