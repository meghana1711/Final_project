hpc:Checkpointdirectory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Any valid path used for storing checkpoint files." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job that can be checkpointed and restarted." .

hpc:Checkpointfile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A file containing checkpoint information for a job." .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for a job." .

hpc:jobfilename a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the file associated with the job." .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The time in minutes between automatic checkpoints." .

hpc:checkpointdirectorypath a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:string ;
    rdfs:comment "The path of the checkpoint directory." .

hpc:checkpointable a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointdirectory ;
    rdfs:comment "The relationship between a job and its checkpoint directory." .

hpc:checkpointedby a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range hpc:Job ;
    rdfs:comment "The jobs that have been checkpointed into a directory." .

hpc:checkpointableperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The checkpoint period for a directory, if automatically checkpointing is enabled." .

hpc:maxcheckpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointdirectory ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum recommended checkpoint period due to the heavyweight nature of checkpointing." .
