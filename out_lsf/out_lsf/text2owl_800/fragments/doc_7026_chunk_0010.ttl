hpc:LsfAdmin a owl:Class .
hpc:LsfManagementHost a owl:Class .
hpc:LsfManagementCandidate a owl:Class .
hpc:ChCommand a owl:Class .
hpc:restrictAccess a owl:ObjectProperty .
hpc:executionPermissions a owl:DatatypeProperty .
hpc:lsfMasterList a owl:ObjectProperty .
hpc:lsfRejectNonlsfhost a owl:ObjectProperty .
hpc:lsfHostAddrRange a owl:DatatypeProperty .

hpc:LsfAdmin rdfs:subClassOf owl:Thing .
hpc:LsfManagementHost rdfs:subClassOf hpc:LsfAdmin .
hpc:LsfManagementCandidate rdfs:subClassOf hpc:LsfAdmin .
hpc:ChCommand rdfs:subClassOf owl:Thing .

hpc:RestrictAccess rdfs:domain hpc:LsfAdmin .
hpc:RestrictAccess rdfs:range hpc:ChCommand .
hpc:ExecutionPermissions rdfs:domain hpc:ChCommand .
hpc:ExecutionPermissions rdfs:range xsd:string .
hpc:LsfMasterList rdfs:domain hpc:LsfManagementHost .
hpc:LsfMasterList rdfs:range xsd:string .
hpc:LsfRejectNonlsfhost rdfs:domain hpc:LsfManagementHost .
hpc:LsfRejectNonlsfhost rdfs:range xsd:boolean .
hpc:LsfHostAddrRange rdfs:domain hpc:LsfManagementHost .
hpc:LsfHostAddrRange rdfs:range xsd:string .
