hpc:Jobpriority a owl:Class .
hpc:Userassignedjobpriority a owl:Class .
hpc:submittedjoborder a owl:ObjectProperty .
hpc:jobeligibilityfordispatch a owl:ObjectProperty .
hpc:jobdispatchorder a owl:ObjectProperty .
hpc:jobstarvationprevention a owl:ObjectProperty .
hpc:jobpriorityescalation a owl:ObjectProperty .
hpc:Automaticjobpriorityescalation a owl:Class .
hpc:Absolutejobpriorityscheduling a owl:Class .
hpc:apsjobselectionprocess a owl:ObjectProperty .
hpc:jobpriorityvalue a owl:DatatypeProperty .
hpc:Jobrelatedfactor a owl:Class .
hpc:Jobweightingfactor a owl:Class .
hpc:Subfactor a owl:Class .
hpc:factorweight a owl:DatatypeProperty .
hpc:subfactorweight a owl:DatatypeProperty .
hpc:relaxjobdispatchorder a owl:ObjectProperty .
hpc:firstcomefirstserved a owl:ObjectProperty .
hpc:Queue a owl:Class .

hpc:Jobpriority rdfs:subClassOf owl:Class .
hpc:Userassignedjobpriority rdfs:subClassOf hpc:Jobpriority .
hpc:Automaticjobpriorityescalation rdfs:subClassOf hpc:Jobpriority .
hpc:Absolutejobpriorityscheduling rdfs:subClassOf hpc:Jobpriority .
hpc:Jobrelatedfactor rdfs:subClassOf hpc:Jobpriority .
hpc:Jobweightingfactor rdfs:subClassOf hpc:Jobrelatedfactor .
hpc:Subfactor rdfs:subClassOf hpc:Jobrelatedfactor .
hpc:Queue a owl:Class .

hpc:Submittedjoborder rdfs:domain hpc:Userassignedjobpriority ;
                        rdfs:range hpc:Job .
hpc:Jobeligibilityfordispatch rdfs:domain hpc:Userassignedjobpriority ;
                               rdfs:range hpc:Job .
hpc:Jobdispatchorder rdfs:domain hpc:Jobpriority ;
                       rdfs:range hpc:Job .
hpc:Jobstarvationprevention rdfs:domain hpc:Absolutejobpriorityscheduling ;
                            rdfs:range hpc:Queue .
hpc:Apsjobselectionprocess rdfs:domain hpc:Absolutejobpriorityscheduling ;
                           rdfs:range hpc:Queue .
hpc:Jobpriorityvalue rdfs:domain hpc:Jobpriority ;
                     rdfs:range xsd:integer .
hpc:Jobrelatedfactor rdfs:domain hpc:Jobpriorityvalue ;
                    rdfs:range hpc:Jobrelatedfactor .
hpc:Subfactor rdfs:domain hpc:Jobrelatedfactor ;
               rdfs:range hpc:Subfactor .
hpc:Factorweight rdfs:domain hpc:Jobweightingfactor ;
               rdfs:range xsd:float .
hpc:Subfactorweight rdfs:domain hpc:Subfactor ;
               rdfs:range xsd:float .
hpc:RelaxJobDispatch
