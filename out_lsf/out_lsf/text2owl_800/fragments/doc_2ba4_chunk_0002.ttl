hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequiringlicense .

hpc:Resourcerequiringlicense a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Licensepool a owl:Class ;
    rdfs:subClassOf hpc:Resourcepool .

hpc:Staticlicensepool a owl:Class ;
    rdfs:subClassOf hpc:Licensepool .

hpc:Staticlicense a owl:Class ;
    rdfs:subClassOf hpc:License .

hpc:hasLicensePool rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcepool ;
    rdfs:range hpc:Licensepool .

hpc:hasStaticLicense rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Staticlicensepool ;
    rdfs:range hpc:Staticlicense .

hpc:name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource, hpc:Staticlicense ;
    rdfs:range xsd:string .

hpc:type rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource, hpc:Staticlicense ;
    rdfs:range xsd:string .

hpc:interval rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:nonNegativeInteger .

hpc:increasing rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .

hpc:description rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
