@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:eplimit a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:duration .

hpc:inputFile a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:nonNegativeInteger .

hpc:outputFile a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:nonNegativeInteger .

hpc:errorFile a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:nonNegativeInteger .

hpc:outputDir a owl:ObjectProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range hpc:Directory .

hpc:subCwd a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:string .

hpc:execHome a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:string .

hpc:execCwd a owl:DatatypeProperty ;
  rdfs:domain hpc:Job ;
  rdfs:range xsd:string .

hpc:Directory a owl:Class .
