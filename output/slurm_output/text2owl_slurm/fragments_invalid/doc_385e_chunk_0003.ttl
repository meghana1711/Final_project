hpc:GPUsPerNode        a        owl:DatatypeProperty ;
                        rdfs:domain   hpc:Resourceallocation ;
                        rdfs:range    xsd:nonNegativeInteger ;
                        rdfs:comment  "Number of GPUs per node." .

hpc:GPUsPerSocket      a        owl:DatatypeProperty ;
                        rdfs:domain   hpc:Resourceallocation ;
                        rdfs:range    xsd:nonNegativeInteger ;
                        rdfs:comment  "Number of GPUs per socket." .

hpc:GPUsPerTask        a        owl:Datatype
