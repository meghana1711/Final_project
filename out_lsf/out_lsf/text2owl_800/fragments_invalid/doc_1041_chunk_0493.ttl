hpc:Applicationprofile a owl:Class .
hpc:Resumereason a owl:Class .
hpc:Jobgroup a owl:Class .
hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Queue a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:app a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Applicationprofile .
hpc:c a owl:ObjectProperty ;
    rdfs:domain hpc:Resumereason .
hpc:g a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Jobgroup .
hpc:j a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:m a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hp:(Host | hpc:Hostgroup) .
hpc:q a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Queue .
hpc:sla a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Serviceclass .
hpc:u a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range (hpc:User | hpc:Usergroup | xsd:string) .
hpc:Jobidindexlist a owl:Class ;
    rdfs:subClassOf hpc:Jobid .
