hpc:Cacheaccesscontrol a owl:Class .
hpc:permissionmask a owl:DatatypeProperty .
hpc:cacheAccessControl a owl:ObjectProperty .
hpc:Hasdefaultpermissionmask rdfs:domain hpc:Cacheaccesscontrol .
hpc:Hasdefaultpermissionmask rdfs:range xsd:integer .

hpc:Querynthreads a owl:Class .
hpc:queryNthreads a owl:ObjectProperty .
hpc:Numberofthreads rdfs:domain hpc:Querynthreads .
hpc:Numberofthreads rdfs:range xsd:integer .

hpc:Remotecacherefreshinterval a owl:Class .
hpc:refreshInterval a owl:DatatypeProperty .
hpc:remoteCacheRefreshInterval a owl:ObjectProperty .
hpc:Hasdefaultvalue rdfs:domain hpc:Remotecacherefreshinterval .
hpc:Hasdefaultvalue rdfs:range xsd:integer .
hpc:Hasvalidvaluemin rdfs:domain hpc:Remotecacherefreshinterval .
hpc:Hasvalidvaluemin rdfs:range xsd:integer .
hpc:Hasvalidvaluemax rdfs:domain hpc:Remotecacherefreshinterval .
hpc:Hasvalidvaluemax rdfs:range xsd:integer .

hpc:Stagingarea a owl:Class .
hpc:stagingArea a owl:ObjectProperty .
hpc:Stagingareapath rdfs:domain hpc:Stagingarea .
hpc:Stagingareapath rdfs:range xsd:string .
hpc:Hashostname rdfs:domain hpc:Stagingarea .
hpc:Hashostname rdfs:range xsd:string .
hpc:Pathmustnotcontainstickybit rdfs:subClassOf hpc:Stagingarea .
