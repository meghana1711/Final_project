hpc:Jobsubmissionoptions a owl:Class .
hpc:inputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:string .
hpc:outputdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:string .
hpc:corelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:integer .
hpc:computenodemem a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:integer .
hpc:hostfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:string .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:string .
hpc:rerun a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmissionoptions ;
    rdfs:range xsd:string .
hpc:Schedule a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmissionoptions .
hpc:usergroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedule ;
    rdfs:range xsd:string .
hpc:Notify a owl:Class ;
    rdfs:subClassOf hpc:Schedule .
hpc:notifyjobdone a owl:DatatypeProperty ;
    rdfs:domain hpc:Notify ;
    rdfs:range xsd:string .
hpc:notifyjobexit a owl:DatatypeProperty ;
    rdfs:domain hpc:Notify ;
    rdfs:range xsd:string .
hpc:mailuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Notify ;
    rdfs:range xsd:string .
hpc:command a owl:DatatypeProperty ;
    rdfs:domain hpc:Notify ;
    rdfs:range xsd:string .
