hpc:Computeunit a owl:Class .
hpc:pref a owl:DatatypeProperty .
hpc:Pref rdfs:domain hpc:Computeunit .
hpc:Pref rdfs:range xsd:string .

hpc:ConfigPref a owl:NamedIndividual .
hpc:Configpref hpc:pref "config" .

hpc:MaxAvailPref a owl:NamedIndividual .
hpc:Maxavailpref hpc:pref "maxvail" .

hpc:MinAvailPref a owl:NamedIndividual .
hpc:Minavailpref hpc:pref "minavail" .

hpc:Firstexecutionhost a owl:Class .
hpc:mandatoryfirstexecutionhost a owl:ObjectProperty .
hpc:Mandatoryfirstexecutionhost rdfs:domain hpc:Computeunit .
hpc:Mandatoryfirstexecutionhost rdfs:range hpc:Firstexecutionhost .
