hpc:User a owl:Class .
hpc:Query a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Cluster a owl:Class .
hpc:networkbandwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:decimal .
hpc:responsiveness a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
hpc:performance a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
hpc:Queryimpact a owl:Class ;
    rdfs:subClassOf hpc:Query .
hpc:multithreadedmbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Query .
hpc:queryport a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:integer .
hpc:queryenhanced a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:xBoolean .
hpc:maxconcurrentquery a owl:DatatypeProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range xsd:integer .
hpc:heavyqueryoperation a owl:ObjectProperty ;
    rdfs:domain hpc:Query .
hpc:lsfmultithreadedquery a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Queryimpact ;
    rdfs:domain hpc:Managementhost ;
hpc:querytraffic a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .
