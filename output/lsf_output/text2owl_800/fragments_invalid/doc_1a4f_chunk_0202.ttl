hpc:Booleanvariable a owl:Class .
hpc:Stringvariable a owl:Class .

hpc:booleanoperator a owl:ObjectProperty .
hpc:stringoperator a owl:ObjectProperty .

hpc:Andoperator rdfs:subClassOf hpc:Booleanoperator .
hpc:Oroperator rdfs:subClassOf hpc:Booleanoperator .
hpc:Notoperator rdfs:subClassOf hpc:Booleanoperator .

hpc:Equaloperator rdfs:subClassOf hpc:Stringoperator .
hpc:Notequaloperator rdfs:subClassOf hpc:Stringoperator .
hpc:Lessoperator rdfs:subClassOf hpc:Stringoperator .
hpc:Lessorequaloperator rdfs:subClassOf hpc:Stringoperator .
hpc:Greateroperator rdfs:subClassOf hpc:Stringoperator .
hpc:Greaterorequaloperator rdfs:subClassOf hpc:Stringoperator .

hpc:functioncall a owl:DatatypeProperty .
hpc:Functioncall rdfs:domain hpc:Booleanvariable ;
                    rdfs:range hpc:Functioncallresult .

hpc:Functioncallresult rdfs:subClassOf xsd:boolean .

hpc:Functioncallresult rdfs:range xsd:string .

hpc:Multiplenotoperatorserror a owl:Class .

hpc:Invalidfunctioncall a owl:Class .

hpc:Invalidfunctioncall rdfs:subClassOf hpc:Functioncall ;
                         rdfs:subClassOf hpc:Invalidfunctioncallerror .

hpc:Invalidfunctioncallerror rdfs:subClassOf xsd:string .

hpc:InvalidFunctionCallError rdf:value "Function calls must not have blanks between the parentheses." .

hpc:InvalidFunctionCallError rdf:value "Multiple logical NOT operators (!) are not valid." .

hpc:Resourcerequirement a owl:Class .
hpc:Resourcerequirement rdfs:subClassOf rdf:Statement .

hpc:Resourcerequirement rdfs:domain hpc:Resource .

hpc:selection a owl:ObjectProperty .
hpc:Selection rdfs:domain hpc:Resourcerequirement ;
               rdfs:range hpc:Resource .

hpc:Selection rdfs:range hpc:Selectionresult .

hpc:Selectionresult a owl:Class .
hpc:Selectionresult rdfs:subClassOf rdf:Statement .

hpc:Selectionresult rdfs:domain hpc:Resource .

hpc:Selectionresult rdfs:range hpc:Resource .

hpc:Invalidselection a owl:Class .

hpc:Invalidselection rdfs:subClassOf hpc:Selection ;
                      rdfs:subClassOf hpc:Invalidselectionerror .

hpc:Invalidselectionerror rdfs:subClassOf xsd:string .

hpc:InvalidSelectionError rdf:value "At least one blank space must separate each section." .

hpc:InvalidSelectionError rdf:value "Only a single select section is supported by the stricter syntax." .

hpc:InvalidSelectionError rdf:value "Escape characters (like '\n') are not supported in string literals." .

