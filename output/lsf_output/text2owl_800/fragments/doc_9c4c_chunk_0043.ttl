hpc:LsfAdmin a owl:Class .
hpc:Hasprimaryadmin rdfs:domain hpc:LsfAdmin ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasAdmin .
hpc:Hassecondaryadmin rdfs:domain hpc:LsfAdmin ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasAdmin .
hpc:Isprimaryadmin rdfs:subClassOf hpc:LsfAdmin .
hpc:Issecondaryadmin rdfs:subClassOf hpc:LsfAdmin .
hpc:Hasadmin rdfs:domain hpc:LsfAdmin ;
    rdfs:range rdf:List .
hpc:LsfAdminAccount a owl:Class .
hpc:Cannotberoot rdfs:domain hpc:LsfAdminAccount ;
    rdfs:range xsd:boolean .
hpc:Ownsconfigfiles rdfs:domain hpc:LsfAdminAccount ;
    rdfs:range xsd:boolean .
hpc:Haspermissiontoreconfigure rdfs:domain hpc:LsfAdminAccount ;
    rdfs:range xsd:boolean .
hpc:Haspermissiontocontrolbatchjobs rdfs:domain hpc:LsfAdminAccount ;
    rdfs:range xsd:boolean .
hpc:Haspermissiontostartdaemons rdfs:domain hpc:LsfAdminAccount ;
    rdfs:range xsd:boolean .
hpc:LsfAdminAccount a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:isPrimaryAdmin ;
        owl:hasValue true ] .
hpc:LsfAdminAccount a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:onProperty hpc:isSecondaryAdmin ;
        owl:hasValue true ] .
hpc:Backupandrollback rdfs:domain xsd:boolean .
hpc:Backupandrollback rdfs:range xsd:boolean .
