hpc:StartedJobs rdfs:domain hpc:Queue ;
                    rdfs:range xsd:nonNegativeInteger .
hpc:reservedJobs a owl:ObjectProperty .
hpc:ReservedJobs rdfs:domain hpc:Queue ;
                    rdfs:range xsd:nonNegativeInteger .
