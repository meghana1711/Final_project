hpc:Distribution a owl:Class .
hpc:Licensesscheduler a owl:Class .
hpc:clustermodeobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Licensesscheduler ;
    rdfs:range hpc:Clustermode .
hpc:projectmodeobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Licensesscheduler ;
    rdfs:range hpc:Projectmode .
hpc:blinfoobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Licensesscheduler .
hpc:alphaobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:boolean .
hpc:groupobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:List .
hpc:featuregroupdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:string .
hpc:nonshareddistributiondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:boolean .
hpc:workloaddistributiondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Distribution ;
    rdfs:range xsd:boolean .
hpc:licensetokennamesdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:List .
hpc:hierarchicalprojectgroupschedulingpolicydatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:boolean .
hpc:hierarchicallicenseprojectgroupconfigurationobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range hpc:Hierarchicallicenseprojectgroup .
hpc:clusterlocalityinformationobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:List .
hpc:licenseserverhostsobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:List .
hpc:servicedomainsobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:List .
hpc:Featuregroup a owl:Class ;
    rdfs:subClassOf hpc:Distribution .
hpc:featurelistdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Featuregroup ;
    rdfs:range rdf:List .
hpc:Hierarchicallicenseprojectgroup a owl:Class .
