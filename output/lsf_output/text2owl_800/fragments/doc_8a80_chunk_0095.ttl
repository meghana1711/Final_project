hpc:blstatusage a owl:ObjectProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range rdf:Resource .

hpc:blstatversion a owl:ObjectProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range xsd:string .

hpc:blstatdynamic a owl:ObjectProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range rdf:Resource .

hpc:blstatsynopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range xsd:string .

hpc:servicedomainname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:tokenname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:outputalpha a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:total a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:available a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:featuregroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:string .

hpc:slots a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstatdynamic ;
    rdfs:range xsd:boolean .

hpc:all a owl:ObjectProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range rdf:Resource .

hpc:tokennametoken a owl:ObjectProperty ;
    rdfs:domain hpc:All ;
    rdfs:range xsd:string .

hpc:lsprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:All ;
    rdfs:range xsd:string .

hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstat ;
