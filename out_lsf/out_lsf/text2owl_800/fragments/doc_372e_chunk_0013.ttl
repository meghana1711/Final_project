hpc:Feature a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .
hpc:clusterdistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .
hpc:allocBuffer a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string .

hpc:Mywan a owl:Class ;
    rdfs:subClassOf hpc:Cluster .
hpc:Mylan a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:c1 a hpc:Cluster ;
    hpc:Name "c1" .
hpc:c2 a hpc:Cluster ;
    hpc:Name "c2" .
hpc:c3 a hpc:Cluster ;
    hpc:Name "c3" .
