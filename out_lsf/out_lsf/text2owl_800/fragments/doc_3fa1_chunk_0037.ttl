hpc:Jobslotreservation a owl:Class .
hpc:Adjustment a owl:Class .
hpc:Fairshareadjustment a owl:Class .

hpc:hasreservedslots a owl:ObjectProperty .
hpc:hasinuseslots a owl:ObjectProperty .
hpc:hasadjustment a owl:ObjectProperty .

hpc:cputimefactor a owl:DatatypeProperty .
hpc:runtimefactor a owl:DatatypeProperty .
hpc:runjobfactor a owl:DatatypeProperty .
hpc:fwdjobfactor a owl:DatatypeProperty .
hpc:fairshareadjustmentfactor a owl:DatatypeProperty .
hpc:histhours a owl:DatatypeProperty .
hpc:gpuruntimefactor a owl:DatatypeProperty .

hpc:Hascputimefactor rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal .
hpc:Hasruntimefactor rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal .
hpc:Hasrunjobfactor rdfs:domain hpc:Queue;
    rdfs:range xsd:integer .
hpc:Hasfwdjobfactor rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal .
hpc:Hasfairshareadjustmentfactor rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal .
hpc:Hashisthours rdfs:domain hpc:Queue;
    rdfs:range xsd:integer .
hpc:Hasgpuruntimefactor rdfs:domain hpc:Queue;
    rdfs:range xsd:decimal .

hpc:Queue a owl:Class .
hpc:Cluster a owl:Class .
hpc:Queue rdfs:subClassOf hpc:Cluster .

hpc:lsbQueues a rdf:Property .
hpc:lsbParams a rdf:Property .
