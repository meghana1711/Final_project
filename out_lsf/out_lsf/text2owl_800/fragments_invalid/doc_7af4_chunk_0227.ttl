hpc:Host a owl:Class .
hpc:Jobslot a owl:Class .
hpc:preemptivescheduling a owl:ObjectProperty .
hpc:numberofprocessors a owl:DatatypeProperty .
hpc:jobslotcount a owl:DatatypeProperty .
hpc:Loadindex a owl:Class .
hpc:loadsched a owl:ObjectProperty .
hpc:loadstop a owl:ObjectProperty .
hpc:schedulingthreshold a owl:DatatypeProperty .
hpc:suspendingthreshold a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Jobslot rdfs:subClassOf owl:Class .
hpc:Preemptivescheduling rdfs:domain hpc:Host ;
                             rdfs:range owl:Boolean .
hpc:Numberofprocessors rdfs:domain hpc:Host ;
                          rdfs:range xsd:nonNegativeInteger .
hpc:Jobslotcount rdfs:domain hpc:Host ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Loadindex rdfs:subClassOf owl:Class .
hpc:Loadsched rdfs:domain hpc:Host ;
                  rdfs:range rdf:List .
hpc:Loadstop rdfs:domain hdf:LoadSched ;
               rdfs:range rdf:List .
hpc:Schedulingthreshold rdfs:domain rdf:List ;
                         rdfs:range xsd:nonNegativeInteger .
hpc:Suspendingthreshold rdfs:domain rdf:List ;
                         rdfs:range xsd:nonNegativeInteger .
