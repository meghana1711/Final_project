hpc:Averagecpuusage a owl:Class .
hpc:Averagecpuusagepercentage rdfs:domain hpc:Averagecpuusage ;
                               rdfs:range xsd:decimal .

hpc:Cpupeakreachedduration a owl:Class .
hpc:Cpupeakreachedduration rdfs:domain hpc:Cpupeakreachedduration ;
                             rdfs:range xsd:duration .

hpc:Planstarttime a owl:Class .
hpc:Planstarttime rdfs:domain hpc:Planstarttime ;
                   rdfs:range xsd:dateTime .

hpc:Planfinishtime a owl:Class .
hpc:Planfinishtime rdfs:domain hpc:Planfinishtime ;
                    rdfs:range xsd:dateTime .

hpc:Allfields a owl:Class .

hpc:outputwidth a owl:DatatypeProperty ;
                rdfs:domain hpc:Allfields ;
                rdfs:range xsd:positiveInteger .

hpc:fieldnamesandaliasesnotcasesensitive a owl:ObjectProperty .

hpc:Validvaluesforoutputwidth a owl:Class .
hpc:Validvaluesforoutputwidth rdfs:subClassOf hpc:Positiveinteger .

hpc:Jobid a owl:Class .
hpc:Jobid rdfs:domain hpc:Jobid ;
         rdfs:range xsd:string .

hpc:lsbjobiddisplength a owl:DatatypeProperty ;
                        rdfs:domain hpc:Allfields .

hpc:specifiedoutputwidthoverrideslsbjobiddisplength a owl:ObjectProperty .
