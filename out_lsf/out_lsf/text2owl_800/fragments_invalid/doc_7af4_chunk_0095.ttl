    rdfs:domain hpc:Postexecutioncommand ;
    rdfs:range xsd:string .
hpc:usesshell a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutioncommand ;
    rdfs:range xsd:boolean .
hpc:requeuesjob a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutioncommand ;
    rdfs:range hpath:Job .
hpc:setsenvironmentvariable a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutioncommand ;
