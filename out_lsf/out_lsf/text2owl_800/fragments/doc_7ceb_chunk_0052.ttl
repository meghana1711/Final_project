hpc:Lim a owl:Class .
hpc:Configurationfile a owl:Class .
hpc:Errorlog a owl:Class .
hpc:Host a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Locallim a owl:Class .
hpc:Cluster a owl:Class .
hpc:lsfserverhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:string .
hpc:lsfmasterlist a owl:DatatypeProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:string .
hpc:communicationtimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Locallim ;
    rdfs:range hpc:Errorlog .
hpc:running a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:up a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
hpc:cannotlocatemasterlim a owl:ObjectProperty ;
    rdfs:domain hpc:Locallim ;
    rdfs:range hpc:Errorlog .
hpc:masterlimisdown a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Errorlog .
hpc:hostnameconflict a owl:ObjectProperty ;
    rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Errorlog .
hpc:LoopbackAddress a xsd:string .
