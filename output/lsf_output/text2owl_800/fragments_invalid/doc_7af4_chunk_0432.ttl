hpc:Gpumode a owl:Class;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Sharedgpumode a owl:Class;
    rdfs:subClassOf hpc:Gpumode;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Exclusiveprocessgpumode a owl:Class;
    rdfs:subClassOf hpc:Gpumode;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:hasgpumode a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Gpumode .

hpc:mpsenabled a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:boolean .

hpc:mpsmode a owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:string .

hpc:Mpsmodevalue a owl:Class;
    rdfs:subClassOf [ rdf:type xsd:string ] .

hpc:MPSValue_yes a hpc:MPSModeValue .
hpc:MPSValue_no a hpc:MPSModeValue .
hpc:MPSValue_mps_shared a hpc:MPSModeValue .
hpc:MPSValue_per_socket a hpc:MPSModeValue .
hpc:MPSValue_per_gpu a hpc:MPSModeValue .

hpc:MpsmodeoptionMpsYes a owl:Class;
    rdfs:subClassOf hpc:Mpsmodevalue .

hpc:MpsmodeoptionMpsNo a owl:Class;
    rdfs:subClassOf hpc:Mpsmodevalue .

hpc:MpsmodeoptionMpsShared a owl:Class;
    rdfs:subClassOf hpc:Mpsmodevalue .

hpc:MpsmodeoptionPerSocket a owl:Class;
    rdfs:subClassOf hpc:Mpsmodevalue .

hpc:MpsmodeoptionPerGpu a owl:Class;
    rdfs:subClassOf hpc:Mpsmodevalue .

hpc:Amdgpu a owl:Class;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:Nvidiagpu a owl:Class;
    rdfs:subClassOf [ rdf:type owl:Class ] .

hpc:amdgpuExcluded a owl:ObjectProperty;
    rdfs:domain hpc:Mpsenabled;
    rdfs:range hpc:Amdgpu .

hpc:nvidiagpuExcluded a owl:ObjectProperty;
    rdfs:domain hpc:Mpsenabled;
    rdfs:range hpc:Nvidiagpu .

hpc:mpsIgnored a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Mpsenabled .

hpc:mpsUseful a owl:ObjectProperty;
    rdfs
