hpc:Lsf a owl:Class .
hpc:Configuration a owl:Class .
hpc:Timebasedconfiguration a owl:Class .
hpc:Multiclusterconfiguration a owl:Class .
hpc:Sharedconfiguration a owl:Class .
hpc:Commonconfigurationfile a owl:Class .
hpc:Application a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:cpulimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:decimal .
hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedconfiguration ;
    rdfs:range xsd:string .
hpc:timebased a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range hpc:Timebasedconfiguration .
hpc:include a owl:ObjectProperty ;
    rdfs:domain hpc:Timebasedconfiguration ;
    rdfs:range hpc:Commonconfigurationfile .
hpc:Lsbevents a owl:Class .
hpc:Lsbeventlogfile a owl:Class .
hpc:Lsbeventrecord a owl:Class .
hpc:JobNew a owl:Class ;
    rdfs:subClassOf hpc:Lsbeventrecord .
hpc:niosport a owl:DatatypeProperty ;
    rdfs:domain hpc:JobNew ;
    rdfs:range xsd:integer .
hpc:statuschange a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbeventrecord ;
    rdfs:range hpc:Host|hpc:Job|hpc:Queue .
hpc:lsbeventsfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbeventlogfile ;
    rdfs:range xsd:string .
