hpc:blstat a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range rdf:List .

hpc:Command a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:clustermode a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Cluster .

hpc:projectmode a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Project .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Hostgroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Computeunit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Licenseserver a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Licensefeature a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:fieldname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range xsd:string .

hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:domain hpc:Fieldname ;
    rdfs:range xsd:nonNegativeInteger .

hpc:delimiter a owl:DatatypeProperty ;
    rdfs:domain hpc:Blstat ;
    rdfs:range xsd:string .

hpc:lsprojectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:resreq a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Project a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
