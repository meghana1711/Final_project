hpc:Loadindex a owl:Class .
hpc:Builtinloadindex a owl:Class .
hpc:Externalloadindex a owl:Class .
hpc:Hostbasedresource a owl:Class .
hpc:Numericresource a owl:Class .
hpc:Dynamicresource a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:Customizedoutputformat a owl:Class .
hpc:Lsloadfield a owl:Class .
hpc:Wildcardcharacter a owl:Class .
hpc:fieldname a owl:DatatypeProperty .
hpc:outputformat a owl:ObjectProperty .
hpc:numhosts a owl:DatatypeProperty .
hpc:lsloadfieldsorder a owl:ObjectProperty .
hpc:fieldwidth a owl:DatatypeProperty .
hpc:RecommendedWidth a xsd:integer .
hpc:MaximumWidth a xsd:integer .
hpc:Truncated a xsd:boolean .
hpc:lsloadfieldname a owl:DatatypeProperty .
hpc:UnlimitedWidth a xsd:integer .
hpc:LeftJustification a xsd:boolean .
hpc:Hostbasedresource rdfs:subClassOf hpc:Resource .
hpc:Numericresource rdfs:subClassOf hpc:Hostbasedresource .
hpc:Dynamicresource rdfs:subClassOf hpc:Numericresource .
hpc:Resourcerequirement rdfs:subClassOf hpc:Dynamicresource .
hpc:Customizedoutputformat rdfs:subClassOf hpc:Resourcerequirement .
hpc:Lsloadfield rdfs:subClassOf hpc:Customizedoutputformat .
hpc:Wildcardcharacter rdfs:subClassOf hpc:Lsloadfield .
hpc:Builtinloadindex rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:integer .
hpc:Externalloadindex rdfs:domain hpc:Hostbasedresource ;
    rdfs:range xsd:integer .
hpc:Numhosts rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range xsd:integer .
hpc:Outputformat rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range hpc:Lsloadfield .
hpc:Lsloadfieldsorder rdfs:domain hpc:Customizedoutputformat ;
    rdfs:range rdf:List .
hpc:Fieldwidth rdfs:domain hpc:Lsloadfield ;
    rdfs:range xsd:integer .
hpc:Recommendedwidth rdfs:domain hpc:Fieldwidth .
hpc:Maximumwidth rdfs:domain hpc:Fieldwidth .
hpc:Truncated rdfs:domain hpc:Fieldwidth .
hpc:Lsloadfieldname rdfs:domain hpc:Lsloadfield ;
    rdfs:range xsd:string .
hpc:Unlimitedwidth rdfs:domain hpc:Fieldwidth .
hpc:Leftjustification rdfs:domain hpc:Fieldwidth .
