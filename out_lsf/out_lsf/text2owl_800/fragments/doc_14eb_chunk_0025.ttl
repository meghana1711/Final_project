hpc:Resourcegroup a owl:Class .
hpc:Host a owl:Class .
hpc:Workload a owl:Class .
hpc:canrun a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Workload .
hpc:operatingsystemtype a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:dynamicmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcegroup .
hpc:Resourcedistributionplan a owl:Class .
hpc:requestresources a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Resourcedistributionplan .
hpc:returnslots a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcedistributionplan ;
    rdfs:range xsd:integer .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcedistributionplan .
hpc:Resourcemanager a owl:Class .
