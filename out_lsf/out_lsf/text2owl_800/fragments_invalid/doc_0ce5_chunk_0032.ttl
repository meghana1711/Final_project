hpc:lsfQueryEsServers a owl:ObjectProperty .
hpc:lsfQueryEsFunctions a owl:ObjectProperty .

hpc:Function a owl:Class .
hpc:Acctfunction hpc:function ;
    rdfs:subClassOf hpc:Function ;
    rdfs:comment "For the acct function, the bacct command uses LSF Explorer to retrieve the accounting log records." .
hpc:Jobsfunction hpc:function ;
    rdfs:subClassOf hpc:Function ;
    rdfs:comment "For the jobs function, the bhist command uses LSF Explorer to retrieve the event log records." .
hpc:Energyfunction hpc:function ;
    rdfs:subClassOf hpc:Function ;
    rdfs:comment "If the energy function is defined and LSF_ENABLE_BEAT_SERVICE='energy' is defined in the lsf.conf file, the bhosts and bjobs commands use LSF Explorer to retrieve energy data." .
hpc:Gpfsiofunction hpc:function ;
    rdfs:subClassOf hpc:Function ;
    rdfs:comment "If the gpfsio function is defined, the bjobs and bacct commands use LSF Explorer to retrieve IBM Spectrum Scale job accounting I/O data." .
hpc:Allfunction hpc:function ;
    rdfs:subClassOf hpc:Function ;
    rdfs:comment "If the all keyword is defined, all supported functions use LSF Explorer to retrieve data." .

hpc:Hasserver rdfs:domain hpc:LsfQueryEsServers ;
hpc:Hasserver rdfs:range xsd:string .

hpc:Hasfunction rdfs:domain hpc:LsfQueryEsFunctions ;
hpc:Hasfunction rdfs:range hpc:Function .
