hpc:LsfApplicationMonitoring a owl:Class .
hpc:LsfAcPncUrlParameter a owl:Class .
hpc:ExternalWatchdogScript a owl:Class .

# Object Properties
hpc:usesLsfAcPncUrl a owl:ObjectProperty ;
    rdfs:domain hpc:LsfApplicationMonitoring ;
    rdfs:range hpc:LsfAcPncUrlParameter .
hpc:sendsNotification a owl:ObjectProperty ;
    rdfs:domain hpc:ExternalWatchdogScript ;
    rdfs:range hpc:Notification .

# Datatype Properties
hpc:hasUrl a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfAcPncUrlParameter ;
    rdfs:range xsd:string .
hpc:hasListenPort a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfAcPncUrlParameter ;
    rdfs:range xsd:integer .
hpc:hasMessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Notification ;
    rdfs:range xsd:string .
hpc:hasErrorLevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Notification ;
    rdfs:range xsd:string .

# Data
hpc:LSF_Application_Center_Notifications_Server a hpc:LSF_AC_PNC_URL_Parameter ;
    hpc:has_URL "http://example.com/lsf-ac-notifications" ;
    hpc:has_Listen_Port 5678 .

hpc:bpost a hpc:External_Watchdog_Script .
hpc:Bpost hpc:sendsNotification (
    hpc:Notification (
        hpc:has_Message "message" ;
        hpc:has_Error_Level "WARNING"
    )
) .

# Other LSF Behavior

hpc:ResourceLimitMaximumIntegerLimitIncrease a owl:Class .
hpc:BjobsPlanCommandOption a owl:Class .
hpc:ImprovedBreadAndBstatusPerformance a owl:Class .
hpc:NewPlatformSupport a owl:Class .

hpc:maximumIntegerLimitIncreased a owl:ObjectProperty ;
    rdfs:domain hpc:ResourceLimitMaximumIntegerLimitIncrease ;
    rdfs:range hpc:Lsf .
hpc:bjobsPlanCommandOptionShowsPlannedStartAndEndTimes a owl:ObjectProperty ;
    rdfs:domain hpc:BjobsPlanCommandOption ;
    rdfs:range hpc:Lsf .
hpc:improvedBreadAndBstatusPerformanceByHandlingRequestsInQueryMbatchdDaemon a owl:ObjectProperty ;
    rdfs:domain hpc:ImprovedBreadAndBstatusPerformance ;
    rdfs
