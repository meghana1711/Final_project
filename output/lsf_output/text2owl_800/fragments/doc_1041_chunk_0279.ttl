hpc:Application a owl:Class .
hpc:serviceclass a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Serviceclass .
hpc:jobgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range hpc:Jobgroup .
hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:integer .
hpc:advancereservationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:esubexternalsubmissionname a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:killreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
hpc:suspendreason a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
