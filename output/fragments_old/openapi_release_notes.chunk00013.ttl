hpc:JobDescription a owl:Class .

hpc:FSize a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:Memlock a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:Nofile a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:Nproc a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:Rss a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:Stack a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int64 .

hpc:SegmentSize a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int16 .

hpc:Shared a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range rdf:List ;
    rdfs:range rdf:ListMember xsd:string .

hpc:TimeLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int32 .

hpc:TimeMinimum a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:int32 .

hpc:TresPerJob a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:string .

hpc:TresPerNode a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:string .

hpc:TresPerSocket a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:string .

hpc:TresPerTask a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range xsd:string .

hpc:X11 a owl:DatatypeProperty ;
    rdfs:domain hpc:JobDescription ;
    rdfs:range rdf:List ;
