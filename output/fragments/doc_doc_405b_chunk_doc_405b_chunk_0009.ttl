hpc:JobHeldAdmin a owl:Class .
hpc:JobHeldUser a owl:Class .
hpc:JobHoldMaxRequeue a owl:Class .
hpc:JobLaunchFailure a owl:Class .
hpc:Licenses a owl:Class .

hpc:MaxBBPerAccount a owl:Class .
hpc:MaxBillingPerAccount a owl:Class .
hpc:MaxCpuPerAccount a owl:Class .
hpc:MaxEnergyPerAccount a owl:Class .
hpc:MaxGRESPerAccount a owl:Class .
hpc:MaxJobsPerAccount a owl:Class .
hpc:MaxLicensePerAccount a owl:Class .
hpc:MaxMemoryPerAccount a owl:Class .
hpc:MaxMemPerLimit a owl:Class .
hpc:MaxNodePerAccount a owl:Class .

hpc:hasSystemAdmin a owl:ObjectProperty ;
    rdfs:domain hpc:JobHeldAdmin ;
    rdfs:range hpc:Job .

hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:JobHeldUser ;
    rdfs:range hpc:User .

hpc:hasRequeueLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:JobHoldMaxRequeue ;
    rdfs:range xsd:integer .

hpc:launchStatus a owl:DatatypeProperty ;
    rdfs:domain hpc:JobLaunchFailure ;
    rdfs:range xsd:string .

hpc:waitingForLicense a owl:ObjectProperty ;
    rdfs:domain hpc:Licenses ;
    rdfs:range hpc:License .

hpc:exceedsBBPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxBBPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsBillingPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxBillingPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsCpuPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxCpuPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsEnergyPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxEnergyPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsGRESPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxGRESPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsJobsPerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxJobsPerAccount ;
    rdfs:range hpc:Job .

hpc:exceedsLicensePerAccountLimit a owl:ObjectProperty ;
    rdfs:domain hpc:MaxLicensePerAccount ;
    rdfs:range hpc:Job .

