hpc:Jwt a owl:Class .
hpc:Signingkey a owl:Class .
hpc:privkey a owl:DatatypeProperty ;
    rdfs:domain hpc:Signingkey ;
    rdfs:range xsd:base64Binary .
hpc:Message a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf rdfs:Resource ] .
hpc:exp a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:integer .
hpc:iat a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:integer .
hpc:sun a owl:DatatypeProperty ;
    rdfs:domain hpc:Message ;
    rdfs:range xsd:string .
hpc:compactjws a owl:ObjectProperty ;
    rdfs:domain hpc:Jwt ;
    rdfs:range xsd:base64Binary .
hpc:decode a owl:ObjectProperty ;
    rdfs:domain hpc:Jwt ;
    rdfs:range hpc:Decodedjwt .
hpc:Decodedjwt a owl:Class .
hpc:verify a owl:ObjectProperty ;
    rdfs:domain hpc:Decodedjwt ;
    rdfs:range xsd:boolean .
