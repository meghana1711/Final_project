hpc:Licensefeature a owl:Class .
hpc:Unitoflicense a owl:Class .
hpc:Licenseserver a owl:Class .
hpc:Lsflicensescheduler a owl:Class .
hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Job a owl:Class .
hpc:Runningjob a owl:Class .
hpc:Checkout a owl:Class .
hpc:Checkoutoutsidelsfjob a owl:Class .
hpc:Checkoutbylsfjob a owl:Class .
hpc:Freeunit a owl:Class .

hpc:Hasunitoflicense hpc:licensefeature owl:ObjectProperty .
hpc:Usedby hpc:unitoflicense hpc:Job owl:ObjectProperty .
hpc:outsidelsfjob hpc:checkout a owl:ObjectProperty .
hpc:bylsfjob hpc:checkout a owl:ObjectProperty .
hpc:free hpc:checkout a owl:ObjectProperty .
hpc:On hpc:checkout hpc:Host owl:ObjectProperty .
hpc:Submittedby hpc:job hpc:User owl:ObjectProperty .
hpc:Runningon hpc:job hpc:Host owl:ObjectProperty .
hpc:Availableon hpc:licenseserver hpc:UnitOfLicense owl:ObjectProperty .
hpc:Getlatestusage hpc:licenseserver hpc:LicenseServer owl:ObjectProperty .

hpc:Unitoflicense rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Job rdfs:subClassOf hpc:Runningjob .
hpc:Checkout rdfs:subClassOf hpc:Checkoutoutsidelsfjob or hpc:Checkoutbylsfjob or hpc:Freeunit .

hpc:Hasunitoflicense rdfs:domain hpc:Licensefeature ;
                      rdfs:range hpc:Unitoflicense .
hpc:Usedby rdfs:domain hpc:Unitoflicense ;
             rdfs:range hpc:Job .
hpc:Outsidelsfjob rdfs:domain hpc:Checkout ;
                   rdfs:range hpc:Checkoutoutsidelsfjob .
hpc:Bylsfjob rdfs:domain hpc:Checkout ;
              rdfs:range hpc:Checkoutbylsfjob .
hpc:Free rdfs:domain hpc:Checkout ;
            rdfs:range hpc:Freeunit .
hpc:On rdfs:domain hpc:Checkout ;
       rdfs:range hpc:Host .
hpc:Submittedby rdfs:domain hpc:Job ;
               rdfs:range hpc:User .
hpc:Runningon rdfs:domain hpc:Job ;
              rdfs:range hpc:Host .
hpc:Availableon rdfs:domain hpc:Licenseserver ;
               rdfs:range hpc:Unitoflicense .
hpc:Getlatestusage rdfs:domain hpc:Licenseserver ;
                 rdfs:range hpc:Licenseserver .
