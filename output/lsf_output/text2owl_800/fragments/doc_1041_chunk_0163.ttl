hpc:Cluster a owl:Class .
hpc:dmdMaster a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:lsfDataPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:integer .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:outgoingRemote a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:incomingRemote a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
hpc:lsfDataHosts a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDataPort ;
    rdfs:range hpc:Cluster .
hpc:Admin a owl:Class .
