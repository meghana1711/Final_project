hpc:Preemptablejob a owl:Class .
hpc:nopreemptinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:pendingtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range xsd:duration .
hpc:nopreemptintervalhasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Nopreemptinterval .
hpc:pendingtimelimithasvalue a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptablejob ;
    rdfs:range hpc:Pendingtimelimit .
hpc:PendingTimeLimitDefault a owl:NamedIndividual ;
    hpc:PendingTimeLimitHasValue "PEND_TIME_LIMIT" .
