hpc:Lsf a owl:Class.
hpc:hasTimeoutValue a rdfs:DatatypeProperty;
    rdfs:domain hpc:Lsf;
    rdfs:range xsd:nonNegativeInteger.
hpc:isdefinedin a owl:ObjectProperty;
    rdfs:domain hpc:Lsf;
    rdfs:range hpc:Configurationfile.
hpc:isoverriddenby a owl:ObjectProperty;
    rdfs:domain hpc:Environmentvariable;
    rdfs:range hpc:Lsf.
hpc:restartalldaemons a owl:ObjectProperty;
    rdfs:domain hpc:Lsfadministrator;
    rdfs:range hpc:Restartaction.
hpc:Configurationfile a owl:Class.
hpc:Environmentvariable a owl:Class.
hpc:Restartaction a owl:Class.
hpc:Lsfadministrator a owl:Class.
hpc:Hastimeoutvaluevalue rdfs:range xsd:nonNegativeInteger.
