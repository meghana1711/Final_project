hpc:Elimexecutable a owl:Class .
hpc:hasLoadIndex rdf:Property ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range xsd:string .

# Resource
hpc:Resource a owl:Class .
hpc:hasName rdf:Property ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:isNumericResource rdf:Property ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:getDataInterval rdf:Property ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:duration .

# Dynamic External Resource
hpc:Dynamicexternalresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .

# Elim collects an external load index value for a dynamic external resource
hpc:collectsLoadIndexValue rdf:Property ;
    rdfs:domain hpc:Elimexecutable ;
    rdfs:range hpc:Dynamicexternalresource .
