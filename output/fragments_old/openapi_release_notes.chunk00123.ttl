                 rdfs:range xsd:anyURI .

hpc:hasSchema a owl:ObjectProperty .
hpc:hasSchema rdfs:domain hpc:AssociationResponse ;
              rdfs:range rdf:Resource .

hpc:hasSchemaRef a owl:ObjectProperty .
hpc:hasSchemaRef rdfs:domain hpc:AssociationResponse ;
                rdfs:range rdf:Resource .
