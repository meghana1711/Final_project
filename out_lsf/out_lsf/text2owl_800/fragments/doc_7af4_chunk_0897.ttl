hpc:Lsfdatamanageradmin a owl:Class .
hpc:Lsfclusteradmin a owl:Class .
hpc:Lsfadminuser a owl:Class .
hpc:Rootuser a owl:Class .
hpc:hasLSFClusterAdmin rdf:type owl:ObjectProperty .
hpc:hasLSFAdminUser rdf:type owl:ObjectProperty .
hpc:hasLSFDataManagerAdmin rdf:type owl:ObjectProperty .
hpc:isLSFDataManagerAdminFor rdf:type owl:ObjectProperty .
hpc:isNotRootUser rdf:type owl:ObjectProperty .
hpc:CACHE_ACCESS_CONTROL rdf:type owl:DatatypeProperty .
hpc:CACHE_ACCESS_CONTROL_Y rdf:type xsd:string .
hpc:CACHE_ACCESS_CONTROL_N rdf:type xsd:string .
hpc:CACHE_ACCESSIBLE_FILES rdf:type owl:DatatypeProperty .
hpc:CACHE_ACCESSIBLE_FILES_Y rdf:type xsd:string .
hpc:CACHE_ACCESSIBLE_FILES_N rdf:type xsd:string .
hpc:Lsfdatamanageradmin rdfs:subClassOf rdf:Resource .
hpc:Lsfclusteradmin rdfs:subClassOf rdf:Resource .
hpc:Lsfadminuser rdfs:subClassOf rdf:Resource .
hpc:Rootuser rdfs:subClassOf rdf:Resource .
hpc:Haslsfclusteradmin rdfs:domain hpc:Lsfdatamanageradmin ;
                             rdfs:range hpc:Lsfclusteradmin .
hpc:Haslsfadminuser rdfs:domain hpc:Lsfdatamanageradmin ;
                             rdfs:range hpc:Lsfadminuser .
hpc:Haslsfdatamanageradmin rdfs:domain hpc:Lsfdatamanageradmin ;
                             rdfs:range hpc:Lsfdatamanageradmin .
hpc:Islsfdatamanageradminfor rdfs:domain hpc:Lsfdatamanageradmin ;
                             rdfs:range rdf:Resource .
hpc:Isnotrootuser rdfs:domain hpc:Rootuser ;
                      rdfs:range xsd:boolean .
hpc:CacheAccessControl rdfs:domain hpc:Lsfdatamanageradmin ;
                          rdfs:range xsd:string .
hpc:CacheAccessibleFiles rdfs:domain hpc:Lsfdatamanageradmin ;
                            rdfs:range xsd:string .
