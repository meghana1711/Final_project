@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Syncookieconfig a owl:Class .
hpc:hassyncookievalue a owl:DatatypeProperty .
hpc:Syncookieconfig rdfs:subClassOf owl:Class .
hpc:Hassyncookievalue rdfs:domain hpc:Syncookieconfig .
hpc:Hassyncookievalue rdf:range xsd:integer .
hpc:SyncookieConfig rdf:value "1" hpc:hasSyncookieValue .

hpc:Synackretriesconfig a owl:Class .
hpc:hassynackretries a owl:DatatypeProperty .
hpc:Synackretriesconfig rdfs:subClassOf
