hpc:Job a owl:Class .
hpc:Adminqueue a owl:Class .
hpc:Priorityqueue a owl:Class .
hpc:Awsinstance a owl:Class .

hpc:Hasjob hpc:objectproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Adminqueue .

hpc:Pendingtime hpc:datatypeproperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:minute .

hpc:Adminqueuethreshold hpc:objectproperty ;
    rdfs:domain hpc:Adminqueue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Cloudenabled hpc:datatypeproperty ;
    rdfs:domain hpc:Priorityqueue ;
    rdfs:range xsd:boolean .

hpc:Burstingallowed hpc:functionalproperty ;
    rdfs:domain hpc:Adminqueue ;
    rdfs:range xsd:boolean .

hpc:Policy a owl:Class .
hpc:Maxnumber hpc:datatypeproperty ;
    rdfs:domain hpc:Policy ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Stepvalue hpc:datatypeproperty ;
    rdfs:domain hpc:Policy ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Globalpolicya1 rdfs:subClassOf hpc:Policy .
hpc:Projectpolicya2 rdfs:subClassOf hpc:Policy .

hpc:Adminqueue rdfs:subClassOf hpc:Queue .
hpc:Queue a owl:Class .

hpc:Hasinstance hpc:objectproperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range hpc:Adminqueue .

hpc:Launchedat hpc:datatypeproperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:dateTime .

