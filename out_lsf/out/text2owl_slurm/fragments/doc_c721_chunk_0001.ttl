hpc:Account a owl:Class .
hpc:Subaccount a owl:Class .
hpc:Parentaccount a owl:Class .
hpc:Grandparentaccount a owl:Class .

hpc:normalizedshare a owl:ObjectProperty .
hpc:Usershare rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .
hpc:Siblings rdfs:domain hpc:Account ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Accountshare rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .
hpc:Siblingaccounts rdfs:domain hpc:Account ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Parentshare rdfs:domain hpc:Parentaccount ;
    rdfs:range xsd:decimal .
hpc:Parentsiblings rdfs:domain hpc:Parentaccount ;
    rdfs:range xsd:nonNegativeInteger .

hpc:normalizedusage a owl:ObjectProperty .
hpc:Userusage rdfs:domain hpc:Account ;
    rdfs:range xsd:decimal .
hpc:Totalusage rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:halflifefactor a owl:DatatypeProperty .
hpc:Halflife rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:Account rdfs:subClassOf hpc:Parentaccount .
hpc:Subaccount rdfs:subClassOf hpc:Account .
hpc:Parentaccount rdfs:subClassOf hpc:Grandparentaccount .
