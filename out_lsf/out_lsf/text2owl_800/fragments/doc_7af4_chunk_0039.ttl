hpc:Hostname a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Current host name." .

hpc:numkvp a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range xsd:integer .

hpc:key a owl:DatatypeProperty ;
    rdfs:domain hpc:Numkvp ;
    rdfs:range xsd:string ;
    rdfs:comment "Reserved for future use." .

hpc:value a owl:DatatypeProperty ;
    rdfs:domain hpc:Numkvp ;
    rdfs:range xsd:string ;
    rdfs:comment "Reserved for future use." .

hpc:storageinfoc a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range xsd:integer .

hpc:storageinfov a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range xsd:nonNegativeInteger .

hpc:finishkvp a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range () ;
    rdfs:comment "Nothing is logged to the record for this value if the last field value is 0." .

hpc:numkvp1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Finishkvp ;
    rdfs:range xsd:integer .

hpc:key1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Numkvp1 ;
    rdfs:range xsd:string ;
    rdfs:comment "Reserved for future use." .

hpc:value1 a owl:DatatypeProperty ;
    rdfs:domain hpc:Numkvp1 ;
    rdfs:range xsd:string ;
    rdfs:comment "Reserved for future use." .

hpc:schedulingoverhead a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostname ;
    rdfs:range xsd:float .

hpc:eventtype a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventadrsvfinish ;
    rdfs:range xsd:string .

hpc:versionnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventadrsvfinish ;
    rdfs:range xsd:string .

hpc:eventloggingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventadrsvfinish ;
    rdfs:range xsd:integer .

hpc:reservationcreationtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventadrsvfinish ;
    rdfs:range xsd:integer .

hpc:Eventadrsvfinish a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .
