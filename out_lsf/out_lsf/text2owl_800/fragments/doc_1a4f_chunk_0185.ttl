hpc:Command a owl:Class .
hpc:select a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Selectionstring .

hpc:order a owl:ObjectProperty ;
    rdfs:domain hpc:Command .

hpc:rusage a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Usagestring .

hpc:Load a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Hostselection a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Loadadjustment a owl:Class ;
    rdfs:subClassOf hpc:Rusage .

hpc:Place a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:subClassOf hpc:Hostselection ;
    rdfs:subClassOf hpc:Loadadjustment .

hpc:span a owl:ObjectProperty ;
    rdfs:domain hpc:Place .

hpc:same a owl:ObjectProperty ;
    rdfs:domain hpc:Place .

hpc:cu a owl:ObjectProperty ;
    rdfs:domain hpc:Place .

hpc:affinity a owl:ObjectProperty ;
    rdfs:domain hpc:Place .

hpc:Bsub a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Bmod a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Multiplesections a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Section a owl:Class ;
    rdfs:subClassOf hpc:Multiplesections ;
    rdfs:subClassOf hpc:Command ;
    owl:disjointWith hpc:Place .

hpc:selection a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:ordering a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:rusageadjustment a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:spanning a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:samehost a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:cpurequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:affinityrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Section .

hpc:blankspace a owl:DatatypeProperty ;
    rdfs:range xsd:string .
