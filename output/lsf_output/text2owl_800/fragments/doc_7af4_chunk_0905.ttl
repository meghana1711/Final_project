hpc:Cluster a owl:Class .
hpc:Datatransfernode a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Mountedstagingarea a owl:Class .
hpc:Datamanager a owl:Class .
hpc:Datamanagerhost a owl:Class .
hpc:Datatransferqueue a owl:Class .
hpc:hasstagingarea a owl:ObjectProperty .
hpc:hasmountedstagingarea a owl:ObjectProperty .
hpc:hasdatatransferqueue a owl:ObjectProperty .
hpc:hasreadwriteaccess a owl:ObjectProperty .
hpc:canreachdatalocation a owl:ObjectProperty .
hpc:mountedatsamelocation a owl:ObjectProperty .
hpc:stagingareaexists a owl:DatatypeProperty .
hpc:datamanagerrestarted a owl:DatatypeProperty .
hpc:Datasourcelocation rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:string .
hpc:Datadestinationlocation rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:string .
hpc:Stagingarea rdfs:range hpc:Mountedstagingarea .
hpc:Mountedstagingarea rdfs:range hpc:Stagingarea .
hpc:Datamanagerhost rdfs:subClassOf hpc:Datatransfernode ;
    rdfs:subClassOf hpc:Node .
hpc:Datatransferqueue rdfs:domain hpc:Datatransfernode .
hpc:Hasstagingarea rdfs:domain hpc:Datamanagerhost ;
    rdfs:range hpc:Mountedstagingarea .
hpc:Hasmountedstagingarea rdfs:domain hpc:Datamanagerhost ;
    rdfs:range hpc:Mountedstagingarea .
hpc:Hasdatatransferqueue rdfs:domain hpc:Datamanagerhost ;
    rdfs:range hpc:Datatransferqueue .
hpc:Hasreadwriteaccess rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:boolean .
hpc:Canreachdatalocation rdfs:domain hpc:Datatransfernode ;
    rdfs:range xsd:boolean .
hpc:Mountedatsamelocation rdfs:domain hpc:Datamanagerhost ;
    rdfs:range hpc:Datamanagerhost .
hpc:Stagingareaexists rdfs:domain hpc:Stagingarea ;
    rdfs:range xsd:boolean .
hpc:Datamanagerrestarted rdfs:domain hpc:Datamanager ;
    rdfs:range xsd:boolean .
