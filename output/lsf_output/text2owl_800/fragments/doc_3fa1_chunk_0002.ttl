hpc:Jobsubmission a owl:Class .
hpc:Applicationprofile rdfs:subClassOf hpc:Jobsubmission .
hpc:Queue rdfs:subClassOf hpc:Jobsubmission .
hpc:containerparametersetting a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Parametersetting .
hpc:execdriverparametersetting a owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Parametersetting .
hpc:queueparametersetting a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Parametersetting .
hpc:Parametersetting a owl:Class .
hpc:Imagenamespecification a owl:Class .
hpc:lsbcontainerimage a owl:DatatypeProperty ;
    rdfs:domain hpc:Imagenamespecification ;
    rdfs:range xsd:string .
hpc:environmentvariablesetting a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Environmentvariable .
hpc:Esubscript a owl:Class .
hpc:Jobpack a owl:Class .
