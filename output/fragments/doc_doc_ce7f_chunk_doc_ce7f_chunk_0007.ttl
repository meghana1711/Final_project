hpc:LoginNode a owl:Class .
hpc:SubmitHost rdf:type owl:EquivalentClass ;
    rdfs:subClassOf hpc:LoginNode .

hpc:SlurmClientCommand rdf:type owl:Class .
hpc:LoginNode rdfs:subClassOf owl:Class ;
    rdfs:subClassOf (hpc:LoginNode rdf:type owl:Restriction ;
        rdfs:onProperty hpc:hasSlurmClientCommand ;
        rdfs:allValuesFrom hpc:SlurmClientCommand) .

hpc:SlurmConf rdf:type owl:Class .
hpc:LoginNode rdfs:subClassOf owl:Class ;
    rdfs:subClassOf (hpc:LoginNode rdf:type owl:Restriction ;
        rdfs:onProperty hpc:hasSlurmConf) .

hpc:AuthenticationMethod rdf:type owl:Class .
hpc:LoginNode rdfs:subClassOf owl:Class ;
    rdfs:subClassOf (hpc:LoginNode rdf:type owl:Restriction ;
        rdfs:onProperty hpc:usesAuthenticationMethod) .

hpc:JobScheduling rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LoginNode ;
    rdfs:range xsd:boolean .

hpc:ComputationallyDemandingWork rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LoginNode ;
    rdfs:range xsd:boolean .

hpc:SlurmRestd rdf:type owl:Class .
hpc:SlurmRestd rdf:type owl:EquivalentClass ;
    rdf:type owl:Restriction ;
    rdfs:onProperty hpc:isSlurmRestd .

hpc:SlurmRestdRunMode rdf:type owl:Enum ;
    rdfs:subClassOf owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmRestd .
hpc:SlurmRestdRunMode "traditionalUnixService" .
hpc:SlurmRestdRunMode "InetService" .
```
