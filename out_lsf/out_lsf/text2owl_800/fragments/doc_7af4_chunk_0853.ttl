hpc:EgoMasterList a owl:Class .
hpc:LsfMasterList a owl:Class .
hpc:EgoConf a owl:Class .
hpc:LsfConf a owl:Class .
hpc:Lim a owl:Class .
hpc:management_host rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range hpc:Lim .
hpc:server_host rdf:type owl:Class .
hpc:non_management_host rdf:type owl:Class .
hpc:configuration_mismatch_warning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:string .
hpc:LSF_SERVER_HOSTS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ServerHost ;
    rdfs:range hpc:Lim .
hpc:LSF_LIM_IGNORE_CHECKSUM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:boolean .
hpc:LSF_ADD_CLIENTS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:ServerHost ;
    rdfs:range xsd:boolean .
hpc:EGO_MASTER_LIST_defined_in_ego_conf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:EgoMasterList ;
    rdfs:range hpc:EgoConf .
hpc:LSF_MASTER_LIST_defined_in_lsf_conf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfMasterList ;
    rdfs:range hpc:LsfConf .
hpc:EGO_MASTER_LIST_takes_precedence rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:EgoMasterList ;
    rdfs:range hpc:LsfMasterList .
hpc:LSF_MASTER_LIST_and_EGO_MASTER_LIST_values_match rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfMasterList ;
    rdfs:range hpc:EgoMasterList .
hpc:EGO_disabled rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:EgoMasterList ;
    rdfs:range hpc:LsfConf .
hpc:reconfigured_cluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range hpc:Lim .
