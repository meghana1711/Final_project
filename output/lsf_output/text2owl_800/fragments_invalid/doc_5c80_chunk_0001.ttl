hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Returns job output, job error, and job information to the submission host through email." .

hpc:Jobreport a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job report is sent by email to the LSF client and includes the following information: Job information such as: CPU use, Memory use, Name of the account that submitted the job, Job output, Errors." .

hpc:Submittingjob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Submitting jobs (bsub)" .

hpc:Modifypendingjobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Modify pending jobs (bmod)" .

hpc:Modifyrunningjobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Modify running jobs" .

hpc:Controllingjobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF controls jobs dispatched to a host to enforce scheduling policies or in response to user requests." .

hpc:Usinglsfwithnonsharedfilespace a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "About using LSF with non-shared file space" .

hpc:Aboutresourcereservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "About resource reservation" .

hpc:Setpendingtimelimits a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Set pending time limits" .

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Submittingjob ;
    rdfs:range hpc:Job ;
    rdfs:comment "Submit a job (bsub)" .

hpc:bsubOptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Bsub ;
    rdfs:range xsd:string ;
    rdfs:comment "Options for the bsub command" .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job in the LSF system" .
    rdfs:subClassOf hpc:Submittingjob ;
    rdfs:subClassOf hpc:Controllingjobs ;
    rdfs:subClassOf hpc:Jobreport ;

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The ID of the job" .

hpc:jobqueue a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The queue the job is submitted to" .

hpc:JobExecutionHost a owl:
