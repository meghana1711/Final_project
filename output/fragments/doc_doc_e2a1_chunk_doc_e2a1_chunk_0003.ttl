hpc:Slurmd a owl:Class .
hpc:SlurmdPort a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:integer .

hpc:SrunPortRange a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:integer .

hpc:SlurmctldCommunication a owl:Class .
hpc:SlurmctldPort a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmctldCommunication ;
    rdfs:range xsd:integer .

hpc:ClientCommand a owl:Class ;
    rdfs:subClassOf hpc:SlurmctldCommunication .

hpc:Salloc rdf:type hpc:ClientCommand .
hpc:SacctMgr rdf:type hpc:ClientCommand .
hpc:Sbatch rdf:type hpc:ClientCommand .
hpc:Sbcast rdf:type hpc:ClientCommand .
hpc:Scancel rdf:type hpc:ClientCommand .
hpc:Scontrol rdf:type hpc:ClientCommand .
hpc:Sdiag rdf:type hpc:ClientCommand .
hpc:Sinfo rdf:type hpc:ClientCommand .
hpc:Sprio rdf:type hpc:ClientCommand .
hpc:Squeue rdf:type hpc:ClientCommand .
hpc:Sshare rdf:type hpc:ClientCommand .
hpc:Sstat rdf:type hpc:ClientCommand .
hpc:Strigger rdf:type hpc:ClientCommand .
hpc:Sview rdf:type hpc:ClientCommand .

hpc:SlurmdbCommunication a owl:Class .
hpc:SlurmdbPort a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmdbCommunication ;
    rdfs:range xsd:integer .

hpc:JobInformationCommand a owl:Class ;
    rdfs:subClassOf hpc:SlurmdbCommunication .

hpc:Sacct rdf:type hpc:JobInformationCommand .
hpc:SacctMgr rdf:type hpc:JobInformationCommand .
hpc:Sreport rdf:type hpc:JobInformationCommand .

hpc:JobAllocation a owl:Class .
hpc:StepCreate a owl:Class .
hpc:JobAllocationSequence a owl:Class ;
    rdfs:subClassOf owl:Sequence .

hpc:JobAllocationStep a owl:Class ;
    rdfs:subClassOf hpc:JobAllocationSequence .

hpc:JobAllocationStep1 a hpc:JobAllocationStep ;
    hpc:propName "sends job allocation request to slurmctld" .

hpc:JobAllocationStep2 a hpc:JobAllocationStep ;
    hpc:propName "grants allocation and returns details" .

hpc:JobAllocationStep3 a hpc:JobAllocationStep ;
    hpc:propName "sends step create request to slurmctld" .

