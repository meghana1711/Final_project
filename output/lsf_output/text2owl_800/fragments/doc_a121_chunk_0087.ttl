hpc:hasweight a owl:DatatypeProperty ;
    rdfs:domain hpc:Factor ;
    rdfs:range xsd:decimal .

hpc:haslimit a owl:ObjectProperty ;
    rdfs:domain hpc:Factor ;
    rdfs:range hpc:Limit .

hpc:Limit a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasFactor ;
                        owl:hasValue xsd:positiveDecimal ;
                        owl:allValuesFrom xsd:decimal ] .

hpc:hasgraceperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Factor ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ApsPriority a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasWeightedFactor ;
                        owl:allValuesFrom hpc:APS_PRIORITY_Value ] .

hpc:ApsPriorityValue a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasFactor ;
                        owl:hasValue xsd:decimal ] .

hpc:hasweightedfactor a owl:ObjectProperty .
