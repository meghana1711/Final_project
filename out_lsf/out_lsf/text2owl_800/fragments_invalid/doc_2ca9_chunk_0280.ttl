hpc:Lsfversion a owl:Class .
hpc:Fixpack11 rdfs:subClassOf hpc:Lsfversion .
hpc:Fixpack12 rdfs:subClassOf hpc:Lsfversion .

hpc:gpupreemption a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfversion ;
    rdfs:range hpc:Boolean .

hpc:kerberosuserimpersonation a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Boolean .

hpc:checksum a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Boolean .

hpc:querycommandauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Boolean .

hpc:dynamicmigscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:Boolean .

hpc:migallocationinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Fixpack11 ;
    rdfs:range hpc:String .

hpc:Deprecatedparameter a owl:Class .

hpc:LsbChunkRusage rdfs:subClassOf hpc:Deprecatedparameter .
