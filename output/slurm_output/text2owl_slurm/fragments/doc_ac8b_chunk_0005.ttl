hpc:Qosfactor a owl:Class.
hpc:Sitefactor a owl:Class.
hpc:Tresfactor a owl:Class.
hpc:Hassitefactor a owl:Class;
    rdfs:domain hpc:Sitefactor;
    rdfs:range hpc:Qosfactor.
hpc:Hastresfactor a owl:Class;
    rdfs:domain hpc:Tresfactor;
    rdfs:range hpc:Job.
hpc:Trestype a owl:Class.
hpc:fairsharefactor a owl:DatatypeProperty;
    rdfs:domain hpc:Job.
hpc:Fairsharefactor rdf:type owl:DatatypeProperty;
    rdfs:domain hpc:Job;
    rdfs:range xsd:float.
hpc:tresbillingweights a owl:ObjectProperty;
    rdfs:domain hpc:Partition;
    rdfs:range xsd:float.
