hpc:Linuxcgroup a owl:Class .
hpc:Pim a owl:Class .
hpc:Osjitter a owl:Class .
hpc:lsfcgroupfeature a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxcgroup ;
    rdfs:range hpc:Linuxcgroupfeature .
