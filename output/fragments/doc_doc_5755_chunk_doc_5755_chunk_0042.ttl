hpc:SlurmCluster a owl:Class .
hpc:SlurmNode a owl:Class .
hpc:SlurmJob a owl:Class .

hpc:hasNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmJob ;
    rdfs:range hpc:SlurmNode .

hpc:isInCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range hpc:SlurmCluster .

hpc:isRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:boolean .

hpc:isDrained rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:boolean .

hpc:hasState rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:string .

hpc:hasReason rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:string .

hpc:drainNode a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range hpc:SlurmNode .

hpc:stopSlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:string .

hpc:updateSlurmConf a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:string .

hpc:restartSlurmd a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmNode ;
    rdfs:range xsd:string .

hpc:startSlurmctld a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:string .

hpc:runScontrolReconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range xsd:string .

hpc:removeNodeFromCluster a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmController ;
    rdfs:range hpc:SlurmNode .
```
