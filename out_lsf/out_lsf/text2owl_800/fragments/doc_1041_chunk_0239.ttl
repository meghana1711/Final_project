hpc:Lsf a owl:Class ;
    rdfs:subClassOf hpc:Hpcresource ;
    rdfs:comment "Calculates historical run time using actual run time of finished jobs and a decay factor." .

hpc:historicalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:float ;
    rdfs:comment "The calculated historical run time." .

hpc:decayfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Historicalruntime ;
    rdfs:range xsd:float ;
    rdfs:comment "The decay factor for historical run time." .

hpc:HIST_HOURS a xsd:nonNegativeInteger ;
    rdfs:comment "The interval of time (in hours) that specifies the decay rate for recently used run time." .

hpc:wallclockruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:float ;
    rdfs:comment "The run time of running jobs." .

hpc:fairshareadjustment a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Adjustment ;
    rdfs:comment "The dynamic priority calculation adjustment made by the user-defined fair share plug-in." .

hpc:FairShareAdjustmentFactor a xsd:float ;
    rdfs:comment "The parameter that enables and weights the fair share adjustment." .

hpc:Files a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:comment "Reads lsb.hosts." .

hpc:Bugroup rdfs:subClassOf hpc:Files ;
    rdfs:comment "See also bugroup." .

hpc:Bmgroup rdfs:subClassOf hpc:Files ;
    rdfs:comment "See also bmgroup." .

hpc:Lsbhosts rdfs:subClassOf hpc:Files ;
    rdfs:comment "See also lsb.hosts." .

hpc:bimages a owl:ObjectProperty ;
    rdfs:domain hpc:Files ;
    rdfs:range hpc:Imageinfo ;
    rdfs:comment "Displays information on Docker container images." .

hpc:ImageReponame a xsd:string ;
    rdfs:comment "Name of the Docker image repository." .

hpc:ImageTagname a xsd:string ;
    rdfs:comment "Name of the Docker image tag." .

hpc:HostName a xsd:string ;
    rdfs:comment "Name of the host or host group." .

hpc:HostGroup a xsd:string ;
    rdfs:comment "Name of the host group." .

hpc:Adjustment a owl:Class ;
    rdfs:subClassOf hpc:Quantity ;
    rdfs:comment "Dynamic priority adjustment made by the user-defined fair share plug-in." .
