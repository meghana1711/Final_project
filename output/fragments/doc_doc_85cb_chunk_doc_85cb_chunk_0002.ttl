hpc:License a owl:Class .
hpc:LicenseName a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Total a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Used a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Free a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Reserved a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:Remote a owl:DatatypeProperty ;
    rdfs:domain hpc:License .

hpc:LicenseServer a owl:Class .

hpc:Server a owl:DatatypeProperty ;
    rdfs:domain hpc:LicenseServer .

hpc:ServerType a owl:DatatypeProperty ;
    rdfs:domain hpc:LicenseServer .

hpc:Integration a owl:Class .

hpc:ThirdPartyLicenseManager a owl:Class .

hpc:AutomaticLicenseManagement a owl:ObjectProperty ;
    rdfs:domain hpc:Integration ;
    rdfs:range hpc:LicenseServer .

hpc:Slurm a owl:Class .

hpc:SubmissionOption a owl:Class .

hpc:TRES a owl:Class .

hpc:AccountingStorageTRES a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm .
    rdfs:range hpc:TRES .

hpc:RequestedLicense a owl:Class .

hpc:Script a owl:Class .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Slurm .

hpc:TresPerTask a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:TRES .

hpc:Cluster a owl:Class .

hpc:Product a owl:Class .

hpc:LicensesPerCluster a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .
    rdfs:range hpc:Product .

hpc:LicensePercentage a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .
```
