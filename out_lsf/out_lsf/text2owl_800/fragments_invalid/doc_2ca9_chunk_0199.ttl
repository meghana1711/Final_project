    rdfs:domain hpc:Dcgmintegration ;
    rdfs:range xsd:string .

hpc:softlinkcreation a owl:ObjectProperty ;
    rdfs:domain hpc:Dcgmintegration ;
    rdfs:range xsd:string .

hpc:Globallimitscope a owl:Class .
hpc:LocalClusterScope a ows:ObjectProperty ;
    rdfs:domain hpc:Globallimitscope ;
    rdfs:range hpc:Cluster .

hpc:lsfstrictchecking a owl:ObjectProperty ;
    rdfs:domain hpc:Globallimitscope ;
    rdfs:range xsd:boolean .

hpc:Knownissue a owl:Class .
hpc:lsfversionupdate a owl:ObjectProperty ;
    rdfs:domain hpc:Knownissue ;
    rdfs:range xsd:string .

hpc:Xdrerror a owl:Class .
hpc:lsfjobstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Xdrerror ;
    rdfs:range xsd:string .

hpc:Externalauthentication a owl:Class .
hpc:nestednamespace a owl:ObjectProperty ;
    rdfs:domain hpc:Externalauthentication ;
    rdfs:range xsd:boolean .
