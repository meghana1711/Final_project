hpc:Help a owl:Class .
hpc:Subcommand a owl:Class .

hpc:Datamanagementsubcommand a owl:Class .
hpc:Filebasedcachequery a owl:Class .
hpc:Jobbasedcachequery a owl:Class .
hpc:Changegroupafterstageout a owl:Class .
hpc:Changegroupafterstagein a owl:Class .

hpc:bdatacache a owl:ObjectProperty .
hpc:Bdatacache rdfs:domain hpc:Filebasedcachequery ;
                 rdfs:domain hpc:Jobbasedcachequery ;
                 rdfs:range rdf:List ;
hpc:Bdatacache rdfs:range rdf:List ;
                 rdfs:range rdf:Property ;
                 rdfs:range rdf:Literal ;
hpc:Bdatacache rdfs:range xsd:string ;
hpc:Bdatacache rdfs:range xsd:anyURI ;
hpc:Bdatacache rdfs:range xsd:boolean ;

hpc:Dmd rdfs:range xsd:string ;

hpc:Hostname rdfs:range xsd:string ;
hpc:Absfilepath rdfs:range xsd:string ;

hpc:Jobid rdfs:range xsd:positiveInteger ;
hpc:Jobid rdfs:range xsd:anyURI ;
hpc:Jobid rdfs:range xsd:string ;

hpc:Clustername rdfs:range xsd:string ;

hpc:W rdfs:range xsd:boolean ;
hpc:L rdfs:range xsd:boolean ;

hpc:chgrp a owl:ObjectProperty .
hpc:Chgrp rdfs:domain hpc:Changegroupafterstageout ;
                 rdfs:domain hpc:Changegroupafterstagein .
hpc:Chgrp rdfs:range rdf:List ;
hpc:Chgrp rdfs:range rdf:Property ;
hpc:Chgrp rdfs:range xsd:string ;
hpc:Chgrp rdfs:range xsd:anyURI ;

hpc:Usergroupname rdfs:range xsd:string ;
