hpc:Job a owl:Class .
hpc:Applicationprofile a owl:Class .
hpc:Pendingjob a owl:Class .
hpc:Defaultapplicationprofile a owl:Class .

hpc:hasPendingJob an owl:ObjectProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range hpc:Pendingjob .

hpc:isDefaultApplicationProfile an owl:ObjectProperty ;
    rdfs:domain hpc:Defaultapplicationprofile ;
    rdfs:range hpc:Applicationprofile .

hpc:Lsbparams a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Lsbapplications a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:hasDefaultApplicationProfile an owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Defaultapplicationprofile .

hpc:DEFAULT_APPLICATION rdfs:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Applicationprofile .

hpc:DEFAULT_APPLICATION_NOT_EXISTS rdfs:Literal .

hpc:movePendingJobs an owl:ObjectProperty .
hpc:editLSBApplications an owl:ObjectProperty .
hpc:deleteOrCommentOut an owl:ObjectProperty .
hpc:saveChanges an owl:ObjectProperty .
hpc:reconfigureMBatchd an owl:ObjectProperty .
hpc:setDefaultApplication an owl:ObjectProperty .
hpc:logInAsLSFAdministrator an owl:ObjectProperty .
