hpc:UserAccountMapping
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The mapping between user accounts in different systems." .

hpc:Logout
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:User ] ;
    rdfs:range [ rdf:type rdf:XMLLiteral ] ;
    rdfs:comment "The action of logging out from an instance." .

hpc:Snapshot
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Instance ] ;
    rdfs:range [ rdf:type rdf:XMLLiteral ] ;
    rdfs:comment "The action of creating a snapshot for an instance." .

hpc:OpenStackInstanceSnapshot
    a owl:Class ;
    rdfs:subClassOf [ rdf:type hpc:Snapshot ] ;
    rdfs:comment "A snapshot of an OpenStack instance." .

hpc:AccessibleByProject
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Openstackinstancesnapshot ] ;
    rdfs:range [ rdf:type hpc:Lsfproject ] ;
    rdfs:comment "The LSF projects that can access the snapshot." .

hpc:OpenStackDNS
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "An OpenStack DNS server." .

hpc:OpenStackDNSServer
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Openstackdns ] ;
    rdfs:range [ rdf:type xsd:string ] ;
    rdfs:comment "The Linux host serving as the OpenStack DNS server." .

hpc:InstallDnsScript
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Openstackdnsserver ] ;
    rdfs:range [ rdf:type xsd:string ] ;
    rdfs:comment "The install_dns.sh script file on the OpenStack DNS server." .

hpc:OpenStackResourceConnector
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The LSF resource connector configuration for OpenStack." .

hpc:OpenStackAsResourceProvider
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:Lsfresourceconnector ] ;
    rdfs:range [ rdf:type xsd:boolean ] ;
    rdfs:comment "Indicates if OpenStack is configured as a resource provider." .

hpc:SubmitJob
    a owl:ObjectProperty ;
    rdfs:domain [ rdf:type hpc:User ] ;
    rdfs:range [ rdf:type hpc:Job ] ;
    rdfs:comment "The action of submitting a job
