hpc:Executioncluster a owl:Class .
hpc:Submissioncluster a owl:Class .
hpc:Datatransferqueue a owl:Class .
hpc:Remotequeue a owl:Class .
hpc:fileTransferCmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:string .
hpc:sndjobsTo a owl:ObjectProperty ;
    rdfs:domain hpc:Remotequeue ;
    rdfs:range hpc:Datatransferqueue .
hpc:rcvjobsFrom a owl:ObjectProperty ;
    rdfs:domain hpc:Submissioncluster ;
    rdfs:range (hpc:Executioncluster | hpc:Allclusters) .
hpc:LsbUsers a owl:Class .
hpc:Usermap a owl:Class ;
    rdfs:subClassOf hpc:LsbUsers .
hpc:local a owl:DatatypeProperty ;
    rdfs:domain hpc:Usermap .
hpc:remote a owl:DatatypeProperty ;
    rdfs:domain hpc:Usermap .
hpc:direction a owl:DatatypeProperty ;
    rdfs:domain hpc:Usermap .
hpc:Crossclusteruseraccountmapping a owl:Class .
hpc:crossclusteruseraccountmappinginibmspectrumlsfdatamanager a owl:ObjectProperty ;
    rdfs:domain hpc:Crossclusteruseraccountmapping .
hpc:LsfConf a owl:Class .
hpc:lsfDataHosts a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:lsfDataPort a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
hpc:lsbTimeDmd a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfConf .
