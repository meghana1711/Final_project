hpc:jobcontrolaction a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Commandaction .

hpc:Commandaction a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:CommandLine ;
                        owl:hasValue "/bin/sh -c" ;
                        owl:allValuesFrom xsd:string ] .

hpc:commandline a owl:DatatypeProperty ;
    rdfs:domain hpc:Commandaction .

hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:JobControls ;
                        owl:allValuesFrom ( hpc:Action ;
                                                owl:onProperty hpc:signal ) ] .

hpc:Action a owl:Class ;
    rdfs:subClassOf [ a owl:UnionOf ;
                        owl:members ( hpc:TerminateAction ;
                                        hpc:SuspendAction ) ] .

hpc:Terminateaction a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:signal ;
                        owl:hasValue hpc:TERMINATE ] .

hpc:Suspendaction a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:signal ;
                        owl:hasValue hpc:SUSPEND ] ;
    rdfs:subPropertyOf hpc:JobControlAction ;
    rdfs:domain hpc:Job ;

hpc:signal a owl:DatatypeProperty ;
    rdfs:domain hpc:Action .

hpc:jobpgids a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:jobpids a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

hpc:lsbSuspReasons a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspendaction .

hpc:lsbSuspSubreasons a owl:DatatypeProperty ;
    rdfs:domain hpc:Suspendaction .
