hpc:Step a owl:Class .

hpc:id a owl:DatatypeProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Step ID (Slurm job step ID)" .

hpc:stderr a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to stderr file" .

hpc:stderr_expanded a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Step stderr with expanded fields" .

hpc:stdin a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to stdin file" .

hpc:stdin_expanded a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Step stdin with expanded fields" .

hpc:stdout a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to stdout file" .

hpc:stdout_expanded a owl:ObjectProperty ;
    rdfs:domain hpc:Step ;
    rdfs:range xsd:string ;
    rdfs:comment "Step stdout with expanded fields" .

hpc:time a owl:Class ;
    rdfs:subClassOf hpc:Step .

hpc:end a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:int64 ;
    rdfs:comment "End time (UNIX timestamp)" .

hpc:limit a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Maximum run time in minutes (32 bit integer number with flags)" ;
    $ref "#/components/schemas/v0.0_43_uint32_no_val_struct" .

hpc:start a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:int64 ;
    rdfs:comment "Time execution began (UNIX timestamp)" .

hpc:UpdateNodeMsg a owl:Class .

hpc:resume_after a owl:DatatypeProperty ;
