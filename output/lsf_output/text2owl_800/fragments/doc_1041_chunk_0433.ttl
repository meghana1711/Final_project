hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:datarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .

hpc:Datafile a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Jobarrayelement a owl:Class ;
    rdfs:subClassOf hpc:Jobid .

hpc:modifydatarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .

hpc:Jobmodification a owl:Class ;
    rdfs:subClassOf hpc:Modifydatarequirement .

hpc:jobmodificationid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobmodification ;
    rdfs:range xsd:string .

hpc:Joberrorfile a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Cannotmodifyjoberrorfile a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .

hpc:Cannotmodifyremoterunningjob a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .

hpc:Cannotmodifyjobthatisalreadyforwarded a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .

hpc:Cannotmodifyrunningorfinishedjob a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .

hpc:Cannotmodifyjobthatisalreadyforwardedtoorfromanothercluster a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .

hpc:Jobdispatchedwithouterrorfile a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Cannotmodifynameofjoberrorfileforarunningjob a owl:Class ;
    rdfs:subClassOf hpc:Joberrorfile .
