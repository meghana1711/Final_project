hpc:Collector a owl:Class .
hpc:collectorname a owl:DatatypeProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range xsd:string .

hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Collector ;
    rdfs:range xsd:string .

hpc:Okstatus a owl:Class ;
    rdfs:subClassOf hpc:Status .

hpc:Partialokstatus a owl:Class ;
    rdfs:subClassOf hpc:Status .
