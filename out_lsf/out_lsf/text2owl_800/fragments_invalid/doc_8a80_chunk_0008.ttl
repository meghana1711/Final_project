hpc:Enableinteractive a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Used for project mode only. Default Not deﬁned." .

hpc:fastDispatch a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables fast dispatch project mode for the license feature, which increases license utilization for project licenses." .

hpc:FastDispatchSupportedParam a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The fast dispatch project mode supports the following parameters in the Feature section:" .

hpc:FastDispatchSupportedParam hpc:allocation ;
hpc:FastDispatchSupportedParam hpc:demandLimit ;
hpc:FastDispatchSupportedParam hpc:distribution ;
hpc:FastDispatchSupportedParam hpc:groupDistribution ;
hpc:FastDispatchSupportedParam hpc:lmLicenseName ;
hpc:FastDispatchSupportedParam hpc:lsFeaturePercentage ;
hpc:FastDispatchSupportedParam hpc:name ;
hpc:FastDispatchSupportedParam hpc:nonSharedDistribution ;
hpc:FastDispatchSupportedParam hpc:serviceDomains ;
hpc:FastDispatchSupportedParam hpc:workloadDistribution ;

hpc:FastDispatchNotSupportedParam a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Other parameters are not supported, including those that project mode supports, such as the following parameters:" .

hpc:FastDispatchNotSupportedParam hpc:accinuseIncludesOwnership ;
hpc:FastDispatchNotSupportedParam hpc:dynamic ;
hpc:FastDispatchNotSupportedParam hpc:group ;
hpc:FastDispatchNotSupportedParam hpc:localTo ;
hpc:FastDispatchNotSupportedParam hpc:lsActivePercentage ;

hpc:Licensefeature a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a license feature." .

hpc:Project a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a project." .

hpc:Feature a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a feature of a project." .

hpc:Parameter a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a parameter of a feature." .

hpc:hasFeature
