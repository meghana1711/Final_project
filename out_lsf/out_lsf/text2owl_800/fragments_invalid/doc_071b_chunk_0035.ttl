hpc:Hostmodel a owl:Class .
hpc:cpuperformance a owl:DatatypeProperty .
hpc:Cpu ncname xsd:string .
hpc:Ncpus xsd:nonNegativeInteger .
hpc:MaxMem xsd:string .
hpc:MaxSwp xsd:string .
