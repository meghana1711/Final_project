hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Attribute a owl:Class .
hpc:Subcommand a owl:Class .
hpc:Description rdfs:domain hpc:Attribute ;
                 rdfs:range xsd:string .
hpc:create a owl:ObjectProperty ;
                 rdfs:domain hpc:Subcommand ;
                 rdfs:range rdf:List .
hpc:HostName rdfs:domain hpc:Create ;
                 rdfs:range hpc:Host .
hpc:HostGroup rdfs:domain hpc:Create ;
                 rdfs:range hpc:Hostgroup .
hpc:Description rdfs:domain hpc:Create ;
                 rdfs:range xsd:string .
hpc:AttrName rdfs:domain hpc:Attribute ;
             rdfs:range xsd:string .
hpc:battr a hpc:Subcommand ;
          rdfs:subClassOf hpc:Subcommand .
hpc:Battr -h rdfs:subClassOf hpc:Subcommand ;
          rdfs:subClassOf hpc:Subcommand .
hpc:Battr -V rdfs:subClassOf hpc:Subcommand ;
          rdfs:subClassOf hpc:Subcommand .
