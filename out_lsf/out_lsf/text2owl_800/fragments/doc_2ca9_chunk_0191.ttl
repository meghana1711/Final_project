hpc:Fixcentral a owl:Class .
hpc:findproducttab a owl:ObjectProperty ;
    rdfs:domain hpc:Fixcentral ;
    rdfs:range hpc:Findproducttabinstance .
hpc:productselectorfield a owl:DatatypeProperty ;
    rdfs:domain hpc:Findproducttabinstance .
hpc:installedversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Fixcentral .
hpc:platform a owl:DatatypeProperty ;
    rdfs:domain hpc:Fixcentral .
hpc:selectproducttab a owl:ObjectProperty ;
    rdfs:domain hpc:Fixcentral ;
    rdfs:range hpc:Selectproducttabinstance .
hpc:Productgroup a owl:Class ;
    rdfs:subClassOf hpc:Fixcentral .
hpc:Spectrumcomputing a owl:Class ;
    rdfs:subClassOf hpc:Productgroup .
hpc:Linux a owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Linux64bit a hpc:Linux .
hpc:LinuxX86_64 a hpc:Linux .
hpc:LinuxPPC64LE a hpc:Linux .
hpc:Interimfix a owl:Class ;
    rdfs:subClassOf hpc:Fixcentral .
