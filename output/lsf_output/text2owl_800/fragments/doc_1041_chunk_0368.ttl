hpc:blinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range rdf:Resource ;
    rdfs:subPropertyOf hpc:hasInformation .

hpc:clustermode a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:Boolean ;
    rdfs:subPropertyOf hpc:BLInfo .

hpc:projectmode a owl:ObjectProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range rdf:Boolean ;
    rdfs:subPropertyOf hpc:BLInfo .

hpc:tokenname a owl:DatatypeProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:BLInfo .

hpc:distributiontype a owl:DatatypeProperty ;
    rdfs:domain hpc:Blinfo ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:BLInfo .

hpc:Featuregroup a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:Lsflicensescheduler a owl:Class .
