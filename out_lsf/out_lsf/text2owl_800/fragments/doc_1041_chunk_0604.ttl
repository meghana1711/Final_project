hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:datarequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Datafile .

hpc:Datafile a owl:Class ;
    rdfs:subClassOf hpc:Resource ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:subClassOf xsd:string .

hpc:Datagroup a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:subClassOf rdf:Seq ;
    rdfs:subClassOf xsd:string .

hpc:sanitycheck a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range hpc:Operation .

hpc:Operation a owl:Class .

hpc:accesscheck a owl:ObjectProperty ;
    rdfs:domain hpc:Sanitycheck ;
    rdfs:range hpc:Operation .

hpc:sizecheck a owl:ObjectProperty ;
    rdfs:domain hpc:Sanitycheck ;
    rdfs:range hpc:Operation .

hpc:modificationtimecheck a owl:ObjectProperty ;
    rdfs:domain hpc:Sanitycheck ;
    rdfs:range hpc:Operation .

hpc:hashgeneration a owl:ObjectProperty ;
    rdfs:domain hpc:Sanitycheck ;
    rdfs:range hpc:Operation .

hpc:datagroupspecification a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Datagroup .
