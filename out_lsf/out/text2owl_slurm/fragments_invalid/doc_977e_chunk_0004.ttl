hpc:Reservation a owl:Class.
hpc:User a owl:Class.
hpc:Account a owl:Class.
hpc:Node a owl:Class.
hpc:Core a owl:Class.
hpc:hasuser a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:User.
hpc:hasaccount a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:Account.
hpc:hasnode a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:Node.
hpc:hascore a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:Core.
hpc:starttime a owl:DatatypeProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range xsd:dateTime.
hpc:endtime a owl:DatatypeProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range xsd:dateTime.
hpc:duration a owl:Datatype
