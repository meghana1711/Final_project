hpc:Scontrol a owl:Class .
hpc:Sinfo a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:Slurmd a owl:Class .
hpc:Slurmdbd a owl:Class .
hpc:Sprio a owl:Class .
hpc:Squeue a owl:Class .
hpc:Sreport a owl:Class .
hpc:Srun a owl:Class .
hpc:Sstat a owl:Class .
hpc:Strigger a owl:Class .
hpc:Sview a owl:Class .
hpc:Sourcecodemanagement a owl:Class .

hpc:hasAdminTool rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Scontrol ;
 rdfs:range hpc:Scontrol .

hpc:hasUserCommand rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Scontrol, hpc:Sinfo, hpc:Sprio, hpc:Squeue, hpc:Srun, hpc:Sstat, hpc:Sview, hpc:Strigger ;
 rdfs:range hpc:Command .

hpc:isDaemon rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Slurmctld, hpc:Slurmd ;
 rdfs:range hpc:Daemon .

hpc:hasDatabase rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Slurmdbd ;
 rdfs:range hpc:Database .

hpc:hasUserCommandForJobPriority rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Squeue, hpc:Srun ;
 rdfs:range hpc:Command .

hpc:hasJobAccountingGather rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Sstat ;
 rdfs:range hpc:Jobaccountinggather .

hpc:hasEventTrigger rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Strigger ;
 rdfs:range hpc:Event .

hpc:hasSourceCodeManagement rdf:type owl:ObjectProperty ;
 rdfs:domain hpc:Sourcecodemanagement ;
 rdfs:range hpc:Sourcecodemanagement .

hpc:isInGithub rdf:type owl:DatatypeProperty ;
 rdfs:domain hpc:Sourcecodemanagement ;
 rdfs:range xsd:string .
