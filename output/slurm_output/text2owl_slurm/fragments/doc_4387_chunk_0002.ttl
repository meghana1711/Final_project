hpc:Jobcomptype a owl:Class .
hpc:jobcomploc a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomptype ;
    rdfs:range xsd:string .
hpc:Accountingstoragetype a owl:Class .
hpc:Jobacctgathertype a owl:Class .
hpc:Slurmdbd a owl:Class .
hpc:JobCompLocRequiredByJobCompType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomptype ;
    rdfs:range hpc:Jobcomploc .
hpc:RequiresAccountingStorageType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomptype ;
    rdfs:range hpc:Accountingstoragetype .
hpc:RequiresJobAcctGatherType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomptype ;
    rdfs:range hpc:Jobacctgathertype .
hpc:UsesSlurmDBD rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobcomptype ;
    rdfs:range hpc:Slurmdbd .
