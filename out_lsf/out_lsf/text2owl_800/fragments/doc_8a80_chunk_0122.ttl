hpc:Applicationstatus a owl:Class .
hpc:Applicationstatus rdfs:subClassOf owl:Class .

hpc:running a owl:ObjectProperty .
hpc:Running rdfs:domain hpc:Applicationstatus ;
    rdfs:range xsd:string .

hpc:initial a owl:ObjectProperty .
hpc:Initial rdfs:domain hpc:Applicationstatus ;
    rdfs:range xsd:string .

hpc:exit a owl:ObjectProperty .
hpc:Exit rdfs:domain hpc:Applicationstatus ;
    rdfs:range xsd:string .

hpc:Application a owl:Class .
hpc:Application rdfs:subClassOf owl:Class .

hpc:name a owl:DatatypeProperty .
hpc:Name rdfs:domain hpc:Application ;
    rdfs:range xsd:string .
