hpc:Fairsharescheduling a owl:Class .
hpc:Preemption a owl:Class .
hpc:Backfill a owl:Class .
hpc:Schedulinganddispatch a owl:Class .
hpc:jobschedulinginterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulinganddispatch ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobdispatchinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulinganddispatch ;
    rdfs:range xsd:nonNegativeInteger .
hpc:shortwaittimebetweendispatches a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulinganddispatch ;
    rdfs:range xsd:nonNegativeDuration .
hpc:Dispatchorder a owl:Class .
hpc:queuepriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchorder ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobsubmissionorder a owl:ObjectProperty ;
    rdfs:domain hpc:Dispatchorder ;
    rdfs:range hpc:Job .
hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Dispatchorder .
hpc:Job a owl:Class .
hpc:usershare a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharescheduling ;
    rdfs:range xsd:nonNegativeDecimal .
hpc:resourceusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Fairsharescheduling ;
    rdfs:range xsd:nonNegativeDecimal .
hpc:preemptionbehavior a owl:ObjectProperty ;
    rdfs:domain hpc:Preemption ;
    rdfs:range xsd:string .
hpc:Preemptibleresource a owl:Class ;
    rdfs:subClassOf hpc:Preemption .
hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf hpc:Preemptibleresource .
hpc:License a owl:Class ;
    rdfs:subClassOf hpc:Preemptibleresource .
hpc:Backfilling a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:backfillingallowed a owl:ObjectProperty ;
    rdfs:domain hpc:Backfilling ;
    rdfs:range xsd:boolean .
hpc:reservationtimeexpiry a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfilling ;
    rdfs:range xsd:dateTime .
