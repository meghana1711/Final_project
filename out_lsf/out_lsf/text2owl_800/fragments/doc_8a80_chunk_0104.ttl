hpc:Peak a owl:Class ;
    rdfs:subClassOf hpc:Licensestate ;
    rdfs:comment "The maximum of INUSE+RESERVE+OVER observed over the past 5 minutes." .

hpc:buffer a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The optional allocation buffer that is configured in the ALLOC_BUFFER parameter of the Feature section for WAN service domains." .

hpc:Free a owl:Class ;
    rdfs:subClassOf hpc:Licensestate ;
    rdfs:comment "The number of licenses the cluster has free." .

hpc:demand a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Numeric value that indicates the number of tokens that are required by each cluster." .

hpc:Feature a owl:Class ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:comment "The license name. This name appears only once for each feature." .

hpc:serviceDomain a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the service domain that provided the license." .

hpc:TotalInuse a owl:Class ;
    rdfs:subClassOf hpc:Licenseinuse ;
    rdfs:comment "The number of licenses in use by LSF License Scheduler projects." .

hpc:TotalReserve a owl:Class ;
    rdfs:subClassOf hpc:Licensereserve ;
    rdfs:comment "The number of licenses that are reserved for LSF License Scheduler projects." .
