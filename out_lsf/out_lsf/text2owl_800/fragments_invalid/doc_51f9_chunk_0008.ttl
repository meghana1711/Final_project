hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:spreadsToRacks ;
                        owl:hasValue moreThan 2 ;
                        owl:allValueFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:isOnRack ;
                        owl:hasValue lessThan 3 ] ;

hpc:spreadstoracks a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:isonrack a owl:ObjectProperty .
