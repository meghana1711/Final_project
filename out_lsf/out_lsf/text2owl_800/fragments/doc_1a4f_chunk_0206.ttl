hpc:Orderstring a owl:Class .

hpc:hasresource a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring ;
    rdfs:range rdf:List .

hpc:Resource a owl:Class .
hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource .

hpc:normalizedloadindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Orderstring ;
    rdfs:range xsd:decimal .

hpc:preferredcomputeunitorder a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring .

hpc:Okstate a owl:Class .
hpc:Notavailableforloadsharing a owl:Class ;
    rdfs:subClassOf hpc:Okstate .

hpc:sortfromrighttoleft a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring .

hpc:dropleastdesirable a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring .

hpc:sortbystatus a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring .

hpc:defaultorderreturnedbylsinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Orderstring .

hpc:preferredtakesprecedence a owl:ObjectProperty ;
    rdfs:domain hpc:Preferredcomputeunitorder .
