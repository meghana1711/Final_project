hpc:X11forwardingjob a owl:Class ;
    rdfs:subClassOf hpc:Hpcjob ;
    rdfs:comment "Jobs submitted with X11 forwarding." ;
    rdfs:label "X11ForwardingJob" ;
    hpc:canRunOn rdfs:Resource ;
    hpc:Canrunon rdfs:domain hpc:Host ;
    hpc:Canrunon rdfs:range xsd:string ;
    hpc:cannotBeCheckedOrModifiedBy esubs ;
    hpc:cannotBeUsedWith rdfs:Class ;
    hpc:Cannotbeusedwith rdfs:domain hpc:Job ;
    hpc:Cannotbeusedwith rdfs:range xsd:string ;
    hpc:cannotBeUsedWith rdfs:value "job arrays" ;
    hpc:cannotBeUsedWith rdfs:value "job chunks" ;
    hpc:cannotBeUsedWith rdfs:value "user account mapping" ;
    hpc:canOnlyRunOn rdfs:Class ;
    hpc:Canonlyrunon rdfs:domain hpc:Host ;
    hpc:Canonlyrunon rdfs:range xsd:string ;
    hpc:hasBenefit rdfs:Resource ;
    hpc:Hasbenefit rdfs:domain hpc:X11forwardingjob ;
    hpc:Hasbenefit rdfs:range rdfs:Literal ;
    hpc:hasDrawback rdfs:Resource ;
    hpc:Hasdrawback rdfs:domain hpc:X11forwardingjob ;
    hpc:Hasdrawback rdfs:range rdfs:Literal ;
    hpc:hasDependency rdfs:Resource ;
    hpc:Hasdependency rdfs:domain hpc:X11forwardingjob ;
    hpc:Hasdependency rdfs:range rdfs:Literal ;
    hpc:hasLimitation rdfs:Resource ;
    hpc:Haslimitation rdfs:domain hpc:X11forwardingjob ;
    hpc:Haslimitation rdfs:range rdfs:Literal ;
    hpc:requiresSSHInstalledOn rdfs:Class ;
    hpc:Requiressshinstalledon rdfs:domain hpc:X11serverhost ;
    hpc:Requiressshinstalledon rdfs:range hpc:Host ;
    hpc:requiresKeyGeneration rdfs:Class ;
    hpc:Requireskeygeneration rdfs:domain hpc:X11forwardingjob ;
    hpc:Requireskeygeneration rdfs:range rdfs:Resource ;
    hpc:requiresKeyAdditionToAuthorizedKeysFile rdfs:Class ;
    hpc:Requireskeyadditiontoauthorizedkeysfile rdfs:domain hpc:X11forwardingjob ;
    hpc:Requireskeyadditiontoauthorizedkeysfile rdfs:range rdfs:Resource ;
    hpc:requiresXDisplaySetting rdfs:Class ;
    hpc:Requiresxdisplaysetting rdfs:domain hpc:X11forwardingjob ;
    hpc:Requiresxdisplaysetting rdfs:range rdfs:Resource ;
    hpc:requires
