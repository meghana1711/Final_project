hpc:Job a owl:Class .
hpc:ZeroSizeJob a hpc:Job ;
    rdfs:subClassOf hpc:Job .

hpc:BurstBufferDirective a owl:Class .
hpc:JobArray a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:HeterogeneousJob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:PrivilegedUser a owl:Class .
hpc:SlurmOperator rdf:type hpc:PrivilegedUser .
hpc:Administrator rdf:type hpc:PrivilegedUser .

hpc:Component a owl:Class ;
    rdfs:subClassOf hpc:HeterogeneousJob .

hpc:BurstBufferHook a owl:Class .
hpc:BurstBufferHook rdfs:domain hpc:Component ;
    rdfs:range hpc:BurstBufferDirective .

hpc:CommandLineOption a owl:Class .
hpc:Salloc rdf:type hpc:CommandLineOption .
hpc:Sbatch rdf:type hpc:CommandLineOption .
hpc:Srun rdf:type hpc:CommandLineOption .

hpc:BurstBufferPlugin a owl:Class .
hpc:Behavior a owl:DatatypeProperty ;
    rdfs:domain hpc:CommandLineOption .

hpc:Datawarp a owl:Class .
hpc:DirectiveFormat a owl:DatatypeProperty ;
    rdfs:domain hpc:Datawarp .

hpc:PersistentBurstBuffer a owl:Class .
hpc:CanCreate rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PrivilegedUser .
hpc:CanDestroy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:PrivilegedUser .

hpc:BurstBufferConfFile a owl:Class .
hpc:BurstBufferOperations a owl:Class ;
    rdfs:subClassOf hpc:BurstBufferDirective .
```
