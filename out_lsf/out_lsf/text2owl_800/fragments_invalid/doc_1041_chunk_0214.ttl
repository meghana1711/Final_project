hpc:Hostgroup a owl:Class .
hpc:hostgroupstatus a owl:ObjectProperty .
hpc:okstatus a owl:DatatypeProperty .
hpc:unavailstatus a owl:DatatypeProperty .
hpc:unreachstatus a owl:DatatypeProperty .
hpc:busystatus a owl:DatatypeProperty .
hpc:closedstatus a owl:DatatypeProperty .
hpc:closedrcpstatus a owl:DatatypeProperty .
hpc:hostgroupStatusAndCount a owl:ObjectProperty .

hpc:Hostgroupstatus rdfs:domain hpc:Hostgroup .
hpc:Okstatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Unavailstatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Unreachstatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Busystatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Closedstatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:string .
hpc:Closedrcpstatus rdfs:domain hpc:Hostgroupstatus ;
                 rdfs:range xsd:string .
hpc:HostgroupStatusAndCount rdfs:domain hpc:Hostgroup .
                 rdfs:range hpc:Hostgroupstatus .

hpc:HostGroup_ok a hpc:HostGroupStatus ;
                 hpc:OkStatus "ok" .
hpc:HostGroup_closed a hpc:HostGroupStatus ;
                 hpc:ClosedStatus "closed" .
hpc:HostGroup_closed_RCP a hpc:HostGroupStatus ;
                 hpc:ClosedRCPStatus "closed_RC" .
