hpc:SlurmDBD a owl:Class .
hpc:SlurmAuthenticationPlugin rdf:type owl:Class .
hpc:SlurmAccountingStoragePlugin rdf:type owl:Class .
hpc:DataCaching rdf:type owl:ObjectProperty .
hpc:PendingRequestPrioritization rdf:type owl:ObjectProperty .
hpc:Association a owl:Class .
hpc:ClusterName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:BankAccount rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:User rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:SlurmPartition rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Association ;
    rdfs:range xsd:string .
hpc:SchedulingPolicy rdf:type owl:Class .
hpc:AccountingStorageEnforce rdf:type owl:ObjectProperty .
hpc:AccountingStorageEnforce_options a owl:Class .
hpc:AccountingStorageEnforce_associations rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SchedulingPolicy ;
    rdfs:range hpc:AccountingStorageEnforce_options .
hpc:AccountingStorageEnforce_limits rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SchedulingPolicy ;
    rdfs:range hpc:AccountingStorageEnforce_options .
hpc:EnforcementOption rdf:type owl:Class .
hpc:PreventUsersFromRunningJobs rdf:type hpc:EnforcementOption ;
    rdfs:label "Prevent users from running jobs if their association is not in the database." .
hpc:PreventUsersFromAccessingInvalidAccounts rdf:type hpc:EnforcementOption ;
    rdfs:label "Prevent users from accessing invalid accounts." .
hpc:EnforceLimits rdf:type hpc:EnforcementOption .
