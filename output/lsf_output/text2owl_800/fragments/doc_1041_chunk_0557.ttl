hpc:filesize a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:decimal .

hpc:modifieddate a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:dateTime .

hpc:Datafile a owl:Class .

hpc:Localfile a owl:Class ;
    rdfs:subClassOf hpc:Datafile .

hpc:Remotefile a owl:Class ;
    rdfs:subClassOf hpc:Datafile .

hpc:datahost a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range rdf:Resource .

hpc:src a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Literal .

hpc:dst a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:Job a owl:Class .

hpc:Recursivedirectory a owl:Class ;
    rdfs:subClassOf hpc:Datafile .
