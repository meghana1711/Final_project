hpc:defaultresourceorder a owl:ObjectProperty .
hpc:Defaultresourceorder rdfs:domain hpc:Resourcerequirement .
hpc:Defaultresourceorder rdfs:range xsd:string .

hpc:defaultresourceordervalue a owl:DatatypeProperty .
hpc:Defaultresourceordervalue rdfs:domain hpc:Defaultresourceorder .
hpc:Defaultresourceordervalue rdfs:range xsd:nonNegativeInteger .

hpc:defaultslavelocity a owl:ObjectProperty .
hpc:Defaultslavelocity rdfs:domain hpc:Slascheduler .
hpc:Defaultslavelocity rdfs:range xsd:nonNegativeInteger .

hpc:defaultusergroup a owl:ObjectProperty .
hpc:Defaultusergroup rdfs:domain hpc:Jobsubmission .
hpc:Defaultusergroup rdfs:range xsd:string .

hpc:Resourcerequirement a owl:Class .
hpc:Slascheduler a owl:Class .
hpc:Jobsubmission a owl:Class .
