hpc:User a owl:Class .
hpc:Account a owl:Class .
hpc:hasshare a owl:ObjectProperty .
hpc:normalizedshare a owl:DatatypeProperty .

hpc:Account rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .

hpc:Hasshare rdfs:domain hpc:User ;
          rdfs:domain hpc:Account ;
          rdfs:range xsd:decimal .

hpc:Normalizedshare rdfs:domain hpc:User ;
          rdfs:range xsd:decimal .

hpc:Account hpc:hasshare hpc:B ;
           hpc:Hasshare hpc:c .
hpc:C hpc:hasshare hpc:User2 ;
     hpc:Hasshare hpc:user3 .
hpc:E hpc:hasshare hpc:User4 .
hpc:F hpc:hasshare hpc:User5 .
hpc:A hpc:normalizedshare xsd:0.4 .
hpc:B hpc:normalizedshare xsd:0.3 .
