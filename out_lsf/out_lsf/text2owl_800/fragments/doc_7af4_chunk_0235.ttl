hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range xsd:string .

hpc:hasmember a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Host .

hpc:hasadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:User .

hpc:Host a owl:Class .

hpc:GroupA a hpc:HostGroup ;
    hpc:hasName "all" ;
    hpc:hasAdmin "clusterAdmin" .

hpc:GroupB a hpc:HostGroup ;
    hpc:hasName "(groupA ~hostA ~hostB)" ;
    hpc:hasAdmin "user11" ;
    hpc:hasAdmin "user14" ;
    hpc:hasMember "hostF" ;
    hpc:hasMember "hostK" .

hpc:GroupC a hpc:HostGroup ;
    hpc:hasName "(hostX hostY hostZ)" ;
    hpc:hasAdmin "clusterAdmin" .

hpc:GroupD a hpc:HostGroup ;
    hpc:hasName "(groupC ~hostX)" ;
    hpc:hasAdmin "usergroupB" .

hpc:GroupE a hpc:HostGroup ;
    hpc:hasName "(all ~groupC ~hostB)" ;
    hpc:hasAdmin "clusterAdmin" .

hpc:GroupF a hpc:HostGroup ;
    hpc:hasName "(hostF groupC hostK)" ;
    hpc:hasAdmin "clusterAdmin" .

hpc:CONDENSE a hpc:HostGroup .
hpc:n a owl:ObjectProperty ;
    rdfs:domain hpc:Condense ;
    rdfs:range xsd:string .
hpc:y a owl:ObjectProperty ;
    rdfs:domain hpc:Condense ;
    rdfs:range xsd:string .

hpc:GroupA_CONDENSE a hpc:CONDENSE ;
    hpc:N "all" .

hpc:GroupB_CONDENSE a hpc:CONDENSE ;
    hpc:N "hostA, hostB" ;
    hpc:hasMember "hostA" ;
    hpc:hasMember "hostB" ;
    hpc:Y "usergroupC" ;
    hpc:hasAdmin "user1" .

hpc:GroupC_CONDENSE a hpc:CONDENSE ;
    hpc:Y "all" .
