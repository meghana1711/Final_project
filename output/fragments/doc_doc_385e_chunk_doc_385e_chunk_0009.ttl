hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:NodeList a owl:Class .
hpc:Node a owl:Class .
hpc:JobPartition a owl:Class ;
    rdfs:subClassOf hpc:Partition ;
    rdfs:domain hpc:Job .

hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobPartition .

hpc:getName a owl:ObjectProperty ;
    rdfs:domain hpc:JobPartition ;
    rdfs:range xsd:string .

hpc:hasUser a owl:ObjectProperty ;
    rdfs:domain hpc:JobPartition ;
    rdfs:range xsd:string .

hpc:hasStatus a owl:ObjectProperty ;
    rdfs:domain hpc:JobPartition ;
    rdfs:range xsd:string .

hpc:hasTime a owl:DatatypeProperty ;
    rdfs:domain hpc:JobPartition ;
    rdfs:range xsd:duration .

hpc:hasNodes a owl:ObjectProperty ;
    rdfs:domain hpc:JobPartition ;
    rdfs:range hpc:NodeList .

hpc:getNodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:NodeList .

hpc:isFinished a owl:ObjectProperty ;
    rdfs:domain hpc:Node .

hpc:LinuxNode a hpc:Node ;
    rdfs:subClassOf hpc:Node .
```
