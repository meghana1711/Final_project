hpc:Lsf a owl:Class .
hpc:Shifter a owl:Class .
hpc:dockerimageaffinity a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:usespurempienvironment a owl:ObjectProperty ;
    rdfs:domain hpc:Shifter .
hpc:requiresshifterinstallation a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Shifter .
hpc:accessibletoexecutionhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Shifter .
hpc:requirespreparedimages a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:bindsrequireddirectories a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:submitsshifterjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf .
hpc:Shifterapplicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
hpc:Shifterqueue a owl:Class ;
    rdfs:subClassOf hpc:Lsf .
