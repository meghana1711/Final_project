hpc:Printusageerror a owl:Class .
hpc:PrintReleaseVersionError a owsl:ThrownException .
hpc:Displayenergyawareschedulingpolicies a owl:Class .
hpc:Showpowerpolicysettings a owl:Class .
hpc:Guaranteedresourcepool a owl:Class .
hpc:poolname a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:Resources a owl:Class ;
    rdfs:subClassOf hpc:Guaranteedresourcepool .
hpc:Resources rdfs:subClassOf hpc:Hosts .
hpc:Resources rdfs:subClassOf hpc:Slots .
hpc:Resources rdfs:subClassOf hpc:Packages .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteedresourcepool ;
    rdfs:range xsd:string .
hpc:ok a xsd:string .
hpc:unknown a xsd:string .
hpc:overcommitted a xsd:string .
hpc:close_loans a xsd:string .
