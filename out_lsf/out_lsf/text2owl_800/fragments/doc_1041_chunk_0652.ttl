hpc:Jsdl a owl:Class .
hpc:Posixextension a owl:Class .
hpc:Lsfextension a owl:Class .

hpc:Jsdlfile a owl:Class .
hpc:Jsdlspecification a owl:Class .
hpc:Jsdlversion a owl:Class .
hpc:Validjsdlelement a owl:Class .
hpc:Posixextensionelement a owl:Class .
hpc:Lsfextensionelement a owl:Class .
hpc:Invalidjsdlelement a owl:Class .

hpc:submitjob a owl:ObjectProperty .
hpc:Usesstandardjsdlelementsandposixextensions rdfs:domain hpc:Submitjob ;
    rdfs:range hpc:Jsdlfile .

hpc:jsdlStrict a owl:ObjectProperty .
hpc:Verifiesvalidity rdfs:domain hpc:JsdlStrict ;
    rdfs:range hpc:Jsdlfile .

hpc:lsfextensionusage a owl:ObjectProperty .
hpc:Submitjob rdfs:domain hpc:Lsfextensionusage ;
    rdfs:range hpc:Jsdlfile .

hpc:Jsm a owl:Class .
hpc:daemon a owl:ObjectProperty .
hpc:Enablesordisables rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Jsm .

hpc:JSM_y a owl:NamedIndividual .
hpc:JSM_d a owl:NamedIndividual .
hpc:JSM_y rdf:type hpc:JSM ;
    hpc:Daemon hpc:jsmEnabled .
hpc:JSM_d rdf:type hpc:JSM ;
    hpc:Daemon hpc:jsmDebug .

hpc:jsmEnabled a owl:ObjectProperty .
hpc:Isenabledbydefault rdfs:domain hpc:Jsm ;
    rdfs:range hpc:JsmEnabled .

hpc:jsmDebug a owl:ObjectProperty .
hpc:Enablesdebugmode rdfs:domain hpc:Jsm ;
    rdfs:range hpc:JsmDebug .

hpc:JSM_enabled rdf:type hpc:Boolean .
hpc:JSM_debug rdf:type hpc:Boolean .

hpc:JsmEnabled rdfs:subClassOf xsd:boolean .
hpc:JsmDebug rdfs:subClassOf xsd:boolean .

hpc:Csm a owl:Class .
hpc:integrationpackage a owl:ObjectProperty .
hpc:Isforlsfjobsthatusejsrun rdfs:domain hpc:Integrationpackage ;
    rdfs:range hpc:Csm .

hpc:Conflictingjobsubmissionparameters a owl:Class .
hpc:Jobscriptoverrides rdfs:domain hpc:Conflictingjobsubmissionparameters ;
    rdfs:range hpc:Jobscript .

hpc:Jobscript a owl:Class .
