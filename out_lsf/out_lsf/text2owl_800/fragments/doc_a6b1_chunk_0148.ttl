hpc:Xdisplayhost a owl:Class .
hpc:Xapplication a owl:Class .
hpc:remoteshellconnection a owl:ObjectProperty .
hpc:Lsfcluster a owl:Class .
hpc:Clientsoftware a owl:Class .
hpc:displayhostselection a owl:ObjectProperty .
hpc:Leastloadedhost a owl:Class .
hpc:Exceed a owl:Class .
hpc:xstart a owl:ObjectProperty .
hpc:reexec a owl:ObjectProperty .
hpc:Xwindow a owl:Class .

hpc:Xdisplayhost rdfs:subClassOf owl:Class .
hpc:Xapplication rdfs:subClassOf owl:Class .
hpc:Remoteshellconnection rdfs:domain hpc:Clientsoftware ;
                                rdfs:range hpc:Xapplication .
hpc:Lsfcluster rdfs:subClassOf owl:Class .
hpc:Clientsoftware rdfs:subClassOf owl:Class .
hpc:Displayhostselection rdfs:domain hpc:Clientsoftware ;
                            rdfs:range hpc:Xdisplayhost .
hpc:Leastloadedhost rdfs:subClassOf hpc:Xdisplayhost .
hpc:Exceed rdfs:subClassOf owl:Class .
hpc:Xstart rdfs:domain hpc:Exceed ;
                      rdfs:range hpc:Reexec .
hpc:REEXEC rdfs:subPropertyOf hpc:RemoteShellConnection ;
                      rdfs:domain hpc:Clientsoftware ;
                      rdfs:range hpc:Xwindow .
hpc:Xwindow rdfs:subClassOf owl:Class .
