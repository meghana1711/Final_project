@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Taskprologscript a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Scripts that are executed by Slurm for job management." .

hpc:printsobject a owl:ObjectProperty ;
    rdfs:domain hpc:Taskprologscript ;
    rdfs:range xsd:string ;
    rdfs:comment "Property for messages printed to the job's standard output." .

hpc:exportsenvironmentvariable a owl:ObjectProperty ;
    rdfs:domain hpc:Taskprologscript ;
    rdfs:range xsd:string ;
    rdfs:comment "
