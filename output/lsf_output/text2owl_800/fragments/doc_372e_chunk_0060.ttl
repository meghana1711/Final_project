hpc:Failoverprovisioning a owl:Class .
hpc:Licensescheduler a owl:Class .
hpc:Lanfailoverprovisioning a owl:Class .
hpc:Wanfailoverprovisioning a owl:Class .
hpc:setupfailover a owl:ObjectProperty .

hpc:LSF_CONFDIR a rdfs:DatatypeProperty ;
  rdfs:domain hpc:Licensescheduler ;
  rdfs:range xsd:string .

hpc:lsfLicSchedHosts a owl:DatatypeProperty ;
  rdfs:domain hpc:LsfConfdir ;
  rdfs:range xsd:string .

hpc:hosts a owl:DatatypeProperty ;
  rdfs:domain hpc:Licensescheduler ;
  rdfs:range xsd:string .

hpc:preference a owl:ObjectProperty ;
  rdfs:domain hpc:LsfLicSchedHosts ;
  rdfs:range hpc:LsfLicSchedHosts .
