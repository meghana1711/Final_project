hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a reservation in the HPC system." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a job submitted with the brsvsub command." .

hpc:Resourceunit a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the type of resource being reserved (slot or host)." .

# Object Properties
hpc:hasreservationstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of the reservation." .

hpc:hascreator a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User ;
    rdfs:comment "The creator of the reservation." .

hpc:hasresourceunit a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Resourceunit ;
    rdfs:comment "The type of resource being reserved." .

hpc:hasdescription a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "A description of the reservation." .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Job ;
    rdfs:comment "The job associated with the reservation." .

hpc:hasresourcerequirementdetails a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource requirement details of the job." .

hpc:hasstarttime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The start time of the job." .

hpc:hasendtime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The end time of the job." .

hpc:hasstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The status of the job." .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:User ;
    rdfs:comment "The user or user group that has permission to use the reservation." .

hpc:hasncpus a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of CPU cores reserved." .

hpc:hasRSVHosts a o
