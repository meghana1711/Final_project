hpc:Blanchframework a owl:Class.
hpc:Resourceallocation a owl:Class.
hpc:Remotetask a owl:Class.
hpc:Validationrequest a owl:Class.
hpc:Host a owl:Class.
hpc:Terminatedtask a owl:Class.

hpc:hasresource a owl:ObjectProperty.
hpc:isrunningon a owl:ObjectProperty.
hpc:Hasadditionalresources rdfs:domain hpc:Validationrequest ;
                               rdfs:range hpc:Resourceallocation .
hpc:Hasreleasedresources rdfs:domain hpc:Validationrequest ;
                               rdfs:range hpc:Resourceallocation .
hpc:isonhost a owl:ObjectProperty.
hpc:isterminated a owl:ObjectProperty.
hpc:Hasgraceperiod xsd:nonNegativeInteger rdfs:range hpc:Remotetask .
hpc:hasnotifiedcommand a owl:ObjectProperty.
hpc:isresizablejob a owl:ObjectProperty.
hpc:usesblanchcommand a owl:ObjectProperty.
hpc:usesLsbgetAllocApi a
