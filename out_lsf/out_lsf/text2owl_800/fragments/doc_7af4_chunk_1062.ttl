hpc:LsfResources a owl:Class .
hpc:LSF_MASTER rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfResources ;
    rdfs:range hpc:LsfResources .
hpc:LSF_SUBMIT_TO_CLUSTER rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfResources ;
    rdfs:range xsd:string .
hpc:MELIM rdf:type owl:Class .
hpc:MELMELIMIM rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Melim .
hpc:elim rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Melim .
hpc:LSF_SUBMIT_TO_CLUSTER_DEFAULT a owl:NamedIndividual ;
    hpc:LSF_SUBMIT_TO_CLUSTER "not defined" .
hpc:LSF_TS_LOGON_TIME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfResources ;
    rdfs:range xsd:decimal .
