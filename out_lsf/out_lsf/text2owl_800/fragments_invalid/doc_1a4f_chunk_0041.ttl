hpc:Elim a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An executable that sends updated load information to the management host LIM." .

hpc:Managementhostlim a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A LIM that manages other LIMs." .

hpc:loadupdatestring a owl:DatatypeProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string ;
    rdfs:comment "The string that contains the updated load information." .

hpc:loadupdatefrequency a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The frequency at which the load update string is written." .

hpc:changedetection a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the elim should report new values only when a change is detected." .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A group of hosts in a LSF cluster." .

hpc:defaultresourcemapping a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Elim ;
    rdfs:comment "The default external resource mapped for the cluster." .

hpc:checkingheader a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range hpc:Elim ;
    rdfs:comment "A header that checks whether the elim is programmed to report values for the expected resources on the host." .

hpc:Overridableloadindex a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A load index that can be overridden by an elim executable." .

hpc:Builtinloadindex a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A load index defined by the system." .

hpc:Dynamicexternalresource a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An external resource that can be dynamically measured." .

hpc:overrideloadindex a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range hpc:Dynamicexternalresource ;
    rdfs:comment "The dynamic external resource that the elim is overriding." .

hpc:Jsdlsupport a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An elim that supports Job Submission Description Language (JSDL) files." .

hpc:operatingsystemname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jsdlsupport ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the operating system." .

hpc:OperatingSystemVersion a owl:Dat
