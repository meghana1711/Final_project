hpc:Job a owl:Class .
hpc:User a owl:Class .

hpc:dynamicpriority a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:historicalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:committedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:runtimedecayalgorithm a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Shortjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Longjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Runningjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Finishedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:decayingalgorithmforrunningjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Lsbevents a owl:Class .
hpc:Mbatchd a owl:Class .

hpc:cleanperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:nonNegativeInteger .

hpc:reconfigurationrestarteffectonhistoricalruntime a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd .
