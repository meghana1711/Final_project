hpc:Clearcasedrive a owl:Class .
hpc:hasDriveLetter rdf:Property ;
    rdfs:domain hpc:Clearcasedrive ;
    rdfs:range xsd:string .
hpc:isWindowsOnly rdf:Property ;
    rdfs:domain hpc:Clearcasedrive ;
    rdfs:range xsd:boolean .
hpc:Clearcasemountdir a owl:Class .
hpc:isUnixOnly rdf:Property ;
    rdfs:domain hpc:Clearcasemountdir ;
    rdfs:range xsd:boolean .
hpc:hasPath rdf:Property ;
    rdfs:domain hpc:Clearcasemountdir ;
    rdfs:range xsd:string .
hpc:Clearcaseroot a owl:Class .
hpc:isWindows rdf:Property ;
    rdfs:domain hpc:Clearcaseroot ;
    rdfs:range xsd:boolean .
hpc:hasAbsolutePath rdf:Property ;
    rdfs:domain hpc:Clearcaseroot ;
    rdfs:range xsd:string .
hpc:Daemonwrapdebug a owl:Class .
hpc:enablesDebugging rdf:Property ;
    rdfs:domain hpc:Daemonwrapdebug ;
    rdfs:range xsd:boolean .
