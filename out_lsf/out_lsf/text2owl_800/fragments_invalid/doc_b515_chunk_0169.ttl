hpc:Cumulativecputime a owl:Class ;
    rdfs:subClassOf hpc:Timemeasurement ;
    rdfs:comment "The cumulative CPU time used by the user (measured in hours)." .

hpc:Cumulativecputime rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:normalizedcumulativecputime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The actual (not normalized) CPU time used by the job." .

hpc:decayfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The decay factor used to calculate the cumulative CPU time." .

