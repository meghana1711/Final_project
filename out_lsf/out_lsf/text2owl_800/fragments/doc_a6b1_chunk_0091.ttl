hpc:Hostmodel a owl:Class .
hpc:modelname a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range xsd:string .
hpc:cpufactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range xsd:decimal .
hpc:architecture a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range xsd:string .
hpc:lsfshared a owl:ObjectProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range hpc:Lsfshared .
hpc:lsfconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range rdf:Statement .
hpc:badminreconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range rdf:Statement .
hpc:lsbparams a owl:ObjectProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range hpc:Lsbparams .
hpc:cleanperioddone a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:integer .
