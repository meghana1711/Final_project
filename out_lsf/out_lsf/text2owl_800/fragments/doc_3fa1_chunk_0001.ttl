hpc:Enrootjob a owl:Class .
hpc:bsub a owl:ObjectProperty .
hpc:Appprofile a owl:Class .
hpc:Queue a owl:Class .
hpc:container a owl:ObjectProperty .
hpc:execDriver a owl:DatatypeProperty .

hpc:Enrootjob rdfs:subClassOf hpc:Job .
hpc:Bsub rdfs:domain hpc:Enrootjob ;
    rdfs:range rdf:Statement .
hpc:Appprofile rdfs:subClassOf hpc:Applicationprofile .
hpc:Queue rdfs:subClassOf hpc:Queue .
hpc:Container rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:string .
hpc:ExecDriver rdfs:domain hpc:Enrootjob ;
    rdfs:range xsd:string .
