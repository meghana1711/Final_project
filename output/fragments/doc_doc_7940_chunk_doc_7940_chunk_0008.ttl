hpc:OriginClusterID a owl:DatatypeProperty .
hpc:LocalJobID a owl:DatatypeProperty .
hpc:SiblingJob a owl:Class .
hpc:Cluster a owl:Class .
hpc:CommunicatesWith a owl:ObjectProperty .
hpc:OriginatesFrom a owl:ObjectProperty .
hpc:SubmitsTo a owl:ObjectProperty .
hpc:DeterminesRunnability a owl:ObjectProperty .
hpc:OriginJob a owl:Class .
hpc:RevokedState a owl:Class .
hpc:ViableSibling a owl:Class .
hpc:ActiveSibling a owl:Class .

hpc:Cluster rdfs:subClassOf xsd:string .
hpc:OriginClusterID rdfs:domain hpc:SiblingJob ;
                      rdfs:range hpc:Cluster .
hpc:LocalJobID rdfs:domain hpc:OriginJob ;
                 rdfs:range xsd:string .
hpc:SiblingJob rdfs:subClassOf hpc:Cluster .
hpc:CommunicatesWith rdfs:domain hpc:OriginJob ;
                      rdfs:range hpc:Cluster .
hpc:OriginatesFrom rdfs:domain hpc:SiblingJob ;
                     rdfs:range hpc:Cluster .
hpc:SubmitsTo rdfs:domain hpc:OriginCluster ;
                 rdfs:range hpc:SiblingJob .
hpc:DeterminesRunnability rdfs:domain hpc:OriginCluster ;
                          rdfs:range hpc:SiblingJob .
hpc:OriginJob rdfs:subClassOf hpc:Cluster .
hpc:RevokedState rdfs:subClassOf owl:Class .
hpc:ViableSibling rdfs:subClassOf hpc:Cluster .
hpc:ActiveSibling rdfs:subClassOf hpc:SiblingJob .

hpc:RevokedState rdf:value "not actively being scheduled" .
hpc:RevokedState rdf:value "one of the sibling jobs is running on a remote cluster" .
hpc:ViableSibling rdf:value "eligible to run a sibling job" .
hpc:ActiveSibling rdf:value "actively has a sibling job and is able to schedule the job" .
```
