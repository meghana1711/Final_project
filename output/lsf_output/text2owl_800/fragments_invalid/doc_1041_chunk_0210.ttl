hpc:Host a owl:Class .
hpc:slotvalue a owl:DatatypeProperty .
hpc:dispatchwindow a owl:ObjectProperty .
hpc:PowerState a owl:Enum .
hpc:currentpowerusage a owl:DatatypeProperty .
hpc:totalenergyconsumed a owl:DatatypeProperty .
hpc:Attribute a owl:Class .
hpc:lockid a owl:ObjectProperty .
hpc:comment a owl:DatatypeProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Slotvalue rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Dispatchwindow rdfs:domain hpc:Host ;
    rdfs:range rdf:* .
hpc:Powerstate rdfs:subClassOf owl:Class ;
    rdfs:subClassOf xsd:string .
hpc:Currentpowerusage rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Totalenergyconsumed rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:Attribute rdfs:subClassOf owl:Class .
hpc:Lockid rdfs:domain hpc:Host ;
    rdfs:range rdf:* .
hpc:Comment rdfs:domain hpc:Lockid ;
    rdfs:range xsd:string .
