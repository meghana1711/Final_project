hpc:Vpc a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Virtual Private Cloud in IBM Cloud." .

hpc:Subnet a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Subnet in a VPC in IBM Cloud." .

hpc:createvpc a owl:ObjectProperty ;
    rdfs:domain hpc:Vpc ;
    rdfs:range hpc:Vpc ;
    rdfs:comment "Create a new VPC." .

hpc:createsubnet a owl:ObjectProperty ;
    rdfs:domain hpc:Vpc ;
    rdfs:range hpc:Subnet ;
    rdfs:comment "Create a new subnet for a VPC." .

hpc:specifydetails a owl:ObjectProperty ;
    rdfs:domain hpc:Createvpc ;
    rdfs:range xsd:string ;
    rdfs:comment "Specify the details for a new VPC." .

hpc:newsubnetforvpc a owl:ObjectProperty ;
    rdfs:domain hpc:Createsubnet ;
    rdfs:range hpc:Subnet ;
    rdfs:comment "Specify the details for a new subnet." .

hpc:location a owl:DatatypeProperty ;
    rdfs:domain hpc:Subnet ;
    rdfs:range xsd:string ;
    rdfs:comment "The location of the subnet, consisting of a region and a zone." .
