hpc:accountingstorageport a owl:DatatypeProperty;
    rdfs:domain hpc:Slurmdbd;
    rdfs:range xsd:integer.

hpc:accountingstoragetype a owl:ObjectProperty;
    rdfs:domain hpc:Slurmdbd;
    rdfs:range xsd:string.

hpc:clustername a owl:DatatypeProperty;
    rdfs:domain hpc:Slurmdbd;
    rdfs:range xsd:string.

hpc:trackwckey a owl:ObjectProperty;
    rdfs:domain hpc:Slurmdbd;
    rdfs:range xsd:boolean.

hpc:Slurmdbd a owl:Class.

hpc:authinfo a owl:ObjectProperty;
    rdfs:domain hpc:Slurmdbd;
    rdfs:range xsd:string.

hpc:Clustername rdfs:range "accounting_storage/slurmdbd"^^xsd:string.
