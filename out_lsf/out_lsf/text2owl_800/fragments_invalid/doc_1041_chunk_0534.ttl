hpc:Reservation a owl:Class .
hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Cluster a owl:Class .
hpc:Policy a owl:Class .

# Object Properties
hpc:hasreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Reservation .

hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range h time:Reservation .

hpc:isingroup a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Group .

hpc:isincluster a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster .

# Datatype Properties
hpc:policy a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string .

hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:date .

# Subclass Relations
hpc:Advancereservation a owl:Class ;
    rdfs:subClassOf hpc:Reservation .

hpc:Localreservation a owl:Class ;
    rdfs:subClassOf hpc:Advancereservation .

hpc:Remotereservation a owl:Class ;
    rdfs:subClassOf hpc:Advancereservation .

# Disjoint Classes (if applicable)
hpc:LocalReservation owl:disjointWith hpc:RemoteReservation .
