hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .
hpc:Project a owl:Class .
hpc:Queue a owl:Class .

hpc:Hasuser rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:Isonhost rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Belongstoproject rdfs:domain hpc:Job ;
    rdfs:range hpc:Project .

hpc:Isinqueue rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .

hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:totaljobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Throughputcalculation ;
    rdfs:range xsd:integer .

hpc:begintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Throughputcalculation ;
    rdfs:range xsd:dateTime .

hpc:endtimethroughput a owl:DatatypeProperty ;
    rdfs:domain hpc:Throughputcalculation ;
    rdfs:range xsd:dateTime .

hpc:Throughputcalculation a owl:Class .
hpc:Allsystemthroughput a owl:Class ;
    rdfs:subClassOf hpc:Throughputcalculation .
hpc:Hostthroughput a owl:Class ;
    rdfs:subClassOf hpc:Throughputcalculation .
hpc:Queuethroughput a owl:Class ;
    rdfs:subClassOf hpc:Throughputcalculation .
