hpc:Limacct a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The lim.acct file is the log file for the LSF Load Information Manager (LIM). The lim.acct file contains host load information that is collected and distributed by LIM." .

hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Limacct ;
    rdfs:range xsd:dateTime .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Limacct ;
    rdfs:range xsd:string .

hpc:hoststatus a owl:ObjectProperty ;
    rdfs:domain hpc:Limacct ;
    rdfs:range xsd:int .

hpc:loadindexnames a owl:DatatypeProperty ;
    rdfs:domain hpc:Limacct ;
    rdfs:range xsd:string .

hpc:loadindexvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Limacct ;
    rdfs:range xsd:float .

hpc:Lsbacct a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The lsb.acct file is the batch job log file of LSF." .
