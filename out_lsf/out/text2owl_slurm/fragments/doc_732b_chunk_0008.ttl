hpc:deny a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:allow a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:letthrough a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:disablex11 a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:denyconnection a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:turnoffx11forwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:Configurablevalue a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Default a xsd:integer ;
    rdfs:value "0"^^xsd:integer .

hpc:joincontainer a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:controlinteraction a owl:ObjectProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range hpc:Connection .

hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Connection ;
    rdfs:range xsd:string .

hpc:SlurmdDebug a xsd:string .
