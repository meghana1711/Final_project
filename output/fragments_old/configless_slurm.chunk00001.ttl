hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a owl:Class .

hpc:ConfiglessSlurm a owl:Class .
hpc:ConfiglessSlurm rdfs:subClassOf hpc:SlurmWorkloadManager .

hpc:SlurmController a owl:Class .
hpc:SlurmController rdfs:subClassOf hpc:SchedMD .

hpc:SlurmNode a owl:Class .
hpc:SlurmNode rdfs:subClassOf hpc:SlurmController .

hpc:SlurmCTLD a owl:Class .
hpc:SlurmCTLD rdfs:subClassOf hpc:SlurmController .

hpc:Slurmd a owl:Class .
hpc:Slurmd rdfs:subClassOf hpc:SlurmNode .

hpc:SlurmCTLDConfiguration a owl:Class .

hpc:SlurmConfServer a owl:ObjectProperty .
hpc:SlurmConfServer rdfs:domain hpc:Slurmd ;
                        rdfs:range rdf:Resource .

hpc:SlurmCTLDConfigured a owl:ObjectProperty .
hpc:SlurmCTLDConfigured rdfs:domain hpc:SlurmCTLD ;
                        rdfs:range xsd:boolean .

hpc:SlurmConfigured a owl:ObjectProperty .
hpc:SlurmConfigured rdfs:domain hpc:Slurmd ;
                        rdfs:range xsd:boolean .

hpc:SlurmCTLDConfigFile a owl:DatatypeProperty .
hpc:SlurmCTLDConfigFile rdfs:domain hpc:SlurmCTLD .
                        rdfs:range xsd:string .

hpc:SlurmCTLDPort a owl:DatatypeProperty .
hpc:SlurmCTLDPort rdfs:domain hpc:SlurmCTLD .
                        rdfs:range xsd:integer .

hpc:SlurmCTLDHASetup a owl:ObjectProperty .
hpc:SlurmCTLDHASetup rdfs:domain hpc:SlurmCTLD .
                        rdfs:range xsd:boolean .

hpc:SlurmCTLDPrimary a owl:DatatypeProperty .
hpc:SlurmCTLDPrimary rdfs:domain hpc:SlurmCTLD .
                        rdfs:range xsd:string .

hpc:SlurmCTLDBackup a owl:DatatypeProperty .
hpc:SlurmCTLDBackup rdfs:domain hpc:SlurmCTLD .
                        rdfs:range xsd:string .

hpc:SlurmCTLDTTL
