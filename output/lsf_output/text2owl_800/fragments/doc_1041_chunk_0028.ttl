hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Status a owl:Class .
hpc:Queue a owl:Class .
hpc:Command a owl:Class .
hpc:Host a owl:Class .
hpc:effectiveresReq a owl:ObjectProperty .
hpc:peNetworkId a owl:ObjectProperty .
hpc:bacct a owl:DatatypeProperty .
hpc:rsvid a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:creator a owl:DatatypeProperty .
hpc:user a owl:DatatypeProperty .
hpc:ncpus a owl:DatatypeProperty .
hpc:rsvHosts a owl:DatatypeProperty .
hpc:timeWindow a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Status rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:Command rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf owl:Class .

hpc:EffectiveresReq rdfs:domain hpc:Job ;
                        rdfs:range hpc:Resourcerequirement .
hpc:PeNetworkId rdfs:domain hpc:Job ;
                   rdfs:range xsd:string .
hpc:Bacct rdfs:domain hpc:Job ;
             rdfs:range xsd:string .
hpc:Rsvid rdfs:domain hpc:Advancereservation ;
           rdfs:range xsd:string .
hpc:Type rdfs:domain hpc:Advancereservation ;
         rdfs:range xsd:string .
hpc:Creator rdfs:domain hpc:Advancereservation ;
           rdfs:range xsd:string .
hpc:User rdfs:domain hpc:Job ;
          rdfs:range xsd:string .
hpc:Ncpus rdfs:domain hpc:Advancereservation ;
           rdfs:range xsd:nonNegativeInteger .
hpc:RsvHosts rdfs:domain hpc:Advancereservation ;
             rdfs:range xsd:string .
hpc:TimeWindow rdfs:domain hpc:Advancereservation ;
               rdfs:range xsd:string .
