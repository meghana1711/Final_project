hpc:Azurehostclass a owl:Class .
hpc:hasazurehost a owl:ObjectProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:boolean .

hpc:Instance a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Instance ;
    rdfs:range xsd:string .

hpc:HostStatus a owl:Enum ;
    rdfs:member rdf:"ok" ;
    rdfs:member rdf:"unavail" ;
    rdfs:member rdf:"closed" .

hpc:Instance a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:status ;
                        owl:hasValue rdf:"ok" ] .

hpc:Instance a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:status ;
                        owl:hasValue rdf:"unavail" ] .

hpc:Instance a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:status ;
                        owl:hasValue rdf:"closed" ] .

hpc:Instance a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasAzurehost ;
                        owl:hasValue true ] .

hpc:Instance a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasAzurehost ;
                        owl:hasValue false ] .
