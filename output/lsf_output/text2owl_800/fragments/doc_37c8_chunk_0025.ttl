hpc:Procedure a owl:Class .
hpc:containerparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Procedure ;
    rdfs:range hpc:Container .

hpc:Container a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:image a owl:DatatypeProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .

hpc:options a owl:DatatypeProperty ;
    rdfs:domain hpc:Container ;
    rdfs:range xsd:string .

hpc:script a owl:DatatypeProperty ;
    rdfs:domain hpc:Options ;
    rdfs:range xsd:string .

hpc:Containeroption a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:Option .

hpc:preexecutionscript a owl:ObjectProperty ;
    rdfs:domain hpc:Containeroption ;
    rdfs:range xsd:string .

hpc:ldlibrarypathcleaning a owl:ObjectProperty ;
    rdfs:domain hpc:Container .
