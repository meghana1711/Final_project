hpc:Lsfwebservices a owl:Class .
hpc:configurationfile hpc:prop a owl:DatatypeProperty .
hpc:restartservice hpc:prop a owl:ObjectProperty .
hpc:authentication hpc:prop a owl:ObjectProperty .
hpc:singlesignon hpc:prop a owl:ObjectProperty .
hpc:realmaccount hpc:prop a owl:DatatypeProperty .
hpc:username hpc:prop a owl:DatatypeProperty .
hpc:password hpc:prop a owl:DatatypeProperty .
hpc:url hpc:prop a owl:DatatypeProperty .
hpc:clusterlogin hpc:prop a owl:ObjectProperty .
hpc:listclusters hpc:prop a owl:ObjectProperty .
hpc:jobsubmission hpc:prop a owl:ObjectProperty .
hpc:defaultqueue hpc:prop a owl:DatatypeProperty .
hpc:ldapintegration hpc:prop a owl:ObjectProperty .
hpc:keycloakuserfederation hpc:prop a owl:ObjectProperty .
hpc:openldap hpc:prop a owl:DatatypeProperty .

hpc:Lsfwebservices rdfs:subClassOf owl:Class .
hpc:Configurationfile rdfs:domain hpc:Lsfwebservices ;
                          rdfs:range xsd:string .
hpc:Restartservice rdfs:domain hpc:Lsfwebservices ;
                     rdfs:range rdf:List .
hpc:Authentication rdfs:domain hpc:Lsfwebservices .
hpc:Singlesignon rdfs:domain hpc:Authentication .
hpc:Realmaccount rdfs:domain hpc:Singlesignon .
hpc:Username rdfs:domain hpc:Realmaccount .
hpc:Password rdfs:domain hpc:Realmaccount .
hpc:Url rdfs:domain hpc:Realmaccount .
hpc:Clusterlogin rdfs:domain hpc:Authentication .
hpc:Listclusters rdfs:domain hpc:Clusterlogin .
hpc:Jobsubmission rdfs:domain hpc:Clusterlogin .
hpc:Defaultqueue rdfs:domain hpc:Jobsubmission .
hpc:Ldapintegration rdfs:domain hpc:Lsfwebservices .
hpc:Keycloakuserfederation rdfs:domain hpc:Ldapintegration .
hpc:Openldap rdfs:domain hpc:Keycloakuserfederation .
