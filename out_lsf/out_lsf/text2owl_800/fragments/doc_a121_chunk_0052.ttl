hpc:Job a owl:Class .
hpc:Dataprovenancejob a owl:Class .

hpc:standardinputfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:lsbDpSubfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:lsbDpDestfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:numberoffiles a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:esubDprovfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:esubDprovfilecount a owl:DatatypeProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:showhist a owl:ObjectProperty ;
    rdfs:domain hpc:Dataprovenancejob ;
    rdfs:range xsd:string .
