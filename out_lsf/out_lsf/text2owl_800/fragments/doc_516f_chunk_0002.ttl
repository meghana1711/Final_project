hpc:Job a owl:Class .
hpc:pendingtimelimit a owl:ObjectProperty .
hpc:eligiblependingtimelimit a owl:ObjectProperty .
hpc:effectiveplimit a owl:DatatypeProperty .
hpc:plimitremain a owl:DatatypeProperty .
hpc:effectiveeplimit a owl:DatatypeProperty .
hpc:eplimitremain a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:PendingTimeLimit rdf:type owl:ObjectProperty .
hpc:EligiblePendingTimeLimit rdf:type owl:ObjectProperty .
hpc:EffectivePLimit rdf:type owl:DatatypeProperty .
hpc:PLimitRemain rdf:type owl:DatatypeProperty .
hpc:EffectiveEPLimit rdf:type owl:DatatypeProperty .
hpc:EPLimitRemain rdf:type owl:DatatypeProperty .

hpc:Pendingtimelimit rdfs:domain hpc:Job .
hpc:Eligiblependingtimelimit rdfs:domain hpc:Job .
hpc:Effectiveplimit rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Plimitremain rdfs:domain hpc:Job ;
    rdfs:range xsd:nonPositiveInteger .
hpc:Effectiveeplimit rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Eplimitremain rdfs:domain hpc:Job ;
    rdfs:range xsd:nonPositiveInteger .
