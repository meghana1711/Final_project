hpc:Hostattribute a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a host attribute in the LSF system." .

hpc:ttl a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostattribute ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The time-to-live (TTL) of a host attribute." .

hpc:hasttl a owl:ObjectProperty ;
    rdfs:domain hpc:Hostattribute ;
    rdfs:range hpc:Hostattribute ;
    rdfs:comment "The host attribute that has the TTL." .

hpc:TTLValueInMinutes owl:ObjectProperty ;
    rdfs:domain hpc:Ttl ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the TTL value is in minutes." .

hpc:defaultTTL a xsd:nonNegativeInteger ;
    rdfs:comment "The default TTL for host attributes is one hour." .

hpc:Jobaffinity a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents job affinity preferences for jobs to run on the same host or compute unit." .

hpc:samejobaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinity ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the SAME_JOB_AFFINITY parameter is enabled." .

hpc:samehost a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinity ;
    rdfs:range hpc:Jobaffinity ;
    rdfs:comment "Specifies affinity preferences for jobs to run on the same host." .

hpc:samecu a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinity ;
    rdfs:range hpc:Jobaffinity ;
    rdfs:comment "Specifies affinity preferences for jobs to run on the same compute unit." .

hpc:battrcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobaffinity ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to manage host attributes for job affinity." .

hpc:battrcreate a owl:ObjectProperty ;
    rdfs:domain hpc:Battrcommand ;
    rdfs:range hpc:Hostattributecreatecommand ;
    rdfs:comment "The create command for host attributes." .
