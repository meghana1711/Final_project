@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>
@prefix hpc: <http://example.org/hpc#>

hpc:Slurm a owl:Class.
hpc:oversubscribe a owl:ObjectProperty;
    rdfs:domain hpc:Slurm;
    rdfs:range xsd:boolean.
hpc:exclusive a owl:ObjectProperty;
    rdfs:domain hpc:Slurm;
    rdfs:range xsd:string.
hpc:exclusiveuser a owl:DatatypeProperty;
    rdfs:domain hpc:Slurm;
    rdfs:range xsd:string.
hpc:mcslabel a owl:DatatypeProperty;
    rdfs:domain hpc:Job.
hpc:mcsp
