hpc:Slurmuser a owl:Class .
hpc:Resumeprogram a owl:Class .
hpc:Suspendprogram a owl:Class .
hpc:nodeStartup a owl:ObjectProperty .
hpc:nodeShutdown a owl:ObjectProperty .
hpc:logfile a owl:DatatypeProperty .
hpc:hosts a owl:DatatypeProperty .
hpc:Resumeprogram rdfs:subClassOf hpc:Program .
hpc:Suspendprogram rdfs:subClassOf hpc:Program .
hpc:Program rdf:type owl:Class .
hpc:NodeStartup rdfs:domain hpc:Resumeprogram ;
                      rdfs:range xsd:string .
hpc:NodeShutdown rdfs:domain hpc:Suspendprogram ;
                   rdfs:range xsd:string .
hpc:Logfile rdfs:domain hpc:Program ;
               rdfs:range xsd:string .
hpc:Hosts rdfs:domain hpc:Program ;
           rdfs:range xsd:string .
