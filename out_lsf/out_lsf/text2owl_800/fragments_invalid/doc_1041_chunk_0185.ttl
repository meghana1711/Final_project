hpc:Command a owl:Class .
hpc:queuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:username a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range (xsd:string | hpc:Usergroup) .
hpc:Usergroup a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:JobState a owl:EnumeredClass ;
    rdfs:subClassOf hpc:Job ;
    rdfs:subClassOf hpc:Commandresult ;
    rdfs:comment "States of a job: PENDING, RUNNING, SUSPENDED, FINISHED (EXIT or DONE)" .
hpc:Jobstate rdfs:subClassOf hpc:Jobstatetype .
hpc:Jobstatetype a owl:Class .
hpc:Jobresult a owl:Class ;
    rdfs:subClassOf hpc:Commandresult .
hpc:Jobresult rdfs:subClassOf hpc:Jobstate .
hpc:Jobresult rdfs:subClassOf hpc:Jobresulttype .
hpc:Jobresulttype a owl:Class .
hpc:logfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:string .
hpc:starttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:dateTime .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:dateTime .
hpc:lsbBhistHours a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:nonNegativeInteger .
hpc:eventlogfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:string .
hpc:EventLogFile rdfs:comment "The event log file used by the LSF system" .
hpc:pastweek a owl:DatatypeProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:boolean .
hpc:PastWeek rdfs:comment "Displays events that occurred in the past week" .
hpc:normalizedcputime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:jobaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobaffinitytype .
hpc:Jobaffinitytype a owl:Class .
hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:taskcpuaffinity a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    r
