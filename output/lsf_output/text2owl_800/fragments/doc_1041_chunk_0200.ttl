hpc:Executionrusage a owl:Class .

# Effective RES_REQ
hpc:EffectiveresReq a owl:Class .

# Resizable job information
hpc:Resizablejob a owl:Class .
hpc:Autoresizable rdfs:domain hpc:Resizablejob ;
                  rdfs:range xsd:boolean .
hpc:Resizenotificationcommand rdfs:domain hpc:Resizablejob ;
                             rdfs:range xsd:string .

# Resize notification accepted
hpc:Resizenotificationaccepted a owl:Class .

# Notification command initialized
hpc:Notificationcommandinitialized a owl:Class ;
  rdfs:subClassOf hpc:Resizenotificationaccepted .
hpc:Pid rdfs:domain hpc:Notificationcommandinitialized ;
              rdfs:range xsd:integer .

# Resize notification failed
hpc:Resizenotificationfailed a owl:Class ;
  rdfs:subClassOf hpc:Resizenotificationaccepted .

# JOB_RESIZE_NOTIFY_DONE event
hpc:Jobresizenotifydoneevent a owl:Class .
hpc:Status rdfs:domain hpc:Jobresizenotifydoneevent ;
              rdfs:range xsd:integer .
hpc:Resizenotificationcommandcompleted a owl:Class ;
  rdfs:subClassOf hpc:Jobresizenotifydoneevent .
hpc:Resizenotificationcommandfailed a owl:Class ;
  rdfs:subClassOf hpc:Jobresizenotifydoneevent .

# JOB_RESIZE_RELEASE event
hpc:Jobresizereleaseevent a owl:Class .
hpc:Numhosts rdfs:domain hpc:Jobresizereleaseevent ;
              rdfs:range xsd:nonNegativeInteger .
hpc:Hostlist rdfs:domain hpc:Jobresizereleaseevent ;
              rdfs:range xsd:string .
hpc:Username rdfs:domain hpc:Jobresizereleaseevent ;
              rdfs:range xsd:string .
hpc:resizenotificationaccepted a owl:ObjectProperty .

# bmod -rncn option
hpc:Bmodrncn a owl:Class .
hpc:Resizenotificationmessage rdfs:domain hpc:Bmodrncn ;
              rdfs:range xsd:string .
