hpc:Sequentialjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Jobslot a owl:Class .

hpc:usesJobSlot rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sequentialjob ;
    rdfs:range hpc:Jobslot .

hpc:requiresJobSlot rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range hpc:Jobslot .

hpc:maxUserJobSlots rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maxProcessorJobSlots rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Processor ;
    rdfs:range xsd:nonNegativeInteger .

hpc:maxHostJobSlots rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .
