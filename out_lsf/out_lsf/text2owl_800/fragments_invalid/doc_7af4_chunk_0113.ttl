hpc:Runlimit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The default run limit.";

hpc:hasrunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration ;
    rdfs:comment "The run limit for a job.";

hpc:normalizedrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The normalized run time of a RunLimit.";

hpc:hostnormalization a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host used for normalization of a RunLimit.";

hpc:executionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:Host ;
    rdfs:comment "The host where a RunLimit is executed.";

hpc:overrideterminationjob a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:Job ;
    rdfs:comment "The job action to override the default termination of a RunLimit.";

hpc:hasjoblevelrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration ;
    rdfs:comment "The job-level run limit of a Job.";

hpc:maxrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:duration ;
    rdfs:comment "The maximum run limit of a Queue.";

hpc:applicationlevellimit a owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range hpc:Application ;
    rdfs:comment "The application-level limit that overrides any default limit.";

hpc:estimatedruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:duration ;
    rdfs:comment "The estimated run time for scheduling purposes.";

hpc:absrunlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the runtime limit is normalized by the host CPU factor.";
