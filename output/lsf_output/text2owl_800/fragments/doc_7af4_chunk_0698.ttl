hpc:Lsf a owl:Class .
hpc:cudaVisibleDevices a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Mps a owl:Class .
hpc:mps a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:string .
hpc:MpsPerSocket a owl:Class ;
    rdfs:subClassOf hpc:Mps .
hpc:MpsPerGpu a owl:Class ;
    rdfs:subClassOf hpc:Mps .
hpc:MpsShared a owl:Class ;
    rdfs:subClassOf hpc:Mps .

hpc:jExclusive a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .

hpc:aff a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range xsd:boolean .
