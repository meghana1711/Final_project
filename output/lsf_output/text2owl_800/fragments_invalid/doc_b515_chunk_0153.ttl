hpc:Creator a owl:Class.
hpc:User a owl:Class.
hpc:Ncpus a owl:Class.
hpc:Rsvhosts a owl:Class.
hpc:Configuration a owl:Class.

hpc:hascreator a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range hpc:Creator .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range hpc:User .
hpc:hasncpus a owl:ObjectProperty ;
