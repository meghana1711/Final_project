hpc:Multihostjob a owl:Class .
hpc:Lsfjob a owl:Class .
hpc:Environmentvariable a owl:Class .
hpc:LSB_BIND_JOB, hpc:LSB_BIND_CPU_LIST rdf:type hpc:EnvironmentVariable .
hpc:processorbinding a owl:ObjectProperty .
hpc:Jobprocess a owl:Class .
hpc:Jobprocessgroup a owl:Class .
hpc:Rootjobprocess a owl:Class .
hpc:Daemonprocess a owl:Class .
hpc:Hostsupport a owl:Class .
hpc:processoraffinity a owl:ObjectProperty .
hpc:Singleprocessorhost a owl:Class .
hpc:Ncpusdefinition a owl:Class .
hpc:Processors, hpc:ProcessorsAndCores, hpc:ProcessorsCoresAndThreads rdf:type hpc:NCPUSDefinition .
hpc:egoDefineNcpus a owl:DatatypeProperty .
hpc:EgoDefineNcpus rdfs:domain hpc:Ncpusdefinition ;
                          rdfs:range xsd:string .
hpc:Defaultncpus a owl:Class .
hpc:DefaultNCPUS rdf:type hpc:NCPUSDefinition ;
                 rdfs:label "cores" .
hpc:processorbindingpolicy a owl:ObjectProperty .
hpc:Jobprocessgroup rdfs:subClassOf hpc:Jobprocess ;
                        rdfs:domain hpc:Lsfjob ;
                        rdfs:range hpc:Jobprocessgroup .
hpc:Jobprocess rdfs:subClassOf hpc:Process ;
                 rdfs:domain hpc:Lsfjob ;
                 rdfs:range hpc:Jobprocess .
hpc:Rootjobprocess rdfs:subClassOf hpc:Jobprocess ;
                   rdfs:domain hpc:Lsfjob ;
                   rdfs:range hpc:Rootjobprocess .
hpc:Daemonprocess rdfs:subClassOf hpc:Process ;
                   rdfs:domain hpc:Lsfjob ;
                   rdfs:range hpc:Daemonprocess .
hpc:Host rdfs:subClassOf hpc:Hostsupport .
hpc:Processoraffinity rdfs:domain hpc:Host ;
                      rdfs:range hpc:Host .
hpc:Singleprocessorhost rdfs:subClassOf hpc:Host ;
                        rdfs:domain hpc:Hostsupport ;
                        rdfs:range hpc:Singleprocessorhost .
