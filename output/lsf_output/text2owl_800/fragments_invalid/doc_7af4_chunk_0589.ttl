hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Job a owl:Class .
hpc:Shareassignment a owl:Class .
hpc:totalshares a owl:DatatypeProperty ;
    rdfs:domain hpc:Shareassignment ;
    rdfs:range xsd:integer .
hpc:username a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:maxjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:maxpendingjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:joblocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:User a rdfs:subClassOf [ a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        rdfs:subClassOf [ a owl:Class ;
            rdfs:subClassOf [ a owl:Class ;
                rdfs:subClassOf owl:Thing ] ] ] ] .
hpc:Usergroup a rdfs:subClassOf [ a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:Thing ] ] .
hpc:Job a rdfs:subClassOf [ a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:Thing ] ] .
hpc:Shareassignment a rdfs:subClassOf [ a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
        rdfs:subClassOf owl:Thing ] ] .
