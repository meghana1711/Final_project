hpc:Slotreservation a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Applies only to parallel jobs." .

hpc:hasmaxreservetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Slotreservation ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Up to 5 cycles of MBD_SLEEP_TIME (5 minutes, by default) to reserve sufficient job slots to start." .

hpc:sndjobsto a owl:ObjectProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range rdf:List ;
    rdfs:comment "Specify remote queue names, in the form queue_name@cluster_name[+preference], separated by a space." .

hpc:Remotequeue a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a remote queue." .

hpc:hasqueuename a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotequeue ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the remote queue." .

hpc:hasclustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotequeue ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the cluster associated with the remote queue." .

hpc:haspreference a owl:DatatypeProperty ;
    rdfs:domain hpc:Remotequeue ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Queue preference." .

hpc:Sndjobstoignored a owl:Class ;
    rdfs:subClassOf hpc:Sndjobsto ;
    rdfs:comment "Ignored if lsb.queues HOSTS specifies remote (borrowed) resources." .
