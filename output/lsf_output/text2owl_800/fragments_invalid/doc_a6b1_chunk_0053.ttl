hpc:Useraccountmapping rdfs:subClassOf owl:Class .
hpc:LsfEauthUser rdfs:domain hpc:Useraccountmapping ;
                      rdfs:range xsd:string .
hpc:LsfEexecUser rdfs:domain hpc:Useraccountmapping ;
                      rdfs:range xsd:string .
hpc:LsbPrePostExecUser rdfs:domain hpc:Useraccountmapping ;
                           rdfs:range xsd:string .
hpc:Clusteradministrator rdfs:subClassOf owl:Class .
hpc:ClusterName rdfs:domain hpc:Clusteradministrator ;
                     rdfs:range xsd:string .
hpc:Administrators rdfs:domain hpc:Clusteradministrator ;
                      rdfs:range xsd:string .
hpc:LsfRootRex rdfs:domain hpc:Useraccountmapping ;
                     rdfs:range xsd:string .
hpc:LsfStartupUsers rdfs:domain hpc:Useraccountmapping ;
                        rdfs:range xsd:string .
hpc:LsfStartupPath rdfs:domain hpc:LsfStartupUsers ;
                       rdfs:range xsd:string .
hpc:Authorizationfailure rdfs:subClassOf owl:Class .
hpc:UsuspState rdfs:subClassOf hpc:Authorizationfailure .
hpc:Registerwindowspassword rdfs:domain hpc:Authorizationfailure ;
                               rdfs:range xsd:string .
hpc:Bresume rdfs:domain hpc:Authorizationfailure ;
                      rdfs:range xsd:string .
hpc:Findhostbyaddr rdfs:domain hpc:Authorizationfailure ;
                      rdfs:range xsd:string .
