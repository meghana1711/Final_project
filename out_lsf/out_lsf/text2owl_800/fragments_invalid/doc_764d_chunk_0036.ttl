hpc:Reservation a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a reservation in the HPC system." .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a cluster in the HPC system." .

hpc:Submissioncluster rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster where jobs are submitted." .

hpc:Executioncluster rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A cluster where jobs are executed." .

hpc:Reservationstate a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents the state of a reservation." .

hpc:AvailableReservationState a hpc:ReservationState ;
    rdfs:comment "The reservation is available." .

hpc:ModifiableReservationState a hpc:ReservationState ;
    rdfs:comment "The reservation can be modified." .

hpc:ModifiedReservationState a hpc:ReservationState ;
    rdfs:comment "The reservation has been modified." .

hpc:DeletedReservationState a hpc:ReservationState ;
    rdfs:comment "The reservation has been deleted." .

hpc:hasreservation a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Reservation ;
    rdfs:comment "A cluster has a reservation." .

hpc:hasstate a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Reservationstate ;
    rdfs:comment "A reservation has a state." .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Job ;
    rdfs:comment "A reservation has a job." .

hpc:hascluster a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A reservation is associated with a cluster." .

hpc:makeReservation a rdf:Property ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Reservation ;
    rdfs:comment "A cluster makes a reservation." .

hpc:modifyReservation a rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range hpc:Reservation ;
    rdfs:comment "A reservation is modified." .

hpc:deleteReservation a rdf:Property ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:string ;
    rdfs:comment "A reservation is deleted." .

hpc:submitJobToReservation a rdf:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Reservation
