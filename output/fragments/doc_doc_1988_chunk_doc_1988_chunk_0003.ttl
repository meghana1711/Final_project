hpc:PreemptMode a owl:Class .
hpc:SchedulerTimeSlice a owl:DatatypeProperty ;
    rdfs:domain hpc:PreemptMode ;
    rdfs:range xsd:integer .
hpc:OverSubscribe a owl:Class .
hpc:hasPartition a owl:ObjectProperty ;
    rdfs:domain hpc:OverSubscribe ;
    rdfs:range hpc:Partition .
hpc:Partition a owl:Class .
hpc:hasPreemptMode a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:PreemptMode .
hpc:hasSchedulerTimeSlice a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:integer .
hpc:hasOverSubscribe a owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range hpc:OverSubscribe .
hpc:Force a owl:Class ;
    rdfs:subClassOf hpc:OverSubscribe .
hpc:hasMaxShare a owl:DatatypeProperty ;
    rdfs:domain hpc:Force ;
    rdfs:range xsd:integer .
