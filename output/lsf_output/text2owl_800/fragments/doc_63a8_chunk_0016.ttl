hpc:Tag a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A tag created by jobs in LSF." .

hpc:cleanuptask a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Tag ;
    rdfs:comment "The action of cleaning up a tag." .

hpc:cleantag a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Tag ;
    rdfs:comment "The action of deleting a tag and its containing files." .

hpc:specifyuser a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range xsd:string ;
    rdfs:comment "The action of specifying a user for cleaning up their tags." .

hpc:tagusage a owl:ObjectProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether a tag is currently in use." .

hpc:lastdownload a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The time stamp of the last download of the tag." .
