hpc:Productgroup a owl:Class .
hpc:Product a owl:Class .
hpc:installedversion a owl:DatatypeProperty .
hpc:platform a owl:DatatypeProperty .

hpc:Productgroup rdfs:subClassOf owl:Class .
hpc:Product rdfs:subClassOf hpc:Productgroup .

hpc:Installedversion rdfs:domain hpc:Product .
hpc:Platform rdfs:domain hpc:Product .

hpc:Installedversion rdfs:range xsd:string .
hpc:Platform rdfs:range xsd:string .

hpc:ProductGroup IBMSpectrumComputing rdf:type hpc:ProductGroup .
hpc:Product IBMSpectrumLSF rdf:type hpc:Product .
hpc:Product IBMSpectrumLSFSuite rdf:type hpc:Product .
