hpc:CsmReq a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies the required values for the IBM Cluster Systems Manager (CSM) bsub job submission command options." .

hpc:EnableGpuHistRunTime a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Enables the use of historical GPU run time in the calculation of fair share scheduling policy." .

hpc:GpuReq a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies the GPU requirements for the queue." .

hpc:ResReq a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specifies the resource reservation method." .

hpc:hasversion a owl:ObjectProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range xsd:string ;
    rdfs:comment "The version of LSF this parameter applies to." .

hpc:haschange a owl:ObjectProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range xsd:string ;
    rdfs:comment "The changes made to the parameter in a specific LSF version." .

hpc:hasoption a owl:ObjectProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range xsd:string ;
    rdfs:comment "The options that can be specified for the parameter." .

hpc:hasaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReq ;
    rdfs:range xsd:string ;
    rdfs:comment "The affinity setting for GPU requirements." .

hpc:hasmps a owl:ObjectProperty ;
    rdfs:domain hpc:GpuReq ;
    rdfs:range xsd:string ;
    rdfs:comment "The MPS setting for GPU requirements." .

hpc:hasresourcelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum integer value for a resource limit." .

hpc:hasreservationmethod a owl:DatatypeProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range xsd:string ;
    rdfs:comment "The resource reservation method for a job or host." .
