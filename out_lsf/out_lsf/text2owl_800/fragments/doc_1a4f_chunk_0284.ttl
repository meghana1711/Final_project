hpc:Cpulimit a owl:Class .
hpc:cpudefaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cpumaxlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Cpulimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Runlimit a owl:Class .
hpc:rundefaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:runmaxlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Threadlimit a owl:Class .
hpc:threaddefaultlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Threadlimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Cpulimit rdfs:subClassOf owl:Class .
hpc:Runlimit rdfs:subClassOf owl:Class .
hpc:Threadlimit rdfs:subClassOf owl:Class .
