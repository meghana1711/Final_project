hpc:Signallisteningscript a owl:Class .
hpc:Notifcationscript a owl:Class .
hpc:blauchncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Signallisteningscript ;
    rdfs:range hpc:Blauchncommand .
hpc:Switchedjob a owl:Class .
hpc:bswitch a owl:ObjectProperty ;
    rdfs:domain hpc:Switchedjob ;
    rdfs:range hpc:Queue .
hpc:Usergroupadministrator a owl:Class .
hpc:bresizecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroupadministrator ;
    rdfs:range hpc:Bresizecommand .
hpc:bresizerelease a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroupadministrator ;
    rdfs:range hpc:Job .
hpc:bresizerequest a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroupadministrator ;
    rdfs:range hpc:Job .
hpc:bresizecancel a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroupadministrator ;
    rdfs:range hpc:Resizerequest .
hpc:Requeueexitvalues a owl:Class .
hpc:joblevelrequeueexitvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Requeueexitvalues ;
    rdfs:range hpc:Job .
hpc:applicationlevelrequeueexitvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Requeueexitvalues ;
    rdfs:range hpc:Application .
hpc:queuelevelrequeueexitvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Requeueexitvalues ;
    rdfs:range hpc:Queue .
hpc:Automaticjobrerun a owl:Class .
hpc:reschedulablejob a owl:ObjectProperty ;
    rdfs:domain hpc:Automaticjobrerun ;
    rdfs:range hpc:Job .
hpc:Resizablejob a owl:Class .
hpc:computeunitrequirements a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Alternativeresourcerequirements a owl:Class ;
    rdfs:subClassOf hpc:Resizablejob .
hpc:taskincrease a owl:DatatypeProperty ;
    rdfs:domain hpc:Alternativeresourcerequirements ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Compoundresourcerequirements a owl:Class ;
    rdfs:subClassOf hpc:Resizablejob .
hpc:lasttermcompoundresource a owl:ObjectProperty ;
    rdfs:domain hpc:Compoundresourcerequirements ;
    rdfs:range hpc:Resourcerequirement .
