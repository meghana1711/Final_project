hpc:Job a owl:Class .
hpc:hasjobname a owl:ObjectProperty .
hpc:Hasjobname rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:wildcardcharacter a owl:ObjectProperty .
hpc:Wildcardcharacter rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobpattern a owl:ObjectProperty .
hpc:Jobpattern rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobarray a owl:Class .
hpc:Jobarray rdfs:subClassOf hpc:Job .
hpc:arrayindex a owl:DatatypeProperty .
hpc:Arrayindex rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:nonNegativeInteger .
hpc:migratecommand a owl:ObjectProperty .
hpc:Migratecommand rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:multiclustercapability a owl:ObjectProperty .
hpc:Multiclustercapability rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:User a owl:Class .
hpc:User rdfs:subClassOf hpc:Job .
hpc:username a owl:DatatypeProperty .
hpc:Username rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:usergroup a owl:DatatypeProperty .
hpc:Usergroup rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:allUser a owl:NamedIndividual .
hpc:allUser a hpc:User .
hpc:Windowsuser a owl:Class .
hpc:Windowsuser rdfs:subClassOf hpc:User .
hpc:windowsdomainname a owl:DatatypeProperty .
hpc:Windowsdomainname rdfs:domain hpc:Windowsuser ;
    rdfs:range xsd:string .
hpc:bmodcommand a owl:ObjectProperty .
hpc:Bmodcommand rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
