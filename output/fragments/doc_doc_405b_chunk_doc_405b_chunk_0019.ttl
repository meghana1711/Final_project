hpc:UnavailableNodes a owl:Class .
hpc:reason rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Reservation a owl:Class .
hpc:advancedReservation rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:ReservationDeleted a owl:Class .
