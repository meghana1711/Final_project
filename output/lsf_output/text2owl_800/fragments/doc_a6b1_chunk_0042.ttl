    rdfs:range xsd:nonNegativeInteger .
hpc:Hascpurunqueuelengths rdfs:domain hpc:Processor ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Issuspendedduetoloadthresholds rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:Hasperprocessorjobslotlimit rdfs:domain hpc:Processor ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasexternalstaticlim rdfs:domain hpc:Processor ;
    rdfs:range xsd:string .
hpc:Detectsoperatingsystem rdfs:domain hpc:Processor ;
    rdfs:range xsd:string .
hpc:Requiresfile rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:Hasnonaccessiblefile rdfs:domain hpc:Task ;
    rdfs:range xsd:boolean .
hpc:Hasegoeslimtimeout rdfs:domain hpc:Configuration ;
    rdfs:range xsd:nonNegativeInteger .
