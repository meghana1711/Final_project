hpc:Outputdirectory a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Represents the output directory for a job." .

hpc:hasoutputdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory ;
    rdfs:comment "Relates a job to its output directory." .

# Dynamic Output Directory Pattern
hpc:Dynamicoutputdirectorypattern a owl:Class ;
    rdfs:subClassOf owl:String ;
    rdfs:comment "Represents a pattern for the output directory of a job." .

# Job State
hpc:Jobstate a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Represents the state of a job." .

hpc:ispendingstate a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstate ;
    rdfs:range hpc:Jobstate ;
    rdfs:comment "Indicates if a job is in pending state." .

# Modifying Output Directory
hpc:Modifyoutputdirectory a owl:Class ;
    rdfs:subClassOf owl:Action ;
    rdfs:comment "Action to modify the output directory of a job." .

hpc:hasoutputdirectoryvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Modifyoutputdirectory ;
    rdfs:range xsd:string ;
    rdfs:comment "Relates a modify output directory action to its new output directory value." .

# Queue
hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Represents a queue in the HPC system." .

hpc:isdefaultjoboutdirqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue ;
    rdfs:comment "Indicates if a queue is the default job output directory queue." .

# Rerunnable Job
hpc:Rerunnablejob a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Represents a job that can be rerun." .

hpc:resetrerunnablejob a owl:ObjectProperty ;
    rdfs:domain hpc:Action ;
    rdfs:range hpc:Rerunnablejob ;
    rdfs:comment "Resets the rerunnable job setting for a job." .

hpc:hasapplicationprofile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Applicationprofile ;
    rdfs:comment "Relates a job to its application profile." .

hpc:hasqueuelevelrerunnablejobsetting a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Rerunnablejobsetting ;
    rdfs:comment "Relates a queue to its queue level rerunnable job setting." .

# Immediate Orphan Job Termination
hpc:ImmediateOrphanTermination a owl:
