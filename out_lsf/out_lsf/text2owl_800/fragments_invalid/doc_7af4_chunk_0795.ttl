hpc:lsfDcgmPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:integer ;
    rdfs:comment "Enables the NVIDIA Data Center GPU Manager (DCGM) features and specifies the port number that LSF uses to communicate with the DCGM daemon." .

hpc:hasdcgmport a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:LsfDcgmPort ;
    rdfs:comment "The port number should be set to the port reported by /usr/bin/nv-hostengine." .

hpc:Dcgmprovidesfunctionality a owl:Class ;
    rdfs:subClassOf hpc:Functionality .

hpc:providesgpuusageinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Dcgmprovidesfunctionality ;
    rdfs:range hpc:ExclusiveProcessModeJob ;
    rdfs:comment "Provides GPU usage information for EXCLUSIVE_PROCESS mode jobs." .

hpc:checksgpustatus a owl:ObjectProperty ;
    rdfs:domain hpc:Dcgmprovidesfunctionality ;
    rdfs:range hpc:Job ;
    rdfs:comment "Checking the status of GPUs to automatically filter out unhealthy GPUs when the job allocates GPU resources, and to automatically add back the GPU if it becomes healthy again." .

hpc:checksgpuhealth a owl:ObjectProperty ;
    rdfs:domain hpc:Dcgmprovidesfunctionality ;
    rdfs:range hpc:Gpu ;
    rdfs:comment "Mechanisms to check the GPU health." .

hpc:integrateschecks a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Dcgmprovidesfunctionality ;
    rdfs:comment "Integrates the mechanisms to check the GPU status before, during, and after the job is running to meet the GPU requirements." .

hpc:requeuesjob a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Job ;
    rdfs:comment "If LSF detects that a GPU is not healthy before the job is complete, LSF requeues the job." .

hpc:Gpuresourceusagereports a owl:Class ;
    rdfs:subClassOf hpc:Resourceusagereport ;
    rdfs:comment "GPU resource usage reports." .

hpc:Dcgmstatusvalid a owl:Class ;
    rdfs:subClassOf hpc:Hoststatus ;
    rdfs:comment "The execution host's DCGM status." .

hpc:Gpuautoboost a owl:Class ;
    rdfs:subClassOf hpc:Feature ;
    rdfs:comment "The GPU auto-boost feature." .

hpc:supportsjobacrossmultiplegpus a owl:ObjectProperty ;
    rdfs:domain hpc:Gpuautoboost ;
    rdfs:range hpc:Job ;
    rdfs:comment "Supports jobs that run across multiple GPUs, including jobs that run across multiple
