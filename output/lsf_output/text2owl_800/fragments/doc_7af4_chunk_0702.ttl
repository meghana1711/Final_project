hpc:Lsf a owl:Class .
hpc:lsbGpuPoweroffDuration a owl:DatatypeProperty .
hpc:Gpu a owl:Class .
hpc:haspowerlimitmode a owl:ObjectProperty .
hpc:isidle a owl:DatatypeProperty .
hpc:meetsjobrequirements a owl:ObjectProperty .
hpc:MaxPowerLimit a owl:Class .
hpc:MinPowerLimit a owl:Class .
hpc:Gpuflow a owl:Class .
hpc:allocatesgpu a owl:ObjectProperty .
hpc:samepci a owl:ObjectProperty .
hpc:restarted a owl:ObjectProperty .
hpc:NvidiaK80 a owl:Class .
hpc:supportsautoboost a owl:DatatypeProperty .
hpc:switchpowerlimits a owl:DatatypeProperty .

hpc:Gpu rdfs:subClassOf hpc:Hardware .
hpc:Lsf rdfs:subClassOf owl:Class .
hpc:LsbGpuPoweroffDuration rdfs:domain hpc:Lsf ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:Gpuflow rdfs:subClassOf owl:Class .
hpc:Haspowerlimitmode rdfs:domain hpc:Gpu ;
                      rdfs:range hpc:Powerlimitmode .
hpc:Isidle rdfs:domain hpc:Gpu ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Meetsjobrequirements rdfs:domain hpc:Gpu ;
                          rdfs:range xsd:boolean .
hpc:MaxPowerLimit rdfs:subClassOf hpc:Powerlimitmode .
hpc:MinPowerLimit rdfs:subClassOf hpc:Powerlimitmode .
hpc:Allocatesgpu rdfs:domain hpc:Lsf ;
                   rdfs:range hpc:Gpuflow .
hpc:Samepci rdfs:domain hpc:Gpuflow ;
                   rdfs:range xsd:boolean .
hpc:Restarted rdfs:domain hpc:Lsf ;
                   rdfs:range xsd:boolean .
hpc:NvidiaK80 rdfs:subClassOf hpc:Gpu .
hpc:Supportsautoboost rdfs:domain hpc:NvidiaK80 ;
                      rdfs:range xsd:boolean .
hpc:Switchpowerlimits rdfs:domain hpc:NvidiaK80 ;
                       rdfs:range xsd:boolean .
