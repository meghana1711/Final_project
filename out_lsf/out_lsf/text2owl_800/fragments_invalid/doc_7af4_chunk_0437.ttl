hpc:Gpumodel a owl:Class .
hpc:modelname a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:brandname a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:modeltypename a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:totalmemorysize a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:memoryunit a owl:DatatypeProperty ;
    rdfs:domain hpc:Totalmemorysize ;
    rdfs:range xsd:string .
hpc:gpumemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:gtile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:numberofgpuspersocket a owl:DatatypeProperty ;
    rdfs:domain hpc:Gtile ;
    rdfs:range xsd:integer .
hpc:autocalculatenumberofgpuspersocket a owl:ObjectProperty ;
    rdfs:domain hpc:Gtile ;
    rdfs:range xsd:boolean .
hpc:gpumodelnamestring a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:replacespacecharacters a owl:ObjectProperty ;
    rdfs:domain hpc:Gpumodelnamestring ;
    rdfs:range xsd:string .
hpc:replaceslashcharacter a owl:ObjectProperty ;
    rdfs:domain hpc:Gpumodelnamestring ;
    rdfs:range xsd:string .
hpc:replacehyphencharacter a owl:ObjectProperty ;
    rdfs:domain hpc:Gpumodelnamestring ;
    rdfs:range xsd:string .
hpc:replacewithunderscorecharacter a owl:ObjectProperty ;
    rdfs:domain hpc:Gpumodelnamestring ;
    rdfs:range xsd:string .
hpc:availablegpumodelnames a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:commandtofindavailablegpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Availablegpumodelnames ;
    rdfs:range xsd:string .

hpc:Gpumodel rdfs:subClassOf owl:Class .
hpc:ModelName rdfs:subPropertyOf hpc:GPUModel .
hpc:BrandName rdfs:subPropertyOf hpc:GPUModel .
hpc:ModelTypeName rdfs:subPropertyOf hpc:GPUModel .
hpc:TotalMemorySize rdfs:subPropertyOf hpc:GPUModel .
hpc:MemoryUnit rdfs:subPropertyOf hpc:TotalMemorySize .
hpc:GPUMemory rdfs:sub
