hpc:Project a owl:Class .
hpc:Cluster a owl:Class .
hpc:Licensescheduler a owl:Class .
hpc:demandlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range xsd:integer .
hpc:demand a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:demandconsiderationmode a owl:ObjectProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range xsd:integer .
hpc:Projectmode a owl:Class ;
    rdfs:subClassOf hpc:Demandconsiderationmode .
hpc:projectdemandreporting a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Project .
