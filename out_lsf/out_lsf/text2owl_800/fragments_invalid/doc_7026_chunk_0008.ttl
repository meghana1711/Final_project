hpc:Lsfcluster a owl:Class .
hpc:Securelsfcluster rdfs:subClassOf hpc:Lsfcluster .

hpc:replaceexecutablefile a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:File .

hpc:matchparametersinlsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:encryptcommandtransmission a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:restrictuseraccess a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:secureagainstfalserequests a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:customizeexternalauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:enableexternalauthenticationofdaemons a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:restrictrootaccessforbatchinteractivejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:restrictuseraccesstoadministrationcommands a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:jobinformationaccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:preventuserchangeofjobuser a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformationaccesscontrol ;
    rdfs:range xsd:Boolean .

hpc:temporarilyenablerootprivileges a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:Boolean .

hpc:viewclustersecuritysettings a owl:ObjectProperty ;
    rdfs:domain hdfs:SecureLSFCluster ;
    rdfs:range xsd:String .

hpc:changeremoteexecutionshell a owl:ObjectProperty ;
    rdfs:domain hpc:Securelsfcluster ;
    rdfs:range xsd:String .
