hpc:Managementhost a owl:Class .
hpc:Dynamichost a owl:Class .
hpc:Statichost a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:hhostdel an owl:ObjectProperty .
hpc:configureStaticHost an owl:ObjectProperty .
hpc:Sharedfilesystemenvironment a owl:Class .
hpc:Nonsharedfilesystemenvironment a owl:Class .
hpc:Lsfcluster a owl:Class .
hpc:LsfMasterList rdfs:domain hpc:Lsfcluster ;
    rdfs:range rdf:Resource .
hpc:LsfDynamicHostWaitTime rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:waitForAcknowledgmentFromLIM an owl:ObjectProperty .
hpc:announceSelfToLIM an owl:ObjectProperty .
hpc:ManagementHostLIM a hpc:ManagementHost .
hpc:Statichost rdfs:subClassOf hpc:Host .
hpc:Dynamichost rdfs:subClassOf hpc:Host .
hpc:Host rdfs:subClassOf owl:Class .
hpc:Hostgroup rdfs:subClassOf owl:Class .
hpc:Hhostdel rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Host .
hpc:Configurestatichost rdfs:domain hpc:Lsfcluster ;
    rdfs:range hpc:Statichost .
hpc:Sharedfilesystemenvironment rdfs:subClassOf owl:Class .
hpc:Nonsharedfilesystemenvironment rdfs:subClassOf owl:Class .
hpc:LSF_MASTER_LIST rdfs:subPropertyOf rdf:type .
hpc:LSF_DYNAMIC_HOST_WAIT_TIME rdfs:subPropertyOf rdf:type .
hpc:Waitforacknowledgmentfromlim rdfs:domain hpc:Dynamichost ;
    rdfs:range hpc:Managementhostlim .
hpc:Announceselftolim rdfs:domain hpc:Dynamichost .
