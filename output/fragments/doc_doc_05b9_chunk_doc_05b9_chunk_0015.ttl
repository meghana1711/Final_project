hpc:partition a owl:Class .
hpc:qos a owl:DatatypeProperty .
hpc:reason a owl:Class .
hpc:reservation a owl:Class .
hpc:reservationId a owl:DatatypeProperty .
hpc:state a owl:DatatypeProperty .
hpc:step a owl:DatatypeProperty .
hpc:endTime a xsd:dateTime .
hpc:startTime a xsd:dateTime .
hpc:node a owl:DatatypeProperty .
hpc:users a owl:Class .
hpc:wckey a owl:DatatypeProperty .

hpc:JobScript rdfs:subClassOf owl:Class .
hpc:showJobEnvironment rdfs:domain hpc:JobScript ;
                          rdfs:range rdf:List .
hpc:format rdfs:domain hpc:JobScript ;
                     rdfs:range xsd:string .
hpc:groups rdfs:domain hpc:JobScript ;
                 rdfs:range rdf:List .
hpc:jobName rdfs:domain hpc:JobScript ;
               rdfs:range xsd:string .
