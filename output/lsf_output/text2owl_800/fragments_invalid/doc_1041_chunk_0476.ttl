hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job in the system." .

hpc:jobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for a job." .

hpc:jobName a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the job, up to 4094 characters long." .

hpc:jobAttachmentDirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where job attachments are saved." .

hpc:Job_Attachment_Directory_Default a owl:NamedIndividual ;
    hpc:Job_Attachment_Directory rdf:value "LSB_SHAREDIR/info/" .

hpc:jobMessageIndex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs:comment "The index of the message to retrieve. The default is 0." .

hpc:Message_Index_Default a owl:NamedIndividual ;
    hpc:Message_Index rdf:value 0 .

hpc:notification a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether the message was sent to LSF Application Center Notifications." .

hpc:wideFormat a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:comment "Displays information without truncating fields." .

hpc:Job_Message_Index_Specified a owl:NamedIndividual ;
    hpc:Message_Index rdf:value -1 ;
    hpc:Wide_Format rdf:value true .

hpc:Job_Message_Index_Not_Specified a owl:NamedIndividual ;
    hpc:Message_Index rdf:value -1 ;
    hpc:Wide_Format rdf:value false .

hpc:jobNameWildcard a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Matches job names containing the wildcard character." .
