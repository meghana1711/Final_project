    rdfs:range rdf:* .
hpc:Liveconfiguration rdfs:subClassOf owl:Thing .
hpc:Usesconfigurationfile rdfs:domain hpc:Liveconfiguration ;
    rdfs:range rdf:* .
hpc:Setuidflag rdfs:domain hpc:Bctrld ;
    rdfs:range xsd:boolean .
hpc:Nonrootuser rdfs:subClassOf owl:Thing .
