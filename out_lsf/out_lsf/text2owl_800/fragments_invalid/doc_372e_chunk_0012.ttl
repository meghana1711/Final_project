hpc:Cluster a owl:Class .
hpc:Feature a owl:Class .
hpc:ClusterDistribution rdfs:domain hpc:Feature ;
                          rdfs:range rdf:List .
hpc:AllocBuffer rdfs:domain hpc:Feature ;
                   rdfs:range rdf:List .
hpc:Clustershare a owl:Class .
hpc:Minallocation rdfs:subClassOf hpc:Clustershare .
hpc:Maxallocation rdfs:subClassOf hpc:Clustershare .
hpc:hascluster a owl:ObjectProperty ;
                 rdfs:domain hpc:Clustershare ;
                 rdfs:range hpc:Cluster .
hpc:hasshare a owl:DatatypeProperty ;
                 rdfs:range xsd:integer .
hpc:hasallocationbuffer a owl:DatatypeProperty ;
                        rdfs:range rdf:List .
hpc:Cluster(tokyo_cl) a hpc:Cluster ;
                      hpc:hasShare 1 .
hpc:Cluster(newyork_cl) a hpc:Cluster ;
                      hpc:hasShare 1 .
hpc:Cluster(toronto_cl) a hpc:Cluster ;
                      hpc:hasShare 2 .
hpc:Mywanserver a owl:Class .
hpc:Mylan a owl:Class .
hpc:Mywan rdfs:subClassOf hpc:Mywanserver .
hpc:Mylan rdfs:subClassOf hpc:Cluster .
