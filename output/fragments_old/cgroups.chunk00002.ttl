hpc:Plugin a owl:Class .

# JobacctGatherType
hpc:JobacctGatherType a owl:DatatypeProperty ;
    rdfs:domain hpc:Plugin ;
    rdfs:range xsd:string .

# CgroupPlugin
hpc:CgroupPlugin a owl:Class ;
    rdfs:subClassOf hpc:Plugin .

# Cgroup
hpc:Cgroup a owl:Class .

# CgroupVersion1, CgroupVersion2
hpc:CgroupVersion1, hpc:CgroupVersion2 a owl:Class ;
    rdfs:subClassOf hpc:Cgroup .

# UnifiedMode, TopDownConstraint, NoInternalProcessConstraint
hpc:UnifiedMode, hpc:TopDownConstraint, hpc:NoInternalProcessConstraint a owl:ObjectProperty .

# SystemdDependency
hpc:SystemdDependency a owl:ObjectProperty ;
    rdfs:domain hpc:CgroupVersion2 ;
    rdfs:range hpc:Cgroup .

# ResourceSpecialization
hpc:ResourceSpecialization a owl:Class .

# Controller
hpc:Controller a owl:Class .

# MemoryController, FreezerController, DevicesController
hpc:MemoryController, hpc:FreezerController, hpc:DevicesController a owl:Class ;
    rdfs:subClassOf hpc:Controller .

# ControllerInterfaces
hpc:MemoryControllerInterface, hpc:FreezerControllerInterface a owl:ObjectProperty .

# MemoryLimitInBytes, MemorySoftLimitInBytes, MemoryMemswLimitInBytes, MemorySwappiness, FreezerState, CpuacctStat
hpc:MemoryLimitInBytes, hpc:MemorySoftLimitInBytes, hpc:MemoryMemswLimitInBytes, hpc:MemorySwappiness, hpc:FreezerState, hpc:CpuacctStat a owl:DatatypeProperty .

# CpuacctStatMetrics
hpc:CpuacctStatMetrics a owl:ObjectProperty ;
    rdfs:domain hpc:CpuacctStat ;
    rdfs:range xsd:double .

# CgroupControllers, CgroupSubtreeControl
hpc:CgroupControllers, hpc:CgroupSubtreeControl a owl:ObjectProperty .

# CgroupFreeze
hpc:CgroupFreeze a owl:ObjectProperty ;
    rdfs:domain hpc:FreezerController ;
    rdfs:range hpc:Cgroup .

# CpusetCpus, CpusetMems, CpusetCpusEffective, CpusetMemsEffective
hpc:CpusetCpus, hpc:CpusetMems, hpc:CpusetCpusEffective, hpc:CpusetMemsEffective a owl:DatatypeProperty .

# EbpfProgram
hpc:EbpfProgram a owl:ObjectProperty ;
    rdfs:domain hpc:DevicesController ;
    rdfs:range xsd:string .

# MemoryStat, CpuStat
hpc:MemoryStat, hpc:CpuStat a owl:DatatypeProperty .

# SwapAccount
hpc:SwapAccount a owl:ObjectProperty ;
    rdfs:domain h
