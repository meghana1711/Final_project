hpc:Host a owl:Class .
hpc:Pool a owl:Class .
hpc:Package a owl:Class .
hpc:TotalPackagesOfPool rdf:type owl:ObjectProperty .
hpc:TotalPackagesOfHost rdf:type owl:DatatypeProperty .
hpc:ContributedPackages rdf:type owl:DatatypeProperty .
hpc:FreePackages rdf:type owl:DatatypeProperty .
hpc:AvailablePackages rdf:type owl:DatatypeProperty .
hpc:TotalSlots rdf:type owl:DatatypeProperty .
hpc:MaxMemory rdf:type owl:DatatypeProperty .
hpc:TotalMemoryForLSFJobs rdf:type owl:ObjectProperty .
hpc:MemoryOccupiedByProcesses rdf:type owl:ObjectProperty .
hpc:FreeResources rdf:type owl:ObjectProperty .

hpc:Host rdfs:subClassOf owl:Class .
hpc:Pool rdfs:subClassOf owl:Class .
hpc:Package rdfs:subClassOf owl:Class .

hpc:Totalpackagesofpool rdfs:domain hpc:Pool ;
    rdfs:range xsd:integer .
hpc:Totalpackagesofhost rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Contributedpackages rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Freepackages rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Availablepackages rdfs:domain hpc:Pool ;
    rdfs:range xsd:integer .
hpc:Totalslots rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Maxmemory rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Totalmemoryforlsfjobs rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Memoryoccupiedbyprocesses rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:Freeresources rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:TotalPackagesOfPool owl:hasValueMaxCardinality 1 ;
    owl:inverseOf hpc:AvailablePackages .

hpc:TotalPackagesOfHost rdfs:subPropertyOf hpc:ContributedPackages ;
    owl:inverseOf hpc:FreePackages .

hpc:ContributedPackages rdfs:subPropertyOf hpc:TotalMemoryForLSFJobs ;
    owl:inverseOf hpc:MemoryOccupiedByProcesses .

hpc:TotalMemoryForLSFJobs rdf:type owl:CompositeObjectProperty ;
    rdf:first hpc:TotalSlots ;
    rdf:rest hpc:MaxMemory .

hpc:FreeResources rdf:type owl:CompositeObjectProperty ;
    rdf:first hpc:TotalSlots ;
    rdf:rest hpc:MaxMemory .
