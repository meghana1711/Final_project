hpc:timestamp a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:dateTime .

hpc:batchoperationcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:string .

hpc:User a owl:Class ;
    rdfs:subClassOf rdf:Plural .

hpc:user a owl:ObjectProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range hpc:User .

hpc:Sendinghost a owl:Class ;
    rdfs:subClassOf rdf:Plural .

hpc:sendinghost a owl:ObjectProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range hpc:Sendinghost .

hpc:maxdatasize a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:nonNegativeInteger .

hpc:requeststatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:nonNegativeInteger .

hpc:requestreceivedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:time .

hpc:requestprocessedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Logentry ;
    rdfs:range xsd:time .

hpc:Logentry a owl:Class .
