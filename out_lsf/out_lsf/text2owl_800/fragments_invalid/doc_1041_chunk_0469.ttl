hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Queueablejob ;
    rdfs:comment "A job in the queue." .

hpc:Rerunnablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job in the queue that can be restarted." .

hpc:Checkpointablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job in the queue that is checkpointable." .

hpc:checkpointdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the checkpoint directory." .

hpc:checkpointperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies the checkpoint period in seconds." .

hpc:CheckpointPeriodInMinutes owl:equivalentProperty hpc:CheckpointPeriod ;
    rdfs:comment "The checkpoint period is deﬁned in minutes." .

hpc:checkpointoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Checkpointablejob ;
    rdfs:comment "Indicates if a job is check-pointed." .

hpc:rerunnableoption a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Rerunnablejob ;
    rdfs:comment "Indicates if a job can be restarted." .

hpc:nopreemptinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The uninterrupted running time (minutes) that must pass before preemption is permitted." .

hpc:maxtotaltimepreempt a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum total preemption time (minutes) above which preemption is not permitted." .

hpc:jobcontrols a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobcontrols ;
    rdfs:comment "The configured actions for job control." .

hpc:adminactioncomment a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "If the LSF administrator specified an administrator comment." .

hpc:checkpointdirectoryspecified a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if CHKPNTDIR field is displayed." .

