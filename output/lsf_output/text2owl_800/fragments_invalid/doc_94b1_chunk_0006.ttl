hpc:PendingJob
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Job .

hpc:SuspendedHost
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Host .

hpc:PowerPolicySuspendedHost
    a owl:Class ;
    rdfs:subClassOf hpc:Suspendedhost ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subClassOf hpc:Powermanagedhost ] ) .

hpc:ManuallySuspendedHost
    a owl:Class ;
    rdfs:subClassOf hpc:Suspendedhost ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf ( hpc:Powerpolicysuspendedhost [ rdfs:subClassOf hpc:Host ] ) ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subPropertyOf hpc:Powerstate ] ; owl:hasValue "manual" ) .

hpc:ResumableHost
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subPropertyOf hpc:Powerstate ] ; owl:hasValue "suspended" ) ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subPropertyOf hpc:Powerstate ] ; owl:hasValue "suspended" ; rdf:value "by power policy" ) .

hpc:WorkingHost
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subPropertyOf hpc:Powerstate ] ; owl:hasValue "working" ) .

hpc:IdleHost
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Host ;
    rdfs:subClassOf ( hpc:Host [ rdfs:subPropertyOf hpc:Jobstate ] ; owl:hasValue "0" ) .

hpc:OkHost
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Host .

hpc:PowerSaveState
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ] ;
    rdfs:subClassOf hpc:Powerstate .

hpc:PowerResumeCmd
    a owl:ObjectProperty ;
    rdfs:domain hpc:Resumablehost ;
    rdfs:range xsd:string .

hpc:PowerResetCmd
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:
