   rdfs:domain hpc:Bhostscommands .
hpc:BhostsRconly rdfs:subClassOf hpc:Bhostscommands ;
   rdfs:domain hpc:Bhostscommands .

# LSF Resource Connector Configuration
hpc:Lsfresourceconnectorconfiguration a owl:Class .
hpc:LsfMqBrokerHosts rdfs:domain hpc:Lsfresourceconnectorconfiguration .

# LSF Multicluster Job Forwarding
hpc:Lsfmulticlusterjobforwarding a owl:Class .
hpc:Enhancedlsfmulticlusterjobforwarding rdfs:subClassOf hpc:Lsfmulticlusterjobforwarding ;
   rdfs:domain hpc:Lsfmulticlusterjobforwarding .

# LSF Data Manager Transfer Queue
hpc:Lsfdatamanagertransferqueue a owl:Class .
hpc:SndjobsTo rdfs:domain hpc:Lsfdatamanagertransferqueue .
hpc:RcvjobsFrom rdfs:domain hpc:Lsfdatamanagertransferqueue .
hpc:FileTransferCmd rdfs:domain hpc:Lsfdatamanagertransferqueue .

# Data Requirement Specification
