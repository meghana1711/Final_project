hpc:Project a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The project name." ;
    rdfs:label "PROJECT" ;
    rdfs:domain hpc:Project .

hpc:projectname a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "The project name." ;
    rdfs:label "projectName" .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The priority of the project if it is different from the default behavior. A larger number indicates a higher priority." ;
    rdfs:label "priority" .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string ;
    rdfs:comment "The description of the project." ;
    rdfs:label "description" .

hpc:Projectgroup a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The number of licenses that each project owns." ;
    rdfs:label "ProjectGroup" .

hpc:numownedlicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of licenses that each project owns." ;
    rdfs:label "numOwnedLicenses" .

hpc:maxconcurrentuses a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of licenses that the hierarchical group member project can use at any one time." ;
    rdfs:label "maxConcurrentUses" .

hpc:exclusivelicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of licenses that the hierarchical group member projects use exclusively." ;
    rdfs:label "exclusiveLicenses" .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The priority of the project if it is different from the default behavior. A larger number indicates a higher priority." ;
    rdfs:label "priority" .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The description of the project group." ;
    rdfs:label "description" .

hpc:Projectoutput a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Project Output with the -LP option, project mode" ;
    rdfs:label "ProjectOutput" .

hpc:projectMode a
