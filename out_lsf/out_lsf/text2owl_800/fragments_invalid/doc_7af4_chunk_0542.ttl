hpc:Jobslot a owl:Class .
hpc:Host a owl:Class .
hpc:Cpu a owl:Class .
hpc:Limitsection a owl:Class .
hpc:Queues a owl:Class .
hpc:PerHost a owl:Class .
hpc:slotsPerProcessor a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .

hpc:Jobslot rdfs:subClassOf hpc:Resourceconsumer .
hpc:Host rdfs:subClassOf hpc:Resourceprovider .
hpc:Cpu rdfs:subClassOf hpc:Resource .
hpc:Limitsection rdfs:subClassOf hpc:Configuration .
hpc:Queues rdfs:subClassOf hpc:Limitsection .
hpc:PerHost rdfs:subClassOf hpc:Limitsection .

hpc:Jobslot rdfs:domain hpc:Resourceconsumer .
hpc:Host rdfs:domain hpc:Resourceprovider .
hpc:Cpu rdfs:domain hpc:Resource .
hpc:Limitsection rdfs:domain hpc:Configuration .
hpc:Queues rdfs:domain hpc:Limitsection .
hpc:PerHost rdfs:domain hpc:Limitsection .

hpc:SlotsPerProcessor rdfs:range xsd:nonNegativeInteger .
hpc:Swp rdfs:range xsd:nonNegativeInteger .

hpc:hasCPUsOnHost owl:FunctionalProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:hasResources .

hpc:hasJobSlotsPerHost owl:FunctionalProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:hasResources .

hpc:hasJobSlotsPerProcessor owl:FunctionalProperty ;
    rdfs:domain hpc:Limitsection ;
    rdfs:range xsd:nonNegativeInteger .

hpc:hasSwapSpacePerResourceConsumer owl:FunctionalProperty ;
    rdfs:domain hpc:Resourceconsumer ;
    rdfs:range xd:nonNegativeInteger .

hpc:isAdjustedByMbatchd rdfs:property ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range xsd:boolean .

hpc:isLimitedBySWP rdfs:property ;
    rdfs:domain hpc:Resourceconsumer ;
    rdfs:range xsd:boolean .

hpc:isLimitedByQUEUES rdfs:property ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:Queues .

hpc:isLimitedByPER_HOST rdfs:property ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:PerHost .

hpc:isLimitedByUSERS rdfs:property ;
    rdfs:domain hpc:Jobslot ;
    rdfs:range hpc:Users .

hpc:isLim
