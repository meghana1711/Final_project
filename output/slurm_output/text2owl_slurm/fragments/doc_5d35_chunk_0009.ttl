hpc:Joballocation a owl:Class .
hpc:hasjobid a owl:ObjectProperty .
hpc:hashetsize a owl:DatatypeProperty .
hpc:hashetgroup a owl:ObjectProperty .
hpc:getnodelisthetgroup a owl:ObjectProperty .
hpc:isnodehetgroup a owl:ObjectProperty .
hpc:getnodelist a owl:ObjectProperty .
hpc:isnode a owl:ObjectProperty .
hpc:hasfeature a owl:ObjectProperty .
hpc:Memory a xsd:nonNegativeInteger .
hpc:Cores a xsd:nonNegativeInteger .

hpc:Joballocation rdfs:subClassOf owl:Class .
hpc:Hasjobid rdfs:domain hpc:Joballocation ;
                                rdfs:range xsd:integer .
hpc:Hashetsize rdfs:domain hpc:Joballocation ;
                                rdfs:range xsd:nonNegativeInteger .
hpc:Hashetgroup rdfs:domain hpc:Joballocation ;
                                rdfs:range xsd:integer .
hpc:Getnodelisthetgroup rdfs:domain hpc:Joballocation ;
                                rdfs:range xsd:integer .
hpc:Isnodehetgroup rdfs:domain hpc:Node ;
                                rdfs:range hpc:Joballocation .
hpc:Getnodelist rdfs:domain hpc:Node ;
                                rdfs:range xsd:string .
hpc:Isnode rdfs:domain hpc:Node ;
                                rdfs:range hpc:Joballocation .
hpc:Hasfeature rdfs:domain hpc:Node ;
                                rdfs:range xsd:string .
hpc:Memory rdfs:subPropertyOf hpc:hasResource .
hpc:Cores rdfs:subPropertyOf hpc:hasResource .
