hpc:Compilation a owl:Class .
hpc:compilestep a owl:ObjectProperty .
hpc:cleanup a owl:ObjectProperty .
hpc:link a owl:ObjectProperty .
hpc:install a owl:ObjectProperty .

hpc:Compilestep rdfs:domain hpc:Compilation .
hpc:Cleanup rdfs:domain hpc:Compilation .
hpc:Link rdfs:domain hpc:Compilation .
hpc:Install rdfs:domain hpc:Compilation .

hpc:Compilation rdfs:subClassOf owl:Class .
hpc:Compilestep rdfs:subClassOf hpc:Compilation .
hpc:Cleanup rdfs:subClassOf hpc:Compilation .
hpc:Link rdfs:subClassOf hpc:Compilation .
hpc:Install rdfs:subClassOf hpc:Compilation .

hpc:Compilestep rdfs:range rdf:List ;
    rdfs:range xsd:string ;
    rdfs:range hpc:Compilestepargument .

hpc:Cleanup rdfs:range rdf:List .

hpc:compilestepargument a owl:DatatypeProperty .
hpc:Compilestepargument rdfs:domain hpc:Compilestep .
hpc:Compilestepargument rdfs:range xsd:string .

hpc:linkargument a owl:DatatypeProperty .
hpc:Linkargument rdfs:domain hpc:Link .
hpc:Linkargument rdfs:range xsd:string .

hpc:installargument a owl:DatatypeProperty .
hpc:Installargument rdfs:domain hpc:Install .
hpc:Installargument rdfs:range xsd:string .
