hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A job in the HPC system." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A queue in the HPC system." .

hpc:Submissioncluster a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The cluster from which jobs are submitted." .

hpc:Executioncluster a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The cluster where jobs are executed." .

hpc:Remotecluster a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A remote cluster where jobs can be executed." .

hpc:brun a owl:ObjectProperty ;
    rdfs:domain hpc:Administrator ;
    rdfs:range hpc:Job ;
    rdfs:comment "Forces a pending or finished job to run or be forwarded to a specified cluster." .

hpc:host a owl:DatatypeProperty ;
    rdfs:domain hpc:Brun ;
    rdfs:range xsd:string ;
    rdfs:comment "The host name where the job is to be run." .

hpc:cluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Brun ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the cluster where the job is to be run." .

hpc:pendingjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "A job that is currently pending." .

hpc:availablehost a owl:ObjectProperty ;
    rdfs:domain hpc:Remotecluster ;
    rdfs:range hpc:Host ;
    rdfs:comment "The first available host in a remote cluster." .

hpc:specifiedhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Brun ;
    rdfs:range rdf:List ;
    rdfs:comment "The hosts specified when forcing a job to run." .

hpc:belongtoonecluster a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster ;
    rdfs:comment "A host can belong to only one cluster." .

hpc:cannotspecifytogether a owl:ObjectProperty ;
    rdfs:domain hpc:Brun ;
    rdfs:range rdf:List ;
    rdfs:comment "Host names and cluster names cannot be specified together in the same brun command." .

hpc:returnedtosubmissioncluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Submissioncluster ;
    rdfs:comment "A job pending in an execution cluster, forced to run in a different cluster, is returned to the submission cluster." .

hpc:forwardedonce a owl:ObjectProperty ;
