hpc:SlurmDaemonSupportsVersion a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmDaemon ;
    rdfs:range hpc:SlurmVersion .
hpc:SlurmVersionDesignatesMaintenanceRelease a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmVersion .
hpc:SlurmVersionMatchesReleaseYearMonth a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmVersion .
hpc:SlurmNodeHasStateInformation a owl:ObjectProperty .
