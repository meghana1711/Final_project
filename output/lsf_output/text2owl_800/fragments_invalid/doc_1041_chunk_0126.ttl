hpc:Usergroupadministrator a owl:Class .
hpc:Fullrights a owl:Class .
hpc:Usershare a owl:Class .
hpc:Groupmember a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Groupadminlist a owl:Class .

hpc:hasFullRights an rdfs:subPropertyOf rdf:type .
hpc:Hasusergroup an rdfs:domain hpc:Usergroupadministrator ;
                      rdfs:range hpc:Usergroup .
hpc:Hasgroupmember an rdfs:domain hpc:Usergroupadministrator ;
                     rdfs:range hpc:Groupmember .
hpc:Isgroupadminlistmember an rdfs:domain hpc:Usergroup ;
                             rdfs:range hpc:Usergroupadministrator .

hpc:hasFullRightsForGroup an rdfs:subPropertyOf hpc:hasFullRights .
hpc:Hasfullrightsforusergroup an rdfs:domain hpc:Usergroupadministrator ;
                                 rdfs:range hpc:Usergroup .
hpc:canAddGroupMember an rdfs:subPropertyOf hpc:hasFullRightsForGroup .
hpc:canAddGroupMemberIfHasFullRightsForMemberUserGroup an rdfs:subPropertyOf hpc:canAddGroupMember .

hpc:createUserGroup an rdfs:subPropertyOf hpc:hasFullRightsForGroup .
hpc:deleteUserGroup an rdfs:subPropertyOf hpc:hasFullRightsForGroup .
hpc:adjustUserShares an rdfs:subPropertyOf hpc:hasFullRightsForGroup .

hpc:Lsbresources a owl:Class .
hpc:Lsbqueues a owl:Class .
hpc:Lsbusers a owl:Class .
hpc:Lshosts a owl:Class .
hpc:Lsfclusterclustername a owl:Class .
hpc:Lsbserviceclasses a owl:Class .

hpc:canChangeConfiguration an rdfs:subPropertyOf rdf:type .
hpc:Canchangelsbresources an rdfs:domain hpc:Usergroupadministrator with hpc:Fullrights ;
                                 rdfs:range hpc:Lsbresources .
hpc:Canchangelsbqueues an rdfs:domain hpc:Usergroupadministrator with hpc:Fullrights ;
                                 rdfs:range hpc:Lsbqueues .
hpc:Canchangelsbusers an rdfs:domain hpc:Usergroupadministrator with hpc:Fullrights ;
                                 rdfs:range hpc:Lsbusers .
hpc:Canchangelshosts an rdfs:domain hpc:Usergroupadministrator with hpc:Fullrights ;
                                 rdfs:range hpc:Lshosts .
hpc:Canchangelsfclusterclustername an rdfs:domain hpc:Usergroupadministrator with hpc:Fullrights ;
                                 rdfs:range hpc:Lsfclusterclustername .
