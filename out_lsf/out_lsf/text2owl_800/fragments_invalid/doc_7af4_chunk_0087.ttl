hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A job in the HPC system." .

hpc:preexecutioncommandfailure a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Boolean ;
    rdfs:comment "Indicates if the job's pre-execution command fails all attempts." .

hpc:infiniteinteger a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparameters ;
    rdfs:range xsd:integer ;
    rdfs:comment "Defined in lsf.h. Default value for some parameters." .

hpc:maxTotalTimePreempt a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparameters ;
    rdfs:range xsd:integer ;
    rdfs:comment "The accumulated preemption time in minutes after which a job cannot be preempted again." .

hpc:Lsbparameters a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Parameters defined in lsb." .

hpc:osmemorylimitenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimitenforcementmethod ;
    rdfs:range hpc:Memorylimitenforcement ;
    rdfs:comment "The method of enforcing memory usage by the OS." .

hpc:Osmemorylimitenforcementmethod a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The default method of enforcing memory usage by the OS." .

hpc:lslimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The limit specified in KB, MB, GB, TB, PB, or EB." .

hpc:Memorylimit a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The limit of physical memory (resident set size, RSS) that may be allocated to a process." .

hpc:Memorylimitenforcement a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The methods used by LSF to enforce memory usage." .

hpc:softlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range hpc:Memorylimit ;
    rdfs:comment "The soft limit of the physical memory (resident set size, RSS) that may be allocated to a process." .

hpc:hardlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range hpc:Memorylimit ;
    rdfs:comment "The hard limit of the physical memory (resident set size, RSS) that may be allocated to a process." .

hpc:memlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer ;
    rdfs
