hpc:Account a owl:Class .
hpc:ParentAccount owl:Class .
hpc:FairShareFactor a owl:Class .
hpc:UsageImbalance a owl:Class .

hpc:hasParent a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:ParentAccount .

hpc:hasFairShareFactor a owl:ObjectProperty ;
    rdfs:domain hpc:Account .

hpc:hasUsageImbalance a owl:DatatypeProperty ;
    rdfs:domain hpc:Account .
    rdfs:range xsd:decimal .

hpc:DepthOblivious a owl:Class .
hpc:hasDepthObliviousConfig a owl:ObjectProperty ;
    rdfs:domain hpc:Account .

hpc:PriorityFlags a owl:Class .
hpc:hasPriorityFlags a owl:DatatypeProperty ;
    rdfs:domain hpc:DepthOblivious .
    rdfs:range xsd:string .

hpc:PriorityType a owl:Class .
hpc:hasPriorityType a owl:DatatypeProperty ;
    rdfs:domain hpc:DepthOblivious .
    rdfs:range xsd:string .

hpc:DEPTH_OBLIVIOUS a hpc:PriorityFlags .
hpc:priority_multifactor a hpc:PriorityType .

hpc:Rparent a xsd:decimal .
hpc:k a xsd:decimal .

hpc:TendsTowardsOne rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:Rparent ;
    rdfs:range hpc:k ;
    rdfs:subPropertyOf owl:implies .

hpc:TendsTowardsZero rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:Rparent ;
    rdfs:range hpc:k ;
    rdfs:subPropertyOf owl:implies .

hpc:GetBonusOrMalus rdf:type owl:FunctionalProperty ;
    rdfs:domain (hpc:UsageImbalance hpc:ParentAccount) ;
    rdfs:range hpc:k ;
    rdfs:subPropertyOf owl:implies .

hpc:NoHelp rdf:type owl:FunctionalProperty ;
    rdfs:domain (hpc:UsageImbalance hpc:ParentAccount) ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:implies .

hpc:KeepAtOne rdf:type owl:FunctionalProperty ;
    rdfs:domain hpc:k ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:implies .
```
