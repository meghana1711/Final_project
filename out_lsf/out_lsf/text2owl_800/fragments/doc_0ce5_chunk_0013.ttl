hpc:Mbatchd a owl:Class .
hpc:Queryrequest a owl:Class .
hpc:Thread a owl:Class .
hpc:portnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .
hpc:Jobstatus a owl:Class .
hpc:querycommand a owl:ObjectProperty ;
    rdfs:domain hpc:Queryrequest ;
    rdfs:range hpc:Querycommand .
hpc:lsbQueryEnh a owl:ObjectProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:boolean .
hpc:bread a hpc:QueryCommand .
hpc:bstatus a hpc:QueryCommand .
hpc:tspeek a hpc:QueryCommand .
hpc:lsbQueryPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .
hpc:mbdRefreshTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .
hpc:minRefreshTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchd ;
    rdfs:range xsd:integer .
hpc:MBD_REFRESH_TIME_Range a owl:Restriction ;
    rdfs:domain hpc:MbdRefreshTime ;
    owl:onProperty hpc:MBD_REFRESH_TIME ;
    owl:hasValue xsd:integer ;
    owl:minValue xsd:integer ;
    owl:maxValue 300 .
hpc:min_refresh_time_Range a owl:Restriction ;
    rdfs:domain hpc:MinRefreshTime ;
    owl:onProperty hpc:min_refresh_time ;
    owl:hasValue xsd:integer ;
    owl:minValue 0 ;
    owl:maxValue 10 .
hpc:Childmbatchd a owl:Class ;
    rdfs:subClassOf hpc:Mbatchd .
hpc:queryrequestprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Childmbatchd ;
    rdfs:range hpc:Thread .
hpc:jobchangestatus a owl:ObjectProperty ;
    rdfs:domain hpc:Childmbatchd ;
    rdfs:range hpc:Job .
hpc:newjobsubmitted a owl:ObjectProperty ;
    rdfs:domain hpc:Childmbatchd ;
    rdfs:range hpc:Job .
hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:MbdRefreshTime ;
    rdfs:range xsd:integer .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:orphanjobtermination a owl:ObjectProperty ;
    rdfs:domain hpc:Pendingjob ;
    rdfs:range hpc:Childmbatchd .
