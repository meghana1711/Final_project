hpc:Borrowedhost a owl:Class .
hpc:CanPingHostName an owl:ObjectProperty .
hpc:Dnssettings a owl:Class .
hpc:Firewallsettings a owl:Class .
hpc:Lsfports a owl:Class .
hpc:Lsfmanagementhost a owl:Class .
hpc:Borrowedserverhost a owl:Class .
hpc:lsfStripDomain a owl:DatatypeProperty .
hpc:Resourceconnector a owl:Class .
hpc:schmodDemand a owl:ObjectProperty .
hpc:Pluginmodule a owl:Class .
hpc:AwsEnableScript a owl:Class .
hpc:Awshost a owl:Class .

hpc:Borrowedhost rdfs:subClassOf rdf:Resource .
hpc:Canpinghostname rdfs:domain hpc:Borrowedhost ;
                     rdfs:range xsd:boolean .
hpc:Dnssettings rdfs:subClassOf rdf:Resource .
hpc:Firewallsettings rdfs:subClassOf rdf:Resource .
hpc:Lsfports rdfs:subClassOf rdf:Resource .
hpc:Lsfmanagementhost rdfs:subClassOf rdf:Resource .
hpc:Borrowedserverhost rdfs:subClassOf rdf:Resource .
hpc:LsfStripDomain rdfs:domain hpc:Lsfmanagementhost ;
                      rdfs:range xsd:string .
hpc:Resourceconnector rdfs:subClassOf rdf:Resource .
hpc:SchmodDemand rdfs:domain hpc:Resourceconnector ;
                    rdfs:range hpc:Pluginmodule .
hpc:Pluginmodule rdfs:subClassOf rdf:Resource .
hpc:AwsEnableScript rdfs:subClassOf rdf:Resource .
hpc:Awshost rdfs:subClassOf rdf:Resource .
