hpc:CopyLSFPackage
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of copying the LSF package to the IBM Cloud Gen 2 host." .

hpc:LSFPackage
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The LSF package files required for installation." .

hpc:InstallRequiredSoftware
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of installing the required software for LSF on the instance." .

hpc:SetUpFirewallCommunications
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of setting up firewall communications for LSF on the instance." .

hpc:OpenLSFLSFPort
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Setupfirewallcommunications ;
    rdfs:range xsd:integer ;
    rdfs:comment "The port number to be opened for LSF_LIM_PORT." .

hpc:OpenLSFResPort
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Setupfirewallcommunications ;
    rdfs:range xsd:integer ;
    rdfs:comment "The port number to be opened for LSF_RES_PORT." .

hpc:OpenLSBSDPort
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Setupfirewallcommunications ;
    rdfs:range xsd:integer ;
    rdfs:comment "The port number to be opened for LSB_SBD_PORT." .

hpc:LoginToInstance
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of logging in to the instance." .

hpc:SwitchToRoot
    a owl:ObjectProperty ;
    rdfs:domain hpc:Logintoinstance ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The action of switching to the root user after logging in." .
