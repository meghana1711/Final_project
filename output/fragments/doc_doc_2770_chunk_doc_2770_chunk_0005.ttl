hpc:MaxJobTest a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#integer> .

hpc:MaxJobUser a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#integer> .

hpc:MaxTime a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillScheduler ;
    rdfs:range xsd:integer .

hpc:MaxTimeDefault a xsd:integer ;
    hpc:MaxTime rdfs:seeAlso hpc:bf_max_time .

hpc:OneResvPerJob a owl:ObjectProperty ;
    rdfs:domain hpc:BackfillScheduler ;
    rdfs:range hpc:Job .

hpc:Resolution a owl:DatatypeProperty ;
    rdfs:domain hpc:BackfillScheduler ;
    rdfs:range xsd:integer .

hpc:ResolutionDefault a xsd:integer ;
    hpc:Resolution rdfs:seeAlso hpc:bf_resolution .
```
