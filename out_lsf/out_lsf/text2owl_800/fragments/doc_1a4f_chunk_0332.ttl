hpc:Globalresourcedistributionpolicy a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Globalresourcedistributionpolicy ;
    rdfs:range xsd:string .
hpc:distribute a owl:ObjectProperty ;
    rdfs:domain hpc:Globalresourcedistributionpolicy ;
    rdfs:range xsd:string .
hpc:policy a owl:ObjectProperty ;
    rdfs:domain hpc:Globalresourcedistributionpolicy ;
    rdfs:range hpc:Distributionpolicy .
hpc:DistributionPolicy a owl:Enum ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Specify the distribution policy for global resources and global limits." .
hpc:Evenly a hpc:DistributionPolicy .
hpc:Compete a hpc:DistributionPolicy .
