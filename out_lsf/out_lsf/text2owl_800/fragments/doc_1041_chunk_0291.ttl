hpc:execcwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Multicluster ;
    rdfs:range xsd:string .

hpc:licproject a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:License a owl:Class .

hpc:forwardcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:forwardtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:Fwdcluster rdfs:subClassOf hpc:Cluster .

hpc:srcjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:dstjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:sourcecluster a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Cluster .

hpc:Energy a owl:Class .
