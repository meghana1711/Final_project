@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Serviceclass a owl:Class.
hpc:slathroughput a owl:ObjectProperty.
hpc:optimumnumberofrunningjobs a owl:DatatypeProperty.
hpc:serviceclassname a owl:DatatypeProperty.
hpc:priority a owl:DatatypeProperty.
hpc:goal a owl:DatatypeProperty.
hpc:activewindow a owl:DatatypeProperty.
hpc:status a owl:DatatypeProperty.
hpc:njobspendrunssuspususpfinish a owl:DatatypeProperty.

hpc:Slathroughput rdfs:domain hpc:Serviceclass;
    rdfs:range xsd:decimal.

hpc:Opt
