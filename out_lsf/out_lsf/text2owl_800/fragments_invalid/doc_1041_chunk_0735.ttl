    rdfs:range hpc:Job .
hpc:Jobstate rdfs:domain hpc:Resizablejob .
hpc:Thresholdconfiguration rdfs:range hpc:Configuration .
hpc:Runlimit rdfs:range xsd:decimal .
hpc:Cpulimit rdfs:range xsd:decimal .
hpc:Queuelevelresourcerequirements rdfs:range hpc:Configuration .
hpc:multiphaserusagestringresourcerequirement a owl:DatatypeProperty .
