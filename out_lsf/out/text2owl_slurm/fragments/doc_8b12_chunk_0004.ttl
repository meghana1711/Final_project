hpc:Sdiag a owl:Class .
hpc:hasstatistics a owl:ObjectProperty .
hpc:Timeseriesdatabase rdfs:subClassOf hpc:Datastorage .
hpc:Graphingtool rdfs:subClassOf hpc:Softwaretool .
hpc:Diamondcollector a owl:Class .
hpc:Collectd a owl:Class .
hpc:json a owl:DatatypeProperty ;
    rdfs:domain hpc:Diamondcollector ;
    rdfs:range xsd:string .
hpc:Slurmplugin a owl:Class .
hpc:jsonc a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmplugin ;
    rdfs:range xsd:string .
hpc:buildinstructions a owl:ObjectProperty .
hpc:library a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmplugin ;
    rdfs:range xsd:string .
hpc:packageconfigurationpath a owl:ObjectProperty .
hpc:Slurm a owl:Class .
hpc:httpparser a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:libhttpParser a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
