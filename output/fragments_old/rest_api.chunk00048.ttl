hpc:Type a owl:Class .

hpc:Account a owl:Class ;
    rdfs:subClassOf hpc:Type ;
    rdfs:domain hpc:Type ;
    rdfs:range [ a owl:Class ;
        rdf:type owl:Restriction ;
        owl:onProperty hpc:type ;
        owl:allValuesFrom hpc:Type ].

hpc:WallClock a owl:Class ;
    rdfs:subClassOf hpc:Type .

hpc:QOS a owl:Class ;
    rdfs:subClassOf hpc:WallClock ;
    rdfs:domain hpc:WallClock ;
    rdfs:range [ a owl:Class ;
        rdf:type owl:Restriction ;
        owl:onProperty hpc:per ;
        owl:allValuesFrom ( [ a owl:Class ;
            rdf:type owl:Restriction ;
            owl:onProperty hpc:qos ;
            owl:allValuesFrom xsd:integer ] , [ a owl:Class ;
            rdf:type owl:Restriction ;
            owl:onProperty hpc:job ;
            owl:allValuesFrom xsd:integer ] ) ].

hpc:ActiveJobs a owl:Class ;
    rdfs:subClassOf hpc:Type ;
    rdfs:domain hpc:Type ;
    rdfs:range [ a owl:Class ;
        rdf:type owl:Restriction ;
        owl:onProperty hpc:active_jobs ;
        owl:allValuesFrom ( [ a owl:Class ;
            rdf:type owl:Restriction ;
            owl:onProperty hpc:count ;
            owl:allValuesFrom xsd:integer ] , [ a owl:Class ;
            rdf:type owl:Restriction ;
            owl:onProperty hpc:accruing ;
            owl:allValuesFrom xsd:integer ] ) ].

hpc:Factor a owl:DatatypeProperty ;
    rdfs:domain hpc:Type ;
    rdfs:range xsd:decimal .

hpc:GraceTime a xsd:integer .

hpc:Preempt a owl:Class ;
    rdfs:subClassOf hpc:Type .

hpc:PreemptMode a owl:Class ;
    rdfs:subClassOf hpc:Preempt ;
    rdfs:domain hpc:Preempt ;
    rdfs:range rdf:PlainLiteral .

hpc:ExemptTime a owl:Class ;
    rdfs:subClassOf hpc:Preempt ;
    rdfs:domain hpc:Preempt ;
    rdfs:range [ a owl:Class ;
        rdf:type owl:Restriction ;
        owl:onProperty hpc:exempt_time ;
        owl:allValuesFrom ( xsd:integer , xsd:decimal ) ].

hpc:Limit a owl:Class ;
