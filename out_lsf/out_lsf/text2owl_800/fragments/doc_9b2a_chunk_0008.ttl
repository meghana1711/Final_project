hpc:Statusreport a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a status report for a feature collection." .

hpc:Token a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a token in the context of feature collection." .

hpc:Licenseserver a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a license server." .

hpc:collecttoken a owl:ObjectProperty ;
    rdfs:domain hpc:Statusreport ;
    rdfs:range hpc:Token ;
    rdfs:comment "Relates a status report to the token it collected." .

hpc:licenseserver a owl:ObjectProperty ;
    rdfs:domain hpc:Statusreport ;
    rdfs:range hpc:Licenseserver ;
    rdfs:comment "Relates a status report to the license server used for collecting tokens." .

hpc:numberoftokens a owl:DatatypeProperty ;
    rdfs:domain hpc:Statusreport ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Represents the number of tokens collected in a status report." .

hpc:tokenname a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the name of a token." .

hpc:Logfile a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a log file." .

hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the log level of a log file." .

hpc:temporarilychangeloglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range hpc:Loglevelchange ;
    rdfs:comment "Relates a log file to a temporary change in its log level." .

hpc:Loglevelchange a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a temporary change in the log level of a log file." .

hpc:lsLogMask a owl:DatatypeProperty ;
    rdfs:domain hpc:Licensescheduler ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the log mask for a License Scheduler." .

hpc:Licensescheduler a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Represents a License Scheduler." .
