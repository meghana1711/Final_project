hpc:Host a owl:Class .
hpc:Attribute a owl:Class .
hpc:createattr a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:createAttr .
hpc:deleteattr a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List .
hpc:showattr a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute ;
    rdfs:range xsd:string .
hpc:room103 a hpc:Attribute ;
    hpc:description "Hosts in room 103" .
