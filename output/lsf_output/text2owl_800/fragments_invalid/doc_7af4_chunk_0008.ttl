@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:LSF_ENVDIR
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasLSF_ENVDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfEnvdir ;
    rdfs:range xsd:string .

hpc:hasValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEnvdir ;
    rdfs:range xsd:string .

hpc:LSF_LIBDIR
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasLSF_LIBDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfLibdir ;
    rdfs:range xsd:string .

hpc:hasValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfLibdir ;
    rdfs:range xsd:string .

hpc:LSF_SERVERDIR
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasLSF_SERVERDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:LsfServerdir ;
    rdfs:range xsd:string .

hpc:hasValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfServerdir ;
    rdfs:range xsd:string .

hpc:EGO_BINDIR
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf owl:NamedIndividual ] .

hpc:hasEGO_BINDIR
    a owl:ObjectProperty ;
    rdfs:domain hpc:EgoBindir ;
    rdfs:range xsd:string .

hpc:hasValue
    a owl:DatatypeProperty ;
    rdfs:domain hpc:EgoBindir ;
    rdfs:range xsd:string .
