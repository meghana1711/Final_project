hpc:Awsinstance a owl:Class .
hpc:Lsbrcexternalhost a owl:Class .
hpc:Lsfconffile a owl:Class .
hpc:Hostfactory a owl:Class .
hpc:Hostproviderjsonfile a owl:Class .
hpc:Resourceconnector a owl:Class .
hpc:idletime a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbrcexternalhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ttl a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbrcexternalhost ;
    rdfs:range xsd:nonNegativeInteger .
hpc:billingperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostproviderjsonfile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:launchedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Awsinstance ;
    rdfs:range xsd:dateTime .
hpc:joinedcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Hostfactory ;
    rdfs:range hpc:Lsbrcexternalhost .
hpc:closedrcstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range hpc:Lsbrcexternalhost .
hpc:drainedofjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range hpc:Lsbrcexternalhost .
hpc:notifiesresourceconnector a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range hpc:Resourceconnector .
hpc:deallocateshost a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range hpc:Awsinstance .
hpc:LsbRcExternalHost subClassOf owl:Class .
hpc:LsbRcExternalHostIdleTime rdfs:subPropertyOf hpc:IdleTime .
hpc:LsbRcExternalHostMaxTtl rdfs:subPropertyOf hpc:Ttl .
hpc:Lsbrcexternalhostmaxttl rdfs:subClassOf hpc:Idletime .
hpc:Lsbrcexternalhostidletime rdfs:subClassOf hpc:Ttl .
