hpc:Host a owl:Class .
hpc:hostname a owl:DatatypeProperty .
hpc:model a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:Server a owl:Class .
hpc:Client a owl:Class .
hpc:Resource a owl:Class .
hpc:rexpri a owl:ObjectProperty .

# Object Properties
hpc:Rexpri rdfs:domain hpc:Resource .
hpc:Rexpri rdfs:range hpc:Rexpri .

# Datatype Properties
hpc:Host rdfs:subClassOf owl:Class .
hpc:Host rdfs:subClassOf hpc:Hostname rdfs:and
                          hpc:Model rdfs:and
                          hpc:Type rdfs:and
                          hpc:Server rdfs:or
                          hpc:Client rdfs:or .

hpc:Hostname rdfs:domain hpc:Host .
hpc:Model rdfs:domain hpc:Host .
hpc:Type rdfs:domain hpc:Host .
hpc:Server rdfs:domain hpc:Host .
hpc:Client rdfs:domain hpc:Host .

hpc:Hostname rdfs:range xsd:string .
hpc:Model rdfs:range xsd:string .
hpc:Type rdfs:range xsd:integer .
hpc:Server rdfs:range xsd:integer .
hpc:Client rdfs:range xsd:integer .

hpc:Resource rdfs:subClassOf owl:Class .
hpc:Resource rdfs:subClassOf rdfs:sequence .
hpc:Resource rdfs:subClassOf (hpc:Rexpri rdf:first) .
hpc:Resource rdfs:subClassOf (hpc:Rexpri rdf:rest) .

hpc:Rexpri rdfs:domain hpc:Resource .
hpc:Rexpri rdfs:range (hpc:Rexpri rdf:first) rdf:union
                      (hpc:REXPRI rdf:rest) .
