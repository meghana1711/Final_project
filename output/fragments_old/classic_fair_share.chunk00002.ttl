# Classes
hpc:Account a owl:Class .
hpc:User a owl:Class .
hpc:ChildAccount a owl:Class .
hpc:ParentAccount a owl:Class .

# Object Properties
hpc:hasShares a owl:ObjectProperty .
hpc:hasNormalizedShares a owl:ObjectProperty .
hpc:hasUsage a owl:ObjectProperty .
hpc:hasEffectiveUsage a owl:ObjectProperty .

# Datatype Properties
hpc:shares a owl:DatatypeProperty .
hpc:normalizedShares a owl:DatatypeProperty .
hpc:usage a owl:DatatypeProperty .
hpc:effectiveUsage a owl:DatatypeProperty .

# Domain and Range
hpc:hasShares rdfs:domain hpc:Account ;
          rdfs:range xsd:decimal .
hpc:hasNormalizedShares rdfs:domain hpc:Account ;
          rdfs:range xsd:decimal .
hpc:hasUsage rdfs:domain hpc:User ;
          rdfs:range xsd:decimal .
hpc:hasEffectiveUsage rdfs:domain hpc:Account ;
          rdfs:range xsd:decimal .

# Subclass relations
hpc:ChildAccount rdfs:subClassOf hpc:Account .
hpc:ParentAccount rdfs:subClassOf hpc:Account .

# Example instances
hpc:AccountA a hpc:Account ;
          hpc:shares "40"^^xsd:decimal ;
          hpc:hasChild hpc:AccountB .
hpc:AccountD a hpc:Account ;
          hpc:shares "60"^^xsd:decimal ;
          hpc:hasChild hpc:AccountE ;
          hpc:hasChild hpc:AccountF .
hpc:AccountB a hpc:ChildAccount ;
          hpc:shares "30"^^xsd:decimal ;
          hpc:hasChild hpc:AccountC .
hpc:AccountC a hpc:ChildAccount ;
          hpc:shares "10"^^xsd:decimal .
hpc:AccountE a hpc:ChildAccount ;
          hpc:shares "25"^^xsd:decimal .
hpc:AccountF a hpc:ChildAccount ;
          hpc:shares "35"^^xsd:decimal .

hpc:User1 a hpc:User ;
          hpc:hasAccount hpc:AccountB ;
          hpc:usage "0.2"^^xsd:decimal .
hpc:User2 a hpc:User ;
          hpc:hasAccount hpc:AccountC
