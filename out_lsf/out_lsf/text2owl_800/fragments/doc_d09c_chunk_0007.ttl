hpc:Workloadpartition a owl:Class .
hpc:providessolution a owl:ObjectProperty .
hpc:Providessolution rdfs:domain hpc:Workloadpartition ;
                      rdfs:range hpc:Environment .
hpc:Environment a owl:Class .
hpc:iswithin a owl:ObjectProperty .
hpc:Iswithin rdfs:domain hpc:Workloadpartition ;
                 rdfs:range hpc:Aixoperatinginstance .
hpc:Aixoperatinginstance a owl:Class .
hpc:executesin a owl:ObjectProperty .
hpc:Executesin rdfs:domain hpc:Workloadpartition ;
                 rdfs:range hpc:Lparormicropartition .
hpc:Lparormicropartition a owl:Class .
