hpc:Alternativeresourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:Resourcerequirement a owl:Class .
hpc:hasresourcerequirement a owl:ObjectProperty .

hpc:Alternativeresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Compoundresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .

hpc:Hasresourcerequirement rdfs:domain hpc:Job .
hpc:Hasresourcerequirement rdfs:range hpc:Resourcerequirement .

hpc:Resourcerequirement a owl:Class ;
  rdfs:subClassOf [ a owl:Restriction ;
                     owl:onProperty hpc:hasResourceRequirement ;
                     owl:hasValue (xsd:string "taskman"^^xsd:string) ;
                     owl:allValuesFrom (a owl:Class ;
                                         rdfs:subClassOf [ a owl:Restriction ;
                                                           owl:onProperty hpc:rusage ;
                                                           owl:hasValue (xsd:decimal "2"^^xsd:decimal) ]) ] .

hpc:Resourcerequirement a owl:Class ;
  rdfs:subClassOf [ a owl:Restriction ;
                     owl:onProperty hpc:hasResourceRequirement ;
                     owl:hasValue (xsd:string "taskman"^^xsd:string) ;
                     owl:allValuesFrom (a owl:Class ;
                                         rdfs:subClassOf [ a owl:Restriction ;
                                                           owl:onProperty hpc:rusage ;
                                                           owl:hasValue (xsd:decimal "1"^^xsd:decimal) ]) ] .

hpc:Compoundresourcerequirement rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:subClassOf [ a owl:Restriction ;
                     owl:onProperty hpc:hasResourceRequirement ;
                     owl:hasValue (xsd:string "+"^^xsd:string) ] .

hpc:Alternativeresourcerequirement rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:subClassOf [ a owl:Restriction ;
                     owl:onProperty hpc:hasResourceRequirement ;
                     owl:hasValue (xsd:string "||"^^xsd:string) ] .
