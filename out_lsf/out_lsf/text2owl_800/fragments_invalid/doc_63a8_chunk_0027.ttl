hpc:Job a owl:Class .
hpc:Datafile a owl:Class .
hpc:Datamanager a owl:Class .
hpc:Stagingarea a owl:Class .
hpc:Transferarea a owl:Class .
hpc:Pendingstate a owl:Class .
hpc:Satisfiedstate a owl:Class .
hpc:Transferredstate a owl:Class .

hpc:hasdatafile hpc:job a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Datafile .

hpc:isindatamanager hpc:datafile a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Datamanager .

hpc:hashash hpc:datafile a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:hasstatus hpc:datafile a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:hasrefjob hpc:datafile a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Job .

hpc:hasxferjob hpc:datafile a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Job .

hpc:hasgrace hpc:datafile a owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:isinstagingarea hpc:datafile a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Stagingarea .

hpc:isintransferarea hpc:datafile a owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range hpc:Transferarea .

hpc:hasqueue hpc:job a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasjobname hpc:job a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hassubmittime hpc:job a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:hasstate hpc:job a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Datamanager rdfs:subClassOf owl:Class .
hpc:Stagingarea rdfs:subClassOf hpc:Datamanager .
hpc:Transferarea rdfs:subClassOf hpc:Datamanager .
hpc:Pendingstate rdfs:subClassOf hpc:State .
hpc:Satisfiedstate rdfs:subClassOf hpc:State .
