hpc:runtimefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:fairshareadjustmentfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:gpuruntimefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:decimal .

hpc:numbershares a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:cputime a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:jobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fwdjobslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ngpusphysical a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpu ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Job a owl:Class .
hpc:Gpu a owl:Class .
hpc:User a owl:Class .
