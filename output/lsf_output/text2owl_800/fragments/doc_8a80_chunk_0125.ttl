hpc:Taskmanager a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Runs the interactive UNIX application on behalf of the user." .

hpc:Command a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Required. The command to start the job that requires the license." .

hpc:duration a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskmanager ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Duration of the task in minutes or hours." .

hpc:hours a owl:DatatypeProperty ;
    rdfs:domain hpc:Duration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of hours in the duration." .

hpc:token a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskmanager ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Number of tokens." .

hpc:nretries a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskmanager ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of retry attempts that the taskman command makes to connect to the daemon." .

hpc:enableinteractive a owl:ObjectProperty ;
    rdfs:domain hpc:Taskmanager ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Set ENABLE_INTERACTIVE=y parameter in the lsf.licensescheduler file to allow the taskman command to detect batch resources." .

hpc:Project a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "-Lp project" .

hpc:v a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Verbose mode. Displays detailed messages about the status of conﬁguration ﬁles." .
