hpc:Makefileam a owl:Class;
    rdfs:subClassOf hpc:File; .

hpc:makefilein a owl:DatatypeProperty;
    rdfs:domain hpc:Makefileam; .
    rdfs:range xsd:string; .

hpc:slurmconfiguretime a owl:ObjectProperty;
    rdfs:domain hpc:Plugin;
    rdfs:range hpc:Makefileam; .

hpc:Gitrepository a owl:Class;
    rdfs:subClassOf hpc:Repository; .

hpc:Rpm a owl:Class
