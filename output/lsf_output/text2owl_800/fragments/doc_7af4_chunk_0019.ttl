hpc:enablegpu a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables LSF event streaming. Enable LSF event streaming if you intend to install IBM Spectrum LSF Analytics or IBM Spectrum LSF Application Center. Default N (Event streaming is disabled)." .

hpc:enableStream a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "Syntax: ENABLE_STREAM=\"Y\" | \"N\"" .

hpc:lsfAddServers a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "List of extra LSF server hosts. The hosts in the LSF_MASTER_LIST parameter are always LSF server hosts. Use the LSF_ADD_SERVERS parameter to specify extra server hosts. Specify a list of host names two ways: Host names that are separated by spaces or the name of a file that contains a list of host names, one host per line. Valid values: Any valid LSF host name. Example 1: List of host names: LSF_ADD_SERVERS=\"hosta hostb hostc hostd\" Example 2: Host list file: LSF_ADD_SERVERS=:lsf_server_hosts The lsf_server_hosts file contains a list of hosts: hosta hostb hostc hostd Default: Only hosts in the LSF_MASTER_LIST parameter are LSF server hosts." .

hpc:ngpusExclP a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Number of GPUs in Exclusive Process Mode" .

hpc:gpuTopology a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "GPU topology on host" .
