hpc:Job a owl:Class .
hpc:Partition a owl:Class .
hpc:Resource a owl:Class .
hpc:PriorityTier a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:integer .
hpc:Preempts a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:HasHigherPriorityTier a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Partition .
hpc:OverSubscribe a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:MaxShare a owl:DatatypeProperty ;
    rdfs:domain hpc:OverSubscribe ;
    rdfs:range xsd:integer .
hpc:PreemptType a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:ExclusiveUser a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .
hpc:MCSLabel a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:PartitionWithHighestPriorityTier a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:HasHigherPriorityTier ;
    owl:allValuesFrom rdf:nil .
hpc:PreemptablePartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:Preempts ;
    owl:someValuesFrom hpc:Partition .
hpc:NonPreemptablePartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:Preempts ;
    owl:allValuesFrom rdf:nil .
hpc:ExclusiveUserPartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:ExclusiveUser ;
    owl:hasValue true .
hpc:MCSLabelRestrictedPartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:MCSLabel ;
    owl:allValuesFrom rdf:nil .
hpc:MCSLabelPartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:MCSLabel ;
    owl:someValuesFrom rdf:nil .
hpc:OverSubscribedPartition a owl:Class ;
    rdf:type owl:Restriction ;
    owl:onProperty hpc:OverSubscribe ;
    owl:hasValue "FORCE" .
```
