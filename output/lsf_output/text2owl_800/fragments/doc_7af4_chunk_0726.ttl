hpc:Joboutput a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Output of a batch job." .

hpc:LsbMailsizeLimit a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Limit on the size of batch job output email." .

hpc:LsbMailto a owl:Class ;
    rdfs:subClassOf owl:Resource ;
    rdfs:comment "Address used by LSF to send emails about job completion or errors." .

hpc:hasmailformat a owl:ObjectProperty ;
    rdfs:domain hpc:LsbMailto ;
    rdfs:range xsd:string ;
    rdfs:comment "The format string used to build the mailing address." .

hpc:usermailformat a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailto ;
    rdfs:range xsd:string ;
    rdfs:comment "The format string for mailing to the submitting user's account name on the local host." .

hpc:companymailformat a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailto ;
    rdfs:range xsd:string ;
    rdfs:comment "The format string for mailing to user@company_name.com on the mail server." .
