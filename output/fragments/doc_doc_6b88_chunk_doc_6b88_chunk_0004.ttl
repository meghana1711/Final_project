hpc:JWKSFile a owl:Class .
hpc:JWKSFile rdf:type owl:NamedIndividual ;
    rdf:value "/var/spool/slurm/statesave/jwks.json" .

hpc:JWKSFilePermissions a owl:Class .
hpc:JWKSFilePermissions rdf:type owl:NamedIndividual ;
    rdfs:subClassOf hpc:FilePermissions .

hpc:FilePermissions a owl:Class .
hpc:FilePermissions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:JWKSFile ;
    rdfs:range rdf:List ;
    rdf:first hpc:FileOwner ;
    rdf:rest hpc:FilePermissionsList .

hpc:FileOwner a owl:DatatypeProperty ;
    rdfs:domain hpc:JWKSFilePermissions .
    rdfs:range xsd:string .

hpc:FileReadableBy a owl:DatatypeProperty ;
    rdfs:domain hpc:JWKSFilePermissions .
    rdfs:range xsd:string .

hpc:FilePermissionsList a owl:Class .
hpc:FilePermissionsList rdf:type rdf:List ;
    rdf:first hpc:FilePermission ;
    rdf:rest hpc:FilePermissionsList .

hpc:FilePermission a owl:Class .
hpc:FilePermission rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FilePermissionsList .
    rdfs:range rdf:List ;
    rdf:first hpc:FilePermissionType ;
    rdf:rest hpc:FilePermissionValue .

hpc:FilePermissionType a owl:DatatypeProperty ;
    rdfs:domain hpc:FilePermission .
    rdfs:range xsd:string .

hpc:FilePermissionValue a owl:DatatypeProperty ;
    rdfs:domain hpc:FilePermission .
    rdfs:range xsd:integer .

hpc:FileNotWritableByOther a owl:Class .
hpc:FileNotWritableByOther rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:FilePermissions .
    rdfs:range xsd:boolean .

# Slurm JWT and JWKS coexistence
hpc:SlurmJWT a owl:Class .
hpc:SlurmJWT rdf:type owl:NamedIndividual .

hpc:SlurmJWKS a owl:Class .
hpc:SlurmJWKS rdf:type owl:NamedIndividual .

hpc:SlurmJWTandJWKSCoexist a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmJWT ;
    rdfs:range hpc:SlurmJWKS .

# Keycloak JWT and JWKS configuration
hpc:KeycloakClient a owl:Class .
hpc:KeycloakClient rdf:type owl:NamedIndividual ;
    rdf:value "test" .

hpc:KeycloakClientSecret a owl:DatatypeProperty ;
    rdfs:domain hpc:Keyclo
