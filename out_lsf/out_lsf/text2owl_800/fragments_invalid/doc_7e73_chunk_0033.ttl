hpc:Schmoddemandplugin a owl:Class .
hpc:Awshostresource a owl:Class .
hpc:Lsfsharedfile a owl:Class .
hpc:Lsfresourceconnector a owl:Class .
hpc:Awsqueue a owl:Class .
hpc:Lsfconffile a owl:Class .
hpc:Lsbqueuesfile a owl:Class .
hpc:Lsfclusterfile a owl:Class .
hpc:Awsenableconfigfile a owl:Class .
hpc:Awsenablescript a owl:Class .
hpc:lsfrcexternalhostflag a owl:DatatypeProperty .
hpc:rchosts a owl:DatatypeProperty .
hpc:lsfregfloathosts a owl:DatatypeProperty .
hpc:lsfdynamichostwaittime a owl:DatatypeProperty .
hpc:lsfhostaddrrange a owl:DatatypeProperty .
hpc:awslsftop a owl:DatatypeProperty .
hpc:awsregion a owl:DatatypeProperty .

hpc:Lsfsharedfile rdfs:subClassOf owl:Class .
hpc:Lsfconffile rdfs:subClassOf owl:Class .
hpc:Lsbqueuesfile rdfs:subClassOf owl:Class .
hpc:Lsfclusterfile rdfs:subClassOf owl:Class .
hpc:Awsenableconfigfile rdfs:subClassOf owl:Class .
hpc:Awsenablescript rdfs:subClassOf owl:Class .

hpc:Lsfresourceconnector rdfs:subClassOf owl:Class .
hpc:Lsfrcexternalhostflag rdfs:domain LsfResourceConnector ;
                                        rdfs:range xsd:string .
hpc:Rchosts rdfs:domain AwsQueue ;
                             rdfs:range xsd:string .

hpc:Lsfregfloathosts rdfs:domain LsfConfFile ;
                          rdfs:range xsd:xsd:boolean .
hpc:Lsfdynamichostwaittime rdfs:domain LsfConfFile ;
                                 rdfs:range xsd:nonNegativeInteger .
hpc:Lsfhostaddrrange rdfs:domain LsfClusterFile ;
                             rdfs:range xsd:string .
hpc:Awslsftop rdfs:domain AwsEnableConfigFile ;
                          rdfs:range xsd:string .
hpc:Awsregion rdfs:domain AwsEnableConfigFile ;
                          rdfs:range xsd:string .
