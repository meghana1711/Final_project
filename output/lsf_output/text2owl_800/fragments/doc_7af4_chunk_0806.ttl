hpc:MLIMCleanupInterval rdfs:subPropertyOf hpc:hasCleanupInterval .

hpc:mlimcleanupintervalunit a owl:DatatypeProperty .
hpc:Mlimcleanupintervalunit rdfs:domain hpc:Mlimcleanupinterval .
hpc:Mlimcleanupintervalunit rdfs:range xsd:string .

hpc:mlimhostexpiry a owl:ObjectProperty .
hpc:Mlimhostexpiry rdfs:domain hpc:Mlim .
hpc:Mlimhostexpiry rdfs:range xsd:nonNegativeInteger .
hpc:MLIMHostExpiry rdfs:subPropertyOf hpc:hasHostExpiry .

hpc:mlimhostwaittime a owl:ObjectProperty .
hpc:Mlimhostwaittime rdfs:domain hpc:Mlim .
hpc:Mlimhostwaittime rdfs:range xsd:nonNegativeInteger .
hpc:MLIMHostWaitTime rdfs:subPropertyOf hpc:hasHostWaitTime .

hpc:mlimhostwaittimeunit a owl:DatatypeProperty .
hpc:Mlimhostwaittimeunit rdfs:domain hpc:Mlimhostwaittime .
hpc:Mlimhostwaittimeunit rdfs:range xsd:string .

hpc:hascleanupinterval a owl:ObjectProperty .
hpc:Hascleanupinterval rdfs:domain hpc:Mlim .
hpc:Hascleanupinterval rdfs:range xsd:duration .

hpc:hashostexpiry a owl:ObjectProperty .
hpc:Hashostexpiry rdfs:domain hpc:Mlim .
hpc:Hashostexpiry rdfs:range xsd:duration .

hpc:hashostwaittime a owl:ObjectProperty .
