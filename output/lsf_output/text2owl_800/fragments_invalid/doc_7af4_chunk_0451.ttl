hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Regularjob ;
    rdfs:subClassOf hpc:Interruptiblebackfilljob .

hpc:Regularjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:Interruptiblebackfilljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:subClassOf hpc:Backfilljob ;
    rdfs:subClassOf hpc:Interruptiblejob ;
    rdfs:subClassOf hpc:Killablejob ;

hpc:Backfilljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:subClassOf hpc:Slotreservingjob .

hpc:Slotreservingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:Killablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:subClassOf hpc:Interruptiblejob .

hpc:Interruptiblejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job ;
    rdfs:subClassOf hpc:Killablejob ;
    rdfs:subClassOf hpc:Preemptablejob .

hpc:Preemptablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Job .

hpc:MinimalTimeSlice a xsd:duration ;
    rdfs:range xsd:duration .

hpc:QueueRuntimeLimit a xsd:duration ;
    rdfs:range xsd:duration .

hpc:BackfillTimeSlice a xsd:duration ;
    rdfs:range xsd:duration .

hpc:Queue a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:domain hpc:Site ;
    rdfs:range hpc:Queue ;
    owl:hasProperty hpc:MinimalTimeSlice ;
    owl:hasProperty hpc:Backfill ;
    owl:hasProperty hpc:RUNLIMIT ;
    owl:hasProperty hpc:REQUIQUE_EXIT_VALUES ;
    owl:hasProperty hpc:disabled .

hpc:disabled a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:minimaltimeslice a owl:ObjectProperty ;
