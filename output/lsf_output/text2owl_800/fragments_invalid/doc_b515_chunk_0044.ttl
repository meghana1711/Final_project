hpc:Job a owl:Class .
hpc:Tasklimit a owl:Class .
hpc:Task a owl:Class .
hpc:hasTaskLimit an owl:ObjectProperty .
hpc:Mintasklimit rdfs:domain hpc:Tasklimit ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:Maxtasklimit rdfs:domain hpc:Tasklimit ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:Defaulttasklimit rdfs:domain hpc:Tasklimit ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:Pendingjob a owl:Class ;
              rdfs:subClassOf hpc:Job .
hpc:Jobrejected a owl:Class ;
              rdfs:subClassOf hpc:Job .
hpc:jobnolongersatisfiestasklimit a owl:ObjectProperty ;
                                 rdfs:domain hpc:Pendingjob ;
                                 rdfs:range hpc:Jobnolongersatisfiestasklimitreason .
hpc:Jobnolongersatisfiestasklimitreason a owl:Class .
hpc:Resizablejob a owl:Class ;
               rdfs:subClassOf hpc:Job .
hpc:Queue a owl:Class .
hpc:Queuetasklimit rdfs:domain hpc:Queue ;
                    rdfs:range hpc:Tasklimit .
hpc:automaticqueueselection a owl:ObjectProperty ;
                             rdfs:domain hpc:Job ;
                             rdfs:range hpc:Queue .
hpc:Taskrequirements rdfs:domain hpc:Job ;
                       rdfs:range hpc:Task .
