hpc:User a owl:Class.
hpc:Sssd a owl:Class.
hpc:Slurm a owl:Class.

hpc:User rdfs:subClassOf owl:Class.
hpc:Sssd rdfs:subClassOf owl:Class.
hpc:Slurm rdfs:subClassOf owl:Class.

hpc:sssd a owl:ObjectProperty;
    rdfs:subProperty hpc:JobSuspensionResumption.

hpc:enumeration a owl:ObjectProperty.
hpc:casesensitive a owl:ObjectProperty.
hpc:Enumeration rdfs:domain hpc:Sssd;
    rdfs:range xsd:boolean.
hpc:Casesensitive rdfs:domain hpc:Sssd;
    rdfs:range xsd:boolean.

hpc:Jobsuspensionresumption rdfs:domain hpc:Sssd;
    rdfs:range rdf:Resource.
