hpc:Limitconfiguration rdfs:subClassOf owl:Class .
hpc:Resourcelimit rdfs:subClassOf hpc:Limitconfiguration .
hpc:Appliesto rdfs:domain hpc:Resourcelimit .
hpc:Appliesto rdfs:range hpc:Appliesto .
