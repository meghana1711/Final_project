hpc:Feature a owl:Class .
hpc:hasname a owl:DatatypeProperty .
hpc:Hasname rdfs:domain hpc:Feature ;
                 rdfs:range xsd:string .
hpc:hasservicedomains a owl:ObjectProperty .
hpc:Hasservicedomains rdfs:domain hpc:Feature ;
                      rdfs:range rdfs:Resource .
hpc:Group a owl:Class .
hpc:hasgroupdistribution a owl:DatatypeProperty .
hpc:Hasgroupdistribution rdfs:domain hpc:Group ;
                          rdfs:range xsd:string .
hpc:hasownership a owl:ObjectProperty .
hpc:Hasownership rdfs:domain hpc:Group ;
                 rdfs:range rdfs:Resource .
hpc:hasownershiplimits a owl:DatatypeProperty .
hpc:Hasownershiplimits rdfs:domain hpc:Group ;
                        rdfs:range xsd:nonNegativeInteger .
hpc:hasnonshared a owl:DatatypeProperty .
hpc:Hasnonshared rdfs:domain hpc:Group ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:hasmembers a owl:ObjectProperty .
hpc:Hasmembers rdfs:domain hpc:Group ;
                 rdfs:range rdfs:Resource .
hpc:Member a owl:Class .
hpc:hasownership a owl:DatatypeProperty .
hpc:Hasownership rdfs:domain hpc:Member ;
                  rdfs:range xsd:nonNegativeInteger .
hpc:hasproject a owl:ObjectProperty .
hpc:Hasproject rdfs:domain hpc:Member ;
                 rdfs:range rdfs:Resource .
