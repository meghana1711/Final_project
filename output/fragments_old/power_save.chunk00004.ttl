hpc:Scheduler a owl:Class .
hpc:SchedulerParameters a owl:DatatypeProperty .
hpc:hasSchedulerParameters rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range xsd:string .

hpc:Command a owl:Class .
hpc:isCommand a owl:DatatypeProperty .
hpc:hasCommand rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .

hpc:Node a owl:Class .
hpc:NodeFeatures a owl:DatatypeProperty .
hpc:hasNodeFeatures rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:State a owl:DatatypeProperty .
hpc:hasState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:Feature a owl:Class .
hpc:isFeature a owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Feature .
hpc:NodeFeaturesPlugins a owl:DatatypeProperty .
hpc:hasNodeFeaturesPlugins rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:Helper a owl:DatatypeProperty .
hpc:hasHelper rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:string .
hpc:ChangeableFeature a owl:Class .
hpc:isChangeableFeature rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:boolean .
hpc:SelectableLabel a owl:Class .
hpc:isSelectableLabel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range xsd:boolean .

hpc:HybridCluster a owl:Class .
hpc:Partition a owl:Class ;
    rdfs:subClassOf hpc:HybridCluster .
hpc:PartitionName a owl:DatatypeProperty .
hpc:hasPartitionName rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:MaxTime a owl:DatatypeProperty .
hpc:hasMaxTime rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:time .
hpc:Nodes a owl:DatatypeProperty .
hpc:hasNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:string .
hpc:Default a owl:DatatypeProperty .
hpc:hasDefault rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Partition ;
    rdfs:range xsd:boolean .
hpc:SuspendProgram a owl:DatatypeProperty .
