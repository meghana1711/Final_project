# Classes
hpc:Feature a owl:Class .
hpc:Project a owl:Class .
hpc:Cluster a owl:Class .
hpc:Site a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Licensepool a owl:Class .

# Object Properties
hpc:hasservicedomain a owl:ObjectProperty .
hpc:isat a owl:ObjectProperty .
hpc:hasproject a owl:ObjectProperty .
hpc:owns a owl:ObjectProperty .
hpc:isinuse a owl:ObjectProperty .
hpc:isreserve a owl:ObjectProperty .
hpc:isfree a owl:ObjectProperty .
hpc:hasdemand a owl:ObjectProperty .
hpc:haslicensepool a owl:ObjectProperty .

# Datatype Properties
hpc:totalinuse a owl:DatatypeProperty .
hpc:totalreserve a owl:DatatypeProperty .
hpc:totalfree a owl:DatatypeProperty .
hpc:others a owl:DatatypeProperty .
hpc:share a owl:DatatypeProperty .
hpc:project a owl:DatatypeProperty .
hpc:cluster a owl:DatatypeProperty .
hpc:site a owl:DatatypeProperty .
hpc:inuse a owl:DatatypeProperty .
hpc:reserve a owl:DatatypeProperty .
hpc:free a owl:DatatypeProperty .
hpc:demand a owl:DatatypeProperty .

# Domain and Range
rdfs:domain hpc:Hasservicedomain hpc:Feature .
rdfs:domain hpc:Isat hpc:Feature .
rdfs:domain hpc:Hasproject hpc:Feature .
rdfs:domain hpc:Owns hpc:Project .
rdfs:domain hpc:Isinuse hpc:Licensepool .
rdfs:domain hpc:Isreserve hpc:Licensepool .
rdfs:domain hpc:Isfree hpc:Licensepool .
rdfs:domain hpc:Hasdemand hpc:Licensepool .
rdfs:domain hpc:Haslicensepool hpc:Feature .

rdfs:range hpc:Totalinuse xsd:decimal .
rdfs:range hpc:Totalreserve xsd:decimal .
rdfs:range hpc:Totalfree xsd:decimal .
rdfs:range hpc:Others xsd:nonNegativeInteger .
rdfs:range hpc:Share xsd:decimal .
rdfs:range hpc:Project xsd:string .
rdfs:range hpc:Cluster xsd:string .
rdfs:range hpc:Site xsd:string .
rdfs:range hpc:Inuse x
