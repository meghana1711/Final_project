hpc:globalexitrate a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specifies a cluster-wide threshold for exited jobs." .

hpc:RUN_JOB_FACTOR rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Not specified in the documentation." .

hpc:globalLimits a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Enables global limit scheduling." .

hpc:lsbGpdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpolicyd ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Not specified in the documentation." .

hpc:lsbGpdCluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpolicyd ;
    rdfs:range xsd:string ;
    rdfs:comment "Not specified in the documentation." .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Cluster a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Gpolicyd a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .
