hpc:Jobsubmission a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a job submission." .

hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range rdf:Resource ;
    rdfs:comment "The command and arguments used for the job submission." .

hpc:jobSpoolDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where the command file is spooled if JOB_SPOOL_DIR is specified." .

hpc:spoolsto a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:File ;
    rdfs:comment "The file that is spooled if JOB_SPOOL_DIR is specified." .

hpc:File a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a file." .

hpc:isreadableby a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who can read the file." .

hpc:iswritableby a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string ;
    rdfs:comment "The user who can write to the file." .

hpc:issharedby a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:string ;
    rdfs:comment "The host where the file is shared." .

hpc:isaccessible a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the file is accessible." .

hpc:exists a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the file exists." .
