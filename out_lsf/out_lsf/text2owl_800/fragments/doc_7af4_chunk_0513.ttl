hpc:Custompendingreason a owl:Class .
hpc:hasreasonid a owl:ObjectProperty .
hpc:hasmessage a owl:DatatypeProperty .
hpc:haspriority a owl:DatatypeProperty .

hpc:Custompendingreason rdfs:subClassOf hpc:Pendingreason .

hpc:Hasreasonid rdfs:domain hpc:Custompendingreason ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Hasmessage rdfs:domain hpc:Custompendingreason ;
    rdfs:range xsd:string .

hpc:Haspriority rdfs:domain hpc:Custompendingreason ;
    rdfs:range xsd:decimal .
