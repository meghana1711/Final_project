hpc:Compoundresourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:compoundresourcerequirementstring a owl:DatatypeProperty .

hpc:CompoundResourceRequirement subClassOf owl:Class .
hpc:SimpleResourceRequirement subClassOf owl:Class .
hpc:Compoundresourcerequirementstring rdfs:domain hpc:Compoundresourcerequirement .

hpc:hassubexpression a owl:ObjectProperty .
hpc:hascompoundrequirement a owl:ObjectProperty .
hpc:hasglobalsame a owl:ObjectProperty .

hpc:Compoundresourcerequirement rdfs:subClassOf hpc:Resourcerequirement .
hpc:Resourcerequirement a owl:Class .

hpc:CompoundResourceRequirementString rdf:type xsd:string .
hpc:Hassubexpression rdfs:range hpc:Compoundresourcerequirement .
hpc:Hascompoundrequirement rdfs:range hpc:Compoundresourcerequirement .
hpc:Hasglobalsame rdfs:range hpc:Compoundresourcerequirement .

hpc:CompoundResourceRequirementString regex "^((\\d+\\*)\\{([a-zA-Z0-9_]+)\\}([ +]+)\\^)*(\\d+\\*)\\{([a-zA-Z0-9_]+)\\}$" .
hpc:Compoundresourcerequirementstring ^ "(\\d+\\*)\\{([a-zA-Z0-9_]+)\\}([ +]+)\\^*" rdfs:range hpc:Compoundresourcerequirement .
hpc:Compoundresourcerequirementstring \\d+ "*" rdfs:range hpc:Simpleresourcerequirement .
hpc:Compoundresourcerequirementstring \\{[a-zA-Z0-9_]+ \\} rdfs:range hpc:Simpleresourcerequirement .
