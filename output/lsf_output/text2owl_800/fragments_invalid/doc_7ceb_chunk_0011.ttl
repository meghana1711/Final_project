hpc:Unixorlinuxinstallation a owl:Class .
hpc:Windowsinstallation a owl:Class .
hpc:Directorystructure a owl:Class .
hpc:lsfinstallationcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Unixorlinuxinstallation ;
    rdfs:range hpc:Directorystructure .

hpc:Lsfconfigurationfile a owl:Class .
hpc:lsfconf a owl:ObjectProperty ;
    rdfs:domain hpc:Unixorlinuxinstallation ;
    rdfs:range hpc:Lsfconfigurationfile ;
    rdfs:comment "The main LSF configuration file." .
hpc:lsfclusterconf a owl:ObjectProperty ;
    rdfs:domain hpc:Unixorlinuxinstallation ;
    rdfs:range hpc:Lsfconfigurationfile .
hpc:lsfsharedconf a owl:ObjectProperty ;
    rdfs:domain hpc:Unixorlinuxinstallation ;
    rdfs:range hpc:Lsfconfigurationfile .
hpc:lsbqueuesconf a owl:ObjectProperty ;
    rdfs:domain hpc:Unixorlinuxinstallation ;
    rdfs:range hpc:Lsfconfigurationfile .

hpc:ownership a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfigurationfile ;
    rdfs:range xsd:string .
hpc:lsfconfownedby a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationfile ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral "root" .
hpc:otherfilesownedby a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationfile ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral "primary LSF administrator" .
hpc:readableby a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfigurationfile ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral "cluster users" .
