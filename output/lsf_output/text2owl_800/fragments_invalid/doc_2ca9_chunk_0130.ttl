hpc:Googlecomputecloudresourceprovider a owl:Class .
hpc:AwsprovTemplates rdfs:subClassOf hpc:Googlecomputecloudresourceprovider ;
   rdfs:domain hpc:Googlecomputecloudresourceprovider .
hpc:GoogleprovConfig rdfs:subClassOf hpc:Googlecomputecloudresourceprovider ;
   rdfs:domain hpc:Googlecomputecloudresourceprovider .

# LSF Cluster Interaction with Google Compute Cloud
hpc:Lsfclusterinteractionwithgooglecomputecloud a owl:Class .
hpc:Launchgooglecomputecloudinstances rdfs:subClassOf hpc:Lsfclusterinteractionwithgooglecomputecloud ;
   rdfs:domain hpc:Lsfclusterinteractionwithgooglecomputecloud .

# LSF Resource Connector
hpc:Lsfresourceconnector a owl:Class .
hpc:Automaticallydeleteidleinstances rdfs:subClassOf hpc:Lsfresourceconnector ;
   rdfs:domain hpc:Lsfresourceconnector .

# Google Cloud Platform Configuration for LSF Resource Connector
hpc:Googlecloudplatformconfigurationforlsfresourceconnector a owl:Class .
hpc:GoogleprovConfig rdfs:domain hpc:Googlecloudplatformconfigurationforlsfresourceconnector .
hpc:GoogleprovTemplates rdfs:domain hpc:Googlecloudplatformconfigurationforlsfresourceconnector .

# bhosts Commands
hpc:Bhostscommands a owl:Class .
