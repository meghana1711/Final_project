hpc:PreprovisionFailed a owl:Class .
hpc:Allocated a owl:Class .
hpc:ReclaimReceived a owl:Class .
hpc:RelinquishreqSent a owl:Class .
hpc:Relinquished a owl:Class .
hpc:DeallocatedSent a owl:Class .
hpc:PostprovisionStarted a owl:Class .
hpc:Done a owl:Class .

hpc:ProvStatus a owl:Class .
hpc:updatedAt a owl:DatatypeProperty ;
    rdfs:domain hpc:ProvStatus ;
    rdfs:range xsd:dateTime .

hpc:instanceId a owl:DatatypeProperty .

hpc:PreprovisionFailed rdfs:subClassOf hpc:Status .
hpc:Allocated rdfs:subClassOf hpc:Status .
hpc:ReclaimReceived rdfs:subClassOf hpc:Status .
hpc:RelinquishreqSent rdfs:subClassOf hpc:Status .
hpc:Relinquished rdfs:subClassOf hpc:Status .
hpc:DeallocatedSent rdfs:subClassOf hpc:Status .
hpc:PostprovisionStarted rdfs:subClassOf hpc:Status .
hpc:Done rdfs:subClassOf hpc:Status .
