hpc:Usersuspendedjobs a owl:Class .
hpc:userallocatedslots a owl:ObjectProperty .
hpc:reservedslotsforpendingjobs a owl:ObjectProperty .
hpc:Pendingjobslotthreshold a owl:Class .
hpc:apspriority a owl:DatatypeProperty .
hpc:numberofuserspendingjobs a owl:ObjectProperty .
hpc:Pendingjobthreshold a owl:Class .
hpc:bwait a owl:ObjectProperty .
hpc:waitcondition a owl:DatatypeProperty .
hpc:timeout a owl:DatatypeProperty .

hpc:Usersuspendedjobs rdfs:subClassOf owl:Class .
hpc:Userallocatedslots rdfs:domain hpc:Usersuspendedjobs ;
                          rdfs:range xsd:integer .
hpc:Reservedslotsforpendingjobs rdfs:domain hpc:Usersuspendedjobs ;
                                 rdfs:range xsd:integer .
hpc:Pendingjobslotthreshold rdfs:subClassOf owl:Class .
hpc:Apspriority rdfs:domain hpc:Usersuspendedjobs ;
                  rdfs:range xsd:decimal .
hpc:Numberofuserspendingjobs rdfs:domain hpc:Usersuspendedjobs ;
                             rdfs:range xsd:nonNegativeInteger .
hpc:Pendingjobthreshold rdfs:subClassOf owl:Class .
hpc:Bwait rdfs:domain hpc:Usersuspendedjobs ;
                      rdfs:range rdf:String .
hpc:Waitcondition rdfs:range rdf:String .
hpc:Timeout rdfs:range xsd:nonNegativeInteger .
