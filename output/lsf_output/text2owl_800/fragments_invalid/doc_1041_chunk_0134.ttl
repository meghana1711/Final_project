@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Object a owl:Class .
hpc:Action a owl:Class .
hpc:User a owl:Class .
hpc:Impactedobj a owl:Class .
hpc:time a owl:DatatypeProperty .
hpc:name a owl:DatatypeProperty .
hpc:action a owl:ObjectProperty .
hpc:user a owl:ObjectProperty .
hpc:impactedobj a owl:ObjectProperty .

rdfs:domain hpc:Time rdf:Property .
rdfs:range hpc:Time xsd:dateTime .
rdfs:domain hpc:Name rdf:Property .
rdfs:range hpc:Name xsd:string .
rdfs:domain hpc:Action hpc:Object .
rdfs:domain hpc:User hpc:Object .
rdfs:domain hpc:Impactedobj hpc:Object .

hpc:Limit a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Queue a owl:Class .
hpc:Host a owl:Class .

hpc:hasTime rdf:Property .
hpc:hasName rdf:Property .
hpc:hasAction rdf:Property .
hpc:hasUser rdf:Property .
hpc:hasImpactedObj rdf:Property .

hpc:Limit hpc:hastime rdf:Property .
hpc:Usergroup hpc:hastime rdf:Property .
hpc:Queue hpc:hastime rdf:Property .
hpc:Host hpc:hastime rdf:Property .

hpc:Limit hpc:hasname rdf:Property .
hpc:Usergroup hpc:hasname rdf:Property .
hpc:Queue hpc:hasname rdf:Property .
hpc:Host hpc:hasname rdf:Property .

hpc:Limit hpc:hasaction rdf:Property .
hpc:Usergroup hpc:hasaction rdf:Property .
hpc:Queue hpc:hasaction rdf:Property .
hpc:Host hpc:hasaction rdf:Property .

hpc:Usergroup rdfs:subClassOf hpc:Object .
hpc:Queue rdfs:subClassOf hpc:Object .
hpc:Host rdfs:subClassOf hpc:Object .

hpc:Limit rdfs:subClassOf hpc:Object .

hpc:Limit rdfs:range xsd:string .
hpc:User rdfs:range xsd:string .
hpc:Impactedobj rdfs:range rdf:List .

hpc:Limit hpc:hasimpactedobj rdf:type rdf:Property .

hpc:ImpactedObj rdf
