hpc:SlurmDaemon a owl:Class .
hpc:InitDaemon a owl:Class .
hpc:OperatingSystem a owl:Class .
hpc:User a owl:Class .
hpc:Cluster a owl:Class .
hpc:Node a owl:Class .
hpc:AllocatedNode rdf:type hpc:Node ;
    rdfs:subClassOf hpc:Node .

hpc:HardResourceLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:SoftResourceLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:PropagateResourceLimits a owl:ObjectProperty .
hpc:PropagateResourceLimitsExcept a owl:ObjectProperty .

hpc:SlurmInitiatedBy hpc:InitDaemon .
hpc:OperatingSystemDefaultLimits hpc:Slurm .
hpc:LimitsAdjustedBy hpc:UlimitCommand a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:OperatingSystemDefaultLimits .
hpc:PAMEnabled hpc:Slurm a owl:ObjectProperty .
hpc:UniformHardResourceLimitsOnNodes hpc:Cluster a owl:ObjectProperty ;
    rdfs:domain hpc:SystemAdministrator .
hpc:PropagatedResourceLimitPropagationError hpc:Slurm a owl:Class ;
    rdfs:subClassOf owl:Error .
hpc:PropagatedResourceLimitPropagationErrorMessage rdf:type xsd:string .
```
