hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimitdefinition .

hpc:Queuelimitdefinition a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimitdefinition .

hpc:queues a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuelimitdefinition ;
    rdfs:range xsd:string .

hpc:Resource a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimitdefinition .

hpc:Resourcelimitdefinition a owl:Class .

hpc:Resourcelimitsection a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimitdefinition .

hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcelimitsection ;
    rdfs:range xsd:string .

hpc:resourcevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcelimitsection ;
    rdfs:range xsd:integer .

hpc:Verticaltable a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimitdefinition .

hpc:verticaltablesection a owl:ObjectProperty ;
    rdfs:domain hpc:Verticaltable ;
    rdfs:range hpc:Resourcelimitsection ;
    rdfs:subPropertyOf hpc:hasPart .
