hpc:Job a owl:Class .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:jobpattern a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Jobqueue a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:signalvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Signal ;
    rdfs:range xsd:string .
hpc:signalname a owl:DatatypeProperty ;
    rdfs:domain hpc:Signal ;
    rdfs:range xsd:string .
hpc:jobHost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .
hpc:jobHostgroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Hostgroup .
hpc:jobQueue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobqueue .
hpc:signalJob a owl:ObjectProperty .
hpc:Wildcard a owl:Class .
hpc:wildcardInarrayindex false a owl:DatatypeProperty ;
    rdfs:domain hpc:Wildcard ;
    rdfs:range xsd:boolean .
