hpc:Lsfcluster a owl:Class .
hpc:Upgradinglsfcluster a owl:Class .
hpc:backupconfiguration a owl:ObjectProperty ;
    rdfs:domain hpc:Upgradinglsfcluster ;
    rdfs:range hpc:Lsfcluster .
hpc:uninstallexistinglsfcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Upgradinglsfcluster ;
    rdfs:range hpc:Lsfcluster .
hpc:installnewlsfcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Upgradinglsfcluster ;
    rdfs:range hpc:Lsfcluster .
hpc:copyandeditlsfconfigurationfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Installnewlsfcluster ;
    rdfs:range hpc:Lsfcluster .
hpc:copyegoconfigurationfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Installnewlsfcluster ;
    rdfs:range hpc:Lsfcluster .
hpc:startnewlsfcluster a owl:ObjectProperty ;
    rdfs:domain hpc:Installnewlsfcluster ;
    rdfs:range hpc:Lsfcluster .
