hpc:Job a owl:Class .
hpc:status a owl:ObjectProperty .
hpc:Useraccount a owl:Class .
hpc:run a owl:DatatypeProperty .
hpc:DONE rdf:type owl:Class ;
    rdfs:subClassOf hpc:Status ;
    rdfs:domain hpc:Job .
hpc:EXIT rdf:type owl:Class ;
    rdfs:subClassOf hpc:Status ;
    rdfs:domain hpc:Job .
hpc:Completedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:domain xsd:boolean .
hpc:Error rdf:type owl:Class ;
    rdfs:subClassOf hpc:Status ;
    rdfs:domain hpc:Job .
hpc:communication a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobinformation .
hpc:Jobinformation a owl:Class .
hpc:joboutput a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
