hpc:Computeunittype a owl:Class .
hpc:hasDefaultType rdf:Property ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:string .

hpc:Computeunittypelist a owl:Class .
hpc:containsComputeUnitType rdf:Property ;
    rdfs:domain hpc:Computeunittypelist ;
    rdfs:range hpc:Computeunittype .

hpc:Computeunittype a owl:Class ;
    rdfs:subClassOf hpc:Computeunittypelist .

hpc:Defaultcomputeunittype a owl:Class ;
    rdfs:subClassOf hpc:Computeunittype ;
    rdfs:subClassOf hpc:Computeunittypelist ;
    rdfs:subClassOf hpc:Computeunittype {
        hpc:hasExclamationMark as xsd:boolean .
        hpc:Hasexclamationmark rdfs:range xsd:boolean .
    } .

hpc:hasExclamationMark rdf:Property ;
    rdfs:domain hpc:Computeunittype .

hpc:committedruntimefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:decimal .

hpc:condensependingreasons a owl:ObjectProperty ;
    rdfs:domain hpc:Computeunittype ;
    rdfs:range xsd:string .

hpc:AllCondensePendingReasons rdf:Literal "ALL" .
hpc:PartialCondensePendingReasons rdf:Literal "PARTIAL" .
hpc:NoCondensePendingReasons rdf:Literal "N" .

hpc:committedruntimefactorfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .
