hpc:Remotehost a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "Represents a remote host with the format host_name@cluster_name." .

hpc:hascluster a owl:ObjectProperty ;
    rdfs:domain hpc:Remotehost ;
    rdfs:range xsd:string ;
    rdfs:comment "The cluster that the remote host belongs to." .

# Configuration parameters
hpc:Configurationparameter a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

# Changed parameters
hpc:maxPendJobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationparameter ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum pending 'jobs' limit, previously controlling the maximum pending 'slot' threshold." .

hpc:maxPendSlots a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationparameter ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum pending 'slot' limit, introduced to control the previous intention of MAX_PEND_JOBS." .

# Related concepts
hpc:Jobstate a owl:Class ;
hpc:Jobpack a owl:Class ;
hpc:Resourceallocationlimit a owl:Class ;

# Reference
hpc:MAX_PEND_JOBS rdfs:seeAlso <http://example.org/hpc#MAX_PEND_JOBS> .
hpc:MAX_PEND_SLOTS rdfs:seeAlso <http://example.org/hpc#MAX_PEND_SLOTS> .

# LSB users
hpc:Lsbuser a owl:Class ;
    rdfs:subClassOf hpc:User ;
    rdfs:comment "Represents an LSB user." .

hpc:haspendingjoblimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbuser ;
    rdfs:range hpc:Configurationparameter ;
    rdfs:comment "The pending job limit for an LSB user." .

# Changes to default LSF behavior
hpc:Changedlsfbehavior a owl:Class ;
    rdfs:subClassOf hpc:Behaviorchange .

# Improvements to the LSF Integration for Rational ClearCase
hpc:Clearcaseintegration a owl:Class ;
    rdfs:subClassOf hpc:Integration .

# Daemon wrapper performance
hpc:Daemonwrapperperformance a owl:Class ;
    rdfs:subClassOf hpc:Performance .

# New features in IBM Spectrum LSF Version 10.1 Fix Pack 2
hpc:Release a owl:Class ;
    rdfs:subClassOf hpc:Softwarerelease .

hpc:Performanceenhancement a owl:Class ;
    rdfs:subClassOf hpc:Feature .

hpc:Containersupport a owl:Class ;
    rdfs:subClassOf hpc:Support .

hpc:Gpusupport a owl:Class ;
