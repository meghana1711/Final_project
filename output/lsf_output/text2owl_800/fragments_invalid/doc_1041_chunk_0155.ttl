hpc:File a owl:Class .
hpc:Job a owl:Class .
hpc:Cachelocation a owl:Class .
hpc:User a owl:Class .
hpc:Group a owl:Class .

# Object Properties
hpc:hasfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .
hpc:isstagedout a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cachelocation .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:User .
hpc:hasgroup a owl:ObjectProperty ;
    rdfs:domain hpc:File ;
    rdfs:range hpc:Group .
hpc:hasinputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .
hpc:hasoutputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:File .

# Datatype Properties
hpc:hashash a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:hassize a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:decimal .
hpc:hasstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:haspermission a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:hasxferjob a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:hasrefjob a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:hasmodificationdate a owl:DatatypeProperty ;
    rdfs:domain hpc:File ;
    rdfs:range xsd:dateTime .
hpc:hastransferjobfinishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
    rdfs:range xsd:dateTime .
hpc:hasgrace a owl:DatatypeProperty ;
    rdfs:domain hpc:File .
hpc:hascachelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Cachelocation .
    rdfs:range xsd:string .

# Subclass Relations
hpc:Outputfile a owl:Class ;
    rdfs:subClassOf hpc:File .
hpc:Inputfile a owl:Class ;
    rdfs:subClassOf hpc:File .

# Domain and Range Restrictions
hpc:Hasinputfile rdfs:domain hpc:Job .
hpc:Hasoutputfile rdfs:domain hpc:Job .
hpc:Hasuser rdfs:range hpc:User .
hpc:Hasgroup rdfs:range hpc:Group .
hpc:Hashash rdfs:range xsd:hexBinary .
hpc:Hassize rdfs:range xsd:decimal .
