hpc:Job a owl:Class .
hpc:Defaultqueue a owl:Class .
hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Token a owl:Class .
hpc:Kerberosauthentication a owl:Class .
hpc:Clusterperformance a owl:Class .
hpc:Lsfperformancemonitoring a owl:Class .
hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:queueid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:hostid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:groupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Group .
hpc:hastoken a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Token .
hpc:tokenexpiration a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:dateTime .
hpc:isunderheavyqueryload a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:boolean .
hpc:enablelsfperformancemonitoring a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Lsfperformancemonitoring .
hpc:startlsfperformancemonitoring a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfperformancemonitoring ;
    rdfs:range hpc:Cluster .
hpc:viewlsfperformancedata a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfperformancemonitoring ;
    rdfs:range hpc:Cluster .
