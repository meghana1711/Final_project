hpc:Ibmspectrumscale a owl:Class .
hpc:Lsfconfiguration a owl:Class .
hpc:Command a owl:Class .
hpc:Job a owl:Class .
hpc:Storagepool a owl:Class .
hpc:Resourceconnectorauditlog a owl:Class .
hpc:Resourceconnectortemplate a owl:Class .

# Object Properties
hpc:hasfunction a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range rdf:List .
hpc:hasserver a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration .
hpc:displays a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Job .
hpc:audits a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnector .

# Datatype Properties
hpc:function a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .
hpc:server a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string .
hpc:totalreadwritebytes a owl:DatatypeProperty ;
    rdfs:domain hpc:Storagepool ;
    rdfs:range xsd:decimal .
hpc:accumulatedjobdiskusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:jobleveldiskusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
hpc:auditlogfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnectorauditlog ;
    rdfs:range xsd:string .
hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnectortemplate ;
    rdfs:range xsd:integer .
