hpc:SlurmWorkloadManager a owl:Class .
hpc:SchedMD a owl:Class .

hpc:Overview a owl:Class .
hpc:ReleaseNotes a owl:Class .
hpc:Documentation a owl:Class .
hpc:FAQ a owl:Class .
hpc:Publications a owl:Class .
hpc:Installing a owl:Class .
hpc:Download a owl:Class .
hpc:RelatedSoftware a owl:Class .
hpc:InstallationGuide a owl:Class .
hpc:GettingHelp a owl:Class .
hpc:MailingLists a owl:Class .
hpc:SupportAndTraining a owl:Class .
hpc:Troubleshooting a owl:Class .
hpc:KubernetesGuide a owl:Class .
hpc:Presentations a owl:Class .

hpc:Version a rdfs:Datatype .
hpc:LastModified a xsd:date .

hpc:hasVersion a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmWorkloadManager ;
  rdfs:range xsd:string .

hpc:hasPresentations a owl:ObjectProperty ;
  rdfs:domain hpc:SlurmWorkloadManager ;
  rdfs:range hpc:Presentations .

hpc:presentation a owl:Class ;
  rdfs:subClassOf hpc:Presentations .

hpc:hasYear a owl:DatatypeProperty ;
  rdfs:domain hpc:presentation ;
  rdfs:range xsd:integer .

hpc:hasSpeaker a owl:ObjectProperty ;
  rdfs:domain hpc:presentation ;
  rdfs:range hpc:Person .

hpc:hasAffiliation a owl:ObjectProperty ;
  rdfs:domain hpc:Person .
  rdfs:range xsd:string .
