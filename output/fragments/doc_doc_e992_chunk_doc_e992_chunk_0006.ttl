hpc:ReserveInfo a owl:Class .
hpc:nodeInx a owl:ObjectProperty ;
    rdfs:domain hpc:ReserveInfo ;
    rdfs:range xsd:int .

hpc:nodeCnt a owl:DatatypeProperty ;
    rdfs:domain hpc:ReserveInfo ;
    rdfs:range xsd:unsignedInt .

hpc:Reason a owl:Class .
hpc:reason a owl:DatatypeProperty ;
    rdfs:domain hpc:Reason ;
    rdfs:range xsd:string .

hpc:reasonTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Reason ;
    rdfs:range xsd:time .

hpc:reasonUid a owl:DatatypeProperty ;
    rdfs:domain hpc:Reason ;
    rdfs:range xsd:unsignedInt .

hpc:PartitionInfo a owl:Class .
hpc:SlurmStepLayoutReq a owl:Class .
hpc:SlurmStepCtxParams a owl:Class .
```
