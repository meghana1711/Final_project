hpc:SlurmPackage a owl:Class .
hpc:buildRequirement a owl:ObjectProperty .
hpc:dependency a owl:ObjectProperty .
hpc:packageDependency a owl:ObjectProperty .
hpc:generalSlurmPackage rdfs:subClassOf hpc:SlurmPackage .
hpc:DebianPackage rdfs:subClassOf hpc:SlurmPackage .
hpc:RPMName rdfs:domain hpc:DebianPackage ;
    rdfs:range xsd:string .
hpc:DEBName rdfs:domain hpc:DebianPackage ;
    rdfs:range xsd:string .
hpc:LoginController rdfs:subClassOf hpc:DebianPackage .
hpc:Compute rdfs:subClassOf hpc:DebianPackage .
hpc:DB rdfs:subClassOf hpc:DebianPackage .
hpc:manualBuild a owl:ObjectProperty .
hpc:sourceDistribution a owl:DatatypeProperty .
hpc:configureOptions a owl:DatatypeProperty .
hpc:makeInstall a owl:ObjectProperty .
