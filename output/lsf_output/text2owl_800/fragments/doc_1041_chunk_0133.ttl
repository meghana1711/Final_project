hpc:Action a owl:Class .
hpc:Objecttype a owl:Class .
hpc:Valuepair a owl:Class .

hpc:Hasaction rdfs:domain hpc:Action ;
    rdfs:range rdf:Resource .

hpc:Hasobjecttype rdfs:domain hpc:Action ;
    rdfs:range hpc:Objecttype .

hpc:Hasvaluepair rdfs:domain hpc:Action ;
    rdfs:domain hpc:Objecttype ;
    rdfs:range rdf:List .

hpc:pack a owl:ObjectProperty .
hpc:Readsrequests rdfs:domain hpc:Pack ;
    rdfs:range rdf:Resource .

hpc:Haslsfrelease rdfs:domain hpc:Pack ;
    rdfs:range xsd:string .

hpc:hist a owl:ObjectProperty .
hpc:Defaultoutput rdfs:domain hpc:Hist ;
    rdfs:range rdf:Resource .

hpc:Time rdfs:domain hpc:Request ;
    rdfs:range xsd:dateTime .

hpc:Object rdfs:domain hpc:Request ;
    rdfs:range hpc:Object .

hpc:Name rdfs:domain hpc:Object ;
    rdfs:range xsd:string .
