hpc:Transferjob a owl:Class .
hpc:transfercommand a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range xsd:string .

hpc:destination a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range hpc:Absolutepath .

hpc:relativepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Destination ;
    rdfs:range xsd:string .

hpc:absolutepath a owl:DatatypeProperty ;
    rdfs:domain hpc:Destination ;
    rdfs:range xsd:string .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Absolutepath ;
    rdfs:range xsd:string .

hpc:NoDestination a owl:NamedIndividual ;
    hpc:Destination hpc:nodestinationvalue .

hpc:NoDestinationValue a xsd:string .

hpc:link a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range hpc:Linktype .

hpc:Linktype a owl:Class .

hpc:symboliclink a owl:ObjectProperty ;
    rdfs:domain hpc:Linktype ;
    rdfs:range xsd:boolean .

hpc:stalelink a owl:ObjectProperty ;
    rdfs:domain hpc:Linktype ;
    rdfs:range xsd:boolean .

hpc:tag a owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range hpc:Tag .

hpc:tagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .

hpc:Tagdirectory a owl:Class ;
    rdfs:subClassOf hpc:Directory .

hpc:Taggedfile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:Taggeddirectory a owl:Class ;
    rdfs:subClassOf hpc:Directory .

hpc:Directory a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:File a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Pathdescriptor a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:subClassOf hpc:Path .

hpc:Path a owl:Class ;
    rdfs:subClassOf owl:Thing .

hpc:Specialname a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:SpecialNameValue a xsd:string .

hpc:forbiddenspecialnames a owl:ObjectProperty ;
    rdfs:domain hpc:Pathdescriptor ;
    rdfs:range hpc:Specialname .

hpc:allowedspecialnames a owl:ObjectProperty ;
    rdfs:domain hpc:Pathdescriptor ;
    rdfs:range xsd:boolean .
