    rdfs:range xsd:string .
hpc:vpcid a owl:ObjectProperty .
hpc:Vpcid rdfs:domain hpc:Imagename ;
    rdfs:range xsd:string .
hpc:resourcegroupid a owl:ObjectProperty .
hpc:Resourcegroupid rdfs:domain hpc:Imagename ;
    rdfs:range xsd:string .
hpc:vmtype a owl:DatatypeProperty .
hpc:Vmtype rdfs:domain hpc:Imagename ;
    rdfs:range xsd:string .
hpc:securitygroupids a owl:ObjectProperty .
hpc:Securitygroupids rdfs:domain hpc:Imagename ;
    rdfs:range xsd:string .
hpc:sshkeyId a owl:DatatypeProperty .
hpc:SshkeyId rdfs:domain hpc:Imagename ;
    rdfs:range xsd:string .
