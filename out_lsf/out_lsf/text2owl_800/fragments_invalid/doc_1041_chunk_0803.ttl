hpc:Host a owl:Class .
hpc:ResourceRequirementExpression rdf:type owl:ObjectProperty .
hpc:LoadIndex rdf:type owl:ObjectProperty .
hpc:StaticLoadIndex rdf:type owl:Class .
hpc:DynamicLoadIndex rdf:type owl:Class .
hpc:ExternalLoadIndex rdf:type owl:Class .
hpc:HostName rdf:type owl:DatatypeProperty .
hpc:HostGroup rdf:type owl:Class .
hpc:LSF_HOSTGROUP_INFO rdf:type owl:ObjectProperty .
hpc:ClusterName rdf:type owl:DatatypeProperty .
hpc:Cluster rdf:type owl:Class .
hpc:LocalCluster rdf:type owl:Class .
hpc:Multicluster rdf:type owl:Class .

hpc:Host subClassOf owl:Class .
hpc:ResourceRequirementExpression subClassOf owl:ObjectProperty .
hpc:LoadIndex domain owl:Class ;
    rdfs:range hpc:Resourcerequirementexpression .
hpc:StaticLoadIndex subClassOf hpc:LoadIndex .
hpc:DynamicLoadIndex subClassOf hpc:LoadIndex .
hpc:ExternalLoadIndex subClassOf hpc:LoadIndex .
hpc:Hostname rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:Hostgroup rdfs:subClassOf hpc:Host .
hpc:LSF_HOSTGROUP_INFO domain owl:ObjectProperty ;
    rdfs:range xsd:boolean .
hpc:Clustername rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .
hpc:Cluster subClassOf owl:Class .
hpc:LocalCluster subClassOf hpc:Cluster .
hpc:Multicluster subClassOf hpc:Cluster .
