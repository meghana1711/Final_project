hpc:Application a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The application managed by FOD." .

hpc:hasname a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .

hpc:haspath a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .

hpc:hasparams a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string .

hpc:hasnoparams a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string ;
    rdfs:range rdf:PlainLiteral "-" .

hpc:fatalexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Fodadmin a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:startapplicationsunderfod a owl:ObjectProperty ;
    rdfs:domain hpc:Fodadmin ;
    rdfs:range hpc:Application .

hpc:shutdown a owl:ObjectProperty ;
    rdfs:domain hpc:Fodadmin ;
    rdfs:range hpc:Shutdown .

hpc:Shutdown a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Shuts down FOD on the specified hosts." .

hpc:hostname a owl:ObjectProperty ;
    rdfs:domain hpc:Shutdown ;
    rdfs:range xsd:string .

hpc:all a xsd:string ;
    xsd:value "all" .
