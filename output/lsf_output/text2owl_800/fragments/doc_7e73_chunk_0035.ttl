hpc:Iamaccesskey a owl:Class .
hpc:Credentialsfile a owl:Class .
hpc:Awsmanagementconsole a owl:Class .
hpc:Iamconsole a owl:Class .
hpc:accesskeyid a owl:DatatypeProperty .
hpc:secretaccesskey a owl:DatatypeProperty .
hpc:credentialscsvfile a owl:DatatypeProperty .
hpc:Awsresource a owl:Class .
hpc:Federatedaccount a owl:Class .
hpc:Wrapperscript a owl:Class .
hpc:Userauthentication a owl:Class .
hpc:Windowsactivedirectory a owl:Class .
hpc:Lsfcredentialsfile a owl:Class .
hpc:Userdefinedscript a owl:Class .
hpc:Federateduser a owl:Class .
hpc:Temporarycredentials a owl:Class .
hpc:Resourceconnector a owl:Class .
hpc:Federatedaccounts a owl:Class .
hpc:Role a owl:Class .
hpc:Policy a owl:Class .
hpc:Permission a owl:Class .

hpc:Iamaccesskey rdfs:subClassOf owl:Class .
hpc:Credentialsfile rdfs:subClassOf owl:Class .
hpc:Awsmanagementconsole rdfs:subClassOf hpc:Iamaccesskey .
hpc:Iamconsole rdfs:subClassOf hpc:Awsmanagementconsole .
hpc:Accesskeyid rdfs:domain hpc:Iamaccesskey ;
    rdfs:range xsd:string .
hpc:Secretaccesskey rdfs:domain hpc:Iamaccesskey ;
    rdfs:range xsd:string .
hpc:Credentialscsvfile rdfs:domain hpc:Credentialsfile ;
    rdfs:range xsd:string .
hpc:Awsresource rdfs:subClassOf owl:Class .
hpc:Federatedaccount rdfs:subClassOf hpc:Awsresource .
hpc:Wrapperscript rdfs:subClassOf owl:Class .
hpc:Userauthentication rdfs:subClassOf owl:Class .
hpc:Windowsactivedirectory rdfs:subClassOf hpc:Userauthentication .
hpc:Lsfcredentialsfile rdfs:subClassOf hpc:Credentialsfile .
hpc:Userdefinedscript rdfs:subClassOf hpc:Wrapperscript .
hpc:Federateduser rdfs:subClassOf hpc:User .
hpc:Temporarycredentials rdfs:subClassOf hpc:Credentials .
hpc:Resourceconnector rdfs:subClassOf owl:Class .
hpc:Federatedaccounts rdfs:subClassOf hpc:Awsresource .
hpc:Role rdfs:subClassOf hpc:Iamresource .
hpc:Policy rdfs:subClassOf hpc:Iamresource .
hpc:Permission rdfs:subClassOf hpc:Iamresource .
