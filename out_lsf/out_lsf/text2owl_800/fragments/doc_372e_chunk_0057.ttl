hpc:TimeWindow
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf xsd:time ] ;
    rdfs:domain hpc:Timeexpression ;
    rdfs:range xsd:time .

hpc:contains
    a owl:ObjectProperty ;
    rdfs:domain hpc:Timeexpression ;
    rdfs:range hpc:Timewindow ;
    rdfs:subPropertyOf hpc:logicalOperator .

hpc:logicalOperator
    a owl:ObjectProperty .

hpc:and
    a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Logicaloperator .

hpc:or
    a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Logicaloperator .

hpc:not
    a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Logicaloperator .

hpc:Day
    a owl:Class .

hpc:Weekend
    a owl:Class ;
    rdfs:subClassOf hpc:Day ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf hpc:Day ;
                       rdfs:subClassOf hpc:Weekend ] .

hpc:IfElse
    a owl:Class .

hpc:If
    a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelse ;
    rdfs:range hpc:Timeexpression .

hpc:Else
    a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelse ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf owl:ObjectProperty ] .

hpc:Elif
    a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelse ;
    rdfs:range [ a owl:Class ;
                  rdfs:subClassOf hpc:Ifelse ] .

hpc:EndIf
    a owl:ObjectProperty ;
    rdfs:domain hpc:Ifelse .
