hpc:Lsflicensescheduler a owl:Class .
hpc:remoteLmstatProtocol a owl:ObjectProperty .
hpc:remoteLmstatServers a owl:ObjectProperty .
hpc:restrictFeatureName a owl:DatatypeProperty .

hpc:Lsflicensescheduler rdfs:subClassOf owl:Class .
hpc:RemoteLmstatProtocol rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:string .
hpc:RemoteLmstatServers rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:string .
hpc:RestrictFeatureName rdfs:domain hpc:Lsflicensescheduler ;
    rdfs:range xsd:string .
