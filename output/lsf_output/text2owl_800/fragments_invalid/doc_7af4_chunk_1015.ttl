hpc:Environmentvariable a owl:Class .
hpc:TaskEnvironment a hpc:EnvironmentVariable .
hpc:SessionJobEnvironment a hpc:EnvironmentVariable .
hpc:IndividualTaskEnvironment a hpc:EnvironmentVariable .
hpc:DataProvenanceEnvironment a hpc:EnvironmentVariable .

hpc:resettableintaskenvironment a owl:ObjectProperty ;
 rdfs:domain hpc:Environmentvariable ;
 rdfs:range hpc:Taskenvironment .

hpc:resettableinsessionjobenvironment a owl:ObjectProperty ;
 rdfs:domain hpc:Environmentvariable ;
 rdfs:range hpc:Sessionjobenvironment .

hpc:notavailableintaskenvironment a owl:ObjectProperty ;
 rdfs:domain hpc:Environmentvariable ;
 rdfs:range hpc:Taskenvironment .

hpc:setindividuallyforeachtask a owl:ObjectProperty ;
 rdfs:domain hpc:Environmentvariable ;
 rdfs:range hpc:Individualtaskenvironment .

hpc:dataprovenanceenvironmentvariables a owl:ObjectProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range rdf:List .

hpc:standardinputfile a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range xsd:string .

hpc:sourcefilesonsubmissionhost a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range rdf:List .

hpc:destinationfilesonexecutionhost a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range rdf:List .

hpc:numberoffilestobecopied a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range xsd:nonNegativeInteger .

hpc:sourcefilesinesubdprov a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range rdf:List .

hpc:numberoffilesinesubdprov a owl:DatatypeProperty ;
 rdfs:domain hpc:Dataprovenanceenvironment ;
 rdfs:range xsd:nonNegativeInteger .

hpc:prependslsfBindir a owl:ObjectProperty ;
 rdfs:domain hpc:Pathproperty ;
 rdfs:range hpc:Pathproperty .

hpc:prependslsfLibdir a owl:ObjectProperty ;
 rdfs:domain hpc:LdLibraryPathproperty ;
 rdfs:range hpc:LdLibraryPathproperty .

hpc:prependsegoLibdir a owl:ObjectProperty ;
 rdfs:domain hpc:LdLibraryPathproperty ;
 rdfs:range hpc:LdLibraryPathproperty .

hpc:Taskenvironment rdfs:subClassOf hpc:Environmentvariable .
hpc:Sessionjobenvironment rdfs:subClassOf hpc:Environmentvariable .
hpc:Individualtaskenvironment rdfs:subClassOf hpc:Taskenvironment .
