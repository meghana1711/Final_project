hpc:User a owl:Class .
hpc:Ipaddress a owl:Class .
hpc:Accesstoken a owl:Class .
hpc:hasUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:User .
hpc:hasIPAddress rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Ipaddress .
hpc:hasAccessToken rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Accesstoken .
hpc:tokenTTL rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Accesstoken ;
    rdfs:range xsd:integer .

hpc:Users a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:user3 a hpc:users ;
    hpc:hasIPAddress "9.30.199.99"^^xsd:string ;
    hpc:hasAccessToken _:token1 .
_:token1 a hpc:AccessToken ;
    hpc:tokenTTL "3600"^^xsd:integer .

hpc:Allotherusers a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:notallowedtoaccess a owl:ObjectProperty ;
    rdfs:domain hpc:Allotherusers ;
    rdfs:range hpc:Ipaddress .
