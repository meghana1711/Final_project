hpc:Node a owl:Class.
hpc:Socket a owl:Class.
hpc:Core a owl:Class.
hpc:Thread a owl:Class.

hpc:Hassocket rdfs:domain hpc:Node ;
             rdfs:range rdf:Resource.

hpc:numsockets a owl:DatatypeProperty ;
              rdfs:domain hpc:Node ;
              rdfs:range xsd:nonNegativeInteger.

hpc:Hascore rdfs:domain hpc:Socket ;
            rdfs:range rdf:Resource.

hpc:numcores a o
