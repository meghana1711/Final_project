hpc:lsfElimBlocktime a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadinformationmanager ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Time for the elim to finish writing the entire load update string." .

hpc:lsfElimDebug a owl:ObjectProperty ;
    rdfs:domain hpc:Loadinformationmanager ;
    rdfs:range xsd:boolean ;
    rdfs:comment "UNIX only; logs all external load information received by the load information manager (LIM) from the parent external load information manager (MELIM) in the LIM log file (lim.log.host_name)." .

hpc:lsfElimRestarts a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadinformationmanager ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "UNIX only; maximum number of times the parent external load information manager (MELIM) can restart elim executables on a host." .
