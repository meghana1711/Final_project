@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Mpiruncommand a owl:Class.
hpc:Hydrapm a owl:Class.
hpc:Slurm a owl:Class.
hpc:Intelmpilibrary a owl:Class.

hpc:uses a owl:ObjectProperty;
    rdfs:domain hpc:Mpiruncommand;
    rdfs:range hpc:Hydrapm.

hpc:supportedby a owl:ObjectProperty;
    rdfs:domain hpc:Hydrapm;
    rdfs:range hpc:Intelmpilibrary.

hpc:launchedbyslurm a owl:Object
