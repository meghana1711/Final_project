hpc:Preemptable a owl:ObjectProperty .
hpc:Preempts rdf:type owl:ObjectProperty .

hpc:PriorityTier rdf:type owl:DatatypeProperty .
hpc:PartitionOf rdf:type owl:ObjectProperty .
hpc:QOSOf rdf:type owl:ObjectProperty .

hpc:PreemptionMechanism a owl:Class .
hpc:SelectType rdf:type owl:DatatypeProperty .
hpc:SelectTypeParameter rdf:type owl:DatatypeProperty .
hpc:PreemptMode rdf:type owl:DatatypeProperty .

hpc:ResourceAllocation a owl:Class .
hpc:NodeAllocation rdf:type owl:ObjectProperty .
hpc:MemoryAllocation rdf:type owl:ObjectProperty .

hpc:SuspendedJob a owl:Class, rdfs:subClassOf hpc:PreemptableJob .
hpc:CancelledJob a owl:Class, rdfs:subClassOf hpc:PreemptableJob .
hpc:RequeuedJob a owl:Class, rdfs:subClassOf hpc:PreemptableJob .
hpc:SharedResourceJob a owl:Class, rdfs:subClassOf hpc:PreemptableJob .
