hpc:Cluster a owl:Class .
hpc:Usermessage a owl:Class .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Resourceprovider a owl:Class .
hpc:Resourceconsumer a owl:Class .
hpc:Resourceflow a owl:Class .
hpc:Connectionstatus a owl:Class .
hpc:Applicationprofile a owl:Class .
hpc:Jobforwardinginformation a owl:Class .
hpc:LocalQueue a owl:Class .
hpc:JOB_FLOW a owl:Enum .
hpc:JOB_FLOW:send a xsd:string .
hpc:JOB_FLOW:recv a xsd:string .
hpc:sndjobsTo a owl:ObjectProperty .
hpc:rcvjobsFrom a owl:ObjectProperty .
hpc:SndjobsTo rdfs:domain hpc:LocalQueue .
hpc:RcvjobsFrom rdfs:domain hpc:LocalQueue .
hpc:SndjobsTo rdfs:range rdf:Resource .
hpc:RcvjobsFrom rdfs:range rdf:Resource .
hpc:RemoteCluster a owl:Class .
hpc:RemoteQueue a owl:Class .
hpc:jobrunningon a owl:ObjectProperty .
hpc:Jobrunningon rdfs:domain hpc:LocalQueue .
hpc:Jobrunningon rdfs:range hpc:RemoteCluster .
hpc:remoteQueueName a owl:DatatypeProperty .
hpc:RemoteQueueName rdfs:domain hpc:SndjobsTo .
hpc:RemoteQueueName rdfs:range xsd:string .
hpc:remoteClusterName a owl:DatatypeProperty .
hpc:RemoteClusterName rdfs:domain hpc:SndjobsTo .
hpc:RemoteClusterName rdfs:range xsd:string .
