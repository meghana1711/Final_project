hpc:Remotehost a owl:Class .
hpc:Task a owl:Class .
hpc:ChangeHost an owl:ObjectProperty ;
    rdfs:domain hpc:Remotehost ;
    rdfs:range hpc:Remotehost .
hpc:FalseRequest an owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:Lsfcluster a owl:Class .
hpc:Denialofserviceattack a owl:Class ;
    rdfs:subClassOf hpc:Lsfcluster .
hpc:Overloadeddaemon a owl:Class ;
    rdfs:subClassOf hpc:Lsfcluster .
hpc:Validrequest a owl:Class ;
    rdfs:subClassOf hpc:Lsfcluster .
hpc:Unlistedhost a owl:Class ;
    rdfs:subClassOf hpc:Remotehost .
hpc:Lsfmanagementhost a owl:Class ;
    rdfs:subClassOf hpc:Remotehost .
hpc:Lsfdaemon a owl:Class ;
    rdfs:subClassOf hpc:Remotehost .
hpc:Authentication a owl:Class .
hpc:externalauthentication a owl:ObjectProperty ;
    rdfs:domain hpc:Authentication ;
    rdfs:range hpc:Authenticationmethod .
hpc:Identificationdaemon a owl:Class ;
    rdfs:subClassOf hpc:Authenticationmethod .
hpc:security a owl:DatatypeProperty ;
    rdfs:domain hpc:Authenticationmethod ;
    rdfs:range xsd:string .
hpc:lsfserverdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsf .
hpc:LSF_SERVERDIR a xsd:string .
