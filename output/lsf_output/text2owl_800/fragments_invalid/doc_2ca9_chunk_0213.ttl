hpc:Job a owl:Class .
hpc:resourcerequestedobjectproperty a owl:ObjectProperty .
hpc:Filter rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .

hpc:Bjobscommand a owl:Class .
hpc:displaysonlypendingjobsobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand ;
    rdfs:range hpc:Job .

hpc:showsjoblevelinformationobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand .

hpc:effectiveplimitdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:plimitremaindatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:effectiveeplimitdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:eplimitremaindatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:showspendinginformationobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand .

hpc:pendingreasondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:hasnullpendingreasondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:showspendingreasonlevelobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand .

hpc:Level0 a owl:NamedIndividual ;
    hpc:Showspendingreasonlevelobjectproperty hpc:level0 .

hpc:Level1 a owl:NamedIndividual ;
    hpc:Showspendingreasonlevelobjectproperty hpc:level1 .

hpc:Level2 a owl:NamedIndividual ;
    hpc:Showscategorizedhostbasedpendingreasonsobjectproperty hpc:level2 .

hpc:showscategorizedhostbasedpendingreasonsobjectproperty a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobscommand .

hpc:Candidatehosts rdfs:domain hpc:Categorizedhostbasedpendingreasons ;
    rdfs:range hpc:Host .

hpc:actualreasononeachhostdatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Candidatehosts ;
    rdfs:range xsd:string .

hpc:numberofhoststhatgivethatreasondatatypeproperty a owl:DatatypeProperty ;
    rdfs:domain hpc:Categorizedhostbasedpendingreasons ;
    rdfs:range xsd:nonNegativeInteger .

