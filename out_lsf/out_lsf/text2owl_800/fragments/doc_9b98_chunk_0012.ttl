hpc:Cluster a owl:Class .
hpc:cacheddata a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:msgId a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:from a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:postTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:Dataavailability a owl:Class .
hpc:dataavailability a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Dataavailability .
hpc:Datapreference a owl:Class .
hpc:Jobforwardingpolicy a owl:Class .
hpc:Datatag a owl:Class .
hpc:bdatacache a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager ;
    rdfs:range hpc:Bdatacache .
