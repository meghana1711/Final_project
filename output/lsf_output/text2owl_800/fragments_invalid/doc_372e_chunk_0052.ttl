hpc:Preemptionaction a owl:Class .
hpc:tstpsignal a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionaction ;
    rdfs:range xsd:boolean .
hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionaction ;
    rdfs:range hpc:Job .
hpc:lmremove a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionaction ;
    rdfs:range hpc:Application .
hpc:resumeapplication a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptionaction ;
    rdfs:range hpc:Application .
hpc:fastdispatch a owl:DatatypeProperty ;
    rdfs:domain hpc:Feature .
    rdfs:range xsd:boolean .
hpc:distribution a owl:ObjectProperty ;
    rdfs:domain hpc:Feature ;
    rdfs:range hpc:Project .
hpc:Project a owl:Class .
hpc:Application a owl:Class .
hpc:Job a owl:Class .
hpc:Feature a owl:Class .
