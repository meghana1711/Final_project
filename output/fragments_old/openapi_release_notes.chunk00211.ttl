hpc:AccountResponse a owl:Class .
hpc:AccountsResponse a owl:Class .
hpc:OpenapiAccountsResp a owl:Class .
hpc:OpenapiResp a owl:Class .

hpc:AccountResponse rdfs:subClassOf owl:NamedIndividual .
hpc:AccountsResponse rdfs:subClassOf owl:NamedIndividual .
hpc:OpenapiAccountsResp rdfs:subClassOf owl:NamedIndividual .
hpc:OpenapiResp rdfs:subClassOf owl:NamedIndividual .

hpc:hasContent a owl:ObjectProperty .
hpc:hasContent rdfs:domain hpc:AccountResponse ;
