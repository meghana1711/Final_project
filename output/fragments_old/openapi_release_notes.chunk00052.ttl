hpc:JobStateQuery a owl:Class .
hpc:JobID a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStateQuery ;
    rdfs:range xsd:string .
hpc:Flags a owl:DatatypeProperty ;
    rdfs:domain hpc:JobStateQuery ;
    rdfs:range xsd:string ;
    owl:enum "ALL" "DETAIL" "MIXED" "LOCAL" "SIBLING" "FEDERATION" "FUTURE" .
hpc:hasQueryFlags a owl:ObjectProperty ;
    rdfs:domain hpc:JobStateQuery .
