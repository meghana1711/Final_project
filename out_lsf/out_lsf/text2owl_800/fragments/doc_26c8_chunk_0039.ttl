hpc:Ondemandrequest a owl:Class .
hpc:allocationstrategy a owl:ObjectProperty .

hpc:CapacityOptimized rdf:type xsd:string .
hpc:LowestPrice rdf:type xsd:string .
hpc:Diversified rdf:type xsd:string .

hpc:keyname a owl:DatatypeProperty .
hpc:Keyname rdfs:domain hpc:Ondemandrequest ;
    rdfs:range xsd:string .

hpc:interfacetype a owl:DatatypeProperty .
hpc:Interfacetype rdfs:domain hpc:Ondemandrequest ;
    rdfs:range xsd:string .

hpc:efa rdf:type xsd:string .

hpc:Spotinstancetemplate a owl:Class .
hpc:Spotinstancetemplate rdfs:subClassOf hpc:Ondemandrequest .

hpc:Allocationstrategy rdfs:domain hpc:Spotinstancetemplate .
