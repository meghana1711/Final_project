hpc:Softwareversion a owl:Class .
hpc:Installablesoftwareversion a owl:Class ;
    rdfs:subClassOf hpc:Softwareversion .

hpc:Maintenanceperiod a owl:Class .

hpc:installbeforemaintenanceperiod a owl:ObjectProperty ;
    rdfs:domain hpc:Installablesoftwareversion ;
    rdfs:range hpc:Softwareversion ;
    rdfs:subPropertyOf rdf:next .

hpc:rollback a owl:ObjectProperty ;
    rdfs:domain hpc:Softwareversion ;
    rdfs:range hpc:Installablesoftwareversion ;
    rdfs:subPropertyOf rdf:previous .

hpc:Libraryconflict a owl:Class .

hpc:avoidslibraryconflicts a owl:ObjectProperty ;
    rdfs:domain hpc:Installablesoftwareversion ;
    rdfs:range hpc:Libraryconflict .
