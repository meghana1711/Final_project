hpc:Pendingreasonsummary a owl:Class .
hpc:Hasjobcount rdfs:domain hpc:Pendingreasonsummary ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hashostcount rdfs:domain hpc:Pendingreasonsummary ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Hasoccurrencecount rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Pendingreason a owl:Class .
hpc:Iseligible rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:boolean .
hpc:Isineligible rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:boolean .
hpc:Istopreason rdfs:domain hpc:Pendingreason ;
    rdfs:range xsd:boolean .
hpc:Hasfilteroptions rdfs:domain hpc:Pendingreasonsummary ;
    rdfs:range rdf:List .
hpc:Filteroption rdfs:domain hpc:Pendingreasonsummary ;
    rdfs:range hpc:Filteroption .
hpc:Filteroption a owl:Class .
hpc:Ispendingjobfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isjobcountfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Ishostfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isoccurrencefilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Isgroupfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isappfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isfwdfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isjobidfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:string .
hpc:Isqueuefilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:string .
hpc:Isuserfilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:string .
hpc:Isslafilter rdfs:domain hpc:Filteroption ;
    rdfs:range xsd:boolean .
hpc:Isperformanceimprovement a owl:Class .
hpc:Improvesreasonperformance rdfs:domain hpc:Performanceimprovement ;
    rdfs:range xsd:boolean .
hpc:Affectsalljobs rdfs:domain hpc:Performanceimprovement ;
    rdfs:range xsd:boolean .
hpc:Affectsbucketinterval rdfs:domain hpc:Performanceimprovement ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Affectshostcount rdfs:domain hpc:Performanceimprovement ;
    rdfs:range xsd:nonNeg
