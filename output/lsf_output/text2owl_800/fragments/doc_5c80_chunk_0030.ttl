hpc:Job a owl:Class .
hpc:Starttime rdfs:domain hpc:Job ;
    rdfs:range xsd:time .
hpc:Terminationtime rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:Computeunitresourcerequirements rdfs:domain hpc:Job ;
    rdfs:range hpc:Computeunitresourcerequirements .
hpc:Maxcomputeunits rdfs:domain hpc:Computeunitresourcerequirements ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Balance rdfs:domain hpc:Computeunitresourcerequirements ;
    rdfs:range xsd:boolean .
hpc:Computeunit a owl:Class .
hpc:Enclosure rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Enclosure .
hpc:Type rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunittype .
hpc:Enclosurecount rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Slotcount rdfs:domain hpc:Enclosure ;
    rdfs:range xsd:nonNegativeInteger .
hpc:computeunitresourcerequirements a owl:ObjectProperty .
hpc:Hascomputeunit rdfs:domain hpc:Job ;
    rdfs:range hpc:Computeunit .
hpc:Hasenclosure rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Enclosure .
hpc:Hastype rdfs:domain hpc:Computeunit ;
    rdfs:range hpc:Computeunittype .
hpc:Enclosure a owl:Class .
hpc:Computeunittype a owl:Class .
