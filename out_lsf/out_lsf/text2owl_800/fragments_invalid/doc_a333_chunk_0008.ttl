hpc:LsfScheduling a owl:Class .
hpc:compressionFactor rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfScheduling ;
    rdfs:range xsd:nonNegativeInteger .
hpc:schedulingCycleTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfScheduling ;
    rdfs:range xsd:nonNegativeDuration .
hpc:simulationTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfScheduling ;
    rdfs:range xsd:nonNegativeDuration .
hpc:averageSchedulingCycleTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfScheduling ;
    rdfs:range xsd:nonNegativeDuration .
hpc:averageJobLength rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsfScheduling ;
    rdfs:range xsd:nonNegativeDuration .
hpc:schedulingEfficiencyMetrics rdf:type owl:Class .
hpc:RELAX_JOB_DISPATCH_ORDER rdf:type owl:Class .
hpc:maximumReuseTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:RelaxJobDispatchOrder ;
    rdfs:range xsd:nonNegativeInteger .
hpc:LsfSimulatorOperatingSystem a owl:Class .
hpc:Linux a owl:Class ;
    rdfs:subClassOf hpc:LsfSimulatorOperatingSystem .
hpc:X64Platform a owl:Class .
hpc:Red_Hat_Enterprise_Linux rdf:type hpc:Linux ;
    rdfs:subClassOf hpc:X64Platform .
hpc:CentOS rdf:type hpc:Linux ;
    rdfs:subClassOf hpc:X64Platform .
hpc:Ubuntu rdf:type hpc:Linux ;
    rdfs:subClassOf hpc:X64Platform .
hpc:Docker_CE rdf:type owl:Class .
hpc:version rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:DockerCe ;
    rdfs:range xsd:string .
hpc:installedAndRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfSimulatorOperatingSystem ;
    rdfs:range hpc:DockerCe .
hpc:portNotInUse rdf:type owl:Class .
hpc:portNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Portnotinuse ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Internet_Access rdf:type owl:Class .
hpc:LSF_server_or_client rdf:type owl:Class .
hpc:productionEnvironment rdf:type owl:Class .
hpc:load_LSF_configuration
