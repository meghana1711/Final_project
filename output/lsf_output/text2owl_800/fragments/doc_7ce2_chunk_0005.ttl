hpc:Maxconcurrentquery a owl:Class ;
    rdfs:comment "Maximum number of concurrent queries." .

hpc:avoidheavyqueryoperations a owl:ObjectProperty ;
    rdfs:comment "Avoid using heavy query operations." .

hpc:minimizedataprocessingvolume a owl:ObjectProperty ;
    rdfs:comment "Methods to minimize data processing volume." .

hpc:writescriptstoparsejobinformation a owl:ObjectProperty ;
    rdfs:comment "Write scripts to parse job information." ;
    rdfs:domain hpc:Avoidheavyqueryoperations ;
    rdfs:range hpc:Script .

hpc:Script a owl:Class .
