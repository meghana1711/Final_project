hpc:Licenseproject a owl:Class .
hpc:haslicense a owl:ObjectProperty ;
    rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .
hpc:numbernonsharedlicenses a owl:DatatypeProperty ;
    rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Nonsharedlicense a owl:Class .
hpc:isnonsharedlicense a owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range hpc:Nonsharedlicense .
hpc:Lanserver a owl:Class .
hpc:Projectmode a owl:Class .
hpc:Fastdispatchprojectmode a owl:Class .
hpc:ownership a owl:DatatypeProperty ;
    rdfs:domain hpc:Licenseproject ;
    rdfs:range xsd:nonNegativeInteger .
hpc:distributionshareratio a owl:ObjectProperty ;
    rdfs:domain hpc:Project .
hpc:nonshareddistribution a owl:ObjectProperty ;
    rdfs:domain hpc:Licenseproject ;
    rdfs:range rdf:List .
hpc:nonshareddistributionvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Nonshareddistribution ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lp1 a hpc:Project ;
    hpc:Haslicense hpc:vcs-RUNTIME ;
    hpc:Distributionshareratio hpc:lanserver (hpc:Lp1 4/10 hpc:Lp2 1) ;
    hpc:Nonshareddistribution hpc:lanserver (hpc:Lp1 10) .
