hpc:Userspecifiedhostfile a owl:Class .
hpc:hashost a owl:ObjectProperty ;
    rdfs:domain hpc:Userspecifiedhostfile ;
    rdfs:range xsd:string .
hpc:hasslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Userspecifiedhostfile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:iscomment a owl:ObjectProperty ;
    rdfs:domain hpc:Userspecifiedhostfile ;
    rdfs:range xsd:string .
hpc:Userspecifiedhostfilecomment a owl:Class ;
    rdfs:subClassOf hpc:Userspecifiedhostfile .

hpc:Userspecifiedhostfileline a owl:Class ;
    rdfs:subClassOf hpc:Userspecifiedhostfile .
hpc:hashostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Userspecifiedhostfileline ;
    rdfs:range xsd:string .
hpc:hasslotcount a owl:DatatypeProperty ;
    rdfs:domain hpc:Userspecifiedhostfileline ;
    rdfs:range xsd:nonNegativeInteger .
