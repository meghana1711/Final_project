hpc:JobSubmitFunction a owl:Function .
hpc:job_submit rdf:type hpc:JobSubmitFunction ;
    rdfs:domain hpc:JobDescriptor ;
    rdfs:domain xsd:unsignedInt ;
    rdfs:domain rdf:PlainLiteral ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:range xsd:unsignedInt .

hpc:JobDescriptor a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:SubmitUID a owl:DatatypeProperty ;
    rdfs:domain hpc:JobSubmitFunction .

hpc:ErrorMsg a owl:ObjectProperty ;
    rdfs:domain hpc:JobSubmitFunction ;
    rdfs:range rdf:PlainLiteral .
