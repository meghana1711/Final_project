hpc:Jobsubmission a owl:Class .
hpc:cleanperioddone a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:integer .
hpc:cleanperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:integer .
hpc:jobhistoricalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range xsd:integer .
hpc:dynamicuserprioritycalculation a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Jobsubmission .
hpc:Resourceintegration a owl:Class .
hpc:portablehardwarelocality a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceintegration ;
    rdfs:range hpc:Hardware .
hpc:applicationnvidiagpu a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceintegration ;
    rdfs:range hpc:Application .
hpc:applicationintelmic a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceintegration ;
    rdfs:range hpc:Application .
hpc:CleanPeriodDoneLimit a owl:Restriction ;
    rdfs:onClass hpc:CleanPeriodDone ;
    owl:onProperty hpc:CleanPeriodDone ;
    owl:hasValue xsd:7 ;
    owl:maxCardinality 1 .
hpc:CleanPeriodDoneValueLessThanCleanPeriod a owl:Restriction ;
    rdfs:onClass hpc:CleanPeriodDone ;
    owl:onProperty hpc:CleanPeriodDone ;
    owl:hasValue xsd:positiveInteger ;
    owl:allValuesFrom hpc:CleanPeriod .
