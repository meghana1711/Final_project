hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:statustext a owl:DatatypeProperty ;
    rdfs:domain hpc:Externalstatus ;
    rdfs:range xsd:string .
hpc:Exit a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:External a owl:Class .
hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:External ;
    rdfs:range hpc:Job .
hpc:hasstatustext a owl:ObjectProperty ;
    rdfs:domain hpc:External ;
    rdfs:range hpc:Statustext .
hpc:Done a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Postdone a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Posterr a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:hasid a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobid .
hpc:External(?job ?statusText) a hpc:External .
hpc:Exit(?job) a hpc:Exit ;
    hpc:hasJob ?job .
hpc:exit(?job) a hpc:Exit ;
    hpc:hasJob ?job .
hpc:exit(?job ?exitCode) a hpc:Exit ;
    hpc:hasJob ?job ;
    hpc:hasExitCode ?exitCode .
hpc:post_done(?job) a hpc:PostDone ;
    hpc:hasID ?job .
hpc:post_err(?job) a hpc:PostErr ;
    hpc:hasID ?job .
hpc:post_done(?jobID) a hpc:PostDone ;
    hpc:hasID ?jobID .
hpc:post_err(?jobID) a hpc:PostErr ;
    hpc:hasID ?jobID .
