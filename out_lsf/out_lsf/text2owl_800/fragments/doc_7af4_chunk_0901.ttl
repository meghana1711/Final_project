hpc:Cache a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A cache used by LSF data manager." .

hpc:cachepermissions a owl:DatatypeProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:string ;
    rdfs:comment "The permissions affecting the directory structure of the staging area cache." .

hpc:Stagingarea a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The staging area used by LSF data manager." .

hpc:Cachesubdirectory a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A subdirectory within the staging area cache." .

hpc:cacherefreshinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Limits the number of transfer jobs to the data manager by setting a refresh interval for the file cache." .

hpc:Transferjob a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A transfer job performed by LSF data manager." .

hpc:filetransfercmd a owl:ObjectProperty ;
    rdfs:domain hpc:Datamanager ;
    rdfs:range hpc:Command ;
    rdfs:comment "The command used by LSF data manager to transfer data files." .
