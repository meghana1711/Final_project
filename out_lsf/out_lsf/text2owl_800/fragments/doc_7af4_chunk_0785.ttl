hpc:LsfDaemon a owl:Class .
hpc:daemonnicevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range xsd:integer .
hpc:lsfDaemonNiceMbatchd a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDaemon ;
    rdfs:range hpc:Daemonnicevalue ;
    rdfs:rangeMin xsd:negative20 ;
    rdfs:rangeMax xsd:positive19 ;
    rdfs:comment "Adjusts the UNIX nice value for the mbatchd process." .
hpc:LsfDaemonNicePim rdfs:subClassOf hpc:LsfDaemonNiceMbatchd .
hpc:LSF_Daemon_Nice_PIM rdfs:comment "Nice value for the PIM process." .
hpc:LsfDaemonNiceRes rdfs:subClassOf hpc:LsfDaemonNiceMbatchd .
hpc:LSF_Daemon_Nice_RES rdfs:comment "Nice value for the RES process." .
hpc:defaultPriorityMbatchd a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemonNiceMbatchd ;
    rdfs:range xsd:integer ;
    rdfs:comment "The default priority of the mbatchd process is 0." .
hpc:defaultPriorityPim a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemonNicePim ;
    rdfs:range xsd:integer ;
    rdfs:comment "The default priority of the PIM process is 0." .
hpc:defaultPriorityRes a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDaemonNiceRes ;
    rdfs:range xsd:integer ;
    rdfs:comment "The default priority of the RES process is 0." .
