hpc:Datarequirement a owl:Class .
hpc:sanitycheck a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range rdf:Boolean .

hpc:usergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement .

hpc:preexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range rdf:XMLLiteral .

hpc:postexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range rdf:XMLLiteral .

hpc:erroroutputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .

hpc:environmentvariables a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .

hpc:overwriteerroroutput a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:boolean .

hpc:pendingtimelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:externalschedulingoptions a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range rdf:XMLLiteral .

hpc:perprocessfilesizelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:nonNegativeInteger .

hpc:filetransfer a owl:ObjectProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:string .

hpc:cpufrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Datarequirement ;
    rdfs:range xsd:nonNegativeInteger .
