hpc:Cpu a owl:Class .
hpc:Cpulist a owl:Class .
hpc:Cpurange a owl:Class .
hpc:bindjob a owl:ObjectProperty .
hpc:Haslogiccpu rdfs:domain hpc:Cpu .
hpc:Haslogiccpu rdfs:range hpc:Logiccpu .
hpc:Hascpulist rdfs:domain hpc:Host .
hpc:Hascpulist rdfs:range hpc:Cpulist .
hpc:Hascpurange rdfs:domain hpc:Cpurange .
hpc:Hascpurange rdfs:range xsd:integer .
hpc:Boundtocpu rdfs:domain hpc:Cpulist .
hpc:Boundtocpu rdfs:range hpc:Cpu .
hpc:Cannotbemappedtocpu rdfs:domain hpc:Cpulist .
hpc:Cannotbemappedtocpu rdfs:range hpc:Cpu .
hpc:Jobnotbound a owl:Class .
hpc:Jobbound a owl:Class .
hpc:jobdispatchemail a owl:ObjectProperty .
hpc:Jobdispatchemail rdfs:domain hpc:Job .
hpc:Jobdispatchemail rdfs:range rdf:PlainLiteral .
hpc:jobfinishemail a owl:ObjectProperty .
hpc:Jobfinishemail rdfs:domain hpc:Job .
hpc:Jobfinishemail rdfs:range rdf:PlainLiteral .
hpc:mincpusforjob a owl:DatatypeProperty .
hpc:Mincpusforjob rdfs:domain hpc:Job .
hpc:Mincpusforjob rdfs:range xsd:integer .
hpc:maxcpusforjob a owl:DatatypeProperty .
hpc:Maxcpusforjob rdfs:domain hpc:Job .
hpc:Maxcpusforjob rdfs:range xsd:integer .
hpc:bindjobnone a owl:ObjectProperty .
hpc:bindJobNone rdfs:subPropertyOf hpc:bindJob .
hpc:Bindjobnone rdfs:domain hpc:Host .
hpc:Bindjobnone rdfs:range rdf:PlainLiteral .
hpc:bindJobNone rdfs:comment "Functionally equivalent to the former BIND_JOB=N parameter where the processor binding is disabled." .
