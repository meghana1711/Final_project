    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The bhosts command." .

hpc:LsfBhostsCommandGpuOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfbhostscommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The -gpu option of the bhosts command." .

hpc:LsfLshostsCommand
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The lshosts command." .

hpc:LsfLshostsCommandGpuOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflshostscommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The -gpu option of the lshosts command." .

hpc:LsfLsloadCommand
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "The lsload command." .

hpc:LsfLsloadCommandGpuOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflsloadcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The -gpu option of the lsload command." .

hpc:LsfLsloadCommandGpuLoadOption
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsflsloadcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "The -gpuload option of the lsload command." .

