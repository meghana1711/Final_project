hpc:Computehost a owl:Class .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Computehost ;
    rdfs:range xsd:string .
hpc:cores a owl:DatatypeProperty ;
    rdfs:domain hpc:Computehost ;
    rdfs:range xsd:integer .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Computehost ;
    rdfs:range xsd:decimal .
hpc:Lsfjob a owl:Class .
hpc:numberofcores a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:lsfhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range rdf:List .
hpc:Lsfhost a owl:Class ;
    rdfs:subClassOf hpc:Computehost .
hpc:lsfjobstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:string .
