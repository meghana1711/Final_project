hpc:Ratelimiter a owl:Class .
hpc:Administrator a owl:Class .
hpc:Abusiveuser a owl:Class .
hpc:Misbehavinguser a owl:Class .
hpc:Lsfproxyd a owl:Class .
hpc:Lsfratelimiter a owl:Class .
hpc:Querysource a owl:Class .
hpc:Request a owl:Class .
hpc:datasize a owl:DatatypeProperty ;
    rdfs:domain hpc:Request ;
    rdfs:range xsd:nonNegativeInteger .
hpc:batchoperationcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Request ;
    rdfs:range xsd:nonNegativeInteger .
hpc:rejected a owl:DatatypeProperty ;
    rdfs:domain hpc:Request ;
    rdfs:range xsd:boolean .
hpc:accepted a owl:DatatypeProperty ;
    rdfs:domain hpc:Request ;
    rdfs:range xsd:boolean .
hpc:timereceived a owl:DatatypeProperty ;
    rdfs:domain hpc:Request ;
    rdfs:range xsd:dateTime .
hpc:source a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfratelimiter ;
    rdfs:range hpc:Querysource .
hpc:Lsfcluster a owl:Class .
hpc:Expiredhost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Dynamichost a owl:Class ;
    rdfs:subClassOf hpc:Host .
hpc:Lsfmulticluster a owl:Class .
hpc:globaljobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmulticluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:clusterindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfmulticluster ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Crossclusteruseraccountmapping a owl:Class ;
    rdfs:subClassOf hpc:Useraccount .
hpc:Multiclusterenvironment a owl:Class ;
    rdfs:subClassOf hpc:Lsfmulticluster .
