hpc:Host a owl:Class .
hpc:Candidatehost a owl:Class .
hpc:LsfConf a owl:Class .
hpc:lsfLicSchedHosts a owl:ObjectProperty .
hpc:Lim a owl:Class .
hpc:bld a owl:ObjectProperty .
hpc:Blddaemon a owl:Class .
hpc:mbatchd a owl:ObjectProperty .
hpc:Wanlicenseserver a owl:Class .

hpc:Host rdfs:subClassOf rdf:Resource .
hpc:Candidatehost rdfs:subClassOf hpc:Host .
hpc:LsfConf rdfs:subClassOf rdf:Resource .
hpc:LsfLicSchedHosts rdfs:domain hpc:LsfConf ;
                            rdfs:range xsd:string .
hpc:Lim rdfs:subClassOf rdf:Resource .
hpc:Bld rdfs:domain hpc:Lim ;
                         rdfs:range hpc:Candidatehost .
hpc:Blddaemon rdfs:domain hpc:Bld ;
                          rdfs:range hpc:Candidatehost .
hpc:Mbatchd rdfs:domain hpc:Lim .
hpc:Wanlicenseserver rdfs:subClassOf rdf:Resource .

hpc:Designcenter a owl:Class .
hpc:haslsfConf a owl:ObjectProperty .
hpc:hascandidatehosts a owl:ObjectProperty .
hpc:manageslicenses a owl:ObjectProperty .

hpc:Designcenter rdfs:subClassOf rdf:Resource .
hpc:HaslsfConf rdfs:domain hpc:Designcenter ;
                      rdfs:range hpc:LsfConf .
hpc:Hascandidatehosts rdfs:domain hpc:Designcenter ;
                       rdfs:range xsd:string .
hpc:Manageslicenses rdfs:domain hpc:Designcenter ;
                      rdfs:range hpc:Wanlicenseserver .

hpc:DesignCenter_A a hpc:DesignCenter .
hpc:hostA1 a hpc:Host ;
             hpc:HaslsfConf hpc:lsfConfA ;
             hpc:hasCandidateHosts "hostA1.designcenter_a.com" .
hpc:hostA2 a hpc:Host ;
             hpc:HaslsfConf hpc:lsfConfA ;
             hpc:hasCandidateHosts "hostA2.designcenter_a.com" .
hpc:hostA3 a hpc:Host ;
             hpc:HaslsfConf hpc:lsfConfA ;
             hpc:hasCandidateHosts "hostA3.designcenter_a.com" .
hpc:LSF_Conf_A a hpc:LSF_Conf ;
             hpc:LSF_Lic_Sched_Hosts "hostA1.designcenter_a.com hostA2.designcenter_a.com hostA3.designcenter_a.com" .

