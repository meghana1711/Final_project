hpc:OpenAPISpecification a owl:Class .
hpc:OpenAPISpecificationVersion a owl:Class .
hpc:ViolatesOpenAPISstandard a owl:ObjectProperty .
hpc:OpenAPISpecificationVersion rdfs:subClassOf hpc:OpenAPISpecification .
hpc:hasVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:OpenAPISpecification ;
    rdfs:range xsd:string .
hpc:hasTestUnit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OpenAPISpecification .
hpc:isPerfect rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TestUnit .
hpc:hasNewFieldOrPath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OpenAPISpecificationVersion .
hpc:IgnoredByClients rdf:type owl:Class .
hpc:isUnknownField rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:NewFieldOrPath ;
    rdfs:range hpc:IgnoredByClients .
hpc:OpenAPIReleaseNotes a owl:Class .
hpc:diffQuery rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:OpenAPIReleaseNotes ;
    rdfs:range hpc:OpenAPISpecificationVersion .
hpc:SLURM_CONF a owl:NamedIndividual ;
    hpc:hasValue "dev/null" .
hpc:slurmrestd a owl:Class .
hpc:hasVersionNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:slurmrestd .
hpc:hasService rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:slurmrestd ;
    rdfs:range hpc:Service .
hpc:generatesOpenAPISpec rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:slurmrestd .
```
