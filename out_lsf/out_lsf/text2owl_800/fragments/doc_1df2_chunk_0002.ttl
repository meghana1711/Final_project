hpc:Jobdefinition a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Root element of the JSDL document. Contains the mandatory child element JobDescription." .

hpc:Jobdescription a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "High-level container element that holds more specific description elements. Job Identity Elements." .

hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdescription ;
    rdfs:range xsd:string ;
    rdfs:comment "String used to name the job." .

hpc:jobproject a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdescription ;
    rdfs:range xsd:string ;
    rdfs:comment "String that specifies the project to which the job belongs." .

hpc:Application a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "High-level container element that holds more specific application definition elements." .

hpc:applicationname a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string ;
    rdfs:comment "String that defines the name of an application profile defined in lsb.applications." .

hpc:applicationversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string ;
    rdfs:comment "String that defines the version of the application defined in lsb.applications." .

hpc:candidatehosts a owl:ObjectProperty ;
    rdfs:domain hpc:Jobdescription ;
    rdfs:range hpc:Candidatehost ;
    rdfs:comment "Complex type element that specifies the set of named hosts that can be selected to run the job." .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Candidatehost ;
    rdfs:range xsd:string ;
    rdfs:comment "Contains a single name of a host or host group. See the previous example (CandidateHosts)." .

hpc:exclusiveexecution a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdescription ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Boolean that designates whether the job must have exclusive access to the resources it uses." .
