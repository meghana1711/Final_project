hpc:DailyClearance a owl:Class ;
    rdfs:comment "Cleared every day at midnight." .

hpc:WeeklyClearance a owl:Class ;
    rdfs:comment "Cleared every week on Sunday at time 00:00." .

hpc:MonthlyClearance a owl:Class ;
    rdfs:comment "Cleared on the first day of each month at time 00:00." .

hpc:QuarterlyClearance a owl:Class ;
    rdfs:subClassOf hpc:MonthlyClearance ;
    rdfs:comment "Cleared on the first day of each quarter at time 00:00." .

hpc:YearlyClearance a owl:Class ;
    rdfs:subClassOf hpc:QuarterlyClearance ;
    rdfs:comment "Cleared on the first day of each year at time 00:00." .

hpc:PriorityFavorSmall a owl:DatatypeProperty ;
    rdfs:domain ? . ;
    rdfs:range xsd:boolean .

hpc:PriorityMaxAge a owl:DatatypeProperty ;
    rdfs:domain ? ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies the queue wait time at which the age factor maxes out." .

hpc:PriorityWeightAge a owl:DatatypeProperty ;
    rdfs:domain ? ;
    rdfs:range xsd:integer ;
    rdfs:comment "An unsigned integer that scales the contribution of the age factor." .
```
