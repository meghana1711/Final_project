hpc:FwdJobFactor a owl:Class .

hpc:fairshareadjustment a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:decimal .

hpc:remotefairshareload a owl:ObjectProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range hpc:CpuTimeFactor .

hpc:historicalgpuruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:decimal .

hpc:gpuruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:decimal .

hpc:ngpusphysical a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:nonNegativeInteger .

hpc:gpuRunTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:decimal .

hpc:cputimeremote a owl:DatatypeProperty ;
    rdfs:domain hpc:CpuTimeFactor ;
    rdfs:range xsd:decimal .

hpc:runtimeremote a owl:DatatypeProperty ;
    rdfs:domain hpc:RunTimeFactor ;
    rdfs:range xsd:decimal .

hpc:historicalruntimeremote a owl:DatatypeProperty ;
    rdfs:domain hdfs:RUN_TIME_FACTOR ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf hpc:runTimeRemote .

hpc:committedruntimeremote a owl:DatatypeProperty ;
    rdfs:domain hpc:CommittedRunTimeFactor ;
    rdfs:range xsd:decimal .

hpc:jobslotsremote a owl:DatatypeProperty ;
    rdfs:domain hpc:RunJobFactor ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fwdjobslotsremote a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:nonNegativeInteger .

hpc:fairshareadjustmentremote a owl:DatatypeProperty ;
    rdfs:domain hpc:FwdJobFactor ;
    rdfs:range xsd:decimal .

hpc:historicalgpuruntimeremote a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuRunTimeFactor ;
    rdfs:range xsd:decimal .

hpc:gpuruntimeremote a owl:DatatypeProperty ;
    rdfs:domain hpc:GpuRunTimeFactor ;
    rdfs:range xsd:decimal .

