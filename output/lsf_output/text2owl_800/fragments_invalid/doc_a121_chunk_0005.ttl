hpc:Bjobs a owl:Class .
hpc:Bacct a owl:Class .
hpc:Bhist a owl:Class .
hpc:Suspendedjob a owl:Class .

hpc:hasPendingState an owl:ObjectProperty .
hpc:Haspendstate rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .

hpc:hasEpendTime an owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:dateTime .

hpc:hasIpendTime an owl:DatatypeProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:dateTime .

hpc:calculatesWaitTime an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Time .

hpc:calculatesTurnaroundTime an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Time .

hpc:expansionFactor an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:decimal .

hpc:hogFactor an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range (xsd:decimal | hpc:Time) .

hpc:calculatesWaitTimeE an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Time .

hpc:calculatesTurnaroundTimeE an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range hpc:Time .

hpc:expansionFactorE an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range xsd:decimal .

hpc:hogFactorE an owl:ObjectProperty ;
    rdfs:domain hpc:Bacct ;
    rdfs:range (xsd:decimal | hpc:Time) .

hpc:showsTotalTime an owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range hpc:Time .

hpc:savesEligibleIneligiblePendingJobDataToDisk an owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:boolean .

hpc:recoversEligibleIneligiblePendingInfoOnRestart an owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:boolean .

hpc:lostTimePeriodAsEligiblePendingTimeOnRestart an owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:boolean .

hpc:changesTimeInterval an owl:ObjectProperty ;
    rdfs:domain hpc:Bhist ;
    rdfs:range xsd:integer .

hpc:canBeSuspendedBy an owl
