@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Datarequirement a owl:Class .
hpc:Tag a owl:Class .
hpc:File a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromhost a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobname a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:submittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:datarequirementtype a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdfs:Resource .
hpc:DataRequirement_DataFile a rdfs:Class ;
    rdfs:subClassOf hpc:Datarequirement .
hpc:DataRequirement_Tag a rdfs:Class ;
    rdfs:subClassOf hpc:Datarequirement .
hpc:datafileFilesize a owl:DatatypeProperty ;
    rdfs:domain hpc:DatarequirementDatafile ;
    rdfs:range xsd:decimal .
hpc:datafileModified a owl:DatatypeProperty ;
    rdfs:domain hpc:DatarequirementDatafile ;
    rdfs:range xsd:dateTime .
hpc:tagTagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Tag ;
    rdfs:range xsd:string .
