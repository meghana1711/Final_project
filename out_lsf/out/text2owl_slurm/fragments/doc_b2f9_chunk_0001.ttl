hpc:Slurmcluster a owl:Class .
hpc:Grestype a owl:Class .
hpc:Computenode a owl:Class .
hpc:Gresconf a owl:Class .
hpc:Gres a owl:Class .
hpc:grestypename a owl:DatatypeProperty .
hpc:Grestypenodename rdfs:domain hpc:Computenode ;
    rdfs:range xsd:string .
hpc:gresname a owl:ObjectProperty .
hpc:Gresnode rdfs:domain hpc:Computenode ;
    rdfs:range hpc:Gres .
hpc:Grescount rdfs:domain hpc:Gres ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Gresdevicefile rdfs:domain hpc:Gres ;
    rdfs:range xsd:string .
hpc:Grescores rdfs:domain hpc:Gres ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Noconsume a owl:Class .
hpc:GresTypeHasGres rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Grestype ;
    rdfs:range hpc:Gres .
hpc:ComputeNodeHasGresConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Computenode ;
    rdfs:range hpc:Gresconf .
hpc:GresConfHasGres rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Gresconf ;
    rdfs:range hpc:Gres .
hpc:GresConfHasGresType rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Gresconf ;
    rdfs:range hpc:Grestype .
hpc:GresTypeHasNoConsume rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Grestype ;
    rdfs:range hpc:Noconsume .
