# Classes
hpc:Job a owl:Class .
hpc:QOS a owl:Class .
hpc:PartitionQOS a owl:Class, rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf hpc:QOS ] .
hpc:RelativeQOS a owl:Class, rdfs:subClassOf [ a owl:Class ; rdfs:subClassOf hpc:QOS ] .

# Object Properties
hpc:hasQOS a owl:ObjectProperty .
hpc:hasPartitionQOS a owl:ObjectProperty .
hpc:hasRelativeQOS a owl:ObjectProperty .
hpc:hasPriority a owl:ObjectProperty .
hpc:canPreempt a owl:ObjectProperty .
hpc:canBePreemptedBy a owl:ObjectProperty .
hpc:hasPreemptExemptTime a owl:ObjectProperty .
hpc:hasResourceLimits a owl:ObjectProperty .

# Datatype Properties
hpc:hasPriorityValue xsd:integer .
hpc:hasPreemptExemptTimeValue xsd:nonNegativeInteger .
hpc:hasResourceLimit xsd:nonNegativeInteger .

# Domain and Range
hpc:hasQOS rdfs:domain hpc:Job ;
    rdfs:range hpc:QOS .
hpc:hasPartitionQOS rdfs:domain hpc:PartitionQOS ;
    rdfs:range hpc:QOS .
hpc:hasRelativeQOS rdfs:domain hpc:RelativeQOS ;
    rdfs:range hpc:QOS .
hpc:hasPriority rdfs:domain hpc:QOS ;
    rdfs:range hpc:hasPriorityValue .
hpc:canPreempt rdfs:domain hpc:QOS ;
    rdfs:range hpc:QOS .
hpc:canBePreemptedBy rdfs:domain hpc:QOS ;
    rdfs:range hpc:QOS .
hpc:hasPreemptExemptTime rdfs:domain hpc:QOS ;
    rdfs:range hpc:hasPreemptExemptTimeValue .
hpc:hasResourceLimits rdfs:domain hpc:QOS ;
    rdfs:range rdf:List .
