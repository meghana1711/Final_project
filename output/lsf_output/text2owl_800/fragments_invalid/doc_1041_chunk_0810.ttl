hpc:Host a owl:Class .
hpc:memory a owl:DatatypeProperty .
hpc:HostName an owl:ObjectProperty .
hpc:Maxmemory rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:Numa a owl:Class .
hpc:Numanode a owl:Class ;
    rdfs:subClassOf hpc:Numa .
hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Numanode ;
    rdfs:range xsd:decimal .

hpc:Topology a owl:Class .
hpc:Socket a owl:Class ;
    rdfs:subClassOf hpc:Topology .
hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Socket .
hpc:Thread a owl:Class ;
    rdfs:subClassOf hpc:Core .

hpc:SocketID an owl:DatatypeProperty ;
    rdfs:domain hpc:Socket .

hpc:CoreID an owl:DatatypeProperty ;
    rdfs:domain hpc:Core .

hpc:ThreadID an owl:DatatypeProperty ;
    rdfs:domain hpc:Thread .

hpc:Fpga a owl:Class .
