hpc:Backfilljob a owl:Class .
hpc:Slot a owl:Class .
hpc:runtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Backfilljob ;
    rdfs:range xsd:duration .
hpc:Host a owl:Class .
hpc:hasslot a owl:ObjectProperty ;
    rdfs:domain hpc:Backfilljob ;
    rdfs:range hpc:Slot .
hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .
hpc:Hasmemory rdfs:range xsd:decimal .
hpc:Jobarray a owl:Class .
hpc:arrayspec a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray .
hpc:Jobarraysummary a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:owner a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:numjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:pending a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:done a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:exit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:suspended a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:ususpended a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:psuspended a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraysummary .
hpc:Jobarraydependency a owl:Class .
hpc:dependencyinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarraydependency .
