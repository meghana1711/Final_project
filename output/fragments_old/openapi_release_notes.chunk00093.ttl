hpc:PostRequestBody a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:content ;
                        owl:hasValue "*"^^xsd:string ] .

hpc:Content a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:schema ;
                        owl:hasValue xsd:string ] .

hpc:Schema a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:$ref ;
                        owl:hasValue hpc:v0_0_42_openapi_slurmdbd_qos_resp ] .

hpc:Response a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:content ;
                        owl:hasValue "*"^^xsd:string ] .

hpc:ContentApplicationYAML a hpc:Content ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:mediaType ;
                        owl:hasValue "application/yaml" ] .

hpc:v0_0_42_openapi_slurmdbd_qos_resp a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:v0_0_42_openapi_resp a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Post a rdf:Property ;
    rdfs:domain hpc:Request ;
    rdfs:range hpc:Response .

hpc:mediaType a rdf:Property ;
    rdfs:domain hpc:Content ;
    rdfs:range xsd:string .

hpc:$ref a rdf:Property ;
    rdfs:domain hpc:Schema ;
    rdfs:range xsd:string .

hpc:Request a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Response a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:RequestBody a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Path a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Paths a owl:Class ;
    rdfs:subClassOf [ a owl:Collection ;
                        rdfs:member hpc:Path ] .

hpc:Added a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Removed a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Replaced a owl:Class ;
    rdfs:subClassOf [ a owl:Thing ] .

hpc:Get a rdf:Property
