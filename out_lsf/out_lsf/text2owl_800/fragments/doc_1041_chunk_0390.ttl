hpc:Project a owl:Class .
hpc:inuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:reserve a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:free a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:need a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:acumuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:scaledacum a owl:DatatypeProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:decimal .
hpc:Cluster a owl:Class ;
    rdfs:subClassOf hpc:Project .
hpc:fastdispatchprojectmode a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Project .
