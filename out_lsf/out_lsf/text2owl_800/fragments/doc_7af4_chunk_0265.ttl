hpc:attrTtl a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:parameter .

hpc:Lsfconfiguration a owl:Class .

hpc:minimumValue_ATTR_TTL a xsd:decimal ;
    rdf:value "10m" .

hpc:maximumValue_ATTR_TTL a xsd:decimal ;
    rdf:value "100h" .

# Default value for ATTR_TTL
hpc:default_ATTR_TTL a xsd:decimal ;
    rdf:value "1h" .

# BCONF_DUPLICATE_UNIX_UG
hpc:bconfDuplicateUnixUg a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:parameter .

# BJOBS_RES_REQ_DISPLAY
hpc:bjobsResReqDisplay a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:parameter .

# Values for BJOBS_RES_REQ_DISPLAY
hpc:none a xsd:string ;
    rdf:value "none" .

hpc:brief a xsd:string ;
    rdf:value "brief" .

hpc:full a xsd:string ;
    rdf:value "full" .
