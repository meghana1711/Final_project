hpc:SlurmVersion
    a owl:Class ;
    rdfs:subClassOf ( rdf:type owl:Class ) ;
    rdfs:comment "A specific version of Slurm software." .

hpc:SlurmUpdateNotRecommended
    a owl:Class ;
    rdfs:subClassOf ( rdf:type owl:Class ) ;
    rdfs:comment "A Slurm update that is not recommended for use." .

