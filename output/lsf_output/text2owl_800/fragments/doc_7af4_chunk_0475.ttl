hpc:Preemptablequeue a owl:Class .
hpc:haspreemptablequeue a owl:ObjectProperty .
hpc:Haslowerpriorityqueue rdfs:domain hpc:Preemptablequeue ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasPreemptableQueue .
hpc:Hashigherpriorityqueue rdfs:domain hpc:Preemptablequeue ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasPreemptableQueue .
hpc:Preflevel rdfs:domain hpc:Preemptablequeue ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf rdf:type .
hpc:Lowqueuename rdfs:domain hpc:Preemptablequeue ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf rdf:type .
hpc:Hiqueuename rdfs:domain hpc:Preemptablequeue ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf rdf:type .
hpc:preemptdelay a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptablequeue ;
    rdfs:range xsd:nonNegativeInteger .
