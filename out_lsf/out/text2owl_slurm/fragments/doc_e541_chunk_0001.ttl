hpc:Hdf5profileplugin a owl:Class .
hpc:Timeseries a owl:Class .
hpc:EnergyData a hpc:TimeSeries .
hpc:IOData a hpc:TimeSeries .
hpc:IODataFromInterconnect a hpc:IOData .
hpc:IODataFromFilesystem a hpc:IOData .
hpc:TaskPerformanceData a hpc:TimeSeries .
hpc:LocalDiskIO a hpc:TaskPerformanceData .
hpc:CPUConsumption a hpc:TaskPerformanceData .
hpc:MemoryUse a hpc:TaskPerformanceData .

hpc:Sharedfilesystem a owl:Class .
hpc:profilehdf5dir a owl:ObjectProperty .
hpc:Profilehdf5dir rdfs:domain hpc:Hdf5profileplugin ;
                     rdfs:range rdf:Resource .
hpc:Userdirectory a owl:Class .
hpc:Userdirectory rdfs:subClassOf hpc:Profilehdf5dir .
hpc:Jobhdf5file a owl:Class .
hpc:Jobhdf5file rdfs:subClassOf hpc:Profilehdf5dir .
