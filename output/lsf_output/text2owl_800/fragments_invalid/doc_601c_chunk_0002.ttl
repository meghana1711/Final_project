hpc:Lsfmanagementhost a owl:Class .
hpc:Lsfserverhost a owl:Class .

hpc:hasSameTime as owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range xsd:dateTime .

hpc:hasAppropriateSystemRequirements rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost .

hpc:hasClockSync rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost .

hpc:hasseparateserverforapachehttpserver a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost .

hpc:Apachehttpserver a owl:Class ;
    rdfs:subClassOf hpc:Remoteserver .

hpc:hasVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Apachehttpserver ;
    rdfs:range xsd:string .

hpc:isAccessibleFrom rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfmanagementhost ;
    rdfs:range hpc:Highavailabilityenvironment .

hpc:Highavailabilityenvironment a owl:Class .

hpc:hasSharedFileSystem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Highavailabilityenvironment .

hpc:hasUniformAccessPath rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sharedfilesystem .

hpc:hasPermissionRootUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sharedfilesystem .

hpc:requiresRootPrivilegesForInstallation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebservices .

hpc:hasHomeDirectoryPath rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfwebservices ;
    rdfs:range xsd:string .

hpc:hasNFSorNASSANCloudStorage rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Homedirectorypath .

hpc:downloadFromSite rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebservicesinstallationpackage .

hpc:hasOperatingSystemType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfwebservicesinstallationpackage ;
    rdfs:range xsd:string .

hpc:requiresMatchingOS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfinstallation .

hpc:requiresDownloadToSharedFileSystem rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfwebservicesinstallationpackage .

hpc:Installationprocedure a owl:Class .

hpc:ProcedureStep rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Installationprocedure .
