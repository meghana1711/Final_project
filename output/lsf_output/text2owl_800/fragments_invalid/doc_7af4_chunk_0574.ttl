hpc:Serviceclass a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Namedentity ;
    rdfs:label "ServiceClass"@en ;
    rdfs:comment "Required. A unique name that identifies the service class." ;
    rdfs:domain hpc:Servicemanager ;
    rdfs:range xsd:string ;
    rdfs:maxLength "60"^^xsd:integer ;
    rdfs:pattern "^[a-zA-Z0-9_-\s]+$" ;
    rdfs:seeAlso <http://example.org/hpc#UniqueNameConstraint> .

hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:string ;
    rdfs:label "NAME"@en ;
    rdfs:comment "Required." ;

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceclass ;
    rdfs:range xsd:integer ;
    rdfs:label "PRIORITY"@en ;
    rdfs:comment "Required (time-based SLAs only)." ;

hpc:maxHostIdleTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Guaranteesla ;
    rdfs:range xsd:integer ;
    rdfs:label "MAX_HOST_IDLE_TIME"@en ;
    rdfs:comment "Do not set this parameter to a small value, or LSF may release hosts too quickly." ;
    rdfs:comment "Guarantee SLAs (with GOALS=[GUARANTEE]) cannot have MAX_HOST_IDLE_TIME set. If deﬁned, it will be ignored." ;
    rdfs:default "120"^^xsd:integer ;
