    rdfs:domain hpc:Job .
hpc:Submittedfrom rdfs:range xsd:string .
hpc:executionhome a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:Executionhome rdfs:range xsd:string .
