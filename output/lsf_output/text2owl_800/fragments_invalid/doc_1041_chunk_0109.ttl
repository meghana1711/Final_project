hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Attribute a owl:Class .
hpc:Userattribute a owl:Class .
hpc:hostAttribute a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
    rdfs:range hpc:Attribute .
hpc:hasAttribute a owl:ObjectProperty ;
    rdfs:domain hpc:Attribute .
    rdfs:range hpc:Host .
hpc:createAttribute a owl:ObjectProperty ;
    rdfs:domain hpc:User .
    rdfs:range hpc:Attribute .
hpc:deleteAttribute a owl:ObjectProperty ;
    rdfs:domain hpc:User .
    rdfs:range hpc:Attribute .
hpc:hostInGroup a owl:ObjectProperty ;
    rdfs:domain hpc:Host .
    rdfs:range hpc:Hostgroup .
hpc:hostsIn a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup .
    rdfs:range rdf:List .
hpc:listMember a owl:ObjectProperty ;
    rdfs:domain rdf:List .
    rdfs:range hpc:Host .
hpc:attributesToDelete a owl:DatatypeProperty ;
    rdfs:domain hpc:DeleteAttribute .
    rdfs:range rdf:List .
hpc:hostCreator a owl:DatatypeProperty ;
    rdfs:domain hpc:Attribute .
    rdfs:range hpc:User .
hpc:userCanDelete a owl:ObjectProperty ;
    rdfs:domain hpc:User .
    rdfs:range xsd:boolean .
hpc:NormalUser a owl:Class .
hpc:ClusterAdmin a owl:Class .
hpc:RootUser a owl:Class .
hpc:attrCreateUsers a owl:ObjectProperty ;
    rdfs:domain hpc:User .
    rdfs:range rdf:List .
hpc:listMemberAttrCreateUsers a owl:ObjectProperty ;
    rdfs:domain rdf:List .
    rdfs:range hpc:Host .
hpc:All a owl:Class .
hpc:allHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Attribute .
    rdfs:range hpc:All .
