hpc:Batchjoboutput a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Default Not defined. Batch job output (standard output and standard error) is sent to the .lsbatch directory on the execution host." ;
    rdfs:label "BatchJobOutput" ;
    rdfs:subClassOf ( hpc:Unixbatchjoboutput rdfs:subClassOf owl:Class ) ;
    rdfs:subClassOf ( hpc:Windowsbatchjoboutput rdfs:subClassOf owl:Class ) ;
    rdfs:domain hpc:Lsbatch ;

hpc:Unixbatchjoboutput a owl:Class ;
    rdfs:subClassOf hpc:Batchjoboutput ;
    rdfs:comment "On UNIX, $HOME/.lsbatch is used for spooled output." ;
    rdfs:label "UNIXBatchJobOutput" ;
    rdfs:subClassOf ( hpc:Linuxbatchjoboutput rdfs:subClassOf owl:Class ) ;

hpc:Windowsbatchjoboutput a owl:Class ;
    rdfs:subClassOf hpc:Batchjoboutput ;
    rdfs:comment "On Windows, %windir%\lsbtmpuser_id\.lsbatch is used for spooled output. If %HOME% is specified in the user environment, uses that directory instead." ;
    rdfs:label "WindowsBatchJobOutput" ;
    rdfs:subClassOf ( hpc:Windowsbatchjoboutputlinuxhome rdfs:subClassOf owl:Class ) ;

hpc:jobTerminateInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Batchjoboutput ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the time interval in seconds between sending SIGINT, SIGTERM, and SIGKILL when terminating a job." ;
    rdfs:label "JOB_TERMINATE_INTERVAL" ;

hpc:JOB_TERMINATE_INTERVAL_Default a xsd:integer ;
    rdfs:value "10" ;

hpc:killJobsOverRunlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbatch ;
    rdfs:range hpc:KillJobsOverRunlimitSetting ;
    rdfs:comment "Enables the mbatchd daemon to kill jobs that are running over the deﬁned RUNLIMIT value for a long period of time." ;
    rdfs:label "KILL_JOBS_OVER_RUNLIMIT" ;

hpc:KillJobsOverRunlimitSetting a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Represents a setting of KILL_JOBS_OVER_RUNLIMIT." ;
    rdfs:label "KILL_JOBS_OVER_RUNLIMIT_Setting" ;
    rdfs:subClassOf ( hpc:KillJobsOverRunlimitInterval rdfs:subClassOf owl:Class ) ;
    rdfs:subClassOf ( hpc:Kill
