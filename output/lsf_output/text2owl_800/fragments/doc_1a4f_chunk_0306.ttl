hpc:Host a owl:Class .
hpc:dispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:Bag .

hpc:Runwindow a owl:Class ;
    rdfs:subClassOf hpc:Dispatchwindow .

hpc:Queue a owl:Class .
hpc:runwindowonqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Runwindow .

hpc:runwindowdefinition a owl:DatatypeProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range xsd:string .

hpc:TimeZone a xsd:string .
hpc:hastimezone a owl:ObjectProperty ;
    rdfs:domain hpc:Runwindowdefinition ;
    rdfs:range hpc:Timezone .

hpc:OpenTime a xsd:string .
hpc:hasopentime a owl:DatatypeProperty ;
    rdfs:domain hpc:Runwindowdefinition ;
    rdfs:range xsd:string .

hpc:ClosedTime a xsd:string .
hpc:hasclosedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Runwindowdefinition ;
    rdfs:range xsd:string .

hpc:IsOpen a owl:FunctionalProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range xsd:boolean .

hpc:IsClosed a owl:FunctionalProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range xsd:boolean .

hpc:IsRunning a owl:FunctionalProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:IsPending a owl:FunctionalProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:suspendjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range hpc:Queue .

hpc:resumejobs a owl:ObjectProperty ;
    rdfs:domain hpc:Runwindow ;
    rdfs:range hpc:Queue .
