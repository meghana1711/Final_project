hpc:Job a owl:Class .
hpc:Slot a owl:Class .
hpc:Core a owl:Class .
hpc:Host a owl:Class .
hpc:Numa a owl:Class .
hpc:Socket a owl:Class .

hpc:Hasslot hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Slot .

hpc:Hascore hpc:slot owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range hpc:Core .

hpc:Runson hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Host .

hpc:Isnuma hpc:host owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Numa .

hpc:Issocket hpc:numa owl:ObjectProperty ;
    rdfs:domain hpc:Numa ;
    rdfs:range hpc:Socket .

hpc:Pack hpc:slot owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range xsd:integer .

hpc:Packon hpc:socket owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:integer .

hpc:Packexclusive hpc:slot owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range xsd:boolean .

hpc:Packinjob hpc:slot owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range xsd:boolean .

hpc:Distribute hpc:slot owl:ObjectProperty ;
    rdfs:domain hpc:Slot ;
    rdfs:range xsd:string .

hpc:Distributeon hpc:socket owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:string .

hpc:Balance hpc:socket owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range xsd:boolean .

hpc:Cpubind hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Cubind hpc:core owl:DatatypeProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range xsd:string .

# CPU and Memory Binding Requests

hpc:Memorybindingjob a owl:Class .
hpc:Memorybindingoption a owl:Class .

hpc:Hasmemorybinding hpc:job owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Memorybindingjob .

hpc:Hasmemorybindingoption hpc:memorybindingjob owl:ObjectProperty ;
    rdfs:domain hpc:Memorybindingjob ;
    rdfs:range hpc:Memorybindingoption .
