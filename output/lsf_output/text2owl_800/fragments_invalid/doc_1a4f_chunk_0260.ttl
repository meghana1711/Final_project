@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Jobslot a owl:Class .
hpc:Host a owl:Class .
hpc:User a owl:Class .
hpc:Queue a owl:Class .
hpc:Project a owl:Class .
hpc:memory a owl:DatatypeProperty .
hpc:slotsperprocessor a owl:DatatypeProperty .
hpc:hasjobslot a owl:ObjectProperty .
hpc:hashost a owl:ObjectProperty .
hpc:hasuser a owl:ObjectProperty .
hpc:hasqueue a owl:ObjectProperty .
hpc:hasproject a owl:ObjectProperty .

hpc:Jobslot rdfs:domain hpc:Job .
hpc:Host rdfs:domain hpc:Jobslot .
hpc:User rdfs:domain hpc:Jobslot .
hpc:Queue rdfs:domain hpc:Jobslot .
hpc:Project rdfs:domain hpc:Jobslot .

hpc:Job rdfs:subClassOf rdf:Resource .
hpc:Host rdfs:subClassOf rdf:Resource .
hpc:User rdfs:subClassOf rdf:Resource .
hpc:Queue rdfs:subClassOf rdf:Resource .
hpc:Project rdfs:subClassOf rdf:Resource .

hpc:Hasjobslot rdfs:range hpc:Jobslot .
hpc:Hashost rdfs:range hpc:Host .
hpc:Hasuser rdfs:range hpc:User .
hpc:Hasqueue rdfs:range hpc:Queue .
hpc:Hasproject rdfs:range hpc:Project .

hpc:Memory rdfs:domain hpc:Jobslot .
hpc:Memory rdfs:range xsd:decimal .

hpc:Slotsperprocessor rdfs:domain hpc:Limit .
hpc:Slotsperprocessor rdfs:range xsd:nonNegativeInteger .

hpc:Limit a owl:Class .

hpc:Limit rdfs:subClassOf rdf:Resource .

hpc:name a owl:DatatypeProperty .
hpc:hosts a owl:ObjectProperty .
hpc:slots a owl:DatatypeProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:tmp a owl:DatatypeProperty .
hpc:users a owl:ObjectProperty .
hpc:queues a owl:ObjectProperty .
hpc:projects a owl:ObjectProperty .

hpc:Name rdfs:domain hpc:Limit .
hpc:Name rdfs:range xsd:string .

h
