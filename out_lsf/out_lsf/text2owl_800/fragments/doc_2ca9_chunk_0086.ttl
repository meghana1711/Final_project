hpc:Jobinfoaccesscontrol a owl:Class .

# Settings for job information access control class
hpc:Settingjobinfoaccesscontrol a owl:Class ;
    rdfs:subClassOf hpc:Jobinfoaccesscontrol .

# SecureInfoDirUserAccess property
hpc:secureinfodiruseraccess a owl:ObjectProperty ;
    rdfs:domain hpc:Settingjobinfoaccesscontrol ;
    rdfs:range xsd:string .

# SecureJobInfoLevel property
hpc:securejobinfolevel a owl:ObjectProperty ;
    rdfs:domain hpc:Settingjobinfoaccesscontrol ;
    rdfs:range xsd:integer .

# EnableJobInfoByAdminRole property
hpc:enablejobinfobyadminrole a owl:ObjectProperty ;
    rdfs:domain hpc:Settingjobinfoaccesscontrol ;
    rdfs:range xsd:boolean .

# CustomizeUserInfoOutput class
hpc:Customizeuserinfooutput a owl:Class ;
    rdfs:subClassOf hpc:Jobinfoaccesscontrol .

# BusersCommand property
hpc:buserscommand a owl:ObjectProperty .

# LsbBusersFormat property
hpc:lsbbusersformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Buserscommand ;
    rdfs:range xsd:string .
