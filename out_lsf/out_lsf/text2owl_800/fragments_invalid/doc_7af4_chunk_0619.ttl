hpc:Namedresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:hasName an owl:ObjectProperty ;
    rdfs:domain hpc:Namedresource ;
    rdfs:range xsd:string .

hpc:isSharedBy an owl:ObjectProperty ;
    rdfs:domain hpc:Namedresource ;
    rdfs:range rdf:List .

hpc:Sharedinstance a owl:Class ;
    rdfs:subClassOf hpc:Namedresource ;
    rdfs:subClassOf hpc:Resource .

hpc:isInstanceOf an owl:ObjectProperty ;
    rdfs:domain hpc:Sharedinstance ;
    rdfs:range hpc:Resource .

hpc:Allhosts a owl:Class ;
    rdfs:subClassOf hpc:Sharedinstance .

hpc:excludeHost an owl:ObjectProperty ;
    rdfs:domain hpc:Allhosts ;
    rdfs:range xsd:string .
