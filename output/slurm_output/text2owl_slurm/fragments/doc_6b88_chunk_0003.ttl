hpc:Authenticationproxy a owl:Class .
hpc:Amazoncognito rdfs:subClassOf hpc:Authenticationproxy .
hpc:Keycloak rdfs:subClassOf hpc:Authenticationproxy .
hpc:Keycloakstandaloneuse rdfs:subClassOf hpc:Keycloak .
hpc:Slurmjwt a owl:Class .
hpc:jwtkey a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmjwt ;
    rdfs:range xsd:string .
hpc:jwtkeyfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwtkey ;
    rdfs:range xsd:string .
hpc:jwtkeylocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwtkey ;
    rdfs:range xsd:string .
hpc:jwtkeypermissions a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwtkey ;
    rdfs:range xsd:string .
hpc:authalttypes a owl:ObjectProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:authaltparameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
hpc:Slurm a owl:Class .
hpc:Slurmcontroller a owl:Class ;
    rdfs:subClassOf hpc:Slurm .
hpc:Slurmdbd a owl:Class ;
    rdfs:subClassOf hpc:Slurm .
hpc:tokenlifespan a owl:DatatypeProperty ;
    rdfs:domain hpc:Authaltparameters ;
    rdfs:range xsd:integer .
hpc:disabletokencreation a owl:DatatypeProperty ;
    rdfs:domain hpc:Authaltparameters ;
    rdfs:range xsd:boolean .
hpc:slurmrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmcontroller ;
    rdfs:range xsd:string .
hpc:usertokencreation a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmcontroller ;
    rdfs:range xsd:string .
hpc:Externalauthentication a owl:Class .
hpc:jwks a owl:ObjectProperty ;
    rdfs:domain hpc:Externalauthentication ;
    rdfs:range xsd:string .
hpc:Rs256tokens a owl:Class ;
    rdfs:subClassOf hpc:Externalauthentication .
hpc:jwksfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jwks ;
    rdfs:range xsd:string .
