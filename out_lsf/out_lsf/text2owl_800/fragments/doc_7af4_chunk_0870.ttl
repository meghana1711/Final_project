hpc:LSF_PROXYD_TOKEN_WAIT_TIME
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Userrequest ;
    rdfs:range xsd:integer ;
    rdfs:comment "Time a non-root or non-administrator user must wait before being denied a token." .

hpc:UserRequest
    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                       rdfs:subClassOf rdf:Resource ] .

hpc:rootUser
    a owl:Class ;
    rdfs:subClassOf hpc:Userrequest ;
    rdfs:comment "A user with root privileges." .

hpc:administratorUser
    a owl:Class ;
    rdfs:subClassOf hpc:Userrequest ;
    rdfs:comment "An LSF cluster administrator user." .

hpc:grantedToken
    a owl:ObjectProperty ;
    rdfs:domain hpc:Userrequest ;
    rdfs:range hpc:Token ;
    rdfs:comment "A token granted to a user." .

hpc:deniedToken
    a owl:ObjectProperty ;
    rdfs:domain hpc:Userrequest ;
    rdfs:range hpc:Token ;
    rdfs:comment "A token denied to a user." .

hpc:Token
    a owl:Class ;
    rdfs:comment "A token that allows a user to proceed to contact the mbatchd daemon." .
