    rdfs:domain hpc:Job ;
    rdfs:range xsd:float .
hpc:frequencyUnit rdf:Datatype ;
    rdfs:subClassOf xsd:string .
hpc:schedulejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .
hpc:enforceoneuglimits a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Usergroup .
hpc:Usergroup a owl:Class .
hpc:isfairsharegroup a owl:ObjectProperty ;
    rdfs:domain hpc:Usergroup .
hpc:belongstousergroup a owl:ObjectProperty ;
    rdfs:domain hpc:User .
hpc:excludefromusergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:User a owl:Class .
