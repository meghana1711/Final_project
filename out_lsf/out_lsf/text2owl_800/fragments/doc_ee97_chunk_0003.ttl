hpc:Lsf a owl:Class .
hpc:Apachehadoopintegration a owl:Class .
hpc:Hadoopcluster a owl:Class .
hpc:Hadoopversion a owl:Class .
hpc:Platform a owl:Class .
hpc:hasplatform a owl:ObjectProperty .
hpc:hashadoopversion a owl:ObjectProperty .
hpc:hashadoopcluster a owl:ObjectProperty .
hpc:hasfilesystem a owl:ObjectProperty .
hpc:hasjavaruntime a owl:ObjectProperty .
hpc:lsfcontrolsjoblifecycle a owl:DatatypeProperty .
hpc:usessharedfilesystems a owl:DatatypeProperty .
hpc:Apachehadoopintegration rdfs:subClassOf owl:Class .
hpc:Hadoopcluster rdfs:subClassOf owl:Class .
hpc:Hadoopversion rdfs:subClassOf owl:Class .
hpc:Platform rdfs:subClassOf owl:Class .
hpc:Hasplatform rdfs:domain hpc:Apachehadoopintegration ;
                          rdfs:range hpc:Platform .
hpc:Hashadoopversion rdfs:domain hpc:Apachehadoopintegration ;
                          rdfs:range hpc:Hadoopversion .
hpc:Hashadoopcluster rdfs:domain hpc:Apachehadoopintegration ;
                          rdfs:range hpc:Hadoopcluster .
hpc:Hasfilesystem rdfs:domain hpc:Hadoopcluster ;
                     rdfs:range rdf:Resource .
hpc:Hasjavaruntime rdfs:domain hpc:Apachehadoopintegration ;
                          rdfs:range rdf:Resource .
hpc:Lsfcontrolsjoblifecycle rdfs:domain hpc:Lsf ;
                             rdfs:range xsd:boolean .
hpc:Usessharedfilesystems rdfs:domain hpc:Hadoopcluster ;
                             rdfs:range xsd:boolean .
