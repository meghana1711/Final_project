hpc:Reservationusage a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "This is the equivalent of specifying PER_HOST for the METHOD parameter in the ReservationUsage section of the lsb.resources file." .

hpc:gpuReq a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationusage ;
    rdfs:range xsd:string ;
    rdfs:comment "Related to specifying GPU resource requirements." .

hpc:Configuringgpuresources a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Configuring GPU resource requirements." .

hpc:Submittinggpujobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Submitting jobs that require GPU resources." .

hpc:bsubGpu a owl:ObjectProperty ;
    rdfs:domain hpc:Submittinggpujobs ;
    rdfs:range xsd:string ;
    rdfs:comment "Related reference for submitting jobs with GPU resources." .

hpc:lsbGpuReq a owl:ObjectProperty ;
    rdfs:domain hpc:Configuringgpuresources ;
    rdfs:range xsd:string ;
    rdfs:comment "Parameter in the lsf.conf file." .

hpc:gpuReqLsbApplications a owl:ObjectProperty ;
    rdfs:domain hpc:Configuringgpuresources ;
    rdfs:range xsd:string ;
    rdfs:comment "GPU_REQ parameters in the lsb.applications file." .

hpc:gpuReqLsbQueues a owl:ObjectProperty ;
    rdfs:domain hpc:Configuringgpuresources ;
    rdfs:range xsd:string ;
    rdfs:comment "GPU_REQ parameters in the lsb.queues file." .

hpc:Supportfornvidiadgxsystems a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Support for NVIDIA DGX systems." .

hpc:lsfSupportsNvidiaGpuSupport a owl:ObjectProperty ;
    rdfs:domain hpc:Supportfornvidiadgxsystems ;
    rdfs:range xsd:boolean ;
    rdfs:comment "LSF automatically detects and configures NVIDIA GPU support." .

hpc:Jobschedulingandexecution a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The following new features affect job scheduling and execution." .

hpc:Specifytimezones a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "LSF now allows you to specify supported time zones in time-based configurations." .

hpc:timezonesintimebasedconfigurations a owl:ObjectProperty ;
    rdfs:domain hpc:Specifytimezones ;
    rdfs:range xsd:string ;
