hpc:Elimprogram rdfs:subClassOf hpc:Resourcemanagementtool .
hpc:License rdfs:subClassOf hpc:Softwarelicense .
hpc:Resource rdfs:subClassOf hpc:Computingresource .
hpc:Flexlm rdfs:subClassOf hpc:Software .
