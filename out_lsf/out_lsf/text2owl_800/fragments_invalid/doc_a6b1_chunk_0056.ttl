hpc:Externalauthenticationbehavior a owl:Class .
hpc:Eauthexecutable a owl:Class .
hpc:Hostname a owl:Class .
hpc:Sitespecificauthenticationmethod a owl:Class .
hpc:Kerberos a owl:Class .
hps:DCESecurityServices a owl:Class .

hpc:uses a owl:ObjectProperty .
hpc:runsunder a owl:ObjectProperty .
hpc:hasencryptionkey a owl:DatatypeProperty .
hpc:isdefault a owl:DatatypeProperty .

hpc:EauthExecutable hps:runsUnder hpc:UserAccount .
hpc:EauthExecutable hps:hasEncryptionKey xsd:string .
hpc:EauthExecutable hps:isDefault xsd:boolean .
hpc:Sitespecificauthenticationmethod rdfs:subClassOf hpc:Authenticationmethod .
hpc:Kerberos rdfs:subClassOf hpc:Sitespecificauthenticationmethod .
hpc:Dcesecurityservices rdfs:subClassOf hpc:Sitespecificauthenticationmethod .
hpc:EauthExecutable hps:uses hpc:SiteSpecificAuthenticationMethod .
hpc:Lsf rdfs:subClassOf hpc:System .
hpc:LSF hps:uses hpc:EauthExecutable .
hpc:lsfEauthKey a owl:DatatypeProperty .
hpc:lsfServerdir a owl:DatatypeProperty .

hpc:LsfEauthKey rdfs:domain hpc:Lsf .
hpc:LsfServerdir rdfs:domain hpc:Lsf .
hpc:LsfEauthKey rdfs:range xsd:string .
hpc:LsfServerdir rdfs:range xsd:string .
