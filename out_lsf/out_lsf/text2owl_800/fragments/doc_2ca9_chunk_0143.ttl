hpc:Lsbuser a owl:Class .
hpc:Jobthreshold a owl:Class .
hpc:Jobcount a owl:Class .
hpc:Hostloadinfo a owl:Class .

# Object Properties
hpc:hasjobcount a owl:ObjectProperty ;
    rdfs:domain hpc:Jobcount ;
    rdfs:range hpc:Lsbuser .
hpc:hasjobthreshold a owl:ObjectProperty ;
    rdfs:domain hpc:Jobthreshold ;
    rdfs:range hpc:Lsbuser .
hpc:hashostloadinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Hostloadinfo ;
    rdfs:range hpc:Lsbuser .

# Datatype Properties
hpc:pendingjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcount ;
    rdfs:range xsd:nonNegativeInteger .
hpc:pendingjobslotthreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobthreshold ;
    rdfs:range xsd:nonNegativeInteger .

# Class Subclass Relations
hpc:Jobcount rdfs:subClassOf hpc:Jobcountorthreshold .
hpc:Jobthreshold rdfs:subClassOf hpc:Jobcountorthreshold .
hpc:Hostloadinfo rdfs:subClassOf hpc:Customizedoutput .

# Classes for Parameters
hpc:Maxpendingjobs a owl:Class ;
    rdfs:subClassOf hpc:Parameter .
hpc:Maxpendingslots a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

# Object Property for Parameters
hpc:defines a owl:ObjectProperty ;
    rdfs:domain hpc:Parameter ;
    rdfs:range hpc:Configurationfile .

# Configuration File Class
hpc:Configurationfile a owl:Class .

# Annotations
hpc:busers-w hpc:relatedTo hpc:CustomizeHostLoadInfoOutput ;
    hpc:Relatedto hpc:lsload-json-command-option ;
    hpc:Relatedto hpc:newoutputfieldsforbusers .
hpc:lsload-json-command-option hpc:relatedTo hpc:CustomizeHostLoadInfoOutput ;
    hpc:Relatedto hpc:relatedconcepts .
hpc:Newoutputfieldsforbusers hpc:relatedto hpc:CustomizeHostLoadInfoOutput ;
    hpc:Relatedto hpc:lsload-json-command-option ;
    hpc:Relatedto hpc:newoutputfields .
hpc:Newoutputfields hpc:relatedto hpc:CustomizeHostLoadInfoOutput ;
    hpc:Relatedto hpc:lsload-json-command-option ;
    hpc:Relatedto hpc:loggingandtroubleshooting .
hpc:Diagnosembatchdandmbschdperformanceproblems hpc:relatedto hpc:LoggingAndTroubleshooting .
