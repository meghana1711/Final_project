@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Startupscript a owl:Class.
hpc:StartupScript rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Keycloakinstance;
    rdfs:range rdf:XMLLiteral.

hpc:Dockerfile a owl:Class.
hpc:Dockerfile rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Keycloakinstance;
    rdfs:range rdf:XMLLiteral.

hpc:Environmentvariable a owl:Class.
hpc:EnvironmentVariable rdf:type owl:ObjectProperty;
    rdfs:domain hpc:Keyclo
