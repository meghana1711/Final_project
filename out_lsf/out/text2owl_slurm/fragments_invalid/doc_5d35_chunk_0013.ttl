hpc:Job a owl:Class .
hpc:Heterogeneousjob a owl:Class .

hpc:hascomponent a owl:ObjectProperty .
hpc:Hascomponent rdfs:domain hpc:Job ;
                     rdfs:range hpc:Job .

hpc:expectedstarttime a owl:DatatypeProperty .
hpc:Expectedstarttime rdfs:domain hpc:Heterogeneousjob ;
                      rdfs:range xsd:dateTime .

hpc:Firstmode a owl:Class .
hpc:Secondmode a owl:Class .

hpc:Job
