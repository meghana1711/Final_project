hpc:Node a owl:Class .
hpc:CoreBlock a owl:Class .
hpc:CyclicCore a owl:Class .
hpc:CoreMapping a owl:Class .
hpc:Processor a owl:Class .
hpc:TaskID a owl:Class .

hpc:hasCore a owl:ObjectProperty .
hpc:hasProcessor a owl:ObjectProperty .
hpc:hasTaskID a owl:ObjectProperty .
