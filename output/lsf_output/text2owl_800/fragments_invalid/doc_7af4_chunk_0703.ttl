hpc:Nvidiak80hardware a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "Supports auto boost and switch power limits. NVML library must be Version 6.340 or newer." .

hpc:nvmllibraryversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Nvidiak80hardware ;
    rdfs:range xsd:string ;
    rdfs:comment "Version of NVML library required." .

hpc:lsbGslaDisplayAllocHosts a owl:ObjectProperty ;
    rdfs:domain hpc:Nvidiak80hardware ;
    rdfs:range xsd:string ;
    rdfs:comment "If set to Y or y, the bsla command displays information on guarantee hosts that are being used (allocated) from each guarantee pool for the guarantee SLA." .

hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbGslaDisplayAllocHosts ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value of LSB_GSLA_DISPLAY_ALLOC_HOSTS." .

hpc:LSB_GSLA_DISPLAY_ALLOC_HOST_Value a owl:NamedIndividual ;
    hpc:LSB_GSLA_DISPLAY_ALLOC_HOST rdf:datatype xsd:string ;
    hpc:LSB_GSLA_DISPLAY_ALLOC_HOST "N" .

hpc:lsbGslaPreferAdrsvHost a owl:ObjectProperty ;
    rdfs:domain hpc:Nvidiak80hardware ;
    rdfs:range xsd:string ;
    rdfs:comment "If set to Y or y, the guarantee SLA will first try to reserve hosts without advanced reservation." .

hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbGslaPreferAdrsvHost ;
    rdfs:range xsd:string ;
    rdfs:comment "Default value of LSB_GSLA_PREFER_ADRSV_HOST." .

hpc:LSB_GSLA_PREFER_ADRSV_HOST_Value a owl:NamedIndividual ;
    hpc:LSB_GSLA_PREFER_ADRSV_HOST rdf:datatype xsd:string ;
    hpc:LSB_GSLA_PREFER_ADRSV_HOST "N" .

hpc:lsbHjobPerSession a owl:DatatypeProperty ;
    rdfs:domain hpc:Nvidiak80hardware ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the maximum number of jobs that can be dispatched in each scheduling cycle to each host" .

hpc:NotDefined a owl:NamedIndividual ;
    hpc:LSB_HJOB_PER_SESSION rdf:datatype xsd:integer .

hpc:lsbHjobPerSessionActivation a owl:ObjectProperty ;
    r
