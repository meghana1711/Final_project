hpc:Invalidhostaddressrange a owl:Class .
hpc:Validipv4addressrange a owl:Class .
hpc:Validipv6addressrange a owl:Class .
hpc:lsfHostAddrRange a owl:ObjectProperty .

hpc:Invalidhostaddressrange rdfs:subClassOf owl:Class .
hpc:Validipv4addressrange rdfs:subClassOf hpc:Invalidhostaddressrange .
hpc:Validipv6addressrange rdfs:subClassOf owl:Class .

hpc:LsfHostAddrRange rdfs:domain rdf:Resource .
hpc:LsfHostAddrRange rdfs:range hpc:Ipaddress .

hpc:Ipv4address a owl:Class .
hpc:Ipv6address a owl:Class .
hpc:Invalidipv6address a owl:Class .
hpc:Validipv6address a owl:Class .

hpc:Ipv4address rdfs:subClassOf hpc:Ipaddress .
hpc:Ipv6address rdfs:subClassOf hpc:Ipaddress .
hpc:Invalidipv6address rdfs:subClassOf hpc:Ipv6address .
hpc:Validipv6address rdfs:subClassOf hpc:Ipv6address .

hpc:IPv4Address rdf:type xsd:string .
hpc:IPv6Address rdf:type xsd:string .

hpc:InvalidIPv6Address rdf:type hpc:IPv6Address .
hpc:Invalidipv6address rdfs:range xsd:string .
hpc:Invalidipv6address rdfs:range ^"[^0-9a-f:]*4[^0-9a-f]*" .

hpc:ValidIPv6Address rdf:type hpc:IPv6Address .
hpc:ValidIPv6Address1 rdf:type hpc:ValidIPv6Address .
hpc:Validipv6address1 rdfs:range ^"3ffe:.*" .
hpc:ValidIPv6Address2 rdf:type hpc:ValidIPv6Address .
hpc:Validipv6address2 rdfs:range ^"3ffe:fffe::88bb:[a-ff]*" .
hpc:ValidIPv6Address3 rdf:type hpc:ValidIPv6Address .
hpc:Validipv6address3 rdfs:range ^"3ffe-4fff:fffe::88bb:[a-ff]*" .
