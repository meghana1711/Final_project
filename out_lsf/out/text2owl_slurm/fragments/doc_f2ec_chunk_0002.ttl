hpc:Backfillscheduler rdfs:subClassOf hpc:Slurmscheduler .
hpc:Job a owl:Class .
hpc:jobstate a owl:ObjectProperty .
hpc:Jobstate rdfs:domain hpc:Job .
hpc:Jobstate rdfs:range xsd:string .
hpc:jobpriority a owl:DatatypeProperty .
hpc:Jobpriority rdfs:domain hpc:Job .
hpc:Jobpriority rdfs:range xsd:integer .
hpc:jobtimelimit a owl:DatatypeProperty .
hpc:Jobtimelimit rdfs:domain hpc:Job .
hpc:Jobtimelimit rdfs:range xsd:duration .
hpc:jobnoderequirement a owl:ObjectProperty .
hpc:Jobnoderequirement rdfs:domain hpc:Job .
hpc:Jobnoderequirement rdfs:range hpc:Node .
hpc:Jobnonkillableprocess a owl:Class .
hpc:Jobnonkillableprocess rdfs:subClassOf hpc:Job .
hpc:Jobstuckincompletingstate a owl:Class .
hpc:Jobstuckincompletingstate rdfs:subClassOf hpc:Job .
hpc:schedulertype a owl:ObjectProperty .
hpc:Schedulertype rdfs:domain rdf:Resource .
hpc:Schedulertype rdfs:range hpc:Slurmscheduler .
hpc:scontrolshowconfig a owl:ObjectProperty .
hpc:Scontrolshowconfig rdfs:domain rdf:Resource .
hpc:Scontrolshowconfig rdfs:range xsd:string .
hpc:scontrolshowjob a owl:ObjectProperty .
hpc:Scontrolshowjob rdfs:domain rdf:Resource .
hpc:Scontrolshowjob rdfs:range xsd:string .
hpc:slurmstop a owl:ObjectProperty .
hpc:Slurmstop rdfs:domain rdf:Resource .
