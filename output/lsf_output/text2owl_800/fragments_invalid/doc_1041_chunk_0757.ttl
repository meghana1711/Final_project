hpc:Host a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A host in a computing system." .

hpc:memory a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:hasMemory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Memory .

hpc:Socket a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A collection of cores with a direct pipe to memory." .

hpc:hasSocket rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Socket .

hpc:Core a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A single entity capable of performing computations." .

hpc:hasCore rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hp:Core .

hpc:Thread a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A unit of concurrent execution within a process, capable of being scheduled independently." .

hpc:hasThread rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Core ;
    rdfs:range hpc:Thread .

hpc:Numanode a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A NUMA node, if present." .

hpc:hasNumaNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:Numanode .

hpc:Numa a owl:Class ;
    rdfs:subClassOf hpc:Entity ;
    rdfs:comment "A NUMA layer in the machine memory architecture." .

hpc:hasNuma rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Numanode ;
    rdfs:range hpc:Numa .

hpc:maxMem rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Numa ;
    rdfs:range xsd:decimal .
