@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:Resourceallocation a owl:Class .
hpc:reuseduration a owl:ObjectProperty .
hpc:share a owl:ObjectProperty .
hpc:Usergroup a owl:Class .
hpc:runlimit a owl:DatatypeProperty .
hpc:waittime a owl:DatatypeProperty .
hpc:hostunavail a owl:DatatypeProperty .
hpc:removehungjobsfor a owl:ObjectProperty .

rdfs:domain hpc:Reuseduration hpc:Job .
rdfs:domain hpc:Share hpc:Job .
rdfs:domain hpc:Usergroup hpc:Share .
rdfs:range hpc:Reuseduration xsd:nonNegativeInteger .
rdfs:range hpc:Share xsd:nonNegativeInteger .
rdfs:range hpc:Usergroup xsd:string .
rdfs:range hpc:Runlimit xsd:nonNegativeInteger .
rdfs:range hpc:Waittime xsd:nonNegativeInteger .

hpc:Job subClassOf rdf:Resource .
hpc:ResourceAllocation subClassOf rdf:Resource .
hpc:reuseduration a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:share a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Usergroup a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .
hpc:waittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Removehungjobsfor ;
    rdfs:range xsd:nonNegativeInteger .
hpc:removehungjobsfor a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
