hpc:Account a owl:Class .
hpc:Type a owl:Class .
hpc:TRES a owl:Class .
hpc:Allocation a owl:Class .
hpc:Accounting a owl:Class .
hpc:Flag a owl:Class .
hpc:Priority a owl:Class .
hpc:Partition a owl:Class .
hpc:QOS a owl:Class .
hpc:Comment a owl:Class .
hpc:User a owl:Class .
hpc:Cluster a owl:Class .
hpc:Lineage a owl:Class .

hpc:id a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:integer .
hpc:start a owl:DatatypeProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range xsd:integer .
hpc:allocated a owl:ObjectProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range hpc:Allocation .
hpc:id_alt a owl:DatatypeProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range xsd:integer .
hpc:is_default a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:boolean .
hpc:priority a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:Priority .
hpc:parent_account a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:default a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:QOS .
hpc:min a owl:ObjectProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range hpc:PriorityThreshold .
hpc:partition a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:qos a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:comment a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Account ;
    rdfs:range xsd:string .

hpc:TRES a owl:Class ;
