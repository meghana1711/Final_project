hpc:Remotedatamanager a owl:Class .
hpc:Cluster a owl:Class .
hpc:hasserver a owl:ObjectProperty .
hpc:hasport a owl:DatatypeProperty .
hpc:Clustername rdfs:domain hpc:Remotedatamanager ;
                 rdfs:range rdf:List .
hpc:Servers rdfs:domain hpc:Remotedatamanager ;
             rdfs:range rdf:List .
hpc:Hasport rdfs:domain hpc:Remotedatamanager ;
            rdfs:range xsd:integer .

hpc:Ibmcloudgen2resourceprovider a owl:Class .
hpc:ibmcloudgen2Configfile a owl:ObjectProperty .
hpc:ibmcloudgen2Templatefile a owl:ObjectProperty .
hpc:Ibmcloudgen2resourceprovider rdfs:subClassOf hpc:Remotedatamanager .
hpc:Ibmcloudgen2Configfile rdfs:domain hpc:Ibmcloudgen2resourceprovider ;
                             rdfs:range rdf:XMLLiteral .
hpc:Ibmcloudgen2Templatefile rdfs:domain hpc:Ibmcloudgen2resourceprovider ;
                              rdfs:range rdf:XMLLiteral .
