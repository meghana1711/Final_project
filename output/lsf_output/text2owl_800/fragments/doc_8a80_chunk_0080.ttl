hpc:Blcollect a owl:Class ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "Periodically collects license usage information from the license manager." .

hpc:hascollectorname a owl:ObjectProperty ;
    rdfs:domain hpc:Blcollect ;
    rdfs:range xsd:string ;
    rdfs:comment "Required. Specify the collector name you set in the lsf.licensescheduler file." .

hpc:hoststosendto a owl:ObjectProperty ;
    rdfs:domain hpc:Blcollect ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies a space-separated list of hosts to which license information is sent." .

hpc:collectorname a owl:DatatypeProperty ;
    rdfs:domain hpc:Servicedomain ;
    rdfs:range xsd:string ;
    rdfs:comment "Required. Specify the collector name (LIC_COLLECTOR) you define in the ServiceDomain section of the configuration file." .

hpc:Fullyqualifiedhostname rdfs:subClassOf xsd:string .
