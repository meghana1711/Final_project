hpc:Apsjob a owl:Class .
hpc:Fcfsjob a owl:Class .
hpc:Slascheduling a owl:Class .
hpc:Timebasedsla a owl:Class .
hpc:Requeuedjob a owl:Class .
hpc:Rerunjob a owl:Class .
hpc:Migratedjob a owl:Class .
hpc:Suspendedjob a owl:Class .
hpc:Pendedjob a owl:Class .

hpc:overrides rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Apsjob ;
    rdfs:range hpc:Fcfsjob .

hpc:cannotBeUsedTogetherWith rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Apsjob ;
    rdfs:range (hpc:Queuelevelfairshare | hpc:Hostpartitionfairshare | hpc:Timebasedsla) .

hpc:SLAgoals rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Timebasedsla ;
    rdfs:range xsd:string .

hpc:isResetOnRequeue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Requeuedjob ;
    rdfs:range (hpc:Jobpriority | hpc:System | hpc:Adminaps) .

hpc:isNotTreatedTheSameAs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Requeuedjob ;
    rdfs:range hpc:Rerunjob .

hpc:jobPriorityInformationKept rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Migratedjob ;
    rdfs:range xsd:boolean .

hpc:competesWithOtherPendingJobs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Migratedjob ;
    rdfs:range hpc:Pendedjob .

hpc:APSValueReset rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Migratedjob ;
    rdfs:range xsd:boolean .

hpc:resourceReservation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Apsjob ;
    rdfs:range hpc:Queuepolicy .
