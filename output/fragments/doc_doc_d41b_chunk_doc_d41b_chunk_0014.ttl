hpc:GpuResource a owl:Class .
hpc:TeslaGpuResource a owl:Class, rdfs:subClassOf hpc:GpuResource .

# Job submit functions
hpc:SlurmJobSubmitFunction a owl:Class .

# Properties
hpc:gresRequest a owl:ObjectProperty .
hpc:tresPerJob rdfs:domain hpc:JobDescription;
                 rdfs:range xsd:nonNegativeInteger .
hpc:tresPerSocket rdfs:domain hpc:JobDescription;
                   rdfs:range xsd:nonNegativeInteger .
hpc:tresPerTask rdfs:domain hpc:JobDescription;
                 rdfs:range xsd:nonNegativeInteger .
hpc:tresPerNode rdfs:domain hpc:JobDescription;
                 rdfs:range xsd:nonNegativeInteger .
hpc:isGpuResource rdfs:domain hpc:GresRequest;
                   rdfs:range hpc:GpuResource .
hpc:hasType rdfs:domain hpc:GpuResource;
             rdfs:range xsd:string .

# Configuration
hpc:AccountingStorageTRES a owl:ObjectProperty .
hpc:SlurmConf a owl:Class .
hpc:accountingStorageTRES rdfs:domain hpc:SlurmConf;
                         rdfs:range xsd:string .
```
