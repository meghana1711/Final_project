hpc:Job a owl:Class .
hpc:jobID rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:partition rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .
hpc:state rdf:type owl:EnumProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdf:value "R" ;
    rdfs:value "PD" .
hpc:time rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration .
hpc:nodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:nodelistReason rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job .

# Node
hpc:Node a owl:Class .
hpc:nodeName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:state rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:cpus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:allocCPUs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:realMemory rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:tmpDisk rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:sockets rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:cores rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:threads rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:weight rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:features rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .
hpc:reason rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Node .

# Partition
hpc:Partition a owl:Class .
hpc:partitionName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:totalNodes rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:totalCPUs rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:rootOnly rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:default rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:
