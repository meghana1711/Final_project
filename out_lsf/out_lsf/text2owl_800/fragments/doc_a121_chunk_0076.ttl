hpc:Dependencyexpression rdfs:domain hpc:Job .

hpc:Hasdependencyexpression rdfs:range hpc:Dependencyexpression .

hpc:wildcardcharacter a owl:DatatypeProperty .
hpc:Wildcardcharacter rdfs:domain hpc:Dependencyexpression .
hpc:Wildcardcharacter rdfs:range xsd:string .

hpc:singlequotedexpression a owl:ObjectProperty .
hpc:Singlequotedexpression rdfs:domain hpc:Dependencyexpression .
hpc:Singlequotedexpression rdfs:range xsd:string .

hpc:doublequotedexpression a owl:ObjectProperty .
hpc:Doublequotedexpression rdfs:domain hpc:Dependencyexpression .
hpc:Doublequotedexpression rdfs:range xsd:string .

hpc:Windowssystem rdfs:subClassOf owl:Class .

hpc:Windowssystemdependencyexpression rdfs:subClassOf hpc:Dependencyexpression .
