hpc:Cluster a owl:Class .
hpc:hasName an owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:hasHostType an owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:Hosttype .

hpc:Hosttype a owl:Class .
hpc:hasName an owl:DatatypeProperty ;
    rdfs:domain hpc:Hosttype ;
    rdfs:range xsd:string .

hpc:hasValidHostType an owl:ObjectProperty ;
    rdfs:domain hpc:Hosttype ;
    rdfs:range xsd:string .

hpc:Hosttypesection a owl:Class .
hpc:hasTypeName an owl:DatatypeProperty ;
    rdfs:domain hpc:Hosttypesection ;
    rdfs:range xsd:string .

hpc:hasHostTypeList an owl:ObjectProperty ;
    rdfs:domain hpc:Hosttypesection ;
    rdfs:range rdf:List .

hpc:GlobalJobID an owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster .

hpc:hasIndex an owl:DatatypeProperty ;
    rdfs:domain hpc:Globaljobid ;
    rdfs:range xsd:integer .
