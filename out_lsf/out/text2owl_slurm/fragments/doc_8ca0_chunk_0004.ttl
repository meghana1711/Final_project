hpc:ResumeTimeout
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer ;
    rdfs:comment "Maximum time permitted (in seconds) between when a node resume request is issued and when the node is actually available for use." .

hpc:SchedulerParameters
    a owl:Class ;
    rdfs:comment "Parameters related to schedulers." .

hpc:SchedulerType
    a owl:Class ;
    rdfs:subClassOf hpc:Schedulerparameters ;
    rdfs:comment "Types of schedulers." .

hpc:salloc_wait_nodes
    a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulertype ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "If defined, the salloc command will wait until all allocated nodes are ready for use (i.e. booted) before the command returns." .

hpc:sbatch_wait_nodes
    a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulertype ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "If defined, the sbatch script will wait until all allocated nodes are ready for use (i.e. booted) before the initiation." .

hpc:SlurmctldParameters
    a owl:Class ;
    rdfs:subClassOf hpc:Schedulerparameters ;
    rdfs:comment "Slurm-specific scheduler parameters." .

hpc:cloud_dns
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctldparameters ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Configures whether Slurm can avoid notifying the client command of the node's address upon registration when nodes are in DNS." .

hpc:idle_on_node_suspend
    a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmctldparameters ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Mark nodes as idle, regardless of current state, when suspending nodes with SuspendProgram so that nodes will be eligible to be resumed at a later time." .

hpc:Node
    a owl:Class ;
    rdfs:comment "A computing node in a high-performance computing system." .
