hpc:Job rdfs:subClassOf rdf:Resource .
hpc:Containerjob rdfs:subClassOf hpc:Job .
hpc:Starterscript rdfs:domain hpc:Containerjob ;
                                        rdfs:range hpc:Script .
hpc:Execdriver rdfs:domain hpc:Containerjob ;
                               rdfs:range hpc:Context .
hpc:Container rdfs:domain hpc:Containerjob ;
                      rdfs:range hpc:Image ;
                      rdfs:range hpc:Options .
