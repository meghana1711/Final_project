hpc:JobSubmitResponse a owl:Class .
hpc:job_submit_user_msg rdf:datatype xsd:string ;
    rdfs:domain hpc:JobSubmitResponse ;
    rdfs:range xsd:string .
hpc:error rdf:datatype xsd:string ;
    rdfs:domain hpc:JobSubmitResponse ;
    rdfs:range xsd:string .
hpc:JobSubmitResponse hasContentType application/json ;
    rdfs:domain hpc:JobSubmitResponse .

hpc:UpdateNodeResponse a owl:Class .
hpc:error rdf:datatype xsd:string ;
    rdfs:domain hpc:UpdateNodeResponse ;
    rdfs:range xsd:string .
hpc:UpdateNodeResponse hasContentType application/json ;
    rdfs:domain hpc:UpdateNodeResponse .

hpc:BatchUpdateNodeResponse a owl:Class .
