hpc:Datarequirementpath rdfs:range xsd:string .

hpc:stagedfilepath a owl:DatatypeProperty .
hpc:Stagedfilepath rdfs:domain hpc:Stagedfile .
hpc:Stagedfilepath rdfs:range xsd:string .

hpc:stagingarea a owl:DatatypeProperty .
