hpc:ClosedRc a owl:Class ;
    rdfs:subClassOf hpc:Resourceconnectorhost .

hpc:onhostpowerstate a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:boolean .

hpc:offhostpowerstate a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:boolean .

hpc:suspendhostpower a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:string .

hpc:hostrestarting a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:boolean .

hpc:hostresuming a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:boolean .

hpc:hostsuspending a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:boolean .

hpc:closedPower a owl:ObjectProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:string .

hpc:hostpowerpolicysuspend a owl:ObjectProperty ;
    rdfs:domain hpc:Hostsuspend ;
    rdfs:range xsd:boolean .

hpc:cpunormalizationfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnectorhost ;
    rdfs:range xsd:decimal .
