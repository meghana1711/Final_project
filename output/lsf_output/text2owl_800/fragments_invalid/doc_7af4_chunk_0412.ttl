hpc:CsmReq a owl:Class .
hpc:hasjsm a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range xsd:string .
hpc:stepCgroup a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range xsd:string .
hpc:coreIsolation a owl:DatatypeProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range xsd:nonNegativeInteger .
hpc:cnMem a owl:DatatypeProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range xsd:nonNegativeInteger .
hpc:allocFlags a owl:ObjectProperty ;
    rdfs:domain hpc:CsmReq ;
    rdfs:range xsd:string .
hpc:alloc_flagsRange a owl:Restriction ;
    rdfs:onProperty hpc:alloc_flags ;
    rdfs:allValuesFrom xsd:string ;
    rdfs:pattern ([A-Za-z0-9]+) .
hpc:Datalimit a owl:Class .
hpc:maximumLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Datalimit ;
    rdfs:range xsd:nonNegativeInteger .
