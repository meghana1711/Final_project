hpc:HeterogeneousJob a owl:Class .
hpc:UniqueNode a owl:Class .
hpc:HeterogeneousStep a owl:Class .
hpc:RunOnUniqueNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:HeterogeneousStep ;
    rdfs:range hpc:UniqueNode .
hpc:WithinHeterogeneousJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:HeterogeneousStep ;
    rdfs:range hpc:HeterogeneousJob .
hpc:JobSubmitPlugin a owl:Class .
hpc:SpankInitPostOpt a owl:Class .
hpc:JobComponent a owl:Class .
hpc:Scheduling a owl:Class .
hpc:BackfillPlugin a owl:Class .
hpc:PendingReason a owl:DatatypeProperty ;
    rdfs:domain hpc:HeterogeneousJob .
hpc:AlternatingModes a owl:Class .
hpc:ImmediateInitiation a owl:Class .
