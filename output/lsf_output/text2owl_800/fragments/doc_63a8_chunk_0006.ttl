hpc:Datafile a owl:Class ;
    rdfs:subClassOf hpc:File .

hpc:Transferjob a owl:Class .

hpc:hasDataFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Transferjob ;
    rdfs:range hpc:Datafile .

hpc:hasSourceHost rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:hasFilePath rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:string .

hpc:isRecursive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:boolean .

hpc:isTopLevel rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:boolean .

hpc:hasJobArrayIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Datafile ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Transferjob .

hpc:hasJobArrayElement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Transferjob .
