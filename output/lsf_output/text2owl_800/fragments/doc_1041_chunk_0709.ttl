hpc:Dependencyexpression a owl:Class .
hpc:logicaloperator a owl:ObjectProperty .
hpc:AND rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dependencyexpression ;
    rdfs:range (hpc:Logicaloperator hpc:Logicaloperator) .
hpc:OR rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Dependencyexpression ;
    rdfs:range (hpc:Logicaloperator hpc:Logicaloperator) .
hpc:NOT rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Logicaloperator ;
    rdfs:range hpc:Logicaloperator .
hpc:Jobdependency a owl:Class ;
    rdfs:subClassOf hpc:Dependencyexpression .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdependency .
hpc:Jobname rdfs:range xsd:string .
hpc:jobnamewithnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdependency ;
    rdfs:range xsd:string .
hpc:Jobnamewithnumber rdfs:rangeMinLength 1 .
hpc:Jobnamewithnumber rdfs:rangeMaxLength 5 .
hpc:Jobnamewithnumber rdfs:rangePattern "[0-9]+" .
hpc:jobdeplastsub a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobdependency ;
    rdfs:range xsd:boolean .
hpc:Jobdeplastsub rdfs:rangeDefault "0" .
