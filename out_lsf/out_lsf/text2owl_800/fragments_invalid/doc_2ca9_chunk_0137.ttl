hpc:Jobschedulingexecution a owl:Class .
hpc:Advancereservation hpc:Jobschedulingexecution rdfs:subClassOf owl:Class .
hpc:Dynamicallyscheduledreservation hpc:Jobschedulingexecution rdfs:subClassOf owl:Class .
hpc:Resourcemanagement hpc:Jobschedulingexecution rdfs:subClassOf owl:Class .

hpc:bjobsu a owl:ObjectProperty .
hpc:Bjobsu rdfs:domain hpc:Advancereservation ;
                                rdfs:range hpc:Job .
hpc:bjobsorsvid a owl:DatatypeProperty .
hpc:Bjobsorsvid rdfs:domain hpc:Job ;
                          rdfs:range xsd:string .

hpc:brsvsub a owl:ObjectProperty .
hpc:Brsvsub rdfs:domain hpc:Dynamicallyscheduledreservation ;
                          rdfs:range hpc:Job .

hpc:bresize a owl:ObjectProperty .
hpc:Bresize rdfs:domain hpc:Resizablejob ;
                          rdfs:range hpc:Job .

hpc:bresizerequest a owl:ObjectProperty .
hpc:Bresizerequest rdfs:domain hpc:Resizablejob ;
                          rdfs:range hpc:Job .

hpc:Gpuresourcerequirement a owl:Class .
hpc:bsubgpu a owl:ObjectProperty .
hpc:Bsubgpu rdfs:domain hpc:Job ;
                          rdfs:range hpc:Gpuresourcerequirement .
hpc:lsbGpuNewSyntax a owl:ObjectProperty .
hpc:LsbGpuNewSyntax rdfs:domain hpc:Gpuresourcerequirement ;
                          rdfs:range xsd:boolean .
