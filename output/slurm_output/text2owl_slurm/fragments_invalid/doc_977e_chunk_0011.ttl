@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Reservationaccounting a owl:Class.
hpc:Useraccount a owl:Class.
hpc:Bankaccount a owl:Class.
hpc:Reservationresource a owl:Class.
hpc:associatedwith a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range (hpc:Useraccount hpc:Bankaccount) .
hpc:usedby a owl:ObjectProperty ;
    rdfs:domain hpc:Reservationresource ;
    rdfs:range hpc:Useraccount .
hpc:Prolog a owl:Class ;
    rdfs:subClassOf hpc
