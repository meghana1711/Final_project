hpc:LsfGpuIgnore
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfdaemon ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the daemon ignores GPU resources." .

hpc:LsfRtm
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "LSF Real-Time Management." .

hpc:LsfRtmHostGpuInfo
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfrtm ;
    rdfs:range hpc:Lsfhostgpuinfo ;
    rdfs:comment "Indicates that LSF RTM uses LSF resources to get host GPU information." .

hpc:LsfHostGpuInfo
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Information about GPU resources on a host." .

