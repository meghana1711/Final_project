hpc:Slurmnode a owl:Class .
hpc:nodename a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:nodehostname a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:port a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:integer .
hpc:slurmdlogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:slurmdpidfile a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:slurmdspooldir a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:slurmdcommandlineparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmnode ;
    rdfs:range xsd:string .
hpc:Slurmdaemon a owl:Class ;
    rdfs:subClassOf hpc:Slurmnode .
