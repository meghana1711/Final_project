hpc:Job a owl:Class .
hpc:Outputdirectory a owl:Class .
hpc:standardoutput a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory .
hpc:standardoutputformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Standardoutput ;
    rdfs:range xsd:string .
hpc:errordirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory .
hpc:temporarydirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory .
hpc:temporarydirectoryformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Temporarydirectory ;
    rdfs:range xsd:string .
hpc:jobspecifictemporarydirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory .
hpc:jobspecifictemporarydirectoryformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobspecifictemporarydirectory ;
    rdfs:range xsd:string .
hpc:flexiblejobcwd a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Outputdirectory .
