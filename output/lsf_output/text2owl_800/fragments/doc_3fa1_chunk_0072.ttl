hpc:Job a owl:Class .
hpc:Sla a owl:Class .
hpc:Preemptivequeue a owl:Class .
hpc:slaGuaranteesIgnore a owl:ObjectProperty .
hpc:SlaGuaranteesIgnore rdfs:domain hpc:Preemptivequeue ;
                            rdfs:range xsd:string .

hpc:Loanedresource a owl:Class .
hpc:Forcedjob a owl:Class .
hpc:brun a owl:ObjectProperty .
hpc:Brun rdfs:domain hpc:Forcedjob ;
                rdfs:range xsd:string .

hpc:Resourceduration a owl:Class .
hpc:Packageguarantee a owl:Class .
hpc:Package a owl:Class .
hpc:Slot a owl:Class .
hpc:Memory a owl:Class .
hpc:Host a owl:Class .
hpc:Serviceclass a owl:Class .

hpc:Reservedresourcepolicy a owl:Class .
hpc:loanoutpolicy a owl:ObjectProperty .
hpc:Loanoutpolicy rdfs:domain hpc:Reservedresourcepolicy .

hpc:Guaranteepackagepolicy a owl:Class ;
                             rdfs:subClassOf hpc:Reservedresourcepolicy .
hpc:Guaranteepackagepolicy rdfs:subClassOf hpc:Packageguarantee .

hpc:Guaranteedresourcepool a owl:Class .
hpc:name a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:hosts a owl:DatatypeProperty .
hpc:resSelect a owl:DatatypeProperty .
hpc:distribution a owl:DatatypeProperty .

hpc:Name rdfs:range xsd:string .
hpc:Type rdfs:range xsd:string .
hpc:Hosts rdfs:range xsd:string .
hpc:ResSelect rdfs:range xsd:string .
hpc:Distribution rdfs:range xsd:string .

hpc:Guaranteedresourcepool hpc:name "example_pool" .
hpc:Guaranteedresourcepool hpc:type "package[slots=1:mem=1000]" .
hpc:Guaranteedresourcepool hpc:hosts "hgroup1" .
hpc:Guaranteedresourcepool hpc:resSelect "mem > 16000" .
hpc:Guaranteedresourcepool hpc:distribution "([sc1, 25%] [sc2, 25%] [sc3, 30%])" .
