hpc:Jobsatisfaction a owl:Class .
hpc:Jobrequirement a owl:Class .
hpc:Selectrequirement a owl:Class .
hpc:Planningwindow a owl:Class .
hpc:Plannedallocation a owl:Class .
hpc:Resource a owl:Class .
hpc:Higherpriorityjob a owl:Class .
hpc:planningdelay a owl:ObjectProperty .
hpc:Planningdelay rdfs:domain hpc:Plannedallocation ;
                    rdfs:range xsd:minute .
hpc:Planningbasedreservation a owl:Class .
hpc:Jobstarvation a owl:Class .
hpc:pendingtime a owl:DatatypeProperty .
hpc:Pendingtime rdfs:domain hpc:Jobstarvation ;
                 rdfs:range xsd:minute .
hpc:Standardlsfscheduling a owl:Class .
hpc:specifieddelay a owl:DatatypeProperty .
hpc:Specifieddelay rdfs:domain hpc:Standardlsfscheduling ;
                    rdfs:range xsd:minute .
hpc:Delayparameter a owl:Class .
hpc:Delayparameter rdfs:subClassOf hpc:Parameter .
hpc:Applicationlevel a owl:Class .
hpc:Queuelevel a owl:Class .
hpc:Clusterlevel a owl:Class .
hpc:Limitingplannedjobs a owl:Class .
hpc:maxjobs a owl:DatatypeProperty .
hpc:Maxjobs rdfs:domain hpc:Limitingplannedjobs ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:strictestapplies a owl:ObjectProperty .
hpc:Strictestapplies rdfs:domain hpc:Limitingplannedjobs ;
                     rdfs:range hpc:Limitingplannedjobs .
hpc:Clusterutilization a owl:Class .
hpc:Jobstarvationprevention a owl:Class .
hpc:Reservation a owl:Class .
hpc:Idleresources a owl:Class .
