hpc:Emailaccount a owl:Class .
hpc:Emailaccount rdfs:subClassOf xsd:string .

hpc:lsbMaxAskedHostsNumber a owl:ObjectProperty .
hpc:LsbMaxAskedHostsNumber rdfs:domain hpc:Emailaccount ;
                                   rdfs:range xsd:integer .

hpc:lsbMaxForwardPerSession a owl:ObjectProperty .
hpc:LsbMaxForwardPerSession rdfs:domain rdf:Resource ;
                                   rdfs:range xsd:integer .

hpc:lsbMaxJobDispatchPerSession a owl:ObjectProperty .
hpc:LsbMaxJobDispatchPerSession rdfs:domain rdf:Resource ;
                                   rdfs:range xsd:integer .

hpc:lsbMaxPackJobs a owl:ObjectProperty .
hpc:LsbMaxPackJobs rdfs:domain rdf:Integer ;
                          rdfs:range xsd:nonNegativeInteger .
