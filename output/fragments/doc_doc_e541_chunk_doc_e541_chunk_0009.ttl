hpc:Time a owl:Class .
hpc:ElapsedTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:decimal .

hpc:PacketsIn a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MegabytesRead a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:decimal .

hpc:PacketsOut a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MegabytesWrite a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:decimal .

hpc:TaskData a owl:Class .
hpc:JobAcctGatherType a owl:DatatypeProperty ;
    rdfs:domain hpc:TaskData ;
    rdfs:range xsd:string .

hpc:TaskFreq a owl:DatatypeProperty ;
    rdfs:domain hpc:TaskData ;
    rdfs:range xsd:nonNegativeInteger .

hpc:DateAndTime a owl:Class ;
    rdfs:subClassOf hpc:TaskData .

hpc:DateTime a owl:DatatypeProperty ;
    rdfs:domain hpc:DateAndTime ;
    rdfs:range xsd:dateTime .

hpc:TimeOfStep a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:decimal .

hpc:CPUMHz a owl:DatatypeProperty ;
    rdfs:domain hpc:Time ;
    rdfs:range xsd:decimal .
```
