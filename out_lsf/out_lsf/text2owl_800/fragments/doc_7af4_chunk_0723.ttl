hpc:Lsf a owl:Class .
hpc:Sbatchd hpc:hascomponent hpc:LSF .

hpc:LsbMailprog a owl:Class .
hpc:LsbMailprog rdfs:subClassOf xsd:string .
hpc:LsbMailprog rdfs:domain hpc:Lsf .

hpc:uses rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:LsbMailprog .

hpc:calls rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsbMailprog ;
    rdfs:range hpc:LsbMailprog ;
    rdfs:range hpc:LsbMailprogCall .

hpc:LsbMailprogCall a owl:Class .
hpc:LsbMailprogCall rdfs:subClassOf rdf:List .
hpc:LsbMailprogCall rdfs:range hpc:LsbMailprog .

hpc:LSB_MAILPROG_Call_Argument1 rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCall ;
    rdfs:range xsd:string ;
    rdfs:label "-oi" .

hpc:LSB_MAILPROG_Call_Argument2 rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCall ;
    rdfs:range xsd:string ;
    rdfs:label "-F" .

hpc:LSB_MAILPROG_Call_Argument3 rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCall ;
    rdfs:range xsd:string ;
    rdfs:label "-f" .

hpc:hasReturnAddress rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCallArgument3 .

hpc:hasSenderName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCallArgument2 .

hpc:hasRecipient rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LsbMailprogCallArgument1 .

hpc:supportsEndOfFileCharacter rdf:type owl:ObjectProperty ;
    rdf:range xsd:boolean .
