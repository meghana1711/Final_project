hpc:Hostb a owl:Class .
hpc:ClusterMasterStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostb ;
    rdfs:range xsd:string .
hpc:Cluster1 hpc:clustermasterstatus "ok" .

hpc:Outgoingremote a owl:Class .
hpc:CLUSTER rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range hpc:Cluster .
hpc:LSF_DATA_HOSTS rdf:type hpc:Cluster ;
    rdfs:subClassOf hpc:Cluster ;
    rdfs:comment "LSF data hosts cluster" .
hpc:LSF_DATA_PORT rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:integer .
hpc:STATUS rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .
hpc:Hamburg hpc:outgoingremote [ hpc:CLUSTER hpc:LSF_DATA_HOSTS ;
                                     hpc:LSF_DATA_PORT 4104 ;
                                     hpc:STATUS "ok" ] .
hpc:Toulouse hpc:outgoingremote [ hpc:CLUSTER hpc:LSF_DATA_HOSTS ;
                                      hpc:LSF_DATA_PORT 12058 ;
                                      hpc:STATUS "disc" ] .

hpc:Incomingremote a owl:Class .
hpc:CLUSTER rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range hpc:Cluster .
hpc:DMD_MASTER rdf:type hpc:Cluster ;
    rdfs:subClassOf hpc:Cluster ;
    rdfs:comment "DMD master cluster" .
hpc:LSF_DATA_PORT rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range xsd:integer .
hpc:STATUS rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range xsd:string .
hpc:Waterloo hpc:incomingremote [ hpc:CLUSTER hpc:DMD_MASTER ;
                                      hpc:LSF_DATA_PORT 33994 ;
                                      hpc:STATUS "ok" ] .
hpc:Venice hpc:incomingremote [ hpc:CLUSTER hpc:DMD_MASTER ;
                                   hpc:LSF_DATA_PORT 13514 ;
                                   hpc:STATUS "ok" ] .

hpc:Admin a owl:Class .

hpc:Reconfigure rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range hpc:Command .
hpc:shutdown rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Admin ;
    rdfs:range hpc
