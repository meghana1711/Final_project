hpc:hasUser rdf:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:hasLSFAdministrator rdf:domain hpc:Job ;
    rdfs:range hpc:Lsfadministrator .
hpc:isIssuedBy rdf:domain hpc:Action ;
    rdfs:range hpc:User .
hpc:isIssuedBy rdf:domain hpc:BkillCommand ;
    rdfs:range hpc:Job .
hpc:isIssuedBy rdf:domain hpc:BreqqueueCommand ;
    rdfs:range hpc:Job .
hpc:isCausedBy rdf:domain hpc:Action ;
    rdfs:range hpc:TerminateWhen .
hpc:isCausedBy rdf:domain hpc:QueueDefinition ;
    rdfs:range hpc:Suspendaction .
hpc:isCausedBy rdf:domain hpc:QueueDefinition ;
    rdfs:range hpc:Terminate .
hpc:isCausedBy rdf:domain hpc:Job ;
    rdfs:range hpc:Cpulimit, hpc:Memlimit, hpc:Runlimit, hpc:Processlimit .
