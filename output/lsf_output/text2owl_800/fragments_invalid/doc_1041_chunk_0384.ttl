hpc:Licenseproject a owl:Class .
hpc:checkoutexcess a owl:ObjectProperty .
hpc:Checkoutexcess rdfs:domain hpc:Licenseproject ;
                    rdfs:range xsd:integer .
hpc:Demand a owl:Class .
hpc:allocation a owl:ObjectProperty .
hpc:Allocation rdfs:domain hpc:Cluster ;
                 rdfs:range hpc:Licenseproject .
hpc:requirement a owl:DatatypeProperty .
hpc:Requirement rdfs:domain hpc:Cluster ;
                 rdfs:range xsd:integer .
hpc:hierarchicalinfo a owl:ObjectProperty .
hpc:Hierarchicalinfo rdfs:domain hpc:Cluster ;
                     rdfs:range hpc:Licenseproject .
hpc:projectdescription a owl:ObjectProperty .
hpc:Projectdescription rdfs:domain hpc:Project ;
                        rdfs:range xsd:string .
hpc:associatedprojects a owl:ObjectProperty .
hpc:Associatedprojects rdfs:domain hpc:Project ;
                        rdfs:range hpc:Licenseproject .
hpc:Feature a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:Summaryinfo a owl:Class .
hpc:Licenseprojectinfo a owl:Class .
hpc:Cluster a owl:Class .
hpc:Project a owl:Class .

hpc:Checkoutexcess rdfs:subClassOf owl:ObjectProperty ;
                    rdfs:subPropertyOf hpc:CheckoutExcess .
hpc:Allocation rdfs:subClassOf owl:ObjectProperty ;
                    rdfs:subPropertyOf hpc:Allocation .
hpc:Requirement rdfs:subClassOf owl:DatatypeProperty ;
                    rdfs:subPropertyOf hpc:Requirement .
hpc:Hierarchicalinfo rdfs:subClassOf owl:ObjectProperty ;
                    rdfs:subPropertyOf hpc:HierarchicalInfo .
hpc:Projectdescription rdfs:subClassOf owl:ObjectProperty ;
                      rdfs:subPropertyOf hpc:ProjectDescription .
hpc:Associatedprojects rdfs:subClassOf owl:ObjectProperty ;
                       rdfs:subPropertyOf hpc:AssociatedProjects .
hpc:Feature rdfs:subClassOf owl:Class .
hpc:Servicedomain rdfs:subClassOf owl:Class .
hpc:Summaryinfo rdfs:subClassOf owl:Class .
hpc:Licenseprojectinfo rdfs:subClassOf owl:Class .
hpc:Cluster rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf owl:Class .

hpc:Checkoutexcess rdfs:domain hpc:Licenseproject ;
                    rdfs:range xsd:integer .
hpc:Allocation rdfs:domain hpc:Cluster ;
                 rdfs:range hpc:Licenseproject .
hpc:Requirement rdfs:domain hpc:Cluster ;
                 rdfs:range xsd:integer .
hpc:Hierarchicalinfo rdfs:domain
