hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:Job a owl:Class .
hpc:Jobsecurity a owl:Class .
hpc:Hasusergroup rdfs:domain hpc:Job ;
                   rdfs:range hpc:Usergroup .
hpc:Hasaccesslevel rdfs:domain hpc:Jobsecurity ;
                   rdfs:range xsd:string .
hpc:Bjobsfunction rdfs:subClassOf hpc:Job .
hpc:BhistBacct rdfs:subClassOf hpc:Job .
hpc:BsubG rdfs:subClassOf hpc:Job .
hpc:BjobsO rdfs:subClassOf hpc:Job .
hpc:Lsfmulticluster rdfs:subClassOf hpc:Jobsecurity .
hpc:SecureJobInfoLevel rdfs:domain hpc:Jobsecurity ;
                      rdfs:range xsd:string .
hpc:Viewjobinfo rdfs:subClassOf hpc:Jobsecurity .
hpc:Viewjobsummary rdfs:subClassOf hpc:Jobsecurity .
hpc:Viewjobdetail rdfs:subClassOf hpc:Jobsecurity .
hpc:Adminuser rdfs:subClassOf hpc:User .
hpc:Member rdfs:domain hpc:User ;
               rdfs:range hpc:Usergroup .
hpc:Jobcontrol rdfs:subClassOf hpc:Jobsecurity .
hpc:Killjob rdfs:subClassOf hpc:Jobcontrol .
hpc:Prelsf91command rdfs:subClassOf hpc:Bjobs .
hpc:Mbatchd rdfs:domain hpc:Prelsf91command ;
             rdfs:range xsd:string .
