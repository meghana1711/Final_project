hpc:Interactivejob rdfs:subClassOf hpc:Job .
hpc:Performancetuning rdfs:subClassOf hpc:Systemoptimization .
hpc:Lsf rdfs:subClassOf hpc:Scheduler .
hpc:Workstation rdfs:subClassOf hpc:Computingresource .
hpc:Criticalbatchjob rdfs:subClassOf hpc:Batchjob .
hpc:Resourcecontention rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:Operatingsystemoverhead rdfs:domain hpc:Computingresource ;
    rdfs:range xsd:decimal .
hpc:Interactivebatchjobmessaging rdfs:domain hpc:Interactivejob ;
    rdfs:range hpc:Message .
hpc:Runxapplications rdfs:domain hpc:Interactivejob ;
    rdfs:range hpc:Xapplication .
hpc:Sshx11forwarding rdfs:domain hpc:Interactivejob ;
    rdfs:range xsd:boolean .
hpc:Writejobscript rdfs:domain hpc:Lsfadministrator ;
    rdfs:range hpc:Jobscript .
hpc:Registerutmpfileentries rdfs:domain hpc:Lsfadministrator ;
    rdfs:range hpc:Utmpfileentry .
hpc:Centralizedscheduler rdfs:subClassOf hpc:Scheduler .
hpc:Systemmanagement rdfs:domain hpc:System ;
    rdfs:range hpc:Managementstrategy .
hpc:Batchschedulingpolicy rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:Schedulingpolicy .
hpc:Hostselection rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:Host .
