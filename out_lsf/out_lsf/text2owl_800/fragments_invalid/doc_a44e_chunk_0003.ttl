hpc:Bstage a owl:Class ;
    rdfs:subClassOf owl:Command ;
    rdfs:comment "Help and version options for IBM Spectrum LSF Data Manager bstage command." .

hpc:displayshelp a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Displays the command usage of the bstage command to stderr and exits." .

hpc:displaysversion a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range xsd:string ;
    rdfs:comment "Prints IBM Spectrum LSF Data Manager release version to stderr and exits." .

hpc:bdata a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also bdata command." .

hpc:bhist a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also bhist command." .

hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also bjobs command." .

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Bstage ;
    rdfs:range rdf:Resource ;
    rdfs:comment "See also bsub command." .

hpc:Lsbconf a owl:Class ;
    rdfs:subClassOf owl:ConfigurationFile ;
    rdfs:comment "Configuration reference for IBM Spectrum LSF Data Manager." .

hpc:lsbqueues a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The lsb.queues file defines batch queues. Configure a queue as the data transfer queue for LSF data management." .

hpc:Datatransferqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue configured for data transfer." .

hpc:datatransferenabled a owl:DatatypeProperty ;
    rdfs:domain hpc:Datatransferqueue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The DATA_TRANSFER=Y parameter enables the queue for data transfer." .

hpc:Lsbusers a owl:Class ;
    rdfs:subClassOf owl:UserFile ;
    rdfs:comment "Starting in Fix Pack 14, LSF Data Manager supports cross-cluster user account mapping for a multicluster environment." .

hpc:crossclusteruseraccountmapping a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbusers ;
    rdfs:range hpc:Accountmapping ;
    rdfs:comment "Maps user accounts at the system level in the UserMap section of the lsb.users file to configure account mappings in a multicluster environment." .

hpc:mult
