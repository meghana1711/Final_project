hpc:Maxnodeperaccount a owl:Class .
hpc:Maxsubmitjobsperaccount a owl:Class .
hpc:Maxunknownperaccount a owl:Class .
hpc:nodedown a owl:ObjectProperty .
hpc:nonzeroexitcode a owl:ObjectProperty .
hpc:None a owl:Class .
hpc:Outofmemory a owl:Class .
hpc:Partitionconfig a owl:Class .
hpc:partitiondown a owl:ObjectProperty .
hpc:partitioninactive a owl:ObjectProperty .
hpc:partitionnodelimit a owl:ObjectProperty .

hpc:Maxnodeperaccount rdfs:subClassOf owl:Thing .
hpc:Maxsubmitjobsperaccount rdfs:subClassOf owl:Thing .
hpc:Maxunknownperaccount rdfs:subClassOf owl:Thing .
hpc:Nodedown rdfs:domain hpc:Maxnodeperaccount ;
                                rdfs:range owl:Thing .
hpc:Nonzeroexitcode rdfs:domain hpc:Maxnodeperaccount ;
                                rdfs:range xsd:nonNegativeInteger .
hpc:None rdfs:subClassOf owl:Thing .
hpc:Outofmemory rdfs:subClassOf owl:Thing .
hpc:Partitionconfig rdfs:subClassOf owl:Thing .
hpc:Partitiondown rdfs:domain hpc:Partitionconfig ;
                                rdfs:range owl:Thing .
hpc:Partitioninactive rdfs:domain hpc:Partitionconfig ;
                                rdfs:range owl:Thing .
hpc:Partitionnodelimit rdfs:domain hpc:Partitionconfig ;
                                rdfs:range xsd:nonNegativeInteger .
