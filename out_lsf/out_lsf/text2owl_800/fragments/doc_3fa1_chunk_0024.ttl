hpc:GroupName rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:string .
hpc:GroupMember rdfs:domain hpc:Usergroup ;
    rdfs:range rdf:List .

hpc:Hostpartition a owl:Class .
hpc:HpartName rdfs:domain hpc:Hostpartition ;
    rdfs:range xsd:string .
hpc:Hosts rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:List .
hpc:UserShares rdfs:domain hpc:Hostpartition ;
    rdfs:range rdf:List .

hpc:Chargebackfairshare a owl:Class .
hpc:Hasusergroup rdfs:domain hpc:Chargebackfairshare ;
    rdfs:range rdf:List .
hpc:Hasshareratio rdfs:domain hpc:Chargebackfairshare ;
    rdfs:range xsd:decimal .

hpc:Equalshare a owl:Class ;
    rdfs:subClassOf hpc:Chargebackfairshare .
