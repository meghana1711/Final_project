@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Nodename0 a owl:Class .
hpc:Socket a owl:Class .
hpc:numberofallocatedcpus a owl:DatatypeProperty .
hpc:allocatedcpuids a owl:ObjectProperty .
hpc:bindingoftaskstocpus a owl:ObjectProperty .
hpc:Taskid a owl:Class .

hpc:Nodename0 rdfs:subClassOf rdf:Resource .
hpc:Socket rdfs:subClassOf rdf:Resource .
hpc:Numberofallocatedcpus rdfs:domain hpc:Nodename0 ;
                             rdfs:range xsd:nonNeg
