hpc:ConsumableResource a owl:Class .
hpc:LinearPlugin a owl:Class .
hpc:ConsumableResourcePlugin a owl:Class .
hpc:SelectPlugin a owl:Class .
hpc:ConstrainedTresPlugin a owl:Class .
hpc:OverSubscribe a xsd:integer .
hpc:Job a owl:Class .
hpc:Node a owl:Class .
hpc:Partition a owl:Class .
hpc:Shared a owl:Class .
hpc:NonShared a owl:Class .
hpc:FirstJob a owl:Class .
hpc:SecondJob a owl:Class .
hpc:RunningOn a owl:ObjectProperty .
hpc:SharingResources a owl:ObjectProperty .
hpc:OverSubscribeSetting a owl:ObjectProperty .
hpc:HasCPUs a owl:DatatypeProperty .
hpc:ConsumableResource_Partition rdfs:subClassOf hpc:Partition .
hpc:Shared_Job rdfs:subClassOf hpc:Job .
hpc:NonShared_Job rdfs:subClassOf hpc:Job .
hpc:FirstJob_Partition rdfs:subClassOf hpc:Partition .
hpc:SecondJob_Partition rdfs:subClassOf hpc:Partition .
hpc:ConstrainedTresPlugin rdfs:subClassOf hpc:ConsumableResourcePlugin .
hpc:LinearPlugin rdfs:subClassOf hpc:ConsumableResourcePlugin .
hpc:SelectPlugin rdfs:subClassOf hpc:ConsumableResourcePlugin .
hpc:RunningOn rdfs:domain hpc:Job ;
                         rdfs:range hpc:Node .
hpc:SharingResources rdfs:domain hpc:ConstrainedTresPlugin ;
                      rdfs:range hpc:Node .
hpc:OverSubscribeSetting rdfs:domain hpc:ConstrainedTresPlugin ;
                         rdfs:range hpc:Integer .
hpc:HasCPUs rdfs:domain hpc:Node ;
                    rdfs:range xsd:integer .
