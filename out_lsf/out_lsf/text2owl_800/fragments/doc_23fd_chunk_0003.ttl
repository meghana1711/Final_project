hpc:Command a owl:Class .
hpc:hasunsupportedparameters a owl:ObjectProperty .
hpc:isstandalone a owl:DatatypeProperty .

hpc:Command rdfs:subClassOf owl:Class .
hpc:Hasunsupportedparameters rdfs:domain hpc:Command ;
                                 rdfs:range rdf:List .
hpc:Isstandalone rdfs:domain hpc:Command ;
                  rdfs:range xsd:boolean .

hpc:Unsupportedparameter a owl:Class .
hpc:UnsupportedParameters rdf:type rdf:List ;
                             rdfs:first hpc:UnsupportedParameter ;
                             rdfs:rest hpc:UnsupportedParameters .
hpc:Unsupportedparameter rdfs:subClassOf owl:Class .
