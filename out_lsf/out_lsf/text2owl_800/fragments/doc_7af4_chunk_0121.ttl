hpc:Environmentvariable a owl:Class .
hpc:commandpath a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .

hpc:lsbJobpgids a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .

hpc:lsbJobpids a owl:DatatypeProperty ;
    rdfs:domain hpc:Environmentvariable ;
    rdfs:range xsd:string .

hpc:Unixdefaultcommandpath a owl:Class ;
    rdfs:subClassOf hpc:Environmentvariable ;
    rdfs:comment "Command path for UNIX and Linux, with a limit of 4094 characters." .

hpc:Windowsdefaultcommandpath a owl:Class ;
    rdfs:subClassOf hpc:Environmentvariable ;
    rdfs:comment "Command path for Windows, with a limit of 255 characters." .

hpc:Jobcontrolmessages a owl:Class ;
    rdfs:subClassOf hpc:Environmentvariable ;
    rdfs:comment "Job control messages." .

hpc:Termination a owl:Class ;
    rdfs:subClassOf hpc:Environmentvariable ;
    rdfs:comment "Termination methods." .

hpc:Threadlimit a owl:Class ;
    rdfs:subClassOf hpc:Environmentvariable ;
    rdfs:comment "Limits the number of concurrent threads." .

hpc:threadlimitforjob a owl:DatatypeProperty ;
    rdfs:domain hpc:Threadlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The job's thread limit value." .

hpc:threadlimitpertask a owl:DatatypeProperty ;
    rdfs:domain hpc:Threadlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The limit for concurrent threads per task." .

hpc:Unixdefaulttermination a owl:Class ;
    rdfs:subClassOf hpc:Termination ;
    rdfs:comment "Default termination method on UNIX." .

hpc:Windowsdefaulttermination a owl:Class ;
    rdfs:subClassOf hpc:Termination ;
    rdfs:comment "Default termination method on Windows." .
