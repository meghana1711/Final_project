hpc:Lsbapplication a owl:Class .
hpc:Lsbqueue a owl:Class .
hpc:Lsbjob a owl:Class .
hpc:Environmentvariable a owl:Class .

# Object Properties
hpc:hasaffinity a owl:ObjectProperty .
hpc:overrides a owl:ObjectProperty .

# Datatype Properties
hpc:haspreference a owl:DatatypeProperty .
hpc:hasorder a owl:DatatypeProperty .

# Domain and Range
hpc:Hasaffinity rdfs:domain hpc:Lsbapplication ;
                 rdfs:domain hpc:Lsbqueue ;
                 rdfs:domain hpc:Lsbjob .
hpc:Overrides rdfs:domain hpc:Environmentvariable .
hpc:Haspreference rdfs:range xsd:string .
hpc:Hasorder rdfs:range xsd:string .

# Subclass Relations
hpc:Lsbapplication rdfs:subClassOf hpc:Lsbentity .
hpc:Lsbqueue rdfs:subClassOf hpc:Lsbentity .
hpc:Lsbjob rdfs:subClassOf hpc:Lsbentity .
hpc:Environmentvariable rdfs:subClassOf hpc:Lsbentity .

# LSB Application Affinity
hpc:lsbapplicationHasdockerimageaffinity a owl:ObjectProperty .
hpc:LsbapplicationHasdockerimageaffinity rdfs:domain hpc:Lsbapplication ;
                                            rdfs:range hpc:Dockerimageaffinity .

# Docker Image Affinity
hpc:Dockerimageaffinity a owl:Class .
hpc:dockerimageaffinityIsenabled a owl:DatatypeProperty .

# LSB Queue Affinity
hpc:lsbqueueHasdockerimageaffinity a owl:ObjectProperty .
hpc:LsbqueueHasdockerimageaffinity rdfs:domain hpc:Lsbqueue ;
                                       rdfs:range hpc:Dockerimageaffinity .

# LSB Job Environment Variable
hpc:lsbjobHasenvironmentvariable a owl:ObjectProperty .
hpc:LsbjobHasenvironmentvariable rdfs:domain hpc:Lsbjob ;
                                      rdfs:range hpc:Environmentvariable .

# LSB Job Level Override
hpc:lsbjobOverridesapplicationaffinity a owl:ObjectProperty .
hpc:lsbjobOverridesqueueaffinity a owl:ObjectProperty .
hpc:LsbjobOverridesapplicationaffinity rdfs:domain hpc:Lsbjob ;
                                            rdfs:range hpc:Environmentvariable .
hpc:LsbjobOverridesqueueaffinity rdfs:domain hpc:Lsbjob ;
                                          rdfs:range hpc:Environmentvariable .
