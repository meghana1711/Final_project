hpc:Jobgroup a owl:Class .
hpc:jobgroupname a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:grouppathname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup .
hpc:limit a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:positiveInteger .
hpc:maxconcurrentjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range hpc:Limit .
hpc:Rootjobgroup a owl:Class ;
    rdfs:subClassOf hpc:Jobgroup .
hpc:Limit a owl:Class ;
    rdfs:subClassOf xsd:nonNegativeInteger .
