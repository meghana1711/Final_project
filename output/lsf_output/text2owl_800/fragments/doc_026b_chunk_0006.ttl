hpc:Installconfiguration a owl:Class .
hpc:LsfTop rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .
hpc:LsfAdmins rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .
hpc:LsfClusterName rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .
hpc:LsfMasterList rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .
hpc:LsfEntitlementFile rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .
hpc:LsfTardir rdfs:domain hpc:Installconfiguration ;
    rdfs:range xsd:string .

# LSF Data Manager Parameters File
hpc:Lsfdatamanagerparametersfile a owl:Class .
hpc:Isinenvironmentdirectory rdfs:domain hpc:Lsfdatamanagerparametersfile ;
    rdfs:range xsd:boolean .
hpc:Isaccessiblefromalldatamanagerhosts rdfs:domain hpc:Lsfdatamanagerparametersfile ;
    rdfs:range xsd:boolean .

# LSF Data Manager Object Property
hpc:configureslsfdatamanager a owl:ObjectProperty .
hpc:Configureslsfdatamanager rdfs:domain hpc:Installconfiguration ;
    rdfs:range hpc:Lsfdatamanagerparametersfile .
