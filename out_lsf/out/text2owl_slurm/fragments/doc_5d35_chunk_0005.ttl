hpc:Heterogeneousjob a owl:Class .
hpc:Jobcomponent a owl:Class .
hpc:hetjoboffset a owl:DatatypeProperty ;
    rdfs:domain hpc:Heterogeneousjob ;
    rdfs:range xsd:integer .
hpc:jobid a owl:ObjectProperty ;
    rdfs:domain hpc:Heterogeneousjob ;
    rdfs:range xsd:string .
hpc:componentid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string .
hpc:Partition a owl:Class .
hpc:name a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string .
hpc:state a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string .
hpc:time a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:time .
hpc:nodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:integer .
hpc:nodelist a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobcomponent ;
    rdfs:range xsd:string .
hpc:Heterogeneousjobleader a owl:Class ;
    rdfs:subClassOf hpc:Heterogeneousjob .
hpc:Individualcomponent a owl:Class ;
    rdfs:subClassOf hpc:Jobcomponent .
hpc:Cancelablejob a owl:Class ;
    rdfs:subClassOf hpc:Heterogeneousjob .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Cancelablejob .
hpc:Executingjob a owl:Class ;
    rdfs:subClassOf hpc:Cancelablejob .
hpc:Modifiablejob a owl:Class ;
    rdfs:subClassOf hpc:Cancelablejob .
hpc:Emailnotifiablejob a owl:Class ;
    rdfs:subClassOf hpc:Heterogeneousjobleader .
