hpc:SlurmFailure a owl:Class .
hpc:TroubleshootingGuide rdf:type hpc:Document .
hpc:FrequentlyAskedQuestions rdf:type hpc:Document .

hpc:SlurmNotResponding a hpc:SlurmFailure .
hpc:JobsNotScheduled a hpc:SlurmFailure .
hpc:NodesStuckInCompletingState a hpc:SlurmFailure .
hpc:NodesDownState a hpc:SlurmFailure .
hpc:NetworkingProblems a hpc:SlurmFailure .
hpc:ConfigurationProblems a hpc:SlurmFailure .

hpc:scontrolPing a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:boolean .

hpc:Slurmctld a owl:Class .
hpc:SlurmctldDaemon a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:string .

hpc:SlurmctldLog a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:string .

hpc:SlurmctldRunning a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:boolean .

hpc:SlurmctldNotResponding a hpc:SlurmFailure .
hpc:SlurmctldHang a hpc:SlurmFailure .
hpc:SlurmctldFailMode a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmFailure ;
    rdfs:range xsd:string .

hpc:SlurmctldDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:integer .

hpc:SlurmStart a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:string .

hpc:SlurmStop a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:string .

hpc:SlurmStartClean a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmOperator ;
    rdfs:range xsd:string .
