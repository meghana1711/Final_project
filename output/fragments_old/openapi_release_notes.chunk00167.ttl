hpc:Association a owl:Class .
hpc:OpenapiAssocsResp a owl:Class .
hpc:OpenapiAssocsRemovedResp a owl:Class .

hpc:postRequestBodyContent a owl:Class .
hpc:postRequestBodyContent_applicationYAML a owl:DatatypeProperty .
hpc:postRequestBodyContent_applicationYAML rdfs:domain hpc:Association ;
                                               rdfs:range rdf:Resource .

hpc:postResponseContent a owl:Class .
hpc:postResponseContent_applicationYAML a owl:DatatypeProperty .
hpc:postResponseContent_applicationYAML rdfs:domain hpc:Association ;
                                               rdfs:range rdf:Resource .

hpc:postResponse_200 a owl:Class ;
                      rdfs:subClassOf hpc:postResponseContent .

hpc:postResponse_default a owl:Class ;
                          rdfs:subClassOf hpc:postResponseContent .

hpc:deleteResponse_200 a owl:Class ;
                        rdfs:subClassOf hpc:postResponseContent .

hpc:deleteResponse_default a owl:Class ;
                            rdfs:subClassOf hpc:postResponseContent .

hpc:post a owl:ObjectProperty .
hpc:post rdfs:domain hpc:Association ;
       rdfs:range rdf:Resource .

hpc:postResponse_200 rdfs:subPropertyOf hpc:postResponse .
hpc:postResponse_default rdfs:subPropertyOf hpc:postResponse .
hpc:deleteResponse_200 rdfs:subPropertyOf hpc:postResponse .
hpc:deleteResponse_default rdfs:subPropertyOf hpc:postResponse .
```
