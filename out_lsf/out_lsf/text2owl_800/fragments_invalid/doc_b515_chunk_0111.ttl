@base <http://example.org/hpc/>

hpc:Script a owl:Class ;
    rdfs:subClassOf owl:Object ;
    rdfs:comment "A script that sets up and cleans up an LSF job." .

hpc:lsbdjobenvscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string ;
    rdfs:comment "The environment script variable for LSF jobs." .

hpc:cleanup a owl:ObjectProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range hpc:Script ;
    rdfs:comment "The cleanup script for a job." .

hpc:errormessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:string ;
    rdfs:comment "The error message printed to stderr if the script returns a non-zero value." .

hpc:jobexitvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Script ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The real job exit value."
