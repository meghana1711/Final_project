# Cluster
hpc:Cluster a owl:Class .

# Release
hpc:Release a owl:Class .

# Version
hpc:Version a owl:Class .
hpc:Version rdfs:subClassOf hpc:Release .
hpc:Version rdfs:subClassOf rdf:Resource .
hpc:Version rdfs:subClassOf xsd:string .

hpc:Major a owl:DatatypeProperty .
hpc:Major rdfs:domain hpc:Version .
hpc:Major rdfs:range xsd:nonNegativeInteger .

hpc:Minor a owl:DatatypeProperty .
hpc:Minor rdfs:domain hpc:Version .
hpc:Minor rdfs:range xsd:nonNegativeInteger .

hpc:Micro a owl:DatatypeProperty .
hpc:Micro rdfs:domain hpc:Version .
hpc:Micro rdfs:range xsd:nonNegativeInteger .

# Slurm
hpc:Slurm a owl:Class .
hpc:Slurm rdfs:subClassOf rdf:Resource .

hpc:cluster a owl:ObjectProperty .
hpc:cluster rdfs:domain hpc:Slurm .
hpc:cluster rdfs:range hpc:Cluster .

hpc:release a owl:ObjectProperty .
hpc:release rdfs:domain hpc:Slurm .
hpc:release rdfs:range hpc:Release .

hpc:version a owl:ObjectProperty .
hpc:version rdfs:domain hpc:Slurm .
hpc:version rdfs:range hpc:Version .

# Plugin
hpc:Plugin a owl:Class .
hpc:Plugin rdfs:subClassOf rdf:Resource .

hpc:accounting_storage a owl:DatatypeProperty .
hpc:accounting_storage rdfs:domain hpc:Plugin .
hpc:accounting_storage rdfs:range xsd:string .

hpc:name a owl:DatatypeProperty .
hpc:name rdfs:domain hpc:Plugin .
hpc:name rdfs:range xsd:string .

hpc:type a owl:DatatypeProperty .
hpc:type rdfs:domain hpc:Plugin .
hpc:type rdfs:range xsd:string .

hpc:data_parser a owl:DatatypeProperty .
hpc:data_parser rdfs:domain hpc:Plugin .
hpc:data_parser rdfs:range xsd:string .

# Client
hpc:Client a owl:Class .
