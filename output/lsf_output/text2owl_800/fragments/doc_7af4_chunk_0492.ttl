hpc:Span a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Define span[hosts=-1] in the application profile or bsub -R resource requirement string to override the span section setting in the queue. Default select[type==local] order[r15s:pg]." .

hpc:Hostmodel a owl:Class .

hpc:Booleanresource a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Reservableresource a owl:Class .

hpc:reservablelimit a owl:ObjectProperty ;
    rdfs:domain hpc:Reservableresource ;
    rdfs:range xsd:float .

hpc:Consumableresource a owl:Class ;
    rdfs:subClassOf hpc:Reservableresource .

hpc:minvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Consumableresource ;
    rdfs:range xsd:float .

hpc:maxvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Consumableresource ;
    rdfs:range xsd:float .

hpc:Queuelevelresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Joblevelresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement .

hpc:Mergedresourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Merged RES_REQ rusage values from the job and application levels must be in the range set by RESRSV_LIMIT, or the job is rejected." .

hpc:Jobrejection a owl:Class ;
    rdfs:subClassOf hpc:Event .

hpc:Resourcerequirementignored a owl:Class ;
    rdfs:subClassOf hpc:Event .

hpc:Resourcerequirementchange a owl:Class ;
    rdfs:subClassOf hpc:Event .

hpc:Resourcerequirementchangeexceeded a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementchange .

hpc:Resourcerequirementchangelowerthanmin a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirementchange .

hpc:queuelevelresourcerequirementlimit a owl:ObjectProperty ;
    rdfs:domain hpc:Queuelevelresourcerequirement ;
    rdfs:range hpc:Resourcerequirement .

hpc:defaultvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Queuelevelresourcerequirement .
