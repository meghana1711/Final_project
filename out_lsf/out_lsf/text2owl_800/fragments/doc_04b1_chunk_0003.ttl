hpc:Mungedaemon a owl:Class .
hpc:numthreads a owl:ObjectProperty .
hpc:Numthreads rdfs:domain hpc:Mungedaemon ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Ulimit a owl:Class .
hpc:memorysize a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .
hpc:openfilecount a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .
hpc:stacksize a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

hpc:Slurmconfiguration a owl:Class .
hpc:accountingstoragetype a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration .
hpc:Accountingstoragetype rdfs:range hpc:Plugin .

hpc:jobacctgathertype a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration .
hpc:Jobacctgathertype rdfs:range hpc:Plugin .

hpc:jobcomp a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration .
hpc:Jobcomp rdfs:range hpc:Plugin .

hpc:jobsubmitplugins a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfiguration .
hpc:Jobsubmitplugins rdfs:range hpc:String .

hpc:Slurmdbdconfig a owl:Class .
hpc:commitdelay a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdbdconfig .
hpc:Commitdelay rdfs:range xsd:nonNegativeInteger .

hpc:Plugin a owl:Class .
hpc:Plugin1 a owl:Class ;
    rdfs:subClassOf hpc:Plugin .
hpc:Plugin1 rdfs:comment "SlurmDBD plugin" .

hpc:Plugin2 a owl:Class ;
    rdfs:subClassOf hpc:Plugin .
hpc:Plugin2 rdfs:comment "Accounting plugin" .

hpc:Plugin3 a owl:Class ;
    rdfs:subClassOf hpc:Plugin .
hpc:Plugin3 rdfs:comment "Job submit plugin" .
