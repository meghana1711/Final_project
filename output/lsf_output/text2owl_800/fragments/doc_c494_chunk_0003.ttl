hpc:Lsfjob a owl:Class .
hpc:hasexitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:signalvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer .
hpc:requeuelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:bsubcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfjob ;
    rdfs:range hpc:Bsubcommand .
hpc:Bsubcommand a owl:Class .
hpc:taskdefinitionfile a owl:ObjectProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range xsd:string .
hpc:bsubmode a owl:ObjectProperty ;
    rdfs:domain hpc:Bsubcommand ;
    rdfs:range xsd:string .
hpc:SschedRequeueLimit rdfs:subClassOf hpc:Lsfjob .
hpc:Taskfailed a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Tasknotsaved a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
hpc:Tasknotnotified a owl:Class ;
    rdfs:subClassOf hpc:Lsfjob .
