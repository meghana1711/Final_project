hpc:Jobid a owl:Class ;
    rdfs:subClassOf hpc:Outputfield ;
    rdfs:comment "Job identifier with unlimited width or specified width.";
    rdfs:label "JobID" ;
    rdfs:domain hpc:Bjobsoutput ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasOutputField ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range hpc:Outputwidth .

hpc:outputwidth a owl:DatatypeProperty ;
    rdfs:subPropertyOf rdf:Property ;
    rdfs:domain hpc:Outputformat ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Specified output width for JobID." .

hpc:Bjobsformat a owl:Class ;
    rdfs:subClassOf hpc:Outputformat ;
    rdfs:comment "Format for bjobs output." ;
    rdfs:label "BJobsFormat" ;
    rdfs:domain hpc:Bjobsoutput .

hpc:Bjobsoutput a owl:Class ;
    rdfs:subClassOf hpc:Output ;
    rdfs:comment "Output of bjobs command." ;
    rdfs:label "BJobsOutput" .

hpc:Output a owl:Class ;
    rdfs:subClassOf rdf:Resource .

hpc:hasoutputfield a owl:ObjectProperty ;
    rdfs:domain hpc:Output ;
    rdfs:range hpc:Outputfield ;
    rdfs:comment "The fields in the output." .

hpc:Outputfield a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "A field in the output." ;
    rdfs:label "OutputField" .

hpc:Stat a owl:Class ;
    rdfs:subClassOf hpc:Outputfield ;
    rdfs:comment "Status of a job." ;
    rdfs:label "STAT" ;
    rdfs:domain hpc:Bjobsoutput ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasOutputField ;
    rdfs:domain hpc:Bjobsformat ;
    rdfs:range xsd:string ;
    rdfs:maxCardinality 1 ;
    rdfs:label "STAT" ;
    rdfs:comment "Maximum width of 5 characters." ;
    rdfs:domain hpc:Bjobsformat ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Alignment" ;
    rdfs:comment "Left-aligned." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Outputfield ;
    rdfs:comment "Queue where the job is running." ;
    rdfs:label "QUEUE" ;
    rdfs:domain hpc:Bjobsoutput ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:hasOutputField ;
    rdfs:domain hpc:Bjobsformat
