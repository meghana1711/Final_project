hpc:Cpuslot a owl:Class .
hpc:ServiceInstance rdf:type owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:SessionManager rdf:type owl:Class ;
    rdfs:subClassOf hpc:Resource .
hpc:Daemon a owl:Class .
hpc:vemkd rdf:type hpc:Daemon .
hpc:egosc rdf:type hpc:Daemon .
hpc:pem rdf:type hpc:Daemon .
hpc:ProcessExecutionManager rdf:type hpc:Daemon ;
    rdfs:subClassOf hpc:Daemon .
hpc:Resource a owl:Class .
hpc:Resourcegroup a owl:Class .
hpc:hasattribute a owl:ObjectProperty .
hpc:ResourceType rdf:type owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:Hasattribute rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:isPartOf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourcegroup ;
    rdfs:range hpc:Resource .
