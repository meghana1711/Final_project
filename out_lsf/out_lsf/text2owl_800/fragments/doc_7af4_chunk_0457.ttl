hpc:Joboverrun a owl:Class .
hpc:Hasruntime rdfs:domain hpc:Joboverrun ;
                 rdfs:range xsd:nonNegativeInteger .

hpc:Jobsizelist a owl:Class .
hpc:Hasdefaultsize rdfs:domain hpc:Jobsizelist ;
                   rdfs:range hpc:Jobsize .
hpc:Hasjobsize rdfs:domain hpc:Jobsizelist ;
                 rdfs:range hpc:Jobsize .

hpc:Jobsize a owl:Class .

hpc:Joboverrunexception rdfs:subClassOf hpc:Joboverrun .
hpc:JobOverrunException rdfs:comment "A job overrun exception is triggered for jobs running longer than the specified run time." .

hpc:Jobsizelistspecification rdfs:subClassOf hpc:Jobsizelist .
hpc:JobSizeListSpecification rdfs:comment "Specifies a list of job sizes (number of tasks) that are allowed on this queue." .

hpc:Jobsizeallowed rdfs:subClassOf hpc:Jobsize .
hpc:JobSizeAllowed rdfs:comment "The job sizes that are allowed on this queue." .

hpc:Jobsizerequest rdfs:subClassOf hpc:Jobsize .
hpc:JobSizeRequest rdfs:comment "The requested job size when submitting a job or modifying a pending job." .

hpc:Jobsizedefault rdfs:subClassOf hpc:Jobsize .
hpc:JobSizeDefault rdfs:comment "The first value in this list is the default job size, which is the assigned job size request if the job was submitted without requesting one." .

hpc:jobsizelist a owl:ObjectProperty ;
                rdfs:domain hpc:Queue ;
                rdfs:range hpc:Jobsizelistspecification .

hpc:hasdefaultsize a owl:ObjectProperty ;
                    rdfs:domain hpc:Jobsizelistspecification ;
                    rdfs:range hpc:Jobsizedefault .

hpc:hasjobsize a owl:ObjectProperty ;
                rdfs:domain hpc:Jobsizelistspecification ;
                rdfs:range hpc:Jobsizeallowed .

hpc:Jobsizelistspecification a owl:Class .
hpc:Jobsizeallowed a owl:Class .
hpc:Jobsizerequest a owl:Class .
hpc:Jobsizedefault a owl:Class .
