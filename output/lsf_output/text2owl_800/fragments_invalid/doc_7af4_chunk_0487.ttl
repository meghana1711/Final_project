hpc:Rerunnable a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Members of a chunk job can be rerunnable." .

hpc:Rerundisabled a owl:Class ;
    rdfs:subClassOf hpc:Rerunnable ;
    rdfs:comment "Rerun is disabled when RERUNNABLE is set to no." ;
    rdfs:subPropertyOf hpc:hasRerunStatus .

hpc:hasRerunStatus rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Rerunnable ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether rerun is enabled or disabled." .

hpc:rerunstatus a owl:DatatypeProperty ;
    rdfs:domain hpc:Rerunnable ;
    rdfs:range xsd:string ;
    rdfs:comment "The value of rerun status (yes or no)." .

hpc:Casesensitive a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Indicates whether the rerun status is case sensitive." .

hpc:isCaseSensitive rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Rerunnable ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the rerun status is case sensitive." .

hpc:Multiclusterjob a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Represents a multicluster job." .

hpc:Resourcereserve a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Enables processor reservation and memory reservation for pending jobs." .

hpc:maxreservetime a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcereserve ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the number of dispatch turns over which a job can reserve job slots and memory." .

hpc:Slotreserve a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Job slot reservation for parallel jobs." .

hpc:Reservablejob a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing> ;
    rdfs:comment "Represents a job that can reserve resources." .

hpc:canReserveResources rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Reservablejob ;
    rdfs:range hpc:Resourcereserve ;
