hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Groups of jobs with the same executable and resource requirements, but different input files.";
    rdfs:label "JobArray" ;
    rdfs:domain hpc:Jobsubmissionrequest ;
    rdfs:range xsd:string ;

hpc:jobarrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:integer ;
    rdfs:comment "Unique reference for each job in a job array.";

hpc:jobarrayname a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string ;
    rdfs:comment "User specified string that is used to identify the job array.";
    rdfs:subPropertyOf rdf:type ;

hpc:Jobarraynamepattern a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Valid values are any combination of the following characters: a-z | A-Z | 0-9 | . | - | _";
    rdfs:pattern "^[a-zA-Z0-9._-]*$"^^xsd:string ;

hpc:jobarraydimension a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range hpc:Jobarraydimension ;
    rdfs:comment "Specifies the size and dimension of the job array.";

hpc:jobarraystart a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraydimension ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the start of a range of indices.";

hpc:jobarrayend a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraydimension ;
    rdfs:range xsd:integer ;

hpc:jobarraystep a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarraydimension ;
    rdfs:range xsd:integer ;

hpc:Jobarrayindexlist a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Specifies the indices of a job array.";
    rdfs:pattern "^[0-9]+(-[0-9]+(:[0-9]+)?)*(,[0-9]+(-[0-9]+(:[0-9]+)?)*)*$"^^xsd:string ;
