hpc:Installedversion a owl:Class .
hpc:Platform a owl:Class .
hpc:Identifyfixespage a owl:Class .
hpc:Searchoption a owl:Class .
hpc:Aparorspr a owl:Class .
hpc:Fixid a owl:Class .
hpc:Searchkeyword a owl:Class .
hpc:Recommendedfix a owl:Class .
hpc:Ibmpowersystemsfix a owl:Class .
hpc:Fixlevelrecommendationtool a owl:Class .
hpc:Operatingsystem a owl:Class .

hpc:Hasinstalledversion rdfs:domain hpc:Installedversion ;
  rdfs:range xsd:string .
hpc:Runson rdfs:domain hpc:Platform ;
  rdfs:range hpc:Operatingsystem .
hpc:Onidentifyfixespage rdfs:domain hpc:Identifyfixespage ;
  rdfs:range xsd:string .
hpc:Hassearchoption rdfs:domain hpc:Identifyfixespage ;
  rdfs:range hpc:Searchoption .
hpc:Hasaparorspr rdfs:domain hpc:Searchoption ;
  rdfs:range hpc:Aparorspr .
hpc:Hasfixid rdfs:domain hpc:Searchoption ;
  rdfs:range hpc:Fixid .
hpc:Hassearchkeyword rdfs:domain hpc:Searchoption ;
  rdfs:range xsd:string .
hpc:Hasrecommendedfix rdfs:domain hpc:Installedversion ;
  rdfs:range hpc:Recommendedfix .
hpc:Isibmpowersystemsfix rdfs:domain hpc:Recommendedfix ;
  rdfs:range hpc:Ibmpowersystemsfix .
hpc:Providesfixlevelrecommendation rdfs:domain hpc:Ibmpowersystemsfix ;
  rdfs:range hpc:Fixlevelrecommendationtool .
