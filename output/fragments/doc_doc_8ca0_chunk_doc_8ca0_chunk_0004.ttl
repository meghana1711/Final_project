hpc:ResumeTimeout
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:integer ;
    rdfs:comment "Maximum time permitted (in seconds) between when a node resume request is issued and when the node is actually available for use." .

hpc:SchedulerParameters
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:SchedulerType
    a owl:Class .

hpc:sallocWaitNodes
    a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range hpc:SchedulerType ;
    rdfs:comment "If defined, the salloc command will wait until all allocated nodes are ready for use (i.e. booted) before the command returns." .

hpc:sbatchWaitNodes
    a owl:ObjectProperty ;
    rdfs:domain hpc:SchedulerParameters ;
    rdfs:range hpc:SchedulerType ;
    rdfs:comment "If defined, the sbatch script will wait until all allocated nodes are ready for use (i.e. booted) before the initiation." .

hpc:SlurmctldParameters
    a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:cloudDNS
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldParameters ;
    rdfs:range xsd:boolean ;
    rdfs:comment "By default, Slurm expects that the network addresses for cloud nodes won't be known until creation of the node and that Slurm will be notified of the node's address upon registration. Since Slurm communications rely on the node configuration found in the slurm.conf, Slurm will tell the client command, after waiting for all nodes to boot, each node's IP address. However, in environments where the nodes are in DNS, this step can be avoided by configuring this option." .

hpc:idleOnNodeSuspend
    a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmctldParameters ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Mark nodes as idle, regardless of current state, when suspending nodes with SuspendProgram so that nodes will be eligible to be resumed at a later time." .
```
