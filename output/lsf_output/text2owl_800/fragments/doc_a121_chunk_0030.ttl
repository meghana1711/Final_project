hpc:Currentworkingdirectory a owl:Class .
hpc:Licproject a owl:Class .
hpc:License a owl:Class .
hpc:ForwardCluster a owl:Class .
hpc:Multicluster rdfs:subClassOf xsd:string .
hpc:ForwardTime a owl:Class .
hpc:fwdTime a owl:DatatypeProperty .
hpc:FwdTime rdfs:domain hpc:ForwardTime ;
                        rdfs:range xsd:dateTime .
hpc:srcjobid a owl:DatatypeProperty .
hpc:Srcjobid rdfs:domain hpc:Currentworkingdirectory ;
                        rdfs:range xsd:string .
hpc:dstjobid a owl:DatatypeProperty .
hpc:Dstjobid rdfs:domain hpc:Currentworkingdirectory ;
                        rdfs:range xsd:string .
hpc:SourceCluster a owl:Class .
hpc:energy a owl:DatatypeProperty .
hpc:Energy rdfs:domain hpc:Currentworkingdirectory ;
                        rdfs:range xsd:decimal .
hpc:Joule rdfs:subClassOf xsd:decimal .
