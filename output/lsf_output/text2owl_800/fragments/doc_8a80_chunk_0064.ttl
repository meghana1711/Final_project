hpc:Featuregroup a owl:Class .
hpc:Hasfeaturelist rdfs:domain hpc:Featuregroup ;
                    rdfs:range rdf:List .
hpc:Feature rdfs:subClassOf hpc:Featuregroup ;
                 rdfs:subClassOf rdf:List ;
                 rdfs:subClassOf rdf:Seq .
hpc:feature a owl:ObjectProperty .
hpc:Feature rdfs:domain hpc:Featuregroup ;
               rdfs:range hpc:Feature .
hpc:Projectgroup a owl:Class .
hpc:Hasprojectgrouprelationship rdfs:domain hpc:Projectgroup ;
                    rdfs:range hpc:Projectgroup .
hpc:Projectgroup rdfs:subClassOf hpc:Namedthing .
hpc:Projectgroup rdfs:subClassOf hpc:Hierarchicalgroup .
hpc:Projectgroup rdfs:subClassOf hpc:Schedulable .
hpc:Projectgroup rdfs:subClassOf hpc:Licenseprojectcontainer .
hpc:Projectgroup rdfs:subClassOf hpc:Hasshares .
hpc:Projectgroup rdfs:subClassOf hpc:Haslimits .
hpc:Projectgroup rdfs:subClassOf hpc:Hasownership .
hpc:Projectgroup rdfs:subClassOf hpc:Hasnonsharedlicenses .
