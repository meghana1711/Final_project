hpc:DeactivatingAllQueues
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Deactivating all queues pends any running jobs and prevents new jobs from being dispatched." .

hpc:qinactAll
    a owl:ObjectProperty ;
    rdfs:domain hpc:Deactivatingallqueues ;
    rdfs:range rdf:Literal .

hpc:IBMSpectrumLSFApplicationCenter
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "IBM Spectrum LSF Application Center" .

hpc:pmcadminStop
    a owl:ObjectProperty ;
    rdfs:domain hpc:Ibmspectrumlsfapplicationcenter ;
    rdfs:range rdf:Literal .

hpc:Backup
    a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Class ] ;
    rdfs:comment "Back up your existing LSF_CONFDIR, LSB_CONFDIR, and LSB_SHAREDIR according to the procedures at your site." .

hpc:setupScriptUpgrade
    a owl:ObjectProperty ;
    rdfs:domain hpc:Backup ;
    rdfs:range rdf:Literal .

hpc:SourceCshrcOrProfile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Setupscriptupgrade ;
    rdfs:range rdf:Literal .

hpc:NavigateToLocation
    a owl:ObjectProperty ;
    rdfs:domain hpc:Sourcecshrcorprofile ;
    rdfs:range rdf:Literal .

hpc:Extract
    a owl:ObjectProperty ;
    rdfs:domain hpc:Navigatetolocation ;
    rdfs:range rdf:Literal .

hpc:RunSetupScript
    a owl:ObjectProperty ;
    rdfs:domain hpc:Extract ;
    rdfs:range rdf:Literal .

hpc:InstallLicenseSchedulerStandardEdition
    a owl:ObjectProperty ;
    rdfs:domain hpc:Runsetupscript ;
    rdfs:range rdf:Literal .

hpc:CopyEntitlementFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Installlicenseschedulerstandardedition ;
    rdfs:range rdf:Literal .

hpc:StartLicenseScheduler
    a owl:ObjectProperty ;
    rdfs:domain hpc:Copyentitlementfile ;
    rdfs:range rdf:Literal .
