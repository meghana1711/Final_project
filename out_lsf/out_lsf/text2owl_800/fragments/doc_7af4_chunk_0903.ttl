hpc:Filetransfercommand a owl:Class .
hpc:permissionmask a owl:DatatypeProperty .

hpc:Filetransfercommand rdfs:subClassOf owl:Class .
hpc:Permissionmask rdfs:subClassOf owl:DatatypeProperty .

hpc:FILE_TRANSFER_CMD rdf:value "scp" ;
    rdfs:comment "Default command for file transfer." .

hpc:PERMISSION_MASK rdf:value "octal_mode" ;
    rdfs:comment "Controls how data cache file permissions can be changed." .

hpc:PermissionMask rdfs:domain hpc:Filetransferjob .
hpc:PermissionMask rdfs:range xsd:string .

hpc:octal_mode rdf:value "4" ;
    rdfs:comment "Permissions for the user who owns the file." .

hpc:octal_mode rdf:value "2" ;
    rdfs:comment "Permissions for other users in the group that is associated with the file." .

hpc:octal_mode rdf:value "1" ;
    rdfs:comment "Permissions for other users not in the group that is associated with the file." .

hpc:FileTransferJob rdf:type owl:Class .
