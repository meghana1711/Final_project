hpc:User a owl:Class .
hpc:Usergroup a owl:Class .
hpc:hasuser a owl:ObjectProperty .
hpc:Hasuser rdfs:domain hpc:Usergroup ;
                        rdfs:range hpc:User .
hpc:isalluser a owl:ObjectProperty .
hpc:Isalluser rdfs:domain hpc:Usergroup ;
                 rdfs:range xsd:boolean .
hpc:excludeuser a owl:ObjectProperty .
hpc:Excludeuser rdfs:domain hpc:Usergroup ;
                 rdfs:range xsd:string .
hpc:excludeusergroup a owl:ObjectProperty .
hpc:Excludeusergroup rdfs:domain hpc:Usergroup ;
                     rdfs:range xsd:string .
hpc:hasgroup a owl:ObjectProperty .
hpc:Hasgroup rdfs:domain hpc:User ;
                 rdfs:range hpc:Usergroup .
hpc:Forwardjob a owl:Class .
hpc:requiresgpu a owl:DatatypeProperty .
hpc:Requiresgpu rdfs:domain hpc:Forwardjob ;
                 rdfs:range xsd:boolean .
