hpc:License a owl:Class .
hpc:Token a owl:Class .
hpc:Project a owl:Class .
hpc:Cluster a owl:Class .

hpc:hasLicense an owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range hpc:Token .

hpc:isborrowedby a owl:ObjectProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range hpc:Workload .

hpc:isavailable a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:decimal .

hpc:isinuse a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:decimal .

hpc:isreserved a owl:DatatypeProperty ;
    rdfs:domain hpc:Token ;
    rdfs:range xsd:decimal .

hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Token .

hpc:Isprojectgroup a owl:Class ;
    rdfs:subClassOf hpc:Project .

hpc:hasaccumulatedvalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:decimal .

hpc:hasscaledaccumulatevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range xsd:decimal .

hpc:Iscrosscluster a owl:Class ;
    rdfs:subClassOf hpc:Cluster .

hpc:hastokenusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:hasreservedtokens a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:hasfreetokens a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:hastokendemand a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:hasaccumulatedtokens a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:hasscaledaccumulatevalueincluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:decimal .

hpc:showLicenseTokens an owl:ObjectProperty ;
    rdfs:domain hpc:Token .

hpc:showprojectlicenses a owl:ObjectProperty ;
    rdfs:domain hpc:Project .

hpc:showprojectgrouplicenses a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup .

hpc:showcrossclusterinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster .

hpc:showReleaseVersion a
