hpc:HeterogeneousJob a owl:Class .
hpc:RegularJob a owl:Class, rdfs:subClassOf hpc:Job .
hpc:HeterogeneousJob rdfs:subClassOf hpc:Job .
hpc:ResourceLimitTest a owl:ObjectProperty .
hpc:QOSLimitTest a owl:ObjectProperty .
hpc:JobComponent a owl:Class, rdfs:subClassOf hpc:Job .
hpc:PersistentBurstBuffer a owl:Class .
hpc:JobSpecificBurstBuffer a owl:Class .
hpc:hasResourceLimitTest a owl:ObjectProperty, rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range rdfs:Resource .
hpc:hasQOSLimitTest a owl:ObjectProperty, rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range rdfs:Resource .
hpc:hasJobComponent a owl:ObjectProperty, rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:JobComponent .
hpc:hasPersistentBurstBuffer a owl:ObjectProperty, rdfs:domain hpc:HeterogeneousJob ;
    rdfs:range hpc:PersistentBurstBuffer .
hpc:hasJobSpecificBurstBuffer a owl:ObjectProperty, rdfs:domain hpc:JobComponent ;
    rdfs:range hpc:JobSpecificBurstBuffer .
hpc:hasBurstBufferDirective a owl:DatatypeProperty, rdfs:domain hpc:JobSpecificBurstBuffer ;
    rdfs:range xsd:string .
hpc:isPersistent a owl:ObjectProperty, rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
hpc:hasCapacity a owl:DatatypeProperty, rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hasAccess a owl:DatatypeProperty, rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:string .
hpc:hasType a owl:DatatypeProperty, rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:string .
hpc:isDatawarpPlugin a owl:Class .
hpc:hasNodes a owl:DatatypeProperty, rdfs:domain hpc:Job .
hpc:hasConstraint a owl:DatatypeProperty, rdfs:domain hpc:Job .
```
