hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:Cluster a owl:Class .
hpc:Resource a owl:Class .
hpc:Dynamicresource a owl:Class .
hpc:hasResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Resource .
hpc:providesResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Host .
hpc:hasGroup rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Hostgroup .
hpc:isInCluster rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cluster .
hpc:hasResourceRequirement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:hasClusterRequirement rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
