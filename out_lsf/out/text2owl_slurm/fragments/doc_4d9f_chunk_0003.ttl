hpc:Api a owl:Class .
hpc:function a owl:ObjectProperty ;
    rdfs:domain hpc:Api ;
    rdfs:range xsd:array .

hpc:Errorcode a owl:Class .

hpc:Jobarray a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray .

hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Jobarray .

hpc:stdinfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .
hpc:stdoutfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .
hpc:stderrfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:fileformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:slurmArrayJobId a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray .
hpc:slurmArrayTaskId a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray .

hpc:scancelcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray .

hpc:scanceljobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Scancelcommand .
hpc:scancelarrayid a owl:DatatypeProperty ;
    rdfs:domain hpc:Scancelcommand .

hpc:squeuecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarray .

hpc:Jobrecord a owl:Class .
