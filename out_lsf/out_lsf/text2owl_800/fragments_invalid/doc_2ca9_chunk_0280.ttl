hpc:LsfPamCleanJobDelay rdfs:subClassOf hpc:Deprecatedparameter .
hpc:LsfPamHostlistUse rdfs:subClassOf hpc:Deprecatedparameter .
hpc:LsfPamPlugindir rdfs:subClassOf hpc:Deprecatedparameter .
