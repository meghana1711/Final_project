hpc:Userspecifiedhostfile a owl:Class .
hpc:hashost a owl:ObjectProperty .
hpc:Hashost rdfs:domain hpc:Userspecifiedhostfile ;
                 rdfs:range xsd:string .
hpc:hasslots a owl:DatatypeProperty .
hpc:Hasslots rdfs:domain hpc:Userspecifiedhostfile ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Hostname a owl:Class .
hpc:Hostname rdfs:subClassOf xsd:string .
hpc:Hostname@ClusterName a owl:Class ;
                rdfs:subClassOf hpc:Hostname .
hpc:hascluster a owl:DatatypeProperty .
hpc:Hascluster rdfs:domain hpc:Hostname@ClusterName ;
                 rdfs:range xsd:string .
hpc:slotnumber a owl:DatatypeProperty .
hpc:Slotnumber rdfs:domain hpc:Userspecifiedhostfile ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:Userspecifiedhostfilewithslots a owl:Class ;
                 rdfs:subClassOf hpc:Userspecifiedhostfile .
hpc:Userspecifiedhostfilewithslots rdfs:subClassOf
                 (union (hpc:UserSpecifiedHostFile [hpc:hasSlots someValue (xsd:nonNegativeInteger)]
                        (hpc:UserSpecifiedHostFile [hpc:hasSlots null])) .
