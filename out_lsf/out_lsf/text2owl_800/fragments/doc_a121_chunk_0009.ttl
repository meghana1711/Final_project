hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:userid a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .
hpc:status a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Statustype .
hpc:Queue a owl:Class .
hpc:priority a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:integer .
hpc:submissiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:fromhost a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobsummary a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Alljobs a owl:Class ;
    rdfs:subClassOf hpc:Jobsummary .
hpc:Userjobs a owl:Class ;
    rdfs:subClassOf hpc:Jobsummary ;
    rdfs:subClassOf hpc:Jobsummary .
hpc:Specificuserjobs a owl:Class ;
    rdfs:subClassOf hpc:Userjobs ;
    rdfs:subClassOf hpc:Jobsummary .
hpc:localjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:srcjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:srcclustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
