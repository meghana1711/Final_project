hpc:Ssd a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:ssdMax a owl:DatatypeProperty ;
    rdfs:domain hpc:Ssd ;
    rdfs:range xsd:decimal .

hpc:ssdStorage a owl:ObjectProperty ;
    rdfs:domain hpc:Ssd ;
    rdfs:range hpc:SsdStorage .

hpc:lsbStageStorage a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:decimal .

hpc:lsbStageTransferRate a owl:DatatypeProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:decimal ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LsfDatamanager a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:lsfDatamanagerFile a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range hpc:LsfDatamanager .

hpc:lsfDatamanagerLocation a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range rdf:Resource .

hpc:LsfDatamanagerStructure a owl:Class ;
    rdfs:subClassOf owl:Resource .

hpc:lsfDatamanagerClusterName a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfDatamanagerStructure ;
    rdfs:range xsd:string .

hpc:lsfDatamanagerParameters a owl:ObjectProperty ;
    rdfs:domain hpc:LsfDatamanagerStructure ;
    rdfs:range hpc:LsfDatamanagerParametersSection .

hpc:LsfDatamanagerParametersSection a owl:Class ;
    rdfs:subClassOf owl:Resource .
