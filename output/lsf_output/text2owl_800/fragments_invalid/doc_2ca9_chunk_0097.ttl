hpc:Containersupport a owl:Class .
hpc:Dockerentrypointimage a owl:Class ;
    rdfs:subClassOf hpc:Containersupport .

hpc:lsbDockerPlaceHolder a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerentrypointimage ;
    rdfs:range rdf:Literal .

hpc:Dockerjob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Applicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Configurableentity .

hpc:Watchedapplicationprofile a owl:Class ;
    rdfs:subClassOf hpc:Applicationprofile .

hpc:watchdog a owl:ObjectProperty ;
    rdfs:domain hpc:Watchedapplicationprofile ;
    rdfs:range hpc:Watchdogprofile .

hpc:Watchdogprofile a owl:Class .

hpc:lsfAcPncUrl a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfiguration .
    rdfs:range xsd:anyURI .

hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Configurableentity .

hpc:Configurableentity a owl:Class .
