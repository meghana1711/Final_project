    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:chargedsaap a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:path a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:command a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:preexeccommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:postexeccommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:resizenotificationcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:pids a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:exitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
