hpc:Credentialreplayederror rdfs:domain hpc:Slurmddaemon ;
    rdfs:range hpc:Credentialreplayed .
hpc:Symbolnotfounderror rdfs:domain hpc:Slurmdaemon ;
    rdfs:range hpc:Symbolnotfound .
hpc:Backtracetype rdfs:domain hpc:Gdb ;
