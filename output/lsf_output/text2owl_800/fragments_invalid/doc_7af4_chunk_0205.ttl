hpc:User a owl:Class .
hpc:Username hpc:datatypeproperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

hpc:Usergroup hpc:datatypeproperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:string .

hpc:Limit a owl:Class .
hpc:Hasuser hpc:objectproperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:User .

hpc:Project a owl:Class .
hpc:Projectname hpc:datatypeproperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Projects hpc:objectproperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range rdf:List .

hpc:Project hpc:subclassof hpc:Projects .
