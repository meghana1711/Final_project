hpc:LmLicenseName a owl:Class .
hpc:ClusterDistribution a owl:Class .

hpc:hasLicenseName rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:LmLicenseName ;
  rdfs:range xsd:string .

hpc:supportsClusterDistribution rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:boolean .

hpc:configurationTemplate rdf:type owl:Class .
hpc:configurationFile rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:Configurationtemplate ;
  rdfs:range xsd:string .

hpc:installationPackage rdf:type owl:Class .
hpc:includesFile rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:Installationpackage ;
  rdfs:range xsd:string .

hpc:usesDefaultConfiguration rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:boolean .

hpc:ignoresUnsupportedParameters rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:boolean .

hpc:backupConfigurationFile rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:string .

hpc:moveConfigurationFile rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:string .

hpc:renameConfigurationFile rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:string .

hpc:startLicenseScheduler rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range xsd:string .

hpc:lsfLicenseSchedHosts a owl:DatatypeProperty .
hpc:hasLSF_LIC_SCHED_HOSTS rdf:type owl:ObjectProperty ;
  rdfs:domain hpc:ClusterDistribution ;
  rdfs:range hpc:LsfLicenseSchedHosts .
