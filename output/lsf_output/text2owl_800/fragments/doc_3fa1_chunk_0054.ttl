hpc:Fairsharequeue a owl:Class .
hpc:Highpriorityqueue a owl:Class .
hpc:Lowpriorityqueue a owl:Class .
hpc:Pool a owl:Class .
hpc:Queuepool a owl:Class .
hpc:jobslotallocation a owl:ObjectProperty .
hpc:jobslotlimit a owl:DatatypeProperty .
hpc:jobslotratio a owl:DatatypeProperty .
hpc:Jobslotallocation rdfs:domain hpc:Fairsharequeue ;
                        rdfs:range hpc:Jobslotallocation .
hpc:Jobslotlimit rdfs:domain hpc:Fairsharequeue ;
                  rdfs:range xsd:decimal .
hpc:Jobslotratio rdfs:domain hpc:Fairsharequeue ;
                 rdfs:range xsd:decimal .
hpc:Shareswithinpool rdfs:domain hpc:Pool ;
                     rdfs:range xsd:decimal .
