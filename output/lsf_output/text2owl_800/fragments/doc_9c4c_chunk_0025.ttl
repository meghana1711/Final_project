hpc:Resource a owl:Class .
hpc:Resource rdfs:subClassOf owl:Class .

hpc:resourcename a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:interval a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:integer .

hpc:increasing a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .

hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

# Specific shared resources
hpc:Slurm a hpc:Resource ;
    hpc:ResourceName "slurm" ;
    hpc:Type "Boolean" ;
    hpc:Interval "" ;
    hpc:Increasing "" ;
    hpc:Description "SLURM" .

# ... (Repeat the above pattern for each resource in the documentation)

# Service ports
hpc:Serviceport a owl:Class .
hpc:Serviceport rdfs:subClassOf owl:Class .

hpc:portnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Serviceport ;
    rdfs:range xsd:integer .

hpc:usedbyservice a owl:ObjectProperty ;
    rdfs:domain hpc:Serviceport ;
    rdfs:range rdf:Resource .

# ... (Repeat the above pattern for each service port if needed)
