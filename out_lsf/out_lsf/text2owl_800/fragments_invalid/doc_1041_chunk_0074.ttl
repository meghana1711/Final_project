@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Stop a owl:Class .
hpc:View a owl:Class .
hpc:View rdfs:subClassOf hpc:Stop .
hpc:View rdfs:subClassOf rdf:Resource .

hpc:hasjsondata a owl:ObjectProperty .
hpc:Hasjsondata rdfs:domain hpc:View .
hpc:Hasjsondata rdfs:range rdf:XMLLiteral .

hpc:numquerieshandledbymbatchd a owl:DatatypeProperty .
hpc:Numquerieshandledbymbatchd rdfs:domain hpc:View .
hpc:Numquerieshandledbymbatchd rdfs:range xsd:nonNegativeInteger .

hpc:numqueriesforjobs a owl:DatatypeProperty .
hpc:Numqueriesforjobs rdfs:domain hpc:View .
hpc:Numqueriesforjobs rdfs:range xsd:nonNegativeInteger .

hpc:numqueriesforqueues a owl:DatatypeProperty .
hpc:Numqueriesforqueues rdfs:domain hpc:View .
hpc:Numqueriesforqueues rdfs:range xsd:nonNegativeInteger .

hpc:numqueriesforhosts a owl:DatatypeProperty .
hpc:Numqueriesforhosts rdfs:domain hpc:View .
hpc:Numqueriesforhosts rdfs:range xsd:nonNegativeInteger .

hpc:numjobssubmitted a owl:DatatypeProperty .
hpc:Numjobssubmitted rdfs:domain hpc:View .
hpc:Numjobssubmitted rdfs:range xsd:nonNegativeInteger .

hpc:numjobsdispatched a owl:DatatypeProperty .
hpc:Numjobsdispatched rdfs:domain hpc:View .
hpc:Numjobsdispatched rdfs:range xsd:nonNegativeInteger .

hpc:numjobsreordered a owl:DatatypeProperty .
hpc:Numjobsreordered rdfs:domain hpc:View .
hpc:Numjobsreordered rdfs:range xsd:nonNegativeInteger .

hpc:numjobscompleted a owl:DatatypeProperty .
hpc:Numjobscompleted rdfs:domain hpc:View .
hpc:Numjobscompleted rdfs:range xsd:nonNegativeInteger .

hpc:numjobssenttoremotecluster a owl:DatatypeProperty .
hpc:Numjobssenttoremotecluster rdfs:domain hpc:View .
hpc:Numjobssenttoremotecluster rdfs:range xsd:non
