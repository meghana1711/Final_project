hpc:User a owl:Class .
hpc:Securitylevel a owl:Class .
hpc:Job a owl:Class .
hpc:sameuserjob a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:groupjob a owl:ObjectProperty ;
    rdfs:domain hpc:User ;
    rdfs:range hpc:Job .
hpc:summaryinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:detailinfo a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:securejobinfolevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Securitylevel ;
    rdfs:range xsd:integer .
hpc:secureinfodiruseraccess a owl:DatatypeProperty ;
    rdfs:domain hpc:Securitylevel ;
    rdfs:range xsd:string .
hpc:Adminrights a owl:Class ;
    rdfs:subClassOf hpc:User .
hpc:enablejobinfobyadminrole a owl:ObjectProperty ;
    rdfs:domain hpc:Adminrights ;
    rdfs:range xsd:string .
hpc:secureinfodiruseraccesscontrol a owl:ObjectProperty ;
    rdfs:domain hpc:Securitylevel ;
    rdfs:range xsd:string .
hpc:Usergroupadminrights a owl:Class ;
    rdfs:subClassOf hpc:Adminrights .
hpc:Queueadminrights a owl:Class ;
    rdfs:subClassOf hpc:Adminrights .
hpc:Clusteradminrights a owl:Class ;
    rdfs:subClassOf hpc:Adminrights .
hpc:SecureJobInfoLevel_0 a hpc:SecurityLevel ;
    hpc:SecureJobInfoLevel "0" .
hpc:SecureJobInfoLevel_1 a hpc:SecurityLevel ;
    hpc:SecureJobInfoLevel "1" .
hpc:SecureJobInfoLevel_2 a hpc:SecurityLevel ;
    hpc:SecureJobInfoLevel "2" .
hpc:SecureJobInfoLevel_5 a hpc:SecurityLevel ;
    hpc:SecureJobInfoLevel "5" .
hpc:SecureInfoDirUserAccess_G a hpc:SecureInfoDirUserAccessControl ;
    hpc:SecureInfoDirUserAccess "G" .
hpc:SecureInfoDirUserAccess_Y a hpc:SecureInfoDirUserAccessControl ;
    hpc:SecureInfoDirUserAccess "Y" .
