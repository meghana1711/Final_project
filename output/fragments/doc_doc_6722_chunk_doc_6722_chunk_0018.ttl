hpc:Job a owl:Class .
hpc:BurstBuffer a owl:Class .
hpc:PreRunFailure a owl:Class .
hpc:TeardownFailure a owl:Class .
hpc:RunningState a owl:Class .
hpc:StagingOutState a owl:Class .
hpc:TeardownFailState a owl:Class .
hpc:hasConfiguringFlag a owl:ObjectProperty .
hpc:hasJobState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:RunningState .
hpc:hasBurstBufferState rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range (hpc:RunningState | hpc:StagingOutState | hpc:TeardownFailState) .
hpc:starts rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:RunningState ;
    rdfs:range hpc:RunningState .
hpc:completes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:RunningState ;
    rdfs:range hpc:StagingOutState .
hpc:fails rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:RunningState ;
    rdfs:range hpc:TeardownFailState .
hpc:retries rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:TeardownFailState ;
    rdfs:range xsd:integer .
hpc:isConfigured rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
hpc:isRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
hpc:isTeardownRunning rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
hpc:isHold rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isKilled rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isSkipped rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:isSaved rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
hpc:isRestarted rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:BurstBuffer ;
    rdfs:range xsd:boolean .
```
