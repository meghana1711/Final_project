hpc:CLIJobComponent a owl:Class .
hpc:hasOptions a owl:ObjectProperty ;
    rdfs:domain hpc:CLIJobComponent ;
    rdfs:range rdf:Property .

hpc:hetjobOffset a owl:DatatypeProperty ;
    rdfs:domain hpc:CLIJobComponent ;
    rdfs:range xsd:integer .

hpc:CLIJob a owl:Class .
hpc:hasId a owl:ObjectProperty ;
    rdfs:domain hpc:CLIJob ;
    rdfs:range xsd:integer .

hpc:hasStepId a owl:DatatypeProperty ;
    rdfs:domain hpc:CLIJob ;
    rdfs:range xsd:integer .

hpc:CLIFilterPlugin a owl:Class .
hpc:isImplementedInLua a owl:ObjectProperty ;
    rdfs:domain hpc:CLIFilterPlugin ;
    rdfs:range rdf:Boolean .

hpc:CLICommand a owl:Class .
hpc:isForJobSubmission a owl:ObjectProperty ;
    rdfs:domain hpc:CLICommand ;
    rdfs:range rdf:Boolean .

hpc:CLIComponent a owl:Class .
hpc:isForCluster a owl:ObjectProperty ;
    rdfs:domain hpc:CLIComponent ;
    rdfs:range rdf:Literal .
```
