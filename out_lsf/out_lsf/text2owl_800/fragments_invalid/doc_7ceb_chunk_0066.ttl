hpc:ELIM
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Element that overrides index values in LIM." .

hpc:index
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lim ;
    rdfs:range xsd:string ;
    rdfs:comment "Index value of a LIM instance." .

hpc:name
    a owl:ObjectProperty ;
    rdfs:domain hpc:Elim ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the index overridden by an ELIM instance." .

hpc:lsfShared
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "File containing shared configuration for LSF." .

hpc:username
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Username involved in an authRequest." .

hpc:host
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Host involved in an authRequest." .

hpc:port
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port involved in an authRequest." .

hpc:uid
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:integer ;
    rdfs:comment "User ID involved in an authRequest." .

hpc:clname
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Client name involved in an authRequest." .

hpc:clhost
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Client host involved in an authRequest." .

hpc:lname
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Authrequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Local name involved in an authRequest." .

hpc:respath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Rescontrol ;
    rdfs:range xsd:string ;
    rdfs:comment "Path to the file to be re-executed by the RES." .

hpc:jobId
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Renewjob ;
    rdfs:range xsd:string ;
    rdfs:comment "ID of the job involved in a renewJob." .

hpc:from
