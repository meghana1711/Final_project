hpc:TaskByDefault a owl:Class .
hpc:DefaultNodeCount owl:DatatypeProperty ;
    rdfs:domain hpc:TaskByDefault ;
    rdfs:range xsd:integer .

hpc:SrunCommand a owl:Class .
hpc:NodeCount owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:integer .
hpc:NodeRangeExpression owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:string .
hpc:WorkingNode owl:ObjectProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:string .
hpc:OutputFile owl:DatatypeProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:string .
hpc:Timelimit owl:DatatypeProperty ;
    rdfs:domain hpc:SrunCommand ;
    rdfs:range xsd:string .

hpc:ScriptSubmission a owl:Class .
hpc:ScriptName owl:DatatypeProperty ;
    rdfs:domain hpc:ScriptSubmission ;
    rdfs:range xsd:string .
hpc:Nodes owl:ObjectProperty ;
    rdfs:domain hpc:ScriptSubmission ;
    rdfs:range xsd:string .
hpc:TasksPerNode owl:DatatypeProperty ;
    rdfs:domain hpc:ScriptSubmission ;
    rdfs:range xsd:integer .
hpc:OutputFileScript owl:DatatypeProperty ;
    rdfs:domain hpc:ScriptSubmission ;
    rdfs:range xsd:string .

hpc:JobStep a owl:Class .
hpc:Command owl:ObjectProperty ;
    rdfs:domain hpc:JobStep ;
    rdfs:range xsd:string .
hpc:SequentialExecution owl:ObjectProperty ;
    rdfs:domain hpc:JobStep ;
    rdfs:range xsd:boolean .
