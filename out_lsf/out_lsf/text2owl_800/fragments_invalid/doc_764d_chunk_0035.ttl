hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Normaljob ;
    rdfs:comment "A job that does not specify a reservation." .

hpc:Reservedjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that specifies a reservation." .

hpc:Reservation a owl:Class ;
    rdfs:subClassOf rdf:Resource ;
    rdfs:comment "A time-bound allocation of resources." .

hpc:hasreservation hpc:reservation a owl:ObjectProperty ;
    rdfs:domain hpc:Reservedjob ;
    rdfs:range hpc:Reservation ;
    rdfs:comment "The reservation associated with a job." .

hpc:isactivereservation boolean a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the reservation is currently active." .

hpc:isexpiredreservation boolean a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the reservation has expired." .

hpc:isdeletedreservation boolean a owl:DatatypeProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the reservation has been deleted." .

hpc:Psuspstate a owl:Class ;
    rdfs:subClassOf hpc:Jobstate ;
    rdfs:comment "The state of a job that has a specified reservation that has expired or been deleted." .

hpc:Detachedstate a owl:Class ;
    rdfs:subClassOf hpc:Jobstate ;
    rdfs:comment "The state of a job that was detached from its reservation." .

hpc:Brokenconnection a owl:Class ;
    rdfs:subClassOf hpc:Clusterissue ;
    rdfs:comment "A state indicating that cluster connectivity is interrupted." .

hpc:hasremotereservation hpc:reservation a owl:ObjectProperty ;
    rdfs:domain hpc:Reservedjob ;
    rdfs:range hpc:Reservation ;
    rdfs:comment "The remote reservation associated with a job." .

hpc:isaffectedbyremotetimeout boolean a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job is affected by the remote timeout limit." .

hpc:haspendingreason rdf:PlainLiteral a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "The reason a job is in the pending state." .
