hpc:Jobsubmissionfile a owl:Class .
hpc:Jobrequest a owl:Class .

hpc:Hasjobrequest hpc:jobsubmissionfile owl:ObjectProperty .
hpc:Jobrequest hpc:jobrequest .

hpc:Jobrequestfile rdfs:domain hpc:Jobsubmissionfile ;
    rdfs:range xsd:string .

hpc:Jobrequestsyntax rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:string .

hpc:Jobrequestline rdfs:subClassOf hpc:Jobrequest ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:string .

hpc:Jobrequestlinesyntax rdfs:domain hpc:Jobrequestline ;
    rdfs:range xsd:string .

hpc:Jobrequestresource rdfs:domain hpc:Jobrequest ;
    rdfs:range rdf:Resource .

hpc:Jobrequestresourcetype rdfs:domain hpc:Jobrequestresource ;
    rdfs:range xsd:string .

hpc:Jobrequestresourceoption rdfs:domain hpc:Jobrequestresource ;
    rdfs:range xsd:string .

hpc:Jobrequestresourceoptionname rdfs:domain hpc:Jobrequestresourceoption ;
    rdfs:range xsd:string .

hpc:Jobrequestresourceoptionvalue rdfs:domain hpc:Jobrequestresourceoption ;
    rdfs:range xsd:string .

hpc:Jobrequestresourceoptionrequired rdfs:domain hpc:Jobrequestresourceoption ;
    rdfs:range xsd:boolean .
