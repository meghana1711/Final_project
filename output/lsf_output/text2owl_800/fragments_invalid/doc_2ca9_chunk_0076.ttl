hpc:UsePamCreds a owl:Class .
hpc:Lsf a owl:Class .
hpc:Linuxpamservice a owl:Class .
hpc:lsf a hpc:LinuxPAMService ;
    rdfs:label "lsf" ;
    rdfs:comment "Linux PAM service for LSF" .
hpc:lsf_clustername a hpc:LinuxPAMService ;
    rdfs:label "lsf-<clustername>" ;
    rdfs:comment "Linux PAM service for LSF with cluster name" .
hpc:USE_PAM_CREDS_y a hpc:USE_PAM_CREDS ;
    rdfs:label "USE_PAM_CREDS=y" ;
    rdfs:comment "LSF uses PAM limits when job is dispatched to a Linux host" .
hpc:USE_PAM_CREDS_limits a hpc:USE_PAM_CREDS ;
    rdfs:label "USE_PAM_CREDS=limits" ;
    rdfs:comment "LSF uses defined limits when job is dispatched to a Linux host" .
hpc:USE_PAM_CREDS_session a hpc:USE_PAM_CREDS ;
    rdfs:label "USE_PAM_CREDS=session" ;
    rdfs:comment "LSF creates Linux PAM service 'lsf-<clustername>' for session" .
hpc:USE_PAM_CREDS_limits_session a hpc:USE_PAM_CREDS ;
    rdfs:label "USE_PAM_CREDS=limits session" ;
    rdfs:comment "LSF creates both 'lsf' and 'lsf-<clustername>' Linux PAM services" .
hpc:assumes a owl:ObjectProperty ;
    rdfs:domain hpc:UsePamCreds ;
    rdfs:range hpc:Linuxpamservice .
hpc:checks a owl:ObjectProperty ;
    rdfs:domain hpc:Linuxpamservice ;
    rdfs:range hpc:Job .
hpc:JobGroupLimits a owl:Class ;
    rdfs:label "Job group limits" ;
    rdfs:comment "Limits applied to job groups" .
hpc:ForwardedJob a owl:Class ;
    rdfs:label "Forwarded job" ;
    rdfs:comment "Job forwarded to another cluster" .
hpc:GLOBAL_LIMITS a xsd:boolean ;
    rdfs:label "GLOBAL_LIMITS" ;
    rdfs:comment "Enables job group limits for forwarded jobs" .
hpc:Gpolicyd a owl:Class ;
    rdfs:label "global policy daemon (gpolicyd)" ;
    rdfs:comment "Responsible for applying job group limits to forwarded jobs" .
hpc:LSB_GPD_PORT a xsd:string ;
    rdfs:label "LSB_GPD_PORT" ;
    rdfs:comment "Parameter for gpolicyd" .
hpc:LSB_GPD_CLUSTER a xsd:string ;
    rdfs:label "LSB_GPD_CLUSTER" ;
    r
