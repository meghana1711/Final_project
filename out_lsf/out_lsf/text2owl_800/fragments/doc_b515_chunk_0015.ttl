hpc:JobrequirementStartonhost rdfs:range xsd:string .

hpc:jobrequirementCanstartonhost a owl:DatatypeProperty .
hpc:JobrequirementCanstartonhost rdfs:domain hpc:Jobrequirement .
hpc:JobrequirementCanstartonhost rdfs:range xsd:string .

hpc:jobrequirementMuststartonhost a owl:DatatypeProperty .
hpc:JobrequirementMuststartonhost rdfs:domain hpc:Jobrequirement .
hpc:JobrequirementMuststartonhost rdfs:range xsd:string .

hpc:firstexecutionhostJobslotreservation a owl:ObjectProperty .
hpc:FirstexecutionhostJobslotreservation rdfs:domain hpc:Firstexecutionhost .
hpc:FirstexecutionhostJobslotreservation rdfs:range hpc:Jobslot .

hpc:computeunitPriority a owl:ObjectProperty .
