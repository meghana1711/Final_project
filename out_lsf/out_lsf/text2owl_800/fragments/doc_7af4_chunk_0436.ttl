hpc:Gpackpolicysort a owl:Class .
hpc:hashigherpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Gpackpolicysort ;
    rdfs:range hpc:Gpackpolicysort .

hpc:Lsfsort a owl:Class ;
    rdfs:subClassOf hpc:Sort .

hpc:sortbygpus a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsort ;
    rdfs:range hpc:Sortbygpusorder .

hpc:Sortbygpusorder a owl:Class .

hpc:sortbydockeraffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfsort ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .

hpc:GPUVendor a owl:Enum ;
    rdfs:member "amd" ;
    rdfs:member "nvidia" .

hpc:Gpumodel a owl:Class .
hpc:hasmodelname a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:string .
hpc:hasmemory a owl:DatatypeProperty ;
    rdfs:domain hpc:Gpumodel ;
    rdfs:range xsd:nonNegativeInteger .

hpc:gpack a owl:ObjectProperty ;
    rdfs:domain hpc:Gpackpolicysort ;
    rdfs:range hpc:Gpu .

hpc:allocatesgpus a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Gpack .

hpc:Job a owl:Class .

hpc:hasgpuvendor a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Gpuvendor .

hpc:hasgpumodel a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Gpumodel .

hpc:gpackDefault a owl:NamedIndividual ;
    hpc:allocatesGPUs 0 ;
    hpc:hasGPUVendor "nvidia" .

hpc:gvendorDefault a owl:NamedIndividual ;
    hpc:hasGPUVendor "nvidia" .
