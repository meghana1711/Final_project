hpc:Application a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Global a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:Resource a owl:Class .

hpc:precedence a owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Resource .

hpc:delay a owl:DatatypeProperty ;
    rdfs:domain hpc:Application, hpc:Queue ;
    rdfs:range xsd:positiveInteger .

hpc:maxjobs a owl:DatatypeProperty ;
    rdfs:domain hpc:Application, hpc:Queue ;
    rdfs:range xsd:positiveInteger .

hpc:Plan a owl:Class .

hpc:Planparameter a owl:Class .

hpc:Slotreserve rdfs:subClassOf hpc:Planparameter .
hpc:Resourcereserve rdfs:subClassOf hpc:Planparameter .

hpc:postexec a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .

hpc:postexeccommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Postexec ;
    rdfs:range xsd:string .

hpc:Requeueexitvalues a owl:Class .

hpc:lsbjobpend a owl:DatatypeProperty ;
    rdfs:domain hpc:Requeueexitvalues ;
    rdfs:range xsd:string .

hpc:lsbprepostexecuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
