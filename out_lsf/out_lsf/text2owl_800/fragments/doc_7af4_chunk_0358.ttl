hpc:Job a owl:Class .
hpc:ClosedBusyHost a owl:Class .
hpc:CandidateHost a owl:Class .
hpc:PreemptableRunningJob a owl:Class .
hpc:Reservation a owl:Class .

hpc:hasjob a owl:ObjectProperty ;
    rdfs:domain hpc:ClosedBusyHost ;
    rdfs:range hpc:Job .

hpc:iscandidate a owl:ObjectProperty ;
    rdfs:domain hpc:ClosedBusyHost ;
    rdfs:range hpc:CandidateHost .

hpc:haspreemptablerunningjob a owl:ObjectProperty ;
    rdfs:domain hpc:CandidateHost ;
    rdfs:range hpc:PreemptableRunningJob .

hpc:makesreservation a owl:ObjectProperty ;
    rdfs:domain hpc:CandidateHost ;
    rdfs:range hpc:Reservation .

hpc:canruninfiveminutes a owl:ObjectProperty ;
    rdfs:domain hpc:Reservation ;
    rdfs:range xsd:boolean .

hpc:ispended a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:suspendspreemptivependingjobs a owl:ObjectProperty ;
    rdfs:domain hpc:PreemptableQueue ;
    rdfs:range xsd:boolean .

hpc:avoidsremovinghostsfromconsideration a owl:ObjectProperty ;
    rdfs:domain hpc:PreemptiveJob ;
    rdfs:range xsd:boolean .

hpc:GroupJlp a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:GroupMax a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:strictJobCount a owl:ObjectProperty ;
    rdfs:domain hpc:GroupJlp ;
    rdfs:domain hpc:GroupMax ;
    rdfs:range xsd:integer .

hpc:HostJlu a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:leastRunTime a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:time .
