hpc:Taskdefinition a owl:Class .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskdefinition ;
    rdfs:range xsd:duration .
hpc:Exitcode a owl:Class .
hpc:requeuesyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Taskdefinition ;
    rdfs:range xsd:string .
hpc:requeuelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Taskdefinition ;
    rdfs:range xsd:duration .
hpc:Task a owl:Class ;
    rdfs:subClassOf hpc:Taskdefinition .
hpc:SschedRequeueLimit rdfs:range xsd:duration .
hpc:Lsbfixpack a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:lsbfixPack15 rdf:type hpc:lsbfixPack ;
    hpc:RequeueSyntax "all ~exit_code ... | exit_code ..." .
hpc:Notifiedfailure a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:NoNotification rdf:type hpc:NotifiedFailure .
hpc:Savedoutput a owl:Class ;
    rdfs:subClassOf rdf:Resource .
hpc:NoSavedOutput rdf:type hpc:SavedOutput .
