hpc:User a owl:Class .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .

hpc:Job a owl:Class .
hpc:ischeckpointable a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:Checkpointablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:Applicationprofile a owl:Class .
hpc:associatedwith a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpointablejob ;
    rdfs:range hpc:Applicationprofile .

hpc:checkpoint a owl:ObjectProperty .
hpc:forced a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpoint .
    rdfs:range xsd:boolean .
hpc:forcescheckpoint a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint .
hpc:appliesto a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint .
    rdfs:range hpc:Applicationprofile .
hpc:checkpointsjob a owl:ObjectProperty ;
    rdfs:domain hpc:Checkpoint .
    rdfs:range hpc:Job .

hpc:Checkpointablejobstate a owl:Class .
hpc:isrunning a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejobstate ;
    rdfs:range xsd:boolean .
hpc:issuspended a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejobstate ;
    rdfs:range xsd:boolean .

hpc:Checkpointablejobstatetype a owl:Class ;
    rdfs:subClassOf hpc:Checkpointablejobstate .
hpc:iswaitstate a owl:DatatypeProperty ;
    rdfs:domain hpc:Checkpointablejobstatetype ;
    rdfs:range xsd:boolean .
