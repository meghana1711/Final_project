hpc:Slurmissuetracker a owl:Class ;
    rdfs:comment "The official issue tracker for Slurm." ;
    rdfs:seeAlso <https://support.schedmd.com/> .

hpc:Githubcontributions a owl:Class ;
    rdfs:comment "Represents the practice of contributing code to Slurm through GitHub." ;
    rdfs:subClassOf hpc:Nopullrequests .

hpc:Nopullrequests a owl:Class ;
    rdfs:comment "Represents the practice of not accepting Pull Requests through GitHub." .

hpc:Targetrele
