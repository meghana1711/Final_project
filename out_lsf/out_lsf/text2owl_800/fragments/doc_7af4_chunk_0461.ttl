hpc:Loadschedcondition a owl:Class .
hpc:Loadstopcondition a owl:Class .
hpc:Jobschedulingcondition a owl:Class .
hpc:Loadindex a owl:Class .
hpc:Column a owl:Class .

hpc:hasloadindex a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingcondition ;
    rdfs:range hpc:Loadindex .

hpc:hascolumn a owl:ObjectProperty ;
    rdfs:domain hpc:Loadindex ;
    rdfs:range hpc:Column .

hpc:andlogic a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingcondition ;
    rdfs:range hpc:Jobschedulingcondition .

hpc:orlogic a owl:ObjectProperty ;
    rdfs:domain hpc:Jobschedulingcondition ;
    rdfs:range hpc:Jobschedulingcondition .

hpc:io a hpc:LoadIndex ;
    rdf:label "io" .
hpc:it a hpc:LoadIndex ;
    rdf:label "it" .
hpc:ls a hpc:LoadIndex ;
    rdf:label "ls" .
hpc:mem a hpc:LoadIndex ;
    rdf:label "mem" .
hpc:pg a hpc:LoadIndex ;
    rdf:label "pg" .
hpc:r15s a hpc:LoadIndex ;
    rdf:label "r15s" .
hpc:r1m a hpc:LoadIndex ;
    rdf:label "r1m" .
hpc:r15m a hpc:LoadIndex ;
    rdf:label "r15m" .
hpc:swp a hpc:LoadIndex ;
    rdf:label "swp" .
hpc:tmp a hpc:LoadIndex ;
    rdf:label "tmp" .
hpc:ut a hpc:LoadIndex ;
    rdf:label "ut" .
hpc:custom a hpc:LoadIndex ;
    rdf:label "a non-shared custom external load index" .

hpc:memColumn a hpc:Column ;
    rdf:label "MEM" .
hpc:swapColumn a hpc:Column ;
    rdf:label "SWAP" .

hpc:Loadschedcondition rdfs:subClassOf hpc:Jobschedulingcondition .
hpc:Loadstopcondition rdfs:subClassOf hpc:Jobschedulingcondition .

hpc:Threshold rdfs:domain hpc:Loadindex ;
    rdfs:range xsd:decimal .
