hpc:Jobgroup a owl:Class .
hpc:hasjobgrouplimit a owl:ObjectProperty .
hpc:Hasjobgrouplimit rdfs:domain hpc:Jobgroup ;
                      rdfs:range xsd:nonNegativeInteger .
hpc:Jobslot a owl:Class .
hpc:isjobslotavailable a owl:DatatypeProperty ;
                        rdfs:range xsd:boolean .
hpc:Job a owl:Class ;
       rdfs:subClassOf hpc:Jobgroup .
hpc:Paralleljob a owl:Class ;
               rdfs:subClassOf hpc:Job ;
               rdfs:subClassOf hpc:Jobgroup .
hpc:Jobarray a owl:Class ;
             rdfs:subClassOf hpc:Jobgroup .
hpc:Jobgrouplimitexceeded a owl:Class .
hpc:Jobgrouplimitnotspecified a owl:Class .
hpc:Jobgrouplimitnotsupported a owl:Class .
hpc:Jobforwardedtoexecutioncluster a owl:Class .
hpc:Jobgrouphierarchy a owl:Class .
hpc:hasparentjobgroup a owl:ObjectProperty ;
                      rdfs:domain hpc:Jobgroup ;
                      rdfs:range hpc:Jobgroup .
hpc:haschildjobgroup a owl:ObjectProperty ;
                     rdfs:domain hpc:Jobgroup ;
                     rdfs:range hpc:Jobgroup .
hpc:jobgrouplimitnotexceeded a owl:ObjectProperty ;
                             rdfs:domain hpc:Jobgroup ;
                             rdfs:range xsd:boolean .
hpc:createjobgroup a owl:ObjectProperty ;
                    rdfs:domain hpc:User ;
                    rdfs:range hpc:Jobgroup .
