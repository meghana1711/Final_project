hpc:Reconfiguration a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The process of confirming or modifying the configuration." .

hpc:Unrecoverableerror a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "An error that cannot be recovered from during reconfiguration." .

hpc:hostsetupcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Reconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to set up a new host." .

hpc:Installationscriptdirectory a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The directory containing the LSF installation script." .

hpc:Rootuser a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "The user with root privileges." .

hpc:startlsf a owl:ObjectProperty ;
    rdfs:domain hpc:Reconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to start LSF on a new host." .

hpc:bctrldstart a owl:ObjectProperty ;
    rdfs:domain hpc:Startlsf ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to start a specific LSF service." .

hpc:bhostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Reconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to verify changes to the hosts." .

hpc:lshostscommand a owl:ObjectProperty ;
    rdfs:domain hpc:Reconfiguration ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to verify changes to the hosts." .

hpc:Unknownhosttype a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A host type or host model that is unknown during host verification." .

hpc:Defaulthostmodel a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:comment "A host type or host model that is set to the default during host verification." .
