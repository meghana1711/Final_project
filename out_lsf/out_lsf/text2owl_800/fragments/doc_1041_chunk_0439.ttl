hpc:Mbatchdaemon a owl:Class .
hpc:maxjobattasize a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:nonNegativeInteger .
hpc:messagedescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string ;
    rdfs:maxLength 512 .
hpc:messageindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:nonNegativeInteger .
hpc:maxjobmsgnum a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lsfmulticluster a owl:Class ;
    rdfs:subClassOf hpc:Mbatchdaemon .
hpc:notificationlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string ;
    rdfs:oneOf ( "INFO" "WARNING" "ERROR" "CRITICAL" ) .
hpc:lsfacpncurl a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string ;
    rdfs:maxLength 1024 .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string .
hpc:jobidindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string .
hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string ;
    rdfs:maxLength 4094 .
hpc:localjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Mbatchdaemon ;
    rdfs:range xsd:string .
