hpc:Timewindow a owl:Class .
hpc:dayofweek a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:nonNegativeInteger .
hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hastimewindow a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Timewindow .
hpc:User a owl:Class .
hpc:hasuser a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User .
hpc:timewindowstart a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:time .
hpc:timewindowend a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:time .
hpc:TimeWindowDefaultDay rdf:first hpc:DayOfWeek ;
    rdf:rest hpc:TimeWindowDefaultEveryDay .
hpc:TimeWindowDefaultEveryDay rdf:value xsd:7 .
hpc:TimeWindowDefaultMinute rdf:first xsd:0 .
hpc:TimeWindowStartOptional rdf:first hpc:Hour ;
    rdf:rest rdf:nil .
hpc:TimeWindowEndOptional rdf:first hpc:Hour ;
    rdf:rest rdf:nil .
hpc:TimeWindowMinuteOptional rdf:first hpc:Minute ;
    rdf:rest rdf:nil .
hpc:TimeWindowDayOptional rdf:first hpc:DayOfWeek ;
    rdf:rest rdf:nil .
hpc:TimeWindowSyntax rdf:value "xsd:time" .
hpc:TimeWindowStartEndSame rdf:value true .
