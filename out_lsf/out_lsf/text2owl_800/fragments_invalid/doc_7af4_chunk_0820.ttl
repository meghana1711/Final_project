@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Project a owl:Class .
hpc:Status a owl:Enum .
hpc:Queue a owl:Class .
hpc:interactivemode a owl:ObjectProperty .
hpc:command a owl:DatatypeProperty .
hpc:submittedfrom a owl:ObjectProperty .
hpc:runlimit a owl:DatatypeProperty .
hpc:stacklimit a owl:DatatypeProperty .
hpc:corelimit a owl:DatatypeProperty .
hpc:memlimit a owl:DatatypeProperty .
hpc:startedon a owl:DatatypeProperty .
hpc:resourceusagecollected a owl:DatatypeProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swap a owl:DatatypeProperty .
hpc:pgid a owl:DatatypeProperty .
hpc:pid a owl:DatatypeProperty .
hpc:schedulingparameters a owl:ObjectProperty .
hpc:r15s a owl:DatatypeProperty .
hpc:r1m a owl:DatatypeProperty .
hpc:r15m a owl:DatatypeProperty .
hpc:ut a owl:DatatypeProperty .
hpc:pg a owl:DatatypeProperty .
hpc:io a owl:DatatypeProperty .
hpc:ls a owl:DatatypeProperty .
hpc:it a owl:DatatypeProperty .
hpc:tmp a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:mem a owl:DatatypeProperty .
hpc:loadsched a owl:DatatypeProperty .
hpc:loadstop a owl:DatatypeProperty .
hpc:cpuspeed a owl:DatatypeProperty .
hpc:bandwidth a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:User rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf owl:Class .
hpc:Status rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf owl:Class .
hpc:Interactivemode rdfs:domain hpc:Job ;
                        rdfs:range xsd:boolean .
hpc:Command rdfs:domain hpc:Job ;
                        rdfs:range xsd:string .
hpc:Submittedfrom rdfs:domain hpc:Job ;
                        rdfs:range xsd:string .
hpc:Runlimit rdfs:domain hpc:Job ;
                        rdfs:
