hpc:Environmentfile a owl:Class .
hpc:patchinstall a owl:ObjectProperty .
hpc:Package a owl:Class .
hpc:lsfpath a owl:ObjectProperty .
hpc:installationdirectory a owl:DatatypeProperty .
hpc:backupdirectory a owl:DatatypeProperty .
hpc:historydirectory a owl:DatatypeProperty .
hpc:checkcompatibility a owl:ObjectProperty .
hpc:requiresenhancementpack a owl:ObjectProperty .
hpc:haspermission a owl:ObjectProperty .
hpc:listsoverwrittenfiles a owl:ObjectProperty .

hpc:Environmentfile rdfs:subClassOf owl:Class .
hpc:Patchinstall rdfs:domain hpc:Environmentfile ;
                     rdfs:range rdf:Property .
hpc:Package rdfs:subClassOf owl:Class .
hpc:Lsfpath rdfs:domain hpc:Environmentfile ;
                rdfs:range xsd:string .
hpc:Installationdirectory rdfs:domain hpc:Package ;
                      rdfs:range xsd:string .
hpc:Backupdirectory rdfs:domain hpc:Package ;
                rdfs:range xsd:string .
hpc:Historydirectory rdfs:domain hpc:Package ;
                rdfs:range xsd:string .
hpc:Checkcompatibility rdfs:domain hpc:Environmentfile ;
                      rdfs:range rdf:Resource .
hpc:Requiresenhancementpack rdfs:domain hpc:Package ;
                         rdfs:range rdf:Resource .
hpc:Haspermission rdfs:domain hpc:Package ;
                      rdfs:range xsd:boolean .
hpc:Listsoverwrittenfiles rdfs:domain hpc:Package ;
                          rdfs:range rdf:List .
