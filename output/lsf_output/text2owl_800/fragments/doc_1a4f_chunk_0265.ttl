hpc:Limit a owl:Class .
hpc:hasname a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:hasperuser a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:hasperqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:hasperhost a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:string .
hpc:hasmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range xsd:decimal .
hpc:hasswplimit a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range rdf:Resource .

hpc:Dependentresource a owl:Class .
hpc:isdependentof a owl:ObjectProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range hpc:Dependentresource .
