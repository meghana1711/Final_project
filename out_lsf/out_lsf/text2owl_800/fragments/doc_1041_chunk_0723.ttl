hpc:Jobscript a owl:Class ;
    rdfs:subClassOf hpc:Script ;
    rdfs:comment "An ASCII text file that is parsed and run as part of a job." .

hpc:jobscriptoption a owl:ObjectProperty ;
    rdfs:domain hpc:Jobscript ;
    rdfs:range hpc:Command .

hpc:Dockerjobscript a owl:Class ;
    rdfs:subClassOf hpc:Jobscript ;
    rdfs:comment "A Docker job script with a Docker entry point image, but no command." .

hpc:dockerjobscriptoption a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerjobscript ;
    rdfs:range hpc:Applicationprofile .

hpc:helpoption a owl:ObjectProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string ;
    rdfs:comment "Displays a description of the specified category, command option, or sub-option to stderr and exits." .
