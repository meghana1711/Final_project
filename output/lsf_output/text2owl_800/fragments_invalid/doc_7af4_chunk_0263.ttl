hpc:Ar a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "An Active Resource (AR) in the context of job scheduling." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A job that can be scheduled and executed in an Active Resource (AR)." .

hpc:RUNLIMIT an owl:DatatypeProperty ;
    rdfs:domain hpc:Ar ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum runtime limit for a job in an AR." .

hpc:endTime an owl:DatatypeProperty ;
    rdfs:domain hpc:Ar ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "The end time of an Active Resource (AR)." .

hpc:ineligiblePendingState an owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The state of a job or an AR when it cannot be dispatched due to RUNLIMIT or other reasons." .

hpc:eligiblePendingState an owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The state of a job that can be dispatched in an AR." .

hpc:ATTR_CREATE_USERS an owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List ;
    rdfs:comment "The users who can create host attributes for job affinity scheduling." .

hpc:ATTR_MAX_NUM an owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The maximum number of host attributes that can co-exist in the LSF cluster." .
