hpc:gpuruntimefactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:decimal .

hpc:enablegpuhistoricalruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean .

hpc:Gpuruntimefairshare a owl:Class .

hpc:preemptivescheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .

hpc:Gpupreemption a owl:Class ;
    rdfs:subClassOf hpc:Preemptivescheduling .

hpc:preemptableresources a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .

hpc:Generalgpulimit a owl:Class .

hpc:Limit a owl:Class ;
    rdfs:subClassOf hpc:Generalgpulimit .

hpc:resourcelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Limit ;
    rdfs:range rdf:List .

hpc:lsbgpunewsyntax a owl:ObjectProperty ;
    rdfs:domain hpc:Configuration ;
    rdfs:range xsd:string .
