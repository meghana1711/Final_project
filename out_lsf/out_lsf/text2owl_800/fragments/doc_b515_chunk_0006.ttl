hpc:Jobstarter a owl:Class ;
    rdfs:subClassOf hpc:Script ;
    rdfs:comment "A script configured into a queue as a job starter." .

hpc:Jobsubmission a owl:Class ;
    rdfs:subClassOf hpc:Task ;
    rdfs:comment "The act of submitting a parallel job to an HPC system." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf hpc:Jobsubmission ;
    rdfs:comment "A job that requires multiple slots to run." .

hpc:numberofslots a owl:DatatypeProperty ;
    rdfs:domain hpc:Paralleljob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The number of slots required to run a parallel job." .

hpc:jobstatus a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmission ;
    rdfs:range hpc:Jobstatustype ;
    rdfs:comment "The current status of a job submission." .

hpc:Jobstatustype a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "The possible statuses a job submission can have." .

hpc:parallelSchedBySlot a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether jobs are scheduled based on the number of available job slots instead of the number of CPUs." .

hpc:Queue a owl:Class ;
    rdfs:subClassOf hpc:System ;
    rdfs:comment "A system that manages job submissions and scheduling." .
