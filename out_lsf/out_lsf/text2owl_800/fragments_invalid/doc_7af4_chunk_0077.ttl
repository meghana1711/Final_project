@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:hostPreExec a owl:ObjectProperty ;
    rdfs:domain hpc:Application ;
    rdfs:range xsd:string ;
    rdfs:comment "Enables host-based pre-execution processing at the application level." .

hpc:jobCwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Current working directory (CWD) for the job in the application profile." .

hpc:JobCwdPattern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:JOB_CWD ;
                      rdf:type xsd:string ] .

hpc:JobIdPattern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:JOB_CWD ;
                      rdf:first hpc:%J ] .

hpc:JobGroupPattern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:JOB_CWD ;
                      rdf:first hpc:%JG ] .

hpc:JobIndexPattern a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:JOB_CWD ;
                      rdf:first hpc:%I ] .
