hpc:Cluster a owl:Class .
hpc:Job a owl:Class .
hpc:Executionclusterhost hpc:Cluster rdfs:subClassOf hpc:Cluster .
hpc:Hostgroup hpc:Cluster rdfs:subClassOf hpc:Cluster .
hpc:jobstate a owl:ObjectProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:User a owl:Class .
hpc:jobname a owl:DatatypeProperty .
hpc:Jobname rdfs:range xsd:string .
hpc:Clustername rdfs:domain hpc:Executionclusterhost ;
                      rdfs:domain hpc:Hostgroup .
hpc:Clustername rdfs:range xsd:string .
hpc:Jobstate rdfs:domain hpc:Job ;
                 rdfs:range rdf:Resource .
hpc:bhist a owl:ObjectProperty .
hpc:Bhist rdfs:domain hpc:Job ;
          rdfs:range rdf:Seq .
hpc:bhistData a owl:ObjectProperty .
hpc:BhistData rdfs:domain hpc:Job ;
          rdfs:range rdf:Seq .
hpc:bhistHostfile a owl:ObjectProperty .
hpc:BhistHostfile rdfs:domain hpc:Job ;
          rdfs:range xsd:string .
hpc:bhistGpu a owl:ObjectProperty .
hpc:BhistGpu rdfs:domain hpc:Job ;
          rdfs:range rdf:Seq .
hpc:Hostfile a owl:Class .
hpc:hostname a owl:DatatypeProperty .
hpc:Hostname rdfs:range xsd:string .
hpc:gpuid a owl:DatatypeProperty .
hpc:Gpuid rdfs:range xsd:string .
