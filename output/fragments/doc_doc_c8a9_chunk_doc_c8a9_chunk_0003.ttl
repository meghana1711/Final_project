hpc:MaximumDataSegmentSize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:MaximumVirtualMemorySize a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:JobAcctGatherType a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:JobAcctGatherType .

hpc:JobAcctGatherFrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:PreemptType a owl:Enum ;
    rdfs:subClassOf owl:EnumeratedClass ;
    rdf:first hpc:PreemptNone ;
    rdf:rest [ a owl:Enumeration ;
               rdf:value hpc:PreemptPartitionPrio ;
               rdf:value hpc:PreemptQOS ] .

hpc:PreemptMode a owl:Enum ;
    rdfs:subClassOf owl:EnumeratedClass ;
    rdf:first hpc:Off ;
    rdf:rest [ a owl:Enumeration ;
               rdf:value hpc:Suspend ;
               rdf:value hpc:Gang ] .

hpc:Job a owl:Class .
hpc:PreemptNone a owl:Class ;
    rdfs:subClassOf hpc:PreemptType .
hpc:PreemptPartitionPrio a owl:Class ;
    rdfs:subClassOf hpc:PreemptType .
hpc:PreemptQOS a owl:Class ;
    rdfs:subClassOf hpc:PreemptType .
hpc:Off a owl:Class ;
    rdfs:subClassOf hpc:PreemptMode .
hpc:Suspend a owl:Class ;
    rdfs:subClassOf hpc:PreemptMode .
hpc:Gang a owl:Class ;
    rdfs:subClassOf hpc:PreemptMode .
```
