hpc:Projectsection a owl:Class .
hpc:Project a owl:Class .
hpc:priority a owl:DatatypeProperty .
hpc:description a owl:ObjectProperty .

hpc:Projectsection rdfs:subClassOf owl:Class .
hpc:Project rdfs:subClassOf hpc:Projectsection .

hpc:Projectsection rdfs:domain rdf:Resource .
hpc:Project rdfs:domain rdf:Seq .

hpc:Priority rdfs:domain hpc:Project ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Description rdfs:domain hpc:Project ;
    rdfs:range xsd:string .

hpc:Projectsection hpc:hasproject hpc:Project ;
    rdfs:subPropertyOf rdf:list .

hpc:Projectsection hpc:haspriority hpc:Priority ;
    rdfs:subPropertyOf rdf:first .

hpc:Projectsection hpc:hasdescription hpc:Description ;
    rdfs:subPropertyOf rdf:rest .
