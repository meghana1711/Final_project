hpc:Clusterdistribution a owl:Class .
hpc:ClusterDistribution rdfs:domain hpc:Wanservicedomain ;
                          rdfs:range rdf:List .
hpc:Wanservicedomain a owl:Class .
hpc:hasdistribution a owl:ObjectProperty ;
                      rdfs:domain hpc:Clusterdistribution ;
                      rdfs:range hpc:Clustershareassignment .
hpc:Clustershareassignment a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:clusterMode a owl:ObjectProperty ;
                 rdfs:domain hpc:Licensefeature .
hpc:CLUSTER_MODE_Y a xsd:boolean .
hpc:CLUSTER_MODE_N a xsd:boolean .
