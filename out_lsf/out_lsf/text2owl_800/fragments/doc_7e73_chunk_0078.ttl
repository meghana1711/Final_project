hpc:Hostproviders a owl:Class .
hpc:hostProvidersJson rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostproviders ;
    rdfs:range xsd:string .

hpc:Azureprovconfig a owl:Class ;
    rdfs:subClassOf hpc:Hostproviders .

hpc:azureProvConfigJson rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Azureprovconfig ;
    rdfs:range xsd:string .

hpc:azureProvTemplatesJson rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Azureprovconfig ;
    rdfs:range xsd:string .

hpc:Lsfconfiguration a owl:Class .
hpc:updateLsfConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfiguration ;
    rdfs:range hpc:Lsfconfiguration .

hpc:Azurelsfconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Lsfconfiguration .

hpc:Resource a owl:Class .
hpc:reSOURCEName rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:type rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:interval rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .
hpc:increasing rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:boolean .
hpc:description rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range xsd:string .

hpc:Lsbrcexternalhostflag a owl:Class .
hpc:enableLsfResourceConnector rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbrcexternalhostflag ;
    rdfs:range xsd:boolean .
