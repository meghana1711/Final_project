hpc:Timewindow a owl:Class .
hpc:BeginTime a xsd:nonNegativeInteger .
hpc:EndTime a xsd:nonNegativeInteger .
hpc:Day a xsd:nonNegativeInteger .
hpc:Hour a xsd:nonNegativeInteger .
hpc:Minute a xsd:nonNegativeInteger .

hpc:Timewindow rdfs:subClassOf [ rdf:type owl:Class ;
                                   rdfs:subClassOf ( hpc:Hour-Hour rdf:type owl:Class ) ;
                                   rdfs:subClassOf ( hpc:Hour:Minute-Hour:Minute rdf:type owl:Class ) ;
                                   rdfs:subClassOf ( hpc:Day:Hour:Minute-Day:Hour:Minute rdf:type owl:Class ) ] .

hpc:Timewindow rdfs:domain hpc:Reservation .

hpc:Reservation a owl:Class .
hpc:policyname a owl:DatatypeProperty .
hpc:users a owl:ObjectProperty .
hpc:hosts a owl:ObjectProperty .
hpc:Rsvid a owl:Class .
hpc:User a owl:Class .
hpc:NCPUs a xsd:nonNegativeInteger .
hpc:rsvHosts a owl:ObjectProperty .
hpc:timeWindow a owl:DatatypeProperty .

hpc:Policyname rdfs:range xsd:string .
hpc:Users rdfs:domain hpc:Reservation .
hpc:Users rdfs:range hpc:Usergroup rdf:union hpc:User .
hpc:Hosts rdfs:domain hpc:Reservation .
hpc:Hosts rdfs:range hpc:Host rdf:union hpc:Hostgroup .
hpc:RsvHosts rdfs:domain hpc:Rsvid .
hpc:RsvHosts rdfs:range hpc:Host rdf:union hpc:Hostgroup .
hpc:TimeWindow rdfs:range hpc:Timewindow .
