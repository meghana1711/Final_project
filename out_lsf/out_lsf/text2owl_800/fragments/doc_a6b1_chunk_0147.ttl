hpc:Lsfcluster a owl:Class .
hpc:Egocluster a owl:Class .
hpc:Egobase a owl:Class .
hpc:Multiclustercapability a owl:Class .
hpc:Consumerpolicy a owl:Class .
hpc:Slotresource a owl:Class .
hpc:Loadindex a owl:Class .
hpc:Externalresource a owl:Class .

hpc:Hasmulticlustercapability rdfs:domain hpc:Lsfcluster ;
 rdfs:range hpc:Multiclustercapability .

hpc:Usesegobase rdfs:domain hpc:Lsfcluster ;
 rdfs:range hpc:Egobase .

hpc:Supportsleasemode rdfs:domain hpc:Multiclustercapability .

hpc:Hasconsumerpolicy rdfs:domain hpc:Lsfcluster ;
 rdfs:range hpc:Consumerpolicy .

hpc:Appliesto rdfs:domain hpc:Consumerpolicy ;
 rdfs:range hpc:Slotresource .

hpc:Hasloadindex rdfs:domain hpc:Multiclustercapability ;
 rdfs:range hpc:Loadindex .

hpc:Hasexternalresource rdfs:domain hpc:Multiclustercapability ;
 rdfs:range hpc:Externalresource .

hpc:Xterm a owl:Class .
hpc:xtermonleastloadedhost a owl:ObjectProperty .
hpc:Xtermonleastloadedhost rdfs:domain hpc:Xterm ;
 rdfs:range hpc:Lsfcluster .

hpc:startxterm a owl:ObjectProperty .
hpc:Startxterm rdfs:domain hpc:Xterm ;
 rdfs:range hpc:Lsfcluster .

hpc:xtermonapc a owl:ObjectProperty .
hpc:Xtermonapc rdfs:domain hpc:Xterm .

hpc:usesexceed a owl:ObjectProperty .
hpc:Usesexceed rdfs:domain hpc:Xterm ;
 rdfs:range hpc:Lsfcluster .

hpc:Setupexceed rdfs:domain hpc:Xterm ;
 rdfs:range hpc:Lsfcluster .

hpc:display a owl:DatatypeProperty .
hpc:Display rdfs:domain hpc:Xapplication ;
 rdfs:range xsd:string .

hpc:Xapplication a owl:Class .
