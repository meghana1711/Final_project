# MPICH
hpc:MPICH a owl:Class .

hpc:buildMethod a owl:ObjectProperty .
hpc:buildMethod rdfs:domain hpc:MPICH .
hpc:buildMethod rdfs:range rdf:Resource .

hpc:pmiVersion a owl:DatatypeProperty .
hpc:pmiVersion rdfs:domain hpc:MPICH .
hpc:pmiVersion rdfs:range xsd:string .

hpc:linkedWithSlurm a owl:ObjectProperty .
hpc:linkedWithSlurm rdfs:domain hpc:MPICH .
hpc:linkedWithSlurm rdfs:range rdf:Resource .

# Slurm Integration
hpc:SlurmIntegration a owl:Class .

hpc:usesSlurmAPI a owl:ObjectProperty .
hpc:usesSlurmAPI rdfs:domain hpc:SlurmIntegration .
hpc:usesSlurmAPI rdfs:range rdf:Boolean .

hpc:spawnsHydraDaemons a owl:ObjectProperty .
hpc:spawnsHydraDaemons rdfs:domain hpc:SlurmIntegration .
hpc:spawnsHydraDaemons rdfs:range rdf:Resource .

# MVAPICH2
hpc:MVAPICH2 a owl:Class .

hpc:builtWithSlurm a owl:ObjectProperty .
hpc:builtWithSlurm rdfs:domain hpc:MVAPICH2 .
hpc:builtWithSlurm rdfs:range rdf:Resource .

hpc:usesSlurmBootstrap a owl:ObjectProperty .
hpc:usesSlurmBootstrap rdfs:domain hpc:MVAPICH2 .
hpc:usesSlurmBootstrap rdfs:range rdf:Boolean .

hpc:usesCustomBootstrap a owl:ObjectProperty .
hpc:usesCustomBootstrap rdfs:domain hpc:MVAPICH2 .
hpc:usesCustomBootstrap rdfs:range rdf:Resource .
```
