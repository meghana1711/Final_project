hpc:Timewindow a owl:Class .
hpc:begintime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:time .
hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timewindow ;
    rdfs:range xsd:time .
hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .
hpc:Runwindow a owl:Class ;
    rdfs:subClassOf hpc:Timewindow .
hpc:Deadlineconstraintscheduling a owl:Class .
hpc:hastimewindow a owl:ObjectProperty ;
    rdfs:domain hpc:Deadlineconstraintscheduling ;
    rdfs:range hpc:Timewindow .
hpc:Timeformat a owl:Class .
hpc:day a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeformat ;
    rdfs:range xsd:nonNegativeInteger .
hpc:hour a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeformat ;
    rdfs:range xsd:nonNegativeInteger .
hpc:minute a owl:DatatypeProperty ;
    rdfs:domain hpc:Timeformat ;
    rdfs:range xsd:nonNegativeInteger .
