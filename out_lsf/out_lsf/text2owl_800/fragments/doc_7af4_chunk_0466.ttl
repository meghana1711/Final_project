hpc:Lsfjob a owl:Class .
hpc:maxRschedTime a owl:ObjectProperty .
hpc:memlimit a owl:ObjectProperty .

hpc:MaxRschedTime rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the maximum time a job can be scheduled before it is recalled." .

hpc:Memlimit rdfs:domain hpc:Lsfjob ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specifies the per-process resident size limit for all job processes." .

hpc:osmemorylimitenforcement a owl:ObjectProperty ;
    rdfs:domain hpc:Memlimit ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether OS memory limit enforcement is used." .

hpc:defaultmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The default memory limit if no job-level memory limit is specified." .

hpc:softmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The soft memory limit for a process." .

hpc:hardmemorylimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Memlimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The hard memory limit for a process." .

hpc:osmemorylimitenforcementmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Memlimit ;
    rdfs:range xsd:string ;
    rdfs:comment "The method used for OS memory limit enforcement." .
