hpc:Mcjobforwardingmode a owl:Class .
hpc:mcsortbysubmittime a owl:ObjectProperty .
hpc:useSuspSlots a owl:ObjectProperty .
hpc:Lsbqueue a owl:Class .
hpc:beginqueue a owl:ObjectProperty .
hpc:endqueue a owl:ObjectProperty .
hpc:queuename a owl:DatatypeProperty .
hpc:USE_SUSP_SLOTS_Y a xsd:string .
hpc:USE_SUSP_SLOTS_N a xsd:string .
hpc:lsbqueuesfile a owl:DatatypeProperty .
hpc:lsbQueues a owl:ObjectProperty .
hpc:defaultvalue a owl:DatatypeProperty .
hpc:eligiblePendinfoSnapshotInterval a owl:ObjectProperty .
hpc:UseSuspSlots rdfs:domain hpc:Mcjobforwardingmode ;
    rdfs:range [ xsd:string ] ;
    rdfs:subPropertyOf hpc:MCJobForwardingModeProperty .
hpc:Mcsortbysubmittime rdfs:domain hpc:Mcjobforwardingmode ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf hpc:MCJobForwardingModeProperty .
hpc:EligiblePendinfoSnapshotInterval rdfs:domain hpc:Mcjobforwardingmode ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf hpc:MCJobForwardingModeProperty .
hpc:Lsbqueue rdfs:subClassOf hpc:Queue .
hpc:Beginqueue rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSBQueueProperty .
hpc:Endqueue rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSBQueueProperty .
hpc:Queuename rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSBQueueProperty .
hpc:Lsbqueuesfile rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSBQueueProperty .
hpc:LsbQueues rdfs:domain hpc:Lsbconfiguration ;
    rdfs:range hpc:Lsbqueue ;
    rdfs:subPropertyOf hpc:LSBConfigurationProperty .
hpc:Defaultvalue rdfs:domain hpc:Lsbqueue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:LSBQueueProperty .
