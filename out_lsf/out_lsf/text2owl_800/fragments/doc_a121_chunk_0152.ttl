hpc:Administrator a owl:Class .
hpc:Queue a owl:Class .
hpc:Jobstarter a owl:Class .
hpc:Preexecutioncommand a owl:Class .
hpc:Lsbjob a owl:Class .
hpc:jobStarter a owl:ObjectProperty .
hpc:appliesto a owl:ObjectProperty .
hpc:hasexecutionenvironment a owl:ObjectProperty .
hpc:iscontrolledbylsf a owl:ObjectProperty .
hpc:Unix a owl:Class .
hpc:Windows a owl:Class .
hpc:Server2003 a owl:Class .
hpc:X64 a owl:Class .
hpc:Kornshell a owl:Class .
hpc:Dosshell a owl:Class .
hpc:userStarter a owl:DatatypeProperty .
hpc:JobStarter rdfs:domain hpc:Queue ;
    rdfs:range hpc:Jobstarter ;
    rdfs:subPropertyOf hpc:appliesTo .
hpc:Appliesto rdfs:domain hpc:Queue ;
    rdfs:range hpc:Lsbjob .
hpc:Hasexecutionenvironment rdfs:domain hpc:Jobstarter ;
    rdfs:range hpc:Kornshell .
hpc:Iscontrolledbylsf rdfs:domain hpc:Jobstarter ;
    rdfs:range hpc:Lsbjob .
hpc:Kornshell rdfs:subClassOf hpc:Unix .
hpc:Dosshell rdfs:subClassOf hpc:Windows .
hpc:Server2003 rdfs:subClassOf hpc:Windows .
hpc:X64 rdfs:subClassOf hpc:Server2003 .
hpc:UserStarter rdfs:domain hpc:Queue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:appliesTo .
hpc:Unix rdfs:subClassOf hpc:Os .
hpc:Windows rdfs:subClassOf hpc:Os .
hpc:OS rdf:type owl:Class .
