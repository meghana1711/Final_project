hpc:Task a owl:Class .
hpc:UserProcess rdf:type owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:Step rdf:type owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:Job rdf:type owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:Jobacctgatherplugin a owl:Class .
hpc:TRES rdf:type owl:Class .
hpc:tresusageintot a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:tresusageinmax a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:tresusageinmaxnode a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:tresusageinmaxtask a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .
hpc:TresUsageInMax rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:Tres .
hpc:jobacctgatherfrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobacctgatherplugin ;
    rdfs:range xsd:nonNegativeInteger .
hpc:acctFreq rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobacctgatherplugin ;
    rdfs:range xsd:nonNegativeInteger .
hpc:poll rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobacctgatherplugin ;
    rdfs:range xsd:boolean .
hpc:StepPoll rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobacctgatherplugin ;
    rdfs:range xsd:boolean .
hpc:Tres rdf:type owl:Class .
hpc:energy rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Tres ;
    rdfs:range xsd:string .
hpc:tresconsumptionbynode a owl:DatatypeProperty ;
    rdfs:domain hpc:Tres ;
    rdfs:range xsd:string .
