hpc:Dispatchwindow a owl:Class .
hpc:hasdispatchwindow a owl:DatatypeProperty ;
    rdfs:domain hpc:Dispatchwindow ;
    rdfs:range xsd:duration .

hpc:Dockerimageaffinity a owl:Class .
hpc:hasdockerimageaffinity a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerimageaffinity ;
    rdfs:range xsd:boolean .

hpc:dockerimageaffinitypreference a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerimageaffinity ;
    rdfs:range hpc:Dockerimageaffinitypreference .

hpc:dockerimageaffinitypreferencepreferencelevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Dockerimageaffinitypreference ;
    rdfs:range xsd:string .

hpc:dockerimageaffinityhostpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerimageaffinity ;
    rdfs:range hpc:Host .

hpc:Host a owl:Class .
hpc:hasdockerimage a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:Container a owl:Class ;
    rdfs:subClassOf hpc:Job .
