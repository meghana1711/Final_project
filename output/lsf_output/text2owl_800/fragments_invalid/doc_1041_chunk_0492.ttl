hpc:Bresumecommand rdfs:subClassOf hpc:Command .
hpc:Suspendedjob rdfs:subClassOf hpc:Job .

# Property Relations
hpc:Calls rdfs:domain hpc:Brestartcommand ;
  rdfs:range hpc:Esubfile .
hpc:Modifiesarguments rdfs:domain hpc:Brestartcommand ;
  rdfs:range hpc:Esubfile .
hpc:Changesjobenvironment rdfs:domain hpc:Bsubcommand ;
