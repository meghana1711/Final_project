hpc:SLURMJob a owl:Class .
hpc:SLURMArrayJob a owl:Class, rdfs:subClassOf hpc:SLURMJob .
hpc:SLURMTask a owl:Class, rdfs:subClassOf hpc:SLURMJob .

hpc:hasJobID a owl:ObjectProperty .
hpc:hasArrayJobID a owl:ObjectProperty .
hpc:hasArrayTaskID a owl:ObjectProperty .
hpc:hasArrayTaskCount a owl:ObjectProperty .
hpc:hasArrayTaskMax a owl:ObjectProperty .
hpc:hasArrayTaskMin a owl:ObjectProperty .

hpc:JobID rdf:type xsd:integer .
hpc:ArrayJobID rdf:type xsd:integer .
hpc:ArrayTaskID rdf:type xsd:integer .
hpc:ArrayTaskCount rdf:type xsd:integer .
hpc:ArrayTaskMax rdf:type xsd:integer .
hpc:ArrayTaskMin rdf:type xsd:integer .

hpc:SLURMJob rdfs:subClassOf rdf:Resource .
hpc:SLURMArrayJob rdfs:subClassOf rdf:Resource .
hpc:SLURMTask rdfs:subClassOf rdf:Resource .

hpc:hasJobID rdfs:domain hpc:SLURMJob ;
                      rdfs:range hpc:JobID .
hpc:hasArrayJobID rdfs:domain hpc:SLURMArrayJob ;
                      rdfs:range hpc:ArrayJobID .
hpc:hasArrayTaskID rdfs:domain hpc:SLURMTask ;
                      rdfs:range hpc:ArrayTaskID .
hpc:hasArrayTaskCount rdfs:domain hpc:SLURMArrayJob ;
                       rdfs:range hpc:ArrayTaskCount .
hpc:hasArrayTaskMax rdfs:domain hpc:SLURMArrayJob ;
                      rdfs:range hpc:ArrayTaskMax .
hpc:hasArrayTaskMin rdfs:domain hpc:SLURMArrayJob ;
                      rdfs:range hpc:ArrayTaskMin .
```
