hpc:Jobrequirement a owl:Class .
hpc:jobchunking a owl:ObjectProperty .
hpc:Computeunit a owl:Class .
hpc:resourcereservation a owl:ObjectProperty .

hpc:Job rdfs:subClassOf hpc:Job .
hpc:Firstexecutionhost rdfs:domain hpc:Job .
hpc:Jobrequirement rdfs:subClassOf hpc:Job .
hpc:Jobchunking rdfs:domain hpc:Job .
hpc:Computeunit rdfs:subClassOf hpc:Resource .
