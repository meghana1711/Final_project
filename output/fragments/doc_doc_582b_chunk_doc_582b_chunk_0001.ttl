hpc:LargeSlurmCluster a owl:Class .
hpc:HasCoreCount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LargeSlurmCluster ;
    rdfs:range xsd:integer .

hpc:HasNodeCount rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LargeSlurmCluster ;
    rdfs:range xsd:integer .

hpc:PerformanceTime rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LargeSlurmCluster ;
    rdfs:range xsd:decimal .

hpc:RequiresSlurmKnowledge rdf:type owl:ObjectProperty .

hpc:OptimalPerformanceDocument a owl:Class ;
    rdfs:subClassOf hpc:LargeSlurmCluster .

hpc:FileMax rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:LargeSlurmCluster ;
    rdfs:range xsd:integer .
```
