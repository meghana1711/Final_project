# Example 13
hpc:Job a owl:Class .
hpc:hasCPUCount rdf:datatype xsd:int .
hpc:hasTaskCount rdf:datatype xsd:int .
hpc:hasPartition rdf:literal "default" .
hpc:allocationMethod rdf:datatype xsd:string .
hpc:distributionMethod rdf:datatype xsd:string .
hpc:taskAffinity rdf:datatype xsd:boolean .
hpc:socketBinding rdf:datatype xsd:boolean .

hpc:Job_13 a hpc:Job ;
    hpc:hasCPUCount 6 ;
    hpc:hasTaskCount "2"^^xsd:int ;
    hpc:hasPartition "default" ;
    hpc:allocationMethod "block" ;
    hpc:distributionMethod "cyclic" ;
    hpc:taskAffinity true ;
    hpc:socketBinding true .

hpc:Node a owl:Class .
hpc:hasSocketCount rdf:datatype xsd:int .
hpc:hasSocketID rdf:datatype xsd:int .
hpc:hasAllocatedCPUs rdf:datatype xsd:string .
hpc:hasBoundTasks rdf:datatype xsd:string .

hpc:Node_n0 a hpc:Node ;
    hpc:hasSocketCount 2 ;
    hpc:hasSocketID 0 ;
    hpc:hasAllocatedCPUs "0 1 2 3" ;
    hpc:hasBoundTasks "0 10 1-" .

hpc:Socket a owl:Class .
hpc:hasID rdf:datatype xsd:int .
hpc:hasAllocatedCPUs rdf:datatype xsd:string .

hpc:Socket_id0 a hpc:Socket ;
    hpc:hasID 0 ;
    hpc:hasAllocatedCPUs "0 1 2 3" .

hpc:CPU a owl:Class .
hpc:hasID rdf:datatype xsd:int .

hpc:CPU_0 a hpc:CPU ;
    hpc:hasID 0 .

