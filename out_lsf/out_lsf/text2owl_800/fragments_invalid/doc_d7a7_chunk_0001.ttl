hpc:Lanserver a owl:Class.
hpc:Project a owl:Class.
hpc:Token a owl:Class.
hpc:lanserverhastoken a owl:ObjectProperty, rdfs:domain hpc:lanserver; rdfs:range rdf:List.
hpc:tokenbelongsto a owl:ObjectProperty, rdfs:domain hpc:token; rdfs:range rdf:PropertyValue.
hpc:tokenstatus a owl:DatatypeProperty, rdfs:domain hpc:token; rdfs:range xsd:integer.
hpc:tokendistributiontime a owl:DatatypeProperty, rdfs:domain hpc:token; rdfs:range xsd:dateTime.
hpc:licensesshared a owl:ObjectProperty, rdfs:domain hpc:project; rdfs:range rdf:List.
hpc:licensesshare a owl:ObjectProperty, rdfs:domain hpc:licensesshared;
                      rdf:first hpc:Project; rdf:rest rdf:List.
hpc:licensesshareratio a owl:DatatypeProperty, rdfs:domain hpc:licensesshare; rdfs:range
