hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:integer .

hpc:jobname a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:string .

hpc:arrayindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarray ;
    rdfs:range xsd:integer .

hpc:Job a owl:Class .

hpc:jobdescription a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:jobaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:Affinitypreference a owl:Class .

hpc:Exclusion a owl:Class ;
    rdfs:subClassOf hpc:Affinitypreference .

hpc:Inclusion a owl:Class ;
    rdfs:subClassOf hpc:Affinitypreference .

hpc:attributename a owl:DatatypeProperty ;
    rdfs:domain hpc:Affinitypreference .
