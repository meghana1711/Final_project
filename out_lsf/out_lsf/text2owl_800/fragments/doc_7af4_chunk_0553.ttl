hpc:Resourcepool a owl:Class .
hpc:Slot a owl:Class .
hpc:distribution a owl:ObjectProperty .
hpc:Distribution rdfs:domain hpc:Resourcepool .
hpc:Distribution rdfs:range rdfs:List .
hpc:Distributionlist a owl:Class .
hpc:Distributionlist rdfs:subClassOf rdfs:List .
hpc:Distributionlist rdfs:range hpc:Distribution .
hpc:distributionentry a owl:ObjectProperty .
hpc:Distributionentry rdfs:domain hpc:Distributionlist .
hpc:Distributionentry rdfs:range rdf:List .
hpc:DistributionEntry rdf:first hpc:Distribution .
hpc:DistributionEntry rdf:rest hpc:Distribution .
hpc:percentage a owl:DatatypeProperty .
hpc:Percentage rdfs:domain hpc:Distribution .
hpc:Percentage rdfs:range xsd:decimal .
hpc:Guaranteepool a owl:Class .
hpc:loanpolicies a owl:ObjectProperty .
hpc:Loanpolicies rdfs:domain hpc:Guaranteepool .
hpc:Loanpolicies rdfs:range rdfs:List .
hpc:Queue a owl:Class .
hpc:Queue rdfs:subClassOf hpc:Loanpolicy .
hpc:closeondemand a owl:ObjectProperty .
hpc:Closeondemand rdfs:domain hpc:Queue .
hpc:duration a owl:DatatypeProperty .
hpc:Duration rdfs:domain hpc:Queue .
hpc:Duration rdfs:range xsd:nonNegativeInteger .
hpc:idlebuffer a owl:DatatypeProperty .
hpc:Idlebuffer rdfs:domain hpc:Queue .
hpc:Idlebuffer rdfs:range xsd:decimal .
