hpc:Job a owl:Class .
hpc:PriorityFactor a owl:Class .
hpc:Partition a hpc:PriorityFactor .
hpc:FairShareFactor a hpc:PriorityFactor .
hpc:AgeFactor a hpc:PriorityFactor .
hpc:AssociationFactor a hpc:PriorityFactor .

hpc:hasPriorityWeight a owl:ObjectProperty .
hpc:hasPriorityFlag a owl:ObjectProperty .
hpc:hasNormalizedValue a owl:ObjectProperty .
hpc:hasRawValue a owl:ObjectProperty .
hpc:hasAssociationPriority a owl:ObjectProperty .

hpc:PriorityWeightPartition rdf:type xsd:integer .
hpc:PriorityFlags rdf:type rdfs:Class .
hpc:NoNormal_Part a owl:NamedIndividual , hpc:NO_NORMAL_PART rdf:value "NO_NORMAL_PART" .

hpc:PriorityJobFactor rdf:type xsd:float .
hpc:AssociationPriority rdf:type xsd:integer .

hpc:FairShare a hpc:Job .
hpc:PartitionedJob a hpc:Job .
hpc:AssociatedJob a hpc:Job .

hpc:hasPartition a owl:ObjectProperty .
hpc:hasAssociation a owl:ObjectProperty .

hpc:Partition a rdfs:subClassOf hpc:Job .
hpc:AssociatedJob rdfs:subClassOf hpc:Job .

hpc:hasPartition rdfs:domain hpc:PartitionedJob ;
                    rdfs:range hpc:Partition .
hpc:hasAssociation rdfs:domain hpc:AssociatedJob ;
                    rdfs:range hpc:Association .

hpc:AgeFactor rdfs:subClassOf hpc:PriorityFactor .
hpc:AssociationFactor rdfs:subClassOf hpc:PriorityFactor .

hpc:hasAgeFactor a owl:FunctionalProperty .
hpc:hasAssociationPriority rdfs:domain hpc:AssociatedJob ;
                             rdfs:range xsd:integer .
```
