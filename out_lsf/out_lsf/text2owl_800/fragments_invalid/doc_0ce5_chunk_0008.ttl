hpc:Cpurunqueuelength a owl:Class .
hpc:Loadlimit a owl:Class .
hpc:Singleprocessormachine a owl:Class .
hpc:Multiprocessormachine a owl:Class .
hpc:Configurationfile a owl:Class .
hpc:Sharedfile a owl:Class .
hpc:Managementhost a owl:Class .
hpc:Managementcandidate a owl:Class .
hpc:Electedmanagementhost a owl:Class .
hpc:Serverhost a owl:Class .
hpc:lsfMasterList a owl:ObjectProperty .
hpc:preferredmanagementhost a owl:ObjectProperty .
hpc:NumberOfProcessors owl:DatatypeProperty .
hpc:LoadIndex owl:DatatypeProperty .
hpc:configurationinformation a owl:ObjectProperty .
hpc:Managementhosteligibility a owl:Class .
hpc:Outofsyncfiles a owl:Class .

hpc:Cpurunqueuelength rdfs:subClassOf hpc:Loadlimit .
hpc:Singleprocessormachine rdfs:subClassOf hpc:Machine .
hpc:Multiprocessormachine rdfs:subClassOf hpc:Machine .
hpc:Configurationfile rdfs:subClassOf hpc:File .
hpc:SharedFile rdf:type hpc:ConfigurationFile ;
    rdfs:subClassOf hpc:Nonsharedfile ;
    rdfs:domain hpc:Managementcandidate .
hpc:ManagementHost rdf:type hpc:Machine ;
    rdfs:subClassOf hpc:Serverhost .
hpc:ManagementCandidate rdf:type hpc:ServerHost .
hpc:ElectedManagementHost rdf:type hpc:ManagementHost .
hpc:Serverhost rdfs:subClassOf hpc:Machine .
hpc:LsfMasterList rdfs:domain hpc:Managementcandidate ;
    rdfs:range hpc:Managementhost .
hpc:Preferredmanagementhost rdfs:domain hpc:Managementhost ;
    rdfs:range hpc:Managementhost .
hpc:Numberofprocessors rdfs:domain hpc:Machine ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Loadindex rdfs:domain hpc:Loadlimit ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Configurationinformation rdfs:domain hpc:Electedmanagementhost ;
    rdfs:range hpc:Configurationfile .
hpc:ManagementHostEligibility rdf:type hpc:OutOfSyncFiles .
hpc:Outofsyncfiles rdfs:subClassOf hpc:Problem .
