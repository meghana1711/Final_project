hpc:Hostjob rdfs:subClassOf hpc:Job .
hpc:Queuejob rdfs:subClassOf hpc:Job .
hpc:Projectjob rdfs:subClassOf hpc:Job .

hpc:Jobslotlimit rdfs:range xsd:nonNegativeInteger .
hpc:Joblimit rdfs:range xsd:nonNegativeInteger .
hpc:Reservationlimit rdfs:range hpc:Resource .
