hpc:lsfBwaitReregInterval a owl:DatatypeProperty .
hpc:LsbBwaitReregInterval rdfs:domain lsb:ServerConfiguration .
hpc:LsbBwaitReregInterval rdfs:range xsd:integer .
hpc:LsbBwaitReregInterval rdfs:range xsd:nonNegativeInteger .
hpc:LsbBwaitReregInterval rdfs:range xsd:positiveInteger .
hpc:LsbBwaitReregInterval rdfs:range xsd:nonPositiveInteger .
hpc:LsbBwaitReregInterval rdfs:range xsd:maxInclusive "525600" .
hpc:LSB_BWAIT_REREG_INTERVAL rdfs:default "10 minutes" .

hpc:lsbCallLimRetry a owl:DatatypeProperty .
hpc:LsbCallLimRetry rdfs:domain lsb:ServerConfiguration .
hpc:LsbCallLimRetry rdfs:range xsd:integer .
hpc:LsbCallLimRetry rdfs:range xsd:nonNegativeInteger .
hpc:LSB_CALL_LIM_RETRY rdfs:default "0" .

hpc:lsbCgroupCpuSharesOldDefault a owl:DatatypeProperty .
hpc:LsbCgroupCpuSharesOldDefault rdfs:domain lsb:ServerConfiguration .
hpc:LsbCgroupCpuSharesOldDefault rdfs:range xsd:string .
hpc:LsbCgroupCpuSharesOldDefault rdfs:range xsd:boolean .
hpc:LSB_CGROUP_CPU_SHARES_OLD_DEFAULT rdfs:default "Y" .
