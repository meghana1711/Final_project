hpc:Floatingclient a owl:Class .
hpc:allowedipaddress a owl:DatatypeProperty ;
    rdfs:domain hpc:Floatingclient ;
    rdfs:range xsd:string .
hpc:Ipv4range a owl:Class ;
    rdfs:subClassOf hpc:Allowedipaddress .
hpc:Ipv6range a owl:Class ;
    rdfs:subClassOf hpc:Allowedipaddress .
hpc:Ipv4oripv6range a owl:Class ;
    rdfs:subClassOf hpc:Allowedipaddress .
hpc:Wildcardip a owl:Class ;
    rdfs:subClassOf hpc:Allowedipaddress .
hpc:Iprange a owl:Class ;
    rdfs:subClassOf hpc:Allowedipaddress ;
    rdfs:subClassOf hpc:Ipv4range ;
    rdfs:subClassOf hpc:Ipv6range ;
    rdfs:subClassOf hpc:Ipv4oripv6range .
hpc:ipv4rangeHasstart a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipv4range ;
    rdfs:range xsd:integer .
hpc:ipv4rangeHasend a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipv4range ;
    rdfs:range xsd:integer .
hpc:ipv6rangeHasstart a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipv6range ;
    rdfs:range xsd:hexBinary .
hpc:ipv6rangeHasend a owl:DatatypeProperty ;
    rdfs:domain hpc:Ipv6range ;
    rdfs:range xsd:hexBinary .
hpc:ipv4oripv6rangeHasipv4 a owl:ObjectProperty ;
    rdfs:domain hpc:Ipv4oripv6range ;
    rdfs:range hpc:Ipv4range .
hpc:ipv4oripv6rangeHasipv6 a owl:ObjectProperty ;
    rdfs:domain hpc:Ipv4oripv6range ;
    rdfs:range hpc:Ipv6range .
hpc:floatingclientHasallowedip a owl:ObjectProperty ;
    rdfs:domain hpc:Floatingclient .
