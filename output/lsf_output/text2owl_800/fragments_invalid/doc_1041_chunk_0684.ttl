hpc:Resourcerequirement a owl:Class ;
  rdfs:subClassOf owl:Class ;
  rdfs:comment "Represents resource requirements or limits." .

hpc:Resourceunit a owl:Class ;
  rdfs:subClassOf owl:Class ;
  rdfs:comment "Represents units for resource requirements and limits." .

hpc:Resourcelimit a owl:Class ;
  rdfs:subClassOf hpc:Resourcerequirement ;
  rdfs:comment "Represents a limit set for a resource." .

hpc:Resourcerequirementvalue a owl:Class ;
  rdfs:subClassOf owl:Class ;
  rdfs:comment "Represents the value of a resource requirement or limit." .

# Object Properties
hpc:hasunit a owl:ObjectProperty ;
  rdfs:domain hpc:Resourcerequirementvalue ;
  rdfs:range hpc:Resourceunit ;
  rdfs:comment "Indicates the unit of a resource requirement or limit." .

hpc:satisfieslimit a owl:ObjectProperty ;
  rdfs:domain hpc:Resourcerequirementvalue ;
  rdfs:range hpc:Resourcerequirementvalue ;
  rdfs:comment "Indicates whether a resource requirement value satisfies a limit." .

# Datatype Properties
hpc:name a owl:DatatypeProperty ;
  rdfs:domain hpc:Resourcerequirement ;
  rdfs:range xsd:string ;
  rdfs:comment "Name of the resource requirement or limit." .

hpc:haslimit a owl:DatatypeProperty ;
  rdfs:domain hpc:Resourcerequirement ;
  rdfs:range hpc:Resourcelimit ;
  rdfs:comment "Indicates the limit associated with a resource requirement." .

# Resource Units
hpc:Kilobyte a hpc:ResourceUnit ;
  rdfs:label "KB" ;
  rdfs:comment "Kilobyte unit." .

hpc:Megabyte a hpc:ResourceUnit ;
  rdfs:label "MB" ;
  rdfs:comment "Megabyte unit." .

hpc:Gigabyte a hpc:ResourceUnit ;
  rdfs:label "GB" ;
  rdfs:comment "Gigabyte unit." .

hpc:Terabyte a hpc:ResourceUnit ;
  rdfs:label "TB" ;
  rdfs:comment "Terabyte unit." .

hpc:Petabyte a hpc:ResourceUnit ;
  rdfs:label "PB" ;
  rdfs:comment "Petabyte unit." .

hpc:Exabyte a hpc:ResourceUnit ;
  rdfs:label "EB" ;
  rdfs:comment "Exabyte unit." .

hpc:Zettabyte a hpc:ResourceUnit ;
  rdfs:label "ZB" ;
  rdfs:comment "Zettabyte unit." .

