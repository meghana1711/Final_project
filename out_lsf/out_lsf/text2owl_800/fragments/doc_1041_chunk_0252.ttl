hpc:Jobslot a owl:Class .
hpc:Pendingjobslot a owl:Class .
hpc:Runningjobslot a owl:Class .
hpc:Suspendedjobslot a owl:Class .
hpc:Reservedjobslot a owl:Class .
hpc:Sla a owl:Class .
hpc:Serviceclassattachment a owl:Class .
hpc:Owner a owl:Class .
hpc:Groupname a owl:Class .

hpc:hasjobslot a owl:ObjectProperty .
hpc:Haspendingjobslot rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Jobslot ;
                        rdfs:subPropertyOf hpc:hasJobSlot .
hpc:Hasrunningjobslot rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Runningjobslot ;
                        rdfs:subPropertyOf hpc:hasJobSlot .
hpc:Hassuspendedjobslot rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Suspendedjobslot ;
                        rdfs:subPropertyOf hpc:hasJobSlot .
hpc:Hasreservedjobslot rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Reservedjobslot ;
                        rdfs:subPropertyOf hpc:hasJobSlot .
hpc:Hassla rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Sla .
hpc:Hasserviceclassattachment rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Serviceclassattachment .
hpc:Hasowner rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Owner .
hpc:Hasgroupname rdfs:domain hpc:Jobgroup ;
                        rdfs:range hpc:Groupname .
