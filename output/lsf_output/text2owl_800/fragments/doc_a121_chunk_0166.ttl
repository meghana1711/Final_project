hpc:Usermapping a owl:Class .
hpc:Submissionuser a owl:Class .
hpc:Hassubmissionuser rdfs:domain hpc:Usermapping ;
                        rdfs:range hpc:Submissionuser .
hpc:Hasexecutionusers rdfs:domain hpc:Usermapping ;
                      rdfs:range rdf:List .
hpc:List a owl:Class ;
             rdfs:subClassOf xsd:nonNegativeInteger .
hpc:Listmember a owl:Class ;
               rdfs:subClassOf hpc:User .
hpc:Haslistmember rdfs:domain rdf:List ;
                 rdfs:range hpc:Listmember .
hpc:Isownedby rdfs:domain hpc:Usermapping ;
               rdfs:range hpc:Administrator .
hpc:Hasfilepermissions rdfs:domain hpc:Usermapping ;
                     rdfs:range xsd:nonNegativeInteger .
hpc:Readwriteforowner rdfs:domain hpc:Filepermissions ;
                      rdfs:range xsd:integer .
hpc:Readonlyforothers rdfs:domain hpc:Filepermissions ;
                      rdfs:range xsd:integer .
hpc:bsubmitcommand a owl:ObjectProperty .
hpc:Bsubmitcommand rdfs:domain hpc:Usermapping ;
                    rdfs:range rdf:XMLLiteral .
hpc:jobsubmission a owl:ObjectProperty .
hpc:Jobsubmission rdfs:domain hpc:Submissionuser ;
                   rdfs:range rdf:XMLLiteral .
hpc:jobexecution a owl:ObjectProperty .
hpc:Jobexecution rdfs:domain hpc:Executionuser ;
                   rdfs:range rdf:XMLLiteral .
