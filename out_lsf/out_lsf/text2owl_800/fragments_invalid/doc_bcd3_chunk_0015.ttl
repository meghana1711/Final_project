@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Job a owl:Class .
hpc:JobID a xsd:integer .
hpc:Level a xsd:integer .
hpc:parent a owl:ObjectProperty .
hpc:Parent_Status a xsd:string .
hpc:Parent_Name a xsd:string .
hpc:DependencyCondition a xsd:string .
hpc:Satisfied a xsd:boolean .

hpc:Job rdfs:subClassOf hpc:Job .
hpc:Jobid rdfs:domain hpc:Job .
hpc:Level rdfs:domain hpc:Job .
hpc:Parent rdfs:domain hpc:Job .
