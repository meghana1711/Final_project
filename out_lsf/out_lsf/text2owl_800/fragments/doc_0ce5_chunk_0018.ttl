hpc:LsbParamsFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the lsb.params file." .

hpc:MbdQueryCpusParameter
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparamsfile ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "The parameter that specifies the CPUs on which mbatchd child query processes run." .

hpc:CpuInfoCommand
    a owl:ObjectProperty ;
    rdfs:domain hpc:Operatingsystem ;
    rdfs:range xsd:string ;
    rdfs:comment "The command to get a list of valid CPUs on a specific operating system." .

hpc:OperatingSystem
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents an operating system." .

hpc:Linux
    a owl:Class ;
    rdfs:subClassOf hpc:Operatingsystem ;
    rdfs:comment "Represents the Linux operating system." .

hpc:Solaris
    a owl:Class ;
    rdfs:subClassOf hpc:Operatingsystem ;
    rdfs:comment "Represents the Solaris operating system." .

hpc:LsfParamsFile
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the lsf.conf file." .

hpc:LsfIntelligentCpuBindParameter
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfparamsfile ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The parameter that enables LSF to bind a defined set of LSF daemons to CPUs." .

hpc:QueryProcess
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a query process." .

hpc:CpuBinding
    a owl:ObjectProperty ;
    rdfs:domain hpc:Queryprocess ;
    rdfs:range hpc:Cpu ;
    rdfs:comment "The CPU to which a query process is bound." .

hpc:Cpu
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents a CPU." .
