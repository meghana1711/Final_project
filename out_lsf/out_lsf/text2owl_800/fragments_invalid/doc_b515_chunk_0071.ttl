hpc:Host a owl:Class .
hpc:Cpu a owl:Class .
hpc:Memorynode a owl:Class .
hpc:Socket a owl:Class .
hpc:Numa a owl:Class .
hpc:Core a owl:Class .
hpc:Openmpirankfile a owl:Class .
hpc:hasHost rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Openmpirankfile ;
    rdfs:range hpc:Host .
hpc:hasCPU rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Cpu .
hpc:hasMemoryNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hps:MemoryNode .
hpc:hasSocket rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Socket .
hpc:hasNUMA rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Socket ;
    rdfs:range hpc:Numa .
hpc:hasCore rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Numa ;
    rdfs:range hpc:Core .
hpc:hasSlot rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Openmpirankfile ;
    rdfs:range xsd:integer .
