hpc:preartime a owl:DatatypeProperty ;
    rdfs:domain hpc:Advancereservation ;
    rdfs:range xsd:nonNegativeInteger .

hpc:endtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Onetimereservation ;
    rdfs:range xsd:dateTime .

hpc:Year rdfs:subClassOf xsd:nonNegativeInteger ;
    rdfs:range [ xsd:minInclusive "1900" ] ;
    rdfs:comment "Any year after 1900 (YYYY)." .

hpc:Month rdfs:subClassOf xsd:gYearMonth ;
    rdfs:range [ xsd:minInclusive "01" xsd:maxInclusive "12" ] ;
    rdfs:comment "month" .

hpc:Day rdfs:subClassOf xsd:day ;
    rdfs:range [ xsd:minInclusive "01" xsd:maxInclusive "31" ] ;
    rdfs:comment "day of the month" .

hpc:Hour rdfs:subClassOf xsd:gYearMonthDay ;
    rdfs:range xsd:gYearMonthDay ;
    rdfs:comment "hour" .

hpc:Minute rdfs:subClassOf xsd:gYearMonthDay ;
    rdfs:range xsd:gYearMonthDay ;
    rdfs:comment "minute" .

hpc:PreARTime hasPreScript rdf:Boolean ;
    rdfs:domain hpc:Preartime ;
    rdfs:range rdf:Boolean ;
    rdfs:comment "Indicates if a pre-script is specified for the pre-time." .

hpc:EndTimeBeforePreTime rdf:Boolean ;
    rdfs:domain hpc:Onetimereservation ;
    rdfs:range rdf:Boolean ;
    rdfs:comment "Indicates if the end time is later than the time value for the -b option." .
