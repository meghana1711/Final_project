hpc:gpackpolicy a owl:ObjectProperty .
hpc:Gpackpolicy rdfs:domain hpc:Gpuresourcerequirement ;
                 rdfs:range hpc:Gpuresourcerequirement .
hpc:order a owl:ObjectProperty .
hpc:Order rdfs:domain hpc:Gpuresourcerequirement ;
               rdfs:range hpc:Gpuresourcerequirement .
