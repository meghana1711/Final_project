hpc:lsfLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfig ;
    rdfs:range xsd:integer .

hpc:lsfLimIgnoreChecksum a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfig ;
    rdfs:range xsd:string ;
    rdfs:comment "Configure LSF_LIM_IGNORE_CHECKSUM=Y to ignore warning messages logged to lim log files on non-management hosts." .

hpc:lsfLimDebug a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconfig ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf hpc:LSF_DEBUG .

hpc:lsfDebug a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfconfig ;
    rdfs:range xsd:integer ;
    rdfs:comment "Specify 1 for LSF_LIM_DEBUG unless you are testing LSF. LIM runs in the background with no associated control terminal. LSF_LIM_DEBUG=2 LIM runs in the foreground and prints error messages to tty." .

hpc:Lsfconfig a owl:Class .
