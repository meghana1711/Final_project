hpc:lsfinstall a owl:ObjectProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range hpc:Locallsfconf .

hpc:Locallsfconf a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Configfile ;
    rdfs:comment "A local lsf.conf file on a server host." .

hpc:localresources a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The resources defined in LSF_LOCAL_RESOURCES." .

hpc:lsfconfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The directory where the LSF configuration is located." .

hpc:lsfgetconf a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to get the LSF configuration." .

hpc:lsflimport a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:integer ;
    rdfs:comment "The port number used by the LSF LIM." .

hpc:lsfserverhosts a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The host names of the servers in the cluster." .

hpc:lsfversion a owl:DatatypeProperty ;
    rdfs:domain hpc:Locallsfconf ;
    rdfs:range xsd:string ;
    rdfs:comment "The version of the LSF installed." .

hpc:lsfrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Serverhost ;
    rdfs:range hpc:Daemonrestart .

hpc:Daemonrestart a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "The act of restarting a daemon." .

hpc:Lim a owl:Class ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "The Load Sharing Facility (LSF) Load Manager (LIM) daemon." .

hpc:Res a owl:Class ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "The Resource Manager (RES) daemon." .

hpc:Sbatchd a owl:Class ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "The sbatchd daemon." .

hpc:Mbatchd a owl:Class ;
    rdfs:subClassOf hpc:Daemon ;
    rdfs:comment "The mbatchd daemon." .

hpc:LsfSudo
