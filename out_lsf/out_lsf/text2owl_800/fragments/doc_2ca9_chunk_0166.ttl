hpc:Estimator a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Runs a job prediction and stops after a specified time." .

hpc:estimatorMaxRuntimePrediction a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:duration ;
    rdfs:comment "The maximum time the estimator runs." .

hpc:estimatorSimStartInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:duration ;
    rdfs:comment "The time after which the estimator stops if no prediction is made." .

hpc:Eligiblependingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that LSF would normally select for resource allocation, but is pending because its priority is lower." .

hpc:Ineligiblependingjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that is ineligible for scheduling and remains pending even if enough resources are available to run it." .

hpc:hasstarttimeconstraint a owl:ObjectProperty ;
    rdfs:domain hpc:Ineligiblependingjob ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job has a start time constraint." .

hpc:lsfconf a owl:DatatypeProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The location of the lsf.conf file." .

hpc:supportedsubcommands a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The subcommands that the estimator supports." .

hpc:unsupportedsubcommands a owl:ObjectProperty ;
    rdfs:domain hpc:Estimator ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:comment "The subcommands that the estimator does not support." .
