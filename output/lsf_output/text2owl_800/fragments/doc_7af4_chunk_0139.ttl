hpc:Jobstatus a owl:Class .
hpc:Hostrusage a owl:Class .

hpc:hashostrusage a owl:ObjectProperty ;
    rdfs:domain hpc:Jobstatus ;
    rdfs:range hpc:Hostrusage .

hpc:Hostrusage a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        rdfs:onProperty hpc:hasHostRusage ;
                        owl:hasValue xsd:integer ] .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage .

hpc:mem a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .

hpc:swap a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .

hpc:stime a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .

hpc:hhostextendinfo a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:integer .

hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .

hpc:avgmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .

hpc:srcjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:integer .

hpc:srccluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:string .

hpc:dstjobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:integer .

hpc:dstcluster a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:string .

hpc:ineligiblependtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Hostrusage ;
    rdfs:range xsd:decimal .
