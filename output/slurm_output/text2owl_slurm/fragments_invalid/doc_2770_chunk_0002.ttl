hpc:Job a owl:Class.
hpc:defer a owl:ObjectProperty.
hpc:max_switch_wait a xsd:nonNegativeInteger.
hpc:Maxswitchwait rdfs:domain hpc:Job; rdfs:range xsd:nonNegativeInteger.
hpc:max_switch_wait rdfs:subPropertyOf hpc:hasProperty.
hpc:max_switch_wait rdf:value "300"^^xsd:second.
hpc:max_switch_waitDefault a rdf:Property.
hpc:max_switch_waitDefault rdf:value "300"^^xsd:second.
hpc:max_switch_waitDefault rdfs:comment "Default value is 300 seconds.".

hpc:deferaction a owl:ObjectProperty.
hpc:Deferaction rdfs:domain hpc:Job.
hpc:Deferaction rdfs:range rdf:Boolean.
hpc:deferAction rdfs:subPropertyOf hpc:hasProperty.

hpc:partition_job_depth a xsd:nonNegativeInteger.
hpc:Partitionjobdepth rdfs:domain hpc:Job; rdfs:range xsd:nonNegativeInteger
