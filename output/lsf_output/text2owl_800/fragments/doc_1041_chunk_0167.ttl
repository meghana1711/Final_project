hpc:Helpinformation a owl:Class .
hpc:commandname a owl:DatatypeProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range xsd:string .
hpc:releasenumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range xsd:string .
hpc:servicelevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range xsd:string .
hpc:serviceleveldate a owl:DatatypeProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range xsd:string .
hpc:operatingsystemlevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range xsd:string .
hpc:sortby a owl:ObjectProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range [ a owl:Class ;
                 owl:unionOf ( (hpc:CpuFrequency) (hpc:Time) (hpc:Energy) ) ] .
hpc:Cpufrequency a owl:Class .
hpc:Time a owl:Class .
hpc:Energy a owl:Class .
hpc:removeenergypolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range hpc:Novalue .
hpc:followedby a owl:ObjectProperty ;
    rdfs:domain hpc:Removeenergypolicy ;
    rdfs:range [ a owl:Class ;
                 owl:unionOf ( (hpc:UOption) (hpc:EnergyTagName) ) ] .
hpc:Uoption a owl:Class ;
    rdfs:subClassOf hpc:Option .
hpc:Allusers a owl:Class ;
    rdfs:subClassOf hpc:Uoption .
hpc:username a owl:DatatypeProperty ;
    rdfs:domain hpc:Uoption ;
    rdfs:range xsd:string .
hpc:displayoption a owl:ObjectProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range hpc:Displaydata .
hpc:Displaydata a owl:Class .
hpc:energytagname a owl:DatatypeProperty ;
    rdfs:domain hpc:Displaydata ;
    rdfs:range xsd:string .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Displaydata ;
    rdfs:range xsd:string .
hpc:Energytag a owl:Class .
hpc:displayspecifictag a owl:ObjectProperty ;
    rdfs:domain hpc:Helpinformation ;
    rdfs:range hpc:Energytag .
