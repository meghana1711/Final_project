hpc:User a owl:Class .
hpc:Group a owl:Class .
hpc:Host a owl:Class .
hpc:Client a owl:Class .
hpc:Eauthprocess a owl:Class .

hpc:hasuserid a owl:ObjectProperty .
hpc:hasgroupid a owl:ObjectProperty .
hpc:hasusername a owl:ObjectProperty .
hpc:hasclientaddr a owl:ObjectProperty .
hpc:hasclientport a owl:ObjectProperty .
hpc:hasuserauthdatalen a owl:DatatypeProperty .
hpc:invokingdaemonoruser a owl:ObjectProperty .

hpc:Eauthserver a rdfs:subClassOf hpc:Eauthprocess .
hpc:Client rdfs:subClassOf hpc:Host .

hpc:Hasuserid rdfs:domain hpc:Client ;
    rdfs:range xsd:integer .
hpc:Hasgroupid rdfs:domain hpc:Client ;
    rdfs:range xsd:integer .
hpc:Hasusername rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
hpc:Hasclientaddr rdfs:domain hpc:Client ;
    rdfs:range xsd:string .
hpc:Hasclientport rdfs:domain hpc:Client ;
    rdfs:range xsd:integer .
hpc:Hasuserauthdatalen rdfs:domain hpc:Client ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Invokingdaemonoruser rdfs:domain hpc:Eauthprocess ;
    rdfs:range hpc:Daemonoruser .
