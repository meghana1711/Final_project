    rdfs:range xsd:string .
hpc:managementhost a owl:ObjectProperty ;
    rdfs:domain hpc:Clustermanagement ;
    rdfs:range xsd:string .
hpc:Authenticationbetweenclusters a owl:Class .
hpc:Eauthprogram a owl:Class .
hpc:eauthmethod a owl:ObjectProperty ;
    rdfs:domain hpc:Eauthprogram ;
    rdfs:range xsd:string .
hpc:lsfServerdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Eauthprogram ;
    rdfs:range xsd:string .
hpc:Multiclustergrid a owl:Class .
hpc:privilegedportauthentication a owl:ObjectProperty ;
