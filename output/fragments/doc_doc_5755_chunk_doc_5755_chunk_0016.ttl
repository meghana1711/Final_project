hpc:SrunCommand a owl:Class ;
    rdfs:comment "Command for interactive use with output at user's terminal." .

hpc:SbatchCommand a owl:Class ;
    rdfs:comment "Command for submitting a script for later execution with output written to a file." .

hpc:JobArray a owl:Class ;
    rdfs:subClassOf hpc:SbatchCommand .

hpc:FaultTolerance a owl:Class ;
    rdfs:subClassOf hpc:SbatchCommand ;
    rdfs:comment "Behavior when failures occur." .

hpc:InteractiveMode a owl:Class ;
    rdfs:subClassOf hpc:SrunCommand ;
    rdfs:comment "Mode for getting shell prompts." .

hpc:UseInteractiveStep a owl:ObjectProperty ;
    rdfs:domain hpc:Salloc ;
    rdfs:range hpc:InteractiveMode .

hpc:LaunchParameters a owl:DatatypeProperty ;
    rdfs:domain hpc:Salloc ;
    rdfs:range xsd:string .

hpc:PseudoTerminal a owl:Class ;
    rdfs:subClassOf hpc:SrunCommand ;
    rdfs:comment "Method for launching tasks with a remote terminal." .

hpc:Salloc a owl:Class ;
    rdfs:subClassOf hpc:Command .

hpc:Srun a owl:ObjectProperty ;
    rdfs:domain hpc:Salloc ;
    rdfs:range hpc:SrunCommand .

hpc:SrunPty a owl:ObjectProperty ;
    rdfs:domain hpc:Srun ;
    rdfs:range xsd:string .

hpc:Bash a owl:Class ;
    rdfs:subClassOf hpc:Command ;
    rdfs:comment "Shell used in the HPC environment." .

hpc:InteractiveStep a owl:Class ;
    rdfs:subClassOf hpc:SrunCommand ;
    rdfs:comment "Interactive shell within an allocation." .

hpc:ExclusiveStep a owl:Class ;
    rdfs:subClassOf hpc:SrunCommand ;
    rdfs:comment "Step that consumes all resources on the node." .
```
