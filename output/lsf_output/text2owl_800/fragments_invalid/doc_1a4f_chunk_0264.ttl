hpc:Job       a owl:Class ;
           rdfs:subClassOf hpc:Resourceconsumer ;
           rdfs:comment "Represents a job in the HPC system." .

hpc:Resourceconsumer  a owl:Class ;
           rdfs:subClassOf owl:Thing ;
           rdfs:comment "Represents a consumer of resources in the HPC system." .

hpc:submittime  a owl:DatatypeProperty ;
           rdfs:domain hpc:Job ;
           rdfs:range xsd:string ;
           rdfs:comment "The time a job was submitted." .

hpc:jobname  a owl:DatatypeProperty ;
           rdfs:domain hpc:Job ;
           rdfs:range xsd:string ;
           rdfs:comment "The name of the job." .

hpc:status  a owl:DatatypeProperty ;
           rdfs:domain hpc:Job ;
           rdfs:range xsd:string ;
           rdfs:comment "The status of the job." .

hpc:priority  a owl:DatatypeProperty ;
           rdfs:domain hpc:Job ;
           rdfs:range xsd:integer ;
           rdfs:comment "The priority of the job." .

hpc:Cluster  a owl:Class ;
           rdfs:subClassOf owl:Thing ;
           rdfs:comment "Represents a cluster in the HPC system." .

hpc:Resourcelimit  a owl:Class ;
           rdfs:subClassOf owl:Thing ;
           rdfs:comment "Represents a resource limit in the HPC system." .

hpc:limitname  a owl:DatatypeProperty ;
           rdfs:domain hpc:Resourcelimit ;
           rdfs:range xsd:string ;
           rdfs:comment "The name of the limit." .

hpc:peruser  a owl:ObjectProperty ;
           rdfs:domain hpc:Resourcelimit ;
           rdfs:range xsd:string ;
           rdfs:comment "Indicates whether the limit applies to all users." .

hpc:slots  a owl:DatatypeProperty ;
           rdfs:domain hpc:Resourcelimit ;
           rdfs:range xsd:integer ;
           rdfs:comment "The number of slots the limit applies to." .

hpc:equivalentconflictinglimit  a owl:ObjectProperty ;
           rdfs:domain hpc:Resourcelimit ;
           rdfs:range hpc:Resourcelimit ;
           rdfs:comment "A limit that is equivalent to the current limit but with a different value." .

hpc:Newlimit  a owl:Class ;
           rdfs:subClassOf hpc:Resourcelimit ;
           rdfs:comment "A new limit that overrides the existing limit." .

hpc:Existinglimit  a owl:Class ;
           rdfs:subClassOf hpc:Resourcelimit ;
           rdfs:comment "A limit that is ignored when a new limit is introduced." .

hpc:Jobslotlimit  a owl:Class ;
           rdfs:subClassOf hpc:Resourcelimit ;
           rdfs:comment "A job slot limit in lsb
