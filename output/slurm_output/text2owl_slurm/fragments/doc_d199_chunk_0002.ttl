hpc:Slurmdocumentation a owl:Class .
hpc:Slurmplugin a owl:Class .
hpc:Pluginlifecycle a owl:Class .
hpc:openapigeneration a owl:ObjectProperty .
hpc:Openapigeneration rdfs:domain hpc:Slurmdocumentation ;
                          rdfs:range hpc:Openapispecification .
hpc:Openapispecification a owl:Class .
hpc:Client a owl:Class .
hpc:clientdesign a owl:ObjectProperty .
hpc:Clientdesign rdfs:domain hpc:Client ;
                     rdfs:range hpc:Designdescription .
hpc:Designdescription a owl:Class .
hpc:versionsupport a owl:ObjectProperty .
hpc:Versionsupport rdfs:domain hpc:Client ;
                      rdfs:range xsd:string .
hpc:gracefulhandling a owl:ObjectProperty .
hpc:Gracefulhandling rdfs:domain hpc:Client ;
                       rdfs:range hpc:Handlingstrategy .
hpc:Handlingstrategy a owl:Class .
hpc:slurmversioning a owl:ObjectProperty .
hpc:Slurmversioning rdfs:domain hpc:Client ;
                       rdfs:range xsd:string .
hpc:Newfeature a owl:Class .
hpc:backport a owl:ObjectProperty .
hpc:Backport rdfs:domain hpc:Newfeature ;
                    rdfs:range xsd:boolean .
hpc:Openapischema a owl:Class .
hpc:structnamestripping a owl:ObjectProperty .
hpc:Structnamestripping rdfs:domain hpc:Openapischema ;
                          rdfs:range xsd:string .
