hpc:Federatedaccount a owl:Class .
hpc:awsCredentialScript a owl:ObjectProperty .
hpc:AwsCredentialScript rdfs:domain hpc:Federatedaccount ;
                               rdfs:range xsd:string .

hpc:Resourceconnector a owl:Class .
hpc:Lsfresourceconnector a owl:Class ;
                             rdfs:subClassOf hpc:Resourceconnector .

hpc:Iamrole a owl:Class .
hpc:Iamuser a owl:Class ;
               rdfs:subClassOf hpc:Iamrole .
hpc:Iaminstanceprofile a owl:Class .

hpc:instanceprofile a owl:ObjectProperty .
hpc:Instanceprofile rdfs:domain hpc:Lsfresourceconnector ;
                             rdfs:range hpc:Iaminstanceprofile .

hpc:AwsprovTemplates a owl:Class .
hpc:AwsprovConfig a owl:Class .
