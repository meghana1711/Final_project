hpc:Cpufactor a owl:Class .
hpc:projectname a owl:ObjectProperty .
hpc:queuename a owl:ObjectProperty .
hpc:rcacct a owl:DatatypeProperty .
hpc:rcalloc a owl:DatatypeProperty .
hpc:serviceclassname a owl:ObjectProperty .
hpc:time a owl:DatatypeProperty .
hpc:username a owl:ObjectProperty .
hpc:logfilename a owl:DatatypeProperty .
hpc:jobid a owl:ObjectProperty .
hpc:reservationid a owl:ObjectProperty .
hpc:Bacct a owl:Class .

hpc:Projectname rdfs:domain hpc:Bacct .
hpc:Queuename rdfs:domain hpc:Bacct .
hpc:Rcacct rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Rcalloc rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Serviceclassname rdfs:domain hpc:Bacct .
hpc:Time rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Username rdfs:domain hpc:Bacct .
hpc:Logfilename rdfs:domain hpc:Bacct ;
    rdfs:range xsd:string .
hpc:Jobid rdfs:domain hpc:Bacct .
hpc:Reservationid rdfs:domain hpc:Bacct .

hpc:Cpufactor rdfs:subClassOf owl:Thing .
hpc:Bacct rdfs:subClassOf owl:Thing .
