hpc:Host a owl:Class .
hpc:Process a owl:Class .
hpc:Hashost rdfs:domain hpc:Process ;
    rdfs:range hpc:Host .
hpc:Hasuser rdfs:domain hpc:Process ;
    rdfs:range xsd:string .
hpc:Hasid rdfs:domain hpc:Process ;
    rdfs:range xsd:integer .
hpc:Hasstatus rdfs:domain hpc:Process ;
    rdfs:range xsd:string .
hpc:Hasstarttime rdfs:domain hpc:Process ;
    rdfs:range xsd:dateTime .
hpc:Hascaution rdfs:domain hpc:Process ;
    rdfs:range rdf:List .
hpc:Hastprocess rdfs:domain hpc:Process ;
    rdfs:range xsd:string .
hpc:Job a owl:Class .
hpc:Hasparentjob rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:Hasdependencycondition rdfs:domain hpc:Job ;
    rdfs:range rdf:List .
hpc:Haspendingreason rdfs:domain hpc:Job ;
    rdfs:range rdf:PlainLiteral .
hpc:Grandparentjob rdfs:subClassOf hpc:Job .
