@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:nodeaddr a owl:DatatypeProperty.
    rdfs:domain hpc:Node;
    rdfs:range xsd:string.

hpc:nodehostname a owl:DatatypeProperty.
    rdfs:domain hpc:Node;
    rdfs:range xsd:string.

hpc:Nodestate a owl:Class.
    rdfs:subClassOf [ a owl:Restriction ;
                      rdfs:onProperty hpc:NodeState ;
                      owl:allValuesFrom owl:NamedIndividual ] .

hpc:operatingsystem a owl:DatatypeProperty.
