hpc:Job a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                      rdfs:subClassOf owl:NamedIndividual ] .

hpc:JobState a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:StartTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:EndTime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime .

hpc:TimeLimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:NodeList a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:List .

hpc:NodeListIndices a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:AllocCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:positiveInteger .

hpc:NumCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range xsd:positiveInteger .

hpc:ReqNodes a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ReqSCT a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:OverSubscribe a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Contiguous a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .

hpc:CPUsPerTask a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MinCPUs a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:nonNegativeInteger .

