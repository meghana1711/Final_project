hpc:Resourcerequirement a owl:Class .
hpc:Simpleresourcerequirement a owl:Class .
hpc:Compoundresourcerequirement a owl:Class .
hpc:selectionstring a owl:ObjectProperty .
hpc:Selectionstring rdfs:domain hpc:Resourcerequirement ;
                      rdfs:range rdf:String .
hpc:orderstring a owl:ObjectProperty .
hpc:Orderstring rdfs:domain hpc:Resourcerequirement ;
                  rdfs:range rdf:String .
hpc:usagestring a owl:ObjectProperty .
hpc:Usagestring rdfs:domain hpc:Job ;
                rdfs:range rdf:String .
hpc:spanstring a owl:ObjectProperty .
hpc:Spanstring rdfs:domain hpc:Paralleljob ;
                rdfs:range rdf:String .
hpc:samestring a owl:ObjectProperty .
hpc:computeunitstring a owl:ObjectProperty .
hpc:Computeunitstring rdfs:domain hpc:Paralleljob ;
                rdfs:range rdf:String .
