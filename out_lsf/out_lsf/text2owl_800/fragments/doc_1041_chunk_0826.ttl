hpc:Host a owl:Class .

hpc:Ok a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host is in normal state and can accept remote jobs. The ok status indicates that the Load Information Manager (LIM) is unlocked and that both LIM and the Remote Execution Server (RES) are running." .

hpc:Busy a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The LIM on the host is running but RES is unreachable." .

hpc:Overloaded a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host is overloaded because some load indices exceed conﬁgured thresholds. Load index values that caused the host to be busy are preceded by an asterisk (*)." .

hpc:Lockw a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host is locked by its run window. Run windows for a host are speciﬁed in the lsf.conf conﬁguration ﬁle, and can be displayed by the lshosts command. A locked host does not accept LSF jobs from other hosts." .

hpc:Locku a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host is locked by the LSF administrator or root." .

hpc:Unavail a owl:Class ;
    rdfs:subClassOf hpc:Host ;
    rdfs:comment "The host is down or the LIM on the host is not running." .

hpc:r15s a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:r1m a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:r15m a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:nonNegativeInteger .

hpc:ut a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:io a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .
