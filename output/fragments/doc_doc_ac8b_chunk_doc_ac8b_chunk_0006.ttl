hpc:TrackableResource a owl:Class .
hpc:Job a owl:Class .
hpc:TRESBillingWeights a owl:ObjectProperty .
hpc:BillingWeight rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:TrackableResource ;
    rdfs:range xsd:decimal .
hpc:BilledTRES a owl:ObjectProperty ;
    rdfs:domain hpc:Job .

hpc:CPU a hpc:TrackableResource .
hpc:Node a hpc:TrackableResource .
hpc:Memory a hpc:TrackableResource .
hpc:Licenses a hpc:TrackableResource .
hpc:GenericResources a hpc:TrackableResource .

hpc:GlobalTRES a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:TrackableResource .
hpc:NodeTRES a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:TrackableResource .

hpc:Sum a owl:ObjectProperty .
hpc:Max a owl:ObjectProperty .
```
