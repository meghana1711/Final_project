hpc:Logfile a owl:Class .
hpc:logdirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string .

hpc:Lsfconffile a owl:Class .

hpc:lsflogmask a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range xsd:string .

hpc:lsbdebugmbd a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range xsd:string .

hpc:lsbdebugebrokerd a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfconffile ;
    rdfs:range xsd:string .

hpc:loglevel a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceproviderconfiguration .
    rdfs:range xsd:string .

hpc:logfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceproviderconfiguration ;
    rdfs:range xsd:string .

hpc:Persistentfile a owl:Class .

hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:Persistentfile ;
    rdfs:range xsd:string .

hpc:federatedaccountscript a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceproviderconfiguration ;
    rdfs:range xsd:string .

hpc:awsfederatedusercredentialsfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceconnector ;
    rdfs:range xsd:string .

hpc:Resourceconnector a owl:Class .

hpc:Resourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Logfile .

hpc:Egoresourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resourceproviderconfiguration ;
    hpc:LogFileLocation "LSF_TOP/conf/resource_connector/ego/conf/egoprov_conﬁg.json" .

hpc:Openstackresourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resourceproviderconfiguration ;
    hpc:LogFileLocation "LSF_TOP/conf/resource_connector/openstack/conf/osprov_conﬁg.json" .

hpc:Awsresourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resourceproviderconfiguration ;
    hpc:LogFileLocation "LSF_TOP/conf/resource_connector/aws/conf/awsprov_conﬁg.json" .

hpc:Azureresourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resourceproviderconfiguration ;
    hpc:LogFileLocation "LSF_TOP/conf/resource_connector/azure/conf/azureprov_conﬁg.json" .

hpc:Googleresourceproviderconfiguration a owl:Class ;
    rdfs:subClassOf hpc:Resourceproviderconfiguration ;
    hpc:LogFileLocation "LSF_TOP/conf/resource_connector/google/conf/googleprov_conﬁg.
