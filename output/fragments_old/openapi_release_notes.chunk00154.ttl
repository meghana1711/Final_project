    rdfs:subClassOf hpc:Message .

hpc:OpenapiResp a owl:Class ;
    rdfs:subClassOf hpc:Message .

hpc:UpdateNodeMsgContent a owl:DatatypeProperty ;
    rdfs:domain hpc:UpdateNodeMsg ;
    rdfs:range xsd:string .

hpc:OpenapiRespContent a owl:DatatypeProperty ;
    rdfs:domain hpc:OpenapiResp ;
    rdfs:range xsd:string .

hpc:SlurmApiRequest a owl:Class ;
    rdfs:subClassOf hpc:Message .

hpc:SlurmApiResponse a owl:Class ;
