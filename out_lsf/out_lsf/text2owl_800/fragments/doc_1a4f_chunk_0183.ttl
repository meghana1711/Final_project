hpc:Selection a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Specifies the criteria for selecting hosts from the system." .

hpc:Ordering a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Indicates how the hosts that meet the selection criteria is sorted." .

hpc:Resourceusage a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Specifies the expected resource consumption of the task." .

hpc:Jobspanning a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Job spanning section." .

hpc:Affinity a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequirement ;
    rdfs:comment "Controls CPU and memory resource allocations and specifies the distribution of processor units within a host according to the hardware topology information that LSF collects." .

hpc:hasselection a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Selection ;
    rdfs:comment "The selection section for a job." .

hpc:hasordering a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Ordering ;
    rdfs:comment "The ordering section for a job." .

hpc:hasresourceusage a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourceusage ;
    rdfs:comment "The resource usage section for a job." .

hpc:hasjobspanning a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobspanning ;
    rdfs:comment "The job spanning section for a job." .

hpc:hasaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinity ;
    rdfs:comment "The affinity section for a job." .

hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A job in the HPC system." .
