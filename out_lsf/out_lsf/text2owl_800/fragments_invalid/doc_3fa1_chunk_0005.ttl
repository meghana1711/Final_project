hpc:Jobrequest a owl:Class .

# Submission Property
hpc:jobsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range hpc:Jobsubmission .

# SubmissionError Property
hpc:jobsubmissionerror a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:boolean .

# CheckResourceReq Property
hpc:checkresourcereq a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:boolean .

# SpoolDirectory Property
hpc:spooldirectory a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:string .

# PendingJobThreshold Property
hpc:pendingjobthreshold a owl:DatatypeProperty ;
    rdfs:domain hls:User ;
    rdfs:range xsd:nonNegativeInteger .

# PendingSlotsThreshold Property
hpc:pendingslotsthreshold a owl:DatatypeProperty ;
    rdfs:domain hls:Resource ;
    rdfs:range xsd:nonNegativeInteger .

# QuietSubmission Property
hpc:quietsubmission a owl:ObjectProperty ;
    rdfs:domain hpc:Jobrequest ;
    rdfs:range xsd:boolean .

# JobPack Class
hpc:Jobpack a owl:Class .

# Configuration Class
hpc:Configuration a owl:Class .

# Subclass Relations
hpc:Jobrequest rdfs:subClassOf hpc:Job .
hpc:Jobpack rdfs:subClassOf hpc:Job .

# LSF Resource
hpc:Lsf a owl:Class .
hpc:Lsf rdfs:subClassOf hpc:Resource .

# User Resource
hpc:User a owl:Class .
hpc:User rdfs:subClassOf hpc:Resource .
