hpc:Job a owl:Class .
hpc:lsbEnableEstimation a owl:DatatypeProperty .
hpc:LsbEnableEstimation rdfs:domain hpc:Job .
hpc:LsbEnableEstimation rdfs:range xsd:string .
hpc:Estimator a owl:Class .
hpc:Estimator rdfs:subClassOf hpc:Job .
hpc:runlimit a owl:DatatypeProperty .
hpc:Runlimit rdfs:domain hpc:Job .
hpc:Runlimit rdfs:range xsd:nonNegativeInteger .
hpc:runtime a owl:DatatypeProperty .
hpc:Runtime rdfs:domain hpc:Job .
hpc:Runtime rdfs:range xsd:nonNegativeInteger .
hpc:estimatorMaxJobsPrediction a owl:DatatypeProperty .
hpc:EstimatorMaxJobsPrediction rdfs:domain hpc:Estimator .
hpc:EstimatorMaxJobsPrediction rdfs:range xsd:nonNegativeInteger .
hpc:estimatorMaxTimePrediction a owl:DatatypeProperty .
hpc:EstimatorMaxTimePrediction rdfs:domain hpc:Estimator .
hpc:EstimatorMaxTimePrediction rdfs:range xsd:nonNegativeInteger .
