hpc:tmp a owl:DatatypeProperty ;
    rdfs:domain hpc:Resourcelimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The maximum amount of tmp space available to the listed projects for any users, queues, projects, or hosts." .

hpc:Project a owl:Class ;
    rdfs:subClassOf hpc:Resourceconsumer ;
    rdfs:comment "A project in the HPC system." .

hpc:User a owl:Class ;
    rdfs:subClassOf hpc:Resourceconsumer ;
    rdfs:comment "A user in the HPC system." .

hpc:Group a owl:Class ;
    rdfs:subClassOf hpc:Resourceconsumer ;
    rdfs:comment "A group of users in the HPC system." .

hpc:Limit a owl:Class ;
    rdfs:subClassOf hpc:Resourcelimit ;
    rdfs:comment "A limit on the resources available to a resource consumer." .

hpc:users a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcelimit ;
    rdfs:range hpc:User ;
    rdfs:comment "The users or user groups on which limits are enforced." .
