hpc:Joblimit a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The maximum number of job slots that can be processed simultaneously for the specified users on each processor." .

hpc:joblimitprefemptive a owl:ObjectProperty ;
    rdfs:domain hpc:Joblimit ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job limit is for preemptive scheduling." .

hpc:joblimitnonpreemptive a owl:ObjectProperty ;
    rdfs:domain hpc:Joblimit ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the job limit is for non-preemptive scheduling." .

hpc:processorjoblimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Joblimit ;
    rdfs:range xsd:integer ;
    rdfs:comment "The job limit configured per processor." .

hpc:DashCharacter a xsd:string ;
    rdfs:isDefinedBy "http://example.org/hpc#" ;
    rdfs:comment "Indicates no limit." .

hpc:Max a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The maximum number of job slots that can be processed concurrently for the specified users' jobs." .

hpc:maxprefemptive a owl:ObjectProperty ;
    rdfs:domain hpc:Max ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the max is for preemptive scheduling." .

hpc:maxnonpreemptive a owl:ObjectProperty ;
    rdfs:domain hpc:Max ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the max is for non-preemptive scheduling." .

hpc:Lsbconfigurationfile a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The configuration file for LSF." .

hpc:maxjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbconfigurationfile ;
    rdfs:range hpc:Max ;
    rdfs:comment "The MAX defined by the MAX_JOBS parameter in the lsb.users file." .

hpc:Njobs a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "The current number of tasks for all of a users' jobs." .

hpc:Paralleljob a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "A parallel job." .

hpc:pending a owl:ObjectProperty ;
    rdfs:domain hpc:Njobs ;
    rdfs:range hpc:Paralleljob ;
    rdfs:comment "The number of tasks in all of the specified users' pending jobs." .

hpc:AllocOption a xsd:string ;
    rdfs:isDefinedBy "http://example.org/hpc#" ;
    rdfs:comment "The -alloc option." .

hpc:Total
