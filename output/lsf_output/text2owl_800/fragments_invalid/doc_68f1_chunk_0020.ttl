hpc:Reserve rdf:type owl:Class ;
    rdfs:subClassOf hpc:Others .

hpc:Reserve hpc:hasvalue rdf:value xsd:Reserve ;
    rdfs:range xsd:string .

hpc:Blstatoutput hpc:hasreserve hpc:Reserve ;
    rdfs:domain hpc:Blstatoutput ;
    rdfs:range hpc:Reserve .

hpc:Blstatoutput hpc:hasfree hpc:Free ;
    rdfs:domain hpc:Blstatoutput ;
    rdfs:range hpc:Free .

hpc:Blstatoutput hpc:hasothers hpc:Others ;
    rdfs:domain hpc:Blstatoutput ;
    rdfs:range hpc:Others .
