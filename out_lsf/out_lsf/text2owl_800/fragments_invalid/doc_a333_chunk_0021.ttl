    a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
                        rdfs:subClassOf owl:NamedIndividual ] ;
    rdfs:label "Cluster Configuration Tab" ;
    rdfs:comment "A tab showing the parameters of the experiment." .

