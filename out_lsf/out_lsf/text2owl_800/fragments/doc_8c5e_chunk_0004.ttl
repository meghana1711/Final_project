hpc:Useraccountmapping a owl:Class .
hpc:lsfuserdomain a owl:DatatypeProperty .
hpc:lsfexecutedomain a owl:DatatypeProperty .
hpc:Crossplatformjob a owl:Class .
hpc:Sameuser a owl:Class .
hpc:Differentusers a owl:Class .
hpc:sameuserdomain a owl:ObjectProperty .
hpc:differentuserdomains a owl:ObjectProperty .
hpc:Localaccount a owl:Class .
hpc:Unixuser a owl:Class .
hpc:Domainauser a owl:Class .
hpc:Domainbuser a owl:Class .
hpc:Domaincuser a owl:Class .

hpc:Useraccountmapping rdfs:subClassOf owl:Class .
hpc:Crossplatformjob rdfs:subClassOf owl:Class .
hpc:Lsfuserdomain rdfs:domain hpc:Useraccountmapping ;
                          rdfs:range xsd:string .
hpc:Lsfexecutedomain rdfs:domain hpc:Useraccountmapping ;
                        rdfs:range xsd:string .
hpc:Sameuser rdfs:subClassOf hpc:Useraccountmapping .
hpc:Differentusers rdfs:subClassOf hpc:Useraccountmapping .
hpc:Localaccount rdfs:subClassOf hpc:Useraccountmapping .
hpc:Unixuser rdfs:subClassOf hpc:Useraccountmapping .
hpc:Domainauser rdfs:subClassOf hpc:Useraccountmapping .
hpc:Domainbuser rdfs:subClassOf hpc:Useraccountmapping .
hpc:Domaincuser rdfs:subClassOf hpc:Useraccountmapping .

hpc:Sameuserdomain rdfs:domain hpc:Useraccountmapping ;
                     rdfs:range hpc:Sameuser .
hpc:Differentuserdomains rdfs:domain hpc:Useraccountmapping ;
                          rdfs:range hpc:Differentusers .
