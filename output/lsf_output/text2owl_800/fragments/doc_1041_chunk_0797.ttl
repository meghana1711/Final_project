hpc:Command a owl:Class .
hpc:Hasargument rdfs:domain hpc:Command ;
                 rdfs:range xsd:string .

hpc:Runscommand rdfs:domain hpc:Command ;
                 rdfs:range hpc:Task .

hpc:Task a owl:Class .
hpc:Hasexitstatus rdfs:domain hpc:Task ;
                  rdfs:range xsd:int .

hpc:Haserror rdfs:domain hpc:Task ;
             rdfs:range xsd:boolean .

hpc:Lsfversion rdfs:domain hpc:Command ;
             rdfs:range xsd:string .

hpc:Diagnostics rdfs:domain hpc:Command ;
                rdfs:range xsd:string .

hpc:lshosts a owl:ObjectProperty .
hpc:Lshosts rdfs:domain hpc:Command ;
             rdfs:range rdf:List .

hpc:Host a owl:Class .
hpc:Hasstaticresources rdfs:domain hpc:Host ;
                       rdfs:range rdf:List .

hpc:Resourcerequirement rdfs:domain hpc:Host ;
                        rdfs:range xsd:string .

hpc:Allhosts rdfs:domain hpc:Lshosts ;
             rdfs:range rdf:List .

hpc:Hostgroup rdfs:domain hpc:Lshosts ;
              rdfs:range xsd:string .

hpc:Clustername rdfs:domain hpc:Lshosts ;
                rdfs:range xsd:string .

hpc:Hostname rdfs:domain hpc:Lshosts ;
             rdfs:range xsd:string .

hpc:Showall rdfs:domain hpc:Lshosts ;
            rdfs:range xsd:boolean .

hpc:Resourcerequirement rdfs:domain hpc:Resourcerequirement ;
                         rdfs:range xsd:string .
