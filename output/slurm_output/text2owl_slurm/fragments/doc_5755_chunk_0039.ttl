hpc:Node a owl:Class .
hpc:Errorstate a owl:Class .
hpc:nokilloption a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
hpc:killactivejob a owl:ObjectProperty ;
    rdfs:domain hpc:Node .
hpc:killactivejobstep a owl:ObjectProperty ;
    rdfs:domain hpc:Node .
hpc:selecttype a owl:DatatypeProperty ;
    rdfs:domain hpc:Partition .
hpc:Consumableresources a owl:Class .
hpc:Linearselection a owl:Class .
hpc:oversubscribe a owl:ObjectProperty ;
    rdfs:domain hpc:Partition .
hpc:Slurmconf a owl:Class .
hpc:Slurmdlogfile a owl:Class .
hpc:Invalidjobcredential a owl:Class .
hpc:Timeinconsistency a owl:Class .
hpc:credentialtimestamp a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .
hpc:credentialexpiration a owl:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Selecttype rdfs:subClassOf hpc:Configurationparameter .
hpc:Oversubscribe rdfs:subClassOf hpc:Configurationparameter .
hpc:Node rdfs:subClassOf hpc:Computingresource .
hpc:Job rdfs:subClassOf hpc:Workload .
hpc:Partition rdfs:subClassOf hpc:Resourcecontainer .
hpc:Errorstate rdfs:subClassOf hpc:Nodestate .
hpc:Killactivejob rdfs:range hpc:Job .
hpc:Killactivejobstep rdfs:range hpc:Jobstep .
hpc:Credentialtimestamp rdfs:range hpc:Credential .
hpc:Credentialexpiration rdfs:range xsd:nonNegativeInteger .
