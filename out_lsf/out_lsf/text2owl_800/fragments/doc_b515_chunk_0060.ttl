hpc:Interruptiblebackfilljob a owl:Class .
hpc:runlimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Interruptiblebackfilljob ;
    rdfs:range xsd:nonNegativeInteger .
hpc:calculatedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Interruptiblebackfilljob ;
    rdfs:range xsd:dateTime .
hpc:Interruptiblebackfillqueue a owl:Class .
hpc:requeueexitvalues a owl:ObjectProperty ;
    rdfs:domain hpc:Interruptiblebackfillqueue ;
    rdfs:range rdf:Resource .
hpc:Resizeablejob a owl:Class .
hpc:haspriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Lowestpriorityqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue .
hpc:configuredinterruptiblebackfill a owl:DatatypeProperty ;
    rdfs:domain hpc:Interruptiblebackfillqueue ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Singleinterruptiblebackfillqueue a owl:Class ;
    rdfs:subClassOf hpc:Interruptiblebackfillqueue ;
    owl:cardinality 1 .
hpc:Requeueablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Migratedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:lsbMig2pend a owl:ObjectProperty ;
    rdfs:domain hpc:Migratedjob ;
    rdfs:range xsd:boolean .
