hpc:Jobgroup a owl:Class .
hpc:job_group_name rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:idle_time rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:integer .
hpc:delete rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup ;
    rdfs:range xsd:string .
hpc:bgdel a owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:delete .
hpc:bgadd rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:delete .
hpc:bgmod rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf hpc:modify .
hpc:modify a owl:ObjectProperty ;
    rdfs:subClassOf rdf:Property ;
    rdfs:domain hpc:Jobgroup .
hpc:limit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Modifyaction ;
    rdfs:range xsd:integer .
hpc:job_group_owner rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Modifyaction ;
    rdfs:range xsd:string .
