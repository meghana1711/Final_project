hpc:Joboption a owl:Class .

# Object Properties for Job Options
hpc:optionname a owl:ObjectProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:alias a owl:ObjectProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:category a owl:ObjectProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:type a owl:ObjectProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:maxcharacters a owl:ObjectProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:integer .

# Datatype Properties for Job Options
hpc:conflictingoptions a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:description a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .
hpc:synopsis a owl:DatatypeProperty ;
    rdfs:domain hpc:Joboption ;
    rdfs:range xsd:string .

# Specific Job Options (from the table)
hpc:A a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "allocFlags" ;
    hpc:category "resource" ;
    hpc:type "String" ;
    hpc:maxCharacters "Not applicable" .
hpc:App a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "appName" ;
    hpc:category "properties" ;
    hpc:type "String" ;
    hpc:maxCharacters "59" .
hpc:Ar a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "autoResize" ;
    hpc:category "properties" ;
    hpc:type "String" ;
    hpc:maxCharacters "0" .
hpc:B a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "notifyJobDispat" ;
    hpc:category "properties" ;
    hpc:type "String" ;
    hpc:maxCharacters "0" .
hpc:Chnotify a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "String" ;
    hpc:category "Ep postExecCmd" ;
    hpc:type "String" ;
    hpc:maxCharacters "4095" .
hpc:E a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc:alias "errorAppendFileio" ;
    hpc:category "String" ;
    hpc:type "String" ;
    hpc:maxCharacters "4095" .
hpc:Env a owl:Class ;
    rdf:type hpc:JobOption ;
    hpc
