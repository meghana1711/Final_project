hpc:Jobarray a owl:Class .

# Job Array Subclass for Non-Array Jobs
hpc:Nonarrayjob a owl:Class ;
    rdfs:subClassOf hpc:Jobarray ;
    rdfs:comment "Represents a non-array job." .

# Job Class
hpc:Job a owl:Class .

# Job Array Job Class
hpc:Jobarrayjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Represents a job that is part of a job array." .

# Job Index Property
hpc:jobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarrayjob ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Represents the index of a job within a job array." .

# Job ID Property
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobarrayjob ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the unique identifier of a job array job." .

# Input File Property
hpc:inputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Represents the input file for a job." .

# Output File Property
hpc:outputfile a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Represents the output file for a job." .

# Output File with Job Index Property
hpc:outputfilewithjobindex a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarrayjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Represents the output file for a job array job, including the job index." .

# Output File with Job ID Property
hpc:outputfilewithjobid a owl:ObjectProperty ;
    rdfs:domain hpc:Jobarrayjob ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Represents the output file for a job array job, including the job ID." .

# Command Line Argument Passing Property
hpc:commandlineargumentpassing a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Represents the command line argument passing mechanism used by a job." .

# LSB_JOBINDEX Property
hpc:lsbJobindex a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Represents the LSB_JOBINDEX environment variable used for passing job array indices on the command line." .
