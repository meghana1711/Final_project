hpc:Querylogfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Query Log File" ;
    rdfs:comment "Represents a log file where query source information is saved for easier troubleshooting." .

# Query Diagnosis Parameter Class
hpc:Querydiagnosisparameter a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Query Diagnosis Parameter" ;
    rdfs:comment "Represents a parameter that configures the query diagnosis feature." .

# Diagnose Log Directory Property
hpc:diagnoselogdir a owl:ObjectProperty ;
    rdfs:domain hpc:Querydiagnosisparameter ;
    rdfs:range hpc:Directory ;
    rdfs:label "diagnoseLogDir" ;
    rdfs:comment "Indicates the directory where the query log files are stored." .

# Enable Diagnose Property
hpc:enablediagnose a owl:ObjectProperty ;
    rdfs:domain hpc:Querydiagnoseparameter ;
    rdfs:range xsd:boolean ;
    rdfs:label "enableDiagnose" ;
    rdfs:comment "Indicates whether the query diagnosis feature is enabled or not." .

# Query Timeout Property
hpc:querytimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Querydiagnosisparameter ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "queryTimeout" ;
    rdfs:comment "Indicates the duration for which the query information is tracked before it expires." .

# Query Log File Property
hpc:querylogfile a owl:ObjectProperty ;
    rdfs:domain hpc:Querydiagnosisparameter ;
    rdfs:range hpc:Querylogfile ;
    rdfs:label "queryLogFile" ;
    rdfs:comment "Indicates the log file where the query information is saved." .

# Directory Class
hpc:Directory a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:label "Directory" ;
    rdfs:comment "Represents a directory." .
