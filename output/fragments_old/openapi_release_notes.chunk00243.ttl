hpc:postRequestBodyContent a owl:ObjectProperty .
hpc:getResponseContent a owl:ObjectProperty .
hpc:deleteResponseContent a owl:ObjectProperty .

hpc:TextYAML rdf:type xsd:string .
hpc:ApplicationJSON rdf:type xsd:string .

