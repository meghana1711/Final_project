hpc:Job a owl:Class .
hpc:User a owl:Class .
hpc:Partition a owl:Class .
hpc:suspendjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:resumejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:holdjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:releasejob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:updatejobpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:filterbyuser a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:User .
hpc:filterbypartition a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range hpc:Partition .
hpc:jobprioritymanagement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
hpc:printjobid a owl:ObjectProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:string .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:jobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Script a owl:Class .
hpc:Command a owl:Class ;
    rdfs:subClassOf hpc:Script .
