hpc:Eventlog a owl:Class .
hpc:lsbSharedir a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventlog ;
    rdfs:range xsd:string .

hpc:Clustername a owl:Class ;
    rdfs:subClassOf hpc:Eventlog .

hpc:logdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Clustername ;
    rdfs:range xsd:string .

hpc:lsbEvents a owl:DatatypeProperty ;
    rdfs:domain hpc:Clustername ;
    rdfs:range xsd:string .

hpc:Offlineanalysis a owl:Class ;
    rdfs:subClassOf hpc:Eventlog .

hpc:administratorcomment a owl:DatatypeProperty ;
    rdfs:domain hpc:Eventlog ;
    rdfs:range xsd:string .

hpc:Queue a owl:Class .

hpc:Host a owl:Class .
hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Host .

hpc:Hostgroup a owl:Class .
hpc:hostGroup a owl:ObjectProperty ;
    rdfs:domain hpc:Hostgroup ;
    rdfs:range hpc:Host .

hpc:Computeunit a owl:Class .

hpc:openbatchserverhosts a owl:ObjectProperty .
hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Openbatchserverhosts .
hpc:hostGroup a owl:ObjectProperty ;
    rdfs:domain hpc:Openbatchserverhosts .
hpc:computeUnit a owl:ObjectProperty ;
    rdfs:domain hpc:Openbatchserverhosts .

hpc:All a owl:Class .
hpc:all a owl:ObjectProperty ;
    rdfs:domain hpc:Openbatchserverhosts .

hpc:Localhost a owl:Class .
hpc:localHost a owl:ObjectProperty ;
    rdfs:domain hpc:Openbatchserverhosts .

hpc:Batchserverhost a owl:Class ;
    rdfs:subClassOf hpc:Host .

hpc:acceptsbatchjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range xsd:boolean .

hpc:EgoEnabledslascheduling a owl:Class ;
    rdfs:subClassOf hpc:Eventlog .

hpc:enablDefaultEgoSla a owl:DatatypeProperty ;
    rdfs:domain hpc:EgoEnabledslascheduling ;
    rdfs:range xsd:string .

hpc:closedbyego a owl:ObjectProperty ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range hpc:EgoEnabledslascheduling .

hpc:reopenedbybadmin a owl:ObjectProperty ;
    rdfs:domain hpc:Batchserverhost ;
    rdfs:range xsd:boolean .
