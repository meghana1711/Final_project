hpc:Job a owl:Class .

hpc:hasjobpriority a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:defaultjobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .

hpc:maxUserPriority a xsd:decimal .

hpc:userjobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:decimal .

hpc:usergroupjobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Usergroup ;
    rdfs:range xsd:decimal .

hpc:applicationjobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Applicationprofile ;
    rdfs:range xsd:decimal .

hpc:jobPriorityOverTime a xsd:decimal .

hpc:trackEligiblePendingInfo a xsd:xsd:boolean .

hpc:jobSubmissionQueuePriority a xsd:decimal .

hpc:jobpriorityescalation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobpriorityescalation .

hpc:Jobpriorityescalation a owl:Class .
