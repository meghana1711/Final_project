hpc:Host a owl:Class .
hpc:type a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:cpuarch a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:cpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:ncpus a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:maxmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:maxswp a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .
hpc:server a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:HostName rdfs:subClassOf hpc:Host .
hpc:Sunsol rdfs:subClassOf hpc:HostName ;
    owl:equivalentClass [ a owl:Class ;
                           owl:intersectionOf ( hpc:HOST_NAME
                                                  ( rdf:value "SUNSOL"^^xsd:string ) ) ] .
hpc:Rs6k rdfs:subClassOf hpc:HostName .
hpc:Ibm350 rdfs:subClassOf hpc:Rs6k .
hpc:R10k rdfs:subClassOf hpc:Rs6k .
hpc:Hppa rdfs:subClassOf hpc:HostName .
hpc:Hp715 rdfs:subClassOf hpc:Hppa .
