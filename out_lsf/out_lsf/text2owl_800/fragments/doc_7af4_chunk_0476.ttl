hpc:Preemptivejob a owl:Class .
hpc:submissiontime a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range xsd:dateTime .

hpc:pendingreason a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob .

hpc:waitingtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Graceperiod a owl:Class ;
    rdfs:subClassOf hpc:Pendingreason .

hpc:Unknownpendingreason a owl:Class ;
    rdfs:subClassOf hpc:Pendingreason .

hpc:Parameter a owl:Class .
hpc:hasparameter a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Preemptivejob ;
    rdfs:range xsd:integer .

hpc:Queue a owl:Class .
hpc:hasqueue a owl:ObjectProperty ;
    rdfs:domain hpc:Preemptivejob .

hpc:Lsbparams a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:Lsbqueues a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:Lsbapplications a owl:Class ;
    rdfs:subClassOf hpc:Parameter .

hpc:badminreconfigure a owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Action .

hpc:Defaultnotdefined a owl:Class ;
    rdfs:subClassOf hpc:Priority .
