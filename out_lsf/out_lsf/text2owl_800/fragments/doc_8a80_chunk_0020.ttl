hpc:lsPreemptPeer a owl:DatatypeProperty .
hpc:lsRootUser a owl:DatatypeProperty .

hpc:LS_PREEMPT_PEER
  rdfs:domain hpc:Projectgroup ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Enables bottom-up license token preemption in hierarchical project group configuration." .

hpc:LS_ROOT_USER
  rdfs:domain hpc:Configuration ;
  rdfs:range xsd:boolean ;
  rdfs:comment "UNIX only. Enables the root user to run LSF License Scheduler commands as a valid user from the LSF command line." .

hpc:Projectgroup a owl:Class ;
  rdfs:subClassOf hpc:Configuration .

hpc:Configuration a owl:Class .
