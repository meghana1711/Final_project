hpc:Lsloadoutput a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Output .

hpc:width a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsloadoutput ;
    rdfs:range xsd:nonNegativeInteger .

hpc:justification a owl:ObjectProperty ;
    rdfs:domain hpc:Lsloadoutput ;
    rdfs:range xsd:string ;
    rdfs:range rdfs:literal ;
    rdfs:range ^hpc:Justificationtype .

hpc:unit a owl:ObjectProperty ;
    rdfs:domain hpc:Lsloadoutput ;
    rdfs:range xsd:string ;
    rdfs:range rdfs:literal ;
    rdfs:range ^hpc:Unittype .

hpc:Builtinconversion a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:SpaceConversion a hpc:BuiltInConversion ;
    rdfs:subClassOf hpc:Conversiontype ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:TimeConversion a hpc:BuiltInConversion ;
    rdfs:subClassOf hpc:Conversiontype ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Conversiontype a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:Justificationtype a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Justification .

hpc:Unittype a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Unit .

hpc:S a hpc:SpaceConversion ;
    rdfs:subClassOf hpc:Builtinconversion .

hpc:D a hpc:TimeConversion ;
    rdfs:subClassOf hpc:Builtinconversion .

hpc:Hyphen a hpc:JustificationType ;
    rdfs:label "hyphen"@en .

hpc:Colon a hpc:UnitType ;
    rdfs:label "colon"@en .

hpc:Space a hpc:UnitType ;
    rdfs:label "space"@en .

hpc:Duration a hpc:UnitType ;
    rdfs:label "duration"@en .
