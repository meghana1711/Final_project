hpc:Logfile a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A file into which debugging messages are to be logged." .

hpc:daemonname a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the daemon associated with the log file." .

hpc:hostname a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The host name of the system where the log file is created." .

hpc:Logfileformat a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "The format of the log file." .

hpc:LogFileFormat_logfile_name_daemon_name_dot_host_name a hpc:LogFileFormat ;
    rdfs:comment "The default log file format." .

hpc:logginglevel a owl:ObjectProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The logging level for the log file." .

hpc:lsfLogMask a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The default logging level for the LSF system." .

hpc:lsbDebugRes a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The default debug settings for the LSB." .

hpc:lsbDebugLim a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The debug limits for the LSB." .

hpc:Temporarydebugsetting a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Temporary debug settings for the daemon." .

hpc:LogFile_default a hpc:LogFile ;
    rdfs:comment "The current LSF system log file in the LSF system log file directory." .
