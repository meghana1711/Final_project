@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Bootingproblems a owl:Class.
hpc:Systemadministration a owl:Class.

hpc:Nodebootfailure a owl:Class;
    rdfs:subClassOf hpc:Bootingproblems.

hpc:drainnode a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Node.

hpc:requeuejob a owl:ObjectProperty;
    rdfs:domain hpc:Job;
    rdfs:range hpc:Job.

hpc:Nodetopology a owl:Class;
    rdfs:sub
