hpc:Mixedunixwindowscluster a owl:Class .
hpc:Lsfuserdomain a owl:Class .
hpc:jobsubmission a owl:ObjectProperty .
hpc:executiondomain a owl:DatatypeProperty .
hpc:preferredexecutiondomain a owl:ObjectProperty .

hpc:Mixedunixwindowscluster rdfs:subClassOf owl:Class .
hpc:Lsfuserdomain rdfs:subClassOf owl:Class .
hpc:JobSubmission rdf:type owl:ObjectProperty .
hpc:ExecutionDomain rdf:type owl:DatatypeProperty .
hpc:PreferredExecutionDomain rdf:type owl:ObjectProperty .

hpc:Jobsubmission rdfs:domain hpc:Mixedunixwindowscluster ;
                    rdfs:range hpc:Job .

hpc:Executiondomain rdfs:domain hpc:Mixedunixwindowscluster ;
                    rdfs:range xsd:string .

hpc:Preferredexecutiondomain rdfs:domain hpc:User ;
                          rdfs:range xsd:string .

hpc:LSFUserDomain rdfs:subPropertyOf hpc:PreferredExecutionDomain .
