hpc:Paralleljob a owl:Class .
hpc:resourceusagelimit a owl:ObjectProperty .
hpc:taskswaplimit a owl:DatatypeProperty .
hpc:taskmemlimit a owl:DatatypeProperty .
hpc:jobcontrol a owl:ObjectProperty .
hpc:LsbTaskGeometry rdfs:domain hpc:Paralleljob ;
                          rdfs:range xsd:string .
hpc:LsfHpcExtensions rdfs:domain hpc:Paralleljob ;
                         rdfs:range xsd:string .
hpc:enforcesresourceusagelimit a owl:ObjectProperty .
hpc:exclusivehostexecution a owl:ObjectProperty .
hpc:Correctnodespecified rdfs:subClassOf hpc:Enforcesresourceusagelimit .
hpc:Samehostslots rdfs:subClassOf hpc:Enforcesresourceusagelimit .
hpc:Ptilevalue rdfs:domain hpc:Task ;
                   rdfs:range xsd:nonNegativeInteger .
hpc:Hostordernotguaranteed rdfs:subClassOf hpc:LsbTaskGeometry .
hpc:Canrunanygroupoftasks rdfs:subClassOf hpc:LsbTaskGeometry .
