hpc:Job a owl:Class .
hpc:jobid a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:user a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:queue a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Queue .
hpc:Pendingjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Finishedjob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:Historicaljob a owl:Class ;
    rdfs:subClassOf hpc:Job .
hpc:bjobs a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Resizablejob .
hpc:bhist a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Historicaljob .
hpc:btop a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Job .
hpc:bbot a owl:ObjectProperty ;
    rdfs:domain hpc:Lsf ;
    rdfs:range hpc:Job .
