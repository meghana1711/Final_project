hpc:Job a owl:Class .
hpc:Host a owl:Class .
hpc:Advancereservation a owl:Class .
hpc:Allocation a owl:Class .
hpc:reuseduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Allocation ;
    rdfs:range xsd:duration .
hpc:suspendedbyadvancereservationpolicy a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Advancereservation .
hpc:share a owl:ObjectProperty .
hpc:Usershare a owl:Class ;
    rdfs:subClassOf hpc:Share .
hpc:Groupshare a owl:Class ;
    rdfs:subClassOf hpc:Share .
hpc:Projectshare a owl:Class ;
    rdfs:subClassOf hpc:Share .
hpc:jobdispatchorder a owl:ObjectProperty .
hpc:Relaxjobdispatchorder a owl:Class ;
    rdfs:subClassOf hpc:Jobdispatchorder ;
    rdfs:subPropertyOf hpc:JobDispatchOrder ;
    rdfs:domain hpc:Allocation .
hpc:allocreuseduration a owl:DatatypeProperty ;
    rdfs:domain hpc:Relaxjobdispatchorder ;
    rdfs:range xsd:duration .
hpc:JobOwner a rdfs:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:FairShareGroup a rdfs:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:Project a rdfs:Property ;
    rdfs:domain hpc:Job ;
    rdfs:range rdf:Resource .
hpc:multiclustercapability a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:Boolean .
hpc:Queue a owl:Class .
hpc:queuevalue a owl:DatatypeProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:string .
