hpc:Window a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Displayed in the format begin_time-end_time, time specified in the format [day:]hour[:minute]." .

hpc:Time a owl:Class ;
    rdfs:subClassOf xsd:string ;
    rdfs:comment "Specified in the format [day:]hour[:minute], where all fields are numbers in their respective legal ranges." .

hpc:BeginTime rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Window ;
    rdfs:range xsd:string ;
    rdfs:comment "The start time of a window." .

hpc:EndTime rdf:type hpc:DatatypeProperty ;
    rdfs:domain hpc:Window ;
    rdfs:range xsd:string ;
    rdfs:comment "The end time of a window." .

hpc:User a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Allowed to submit jobs to this queue." .

hpc:Users rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:comment "A list of users who are allowed to submit jobs to this queue." .

hpc:LSFAdministrator rdf:type hpc:Class ;
    rdfs:subClassOf hpc:User ;
    rdfs:comment "LSF administrators can submit jobs to the queue even if they are not listed here." .

hpc:Usergroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "User group names have a slash (/) added at the end of the group name." .

hpc:Host a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "A list of hosts where jobs in the queue can be dispatched." .

hpc:Hostgroup a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:comment "Host group names have a slash (/) added at the end of the group name." .

hpc:NQSDestinationQueue rdf:type hpc:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range rdf:List ;
    rdfs:comment "A list of NQS destination queues to which this queue can dispatch jobs." .
