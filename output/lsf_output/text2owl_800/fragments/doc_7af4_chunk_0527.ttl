hpc:Project a owl:Class .
hpc:haslicense a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range rdf:Bag .

hpc:Memorylimit a owl:Class .
hpc:hasmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:nonNegativeInteger .

hpc:memunit a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:string .

hpc:memispercentage a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range xsd:boolean .

hpc:memforhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimit ;
    rdfs:range rdf:List .

hpc:Memorylimitonqueues a owl:Class .
hpc:hasmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memorylimitonqueues ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Memorylimitonusers a owl:Class .
hpc:hasmem a owl:DatatypeProperty ;
    rdfs:domain hpc:Memorylimitonusers ;
    rdfs:range xsd:nonNegativeInteger .

hpc:projects a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimitonqueues ;
    rdfs:range rdf:Bag .

hpc:users a owl:ObjectProperty ;
    rdfs:domain hpc:Memorylimitonusers ;
    rdfs:range rdf:Bag .

hpc:Memorylimitonqueues rdfs:subClassOf hpc:Memorylimit .
hpc:Memorylimitonusers rdfs:subClassOf hpc:Memorylimit .
