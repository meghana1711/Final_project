hpc:Maximummemory a owl:Class ;
    rdfs:label "Maximum memory" ;
    rdfs:comment "Maximum memory is the total available memory of a machine, measured in megabytes (MB)." ;
    rdfs:subClassOf owl:Real .

hpc:Maximumswap a owl:Class ;
    rdfs:label "Maximum swap" ;
    rdfs:comment "Maximum swap is the total available swap space a machine has, measured in megabytes (MB)." ;
    rdfs:subClassOf owl:Real .

hpc:Maximumtemporaryspace a owl:Class ;
    rdfs:label "Maximum temporary space" ;
    rdfs:comment "Maximum temporary space is the total temporary space that a machine has, measured in megabytes (MB)." ;
    rdfs:subClassOf owl:Real .

hpc:Ncpus a owl:Class ;
    rdfs:label "Number of CPUs" ;
    rdfs:comment "The number of CPUs in a machine." ;
    rdfs:subClassOf owl:Integer .

hpc:Processor a owl:Class ;
    rdfs:label "Processor" ;
    rdfs:comment "A processor in a machine." ;
    rdfs:subClassOf owl:Thing .

hpc:Core a owl:Class ;
    rdfs:label "Core" ;
    rdfs:comment "A core in a processor." ;
    rdfs:subClassOf owl:Thing .

hpc:Thread a owl:Class ;
    rdfs:label "Thread" ;
    rdfs:comment "A thread in a core." ;
    rdfs:subClassOf owl:Thing .

hpc:hasMaxMemory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Machine ;
    rdfs:range hpc:Maximummemory ;
    rdfs:label "hasMaxMemory" ;
    rdfs:comment "The maximum memory of a machine."

hpc:hasMaxSwap rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Machine ;
    rdfs:range hpc:Maximumswap ;
    rdfs:label "hasMaxSwap" ;
    rdfs:comment "The maximum swap of a machine."

hpc:hasMaxTemporarySpace rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Machine ;
    rdfs:range hpc:Maximumtemporaryspace ;
    rdfs:label "hasMaxTemporarySpace" ;
    rdfs:comment "The maximum temporary space of a machine."

hpc:hasNCPUs rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Machine ;
    rdfs:range hpc:Ncpus ;
    rdfs:label "hasNCPUs" ;
    rdfs:comment "The number of CPUs in a machine."

hpc:hasProcessor rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Machine ;
    rdfs:range hpc:Processor ;
    rdfs:label "hasProcessor" ;
