hpc:Validvalues a owl:Class .
hpc:Validvalues rdfs:subClassOf xsd:integer .
hpc:Validvalues rdfs:range xsd:nonNegativeInteger .

hpc:INFINIT_INT rdf:datatype xsd:integer .

hpc:Sbatchd a owl:Class .
hpc:Sbatchd rdfs:subClassOf rdf:Resource .

hpc:socket a owl:ObjectProperty .
hpc:Socket rdfs:domain hpc:Sbatchd .
hpc:Socket rdfs:range rdf:Resource .

hpc:LSB_SBD_STARTUP_RETRY_INTERVAL rdf:datatype xsd:integer .

hpc:lsbSetTmpdir a owl:ObjectProperty .
hpc:LsbSetTmpdir rdfs:domain hpc:Sbatchd .
hpc:LsbSetTmpdir rdfs:range rdf:Literal .

hpc:LSB_SET_TMPDIR_Value_Y a owl:NamedIndividual .
hpc:LSB_SET_TMPDIR_Value_Y rdf:value "y" .

hpc:LSB_SET_TMPDIR_Value_N a owl:NamedIndividual .
hpc:LSB_SET_TMPDIR_Value_N rdf:value "n" .

hpc:lsbSetTmpdirEnvVarName a owl:DatatypeProperty .
hpc:LsbSetTmpdirEnvVarName rdfs:domain hpc:LsbSetTmpdir .
hpc:LsbSetTmpdirEnvVarName rdfs:range rdf:Resource .

hpc:LSB_JOB_TMPDIR rdf:datatype xsd:resource .

hpc:LsbSharedir a owl:Class .
hpc:LsbSharedir rdfs:subClassOf rdf:Resource .

hpc:Jobhistorylog a owl:Class .
hpc:Jobhistorylog rdfs:subClassOf hpc:LsbSharedir .

hpc:Accountinglog a owl:Class .
hpc:Accountinglog rdfs:subClassOf hpc:LsbSharedir .

hpc:Directory a owl:Class .
hpc:Directory rdfs:subClassOf rdf:Resource .

hpc:JobSpecificTemporaryDirectory rdf:datatype xsd:resource .

