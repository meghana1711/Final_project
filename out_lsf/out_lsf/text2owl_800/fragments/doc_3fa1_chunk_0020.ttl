hpc:Queueleveluserbasedfairshare a owl:Class .
hpc:Userbasedfairsharepolicy a owl:Class .
hpc:Queue a owl:Class .
hpc:Job a owl:Class .
hpc:Priorityqueue a owl:Class .
hpc:fairsharepolicy a owl:ObjectProperty .
hpc:Appliestoqueue rdfs:domain hpc:Fairsharepolicy ;
                      rdfs:range hpc:Queue .
hpc:Appliestouser rdfs:domain hpc:Fairsharepolicy ;
                   rdfs:range hpc:User .
hpc:Hasdynamicsharepriority rdfs:domain hpc:User ;
                             rdfs:range xsd:decimal .
hpc:Hasqueuepriority rdfs:domain hpc:User ;
                      rdfs:range xsd:decimal .
hpc:isresizablejob a owl:ObjectProperty .
hpc:isparalleljob a owl:ObjectProperty .
hpc:Hasnumcpus rdfs:domain hpc:Paralleljob ;
                 rdfs:range xsd:nonNegativeInteger .
hpc:ispendingresizeallocationrequest a owl:ObjectProperty .
