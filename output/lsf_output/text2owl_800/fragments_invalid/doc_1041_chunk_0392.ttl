hpc:hierarchicalrelationship a owl:ObjectProperty ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

hpc:Member a owl:Class .
hpc:groupmember a owl:ObjectProperty ;
    rdfs:domain hpc:Member ;
    rdfs:range hpc:Projectgroup .

hpc:ProjectGroup hasMembers hpc:Member ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

hpc:Projectmode a owl:Class .
hpc:shareInfoFor a owl:ObjectProperty ;
    rdfs:domain hpc:Projectmode ;
    rdfs:range hpc:Projectgroup .

hpc:ProjectGroup hasProjectInfo hpc:ProjectInfo ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

hpc:ProjectGroup hasHierarchicalRelationship hpc:HierarchicalRelationship ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

hpc:ProjectGroup hasRootMember hpc:RootMember ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Member .

hpc:ProjectGroup hasMembers hpc:GroupMember ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range hpc:Member .

hpc:ProjectGroup hasGroupMembers hpc:GroupMember ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

hpc:ProjectGroup hasHierarchicalRelationships hpc:HierarchicalRelationship ;
    rdfs:domain hpc:Projectgroup ;
    rdfs:range rdf:List .

