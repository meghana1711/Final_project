hpc:MaxAcctArchiveFile a owl:Class .
hpc:acctArchiveSize a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxAcctArchiveFile ;
    rdfs:range xsd:decimal .
hpc:acctArchiveTime a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxAcctArchiveFile ;
    rdfs:range xsd:dateTime .
hpc:acctArchiveAge a owl:DatatypeProperty ;
    rdfs:domain hpc:MaxAcctArchiveFile ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Jobfinishrecord a owl:Class .
hpc:sizeofjobfinishrecord a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobfinishrecord ;
    rdfs:range xsd:nonNegativeInteger .
hpc:totalnumberofrecordsinlsbacct a owl:DatatypeProperty ;
    rdfs:domain hpc:Jobfinishrecord ;
    rdfs:range xsd:nonNegativeInteger .
