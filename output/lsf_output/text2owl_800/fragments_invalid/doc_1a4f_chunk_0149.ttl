hpc:Jobgroup a owl:Class .
hpc:Job a owl:Class .
hpc:Jobowner a owl:Class .
hpc:Jobgroupowner a owl:Class .
hpc:jobgrouphierarchy a owl:ObjectProperty ;
    rdfs:domain hpc:Jobgroup .
    rdfs:range rdf:List .
hpc:jobgroupmembership a owl:ObjectProperty ;
    rdfs:domain hpc:Job .
    rdfs:range hpc:Jobgroup .
hpc:jobcontrol a owl:ObjectProperty .
hpc:jobsubmission a owl:ObjectProperty .
hpc:defaultjobgroup a owl:DatatypeProperty ;
    rdfs:range xsd:string .
hpc:Jobgroup a rdfs:subClassOf hpc:Resource .
hpc:Job a rdfs:subClassOf hpc:Resource .
hpc:Jobowner a rdfs:subClassOf hpc:User .
hpc:Jobgroupowner a rdfs:subClassOf hpc:User .
hpc:Jobgrouphierarchy rdfs:domain hpc:Jobgroup .
hpc:Jobgrouphierarchy rdfs:range hpc:Jobgroup .
hpc:Jobgroupmembership rdfs:domain hpc:Job .
hpc:Jobgroupmembership rdfs:range hpc:Jobgroup .
hpc:Jobcontrol rdfs:domain hpc:User .
hpc:Jobcontrol rdfs:range hpc:Job .
hpc:Jobsubmission rdfs:domain hpc:User .
hpc:Jobsubmission rdfs:range hpc:Job .
hpc:Jobgroupowner rdfs:subClassOf hpc:Jobgroupmember .
hpc:JobGroupHierarchy rdfs:subPropertyOf rdf:list .
hpc:JobControl rdfs:subPropertyOf rdf:type .
hpc:JobSubmission rdfs:subPropertyOf rdf:type .
hpc:JobGroupMembership rdfs:subPropertyOf rdf:type .
