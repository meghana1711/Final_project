hpc:Lsf a owl:Class .
hpc:Offloadingdaemon a owl:Class ;
    rdfs:subClassOf hpc:Lsf .

hpc:Lsfratelimiter a owl:Class ;
    rdfs:subClassOf hpc:Offloadingdaemon .

hpc:Lsfproxyd a owl:Class ;
    rdfs:subClassOf hpc:Offloadingdaemon .

hpc:Lsfdaemons a owl:Class ;
    rdfs:subClassOf hpc:Lsf ;
    rdfs:subClassOf hpc:Offloadingdaemon .

hpc:enableDiagnose a owl:ObjectProperty .
hpc:diagnoseLogdir a owl:DatatypeProperty .

hpc:Diagnoseschedulerbuckets a owl:Class .
hpc:Schedulerbucketssnapshot a owl:Class ;
    rdfs:subClassOf hpc:Diagnoseschedulerbuckets .

hpc:Schedulingcycle a owl:Class .

hpc:jobreqSnapshotfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerbucketssnapshot ;
    rdfs:range xsd:string .

hpc:snapshotfileformat a owl:DatatypeProperty ;
    rdfs:domain hpc:JobreqSnapshotfile ;
    rdfs:range xsd:string .

hpc:snapshotfilelocation a owl:DatatypeProperty ;
    rdfs:domain hpc:Schedulerbucketssnapshot ;
    rdfs:range xsd:string .

hpc:schedulerbucketssnapshotfile a owl:ObjectProperty ;
    rdfs:domain hpc:Schedulerbucketssnapshot ;
    rdfs:range hpc:JobreqSnapshotfile .

hpc:savesnapshot a owl:ObjectProperty ;
    rdfs:domain hpc:Diagnoseschedulerbuckets ;
    rdfs:range hpc:Schedulerbucketssnapshot .

hpc:customsnapshotfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Savesnapshot ;
    rdfs:range xsd:string .

hpc:snapshotformat a owl:DatatypeProperty ;
    rdfs:domain hpc:Savesnapshot ;
    rdfs:range xsd:string .
