hpc:DockerVersion
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:InstalledVersion
    a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerce ;
    rdfs:range hpc:Dockerversion .

hpc:Running
    a owl:ObjectProperty ;
    rdfs:domain hpc:Dockerce ;
    rdfs:range xsd:boolean .

hpc:PortNotInUse
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:AvailablePorts
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range rdf:List ;
    rdfs:subPropertyOf hpc:hasProperty .

hpc:Port
    a owl:DatatypeProperty ;
    rdfs:domain rdf:List ;
    rdfs:range xsd:integer .

hpc:InternetAccess
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:boolean .

hpc:LSFServerOrClient
    a owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Lsfserverorclient .

hpc:LSFServerOrClientType
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfserverorclient ;
    rdfs:range hpc:Lsfserverorclienttype .

hpc:Memory
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:decimal .

hpc:InstallationDirectory
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:InstallationPackage
    a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/2001/XMLSchema#string> .

hpc:FreeSpace
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationdirectory ;
    rdfs:range xsd:decimal .

hpc:AbsolutePath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationdirectory ;
    rdfs:range xsd:boolean .

hpc:SymbolicLinkInPath
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Installationdirectory ;
    rdfs:range xsd:boolean .

hpc:LicenseAgreement
    a owl:ObjectProperty ;
    rdfs:domain hpc:Installationpackage ;
    rdfs:range hpc:Licenseagreement .

hpc:MaxVirtualMemory
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Host
