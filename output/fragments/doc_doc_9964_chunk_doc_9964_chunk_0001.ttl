hpc:WCKey a owl:Class .
hpc:AccountingStorageEnforce rdf:type owl:ObjectProperty .
hpc:TrackWCKey rdf:type owl:ObjectProperty .
hpc:SlurmConf rdf:type owl:Class .
hpc:SlurmdbdConf rdf:type owl:Class .
hpc:SubmittingTool rdf:type owl:Class .
hpc:Sbatch rdf:type hpc:SubmittingTool ;
    hpc:hasOption "wckey" .
hpc:Salloc rdf:type hpc:SubmittingTool ;
    hpc:hasOption "wckey" .
hpc:Srun rdf:type hpc:SubmittingTool ;
    hpc:hasOption "wckey" .
hpc:WCKeyOnJob rdf:type owl:Class .
hpc:DefaultWCKey rdf:type owl:Class .
hpc:WCKeyTracked rdf:type owl:Class .
hpc:WCKeyNotSpecified rdf:type owl:Class .
hpc:WCKeyInAccountingRecord rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:WCKeyOnJob ;
    rdfs:range xsd:string .
hpc:WCKeyForJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:WCKeyOnJob ;
    rdfs:range hpc:WCKey .
hpc:WCKeyForDefault rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:DefaultWCKey ;
    rdfs:range hpc:WCKey .
hpc:WCKeyInSlurmConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:WCKey .
hpc:WCKeyInSlurmdbdConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmdbdConf ;
    rdfs:range hpc:WCKey .
hpc:WCKeyTrackedInSlurmConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmConf ;
    rdfs:range hpc:WCKeyTracked .
hpc:WCKeyTrackedInSlurmdbdConf rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:SlurmdbdConf ;
    rdfs:range hpc:WCKeyTracked .
hpc:WCKeyEnforced rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:AccountingStorageEnforce ;
    rdfs:range hpc:WCKeyOnJob .
hpc:WCKeyTrackedBySacct rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:WCKeyTracked ;
    rdfs:range hpc:Sacct .
hpc:WCKeyViewableBySacct rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:WCKeyOnJob ;
    rdfs:range hpc:Sacct .
hpc:WCKeysInSacct rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Sacct ;
