hpc:Melim a owl:Class .
hpc:elimAbortValue a xsd:string .
hpc:Elimmarked a owl:Class .
hpc:Managementelim a owl:Class .
hpc:Host a owl:Class .
hpc:jobGpuVendor a owl:ObjectProperty .
hpc:Allowedgpuvendor a owl:Class .
hpc:Amd a owl:Class .
hpc:Nvidia a owl:Class .
hpc:lsExecT a owl:ObjectProperty .
hpc:Start a owl:Class .
hpc:End a owl:Class .
hpc:Chkpnt a owl:Class .
hpc:Jobcontrols a owl:Class .
hpc:Sbatchd a owl:Class .
hpc:Jobexecution a owl:Class .
hpc:lsJobpid a owl:DatatypeProperty .
hpc:processID a xsd:integer .
hpc:lsSubcwd a owl:DatatypeProperty .
hpc:currentWorkingDirectory a xsd:string .
hpc:pwd a owl:ObjectProperty .
hpc:Submissionhost a owl:Class .
hpc:LsJobpid rdfs:domain hpc:Jobexecution ;
    rdfs:range hpc:Processid .
hpc:LsSubcwd rdfs:domain hpc:Jobexecution ;
    rdfs:range hpc:Currentworkingdirectory .
hpc:Pwd rdfs:domain hpc:Submissionhost ;
    rdfs:range hpc:LsSubcwd .
hpc:JobGpuVendor rdfs:domain hpc:Managementelim ;
    rdfs:range hpc:Allowedgpuvendor .
hpc:Allowedgpuvendor rdfs:subClassOf hpc:JobGpuVendor ;
    rdfs:subClassOf hpc:Amd, hpc:Nvidia .
