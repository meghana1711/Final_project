hpc:Template a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:imagename a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:flavorname a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:maxnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:nonNegativeInteger .

hpc:LSFMaxNumber rdfs:subPropertyOf hpc:maxNumber ;
    rdfs:comment "The maximum number of available instances of this template." .

hpc:userscript a owl:ObjectProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:userdata a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .

hpc:UserDataKeys rdfs:subPropertyOf hpc:UserData ;
    rdfs:comment "Each key is converted to uppercase and exported as an environment variable with the specified value inside the instance." .

hpc:UserDataValues rdfs:subPropertyOf hpc:UserData ;
    rdfs:comment "Each value associated with a key in the UserData property." .

hpc:EnvironmentVariable rdfs:subPropertyOf hpc:UserData ;
    rdfs:comment "The environment variable that is exported inside the instance at start time." .

hpc:priority a owl:DatatypeProperty ;
    rdfs:domain hpc:Template ;
    rdfs:range xsd:string .
