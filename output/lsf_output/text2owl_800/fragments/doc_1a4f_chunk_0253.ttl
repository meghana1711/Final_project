hpc:Job a owl:Class .
hpc:Resourceconsumer a owl:Class .
hpc:Resourceallocationlimit a owl:Class .
hpc:Resource rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range xsd:string .
hpc:AppliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range hpc:Resourceconsumer .
hpc:MaximumResource rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Resourceallocationlimit ;
    rdfs:range xsd:decimal .
hpc:JobRequiresResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .
hpc:ResourceConsumedBy rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Resource ;
    rdfs:range hpc:Resourceconsumer .
