hpc:egoLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer .

hpc:lsfLimPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer ;
    rdfs:comment "Default port number for LSF on UNIX" .

hpc:lsfResPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer ;
    rdfs:comment "Default port number for LSF resources" .

hpc:lsbMbdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer ;
    rdfs:comment "Default port number for LSB MBD" .

hpc:lsbSbdPort a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer ;
    rdfs:comment "Default port number for LSB SBD" .

hpc:lsfLimStartupRetryInterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:integer ;
    rdfs:comment "Time before lim tries again if initialization failed" .

hpc:lsfLimStartupRetryTimes a owl:DatatypeProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Maximum number of times for lim to repeat attempts to initialize a socket" .

hpc:lsfLinuxCgroupAcct a owl:ObjectProperty ;
    rdfs:domain hpc:Service ;
    rdfs:range hpc:Boolean ;
    rdfs:comment "Enable cgroup accounting for Linux systems" .
