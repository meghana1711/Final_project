hpc:Computersystem a owl:Class .
hpc:hascpu a owl:ObjectProperty .
hpc:Cpu a owl:Class .
hpc:cputype a owl:DatatypeProperty .
hpc:Cputype rdfs:range xsd:string .
hpc:hasmemory a owl:DatatypeProperty .
hpc:Hasmemory rdfs:range xsd:decimal .
hpc:Memorysize a owl:Class .
hpc:memorytype a owl:DatatypeProperty .
hpc:Memorytype rdfs:range xsd:string .
hpc:Computersystem rdfs:subClassOf [ a owl:Class ;
                                      rdfs:subClassOf owl:Thing ] .
hpc:Cpu rdfs:subClassOf hpc:Computercomponent .
hpc:Memory rdfs:subClassOf hpc:Computercomponent .
hpc:Computercomponent a owl:Class .
hpc:Hascpu rdfs:domain hpc:Computersystem .
hpc:Hasmemory rdfs:domain hpc:Computersystem .
