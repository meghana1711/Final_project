hpc:Bconf a owl:Class .
hpc:Liveconfiguration a owl:Class .
hpc:lsfLiveConfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Bconf ;
    rdfs:range xsd:string .
hpc:lsfConfdir a owl:DatatypeProperty ;
    rdfs:domain hpc:Bconf ;
    rdfs:range xsd:string .
hpc:bconfhist a owl:ObjectProperty ;
    rdfs:domain hpc:Bconf ;
    rdfs:range hpc:Liveconfiguration .
hpc:bconf a owl:ObjectProperty ;
    rdfs:domain hpc:Bconf ;
    rdfs:range hpc:Liveconfiguration .
hpc:liveconfdir a owl:ObjectProperty ;
    rdfs:domain hpc:Liveconfiguration ;
    rdfs:range xsd:string .
hpc:logdir a owl:ObjectProperty ;
    rdfs:domain hpc:Liveconfiguration ;
    rdfs:range xsd:string .
hpc:Configurationchange a owl:Class ;
    rdfs:subClassOf hpc:Liveconfiguration .
hpc:historyfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Configurationchange ;
    rdfs:range xsd:string .
hpc:affectsperformance a owl:ObjectProperty ;
    rdfs:domain hpc:Configurationchange ;
    rdfs:range xsd:boolean .
hpc:supportedbybconf a owl:ObjectProperty ;
    rdfs:domain hpc:Configurationchange ;
    rdfs:range xsd:boolean .
hpc:overwriteoriginalfiles a owl:ObjectProperty ;
    rdfs:domain hpc:Bconf ;
    rdfs:range xsd:boolean .
