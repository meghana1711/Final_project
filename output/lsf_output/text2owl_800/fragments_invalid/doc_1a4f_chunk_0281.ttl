hpc:Job a owl:Class .
hpc:Hostmodel a owl:Class .
hpc:CPUScalingFactor rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hostmodel ;
    rdfs:range xsd:decimal .

hpc:Runlimit a owl:Class ;
    rdfs:subClassOf hpc:Job .

hpc:AbsoluteRunLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit ;
    rdfs:range xsd:boolean .

hpc:NormalizedRunLimit rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Runlimit .

hpc:ThreadLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:DefaultThreadLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Queue .
    rdfs:range xsd:integer .

hpc:LSBParamsFile rdf:type owl:Class .
hpc:ABSRunlimit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparamsfile ;
    rdfs:range xsd:boolean .

hpc:LSFMulticlusterCapability rdf:type owl:Class .
hpc:LSFMulticlusterJob rdf:type owl:Class ;
    rdfs:subClassOf hpc:Runlimit ;
    rdfs:subClassOf hpc:Lsfmulticlustercapability .

hpc:FastestHost rdf:type owl:Class ;
    rdfs:subClassOf hpc:Hostmodel .
