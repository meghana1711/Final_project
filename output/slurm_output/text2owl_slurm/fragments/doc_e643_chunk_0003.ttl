hpc:Slurm a owl:Class .
hpc:Nssslurm a owl:Class .
hpc:Slurmd a owl:Class .
hpc:Slurmctld a owl:Class .
hpc:nodename a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:string .
hpc:slurmdspooldir a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmd ;
    rdfs:range xsd:string .
hpc:Jobstep a owl:Class .
hpc:Process a owl:Class ;
    rdfs:subClassOf hpc:Jobstep .
hpc:Systemmonitoring a owl:Class ;
    rdfs:subClassOf hpc:Process .
hpc:Nodehealthcheck a owl:Class ;
    rdfs:subClassOf hpc:Process .
hpc:Prologscript a owl:Class ;
    rdfs:subClassOf hpc:Process .
hpc:Epilogscript a owl:Class ;
    rdfs:subClassOf hpc:Process .
hpc:Nodesystemprocess a owl:Class ;
    rdfs:subClassOf hpc:Process .
hpc:Networkdirectoryservice a owl:Class .
hpc:Ldap a owl:Class ;
    rdfs:subClassOf hpc:Networkdirectoryservice .
hpc:Thunderingherdissue a owl:Class .
hpc:pgid a owl:DatatypeProperty ;
    rdfs:domain hpc:Nssslurm ;
    rdfs:range xsd:integer .
hpc:Session a owl:Class .
hpc:Interactivesalloc a owl:Class ;
    rdfs:subClassOf hpc:Interactivesession .
hpc:defaultshell a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmctld ;
    rdfs:range xsd:string .
hpc:proctrackpgid a owl:ObjectProperty .
hpc:Srunptysession a owl:Class ;
    rdfs:subClassOf hpc:Session .
