hpc:Host a owl:Class .
hpc:Memory a owl:Class .
hpc:Cpu a owl:Class .
hpc:Core a owl:Class .
hpc:Thread a owl:Class .
hpc:Socket a owl:Class .
hpc:Numa a owl:Class .

hpc:hasmemory a owl:ObjectProperty .
hpc:hascpu a owl:ObjectProperty .
hpc:hascore a owl:ObjectProperty .
hpc:hasthread a owl:ObjectProperty .
hpc:hassocket a owl:ObjectProperty .
hpc:hasnuma a owl:ObjectProperty .

hpc:Memory rdfs:domain hpc:Host .
hpc:Cpu rdfs:domain hpc:Host .
hpc:Core rdfs:domain hpc:Host .
hpc:Thread rdfs:domain hpc:Core .
hpc:Socket rdfs:domain hpc:Host .
hpc:Numa rdfs:domain hpc:Host .

hpc:Hasmemory rdfs:range xsd:decimal .
hpc:Hascpu rdfs:range xsd:nonNegativeInteger .
hpc:Hascore rdfs:range xsd:nonNegativeInteger .
hpc:Hasthread rdfs:range xsd:nonNegativeInteger .
hpc:Hassocket rdfs:range xsd:nonNegativeInteger .
hpc:Hasnuma rdfs:range hpc:Numa .

hpc:Host_1 a hpc:Host ;
    hpc:hasMemory "64.0"^^xsd:decimal ;
    hpc:hasCPU "2"^^xsd:nonNegativeInteger ;
    hpc:hasCore "12"^^xsd:nonNegativeInteger ;
    hpc:hasThread "24"^^xsd:nonNegativeInteger ;
    hpc:hasSocket "2"^^xsd:nonNegativeInteger ;
    hpc:hasNUMA [
        a hpc:NUMA ;
        hpc:hasMemory [
            a rdf:List ;
            rdf:first "32.0"^^xsd:decimal ;
            rdf:rest [
                a rdf:List ;
                rdf:first "0"^^xsd:nonNegativeInteger ;
                rdf:rest nil
            ]
        ] ;
        hpc:hasNUMA [
            a rdf:List ;
            rdf:first "32.0"^^xsd:decimal ;
            rdf:rest [
                a rdf:List ;
                rdf:first "0"^^xsd:nonNegativeInteger ;
                rdf:rest nil
            ]
        ]
    ] .

hpc:Core_0 a hpc:Core ;
    hpc:hasThread "2"^^xsd:nonNegativeInteger ;
    hpc:hasCPU "Host_1"^^xsd:string .

hpc:Core1 rdfs:subClassOf hpc:Core ;
    hpc:hasThread "2"^^xsd:nonNegativeInteger ;
    hpc:hasCPU "Host_1"^^xsd:string .

hpc:Core2 rdfs:subClassOf hpc:Core ;
