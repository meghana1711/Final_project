hpc:Podmancontainerjob a owl:Class .
hpc:hasexecutiondriver a owl:ObjectProperty .
hpc:Hasexecutiondriver rdfs:domain hpc:Podmancontainerjob ;
                          rdfs:range xsd:string .
hpc:requiresuserkeyword a owl:ObjectProperty .
hpc:Requiresuserkeyword rdfs:domain hpc:Podmancontainerjob ;
                          rdfs:range xsd:string .
hpc:requiresstarterfilepermission a owl:DatatypeProperty .
hpc:Requiresstarterfilepermission rdfs:domain hpc:Podmancontainerjob ;
                                     rdfs:range xsd:integer .
hpc:requiresmonitorfilepermission a owl:DatatypeProperty .
hpc:Requiresmonitorfilepermission rdfs:domain hpc:Podmancontainerjob ;
                                     rdfs:range xsd:integer .
hpc:isignoredforpodmanjob a owl:ObjectProperty .
hpc:Isignoredforpodmanjob rdfs:domain hpc:Podmancontainerjob ;
                            rdfs:range xsd:boolean .
hpc:Enrootcontainerjob a owl:Class .
hpc:hasexecutiondriverforenroot a owl:ObjectProperty .
hpc:Hasexecutiondriverforenroot rdfs:domain hpc:Enrootcontainerjob ;
                                 rdfs:range xsd:string .
hpc:requiresstarterfilepermissionforenroot a owl:DatatypeProperty .
hpc:Requiresstarterfilepermissionforenroot rdfs:domain hpc:Enrootcontainerjob ;
                                             rdfs:range xsd:integer .
hpc:ExecDriver a owl:Class .
hpc:isforpodmancontainerjob a owl:ObjectProperty .
hpc:Isforpodmancontainerjob rdfs:domain hpc:ExecDriver ;
                              rdfs:range hpc:Podmancontainerjob .
hpc:isforenrootcontainerjob a owl:ObjectProperty .
hpc:Isforenrootcontainerjob rdfs:domain hpc:ExecDriver ;
                              rdfs:range hpc:Enrootcontainerjob .
