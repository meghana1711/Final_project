hpc:Hostevaluationthread a owl:Class .
hpc:Numberofhostsforthread rdfs:domain hpc:Hostevaluationthread ;
                            rdfs:range xsd:integer .
hpc:Numberofthreads rdfs:domain hpc:Hostevaluationthread ;
                     rdfs:range xsd:integer .
hpc:Availablecpusonmanagementhost rdfs:domain hpc:Hostevaluationthread ;
                                   rdfs:range xsd:integer .
hpc:Schedulingperformancemetrics rdfs:domain hpc:Hostevaluationthread ;
                                 rdfs:range xsd:string .
hpc:schGpdTimeout a owl:DatatypeProperty ;
                     rdfs:domain hpc:Hostevaluationthread ;
                     rdfs:range xsd:integer .
hpc:SCH_GPD_TIMEOUT_DEFAULT a xsd:integer .
hpc:secureInfodirUserAccess a owl:ObjectProperty .
hpc:SecureInfodirUserAccessAllowedValues rdfs:domain hpc:SecureInfodirUserAccess ;
                                               rdfs:range xsd:string .
hpc:LsbAdministrator rdfs:subClassOf hpc:User .
hpc:User rdfs:subClassOf owl:Class .
