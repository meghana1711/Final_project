hpc:User a owl:Class .
hpc:UserDirectory a owl:Class .
hpc:HDF5File a owl:Class .
hpc:SlurmdUser a owl:Class .
hpc:ProfileHDF5Dir a owl:Class .

hpc:hasDirectory a owl:ObjectProperty ;
    rdfs:domain hpc:User .
    rdfs:range hpc:UserDirectory .

hpc:createdBy a owl:ObjectProperty ;
    rdfs:domain hpc:HDF5File .
    rdfs:range hpc:SlurmdUser .

hpc:ownedBy a owl:ObjectProperty ;
    rdfs:domain hpc:UserDirectory .
    rdfs:range hpc:User .

hpc:chownedTo a owl:ObjectProperty ;
    rdfs:domain hpc:UserDirectory .
    rdfs:range xsd:string .

hpc:ProfileHDF5Dir a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
                        owl:onProperty hpc:hasDirectory ;
                        owl:hasValue ?path ;
                        rdfs:someValuesFrom [ a xsd:string ] ] .

hpc:hasConfigParameter a owl:ObjectProperty ;
    rdfs:domain hpc:ProfileHDF5Dir .
    rdfs:range xsd:string .

hpc:AcctGatherProfileType a owl:DatatypeProperty ;
    rdfs:domain hpc:ProfileHDF5Dir .
    rdfs:range xsd:string .

hpc:JobAcctGatherFrequency a owl:DatatypeProperty ;
    rdfs:domain hpc:ProfileHDF5Dir .
    rdfs:range xsd:nonNegativeInteger .

hpc:ProfileHDF5Default a owl:DatatypeProperty ;
    rdfs:domain hpc:ProfileHDF5Dir .
    rdfs:range xsd:string .

hpc:ProfileHDF5DirRequired a owl:ObjectProperty ;
    rdfs:domain hpc:ProfileHDF5Dir .
    rdfs:range xsd:boolean .
```
