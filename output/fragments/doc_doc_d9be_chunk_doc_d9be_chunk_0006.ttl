hpc:Job a owl:Class .
hpc:Step a owl:Class, rdfs:subClassOf hpc:Job .
hpc:Task a owl:Class, rdfs:subClassOf hpc:Step .
hpc:CPU a owl:Class .
hpc:Node a owl:Class .
hpc:CPUAllocation a owl:Class .
hcp:CPUBinding a owl:Class .
hpc:TaskAffinity a owl:Class .
hpc:selectOrLinearAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Node ;
    rdfs:range hpc:Job .
hpc:hasCPU a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:CPUAllocation .
hpc:hasAllocatedCPU a owl:ObjectProperty ;
    rdfs:domain hpc:CPUAllocation ;
    rdfs:range hpc:CPU .
hpc:hasBoundCPU a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:integer .
hpc:hasAffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range hpc:TaskAffinity .
hpc:isAbstractCPU a owl:DatatypeProperty ;
    rdfs:domain hpc:CPU .
hpc:isMachineCPU a owl:DatatypeProperty ;
    rdfs:domain hpc:CPU .
```
