hpc:State a owl:Class .
hpc:suspendingreason a owl:ObjectProperty .
hpc:Loadindex rdfs:domain hpc:State ;
    rdfs:range xsd:string .
hpc:SbdSleepTime rdfs:domain hpc:State ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Currentloadsituation rdfs:subClassOf hpc:State ;
    rdfs:label "CurrentLoadSituation" .
hpc:Bjobs a owl:Class .
hpc:bjobsS a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .
hpc:bjobsPs a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .
hpc:bjobsScript a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf hpc:bjobs_s .
hpc:BjobsScriptJobid rdfs:domain hpc:BjobsScript ;
    rdfs:range xsd:positiveInteger .
hpc:bjobsSla a owl:ObjectProperty ;
    rdfs:domain hpc:Bjobs ;
    rdfs:range xsd:string .
hpc:BjobsSlaServiceClassName rdfs:domain hpc:BjobsSla ;
    rdfs:range xsd:string .
hpc:BjobsSlaJobgroup rdfs:domain hpc:BjobsSla ;
    rdfs:range xsd:string .
hpc:BjobsSlaTimebasedserviceclass rdfs:domain hpc:BjobsSla ;
    rdfs:range xsd:boolean .
hpc:bjobsG a owl:ObjectProperty ;
    rdfs:domain hpc:BjobsSla ;
    rdfs:range xsd:string .
hpc:Filter a owl:Class .
