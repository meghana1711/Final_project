# Cluster
hpc:Cluster a owl:Class .

# License
hpc:License a owl:Class .

# Server
hpc:Server a owl:Class .

# LicenseServerType
hpc:LicenseServerType a owl:Class .

# LicenseHost
hpc:LicenseHost a owl:Class ;
    rdfs:subClassOf hpc:Server .

# Remote
hpc:Remote a owl:ObjectProperty ;
    rdfs:domain hpc:LicenseHost ;
    rdfs:range xsd:boolean .

# Total
hpc:Total a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

# Used
hpc:Used a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

# Free
hpc:Free a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

# Reserved
hpc:Reserved a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

# Remote
hpc:Remote a owl:ObjectProperty ;
    rdfs:domain hpc:LicenseHost ;
    rdfs:range xsd:boolean .

# LastConsumed
hpc:LastConsumed a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:string .

# LastDeficit
hpc:LastDeficit a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:nonNegativeInteger .

# LastUpdate
hpc:LastUpdate a owl:DatatypeProperty ;
    rdfs:domain hpc:License ;
    rdfs:range xsd:dateTime .

# Cluster_has_License
hpc:Cluster_has_License a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range hpc:License .

# License_has_Server
hpc:License_has_Server a owl:ObjectProperty ;
    rdfs:domain hpc:License ;
    rdfs:range hpc:LicenseHost .

# Server_has_Type
hpc:Server_has_Type a owl:ObjectProperty ;
    rdfs:domain hpc:Server ;
    rdfs:range hpc:LicenseServerType .

# License_has_Count
