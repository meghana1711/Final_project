hpc:LastPeriod
    a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Last sampling value of metric." .

hpc:Lastperiod rdfs:subClassOf hpc:Metricvalue .

hpc:Lastperiod rdfs:domain hpc:Samplingperiod ;
    rdfs:range hpc:Metricvalue .

hpc:LastPeriod rdfs:subPropertyOf hpc:normalizedLastPeriod .

hpc:normalizedLastPeriod
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lastperiod ;
    rdfs
