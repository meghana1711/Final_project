hpc:Slurmjob a owl:Class .
hpc:HostsFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmjob ;
    rdfs:range xsd:string .

hpc:SlurmOptions rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmjob ;
    rdfs:range xsd:string .

hpc:Command rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmjob ;
    rdfs:range xsd:string .

hpc:OvercommitOption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmoptions ;
    rdfs:range xsd:boolean .

hpc:OversubscribeOption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmoptions ;
    rdfs:range xsd:boolean .

hpc:UnbufferedOption rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Slurmoptions ;
    rdfs:range xsd:boolean .
