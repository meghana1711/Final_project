hpc:Host a owl:Class .
hpc:hasFullyQualifiedHostName an rdfs:Property ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:licenseSchedulerListeningPort an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:lmstatInterval an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:lmstatPath an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:timeout an owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .

hpc:blcstat an owl:ObjectProperty .
