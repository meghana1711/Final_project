hpc:Computersystem a owl:Class .
hpc:hasprocessor a owl:ObjectProperty .
hpc:hasmemory a owl:DatatypeProperty .
hpc:Processor rdfs:domain hpc:Computersystem ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Memory rdfs:domain hpc:Computersystem ;
    rdfs:range xsd:nonNegativeInteger .
hpc:Server a owl:Class ;
    rdfs:subClassOf hpc:Computersystem .
