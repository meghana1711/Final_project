hpc:LmType a owl:Class .
hpc:LmStatPerFeature a owl:Class .
hpc:lmStatTimeout a owl:DatatypeProperty .

hpc:LmType rdfs:subClassOf owl:Class .
hpc:LmStatPerFeature rdfs:subClassOf owl:Class .
hpc:LmStatTimeout rdfs:subClassOf owl:DatatypeProperty .

hpc:hasLMType rdf:type owl:ObjectProperty .
hpc:hasLMStatPerFeature rdf:type owl:ObjectProperty .
hpc:hasLMStatTimeout rdf:type owl:DatatypeProperty .

hpc:Haslmtype rdfs:domain hpc:LmType ;
    rdfs:range xsd:string .
hpc:Haslmstatperfeature rdfs:domain hpc:LmType ;
    rdfs:range xsd:boolean .
hpc:Haslmstattimeout rdfs:domain hpc:LmType ;
    rdfs:range xsd:nonNegativeInteger .

hpc:FLEXLM a owl:NamedIndividual ;
    hpc:hasLMType "FLEXLM" .
hpc:RLM a owl:NamedIndividual ;
    hpc:hasLMType "RLM" .

hpc:collectDataForAllFeatures a owl:NamedIndividual ;
    hpc:hasLMStatPerFeature false .
hpc:collectDataForSpecificFeatures a owl:NamedIndividual ;
    hpc:hasLMStatPerFeature true .

hpc:globalValue a owl:NamedIndividual ;
    hpc:hasLMStatPerFeature false .
hpc:serviceDomainValue a owl:NamedIndividual ;
    hpc:hasLMStatPerFeature true .
hpc:commandLineValue a owl:NamedIndividual ;
    hpc:hasLMStatPerFeature ignored .
