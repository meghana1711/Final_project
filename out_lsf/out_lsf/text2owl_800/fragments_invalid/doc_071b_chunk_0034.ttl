hpc:Host a owl:Class .
hpc:HostType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:HostArchitecture rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:TotalNUMANodes rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:TotalProcessors rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:TotalCores rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:TotalThreads rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
hpc:MatchedType rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:MatchedArchitecture rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:MatchedModel rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .
hpc:CPUMultiplier rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:float .

# Job exit rate and load properties
hpc:CurrentLoad rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Load .
hpc:CurrentLoadValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Currentload ;
    rdfs:range xsd:float .
hpc:CurrentLoadUnit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Currentload ;
    rdfs:range xsd:string .
hpc:LoadThreshold rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range hpc:Loadthreshold .
hpc:LoadThresholdValue rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Loadthreshold ;
    rdfs:range xsd:float .
hpc:LoadThresholdUnit rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Loadthreshold ;
    rdfs:range xsd:string .
hpc:ExceptionalHost rdf:type owl:Class .
hpc:JobExitRate rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Exceptionalhost ;
    rdfs:range xsd:float .
hpc:JobExitRateDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Exceptionalhost ;
