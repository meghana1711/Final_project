hpc:Slurmtestsuite a owl:Class .
hpc:slurmDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmtestsuite ;
    rdfs:range xsd:string .

hpc:testsuiteDir a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmtestsuite ;
    rdfs:range xsd:string .

hpc:globalsLocal a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmtestsuite ;
    rdfs:range xsd:string .

hpc:workingDirectory a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmtestsuite ;
    rdfs:range xsd:string .

hpc:testExecution a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmtestsuite ;
    rdfs:range hpc:Test .

hpc:Test a owl:Class .
hpc:testName a owl:DatatypeProperty ;
    rdfs:domain hpc:Test ;
    rdfs:range xsd:string .

hpc:Slurmconfig a owl:Class .
hpc:rebuildConfig a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfig ;
    rdfs:range xsd:boolean .

hpc:makefileAm a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmconfig ;
    rdfs:range xsd:string .

hpc:autoreconf a owl:ObjectProperty ;
    rdfs:domain hpc:Slurmconfig ;
    rdfs:range xsd:string .

hpc:Slurmdaemon a owl:Class .
hpc:portNumber a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:integer .

hpc:nodename a owl:DatatypeProperty ;
    rdfs:domain hpc:Slurmdaemon ;
    rdfs:range xsd:string .

hpc:Multipleslurmdsupport a owl:Class .
hpc:multipleSlurmdEnabled a owl:DatatypeProperty ;
    rdfs:domain hpc:Multipleslurmdsupport ;
    rdfs:range xsd:boolean .

hpc:configureParameter a owl:DatatypeProperty ;
    rdfs:domain hpc:Multipleslurmdsupport ;
    rdfs:range xsd:string .

hpc:Networkingtest a owl:Class ;
    rdfs:subClassOf hpc:Test .

hpc:Protocoltest a owl:Class ;
    rdfs:subClassOf hpc:Test .

hpc:Largeclustersimulation a owl:Class ;
    rdfs:subClassOf hpc:Test .
