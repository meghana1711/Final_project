hpc:Slurmconfiguration a owl:Class .
hpc:prologflags a owl:ObjectProperty .
hpc:Slurmconf rdfs:subClassOf owl:Document .
hpc:Prologflags rdfs:domain hpc:Slurmconfiguration ;
    rdfs:range xsd:string .
hpc:taskcgroupplugin a owl:ObjectProperty .
hpc:Slurm rdfs:subClassOf owl:Document .
hpc:containoption a owl:ObjectProperty .
hpc:Containoption rdfs:domain hpc:Slurm ;
    rdfs:range xsd:string .
