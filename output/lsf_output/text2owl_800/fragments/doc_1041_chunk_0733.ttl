hpc:bsubmit a owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissionuser ;
    rdfs:range hpc:Jobexecutionuser ;
    rdfs:comment "To submit jobs as other users." .

hpc:User a owl:Class ;
    rdfs:subClassOf xsd:string .

hpc:Jobexecutionuser a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:Jobsubmissionuser a owl:Class ;
    rdfs:subClassOf hpc:User .

hpc:bswitch a owl:ObjectProperty ;
    rdfs:domain hpc:Jobexecutionuser ;
    rdfs:range rdf:Resource ;
    rdfs:comment "Switches unfinished jobs from one queue to another." .

hpc:applicationName a owl:DatatypeProperty ;
    rdfs:domain hpc:Bswitch ;
    rdfs:range xsd:string .

hpc:jobName a owl:DatatypeProperty ;
    rdfs:domain hpc:Bswitch ;
    rdfs:range xsd:string .

hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:Bswitch ;
    rdfs:range xsd:string .

hpc:hostGroup a owl:DatatypeProperty ;
    rdfs:domain hpc:Bswitch ;
    rdfs:range xsd:string .
