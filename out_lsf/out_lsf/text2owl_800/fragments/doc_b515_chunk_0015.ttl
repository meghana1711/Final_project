hpc:Jobrequirement rdfs:range rdf:List .
hpc:Jobrequirement rdfs:range hpc:Host .
hpc:Jobrequirement rdfs:range hpc:Computeunit .

hpc:Jobchunking rdfs:range rdf:List .
hpc:Jobchunking rdfs:range hpc:Job .

hpc:jobrequirementStartonhost a owl:DatatypeProperty .
