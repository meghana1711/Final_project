hpc:Googleprovtemplate a owl:Class .
hpc:Overrides rdfs:subClassOf hpc:Googleprovtemplate .
hpc:userdata a owl:DatatypeProperty ;
    rdfs:domain hpc:Googleprovtemplate ;
    rdfs:range xsd:string .
hpc:instancetags a owl:DatatypeProperty ;
    rdfs:domain hpc:Googleprovtemplate ;
    rdfs:range xsd:string .

hpc:Localssd a owl:Class .
hpc:attachlocalssd a owl:ObjectProperty ;
    rdfs:domain hpc:Googleprovtemplate ;
    rdfs:range hpc:Localssd .
hpc:mountlocalssd a owl:ObjectProperty .

hpc:Preemptiblevminstance a owl:Class .
