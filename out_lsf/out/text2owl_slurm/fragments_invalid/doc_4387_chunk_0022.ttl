hpc:User a owl:Class.
hpc:accountproperty a owl:ObjectProperty.
hpc:adminlevelproperty a owl:DatatypeProperty.
hpc:clusterproperty a owl:ObjectProperty.
hpc:defaultaccountproperty a owl:DatatypeProperty.
hpc:defaultwckeyproperty a owl:DatatypeProperty.
hpc:nameproperty a owl:DatatypeProperty.
hpc:newnameproperty a owl:DatatypeProperty.
hpc:partitionproperty a owl:DatatypeProperty.
hpc:AccountLevel a owl:Enum.
hpc:AccountLevel "None" rdf:value "none" .
hpc:AccountLevel "Operator" rdf:value "operator" .
hpc:AccountLevel "Admin" rdf:value "admin" .
hpc:Userobject a owl:Class.
hpc:Accountobject a owl:Class.
hpc:Accountobject a owl:ObjectSomeValuesFrom hpc:Account.
hpc:Account rdfs:subClassOf hpc:Userobject.
hpc:Account rdfs:subClassOf rdf:Resource.
hpc:Account rdfs:domain hpc:Accountproperty.
hpc:adminlevel a owl:DatatypeProperty.
