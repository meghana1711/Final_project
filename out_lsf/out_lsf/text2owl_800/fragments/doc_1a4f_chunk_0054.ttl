hpc:Host a owl:Class .
hpc:removinghostprocess a owl:ObjectProperty .
hpc:Removinghostprocess rdfs:domain hpc:Host .
hpc:Removinghostprocess rdfs:range rdf:List .
hpc:Removinghostprocesslist a owl:Class .
hpc:Removinghostprocesslist rdfs:subClassOf rdf:List .
hpc:RemovingHostProcessList rdfs:comment "List of steps to remove a host." .
hpc:Step a owl:Class .
hpc:Step1 a hpc:Step .
hpc:Step1 rdfs:comment "Log on to any host in the cluster." .
hpc:step1A a owl:DatatypeProperty .
hpc:Step1A rdfs:domain hpc:Step1 .
hpc:Step1A rdfs:range xsd:string .
hpc:Step1_a rdfs:comment "The action to be performed on the first step." .
hpc:Step2 a hpc:Step .
hpc:Step2 rdfs:comment "List the contents of the LSF_TOP/10.1.0 directory and confirm that there is already a subdirectory with the name of the host type." .
hpc:step2A a owl:DatatypeProperty .
hpc:Step2A rdfs:domain hpc:Step2 .
hpc:Step2A rdfs:range xsd:boolean .
hpc:Step2_a rdfs:comment "The result of the second step." .
hpc:addinghost a owl:ObjectProperty .
hpc:Addinghost rdfs:domain hpc:Host .
hpc:Addinghost rdfs:range hpc:Hostsetup .
hpc:Hostsetup a owl:Class .
hpc:Hostsetup rdfs:subClassOf hpc:Script .
hpc:HostSetup rdfs:comment "Script used to set up LSF to start automatically." .
hpc:dynamicallyaddinghosts a owl:ObjectProperty .
hpc:Dynamicallyaddinghosts rdfs:domain hpc:Cluster .
hpc:Dynamicallyaddinghosts rdfs:range hpc:Configuration .
hpc:Configuration a owl:Class .
hpc:Configuration rdfs:subClassOf rdf:List .
hpc:Configuration rdfs:comment "List of configurations for a cluster." .
hpc:Cluster a owl:Class .
hpc:Cluster rdfs:subClassOf rdf:List .
hpc:Cluster rdfs:comment "List of hosts in a cluster." .
hpc:Hosttype a owl:Class .
hpc:Hosttype rdfs:subClassOf rdf:List .
hpc:HostType rdfs:comment "List of host types in a cluster." .
hpc:lsfinstallationscript a owl:ObjectProperty .
hpc:Lsfinstallationscript rdfs:domain hpc:Cluster .
hpc:Lsfinstallationscript rdfs:range hpc:Script .
hpc:Script a owl:Class .
hpc:Script rdfs:subClassOf rdf:List .
hpc:Script rdfs:comment "List of scripts used in LSF." .
