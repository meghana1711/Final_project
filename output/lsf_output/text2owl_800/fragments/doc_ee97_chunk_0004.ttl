hpc:javaruntimepath a owl:DatatypeProperty .
hpc:Javaruntimepath rdfs:domain hpc:Javaruntimeinstallation .
hpc:Javaruntimepath rdfs:range xsd:string .

hpc:Hadoopinstallation a owl:Class .
hpc:Hadoopinstallation rdfs:subClassOf owl:Thing .

hpc:hadooppath a owl:DatatypeProperty .
hpc:Hadooppath rdfs:domain hpc:Hadoopinstallation .
hpc:Hadooppath rdfs:range xsd:string .

hpc:Lsfserverhost a owl:Class .
hpc:Lsfserverhost rdfs:subClassOf owl:Thing .

hpc:accessibleto a owl:ObjectProperty .
hpc:Accessibleto rdfs:domain hpc:Javaruntimeinstallation .
hpc:Accessibleto rdfs:range hpc:Lsfserverhost .

hpc:overwriteableatsubmission a owl:ObjectProperty .
hpc:Overwriteableatsubmission rdfs:domain hpc:Javaruntimeinstallation .
hpc:Overwriteableatsubmission rdfs:range hpc:Lsfserverhost .

hpc:Hadoopapplication a owl:Class .
