hpc:Project a owl:Class .
hpc:Servicedomain a owl:Class .
hpc:License a owl:Class .
hpc:CompetingProjects owl:DatatypeProperty .
hpc:EntitledLicenses owl:DatatypeProperty .
hpc:OnDemandLicenses owl:DatatypeProperty .
hpc:Preemptivelicense a owl:Class .
hpc:dynamic a owl:ObjectProperty .
hpc:Duration rdfs:domain hpc:Dynamic ;
    rdfs:range xsd:duration .

hpc:Project rdfs:subClassOf hpc:Competingprojects .
hpc:Servicedomain rdfs:subClassOf hpc:Competingprojects .
hpc:Preemptivelicense rdfs:subClassOf hpc:Project .

hpc:Servicedomain hpc:Entitledlicenses rdfs:range xsd:integer .
hpc:Project hpc:Ondemandlicenses rdfs:range xsd:integer .

hpc:wanserver a hpc:ServiceDomain ;
    hpc:EntitledLicenses "8"^^xsd:integer .
hpc:lanserver1 a hpc:ServiceDomain ;
    hpc:EntitledLicenses "12"^^xsd:integer ;
    hpc:Dynamic true .

hpc:Lp1 a hpc:Project ;
    hpc:CompetingProjects ( hpc:wanserver hpc:lanserver1 ) ;
    hpc:OnDemandLicenses "2"^^xsd:integer .
hpc:Lp2 a hpc:Project ;
    hpc:CompetingProjects ( hpc:wanserver hpc:lanserver1 ) ;
    hpc:OnDemandLicenses "6"^^xsd:integer ;
    hpc:PreemptiveLicense true .
