hpc:Lsbparams a owl:Class .
hpc:ALLOCATION_PLANNER rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range hpc:Boolean .
hpc:EXTENDABLE_RUNLIMIT rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbqueues ;
    rdfs:range hpc:Boolean .
hpc:ESTIMATED_RUNTIME rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:nonNegativeInteger .
hpc:PLAN rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Lsbparams ;
    rdfs:range xsd:string .

# LSB Queues
hpc:Lsbqueues a owl:Class .
hpc:SNDJOBS_TO rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbqueues ;
    rdfs:range xsd:string .
hpc:FWD_USERS rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsbqueues ;
    rdfs:range xsd:string .

# Job Submission and Execution Controls
hpc:Jobsubmissioncontrols a owl:Class .
hpc:jobForwardingRestriction rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Jobsubmissioncontrols ;
    rdfs:range xsd:string .

# Default epsub Executable
hpc:Defaultepsubexecutable a owl:Class .

# Advance Reservations
hpc:Advancereservationresourcerequirement a owl:Class .
hpc:sameResourceRequirement rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Advancereservationresourcerequirement ;
    rdfs:range xsd:string .
