hpc:Loglevel a owl:Class;
    rdfs:subClassOf owl:Class.

hpc:logfile a owl:ObjectProperty;
    rdfs:domain hpc:Loglevel;
    rdfs:range xsd:string.

hpc:daemonname a owl:DatatypeProperty;
    rdfs:domain hpc:Logfile.

hpc:hostname a owl:DatatypeProperty;
    rdfs:domain hpc:Logfile.

hpc:logfilepath a owl:DatatypeProperty;
    rdfs:domain hpc:Loglevel;
    rdfs:range xsd:string.

hpc:Lsfsystemlogfile a owl:Class;
    rdfs:subClassOf hpc:Logfile.

hpc:Temporarydebugsettings a owl:Class;
    rdfs:subClassOf owl:Class.

hpc:lsLogMask a owl:DatatypeProperty;
    rdfs:domain hpc:Temporarydebugsettings.

hpc:lsbDebugBld a owl:DatatypeProperty;
    rdfs:domain hpc:Temporarydebugsettings.

hpc:defaultlogfile a owl:ObjectProperty;
    rdfs:domain hpc:Temporarydebugsettings;
    rdfs:range hpc:Logfile.

hpc:InvalidPathBehavior a owl:Enum;
    rdfs:subClassOf owl:Class;
    rdfs:member hpc:CreateInTempDirectory ;
    rdfs:member hpc:NoLogFileOnWindows .
