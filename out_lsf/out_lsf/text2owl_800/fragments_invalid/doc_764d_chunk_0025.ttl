hpc:Localcluster a owl:Class .
hpc:Remotecluster a owl:Class .
hpc:Managementhostlim a owl:Class .
hpc:Cache a owl:Class .
hpc:Loadinformation a owl:Class .
hpc:Hostinformation a owl:Class .

hpc:hascache a owl:ObjectProperty ;
    rdfs:domain hpc:Localcluster ;
    rdfs:range hpc:Cache .

hpc:hasloadinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range hpc:Loadinformation .

hpc:hashostinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range hpc:Hostinformation .

hpc:cachethreshold a owl:DatatypeProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range xsd:integer .

hpc:Loadcachethreshold a owl:Class ;
    rdfs:subClassOf hpc:Cachethreshold .

hpc:Hostcachethreshold a owl:Class ;
    rdfs:subClassOf hpc:Cachethreshold ;
    owl:differentFrom hpc:LoadCacheThreshold .

hpc:LoadCacheThreshold rdfs:subPropertyOf hpc:cacheThreshold ;
    rdfs:range xsd:integer .

hpc:HostCacheThreshold rdfs:subPropertyOf hpc:cacheThreshold ;
    rdfs:range xsd:integer ;
    rdfs:range rdf:PlainLiteral "2\x2A"^^xsd:integer .

hpc:cacheexpired a owl:ObjectProperty ;
    rdfs:domain hpc:Cache ;
    rdfs:range hpc:Remotecluster .

hpc:Jobforwardingmodel a owl:Class .
