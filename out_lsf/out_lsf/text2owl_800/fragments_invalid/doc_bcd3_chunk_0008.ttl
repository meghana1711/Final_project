hpc:badmincommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Badmincommandtype .

hpc:Badmincommandtype a owl:Class .

hpc:badminmbdrestart a owl:ObjectProperty ;
    rdfs:subClassOf hpc:Badmincommand ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Badminmbdrestarttype .

hpc:Badminmbdrestarttype a owl:Class .

hpc:performancemetriclogging a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Performancemetricloggingtype .

hpc:Performancemetricloggingtype a owl:Class .

hpc:performancemetricenable a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetriclogging .
    rdfs:range xsd:boolean .

hpc:performancemetricsampleperiod a owl:DatatypeProperty ;
    rdfs:domain hpc:Performancemetriclogging .
    rdfs:range xsd
