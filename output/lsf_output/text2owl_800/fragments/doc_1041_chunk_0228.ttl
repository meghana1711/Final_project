hpc:Cpuf a owl:Class .
hpc:DispatchWindow a owl:Class .
hpc:CurrentLoad a owl:Class .

hpc:hasnormalizationfactor a owl:ObjectProperty ;
    rdfs:domain hpc:Cpuf ;
    rdfs:range xsd:decimal .

hpc:hasdispatchwindow a owl:ObjectProperty ;
    rdfs:domain hpc:DispatchWindow ;
    rdfs:range hpc:Dispatchwindow .

hpc:Dispatchwindow a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:totalload a owl:DatatypeProperty ;
    rdfs:domain hpc:CurrentLoad ;
    rdfs:range xsd:decimal .

hpc:reservedload a owl:DatatypeProperty ;
    rdfs:domain hpc:CurrentLoad ;
    rdfs:range xsd:decimal .
