hpc:Sshjob a owl:Class ;
    rdfs:subClassOf hpc:Interactivejob ;
    rdfs:comment "Submits an interactive job under a secure shell (ssh) and creates a pseudo-terminal with shell mode support when the job starts." .

hpc:Interactivejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Submits an interactive job and creates a pseudo-terminal with shell mode when the job starts." .

hpc:Xwindowjob a owl:Class ;
    rdfs:subClassOf hpc:Interactivejob ;
    rdfs:comment "Submits an interactive X-Window job." .

hpc:Inputfilejob a owl:Class ;
    rdfs:subClassOf hpc:Interactivejob ;
    rdfs:comment "Gets the standard input for the job from the specified file path." .

hpc:Modifiableinputfilejob a owl:Class ;
    rdfs:subClassOf hpc:Inputfilejob ;
    rdfs:comment "Gets the standard input for the job from the specified file path, but allows you to modify or remove the input file before the job completes." .

hpc:Jobarray a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Assigns the specified name to the job, and, for job arrays, specifies the indices of the job array and optionally the maximum number of jobs that can run at any given time." .

hpc:jobdescription a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string ;
    rdfs:comment "Assigns the specified description to the job; for job arrays, specifies the same job description for all elements in the job array." .

hpc:jobaffinity a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Affinity ;
    rdfs:comment "Specifies the affinity preferences for the job." .

hpc:Jsdljob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Submits a job using a JSDL file that uses the LSF extension to specify job submission options." .

hpc:Jsdlstrictjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Submits a job using a JSDL file that only uses the standard JSDL elements and POSIX extensions to specify job submission options." .

hpc:Jsmjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Enables or disables the IBM Job Step Manager (JSM) daemon for the job." .

hpc:Jsonjob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Submits a job using a JSON file to specify job submission options." .
