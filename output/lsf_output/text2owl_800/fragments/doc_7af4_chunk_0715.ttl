hpc:LsbJobinfoDir a owl:Class .
hpc:LsbJsmDefault a owl:Class .

hpc:hasdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Property to specify a directory for job information." .

hpc:isdefaultdirectory a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Default path for job information directory if LSB_JOBINFO_DIR is not set." .

hpc:isadminowned a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory is owned by the primary LSF administrator." .

hpc:isaccessiblefromallhosts a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory is accessible from all hosts that can potentially become the management host." .

hpc:hasaccesspermission a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the access permission of the directory from the management host." .

hpc:haspermissionmode a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates the permission mode of the directory." .

hpc:cannotbecreated a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether the directory can be created." .

hpc:exitsoncreationfailure a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether mbatchd exits if the directory cannot be created." .

hpc:requiresdraining a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether draining the whole cluster is required when using LSB_JOBINFO_DIR." .

hpc:ignorediflsbLocaldirisconfigured a owl:ObjectProperty ;
    rdfs:domain hpc:LsbJobinfoDir ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether LSB_JOBINFO_DIR is ignored if LSB_LOCALDIR is configured." .

hpc:LSB_JSM_DEFAULT_Y a xsd:string .
hpc:LSB_JSM_DEFAULT_N a xsd:string .
