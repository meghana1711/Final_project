hpc:Project a owl:Class .
hpc:Cluster a owl:Class .
hpc:Consumer a owl:Class .
hpc:Token a owl:Class .
hpc:inuse a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:reserve a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:free a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:need a owl:ObjectProperty ;
    rdfs:domain hpc:Project ;
    rdfs:range xsd:integer .
hpc:acumUse a owl:DatatypeProperty ;
    rdfs:domain hpc:Consumer .
hpc:scaledAcum a owl:DatatypeProperty ;
    rdfs:domain hpc:Consumer .
