hpc:SlurmApiRequestContent a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmApiRequest ;
    rdfs:range xsd:string .

hpc:SlurmApiResponseContent a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmApiResponse ;
    rdfs:range xsd:string .

hpc:ApplicationJsonRequest a owl:Class ;
    rdfs:subClassOf hpc:SlurmApiRequest ;
    rdfs:subClassOf hpc:ApplicationMediaType ;

hpc:ApplicationXYAML a owl:Class ;
    rdfs:subClassOf hpc:SlurmApiRequest ;
    rdfs:subClassOf hpc:ApplicationMediaType .

hpc:TextYAML a owl:Class ;
    rdfs:subClassOf hpc:SlurmApiRequest ;
    rdfs:subClassOf hpc:TextMediaType .

hpc:ApplicationYAML a owl:Class ;
    rdfs:subClassOf hpc:SlurmApiRequest ;
    rdfs:subClassOf hpc:ApplicationMediaType .

hpc:ApplicationMediaType a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:subClassOf hpc:ContentType .

hpc:ContentType a owl:Class ;
    rdfs:subClassOf owl:Class .

hpc:UpdateNodeMsgSchema a owl:ObjectProperty ;
    rdfs:domain hpc:UpdateNodeMsg ;
    rdfs:range hpc:Schema .

hpc:SlurmApiRequestSchema a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmApiRequest ;
    rdfs:range hpc:Schema .

hpc:SlurmApiResponseSchema a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmApiResponse ;
