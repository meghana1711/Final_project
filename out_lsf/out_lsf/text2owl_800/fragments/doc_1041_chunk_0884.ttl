hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Task .

hpc:Task a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual .

hpc:starter a owl:ObjectProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range rdf:Resource .

hpc:outputFile a owl:DatatypeProperty ;
    rdfs:domain hpc:Task ;
    rdfs:range xsd:string .

hpc:usrcmd a owl:DatatypeProperty ;
    rdfs:domain hpc:Starter ;
    rdfs:range xsd:string .
