hpc:User a owl:Class .
hpc:Filesystem a owl:Class .
hpc:Containerconfigfile a owl:Class .
hpc:Storageconfigfile a owl:Class .
hpc:Podmandir a owl:Class .
hpc:Podmanfs a owl:Class .
hpc:Podmandir an owl:DatatypeProperty ;
    rdfs:domain hpc:Podmandir ;
    rdfs:range xsd:string .
hpc:UserID an owl:DatatypeProperty ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:integer .
hpc:VolumePath an owl:ObjectProperty ;
    rdfs:domain hpc:Containerconfigfile ;
    rdfs:range hpc:Podmanfs .
hpc:TmpDir an owl:ObjectProperty ;
    rdfs:domain hpc:Containerconfigfile ;
    rdfs:range xsd:string .
hpc:StaticDir an owl:ObjectProperty ;
    rdfs:domain hpc:Containerconfigfile ;
    rdfs:range hpc:Podmanfs .
hpc:GraphRoot an owl:ObjectProperty ;
    rdfs:domain hpc:Storageconfigfile ;
    rdfs:range hpc:Podmanfs .
hpc:RunRoot an owl:ObjectProperty ;
    rdfs:domain hpc:Storageconfigfile ;
    rdfs:range xsd:string .
hpc:StorageOptions an owl:ObjectProperty ;
    rdfs:domain hpc:Storageconfigfile ;
    rdfs:range xsd:string .
hpc:AmountProgram an owl:ObjectProperty ;
    rdfs:domain hpc:Storageconfigfile ;
    rdfs:range xsd:string .
hpc:Containerid a owl:Class .
hpc:Containerjob a owl:Class .
hpc:Containeridfile a owl:Class .
hpc:ContainerIDDirectory an owl:DatatypeProperty ;
    rdfs:domain hpc:Containeridfile ;
    rdfs:range xsd:string .
