hpc:Job a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Haspostexecutioncommand .

hpc:haspostexecutioncommand a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Postexecutioncommand .

hpc:Postexecutioncommand a owl:Class ;
    rdfs:subClassOf owl:NamedIndividual ;
    rdfs:subClassOf hpc:Command ;
    rdfs:subClassOf hpc:Runsafterjobfinishes ;
    rdfs:subClassOf hpc:Doesnotaffectjobexitstatus ;
    rdfs:subClassOf hpc:Canbedefinedbyuser .

hpc:Command a owl:Class .

hpc:runsafterjobfinishes a owl:ObjectProperty .

hpc:doesnotaffectjobexitstatus a owl:ObjectProperty .

hpc:canbedefinedbyuser a owl:ObjectProperty .

hpc:JobExitStatus a xsd:nonNegativeInteger .

hpc:preExec a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Command ;
    rdfs:subPropertyOf hpc:PreOrPostExecutionCommand ;
    rdfs:subPropertyOf hpc:RunsOnExecutionHost ;
    rdfs:subPropertyOf hpc:UsesSameEnvironmentVariablesAsJob ;
    rdfs:subPropertyOf hpc:CanReQueueJobOnFailure .

hpc:preorpostexecutioncommand a owl:ObjectProperty .

hpc:runsonexecutionhost a owl:ObjectProperty .

hpc:usessameenvironmentvariablesasjob a owl:ObjectProperty .

hpc:canrequeuejobonfailure a owl:ObjectProperty .

hpc:USER_POSTEXEC a xsd:string .
