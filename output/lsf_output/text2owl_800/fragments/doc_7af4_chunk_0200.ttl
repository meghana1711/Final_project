hpc:Project a owl:Class .
hpc:mem a owl:ObjectProperty .
hpc:Memorylimit a owl:Class .
hpc:Queue a owl:Class .
hpc:User a owl:Class .
hpc:Host a owl:Class .

hpc:Project rdfs:subClassOf owl:Class .
hpc:Memorylimit rdfs:subClassOf owl:Class .
hpc:Queue rdfs:subClassOf hpc:Project .
hpc:User rdfs:subClassOf hpc:Project .
hpc:Host rdfs:subClassOf owl:Class .

hpc:Mem rdfs:domain hpc:Project ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MemoryLimit rdfs:subPropertyOf hpc:MEM ;
    rdfs:domain hpc:Mem .

hpc:MemoryLimit rdfs:subPropertyOf hpc:MEM ;
    rdfs:domain hpc:Queue ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MemoryLimit rdfs:subPropertyOf hpc:MEM ;
    rdfs:domain hpc:User ;
    rdfs:range xsd:nonNegativeInteger .

hpc:MemoryLimit rdfs:subPropertyOf hpc:MEM ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:integer .
