hpc:Executionhost a owl:Class .
hpc:Command a owl:Class .
hpc:exitcode a owl:DatatypeProperty ;
    rdfs:domain hpc:Command ;
    rdfs:range xsd:nonNegativeInteger .
hpc:timeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Command .
hpc:executionresult a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range hpc:Command .
hpc:firstexecutionhost a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost .
hpc:Cpuaffinityrange a owl:Class .
hpc:Queue a owl:Class .
hpc:preexecutionprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost ;
    rdfs:range hpc:Preexecutionprocessingtype .
hpc:Preexecutionprocessingtype a owl:Class ;
    rdfs:subClassOf hpc:Processingtype .
hpc:HostBasedPreExecution a hpc:PreExecutionProcessingType .
hpc:hostbasedpostexecution a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost .
hpc:jobrusage a owl:DatatypeProperty ;
    rdfs:domain hpc:Firstexecutionhost .
hpc:Nonfirstexecutionhost a owl:Class ;
    rdfs:subClassOf hpc:Executionhost .
hpc:rusagecollection a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionprocessingtype ;
    rdfs:range xsd:boolean .
hpc:sbatchdquit a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost .
hpc:jobfinishbeforesbatchdrestart a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost .
hpc:hostbasedpostexecutionprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Executionhost .
hpc:Normalpriorityjob a owl:Class .
hpc:queuelevelpreexec a owl:ObjectProperty ;
    rdfs:domain hpc:Preexecutionprocessingtype ;
    rdfs:range xsd:string .
hpc:queuelevelpostexec a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutionprocessingtype ;
    rdfs:range xsd:string .
hpc:HostBasedQueueLevelPreExec a hpc:PreExecutionProcessingType ;
hpc:hostbasedqueuelevelpostexec a owl:ObjectProperty ;
    rdfs:domain hpc:Postexecutionprocessingtype ;
    rdfs:range xsd:string .
hpc:Lightlyloadedhost a owl:Class .
hpc:Bqueues a owl:Class .
hpc:Queueparametersstatistics a owl:Class .
