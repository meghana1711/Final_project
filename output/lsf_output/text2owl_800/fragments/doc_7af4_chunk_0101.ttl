hpc:RequeueExitValues a owl:Class .
hpc:exitCode a owl:DatatypeProperty ;
    rdfs:domain hpc:RequeueExitValues ;
    rdfs:range xsd:nonNegativeInteger .
hpc:ExitCodevalue a owl:Class ;
    rdfs:subClassOf hpc:ExitCode .
hpc:all a owl:ObjectProperty ;
    rdfs:domain hpc:RequeueExitValues ;
    rdfs:range hpc:ExitCodevalue .
hpc:exclude a owl:ObjectProperty ;
    rdfs:domain hpc:RequeueExitValues ;
    rdfs:range hpc:ExitCodevalue .
hpc:number a owl:DatatypeProperty ;
    rdfs:domain hpc:ExitCode ;
    rdfs:range xsd:nonNegativeInteger .
hpc:tilde a owl:DatatypeProperty ;
    rdfs:domain hpc:ExitCode ;
    rdfs:range xsd:nonNegativeInteger .
