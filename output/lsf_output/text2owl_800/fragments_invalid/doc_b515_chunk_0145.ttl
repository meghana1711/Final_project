@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Reservation a owl:Class.
hpc:hasstartingday a owl:DatatypeProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range xsd:dateTime.
hpc:isactive a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range xsd:boolean.
hpc:hasinstance a owl:ObjectProperty;
    rdfs:domain hpc:Reservation;
    rdfs:range hpc:Reservationinstance.
hpc:Reservationinstance a owl:Class.
hpc:hasstartdate a owl:DatatypeProperty;
