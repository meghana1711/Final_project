hpc:TimeslicerThread a owl:Class .
hpc:GangScheduler a owl:Class .
hpc:Job a owl:Class .
hpc:Resource a owl:Class .
hpc:Allocation a owl:Class .

# Object Properties
hpc:hasTimeslicerThread rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Scheduler ;
    rdfs:range hpc:TimeslicerThread .
hpc:suspendsJob rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:GangScheduler ;
    rdfs:range hpc:Job .
hpc:belongsToAllocation rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Allocation .
hpc:isResource rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resource .

# Datatype Properties
hpc:timeSlice xsd:nonNegativeInteger .
hpc:state xsd:string .

# Class Hierarchy
hpc:Scheduler a owl:Class ;
    rdfs:subClassOf hpc:Resource .

hpc:TimeslicerThread rdf:type owl:Class ;
    rdfs:subClassOf hpc:Scheduler .

hpc:GangScheduler rdf:type owl:Class ;
    rdfs:subClassOf hpc:TimeslicerThread .
```
