hpc:Job a owl:Class .
hpc:releaseversion a owl:DatatypeProperty .
hpc:User a owl:Class .
hpc:date a owl:DatatypeProperty .
hpc:time a owl:DatatypeProperty .
hpc:step a owl:DatatypeProperty .
hpc:messageindex a owl:DatatypeProperty .
hpc:jobstatus a owl:ObjectProperty .
hpc:Jobgroup a owl:Class .
hpc:Queue a owl:Class .
hpc:Serviceclass a owl:Class .
hpc:Host a owl:Class .
hpc:Hostgroup a owl:Class .
hpc:suspendreason a owl:DatatypeProperty .
hpc:Applicationprofile a owl:Class .

hpc:Job rdfs:subClassOf owl:NamedIndividual .
hpc:Releaseversion rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:User rdfs:subClassOf owl:NamedIndividual .
hpc:Date rdfs:domain hpc:Job ;
    rdfs:range xsd:date .
hpc:Time rdfs:domain hpc:Job ;
    rdfs:range xsd:time .
hpc:Step rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Messageindex rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Jobstatus rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstatus .
hpc:Jobgroup rdfs:subClassOf owl:NamedIndividual .
hpc:Queue rdfs:subClassOf owl:NamedIndividual .
hpc:Serviceclass rdfs:subClassOf owl:NamedIndividual .
hpc:Host rdfs:subClassOf owl:NamedIndividual .
hpc:Hostgroup rdfs:subClassOf owl:NamedIndividual .
hpc:Suspendreason rdfs:domain hpc:Bstop ;
    rdfs:range xsd:string .
hpc:Applicationprofile rdfs:subClassOf owl:NamedIndividual .
