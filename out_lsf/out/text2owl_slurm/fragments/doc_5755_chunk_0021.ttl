hpc:Job a owl:Class .
hpc:jobsizechange a owl:ObjectProperty .
hpc:jobid a owl:DatatypeProperty .
hpc:Jobenvironment a owl:Class .
hpc:Jobenvironmentvariable a owl:Class .
hpc:jobstate a owl:ObjectProperty .
hpc:jobresubmission a owl:ObjectProperty .
hpc:Backfillscheduler a owl:Class .
hpc:estimatedstarttime a owl:DatatypeProperty .

hpc:Job rdfs:subClassOf hpc:Jobclass .
hpc:Jobsizechange rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .
hpc:Jobid rdfs:domain hpc:Job ;
    rdfs:range xsd:string .
hpc:Jobenvironment rdfs:subClassOf hpc:Jobclass .
hpc:Jobenvironmentvariable rdfs:subClassOf hpc:Jobenvironment ;
    rdfs:range xsd:string .
hpc:Jobstate rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobstatetype .
hpc:Jobresubmission rdfs:domain hpc:Job ;
    rdfs:range hpc:Job .
hpc:Backfillscheduler a owl:Class .
hpc:Estimatedstarttime rdfs:domain hpc:Backfillscheduler ;
    rdfs:range xsd:dateTime .
