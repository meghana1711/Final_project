hpc:SlurmPrepPlugin a owl:Class .
hpc:pluginName a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPrepPlugin ;
    rdfs:range xsd:string .

hpc:pluginType a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmPrepPlugin ;
    rdfs:range xsd:string .

hpc:pluginVersion a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmPrepPlugin ;
    rdfs:range xsd:integer .

hpc:PluginMajorType a owl:NamedIndividual ;
    hpc:pluginType "prep" .
