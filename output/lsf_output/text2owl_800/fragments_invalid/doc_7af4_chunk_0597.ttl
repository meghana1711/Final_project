@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:exinterval a owl:DatatypeProperty ;
    rdfs:domain hpc:Loadinformationmanager ;
    rdfs:range xsd:float .

hpc:Loadinformationmanager a owl:Class .

hpc:floatClients a owl:DatatypeProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:nonNegativeInteger .

hpc:Cluster a owl:Class .

hpc:floatClientsAddrRange a owl:ObjectProperty ;
    rdfs:domain hpc:Cluster ;
    rdfs:range xsd:string .

hpc:IpAddress a owl:Class .
