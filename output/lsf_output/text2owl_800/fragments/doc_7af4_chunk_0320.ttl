hpc:Interval a owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
                       owl:onProperty hpc:interval ;
                       owl:hasValue xsd:positiveInteger ;
                       owl:allValuesFrom xsd:nonNegativeInteger ] .

hpc:jobpriorityovertime a owl:DatatypeProperty ;
    rdfs:domain hpc:Interval ;
    rdfs:range xsd:decimal .

hpc:jobrunlimitratio a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal .
