hpc:HostStatus a owl:Class .
hpc:hostName a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:string .
hpc:status a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:string .
hpc:jl a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:u a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:max a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:njobs a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:run a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:ssusp a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:ususp a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:rsvp a owl:DatatypeProperty ;
    rdfs:domain hpc:HostStatus ;
    rdfs:range xsd:integer .
hpc:Host a owl:Class .
hpc:HOST_STATE a owl:Enum ;
    rdfs:subClassOf hpc:HostStatus ;
    rdfs:member "ok" ;
    rdfs:member "closed" .
hpc:HostType a owl:Class .
hpc:externalJobSubmission a owl:ObjectProperty .
hpc:GoogleCloudPlatform a owl:Class .
hpc:LsfResourceConnector a owl:Class .
hpc:fixPack a owl:DatatypeProperty .
hpc:providerName a owl:DatatypeProperty .
