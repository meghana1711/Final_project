hpc:Pendingreservejob a owl:Class .
hpc:predictedstarttime a owl:DatatypeProperty ;
    rdfs:domain hpc:Pendingreservejob ;
    rdfs:range xsd:string .

hpc:Backfillqueue a owl:Class .

hpc:Resourcereservation a owl:Class ;
    rdfs:subClassOf hpc:Pendingreservejob .

hpc:nopredictedstarttime a owl:ObjectProperty ;
    rdfs:domain hpc:Resourcereservation ;
    rdfs:range xsd:boolean .

hpc:Resizablejob a owl:Class .

hpc:activependingresizeallocationrequest a owl:ObjectProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range hpc:Activependingresizeallocationrequest .

hpc:latestjobpriority a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string .

hpc:Userbasedfairsharescheduling a owl:Class .

hpc:chargingsaap a owl:DatatypeProperty ;
    rdfs:domain hpc:Userbasedfairsharescheduling ;
    rdfs:range xsd:string .

hpc:Absolutepriorityscheduling a owl:Class .

hpc:adminfactor a owl:DatatypeProperty ;
    rdfs:domain hpc:Absolutepriorityscheduling ;
    rdfs:range xsd:float .

hpc:systemaps a owl:DatatypeProperty ;
    rdfs:domain hpc:Absolutepriorityscheduling ;
    rdfs:range xsd:float .

hpc:Sshx11forwarding a owl:Class .

hpc:submittedinsshx11forwardingmode a owl:DatatypeProperty ;
    rdfs:domain hpc:Sshx11forwarding ;
    rdfs:range xsd:boolean .

hpc:sshcommand a owl:DatatypeProperty ;
    rdfs:domain hpc:Sshx11forwarding ;
    rdfs:range xsd:string .

hpc:autoattachedsla a owl:ObjectProperty ;
    rdfs:domain hpc:Sshx11forwarding ;
    rdfs:range xsd:string .

hpc:specifiedcwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:string .

hpc:Cwdpathwithpatternvalues a owl:Class .

hpc:executioncwd a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Cwdpathwithpatternvalues .
