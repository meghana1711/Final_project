hpc:SlurmdDaemon a owl:Class .
hpc:SlurmstepdProgram a owl:Class .
hpc:SpankPluginFunction a owl:Class .
hpc:MPISetup a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range rdf:Resource .
hpc:CallSwitchPlugin a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range rdf:Resource .
hpc:ProctrackPlugin a owl:Class .
hpc:ChangeUserID a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range xsd:integer .
hpc:ConfigureIO a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range rdf:PlainLiteral .
hpc:SetUpEnvironmentVariables a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range rdf:PlainLiteral .
hpc:ForkExecTasks a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmstepdProgram ;
    rdfs:range rdf:Resource .
hpc:JobStepTermination a owl:Class .
hpc:UserInitiatedTermination a owl:Class ;
    rdfs:subClassOf hpc:JobStepTermination .
hpc:SystemInitiatedTermination a owl:Class ;
    rdfs:subClassOf hpc:JobStepTermination .
hpc:SlurmctldDaemon a owl:Class .
hpc:UserTask a owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:SystemTask a owl:Class ;
    rdfs:subClassOf hpc:Task .
hpc:Task a owl:Class .
hpc:JobStep a owl:Class .
hpc:ExternStep a owl:Class ;
    rdfs:subClassOf hpc:JobStep ;
    rdfs:subPropertyOf hpc:CreatedBySlurmstepd .
hpc:BatchStep a owl:Class ;
    rdfs:subClassOf hpc:JobStep ;
    rdfs:subPropertyOf hpc:CreatedBySbatch .
hpc:JobAccountingRecord a owl:Class .
hpc:JobRecord a owl:Class ;
    rdfs:subClassOf hpc:JobAccountingRecord .
hpc:JobStepRecord a owl:Class ;
    rdfs:subClassOf hpc:JobAccountingRecord .
hpc:PrologFlags a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmConfiguration .
    rdfs:range xsd:string .
