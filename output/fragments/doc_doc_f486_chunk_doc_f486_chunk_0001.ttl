hpc:SelectPlugin a owl:Class .
hpc:TopologyAwarePlugin rdfs:subClassOf hpc:SelectPlugin .
hpc:OverSubscribeSupport rdfs:domain hpc:SelectPlugin ;
                          rdfs:range xsd:boolean .

hpc:LinearPlugin a owl:Class ;
                 rdfs:subClassOf hpc:SelectPlugin .
hpc:ConsTresPlugin a owl:Class ;
                   rdfs:subClassOf hpc:SelectPlugin .

hpc:NodeCentric rdfs:domain hpc:LinearPlugin ;
                rdfs:range xsd:boolean .

hpc:FineResolution rdfs:domain hpc:ConsTresPlugin ;
                   rdfs:range xsd:boolean .

hpc:NodeDataStructure a owl:Class .
hpc:ResourceDataStructure a owl:Class .

hpc:ConfiguredMemory rdfs:domain hpc:NodeDataStructure ;
                     rdfs:range xsd:double .
hpc:AllocatedMemory rdfs:domain hpc:NodeDataStructure ;
                    rdfs:range xsd:double .
hpc:ExclusiveNodeFlag rdfs:domain hpc:NodeDataStructure ;
                      rdfs:range xsd:boolean .
hpc:GRES rdfs:domain hpc:NodeDataStructure ;
                  rdfs:range rdf:List .

hpc:PerPartitionOverSubscribe rdfs:domain hpc:ResourceDataStructure ;
                               rdfs:range xsd:integer .
```
