@prefix hpc: <http://example.org/hpc#>
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Site a owl:Class .
hpc:Prereleaseversion a owl:Class .
hpc:Upgrade a owl:Class .
hpc:RevertUpgrade a owl:Property .
hpc:RevertUpgrade a rdf:Property ;
    rdfs:domain hpc:Upgrade ;
    rdfs:range hpc:Revertupgrade .
hpc:Supported a rdf:Property ;
    rdfs:domain hpc:Site ;
    rdfs:range hpc:Prereleaseversion .
hpc:NotSupported a rdf:Property ;
    rdfs:domain hpc:Upgrade ;
