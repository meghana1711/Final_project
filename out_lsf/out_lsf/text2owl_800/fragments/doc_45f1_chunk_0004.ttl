hpc:ClientID
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier for the Keycloak client." .

hpc:ClientSecret
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:string ;
    rdfs:comment "The secret key for the Keycloak client." .

hpc:RootURL
    a owl:ObjectProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The root URL for the Keycloak client." .

hpc:HomeURL
    a owl:ObjectProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The home URL for the Keycloak client." .

hpc:ValidRedirectURIs
    a owl:ObjectProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The valid redirect URIs for the Keycloak client." .

hpc:WebOrigins
    a owl:ObjectProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The web origins for the Keycloak client." .

hpc:AdminURL
    a owl:ObjectProperty ;
    rdfs:domain hpc:Keycloakclient ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The admin URL for the Keycloak client." .
