hpc:LsfSudoers a owl:Class .
hpc:LsfStartupuser a owl:Class .
hpc:LsfStartuppath a owl:Class .

hpc:hasConfigurationFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfSudoers ;
    rdfs:range xsd:string .

hpc:hasParameter rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfSudoers .

hpc:hasSyntax rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hasparameter ;
    rdfs:range xsd:string .

hpc:defaultBehavior rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Hasparameter .

hpc:enablesLSFDaemonStartupByUsers rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStartupuser .

hpc:allowsLSFAdministrators rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Enableslsfdaemonstartupbyusers ;
    rdfs:range hpc:LsfSudoers .

hpc:specifiedUserAccounts rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Enableslsfdaemonstartupbyusers .

hpc:enablesLSFDaemonStartupBySingleUser rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStartupuser .

hpc:specifiedUser rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Enableslsfdaemonstartupbysingleuser .

hpc:specifiesDirectory rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:LsfStartuppath .

hpc:containsLSFDaemonBinaryFiles rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Specifiesdirectory .
