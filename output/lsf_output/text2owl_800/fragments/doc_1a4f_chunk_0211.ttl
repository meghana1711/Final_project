hpc:Job a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequestingentity ;
    rdfs:comment "Represents a job in the HPC system." .

hpc:Resourcerequirement a owl:Class ;
    rdfs:subClassOf hpc:Resourcerequestingentity ;
    rdfs:comment "Represents a resource requirement for a job." .

hpc:orderrequirement a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirement ;
    rdfs:comment "The resource requirement order for a job." .

hpc:defaultresourcerequirementorder a owl:DatatypeProperty ;
    rdfs:domain hpc:Localcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "The default resource requirement order for a local cluster." .

hpc:multipleresourcerequirements a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourcerequirementlist ;
    rdfs:comment "The list of multiple resource requirements for a job." .

hpc:Resourcerequirementlist a owl:Class ;
    rdfs:subClassOf rdf:List ;
    rdfs:comment "A list of resource requirements for a job." .

hpc:Resizablejob a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "A job that can be resized." .

hpc:orderexpression a owl:DatatypeProperty ;
    rdfs:domain hpc:Resizablejob ;
    rdfs:range xsd:string ;
    rdfs:comment "The order expression for a resizable job." .
