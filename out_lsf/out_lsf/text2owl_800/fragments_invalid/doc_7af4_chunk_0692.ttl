hpc:Validfilename a owl:Class .
hpc:Validfilename rdfs:subClassOf owl:Restriction .
hpc:ValidFileName rdfs:label "Valid File Name"@en ;
                    rdfs:comment "Contains only alphanumeric characters, underscore (_) and hyphen (-)."@en ;
                    owl:onProperty hpc:fileName ;
                    owl:hasValue "_" ;
                    owl:allValueFrom xsd:alphanumeric .

hpc:Reservedfilename a owl:Class .
hpc:Reservedfilename rdfs:subClassOf owl:Restriction .
hpc:ReservedFileName rdfs:label "Reserved File Name"@en ;
                    rdfs:comment "The name eswitch.user is reserved."@en ;
                    owl:onProperty hpc:fileName ;
                    owl:hasValue "eswitch.user" .

hpc:Eswitch a owl:Class .
hpc:Eswitch rdfs:subClassOf owl:Thing .
hpc:ESwitch rdfs:label "ESwitch"@en ;
                    rdfs:comment "Represents an execution switch."@en .

hpc:Eswitchconflict a owl:Class .
hpc:Eswitchconflict rdfs:subClassOf owl:Thing .
hpc:ESwitchConflict rdfs:label "ESwitch Conflict"@en ;
                    rdfs:comment "Two different types of parallel job handling."@en .

hpc:Lsf a owl:Class .
hpc:Lsf rdfs:subClassOf owl:Thing .
hpc:LSF rdfs:label "LSF"@en ;
                    rdfs:comment "Represents the LSF (Load Sharing Facility)"@en .

hpc:lsbEswitchMethod a owl:DatatypeProperty .
hpc:LsbEswitchMethod rdfs:domain hpc:Lsf ;
                    rdfs:range xsd:string .

hpc:lsbEventsFileKeepOpen a owl:ObjectProperty .
hpc:LsbEventsFileKeepOpen rdfs:domain hpc:Lsf ;
                    rdfs:range xsd:string .

hpc:LSB_EVENTS_FILE_KEEP_OPEN_Y a owl:NamedIndividual .
hpc:LSB_EVENTS_FILE_KEEP_OPEN_Y rdf:value "Y" .

hpc:LSB_EVENTS_FILE_KEEP_OPEN_N a owl:NamedIndividual .
hpc:LSB_EVENTS_FILE_KEEP_OPEN_N rdf:value "N" .

hpc:lsbExcludeHostPeriod a owl:ObjectProperty .
hpc:LsbExcludeHostPeriod rdfs:domain hpc:Lsf ;
                    rdfs:range xsd:string .

hpc:mbdSleepTime a owl:DatatypeProperty .
hpc:MbdSleepTime rdfs:domain hpc:Lsf ;
                    rd
