hpc:Runningjob a owl:Class .
hpc:command a owl:ObjectProperty ;
    rdfs:domain hpc:Runningjob ;
    rdfs:range xsd:string .

hpc:Singlehostjob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob .
hpc:singlehostcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Singlehostjob ;
    rdfs:range xsd:string ;
    rdfs:comment "Command for a single-host job." .

hpc:Multihostjob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob .
hpc:multihostcommand a owl:ObjectProperty ;
    rdfs:domain hpc:Multihostjob ;
    rdfs:range xsd:string .

hpc:Autoplacejob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob .
hpc:autoplacecommand a owl:ObjectProperty ;
    rdfs:domain hpc:Autoplacejob ;
    rdfs:range xsd:string .

hpc:Mpijob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob .
hpc:mpicommand a owl:ObjectProperty ;
    rdfs:domain hpc:Mpijob ;
    rdfs:range xsd:string .

hpc:Heterogeneousarchitecturejob a owl:Class ;
    rdfs:subClassOf hpc:Mpijob ;
    rdfs:comment "A job that cannot run on a heterogeneous architecture." .

hpc:spanhosts a owl:ObjectProperty ;
    rdfs:domain hpc:Autoplacejob ;
    rdfs:range xsd:string ;
    rdfs:comment "Property to specify the number of hosts for an auto-placed job." .

hpc:spanprocessors a owl:ObjectProperty ;
    rdfs:domain hpc:Autoplacejob ;
    rdfs:range xsd:integer ;
    rdfs:comment "Property to specify the number of processors per host for an auto-placed job." .

hpc:ptile a owl:ObjectProperty ;
    rdfs:domain hpc:Autoplacejob ;
    rdfs:range xsd:integer ;
    rdfs:comment "Property to specify the number of processors for a job when running on multiple hosts." .

hpc:Taskgeometryjob a owl:Class ;
    rdfs:subClassOf hpc:Runningjob .
hpc:taskgeometry a owl:ObjectProperty ;
    rdfs:domain hpc:Taskgeometryjob ;
    rdfs:range xsd:string ;
    rdfs:comment "Property to specify the task geometry for a job." .
