hpc:lsfProcessTracking a owl:DatatypeProperty .
rdf:domain hpc:LSF_PROCESS_TRACKING rdf:resource hpc:LSF_CONFIG .
rdfs:range hpc:LsfProcessTracking xsd:boolean .

# LSF Linux CGroup Accounting
hpc:lsfLinuxCgroupAcct a owl:DatatypeProperty .
rdf:domain hpc:LSF_LINUX_CGROUP_ACCT rdf:resource hpc:LSF_CONFIG .
rdfs:range hpc:LsfLinuxCgroupAcct xsd:boolean .

# LSB Resource Enforcement
hpc:lsbResourceEnforce a owl:DatatypeProperty .
rdf:domain hpc:LSB_RESOURCE_ENFORCE rdf:resource hpc:LSF_CONFIG .
rdfs:range hpc:LsbResourceEnforce xsd:string .

# Docker Resource
hpc:Docker a owl:Class .
hpc:Docker rdfs:subClassOf owl:Boolean .

# Docker Resource Property
hpc:hasdocker a owl:ObjectProperty .
rdf:domain hpc:hasDocker rdf:resource hpc:Resource .
rdfs:range hpc:Hasdocker rdf:resource hpc:Docker .

# LSF Server Host
hpc:LsfServerHost a owl:Class .
hpc:LsfServerHost rdfs:subClassOf owl:Resource .

# LSF Server Host Properties
hpc:hostname a owl:DatatypeProperty .
hpc:model a owl:DatatypeProperty .
hpc:type a owl:DatatypeProperty .
hpc:server a owl:DatatypeProperty .
hpc:r1m a owl:DatatypeProperty .
hpc:mem a owl:DatatypeProperty .
hpc:swp a owl:DatatypeProperty .
hpc:resources a owl:DatatypeProperty .

# Docker Resource Attachment
hpc:runningDocker a owl:DatatypeProperty .
rdf:domain hpc:RUNNING_DOCKER rdf:resource hpc:LSF_SERVER_HOST .
rdfs:range hpc:RunningDocker xsd:boolean .

# Docker Job Dispatching
hpc:dispatchDockerJobs a owl:ObjectProperty .
rdf:domain hpc:DISPATCH_DOCKER_JOBS rdf:resource hpc:LSF_SERVER_HOST .
rdfs:range hpc:DispatchDockerJobs rdf:resource hpc:LsfServerHost .
