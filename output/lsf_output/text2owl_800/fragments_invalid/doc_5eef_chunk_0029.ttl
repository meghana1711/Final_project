hpc:Activedatamanager a owl:Class .
hpc:ManagementHostName an owl:DatatypeProperty ;
    rdfs:domain hpc:Activedatamanager ;
    rdfs:range xsd:string .
hpc:LSFDataPort an owl:DatatypeProperty ;
    rdfs:domain hpc:Activedatamanager ;
    rdfs:range xsd:integer .
hpc:ConnectionStatus an owl:DatatypeProperty ;
    rdfs:domain hpc:Activedatamanager ;
    rdfs:range xsd:string .
hpc:Incomingremote a owl:Class .
hpc:Cluster an owl:DatatypeProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range xsd:string .
hpc:DMDMaster an owl:DatatypeProperty ;
    rdfs:domain hpc:Incomingremote ;
    rdfs:range xsd:string .
hpc:Outgoingremote a owl:Class .
hpc:ClusterMaster an owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .
hpc:LSFDataPortOutgoing an owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:integer .
hpc:ConnectionStatusOutgoing an owl:DatatypeProperty ;
    rdfs:domain hpc:Outgoingremote ;
    rdfs:range xsd:string .
hpc:Remotedatamanager a owl:Class .
hpc:ClusterRemote an owl:DatatypeProperty ;
    rdfs:domain hpc:Remotedatamanager ;
    rdfs:range xsd:string .
hpc:Activedatamanager rdfs:subClassOf owl:Class .
hpc:Incomingremote rdfs:subClassOf hpc:Activedatamanager .
hpc:Outgoingremote rdfs:subClassOf hpc:Activedatamanager .
hpc:Remotedatamanager rdfs:subClassOf owl:Class .
