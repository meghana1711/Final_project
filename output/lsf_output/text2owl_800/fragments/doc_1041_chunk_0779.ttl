hpc:hasLogFile
    a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Logfile ;
    rdfs:label "hasLogFile" ;
    rdfs:comment "Relates a daemon to the log file for its timing messages." .

hpc:LogFileFormat
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "logFileFormat" ;
    rdfs:comment "Specifies the format of the log file." .

hpc:LogFileLocation
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "logFileLocation" ;
    rdfs:comment "Specifies the location of the log file." .

hpc:LogFileDefault
    a owl:NamedIndividual ;
    rdfs:label "defaultLogFile" ;
    hpc:Haslogfile hpc:lsbsystemdaemon ;
    hpc:logFileLocation "" ;
    hpc:logFileFormat xsd:string .

hpc:LSBSystemLogFileDirectory
    a owl:NamedIndividual ;
    rdfs:label "LSBSystemLogFileDirectory" ;
    rdfs:comment "Represents the directory for the LSF system log files." .

hpc:LogFileHostName
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Logfile ;
    rdfs:range xsd:string ;
    rdfs:label "logFileHostName" ;
    rdfs:comment "Specifies the host name of the log file." .

hpc:TemporaryTimingSettings
    a owl:Class ;
    rdfs:label "TemporaryTimingSettings" ;
    rdfs:comment "Represents the temporary timing settings for a daemon." .

hpc:resetTemporaryTimingSettings
    a owl:ObjectProperty ;
    rdfs:domain hpc:Daemon ;
    rdfs:range hpc:Temporarytimingsettings ;
    rdfs:label "resetTemporaryTimingSettings" ;
    rdfs:comment "Resets the temporary timing settings for a daemon." .

hpc:Daemon
    a owl:Class ;
    rdfs:subClassOf hpc:Hpccomponent ;
    rdfs:label "Daemon" ;
    rdfs:comment "Represents a daemon in the HPC system." .

hpc:HPCComponent
    a owl:Class ;
    rdfs:label "HPCComponent" ;
    rdfs:comment "Represents a component in the HPC system." .
