hpc:Job a owl:Class .
hpc:State a owl:Class .
hpc:Normalstate a owl:Class .
hpc:Suspendedstate a owl:Class .
hpc:Pendingstate rdfs:subClassOf hpc:Normalstate .
hpc:Runstate rdfs:subClassOf hpc:Normalstate .
hpc:Done rdfs:subClassOf hpc:Normalstate .
hpc:Psusp rdfs:subClassOf hpc:Suspendedstate .
hpc:Ususp rdfs:subClassOf hpc:Suspendedstate .
hpc:Ssusp rdfs:subClassOf hpc:Suspendedstate .

hpc:hasstate a owl:ObjectProperty .
hpc:iseligiblepending a owl:ObjectProperty .
hpc:Isinactivequeue rdfs:domain hpc:Job ;
                        rdfs:range hpc:Queue .
hpc:Hasstarttimeconstraint rdfs:domain hpc:Job ;
                            rdfs:range xsd:dateTime .
hpc:Issuspendedwhilepending rdfs:domain hpc:Job ;
                             rdfs:range xsd:boolean .
hpc:Hasdependencyconditions rdfs:domain hpc:Job ;
                             rdfs:range xsd:boolean .
