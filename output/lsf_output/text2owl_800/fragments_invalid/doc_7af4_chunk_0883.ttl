hpc:LsfServerHosts a owl:Class .
hpc:hasHostName an rdfs:DatatypeProperty ;
    rdfs:domain hpc:LsfServerHosts ;
    rdfs:range xsd:string .

hpc:LsfMasterList a owl:Class .
hpc:includesInLSF_SERVER_HOSTS an owl:ObjectProperty ;
    rdfs:domain hpc:LsfMasterList ;
    rdfs:range hpc:LsfServerHosts .

hpc:LsfServerdir a owl:Class .
hpc:installationDirectory an owl:DatatypeProperty ;
    rdfs:domain hpc:LsfServerdir ;
    rdfs:range xsd:string .
