hpc:RmCputask a owl:Class .
hpc:ompNumThreads a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:integer .

hpc:Job a owl:Class .
hpc:hascputask a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:RmCputask .

hpc:rmMemAffinity a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:boolean .
