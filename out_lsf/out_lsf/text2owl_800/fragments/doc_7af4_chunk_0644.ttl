hpc:LSB_API_CONNTIMEOUT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Timeout in seconds that b* commands wait for a reply from LSF during the handshake." .

hpc:LSB_API_RECVTIMEOUT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "Timeout in seconds that b* commands wait for a reply from LSF after the handshake is complete." .

hpc:LSB_API_VERBOSE
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Indicates whether LSF batch commands will display a retry error message when LIM is not available." .

# LSB Configuration Parameters
hpc:LSB_BCONF_PROJECT_LIMITS
    a owl:ObjectProperty ;
    rdfs:domain hpc:Lsfcluster ;
    rdfs:range xsd:string ;
    rdfs:comment "Specifies whether LSF uses the bconf command to create project-based limits when the cluster starts up." .

hpc:LSB_BHOSTS_FORMAT
    a owl:DatatypeProperty ;
    rdfs:domain hpc:Lsfcommand ;
    rdfs:range xsd:string ;
    rdfs:comment "Sets the customized output format for the bhosts command." .
