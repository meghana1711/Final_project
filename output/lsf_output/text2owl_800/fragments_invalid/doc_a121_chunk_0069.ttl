hpc:Job a owl:Class .
hpc:Datastagingdetails a owl:Class .
hpc:Job hasDataStagingDetails hpc:DataStagingDetails .

hpc:lsfStageJobid a owl:DatatypeProperty .
hpc:LsfStageJobid rdfs:domain hpc:Job ;
                      rdfs:range xsd:string .

hpc:lsfStageJobindex a owl:DatatypeProperty .
hpc:LsfStageJobindex rdfs:domain hpc:Job ;
                         rdfs:range xsd:nonNegativeInteger .

hpc:lsfStageUser a owl:DatatypeProperty .
hpc:LsfStageUser rdfs:domain hpc:Job ;
                     rdfs:range xsd:string .

hpc:lsfStageHosts a owl:DatatypeProperty .
hpc:LsfStageHosts rdfs:domain hpc:Job ;
                      rdfs:range xsd:string .

hpc:lsfStageStorageMinsize a owl:DatatypeProperty .
hpc:LsfStageStorageMinsize rdfs:domain hpc:Job ;
                                 rdfs:range xsd:decimal .

hpc:lsfStageStorageMaxsize a owl:DatatypeProperty .
hpc:LsfStageStorageMaxsize rdfs:domain hpc:Job ;
                                 rdfs:range xsd:decimal .

hpc:lsfStageUserStageIn a owl:ObjectProperty .
hpc:LsfStageUserStageIn rdfs:domain hpc:Job ;
                               rdfs:range hpc:Userscript .

hpc:lsfStageUserStageOut a owl:ObjectProperty .
hpc:LsfStageUserStageOut rdfs:domain hpc:Job ;
                                 rdfs:range hpc:Userscript .

hpc:lsfStageInStatus a owl:DatatypeProperty .
hpc:LsfStageInStatus rdfs:domain hpc:Job ;
                          rdfs:range xsd:nonNegativeInteger .

hpc:Userscript a owl:Class .
