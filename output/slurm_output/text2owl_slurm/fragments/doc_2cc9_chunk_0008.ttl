hpc:Databaseserver a owl:Class .
hpc:accountingstorageuser a owl:DatatypeProperty ;
    rdfs:domain hpc:Databaseserver ;
    rdfs:range xsd:string .
hpc:accountingstoragepass a owl:DatatypeProperty ;
    rdfs:domain hpc:Databaseserver ;
    rdfs:range xsd:string .
hpc:accountingstoreflags a owl:DatatypeProperty ;
    rdfs:domain hpc:Databaseserver ;
    rdfs:range xsd:string .
hpc:Processidlogging a owl:Class .
hpc:slurmctldpidfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Processidlogging ;
    rdfs:range xsd:string .
hpc:slurmdpidfile a owl:DatatypeProperty ;
    rdfs:domain hpc:Processidlogging ;
    rdfs:range xsd:string .
hpc:Timers a owl:Class .
hpc:slurmctldtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:slurmdtimeout a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:inactivelimit a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:minjobage a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:killwait a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:waittime a owl:DatatypeProperty ;
    rdfs:domain hpc:Timers ;
    rdfs:range xsd:integer .
hpc:Legalnotices a owl:Class .
