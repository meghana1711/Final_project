hpc:Accessibilityimprovement a owl:Class .
hpc:slmtagsupport a owl:ObjectProperty ;
    rdfs:domain hpc:Accessibilityimprovement ;
    rdfs:range hpc:Slmtagfile .

hpc:Knownissue a owl:Class ;
    rdfs:subClassOf hpc:Accessibilityimprovement .
hpc:NoKnownIssues a hpc:KnownIssue ;
    rdfs:comment "Currently, there are no known issues for LSF Simulator." .

hpc:Limitation a owl:Class ;
    rdfs:subClassOf hpc:Accessibilityimprovement .

hpc:onetimeadvancereservation a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:thresholdscheduling a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:memoryorcpulimit a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:preexecutionpostexecutionprocessing a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:jobstartercommands a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:dynamicresourcesandelimscripts a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .

hpc:dynamichosts a owl:ObjectProperty ;
    rdfs:domain hpc:Limitation ;
    rdfs:range xsd:boolean .
