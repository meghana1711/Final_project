hpc:Lsfadminister a owl:Class .
hpc:hasDataManagerRole rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfadminister ;
    rdfs:range hpc:Lsfdatamanagerrole .

hpc:Lsfdatamanagerrole a owl:Class .

hpc:Lsfdatamanagerhost a owl:Class ;
    rdfs:subClassOf hpc:Lsfserverhost .

hpc:hasDMDEamon rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanagerhost ;
    rdfs:range hpc:Dmddaemon .

hpc:Dmddaemon a owl:Class .

hpc:managesStagingArea rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .

hpc:Stagingarea a owl:Class .

hpc:isDataTransferNode rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea .

hpc:isLocalTo rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea ;
    rdfs:range xsd:boolean .

hpc:storesInputFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea .

hpc:storesOutputFiles rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Stagingarea .

hpc:managesDataTransfer rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .

hpc:configuresDataTransferNodes rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .

hpc:managesDataTransferQueue rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .

hpc:isDataSpecificationFile rdf:type owl:Class .

hpc:hasDataSpecificationFile rdf:type owl:ObjectProperty ;
    rdfs:domain hpc:Lsfdatamanager .

hpc:hasDataTagOrSourceFile rdf:type owl:DatatypeProperty ;
    rdfs:domain hpc:Dataspecificationfile ;
    rdfs:range xsd:string .
