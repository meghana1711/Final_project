hpc:Job a owl:Class .
hpc:Application a owl:Class .
hpc:Gpu a owl:Class .
hpc:Device a owl:Class .
hpc:Process a owl:Class .
hpc:Exclusivethreadgpu a owl:Class .
hpc:memorylimit a owl:DatatypeProperty .
hpc:Memory rdfs:range xsd:decimal .
hpc:coresmemorybind a owl:ObjectProperty .
hpc:Core a owl:Class .
hpc:localonly a owl:ObjectProperty .
hpc:Cpuset a owl:Class .
hpc:Task a owl:Class .
hpc:Killed a owl:Class .
hpc:totalmemory a owl:DatatypeProperty .
hpc:Host a owl:Class .
hpc:affinity a owl:ObjectProperty .

hpc:Job rdfs:subClassOf owl:Class .
hpc:Application rdfs:subClassOf hpc:Job .
hpc:Gpu rdfs:subClassOf hpc:Device .
hpc:Exclusivethreadgpu rdfs:subClassOf hpc:Gpu .
hpc:Device rdfs:subClassOf owl:Class .
hpc:Process rdfs:subClassOf hpc:Device .
hpc:Memorylimit rdfs:domain hpc:Job ;
                        rdfs:range xsd:decimal .
hpc:Coresmemorybind rdfs:domain hpc:Job ;
                        rdfs:range hpc:Cpuset .
hpc:Localonly rdfs:domain hpc:Job ;
                        rdfs:range xsd:boolean .
hpc:Affinity rdfs:domain hpc:Job ;
                        rdfs:range hpc:Cpuset .
hpc:Task rdfs:subClassOf hpc:Job .
hpc:Killed rdfs:subClassOf hpc:Job .
hpc:Totalmemory rdfs:domain hpc:Job ;
                        rdfs:range xsd:decimal .
hpc:Host rdfs:subClassOf owl:Class .
