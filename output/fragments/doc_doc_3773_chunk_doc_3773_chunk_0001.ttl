hpc:SlurmSiteFactorPlugin a owl:Class .
hpc:pluginType a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSiteFactorPlugin ;
    rdfs:range xsd:string .

hpc:pluginName a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSiteFactorPlugin ;
    rdfs:range xsd:string .

hpc:pluginVersion a owl:DatatypeProperty ;
    rdfs:domain hpc:SlurmSiteFactorPlugin ;
    rdfs:range xsd:unsignedInt .

hpc:init a owl:ObjectProperty ;
    rdfs:domain hpc:SlurmSiteFactorPlugin ;
    rdfs:range xsd:int .

hpc:PluginType a owl:Class ;
    rdfs:subClassOf owl:Class ;
    rdfs:comment "Represents the type of a Slurm plugin." .

hpc:Major a owl:Class ;
    rdfs:subClassOf hpc:PluginType ;
    rdfs:comment "Represents the major type of a Slurm plugin, which must be 'site_factor'." .

hpc:Minor a owl:Class ;
    rdfs:subClassOf hpc:PluginType ;
    rdfs:comment "Represents the minor type of a Slurm plugin, which can be any recognizable abbreviation for the specific plugin." .

hpc:NICE_OFFSET a xsd:unsignedInt .
