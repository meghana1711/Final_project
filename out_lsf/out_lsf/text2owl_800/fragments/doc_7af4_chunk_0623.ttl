hpc:Authmethod a owl:Class .
hpc:Eauthprogram a owl:Class .
hpc:Lsfconf a owl:Class .
hpc:Lsfdaemon a owl:Class .
hpc:Egoconf a owl:Class .

hpc:Preferredauthenticationmethod rdfs:domain hpc:Lsfdaemon ;
    rdfs:range hpc:Authmethod .

hpc:Correspondingeauthprogram rdfs:domain hpc:Authmethod ;
    rdfs:range hpc:Eauthprogram .

hpc:Lsfconf rdfs:subClassOf hpc:Lsfconf ;
    rdfs:domain hpc:Lsfdaemon .

hpc:Egoconf rdfs:subClassOf hpc:Lsfconf ;
    rdfs:domain hpc:Lsfdaemon .

hpc:Egoparameter rdfs:subClassOf hpc:Lsfconf .

hpc:Egodisableunresolvablehost rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egoenableautodaemonshutdown rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egodaemonscpus rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egodefinencpus rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egoslavectrlremotehost rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egoworkdir rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egopimswapreport rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
hpc:Egoeslimtimeout rdfs:subClassOf hpc:Egoparameter ;
    rdfs:domain hpc:Lsfdaemon .
