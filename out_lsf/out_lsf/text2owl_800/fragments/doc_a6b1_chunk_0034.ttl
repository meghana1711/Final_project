hpc:LsfEventReceiver a owl:Class .
hpc:clustername a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEventReceiver ;
    rdfs:range xsd:string .

hpc:LsfEvent a owl:Class .
hpc:eventnumber a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEvent ;
    rdfs:range xsd:nonNegativeInteger .

hpc:eventargument a owl:DatatypeProperty ;
    rdfs:domain hpc:LsfEvent ;
    rdfs:range xsd:string .

hpc:LsfMbdBusyMsg a owl:Class .
hpc:LsbMbdConnectFailMsg a owl:Class .
hpc:LsbMbdPort a owl:Class .
hpc:LsbQueryPort a owl:Class .

hpc:Custombatchcommandmessage a owl:Class ;
    rdfs:subClassOf hpc:LsfEvent .

hpc:reasonfornoresponsefrommbd a owl:ObjectProperty ;
    rdfs:domain hpc:Custombatchcommandmessage ;
    rdfs:range hpc:LsfEvent .

hpc:defaultmessage a owl:DatatypeProperty ;
    rdfs:domain hpc:Custombatchcommandmessage ;
    rdfs:range xsd:string .
