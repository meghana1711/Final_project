hpc:enableMinjobPreemption a owl:DatatypeProperty .
hpc:EnableMinjobPreemption rdfs:domain hpc:Projectmode .
hpc:EnableMinjobPreemption rdfs:range xsd:string .

hpc:fastDispatch a owl:DatatypeProperty .
hpc:FastDispatch rdfs:domain hpc:Projectmode .
hpc:FastDispatch rdfs:range xsd:string .

hpc:Fastdispatchprojectmode a owl:Class .
hpc:Fastdispatchprojectmode rdfs:subClassOf hpc:Projectmode .

hpc:Joblistoptimization a owl:Class .
hpc:Joblistoptimization rdfs:subClassOf hpc:Feature .
hpc:JobListOptimization rdfs:comment "Minimizes the overall number of preempted jobs by enabling job list optimization." .

hpc:Licenseutilization a owl:Class .
hpc:Licenseutilization rdfs:subClassOf hpc:Feature .
hpc:LicenseUtilization rdfs:comment "Enables fast dispatch project mode for the license feature, which increases license utilization for project licenses." .

hpc:Licensecheckoutfailure a owl:Class .
hpc:Licensecheckoutfailure rdfs:subClassOf hpc:Risk .
hpc:LicenseCheckoutFailure rdfs:comment "There is an increased chance of a license checkout failure for jobs if the license is already in use by a job in another project." .

hpc:Joblicense a owl:Class .
hpc:Joblicense rdfs:subClassOf hpc:Feature .
hpc:JobLicense rdfs:comment "The fast dispatch project mode does not have to run lmutil, lmstat, rlmutil, or rlmstat to verify that a license is free before each job dispatch." .

hpc:Featuredelta a owl:Class .
hpc:Featuredelta rdfs:subClassOf hpc:Parameter .
hpc:FeatureDelta rdfs:comment "Syntax: FEATURE_DELTA=service_domain_name(abs | mult number) ..." .

hpc:Servicedomainname a owl:Class .
hpc:Servicedomainname rdfs:subClassOf xsd:string .

hpc:abs a owl:ObjectProperty .
hpc:Abs rdfs:domain hpc:Featuredelta .
hpc:Abs rdfs:range hpc:Servicedomainname .

hpc:mult a owl:ObjectProperty .
hpc:Mult rdfs:domain hpc:Featuredelta .
hpc:Mult rdfs:range xsd:nonNegativeInteger .

hpc:Projectmode a owl:Class .
hpc:Projectmode rdfs:subClassOf hpc:Mode .
hpc:ProjectMode rdfs:comment "Used for project mode only" .

hpc:Mode a owl:Class .
hpc:Mode rdfs:subClassOf owl:Thing .
