@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@prefix owl: <http://www.w3.org/2002/07/owl#>
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>

hpc:Resource a owl:Class .
hpc:hasname a owl:ObjectProperty .
hpc:hasdescription a owl:DatatypeProperty .

rdfs:domain hpc:Hasname hpc:Resource .
rdfs:domain hpc:Hasdescription hpc:Resource .

hpc:Resourcemap a owl:Class .
hpc:mapsresourcetohost a owl:ObjectProperty .

rdfs:domain hpc:Mapsresourcetohost hpc:Resourcemap .
rdfs:range hpc:Mapsresourcetohost rdf:Resource .

hpc:Notshared a owl:Class .
hpc:islocaltoeachhost a owl:ObjectProperty .

rdfs:subClassOf hpc:Notshared hpc:Resource .
rdfs:domain hpc:Islocaltoeachhost hpc:Notshared .

hpc:Others a owl:Class .
hpc:comprisesinstance a owl:ObjectProperty .

rdfs:subClassOf hpc:Others rdf:Resource .
rdfs:domain hpc:Comprisesinstance hpc:Others .

hpc:Default a owl:Class .
hpc:isinstanceoneachhost a owl:ObjectProperty .

rdfs:subClassOf hpc:Default rdf:Resource .
rdfs:domain hpc:Isinstanceoneachhost hpc:Default .

hpc:resourcename a owl:DatatypeProperty .
hpc:description a owl:DatatypeProperty .

hpc:Resourcename rdfs:range xsd:string .
hpc:Description rdfs:range xsd:string .

hpc:ResourceName rdfs:subPropertyOf hpc:hasName .
hpc:Description rdfs:subPropertyOf hpc:hasDescription .

hpc:ResourceName rdfs:comment "Name of the resource. This resource name must be defined in the Resource section of the lsf.shared file." .
hpc:Description rdfs:comment "A description for the resource." .

hpc:Resourcename rdfs:domain hpc:Resource .
hpc:Description rdfs:domain hpc:Resource .

hpc:ResourceName rdfs:value "Must begin with a letter." .
hpc:ResourceName rdfs:restriction rdfs:pattern xsd:token .

hpc:ResourceName rdfs:restriction rdfs:pattern ^[A-Z][a-zA-Z0-9]*$ .

hpc:ResourceName rdfs:restriction rdfs:excludedValues (
  "<" .
  "." .
  ">" .
  "(" .
  ")" .
) .
