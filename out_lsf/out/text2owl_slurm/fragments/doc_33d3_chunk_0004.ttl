hpc:Batchstep a owl:Class .
hpc:Interactivestep a owl:Class .
hpc:Normalstep a owl:Class .

hpc:Hasbatchhost rdfs:domain hpc:Batchstep ;
    rdfs:range xsd:string .
hpc:Runsslurmstepd rdfs:domain hpc:Batchstep ;
    rdfs:range xsd:integer .

hpc:Hasinteractiveshell rdfs:domain hpc:Interactivestep ;
    rdfs:range xsd:string .
hpc:Runsslurmstepd rdfs:domain hpc:Interactivestep ;
    rdfs:range xsd:integer .

hpc:Runssrun rdfs:domain hpc:Normalstep ;
    rdfs:range xsd:string .
hpc:Hasstepid rdfs:domain hpc:Normalstep ;
    rdfs:range xsd:integer .
hpc:Hasjobid rdfs:domain hpc:Normalstep ;
    rdfs:range xsd:integer .
hpc:Runsonnode rdfs:domain hpc:Normalstep ;
    rdfs:range xsd:integer .
hpc:Runsmultipletasksonnode rdfs:domain hpc:Normalstep ;
    rdfs:range xsd:boolean .
