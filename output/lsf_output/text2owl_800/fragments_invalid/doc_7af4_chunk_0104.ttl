hpc:ResReq a owl:Class .

hpc:hasresourcereq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range xsd:string .

hpc:compoundresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Compoundresreq .

hpc:alternativeresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Alternativeresreq .

hpc:simpleresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Simpleresreq .

hpc:selectresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Selectresreq .

hpc:rusageresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Rusageresreq .

hpc:orderresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Orderresreq .

hpc:spanresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Spanresreq .

hpc:sameresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range hpc:Sameresreq .

hpc:curesreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range xsd:string ;
    owl:inverseOf hpc:hasCu .

hpc:affinityresreq a owl:ObjectProperty ;
    rdfs:domain hpc:ResReq ;
    rdfs:range xsd:string .

hpc:Compoundresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:Alternativeresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:Simpleresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:Selectresreq a owl:Class ;
    rdfs:subClassOf hpc:Simpleresreq .

hpc:Rusageresreq a owl:Class ;
    rdfs:subClassOf hpc:Simpleresreq .

hpc:Orderresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:Spanresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:Sameresreq a owl:Class ;
    rdfs:subClassOf hpc:ResReq .

hpc:cu a owl:DatatypeProperty ;
    rdfs:domain hpc:Host ;
    rdfs:range xsd:string .

hpc:affinity a owl:Datatype
