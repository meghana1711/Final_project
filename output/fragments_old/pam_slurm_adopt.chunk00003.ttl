hpc:Container a owl:Class .
hpc:JobContainer a owl:Class, rdfs:subClassOf [ a owl:Restriction ;
                                                  rdfs:onProperty hpc:joins ;
                                                  rdfs:hasValue "job_container/tmpfs" ] .

hpc:LogLevel a owl:DatatypeProperty ;
           rdfs:domain hpc:Container ;
           rdfs:range xsd:string .

hpc:NodeName a owl:ObjectProperty ;
            rdfs:domain hpc:Container ;
            rdfs:range xsd:string .

hpc:Service a owl:DatatypeProperty ;
           rdfs:domain hpc:Container ;
           rdfs:range xsd:string .

hpc:Firewall a owl:Class .

hpc:SELinux a owl:Class .

hpc:PAMService a owl:Class .
hpc:PAMService a rdfs:subClassOf [ a owl:Restriction ;
                                     rdfs:onProperty hpc:service ;
                                     rdfs:hasValue "*" ] .

hpc:AdoptedProcess a owl:Class .

hpc:AdoptionPermission a owl:Class .
hpc:AdoptionPermission a rdfs:subClassOf [ a owl:Restriction ;
                                             rdfs:onProperty hpc:permissions ;
                                             rdfs:hasValue "allow" ] .

hpc:Permission a owl:Class .
hpc:Permission a rdfs:subClassOf [ a owl:Restriction ;
                                     rdfs:onProperty hpc:type ;
                                     rdfs:hasValue "*" ] .

hpc:Type a owl:DatatypeProperty ;
       rdfs:domain hpc:AdoptionPermission ;
       rdfs:range xsd:string .

hpc:Class a owl:DatatypeProperty ;
       rdfs:domain hpc:Permission ;
       rdfs:range xsd:string .

hpc:Action a owl:DatatypeProperty ;
         rdfs:domain hpc:Permission ;
         rdfs:range xsd:string .
```
