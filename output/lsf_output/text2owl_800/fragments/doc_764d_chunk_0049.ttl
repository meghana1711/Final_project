hpc:Remoteonlyqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue that sends jobs to a specific remote cluster." .

hpc:Receivejobsqueue a owl:Class ;
    rdfs:subClassOf hpc:Queue ;
    rdfs:comment "A queue that receives jobs from another cluster." .

hpc:queueforwarding a owl:ObjectProperty ;
    rdfs:domain hpc:Queue ;
    rdfs:range hpc:Queue ;
    rdfs:comment "A relationship between queues where jobs are forwarded." .

hpc:disabletimeout a owl:ObjectProperty ;
    rdfs:domain hpc:Remoteonlyqueue ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates whether timeouts are disabled in a remote-only queue." .

hpc:maxrschedtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Remoteonlyqueue ;
    rdfs:range xsd:nonNegativeInfiniteDuration ;
    rdfs:comment "The maximum scheduled time for jobs in a remote-only queue." .

hpc:submitjob a owl:ObjectProperty ;
    rdfs:domain hpc:Remoteonlyqueue ;
    rdfs:range xsd:string ;
    rdfs:comment "The action of submitting a job to a remote-only queue." .

hpc:Remoteonlymulticlusterqueue a owl:Class ;
    rdfs:subClassOf hpc:Remoteonlyqueue ;
    rdfs:comment "A remote-only queue that sends to only one receive-jobs queue." .

hpc:Queue1 a hpc:Queue ;
    hpc:Queueforwarding hpc:queue2 ;
    hpc:DisableTimeout true ;
    hpc:MaxRSCHEDTime "infinity"^^xsd:nonNegativeInfiniteDuration ;
    rdfs:label "Queue1" .

hpc:Queue2 a hpc:ReceiveJobsQueue ;
    rdfs:label "queue2" .

hpc:bsub a owl:ObjectProperty ;
    rdfs:domain hpc:Remoteonlyqueue ;
    rdfs:range xsd:string ;
    rdfs:comment "The command used to submit a job to a remote-only queue." .
