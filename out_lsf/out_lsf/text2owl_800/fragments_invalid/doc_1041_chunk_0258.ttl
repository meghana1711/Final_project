hpc:Summaryinformation a owl:Class ;
    rdfs:subClassOf hpc:Jobinformation ;
    rdfs:comment "Displays summary information about unfinished jobs." .

hpc:advancereservationassociatedjob a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Job ;
    rdfs:comment "Displays jobs that are associated with the specified advance reservation." .

hpc:unformattedjobdetailinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobdetailinformation ;
    rdfs:comment "Displays unformatted job detail information." .

hpc:submittedbyuserorusergroup a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:User ;
    rdfs:comment "Displays jobs that were submitted by the specified users or user groups." .

hpc:resourceusageinformation a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Resourceusage ;
    rdfs:comment "Provides resource usage information for: PROJ_NAME, CPU_USED, MEM, SWAP, PIDS, START_TIME, FINISH_TIME." .

hpc:estimatedfinishtime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Displays an estimated finish time for running or pending jobs. For done or exited jobs, displays the actual finish time." .

hpc:estimatedremainingruntime a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:duration ;
    rdfs:comment "Displays the estimated remaining run time of jobs." .

hpc:currentestimatedcompletionpercentage a owl:DatatypeProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Displays the current estimated completion percentage of jobs." .

hpc:wideformat a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range hpc:Jobinformation ;
    rdfs:comment "Wide format. Displays job information without truncating fields." .

hpc:noncondensedoutputforhostgroupsandcomputeunits a owl:ObjectProperty ;
    rdfs:domain hpc:Jobinformation ;
    rdfs:range hpc:Jobinformation ;
    rdfs:comment "Displays noncondensed output for host groups and compute units." .

hpc:Unfinishedjobwithjobexception a owl:Class ;
    rdfs:subClassOf hpc:Job ;
    rdfs:comment "Displays unfinished jobs that have triggered a job exception (overrun, underrun, idle, runtime_est_exceeded)." .

hpc:overrun a owl:ObjectProperty ;
    rdfs:domain hpc:Job ;
    rdfs:range hpc:Jobexception ;
    rdfs:comment "Indicates that a job has overrun." .

hpc
