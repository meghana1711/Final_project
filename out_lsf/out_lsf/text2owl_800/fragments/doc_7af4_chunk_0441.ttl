hpc:gpuRunTimeFactor a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbJob ;
    rdfs:range xsd:decimal .

hpc:GPU_RUN_TIME_FACTOR_DEFAULT a xsd:decimal .

hpc:lsbGpuReq a owl:ObjectProperty ;
    rdfs:domain hpc:LsbConfiguration ;
    rdfs:range hpc:GpuReq .

hpc:GpuReq a owl:Class .

hpc:histHours a owl:DatatypeProperty ;
    rdfs:domain hpc:LsbConfiguration ;
    rdfs:range xsd:decimal .

hpc:HIST_HOURS_DEFAULT a xsd:decimal .
